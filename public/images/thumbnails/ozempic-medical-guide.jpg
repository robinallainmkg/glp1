<svg width="1200" height="630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f8fafc;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#e2e8f0;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cardGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f1f5f9;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow">
      <dropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.15"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGradient)"/>

  <!-- Medical cross pattern -->
  <g opacity="0.03" transform="translate(50, 50)">
    <rect x="0" y="0" width="40" height="40" fill="none" stroke="#3b82f6" stroke-width="2"/>
    <line x1="20" y1="10" x2="20" y2="30" stroke="#3b82f6" stroke-width="2"/>
    <line x1="10" y1="20" x2="30" y2="20" stroke="#3b82f6" stroke-width="2"/>
  </g>

  <!-- Main content area -->
  <g transform="translate(100, 100)">
    <!-- Product visualization -->
    <g transform="translate(0, 0)">
      <!-- Syringe/Pen representation -->
      <rect x="50" y="50" width="200" height="80" rx="40" fill="#e5e7eb" filter="url(#shadow)"/>
      <rect x="60" y="60" width="180" height="60" rx="30" fill="#ffffff" stroke="#d1d5db" stroke-width="2"/>
      <rect x="70" y="70" width="160" height="40" rx="20" fill="#3b82f6"/>
      <text x="150" y="95" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white" text-anchor="middle">OZEMPIC</text>

      <!-- Dosage indicator -->
      <circle cx="280" cy="90" r="25" fill="#10b981"/>
      <text x="280" y="97" font-family="Arial, sans-serif" font-size="12" font-weight="bold" fill="white" text-anchor="middle">2mg</text>
    </g>

    <!-- Product info cards -->
    <g transform="translate(350, 0)">
      <!-- Main info card -->
      <rect x="0" y="0" width="400" height="200" rx="15" fill="url(#cardGradient)" filter="url(#shadow)"/>
      <rect x="0" y="0" width="400" height="60" rx="15" fill="#3b82f6"/>
      <text x="20" y="40" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="white">Ozempic 2mg</text>

      <!-- Product details -->
      <g transform="translate(20, 80)">
        <text x="0" y="0" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="#1f2937">Semaglutide - Novo Nordisk</text>
        <text x="0" y="30" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">Solution injectable en stylo prérempli</text>
        <text x="0" y="55" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">Une injection par semaine</text>
        <text x="0" y="80" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">Conservation : Réfrigérateur (2-8°C)</text>
      </g>

      <!-- Price badge -->
      <g transform="translate(20, 120)">
        <rect x="0" y="0" width="120" height="40" rx="20" fill="#10b981"/>
        <text x="60" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="white" text-anchor="middle">73,90 €</text>
      </g>

      <text x="160" y="145" font-family="Arial, sans-serif" font-size="12" fill="#9ca3af">Prix boîte de 4 stylos</text>
    </g>

    <!-- Benefits section -->
    <g transform="translate(0, 250)">
      <text x="0" y="0" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1f2937">Indications médicales :</text>

      <g transform="translate(0, 30)">
        <circle cx="15" cy="15" r="8" fill="#10b981"/>
        <text x="35" y="20" font-family="Arial, sans-serif" font-size="16" fill="#374151">Diabète de type 2</text>
      </g>

      <g transform="translate(0, 60)">
        <circle cx="15" cy="15" r="8" fill="#10b981"/>
        <text x="35" y="20" font-family="Arial, sans-serif" font-size="16" fill="#374151">Obésité (IMC ≥ 30)</text>
      </g>

      <g transform="translate(0, 90)">
        <circle cx="15" cy="15" r="8" fill="#10b981"/>
        <text x="35" y="20" font-family="Arial, sans-serif" font-size="16" fill="#374151">Surpoids avec comorbidités</text>
      </g>

      <g transform="translate(300, 30)">
        <circle cx="15" cy="15" r="8" fill="#3b82f6"/>
        <text x="35" y="20" font-family="Arial, sans-serif" font-size="16" fill="#374151">Perte de poids : 15-20 kg</text>
      </g>

      <g transform="translate(300, 60)">
        <circle cx="15" cy="15" r="8" fill="#3b82f6"/>
        <text x="35" y="20" font-family="Arial, sans-serif" font-size="16" fill="#374151">Réduction HbA1c : -2%</text>
      </g>

      <g transform="translate(300, 90)">
        <circle cx="15" cy="15" r="8" fill="#3b82f6"/>
        <text x="35" y="20" font-family="Arial, sans-serif" font-size="16" fill="#374151">Risque cardiovasculaire ↓</text>
      </g>
    </g>
  </g>

  <!-- Footer branding -->
  <g transform="translate(100, 550)">
    <line x1="0" y1="0" x2="1000" y2="0" stroke="#e5e7eb" stroke-width="1"/>
    <text x="0" y="30" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#3b82f6">Guide Complet Ozempic - GLP1-France.fr</text>
    <text x="0" y="55" font-family="Arial, sans-serif" font-size="14" fill="#6b7280">Informations médicales validées • Conseils personnalisés • Suivi expert</text>
  </g>

  <!-- Medical disclaimer -->
  <g transform="translate(100, 600)">
    <text x="0" y="0" font-family="Arial, sans-serif" font-size="12" fill="#9ca3af">*Sous surveillance médicale • Remboursé à 65% • Prescription obligatoire</text>
  </g>
</svg>
