# =============================================================================
# GLP1 France — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Agent Fact-check) ---
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- SMTP (Notifications urgentes) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=noreply@glp1-france.fr
NOTIFICATION_EMAIL=admin@glp1-france.fr

# --- n8n (self-hosted sur VPS Hostinger) ---
N8N_USER=admin
N8N_PASSWORD=change-me-strong-password
N8N_ENCRYPTION_KEY=random-32-char-string
N8N_HOST=n8n.glp1-france.fr
N8N_PORT=5678
