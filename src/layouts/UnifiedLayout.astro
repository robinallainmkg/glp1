---
// Layout unifié pour toutes les pages du site
import '../styles/global.css';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import Hotjar from '../components/Hotjar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AiCoach from '../components/AiCoach.astro';
import AffiliateTracker from '../components/AffiliateTracker.astro';
import PlatformTracker from '../components/PlatformTracker.astro';
import SinocareBanner from '../components/SinocareBanner.astro';
import { getAllAffiliateProducts } from '../lib/affiliate';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  author?: string;
  showAffiliateSidebar?: boolean;
  affiliateProducts?: any[];
  affiliateConfig?: any;
  articleContent?: string;
  category?: string;
  // Allow extra dynamic props from pages
  currentPage?: string;
  collection?: string;
  collectionName?: string;
  frontmatter?: any;
  customProps?: any;
  [key: string]: any;
}

const { 
  title, 
  description, 
  keywords = "", 
  image = "/og-image.svg",
  author,
  showAffiliateSidebar = false,
  affiliateProducts = [],
  affiliateConfig = {},
  // articleContent removed (unused in this layout)
  category
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;

// Produits d'affiliation si nécessaire
let allProducts = [];
let availableProducts = [];

if (showAffiliateSidebar) {
  try {
    allProducts = await getAllAffiliateProducts();
  availableProducts = affiliateProducts.length > 0 ? affiliateProducts : allProducts.slice(0, 3);
  // Footer product selection removed (not used)
  } catch (error) {
    console.warn('Erreur lors du chargement des produits:', error);
  }
}

// Détection automatique de la catégorie pour le breadcrumb
const urlParts = Astro.url.pathname.split('/').filter(part => part);
let detectedCategory = category;
let categoryIcon = '📂';

if (!detectedCategory && urlParts.length > 1) {
  if (urlParts[0] === 'collections') {
    detectedCategory = urlParts[1];
  } else if (urlParts[0] === 'guides') {
    detectedCategory = 'guides';
    categoryIcon = '📖';
  } else if (urlParts[0] === 'temoignages') {
    detectedCategory = 'temoignages';
    categoryIcon = '💬';
  }
}

// Icons pour les catégories
const categoryIcons = {
  'effets-secondaires-glp1': '⚠️',
  'glp1-cout': '💰',
  'glp1-perte-de-poids': '📉',
  'regime-glp1': '🥗',
  'alternatives-glp1': '🔄',
  'guides': '📖',
  'temoignages': '💬'
};

if (detectedCategory && categoryIcons[detectedCategory]) {
  categoryIcon = categoryIcons[detectedCategory];
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-48.svg">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#16a34a">
  
  <link rel="canonical" href={canonicalURL}>
  
  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description}>
  {keywords && <meta name="keywords" content={keywords}>}
  {author && <meta name="author" content={author}>}
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>

  <!-- Twitter Card -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={ogImage}>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Google Analytics -->
  <GoogleAnalytics />
  
  <!-- Hotjar Tracking -->
  <Hotjar />

  <!-- A/B Testing Engine (before body to avoid flicker) -->
  <script src="/ab-engine.js" is:inline></script>

</head>

<body>
  <AnnouncementBar />
  <SiteHeader />

  <!-- Breadcrumb Navigation (seulement pour certaines pages) -->
  {(detectedCategory || title !== "GLP-1 France - Guide Complet des Traitements") && (
    <nav class="breadcrumb" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 12px 0;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
        <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; flex-wrap: wrap;">
          <a href="/" style="color: #2d5a4e; text-decoration: none; display: flex; align-items: center; gap: 4px;">
            <span>🏠</span>
            <span>Accueil</span>
          </a>
          <span style="color: #9ca3af;">→</span>
          {detectedCategory && (
            <>
              <a href={detectedCategory === 'guides' || detectedCategory === 'temoignages' ? `/${detectedCategory}/` : `/collections/${detectedCategory}/`} style="color: #2d5a4e; text-decoration: none; display: flex; align-items: center; gap: 4px;">
                <span>{categoryIcon}</span>
                <span>{detectedCategory.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase())}</span>
              </a>
              <span style="color: #9ca3af;">→</span>
            </>
          )}
          <span style="color: #6b7280; display: flex; align-items: center; gap: 4px;">
            <span>📄</span>
            <span>{title}</span>
          </span>
        </div>
      </div>
    </nav>
  )}

  <!-- Contenu principal -->
  <main id="main-content" class={showAffiliateSidebar ? "main-with-sidebar" : "main-full"}>
    {showAffiliateSidebar ? (
      <div class="article-layout">
        <div class="article-content">
          <slot />
        </div>
        <aside class="affiliate-sidebar">
          {availableProducts && (
            <AdaptiveAffiliateDisplay affiliateProducts={availableProducts} config={affiliateConfig} />
          )}
        </aside>
      </div>
    ) : (
      <slot />
    )}
  </main>

  <SiteFooter />
  <AiCoach />
  <AffiliateTracker />
  <PlatformTracker />

  <!-- SiteHeader gère son propre JS/CSS -->

  {showAffiliateSidebar && (
    <script>
      // JavaScript pour les produits d'affiliation (si nécessaire)
      if (typeof window !== 'undefined') {
        // Code spécifique aux pages avec sidebar d'affiliation
        console.log('Sidebar d\'affiliation activée');
      }
    </script>
  )}
</body>
</html>

<style>
/* Header logo and nav fixes (ensure logo displays) */
.new-logo { display: flex; align-items: center; }
.new-logo-link { display: flex; align-items: center; gap: 0.75rem; color: inherit; text-decoration: none; }
.new-logo-icon { width: 40px; height: 40px; flex-shrink: 0; }
.new-logo-text { font-size: 1.125rem; font-weight: 700; color: #111827; }
.new-nav-desktop { display: none; align-items: center; gap: 1.5rem; }
@media (min-width: 768px) { .new-nav-desktop { display: flex; } }

/* Styles spécifiques pour la layout avec sidebar */
.main-with-sidebar {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.article-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 2rem;
  align-items: start;
}

.article-content {
  min-width: 0; /* Pour éviter l'overflow */
}

.affiliate-sidebar {
  position: sticky;
  top: 2rem;
}

.main-full {
  width: 100%;
}

/* Responsive */
@media (max-width: 1024px) {
  .article-layout {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .affiliate-sidebar {
    position: static;
    order: -1; /* Sidebar en haut sur mobile */
  }
}

/* Footer styles */
.site-footer {
  background: #1f2937;
  color: #f9fafb;
  margin-top: 4rem;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 3rem 1rem 1rem;
}

.footer-main {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 3rem;
  margin-bottom: 2rem;
}

.footer-brand h3 {
  color: #16a34a;
  margin-bottom: 1rem;
  font-size: 1.5rem;
  font-weight: 600;
}

.footer-brand p {
  color: #d1d5db;
  line-height: 1.6;
}

.footer-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.footer-column h4 {
  color: #f9fafb;
  margin-bottom: 1rem;
  font-weight: 600;
}

.footer-column ul {
  list-style: none;
  padding: 0;
}

.footer-column ul li {
  margin-bottom: 0.5rem;
}

.footer-column ul li a {
  color: #d1d5db;
  text-decoration: none;
  transition: color 0.2s;
}

.footer-column ul li a:hover {
  color: #16a34a;
}

.footer-legal {
  border-top: 1px solid #374151;
  padding-top: 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.footer-legal-links {
  display: flex;
  gap: 2rem;
}

.footer-legal-links a {
  color: #9ca3af;
  text-decoration: none;
  font-size: 0.875rem;
}

.footer-legal-links a:hover {
  color: #16a34a;
}

.footer-copyright {
  text-align: right;
}

.footer-copyright p {
  margin: 0;
  color: #9ca3af;
  font-size: 0.875rem;
}

.footer-disclaimer {
  font-size: 0.75rem !important;
  font-style: italic;
  margin-top: 0.5rem !important;
}

@media (max-width: 768px) {
  .footer-main {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .footer-links {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .footer-legal {
    flex-direction: column;
    text-align: center;
  }
  
  .footer-copyright {
    text-align: center;
  }
  
  .footer-legal-links {
    flex-wrap: wrap;
    justify-content: center;
  }
}
</style>
