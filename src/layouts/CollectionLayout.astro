---
import BaseLayout from './BaseLayout.astro';
import AffiliateProduct from '../components/AffiliateProduct.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getProductsByCategory } from '../lib/affiliate';

export interface Props {
  collection: {
    id: string;
    name: string;
    slug: string;
    description: string;
    icon: string;
    color: string;
    seoTitle: string;
    seoDescription: string;
    keywords: string[];
    image?: string;
  };
  articles: Array<{
    slug: string;
    title: string;
    description: string;
    author: string;
    url: string;
    wordCount: number;
    readingTime: number;
    lastModified: string;
  }>;
  currentPage?: number;
  totalPages?: number;
  collectionName?: string;
  frontmatter?: any;
  [key: string]: any;
}

const { collection, articles = [], currentPage = 1, totalPages = 1 } = Astro.props;

// Normaliser les articles reçus (supporte à la fois les entrées Astro et les objets préformatés)
const rawArticles = Array.isArray(articles) ? articles : [];
const normalizedArticles = rawArticles.map((a: any) => ({
  slug: a.slug || a?.data?.slug || (a.url ? String(a.url).split('/').filter(Boolean).pop() : ''),
  title: a?.data?.title || a.title || '',
  description: a?.data?.description || a.description || a?.data?.metaDescription || '',
  author: a?.data?.author || a.author || 'Équipe GLP-1 France',
  url: a.url || `/collections/${collection?.slug || ''}/${a.slug || ''}`,
  wordCount: a.wordCount ?? ((a.body || '').toString().split(/\s+/).filter(Boolean).length),
  readingTime: a.readingTime ?? Math.max(1, Math.ceil(((a.wordCount ?? ((a.body || '').toString().split(/\s+/).filter(Boolean).length)) / 200))),
  lastModified: a?.data?.lastModified || a.lastModified || a?.data?.pubDate || new Date().toISOString(),
  thumbnail: a?.data?.thumbnail || a?.thumbnail || a?.data?.image || a?.image || `/images/thumbnails/${a.slug || ''}-illus.jpg`,
  // conserver l'objet original pour compatibilité
  __original: a
}));

// Déduplication par slug : garder la version la plus récente
function dedupeBySlugKeepLatest(items: any[]) {
  const map = new Map<string, any>();
  items.forEach(item => {
    const slug = String(item.slug || '');
    const existing = map.get(slug);
    const itemDate = new Date(item.lastModified || 0).getTime();
    const existingDate = existing ? new Date(existing.lastModified || 0).getTime() : 0;
    if (!existing || itemDate >= existingDate) {
      map.set(slug, item);
    }
  });
  return Array.from(map.values()).sort((a, b) => new Date(b.lastModified).getTime() - new Date(a.lastModified).getTime());
}

const items = dedupeBySlugKeepLatest(normalizedArticles);

// Calcul du temps de lecture total
const totalReadingTime = items.reduce((sum, article) => sum + (article.readingTime || 0), 0);

// Récupération des produits affiliés pour cette collection
let collectionProducts = [];
let _headerProduct = null;
let _sidebarProducts = [];

// Attempt to fetch collection products if helper is available
try {
  if (typeof getProductsByCategory === 'function') {
  collectionProducts = await getProductsByCategory(collection.slug);
  _headerProduct = collectionProducts[0];
  _sidebarProducts = collectionProducts.slice(1, 3);
  }
} catch (error) {
  console.warn('Erreur lors du chargement des produits de collection:', error);
}

// Couleurs dérivées pour le thème de la collection
const colorMap: Record<string, { bg: string; light: string; border: string; text: string; badge: string }> = {
  '#dc2626': { bg: 'red', light: 'from-red-50 to-orange-50/50', border: 'border-red-200', text: 'text-red-700', badge: 'bg-red-100 text-red-800' },
  '#3b82f6': { bg: 'blue', light: 'from-blue-50 to-indigo-50/50', border: 'border-blue-200', text: 'text-blue-700', badge: 'bg-blue-100 text-blue-800' },
  '#16a34a': { bg: 'green', light: 'from-green-50 to-emerald-50/50', border: 'border-green-200', text: 'text-green-700', badge: 'bg-green-100 text-green-800' },
  '#f59e0b': { bg: 'amber', light: 'from-amber-50 to-yellow-50/50', border: 'border-amber-200', text: 'text-amber-700', badge: 'bg-amber-100 text-amber-800' },
  '#8b5cf6': { bg: 'purple', light: 'from-purple-50 to-violet-50/50', border: 'border-purple-200', text: 'text-purple-700', badge: 'bg-purple-100 text-purple-800' },
  '#06b6d4': { bg: 'cyan', light: 'from-cyan-50 to-sky-50/50', border: 'border-cyan-200', text: 'text-cyan-700', badge: 'bg-cyan-100 text-cyan-800' },
  '#ec4899': { bg: 'pink', light: 'from-pink-50 to-rose-50/50', border: 'border-pink-200', text: 'text-pink-700', badge: 'bg-pink-100 text-pink-800' },
  '#f97316': { bg: 'orange', light: 'from-orange-50 to-amber-50/50', border: 'border-orange-200', text: 'text-orange-700', badge: 'bg-orange-100 text-orange-800' },
};

const defaultTheme = { bg: 'blue', light: 'from-blue-50 to-indigo-50/50', border: 'border-blue-200', text: 'text-blue-700', badge: 'bg-blue-100 text-blue-800' };
const theme = colorMap[collection.color] || defaultTheme;
---

<BaseLayout
  title={collection.seoTitle}
  description={collection.seoDescription}
  keywords={collection.keywords.join(', ')}
>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-white">

    <!-- ============================================ -->
    <!-- BREADCRUMBS                                   -->
    <!-- ============================================ -->
    <nav class="container mx-auto px-4 pt-6 pb-2" aria-label="Fil d'Ariane">
      <ol class="flex items-center gap-2 text-sm text-gray-500 flex-wrap">
        <li>
          <a href="/" class="hover:text-gray-900 transition-colors duration-200 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            Accueil
          </a>
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
          <span class="font-medium text-gray-900">{collection.name}</span>
        </li>
      </ol>
    </nav>

    <!-- ============================================ -->
    <!-- HERO SECTION                                  -->
    <!-- ============================================ -->
    <section class={`relative py-12 md:py-16 lg:py-20 overflow-hidden bg-gradient-to-br ${theme.light}`}>
      <!-- Background decoration -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-0 right-0 w-80 h-80 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3" style={`background: ${collection.color}15`}></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4" style={`background: ${collection.color}10`}></div>
      </div>

      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center cl-fade-in">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium mb-6 border" style={`background: ${collection.color}10; border-color: ${collection.color}30; color: ${collection.color}`}>
            <span class="text-xl">{collection.icon}</span>
            <span>{items.length} article{items.length > 1 ? 's' : ''} disponibles</span>
          </div>

          <!-- Title -->
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold leading-tight tracking-tight text-gray-900 mb-6">
            {collection.name}
          </h1>

          <!-- Description -->
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl mx-auto mb-8">
            {collection.description}
          </p>

          <!-- Stats -->
          <div class="flex items-center justify-center gap-6 md:gap-10">
            <div class="flex items-center gap-2 text-gray-700">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background: ${collection.color}15`}>
                <svg class="w-5 h-5" style={`color: ${collection.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div class="text-left">
                <div class="text-lg font-bold text-gray-900">{items.length}</div>
                <div class="text-xs text-gray-500">Articles</div>
              </div>
            </div>
            <div class="w-px h-10 bg-gray-200"></div>
            <div class="flex items-center gap-2 text-gray-700">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background: ${collection.color}15`}>
                <svg class="w-5 h-5" style={`color: ${collection.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="text-left">
                <div class="text-lg font-bold text-gray-900">{totalReadingTime} min</div>
                <div class="text-xs text-gray-500">Lecture totale</div>
              </div>
            </div>
            <div class="w-px h-10 bg-gray-200"></div>
            <div class="flex items-center gap-2 text-gray-700">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center" style={`background: ${collection.color}15`}>
                <svg class="w-5 h-5" style={`color: ${collection.color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="text-left">
                <div class="text-lg font-bold text-gray-900">2026</div>
                <div class="text-xs text-gray-500">A jour</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Produit affilie en banniere apres le header -->
    {_headerProduct && (
      <div class="container mx-auto px-4 -mt-6 mb-8 relative z-10">
        <div class="max-w-4xl mx-auto">
          <AffiliateProduct
            productId={_headerProduct.id}
            placement="banner"
            context={{ category: collection.slug, keywords: collection.keywords, tags: [collection.slug] }}
            variant="featured"
            className="collection-banner-product"
          />
        </div>
      </div>
    )}

    <!-- ============================================ -->
    <!-- ARTICLES GRID                                 -->
    <!-- ============================================ -->
    <section class="py-12 md:py-16">
      <div class="container mx-auto px-4">
        <!-- Section header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10 cl-fade-in">
          <div>
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">
              Tous les articles
            </h2>
            <p class="text-gray-500 mt-1">
              {items.length} article{items.length > 1 ? 's' : ''} dans cette collection
            </p>
          </div>
          <div class="flex gap-2">
            <button class="cl-filter-btn active px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 border" data-filter="all">
              Tous
            </button>
            <button class="cl-filter-btn px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 border" data-filter="recent">
              Recents
            </button>
          </div>
        </div>

        <!-- Articles grid -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 max-w-7xl mx-auto">
          {items.map((article, index) => {
            const shouldShowProduct = index > 0 && (index + 1) % 4 === 0 && _sidebarProducts[Math.floor(index/4)];
            const productToShow = shouldShowProduct ? _sidebarProducts[Math.floor(index/4)] : null;

            // Preparer l'objet article pour ArticleCard : preferer l'original si disponible
            const articleForCard = article.__original || article;

            return (
              <>
                <div class={`cl-fade-in ${index < 3 ? '' : `cl-delay-${(index % 3) + 1}`}`}>
                  <ArticleCard
                    article={articleForCard}
                    collection={collection.slug}
                    categoryName={collection.name}
                    colors={{ bg: collection.color.replace('#',''), text: 'slate-900', badge: 'white' }}
                  />
                </div>

                {productToShow && (
                  <div class="cl-fade-in">
                    <AffiliateProduct
                      productId={productToShow.id}
                      placement="grid"
                      context={{ category: collection.slug, keywords: collection.keywords }}
                      variant="expanded"
                      className="collection-grid-product"
                    />
                  </div>
                )}
              </>
            );
          })}
        </div>

        <!-- Empty state -->
        {items.length === 0 && (
          <div class="text-center py-20">
            <div class="text-6xl mb-4">{collection.icon}</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Aucun article pour le moment</h3>
            <p class="text-gray-500 mb-6">Les articles de cette collection seront bientot disponibles.</p>
            <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-all duration-200">
              Retour a l'accueil
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Produit d'affiliation en vedette -->
    {_headerProduct && (
      <section class="py-12 bg-gray-50/80">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center cl-fade-in">
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight mb-6">Produit en vedette</h2>
            <AffiliateProduct product={_headerProduct} />
          </div>
        </div>
      </section>
    )}

    <!-- ============================================ -->
    <!-- PAGINATION                                    -->
    <!-- ============================================ -->
    {totalPages > 1 && (
      <nav class="container mx-auto px-4 py-8" aria-label="Pagination">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 max-w-7xl mx-auto border-t border-gray-200 pt-8">
          <p class="text-sm text-gray-500 font-medium">
            Page <span class="text-gray-900 font-bold">{currentPage}</span> sur <span class="text-gray-900 font-bold">{totalPages}</span>
          </p>
          <div class="flex gap-3">
            {currentPage > 1 && (
              <a href={`/collections/${collection.slug}/?page=${currentPage - 1}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-gray-200 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 hover:border-gray-300 transition-all duration-200 shadow-sm hover:shadow-md">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Precedent
              </a>
            )}
            {currentPage < totalPages && (
              <a href={`/collections/${collection.slug}/?page=${currentPage + 1}`} class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-all duration-200 shadow-sm hover:shadow-md">
                Suivant
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
            )}
          </div>
        </div>
      </nav>
    )}

    <!-- ============================================ -->
    <!-- BACK TO HOME CTA                              -->
    <!-- ============================================ -->
    <section class="py-12 md:py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center cl-fade-in">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-lg p-8 md:p-12">
            <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight mb-4">
              Explorez nos autres collections
            </h2>
            <p class="text-gray-600 mb-8 leading-relaxed">
              Decouvrez l'ensemble de nos guides sur les traitements GLP-1 : prix, effets secondaires, temoignages et conseils d'experts.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/" class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold rounded-2xl hover:from-blue-700 hover:to-blue-800 transition-all duration-300 shadow-lg shadow-blue-600/25 hover:shadow-xl hover:shadow-blue-600/30 hover:-translate-y-0.5">
                Voir toutes les collections
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
              <a href="/guides/quel-traitement-glp1-choisir/" class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-white border-2 border-gray-200 text-gray-800 font-semibold rounded-2xl hover:border-blue-300 hover:bg-blue-50/50 transition-all duration-300 shadow-sm hover:shadow-md hover:-translate-y-0.5">
                Quel traitement choisir ?
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Scroll-triggered fade-in animations (same pattern as homepage) */
  .cl-fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cl-fade-in.cl-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .cl-delay-1 { transition-delay: 0.1s; }
  .cl-delay-2 { transition-delay: 0.2s; }
  .cl-delay-3 { transition-delay: 0.3s; }

  /* Filter buttons */
  .cl-filter-btn {
    background: white;
    color: #64748b;
    border-color: #e2e8f0;
    cursor: pointer;
  }

  .cl-filter-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
    color: #334155;
  }

  .cl-filter-btn.active {
    background: #1e293b;
    color: white;
    border-color: #1e293b;
  }

  /* Smooth container */
  .container {
    max-width: 1200px;
  }

  /* Responsive adjustments for stats */
  @media (max-width: 640px) {
    .cl-stats-row {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .cl-fade-in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // Intersection Observer for scroll-triggered animations (same as homepage)
  document.addEventListener('DOMContentLoaded', function() {
    const fadeElements = document.querySelectorAll('.cl-fade-in');
    if (!fadeElements.length) return;

    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('cl-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    fadeElements.forEach(function(el) { observer.observe(el); });
  });

  // Filter buttons
  document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.cl-filter-btn');
    const articleCards = document.querySelectorAll('.cl-fade-in .group') as NodeListOf<HTMLElement>;

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        filterBtns.forEach(b => b.classList.remove('active'));
        (this as HTMLElement).classList.add('active');

        const filter = (this as HTMLElement).dataset.filter;

        // For now, all filters show all articles (same behavior as before)
        articleCards.forEach(card => {
          const parent = card.closest('.cl-fade-in') as HTMLElement;
          if (parent) {
            parent.style.display = filter === 'all' || filter === 'recent' ? '' : '';
          }
        });
      });
    });
  });
</script>
