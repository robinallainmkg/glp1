---
// Layout avancé avec système d'affiliation adaptatif (version sans TinaCMS)
import BaseLayout from './BaseLayout.astro';
import AdaptiveAffiliateDisplay from '../components/AdaptiveAffiliateDisplay.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

export interface Props {
  title?: string;
  description?: string;
  author?: string;
  image?: string;
  articleContent?: string;
  availableProducts?: any[];
  affiliateProducts?: any[];
  affiliateConfig?: any;
  showAffiliateSidebar?: boolean;
  hideArticleHeader?: boolean;
  disableInline?: boolean;
  article?: any;
  detectedCategory?: string;
  categoryIcon?: string;
  relatedArticles?: any[];
  config?: any;
  shouldInjectProducts?: boolean;
  category?: string;
  collection?: string;
  collectionName?: string;
  frontmatter?: any;
  children?: any;
  [key: string]: any;
}

// Props attendus par ce layout
const props: Props = Astro.props || {};
const article = props.article ?? null;

// Normalisation des champs
const title = props.title ?? (article?.data?.title || article?.title) ?? '';
const description = props.description ?? (article?.data?.description || article?.description) ?? '';
const author = props.author ?? (article?.data?.author || article?.author) ?? '';
const image = props.image ?? (article?.data?.image || article?.thumbnail || article?.image) ?? '';
const articleContent = props.articleContent ?? article?.body ?? '';
const availableProducts = props.availableProducts ?? props.affiliateProducts ?? [];
const detectedCategory = props.detectedCategory ?? props.category ?? (article?.data?.collection || article?.collection) ?? null;
const categoryIcon = props.categoryIcon ?? '💊';
const relatedArticles = props.relatedArticles ?? [];
const config = props.config ?? {};
const affiliateConfig = props.affiliateConfig ?? {};
const shouldInjectProducts = props.shouldInjectProducts ?? false;
const hideArticleHeader = props.hideArticleHeader ?? false;
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumb Navigation -->
  <nav class="breadcrumb" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 8px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
      <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; flex-wrap: wrap; color: #6b7280;">
        <a href="/" style="color: #3b82f6; text-decoration: none;">Accueil</a>
        {detectedCategory && (
          <>
            <span style="color: #cbd5e1;">/</span>
            <a href={`/collections/${detectedCategory}/`} style="color: #3b82f6; text-decoration: none;">
              {detectedCategory.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
            </a>
          </>
        )}
        <span style="color: #cbd5e1;">/</span>
        <span style="color: #9ca3af; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 400px;">{title}</span>
      </div>
    </div>
  </nav>

  <!-- Article Header -->
  {!hideArticleHeader && (
  <header class="article-header" style="background: linear-gradient(to bottom right, #f8fafc, #f5f3ff); border-bottom: 1px solid #e5e7eb; padding: 0.75rem 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1rem;">
      <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
        {image && (
          <img
            src={image}
            alt={title}
            style="width: 100px; height: 100px; object-fit: cover; border-radius: 12px; flex-shrink: 0;"
            loading="eager"
          />
        )}
        <div style="flex: 1; min-width: 0;">
          <h1 style="font-size: 1.4rem; font-weight: 700; color: #334155; margin: 0 0 0.4rem 0; line-height: 1.3;">
            {title}
          </h1>
          {description && (
            <p style="font-size: 0.9rem; color: #64748b; margin: 0 0 0.5rem 0; line-height: 1.5;">
              {description}
            </p>
          )}
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.8rem; color: #94a3b8;">
            {author && <span>{author}</span>}
            <span>5 min de lecture</span>
            <span>{(article?.data?.pubDate ? new Date(article.data.pubDate) : new Date()).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' })}</span>
          </div>
        </div>
      </div>
    </div>
  </header>
  )}

  <main class="adaptive-article-layout">
    <div class={`article-wrapper ${availableProducts.length > 0 ? 'has-sidebar' : ''}`}>
      <!-- Contenu principal de l'article -->
      <article class="article-content">
        <div class="article-body" id="article-content">
          <slot />
        </div>
      </article>
      
      <!-- Système d'affiliation adaptatif -->
      {availableProducts.length > 0 && (
        <AdaptiveAffiliateDisplay 
          affiliateProducts={availableProducts}
          config={affiliateConfig || config}
          disableInline={props.disableInline || false}
          forceSidebar={true}
          shouldInject={shouldInjectProducts}
        />
      )}
    </div>

    <!-- Articles connexes -->
    <RelatedArticles currentPath={Astro.url.pathname} maxLinks={6} />
  </main>
</BaseLayout>

<style>
/* Styles pour le layout avec affiliation */
.adaptive-article-layout {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem;
}

.article-wrapper {
  display: grid;
  gap: 2rem;
  grid-template-columns: 1fr;
}

.article-wrapper.has-sidebar {
  grid-template-columns: 1fr 300px;
}

.article-content {
  background: white;
  border-radius: 12px;
  padding: 1rem 2rem 2rem 2rem;
  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  border: 1px solid #e5e7eb;
}

.article-body {
  color: #374151;
  line-height: 1.75;
}

/* Masquer le premier H1 du contenu car il est déjà dans le header - :global() pour atteindre le slot */
:global(.article-body h1:first-of-type) {
  display: none !important;
}

/* Tous les H1 restants dans l'article affichés comme H2 */
:global(.article-body h1) {
  font-size: 1.875rem !important;
  color: #1f2937;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 1rem;
  margin-top: 1.5rem;
}

:global(.article-body h2), :global(.article-body h3) {
  color: #1f2937;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 1rem;
  margin-top: 1.5rem;
}

:global(.article-body h2) { font-size: 1.875rem; }
:global(.article-body h3) { font-size: 1.5rem; }

:global(.article-body p) {
  margin-bottom: 1.25rem;
}

:global(.article-body a) {
  color: #2563eb;
  text-decoration: underline;
}

:global(.article-body a:hover) {
  color: #1d4ed8;
}

:global(.article-body strong) {
  font-weight: 600;
  color: #1f2937;
}

:global(.article-body ul), :global(.article-body ol) {
  margin-bottom: 1.25rem;
  padding-left: 1.5rem;
}

:global(.article-body li) {
  margin-bottom: 0.5rem;
}

:global(.article-body blockquote) {
  border-left: 4px solid #3b82f6;
  background: #f8fafc;
  padding: 1rem 1.5rem;
  margin: 1.5rem 0;
  border-radius: 0 8px 8px 0;
}

:global(.article-body code) {
  background: #f1f5f9;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.875em;
}

:global(.article-body pre) {
  background: #1e293b;
  color: #e2e8f0;
  padding: 1rem;
  border-radius: 8px;
  overflow-x: auto;
  margin: 1.5rem 0;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* Styles pour les tableaux - responsive */
.article-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 1.5rem 0;
  font-size: 0.875rem;
  overflow-x: auto;
  display: block;
  white-space: nowrap;
}

.article-body thead,
.article-body tbody,
.article-body th,
.article-body td {
  display: block;
  width: 100%;
}

.article-body thead tr {
  position: absolute;
  top: -9999px;
  left: -9999px;
}

.article-body tr {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  margin-bottom: 1rem;
  display: block;
  background: white;
}

.article-body td {
  border: none;
  border-bottom: 1px solid #e5e7eb;
  position: relative;
  padding: 0.75rem;
  text-align: left;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.article-body td:before {
  content: attr(data-label) ": ";
  font-weight: bold;
  display: inline-block;
  width: 6rem;
  flex-shrink: 0;
}

/* Styles pour les images */
.article-body img {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  margin: 1rem 0;
}

/* Styles pour les sections spéciales */
.article-body .highlight-box {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border: 2px solid #f59e0b;
  border-radius: 12px;
  padding: 1.5rem;
  margin: 2rem 0;
  position: relative;
  overflow: hidden;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.article-body .highlight-box::before {
  content: '💡';
  position: absolute;
  top: -15px;
  left: 20px;
  background: white;
  padding: 8px;
  border-radius: 50%;
  border: 2px solid #f59e0b;
}

.article-body .warning-box {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  border: 2px solid #ef4444;
  border-radius: 12px;
  padding: 1.5rem;
  margin: 2rem 0;
  position: relative;
}

.article-body .warning-box::before {
  content: '⚠️';
  position: absolute;
  top: -15px;
  left: 20px;
  background: white;
  padding: 8px;
  border-radius: 50%;
  border: 2px solid #ef4444;
}

.article-body .success-box {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  border: 2px solid #10b981;
  border-radius: 12px;
  padding: 1.5rem;
  margin: 2rem 0;
  position: relative;
}

.article-body .success-box::before {
  content: '✅';
  position: absolute;
  top: -15px;
  left: 20px;
  background: white;
  padding: 8px;
  border-radius: 50%;
  border: 2px solid #10b981;
}

/* Animation d'entrée pour les éléments */
.article-body h2, .article-body h3, .article-body .highlight-box, .article-body .warning-box, .article-body .success-box {
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Styles pour les boutons CTA */
.article-body .cta-button {
  display: inline-block;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.3);
}

.article-body .cta-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 8px -1px rgba(59, 130, 246, 0.4);
}

@media (max-width: 1024px) {
  .article-wrapper.has-sidebar {
    grid-template-columns: 1fr;
  }
  
  .adaptive-article-layout {
    padding: 1rem;
  }
  
  .article-content {
    padding: 1.5rem;
  }
}

@media (max-width: 768px) {
  .article-content {
    padding: 1rem;
  }
  
  .article-body h1 { font-size: 1.875rem; }
  .article-body h2 { font-size: 1.5rem; }
  .article-body h3 { font-size: 1.25rem; }
  
  /* Prévention des débordements horizontaux */
  .article-body {
    overflow-x: hidden;
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  
  .article-body p,
  .article-body li,
  .article-body div {
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  
  .article-body code {
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: pre-wrap;
    max-width: 100%;
    display: inline-block;
  }
  
  .article-body pre {
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    overflow-x: auto;
  }
  
  /* Tableaux responsives sur mobile */
  .article-body table {
    font-size: 0.8rem;
  }
  
  .article-body td:before {
    width: 5rem;
    font-size: 0.75rem;
  }
  
  /* Images responsives */
  .article-body img {
    width: 100%;
    height: auto;
    max-width: 100%;
  }
  
  /* Listes améliorées */
  .article-body ul,
  .article-body ol {
    padding-left: 1rem;
  }
  
  .article-body li {
    margin-bottom: 0.5rem;
    padding-right: 0.5rem;
  }
  
  /* Citations responsives */
  .article-body blockquote {
    padding: 1rem;
    margin: 1rem 0;
    font-size: 0.9rem;
  }
}
</style>

<script>
  // Injection automatique des produits inline dans le contenu de l'article
  document.addEventListener('DOMContentLoaded', function() {
    const articleContent = document.getElementById('article-content');
    const inlineContainer = document.querySelector('.inline-products-container');

    if (!articleContent || !inlineContainer) return;

    // Récupérer tous les produits inline disponibles
    const inlineProducts = inlineContainer.querySelectorAll('.inline-affiliate-product');

    if (inlineProducts.length === 0) return;

    // Récupérer tous les paragraphes de l'article
    const paragraphs = articleContent.querySelectorAll('p');

    if (paragraphs.length < 3) return; // Pas assez de contenu

    // Configuration d'injection : 2ème, 5ème, 7ème paragraphe
    const injectionPoints = [2, 5, 7]; // Index basé sur 0 (donc 3ème, 6ème, 8ème paragraphe)

    let productIndex = 0;

    injectionPoints.forEach(paragraphIndex => {
      if (paragraphIndex < paragraphs.length && productIndex < inlineProducts.length) {
        const targetParagraph = paragraphs[paragraphIndex];
        const productToInject = inlineProducts[productIndex].cloneNode(true);

        // Insérer le produit après le paragraphe cible
        targetParagraph.parentNode.insertBefore(productToInject, targetParagraph.nextSibling);

        productIndex++;
      }
    });    // Cacher le conteneur original des produits inline (ils sont maintenant dans l'article)
    inlineContainer.style.display = 'none';
  });
</script>
