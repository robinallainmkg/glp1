---
// Layout avancé avec système d'affiliation adaptatif (version sans TinaCMS)
import BaseLayout from './BaseLayout.astro';
import AdaptiveAffiliateDisplay from '../components/AdaptiveAffiliateDisplay.astro';

export interface Props {
  title?: string;
  description?: string;
  author?: string;
  image?: string;
  articleContent?: string;
  availableProducts?: any[];
  affiliateProducts?: any[];
  affiliateConfig?: any;
  showAffiliateSidebar?: boolean;
  hideArticleHeader?: boolean;
  disableInline?: boolean;
  article?: any;
  detectedCategory?: string;
  categoryIcon?: string;
  relatedArticles?: any[];
  config?: any;
  shouldInjectProducts?: boolean;
  category?: string;
  collection?: string;
  collectionName?: string;
  frontmatter?: any;
  children?: any;
  [key: string]: any;
}

// Props attendus par ce layout
const props: Props = Astro.props || {};
const article = props.article ?? null;

// Normalisation des champs
const title = props.title ?? (article?.data?.title || article?.title) ?? '';
const description = props.description ?? (article?.data?.description || article?.description) ?? '';
const author = props.author ?? (article?.data?.author || article?.author) ?? '';
const image = props.image ?? (article?.data?.image || article?.thumbnail || article?.image) ?? '';
const articleContent = props.articleContent ?? article?.body ?? '';
const availableProducts = props.availableProducts ?? props.affiliateProducts ?? [];
const detectedCategory = props.detectedCategory ?? props.category ?? (article?.data?.collection || article?.collection) ?? null;
const categoryIcon = props.categoryIcon ?? '💊';
const relatedArticles = props.relatedArticles ?? [];
const config = props.config ?? {};
const affiliateConfig = props.affiliateConfig ?? {};
const shouldInjectProducts = props.shouldInjectProducts ?? false;
const hideArticleHeader = props.hideArticleHeader ?? false;
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumb Navigation -->
  <nav class="breadcrumb" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 12px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
      <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; flex-wrap: wrap;">
        <a href="/" style="color: #3b82f6; text-decoration: none; display: flex; align-items: center; gap: 4px;">
          <span>🏠</span>
          <span>Accueil</span>
        </a>
        <span style="color: #9ca3af;">→</span>
        {detectedCategory && (
          <>
            <a href={`/collections/${detectedCategory}/`} style="color: #3b82f6; text-decoration: none; display: flex; align-items: center; gap: 4px;">
              <span>{categoryIcon}</span>
              <span>{detectedCategory.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}</span>
            </a>
            <span style="color: #9ca3af;">→</span>
          </>
        )}
        <span style="color: #6b7280; display: flex; align-items: center; gap: 4px;">
          <span>📖</span>
          <span>{title}</span>
        </span>
      </div>
    </div>
  </nav>

  <!-- Article Header -->
  {!hideArticleHeader && (
  <header class="article-header bg-gradient-to-br from-slate-50 to-violet-50 border-b border-gray-200">
    <div class="container mx-auto px-4 py-6">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-6 items-center">
          <!-- Contenu textuel -->
          <div>
            <div class="flex items-center gap-3 mb-4 pt-2">
              <span class="text-2xl">{categoryIcon}</span>
              {detectedCategory && (
                <span class="px-2 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                  {detectedCategory.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
                </span>
              )}
            </div>
            <h1 class="text-2xl md:text-3xl font-bold mb-3 leading-tight text-slate-700">
              {title}
            </h1>
            <p class="text-base text-slate-700 opacity-90 mb-4 leading-relaxed">
              {description || `${title} — Guide complet marché français.`}
            </p>
            <div class="flex flex-wrap items-center gap-4 text-sm text-slate-700 opacity-75">
              {author && (
                <div class="flex items-center gap-2">
                  <span class="text-sm">✍️</span>
                  <span class="font-medium">{author}</span>
                </div>
              )}
              <div class="flex items-center gap-2">
                <span class="text-sm">⏱️</span>
                <span>5 min de lecture</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-sm">📅</span>
                <span>{new Date().toLocaleDateString('fr-FR', { 
                  day: '2-digit',
                  month: '2-digit', 
                  year: 'numeric' 
                })}</span>
              </div>
            </div>
          </div>
          
          <!-- Image de l'article -->
          {image && (
            <div class="lg:order-2">
              <div class="relative">
                <img 
                  src={image} 
                  alt={title}
                  class="w-full h-48 lg:h-64 object-cover rounded-xl shadow-lg"
                  loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent rounded-xl"></div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </header>
  )}

  <main class="adaptive-article-layout">
    <div class={`article-wrapper ${availableProducts.length > 0 ? 'has-sidebar' : ''}`}>
      <!-- Contenu principal de l'article -->
      <article class="article-content">
        <div class="article-body" id="article-content">
          <slot />
        </div>
      </article>
      
      <!-- Système d'affiliation adaptatif -->
      {availableProducts.length > 0 && (
        <AdaptiveAffiliateDisplay 
          affiliateProducts={availableProducts}
          config={affiliateConfig || config}
          disableInline={props.disableInline || false}
          forceSidebar={true}
          shouldInject={shouldInjectProducts}
        />
      )}
    </div>
  </main>
</BaseLayout>

<style>
/* Styles pour le layout avec affiliation */
.adaptive-article-layout {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.article-wrapper {
  display: grid;
  gap: 2rem;
  grid-template-columns: 1fr;
}

.article-wrapper.has-sidebar {
  grid-template-columns: 1fr 300px;
}

.article-content {
  background: white;
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  border: 1px solid #e5e7eb;
}

.article-body {
  color: #374151;
  line-height: 1.75;
}

.article-body h1, .article-body h2, .article-body h3 {
  color: #1f2937;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 1rem;
  margin-top: 2rem;
}

.article-body h1 { font-size: 2.25rem; }
.article-body h2 { font-size: 1.875rem; }
.article-body h3 { font-size: 1.5rem; }

.article-body p {
  margin-bottom: 1.25rem;
}

.article-body a {
  color: #2563eb;
  text-decoration: underline;
}

.article-body a:hover {
  color: #1d4ed8;
}

.article-body strong {
  font-weight: 600;
  color: #1f2937;
}

.article-body ul, .article-body ol {
  margin-bottom: 1.25rem;
  padding-left: 1.5rem;
}

.article-body li {
  margin-bottom: 0.5rem;
}

.article-body blockquote {
  border-left: 4px solid #3b82f6;
  background: #f8fafc;
  padding: 1rem 1.5rem;
  margin: 1.5rem 0;
  border-radius: 0 8px 8px 0;
}

.article-body code {
  background: #f1f5f9;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.875em;
}

.article-body pre {
  background: #1e293b;
  color: #e2e8f0;
  padding: 1rem;
  border-radius: 8px;
  overflow-x: auto;
  margin: 1.5rem 0;
}

/* Styles pour les sections spéciales */
.article-body .highlight-box {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border: 2px solid #f59e0b;
  border-radius: 12px;
  padding: 1.5rem;
  margin: 2rem 0;
  position: relative;
}

.article-body .highlight-box::before {
  content: '💡';
  position: absolute;
  top: -15px;
  left: 20px;
  background: white;
  padding: 8px;
  border-radius: 50%;
  border: 2px solid #f59e0b;
}

.article-body .warning-box {
  background: linear-gradient(135deg, #fee2e2, #fecaca);
  border: 2px solid #ef4444;
  border-radius: 12px;
  padding: 1.5rem;
  margin: 2rem 0;
  position: relative;
}

.article-body .warning-box::before {
  content: '⚠️';
  position: absolute;
  top: -15px;
  left: 20px;
  background: white;
  padding: 8px;
  border-radius: 50%;
  border: 2px solid #ef4444;
}

.article-body .success-box {
  background: linear-gradient(135deg, #d1fae5, #a7f3d0);
  border: 2px solid #10b981;
  border-radius: 12px;
  padding: 1.5rem;
  margin: 2rem 0;
  position: relative;
}

.article-body .success-box::before {
  content: '✅';
  position: absolute;
  top: -15px;
  left: 20px;
  background: white;
  padding: 8px;
  border-radius: 50%;
  border: 2px solid #10b981;
}

/* Animation d'entrée pour les éléments */
.article-body h2, .article-body h3, .article-body .highlight-box, .article-body .warning-box, .article-body .success-box {
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Styles pour les boutons CTA */
.article-body .cta-button {
  display: inline-block;
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
  color: white;
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.3);
}

.article-body .cta-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 8px -1px rgba(59, 130, 246, 0.4);
}

@media (max-width: 1024px) {
  .article-wrapper.has-sidebar {
    grid-template-columns: 1fr;
  }
  
  .adaptive-article-layout {
    padding: 1rem;
  }
  
  .article-content {
    padding: 1.5rem;
  }
}

@media (max-width: 768px) {
  .article-content {
    padding: 1rem;
  }
  
  .article-body h1 { font-size: 1.875rem; }
  .article-body h2 { font-size: 1.5rem; }
  .article-body h3 { font-size: 1.25rem; }
}
</style>

<script>
  // Injection automatique des produits inline dans le contenu de l'article
  document.addEventListener('DOMContentLoaded', function() {
    const articleContent = document.getElementById('article-content');
    const inlineContainer = document.querySelector('.inline-products-container');

    if (!articleContent || !inlineContainer) return;

    // Récupérer tous les produits inline disponibles
    const inlineProducts = inlineContainer.querySelectorAll('.inline-affiliate-product');

    if (inlineProducts.length === 0) return;

    // Récupérer tous les paragraphes de l'article
    const paragraphs = articleContent.querySelectorAll('p');

    if (paragraphs.length < 3) return; // Pas assez de contenu

    // Configuration d'injection : 2ème, 5ème, 7ème paragraphe
    const injectionPoints = [2, 5, 7]; // Index basé sur 0 (donc 3ème, 6ème, 8ème paragraphe)

    let productIndex = 0;

    injectionPoints.forEach(paragraphIndex => {
      if (paragraphIndex < paragraphs.length && productIndex < inlineProducts.length) {
        const targetParagraph = paragraphs[paragraphIndex];
        const productToInject = inlineProducts[productIndex].cloneNode(true);

        // Insérer le produit après le paragraphe cible
        targetParagraph.parentNode.insertBefore(productToInject, targetParagraph.nextSibling);

        productIndex++;
      }
    });    // Cacher le conteneur original des produits inline (ils sont maintenant dans l'article)
    inlineContainer.style.display = 'none';
  });
</script>
