---
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getAllAffiliateProducts } from '../lib/affiliate';

export async function getStaticPaths() {
  return [];
}

const { title, description } = Astro.props;

// Récupérer les produits d'affiliation pour la sidebar uniquement
const affiliateProducts = await getAllAffiliateProducts();
---

<html lang="fr">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>
<body class="bg-slate-50">
  <SiteHeader />

  <!-- Breadcrumb Navigation -->
  <nav class="breadcrumb" style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 12px 0;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 16px;">
      <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; flex-wrap: wrap;">
        <a href="/" style="color: #2d5a4e; text-decoration: none; display: flex; align-items: center; gap: 4px;">
          <span>🏠</span>
          <span>Accueil</span>
        </a>
        <span style="color: #9ca3af;">→</span>
        <span style="color: #6b7280; display: flex; align-items: center; gap: 4px;">
          <span>🎯</span>
          <span>{title}</span>
        </span>
      </div>
    </div>
  </nav>

  ---
// Layout qui combine un contenu principal avec une barre latérale d'affiliation
import { generateAffiliateLink } from '../utils/affiliateLinks';
  <div class="container mx-auto px-4 py-6">
    <div class="max-w-6xl mx-auto">
      <div class="grid lg:grid-cols-3 gap-6">
        <!-- Contenu principal (diagnostic) -->
        <div class="lg:col-span-2">
          <slot />
        </div>

        <!-- Sidebar d'affiliation uniquement -->
        <div class="lg:col-span-1">
          <div class="sticky top-6">
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
              <h3 class="text-lg font-semibold text-gray-800 mb-4">
                💊 Nos Recommandations
              </h3>
              <p class="text-gray-600 text-sm mb-4">
                Découvrez nos produits recommandés pour votre parcours GLP-1.
              </p>
              {affiliateProducts.slice(0, 3).map((product) => (
                <div class="mb-4 p-4 border border-gray-100 rounded-lg">
                  <h4 class="font-medium text-gray-800">{product.productName}</h4>
                  <p class="text-sm text-gray-600 mb-2">{product.brand}</p>
                  <a 
                    href={generateAffiliateLink(product)} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-block bg-blue-600 text-white px-4 py-2 rounded-md text-sm hover:bg-blue-700 transition-colors"
                  >
                    Découvrir →
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <SiteFooter />
</body>
</html>

<style>
  /* Styles pour le layout diagnostic */
  .diagnostic-layout {
    min-height: calc(100vh - 200px);
  }

  @media (max-width: 1024px) {
    .diagnostic-layout .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
