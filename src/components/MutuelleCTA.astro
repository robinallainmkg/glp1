---
// CTA Mutuelle — partenaire affiliation (Awin) pour les pages prix/remboursement.
// Cible : visiteurs en intention "budget / faire rembourser le GLP-1".
// CPA mutuelle : 50-150€/lead (vs 19€ Charles téléconsultation).
//
// L'URL pointe vers le comparateur interne en attendant l'approbation des programmes Awin
// (Magnolia.fr, Acheel, Apicil, Henner, Alan, Aesio, April).
// Quand un partenaire Awin est validé → remplacer la href par le lien deeplink Awin.

interface Props {
  context?: string;
}

const { context = "article" } = Astro.props;

// Lien comparateur interne — sera remplacé par Awin deeplink quand programmes approuvés
const comparateurLink = `/outils/comparateur-mutuelle-glp1/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=mutuelle_${context}`;
---

<div
  data-partner-block="cta"
  data-partner="mutuelle"
  class="mutuelle-cta-block"
>
  <div class="mutuelle-cta-icon">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0D4F73" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2 L20 6 V12 C20 16 16 20 12 22 C8 20 4 16 4 12 V6 Z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>
  </div>
  <div class="mutuelle-cta-content">
    <p class="mutuelle-cta-headline">
      Trouvez la mutuelle qui rembourse le mieux votre GLP-1
    </p>
    <p class="mutuelle-cta-lede">
      Wegovy et Mounjaro ne sont pas remboursés par la S&eacute;curit&eacute; sociale en 2026. Heureusement, certaines mutuelles (MGEN, Harmonie, Apicil, Alan, Acheel...) prennent en charge <strong>50 &agrave; 500 &euro;/an</strong>. Comparez les offres en 2 minutes.
    </p>

    <div class="mutuelle-cta-pricing">
      <span class="mutuelle-cta-price-label">&Eacute;conomie potentielle</span>
      <span class="mutuelle-cta-price-arrow">&rarr;</span>
      <span class="mutuelle-cta-price-new">jusqu'&agrave; 1&nbsp;800&nbsp;&euro;/an</span>
    </div>

    <a
      href={comparateurLink}
      rel="noopener sponsored"
      class="mutuelle-cta-button"
    >
      Comparer les mutuelles GLP-1 (gratuit)
      <span aria-hidden="true">&rarr;</span>
    </a>

    <p class="mutuelle-cta-trust">
      Comparateur ind&eacute;pendant &middot; Sans engagement &middot; Donn&eacute;es prot&eacute;g&eacute;es RGPD
    </p>
  </div>
</div>

<style>
  .mutuelle-cta-block {
    margin: 1.5rem 0;
    max-width: 100%;
    box-sizing: border-box;
    background: linear-gradient(135deg, #F0F9FF 0%, #E8F6FF 100%);
    border: 2px solid #0D4F73;
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex-wrap: wrap;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(13, 79, 115, 0.1);
  }
  .mutuelle-cta-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #0D4F73;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mutuelle-cta-content {
    flex: 1;
    min-width: 220px;
  }
  .mutuelle-cta-headline {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #0D4F73;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .mutuelle-cta-lede {
    margin: 0 0 0.85rem 0;
    font-size: 0.95rem;
    color: #1B6FA0;
    line-height: 1.55;
  }
  .mutuelle-cta-pricing {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0 0 1rem 0;
    background: #fff;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    border: 1px solid #0D4F73;
  }
  .mutuelle-cta-price-arrow {
    color: #6b7280;
    margin: 0 0.15rem;
  }
  .mutuelle-cta-price-new {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0D4F73;
    letter-spacing: -0.02em;
  }
  .mutuelle-cta-price-label {
    font-size: 0.85rem;
    color: #1B6FA0;
    font-weight: 600;
  }
  .mutuelle-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0D4F73;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 4px 12px rgba(13, 79, 115, 0.25);
  }
  .mutuelle-cta-button:hover {
    background: #083850;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(13, 79, 115, 0.35);
    color: #fff;
    text-decoration: none;
  }
  .mutuelle-cta-trust {
    margin: 0.85rem 0 0 0;
    font-size: 0.8rem;
    color: #1B6FA0;
    line-height: 1.4;
  }
  @media (max-width: 480px) {
    .mutuelle-cta-headline { font-size: 1.05rem; }
    .mutuelle-cta-button { width: 100%; justify-content: center; }
  }
</style>
