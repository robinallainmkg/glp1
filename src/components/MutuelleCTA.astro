---
// CTA Mutuelle — pointe vers le guide remboursement (article hub interne).
// Tant qu'aucun partenaire mutuelle Awin/Effiliation n'est actif, on reste honnête :
// le bouton dit "lire le guide", pas "voir les 6 mutuelles" (qui faisait croire à un comparateur).
//
// Quand LesFurets (Awin) ou Effiliation valide → remplacer ce composant par LesFuretsCTA
// (deeplink Awin réel) sur les pages prix/remboursement.

interface Props {
  context?: string;
}

const { context = "article" } = Astro.props;

// Hub article (interne) — explique calendrier Sécu, mutuelles favorables, démarches
const guideLink = `/collections/glp1-cout/wegovy-remboursement-mutuelle/?source=cta_mutuelle_${context}`;
---

<div
  data-partner-block="cta"
  data-partner="mutuelle"
  class="mutuelle-cta-block"
>
  <div class="mutuelle-cta-icon">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0D4F73" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2 L20 6 V12 C20 16 16 20 12 22 C8 20 4 16 4 12 V6 Z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>
  </div>
  <div class="mutuelle-cta-content">
    <p class="mutuelle-cta-headline">
      Wegovy &amp; Mounjaro : le guide remboursement 2026
    </p>
    <p class="mutuelle-cta-lede">
      Pas remboursés par la S&eacute;cu en 2026. Mais certaines mutuelles (MGEN, Harmonie, Apicil, Alan, Acheel...) prennent en charge <strong>50 &agrave; 500 &euro;/an</strong>. On d&eacute;taille les forfaits, le calendrier HAS, et la d&eacute;marche pour faire valider.
    </p>

    <div class="mutuelle-cta-pricing">
      <span class="mutuelle-cta-price-label">&Eacute;conomie potentielle</span>
      <span class="mutuelle-cta-price-arrow">&rarr;</span>
      <span class="mutuelle-cta-price-new">jusqu'&agrave; 1&nbsp;800&nbsp;&euro;/an</span>
    </div>

    <a
      href={guideLink}
      class="mutuelle-cta-button"
    >
      Lire le guide remboursement (5 min)
      <span aria-hidden="true">&rarr;</span>
    </a>

    <p class="mutuelle-cta-trust">
      Sources ANSM &middot; HAS &middot; Mis &agrave; jour 2026
    </p>
  </div>
</div>

<style>
  .mutuelle-cta-block {
    margin: 1.5rem 0;
    max-width: 100%;
    box-sizing: border-box;
    background: linear-gradient(135deg, #F0F9FF 0%, #E8F6FF 100%);
    border: 2px solid #0D4F73;
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex-wrap: wrap;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(13, 79, 115, 0.1);
  }
  .mutuelle-cta-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #0D4F73;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mutuelle-cta-content {
    flex: 1;
    min-width: 220px;
  }
  .mutuelle-cta-headline {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #0D4F73;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .mutuelle-cta-lede {
    margin: 0 0 0.85rem 0;
    font-size: 0.95rem;
    color: #1B6FA0;
    line-height: 1.55;
  }
  .mutuelle-cta-pricing {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0 0 1rem 0;
    background: #fff;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    border: 1px solid #0D4F73;
  }
  .mutuelle-cta-price-arrow {
    color: #6b7280;
    margin: 0 0.15rem;
  }
  .mutuelle-cta-price-new {
    font-size: 1.4rem;
    font-weight: 800;
    color: #0D4F73;
    letter-spacing: -0.02em;
  }
  .mutuelle-cta-price-label {
    font-size: 0.85rem;
    color: #1B6FA0;
    font-weight: 600;
  }
  .mutuelle-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #0D4F73;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 4px 12px rgba(13, 79, 115, 0.25);
  }
  .mutuelle-cta-button:hover {
    background: #083850;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(13, 79, 115, 0.35);
    color: #fff;
    text-decoration: none;
  }
  .mutuelle-cta-trust {
    margin: 0.85rem 0 0 0;
    font-size: 0.8rem;
    color: #1B6FA0;
    line-height: 1.4;
  }
  @media (max-width: 480px) {
    .mutuelle-cta-headline { font-size: 1.05rem; }
    .mutuelle-cta-button { width: 100%; justify-content: center; }
  }
</style>
