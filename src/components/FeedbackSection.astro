---
// Composant de feedback — soumission vers Supabase user_feedback
// Requiert : migration 009_feedback_system.sql appliquée sur Supabase
---

<section class="py-20 bg-gradient-to-br from-purple-50 to-pink-50">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Votre Avis Nous Aide
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Aidez-nous a ameliorer GLP-1 France en partageant votre experience ou vos questions
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <!-- Nous contacter -->
        <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:scale-[1.02] transition-transform duration-300">
          <div class="text-4xl mb-4">📩</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Nous Contacter</h3>
          <p class="text-gray-600 mb-4">
            Une question sur les traitements GLP-1 ? Ecrivez-nous directement.
          </p>
          <a
            href="mailto:contact@glp1-france.com?subject=Question%20GLP-1"
            class="block w-full bg-green-600 text-white font-semibold py-3 rounded-xl hover:bg-green-700 transition-colors text-center"
          >
            Envoyer un Email
          </a>
        </div>

        <!-- Sondage rapide -->
        <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:scale-[1.02] transition-transform duration-300">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Sondage Rapide</h3>
          <p class="text-gray-600 mb-4">
            2 minutes pour nous aider a mieux vous informer
          </p>
          <button
            type="button"
            data-feedback-type="survey"
            class="open-feedback-btn w-full bg-blue-600 text-white font-semibold py-3 rounded-xl hover:bg-blue-700 transition-colors"
          >
            Repondre au Sondage
          </button>
        </div>

        <!-- Temoignage -->
        <div class="bg-white rounded-2xl shadow-lg p-6 text-center hover:scale-[1.02] transition-transform duration-300">
          <div class="text-4xl mb-4">⭐</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Temoignage</h3>
          <p class="text-gray-600 mb-4">
            Partagez votre parcours GLP-1 pour aider d'autres personnes
          </p>
          <button
            type="button"
            data-feedback-type="testimonial"
            class="open-feedback-btn w-full bg-purple-600 text-white font-semibold py-3 rounded-xl hover:bg-purple-700 transition-colors"
          >
            Partager mon Histoire
          </button>
        </div>
      </div>

      <!-- Reassurance -->
      <div class="bg-white rounded-2xl shadow-lg p-6">
        <div class="grid grid-cols-3 gap-6 text-center">
          <div>
            <div class="text-2xl font-bold text-green-600 mb-1">🔒</div>
            <div class="text-sm text-gray-600">Donnees securisees</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-blue-600 mb-1">📋</div>
            <div class="text-sm text-gray-600">Anonyme par defaut</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-purple-600 mb-1">🤝</div>
            <div class="text-sm text-gray-600">Aide la communaute</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modal de feedback -->
<div id="feedbackModal" class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto">
    <div class="p-6">
      <div class="flex justify-between items-center mb-6">
        <h3 id="modalTitle" class="text-2xl font-bold text-gray-900"></h3>
        <button id="closeModalBtn" class="text-gray-400 hover:text-gray-600 text-2xl leading-none" aria-label="Fermer">&times;</button>
      </div>
      <div id="modalContent"></div>
    </div>
  </div>
</div>

<script>
(function () {
  // --- Configuration Supabase (anon key — safe client-side) ---
  const SUPABASE_URL = 'https://ywekaivgjzsmdocchvum.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl3ZWthaXZnanpzbWRvY2NodnVtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTUzNjQ0MDcsImV4cCI6MjA3MDk0MDQwN30.f2Mo-77InzZHnK1o7bMNs1ZC3DyX7EkPl964ksQTafY';

  // --- DOM references ---
  const modal = document.getElementById('feedbackModal');
  const modalTitle = document.getElementById('modalTitle');
  const modalContent = document.getElementById('modalContent');

  // --- Open modal ---
  function openFeedbackModal(type) {
    if (type === 'survey') {
      modalTitle.textContent = 'Sondage Rapide';
      modalContent.innerHTML = surveyFormHTML();
    } else if (type === 'testimonial') {
      modalTitle.textContent = 'Partagez votre Temoignage';
      modalContent.innerHTML = testimonialFormHTML();
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    // Bind form submit
    var form = modalContent.querySelector('form');
    if (form) {
      form.addEventListener('submit', function (e) { handleSubmit(e, type); });
    }
    // Bind rating buttons for survey
    if (type === 'survey') {
      modalContent.querySelectorAll('.rating-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var val = btn.getAttribute('data-value');
          document.getElementById('rating').value = val;
          modalContent.querySelectorAll('.rating-btn').forEach(function (b, i) {
            if (i < parseInt(val)) {
              b.classList.add('bg-yellow-100', 'border-yellow-400');
            } else {
              b.classList.remove('bg-yellow-100', 'border-yellow-400');
            }
          });
        });
      });
    }
  }

  // --- Close modal ---
  function closeFeedbackModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // --- Survey form HTML ---
  function surveyFormHTML() {
    return '<form class="space-y-4">' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Comment avez-vous decouvert notre site ?</label>' +
        '<select name="discovery" class="w-full p-3 border border-gray-300 rounded-lg" required>' +
          '<option value="">Choisir...</option>' +
          '<option value="google">Google</option>' +
          '<option value="social">Reseaux sociaux</option>' +
          '<option value="recommendation">Recommandation</option>' +
          '<option value="other">Autre</option>' +
        '</select>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Que recherchez-vous principalement ?</label>' +
        '<select name="interest" class="w-full p-3 border border-gray-300 rounded-lg" required>' +
          '<option value="">Choisir...</option>' +
          '<option value="price">Prix des traitements</option>' +
          '<option value="effects">Effets secondaires</option>' +
          '<option value="doctor">Trouver un medecin</option>' +
          '<option value="experience">Temoignages</option>' +
        '</select>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Notez la qualite de notre contenu (1-5)</label>' +
        '<div class="flex gap-2">' +
          [1,2,3,4,5].map(function (n) {
            return '<button type="button" class="rating-btn w-12 h-12 border-2 border-gray-300 rounded-lg hover:bg-yellow-100 text-sm font-semibold" data-value="' + n + '">' + n + '</button>';
          }).join('') +
        '</div>' +
        '<input type="hidden" name="rating" id="rating" required>' +
      '</div>' +
      '<button type="submit" class="w-full bg-blue-600 text-white font-semibold py-3 rounded-lg hover:bg-blue-700 transition-colors">Envoyer le Sondage</button>' +
    '</form>';
  }

  // --- Testimonial form HTML ---
  function testimonialFormHTML() {
    return '<form class="space-y-4">' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Prenom (public)</label>' +
        '<input type="text" name="name" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Ex: Marie" required>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Email (prive — pour vous recontacter)</label>' +
        '<input type="email" name="email" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="votre@email.com" required>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Votre parcours GLP-1</label>' +
        '<textarea name="story" rows="4" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Partagez votre experience : traitement suivi, resultats, conseils..." required></textarea>' +
      '</div>' +
      '<div class="text-sm text-gray-600 bg-blue-50 p-3 rounded-lg">' +
        '<strong>Votre temoignage pourra etre publie</strong> (avec votre accord) pour aider d\'autres personnes.' +
      '</div>' +
      '<button type="submit" class="w-full bg-purple-600 text-white font-semibold py-3 rounded-lg hover:bg-purple-700 transition-colors">Partager mon Temoignage</button>' +
    '</form>';
  }

  // --- Submit to Supabase ---
  async function handleSubmit(event, type) {
    event.preventDefault();
    var form = event.target;
    var submitBtn = form.querySelector('button[type="submit"]');
    var originalText = submitBtn.textContent;
    submitBtn.textContent = 'Envoi en cours...';
    submitBtn.disabled = true;

    var formData = new FormData(form);
    var payload = { type: type, page_url: window.location.pathname };

    if (type === 'survey') {
      payload.discovery = formData.get('discovery');
      payload.interest = formData.get('interest');
      payload.rating = parseInt(formData.get('rating')) || null;
    } else if (type === 'testimonial') {
      payload.name = formData.get('name');
      payload.email = formData.get('email');
      payload.story = formData.get('story');
    }

    try {
      var response = await fetch(SUPABASE_URL + '/rest/v1/user_feedback', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(payload)
      });

      if (response.ok || response.status === 201) {
        showSuccess(type);
      } else {
        throw new Error('HTTP ' + response.status);
      }
    } catch (err) {
      console.error('Feedback submit error:', err);
      showError(submitBtn, originalText);
    }
  }

  // --- Success state ---
  function showSuccess(type) {
    var msg = type === 'survey'
      ? 'Votre avis nous aide a ameliorer le site. Merci !'
      : 'Nous reviendrons vers vous rapidement. Merci pour votre temoignage !';
    modalContent.innerHTML =
      '<div class="text-center py-8">' +
        '<div class="text-6xl mb-4">✅</div>' +
        '<h3 class="text-2xl font-bold text-green-600 mb-4">Merci !</h3>' +
        '<p class="text-gray-600 mb-6">' + msg + '</p>' +
        '<button id="successCloseBtn" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors">Fermer</button>' +
      '</div>';
    document.getElementById('successCloseBtn').addEventListener('click', closeFeedbackModal);
    setTimeout(closeFeedbackModal, 4000);
  }

  // --- Error state ---
  function showError(btn, originalText) {
    btn.textContent = 'Erreur — Reessayer';
    btn.disabled = false;
    btn.classList.add('bg-red-600');
    btn.classList.remove('bg-blue-600', 'bg-purple-600');
    setTimeout(function () {
      btn.textContent = originalText;
      btn.classList.remove('bg-red-600');
      btn.classList.add(originalText.includes('Sondage') ? 'bg-blue-600' : 'bg-purple-600');
    }, 3000);
  }

  // --- Event listeners ---
  document.querySelectorAll('.open-feedback-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openFeedbackModal(btn.getAttribute('data-feedback-type'));
    });
  });

  document.getElementById('closeModalBtn').addEventListener('click', closeFeedbackModal);

  modal.addEventListener('click', function (e) {
    if (e.target === modal) closeFeedbackModal();
  });

  // Fermer avec Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeFeedbackModal();
    }
  });
})();
</script>
