---
// Composant de feedback — soumission vers Supabase user_feedback
// Requiert : migration 009_feedback_system.sql appliquée sur Supabase
---

<section style="padding:4rem 1.5rem;background:#fff;">
  <div style="max-width:900px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:2rem;">
      <h2 style="font-size:clamp(1.5rem,3vw,2.2rem);font-weight:800;color:#1a3c34;margin-bottom:.5rem;">
        Votre avis nous aide
      </h2>
      <p style="color:#6b7280;font-size:.95rem;">
        Aidez-nous à améliorer GLP-1 France en partageant votre expérience ou vos questions.
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.5rem;" class="hp-feedback-grid">
      <!-- Nous contacter -->
      <a href="mailto:contact@glp1-france.com?subject=Question%20GLP-1" style="text-decoration:none;background:#f8faf9;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;text-align:center;transition:all .2s;display:block;" class="hp-feedback-card">
        <div style="width:40px;height:40px;background:#dcfce7;border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto .8rem;">
          <svg width="20" height="20" fill="none" stroke="#166534" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 style="font-size:1rem;font-weight:700;color:#1a3c34;margin-bottom:.3rem;">Nous contacter</h3>
        <p style="font-size:.82rem;color:#6b7280;line-height:1.4;margin-bottom:.8rem;">Une question sur les traitements GLP-1 ? Écrivez-nous.</p>
        <span style="display:inline-block;background:#1a3c34;color:#fff;padding:.45rem 1.2rem;border-radius:8px;font-size:.82rem;font-weight:600;">Envoyer un email</span>
      </a>

      <!-- Sondage rapide -->
      <div style="background:#f8faf9;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;text-align:center;transition:all .2s;cursor:pointer;" class="hp-feedback-card">
        <div style="width:40px;height:40px;background:#dbeafe;border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto .8rem;">
          <svg width="20" height="20" fill="none" stroke="#1e40af" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        </div>
        <h3 style="font-size:1rem;font-weight:700;color:#1a3c34;margin-bottom:.3rem;">Sondage rapide</h3>
        <p style="font-size:.82rem;color:#6b7280;line-height:1.4;margin-bottom:.8rem;">2 minutes pour nous aider à mieux vous informer.</p>
        <button type="button" data-feedback-type="survey" class="open-feedback-btn" style="background:#2d5a4e;color:#fff;padding:.45rem 1.2rem;border-radius:8px;font-size:.82rem;font-weight:600;border:none;cursor:pointer;">Répondre au sondage</button>
      </div>

      <!-- Temoignage -->
      <div style="background:#f8faf9;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;text-align:center;transition:all .2s;cursor:pointer;" class="hp-feedback-card">
        <div style="width:40px;height:40px;background:#fef3c7;border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto .8rem;">
          <svg width="20" height="20" fill="none" stroke="#92400e" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
        </div>
        <h3 style="font-size:1rem;font-weight:700;color:#1a3c34;margin-bottom:.3rem;">Témoignage</h3>
        <p style="font-size:.82rem;color:#6b7280;line-height:1.4;margin-bottom:.8rem;">Partagez votre parcours GLP-1 pour aider d'autres personnes.</p>
        <button type="button" data-feedback-type="testimonial" class="open-feedback-btn" style="background:#2d5a4e;color:#fff;padding:.45rem 1.2rem;border-radius:8px;font-size:.82rem;font-weight:600;border:none;cursor:pointer;">Partager mon histoire</button>
      </div>
    </div>

    <!-- Reassurance -->
    <div style="display:flex;justify-content:center;gap:2.5rem;flex-wrap:wrap;padding:.8rem 0;color:#9ca3af;font-size:.78rem;">
      <div style="display:flex;align-items:center;gap:.35rem;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Données sécurisées
      </div>
      <div style="display:flex;align-items:center;gap:.35rem;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Anonyme par défaut
      </div>
      <div style="display:flex;align-items:center;gap:.35rem;">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Aide la communauté
      </div>
    </div>
  </div>
</section>

<style>
  .hp-feedback-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.08); border-color: #bbf7d0 !important; }
  @media(max-width:768px) { .hp-feedback-grid { grid-template-columns: 1fr !important; } }
</style>

<!-- Modal de feedback -->
<div id="feedbackModal" class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto">
    <div class="p-6">
      <div class="flex justify-between items-center mb-6">
        <h3 id="modalTitle" class="text-2xl font-bold text-gray-900"></h3>
        <button id="closeModalBtn" class="text-gray-400 hover:text-gray-600 text-2xl leading-none" aria-label="Fermer">&times;</button>
      </div>
      <div id="modalContent"></div>
    </div>
  </div>
</div>

<script>
(function () {
  // --- Configuration Supabase (anon key — safe client-side) ---
  const SUPABASE_URL = 'https://ywekaivgjzsmdocchvum.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl3ZWthaXZnanpzbWRvY2NodnVtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTUzNjQ0MDcsImV4cCI6MjA3MDk0MDQwN30.f2Mo-77InzZHnK1o7bMNs1ZC3DyX7EkPl964ksQTafY';

  // --- DOM references ---
  const modal = document.getElementById('feedbackModal');
  const modalTitle = document.getElementById('modalTitle');
  const modalContent = document.getElementById('modalContent');

  // --- Open modal ---
  function openFeedbackModal(type) {
    if (type === 'survey') {
      modalTitle.textContent = 'Sondage Rapide';
      modalContent.innerHTML = surveyFormHTML();
    } else if (type === 'testimonial') {
      modalTitle.textContent = 'Partagez votre Temoignage';
      modalContent.innerHTML = testimonialFormHTML();
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    // Bind form submit
    var form = modalContent.querySelector('form');
    if (form) {
      form.addEventListener('submit', function (e) { handleSubmit(e, type); });
    }
    // Bind rating buttons for survey
    if (type === 'survey') {
      modalContent.querySelectorAll('.rating-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var val = btn.getAttribute('data-value');
          document.getElementById('rating').value = val;
          modalContent.querySelectorAll('.rating-btn').forEach(function (b, i) {
            if (i < parseInt(val)) {
              b.classList.add('bg-yellow-100', 'border-yellow-400');
            } else {
              b.classList.remove('bg-yellow-100', 'border-yellow-400');
            }
          });
        });
      });
    }
  }

  // --- Close modal ---
  function closeFeedbackModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // --- Survey form HTML ---
  function surveyFormHTML() {
    return '<form class="space-y-4">' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Comment avez-vous decouvert notre site ?</label>' +
        '<select name="discovery" class="w-full p-3 border border-gray-300 rounded-lg" required>' +
          '<option value="">Choisir...</option>' +
          '<option value="google">Google</option>' +
          '<option value="social">Reseaux sociaux</option>' +
          '<option value="recommendation">Recommandation</option>' +
          '<option value="other">Autre</option>' +
        '</select>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Que recherchez-vous principalement ?</label>' +
        '<select name="interest" class="w-full p-3 border border-gray-300 rounded-lg" required>' +
          '<option value="">Choisir...</option>' +
          '<option value="price">Prix des traitements</option>' +
          '<option value="effects">Effets secondaires</option>' +
          '<option value="doctor">Trouver un medecin</option>' +
          '<option value="experience">Temoignages</option>' +
        '</select>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Notez la qualite de notre contenu (1-5)</label>' +
        '<div class="flex gap-2">' +
          [1,2,3,4,5].map(function (n) {
            return '<button type="button" class="rating-btn w-12 h-12 border-2 border-gray-300 rounded-lg hover:bg-yellow-100 text-sm font-semibold" data-value="' + n + '">' + n + '</button>';
          }).join('') +
        '</div>' +
        '<input type="hidden" name="rating" id="rating" required>' +
      '</div>' +
      '<button type="submit" class="w-full bg-emerald-700 text-white font-semibold py-3 rounded-lg hover:bg-emerald-800 transition-colors">Envoyer le Sondage</button>' +
    '</form>';
  }

  // --- Testimonial form HTML ---
  function testimonialFormHTML() {
    return '<form class="space-y-4">' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Prenom (public)</label>' +
        '<input type="text" name="name" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Ex: Marie" required>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Email (prive — pour vous recontacter)</label>' +
        '<input type="email" name="email" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="votre@email.com" required>' +
      '</div>' +
      '<div>' +
        '<label class="block text-sm font-medium text-gray-700 mb-2">Votre parcours GLP-1</label>' +
        '<textarea name="story" rows="4" class="w-full p-3 border border-gray-300 rounded-lg" placeholder="Partagez votre experience : traitement suivi, resultats, conseils..." required></textarea>' +
      '</div>' +
      '<div class="text-sm text-gray-600 bg-emerald-50 p-3 rounded-lg">' +
        '<strong>Votre temoignage pourra etre publie</strong> (avec votre accord) pour aider d\'autres personnes.' +
      '</div>' +
      '<button type="submit" class="w-full bg-emerald-700 text-white font-semibold py-3 rounded-lg hover:bg-emerald-800 transition-colors">Partager mon Temoignage</button>' +
    '</form>';
  }

  // --- Submit to Supabase ---
  async function handleSubmit(event, type) {
    event.preventDefault();
    var form = event.target;
    var submitBtn = form.querySelector('button[type="submit"]');
    var originalText = submitBtn.textContent;
    submitBtn.textContent = 'Envoi en cours...';
    submitBtn.disabled = true;

    var formData = new FormData(form);
    var payload = { type: type, page_url: window.location.pathname };

    if (type === 'survey') {
      payload.discovery = formData.get('discovery');
      payload.interest = formData.get('interest');
      payload.rating = parseInt(formData.get('rating')) || null;
    } else if (type === 'testimonial') {
      payload.name = formData.get('name');
      payload.email = formData.get('email');
      payload.story = formData.get('story');
    }

    try {
      var response = await fetch(SUPABASE_URL + '/rest/v1/user_feedback', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_ANON_KEY,
          'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
          'Prefer': 'return=minimal'
        },
        body: JSON.stringify(payload)
      });

      if (response.ok || response.status === 201) {
        showSuccess(type);
      } else {
        throw new Error('HTTP ' + response.status);
      }
    } catch (err) {
      console.error('Feedback submit error:', err);
      showError(submitBtn, originalText);
    }
  }

  // --- Success state ---
  function showSuccess(type) {
    var msg = type === 'survey'
      ? 'Votre avis nous aide a ameliorer le site. Merci !'
      : 'Nous reviendrons vers vous rapidement. Merci pour votre temoignage !';
    modalContent.innerHTML =
      '<div class="text-center py-8">' +
        '<div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4"><svg width="32" height="32" fill="none" stroke="#166534" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>' +
        '<h3 class="text-2xl font-bold text-emerald-700 mb-4">Merci !</h3>' +
        '<p class="text-gray-600 mb-6">' + msg + '</p>' +
        '<button id="successCloseBtn" class="bg-emerald-700 text-white px-6 py-3 rounded-lg hover:bg-emerald-800 transition-colors">Fermer</button>' +
      '</div>';
    document.getElementById('successCloseBtn').addEventListener('click', closeFeedbackModal);
    setTimeout(closeFeedbackModal, 4000);
  }

  // --- Error state ---
  function showError(btn, originalText) {
    btn.textContent = 'Erreur — Reessayer';
    btn.disabled = false;
    btn.classList.add('bg-red-600');
    btn.classList.remove('bg-emerald-700');
    setTimeout(function () {
      btn.textContent = originalText;
      btn.classList.remove('bg-red-600');
      btn.classList.add('bg-emerald-700');
    }, 3000);
  }

  // --- Event listeners ---
  document.querySelectorAll('.open-feedback-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      openFeedbackModal(btn.getAttribute('data-feedback-type'));
    });
  });

  document.getElementById('closeModalBtn').addEventListener('click', closeFeedbackModal);

  modal.addEventListener('click', function (e) {
    if (e.target === modal) closeFeedbackModal();
  });

  // Fermer avec Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeFeedbackModal();
    }
  });
})();
</script>
