---
// CTA Charles — téléconsultation spécialiste + ordonnance si éligible (CPA 19€, prix patient 35€)
interface Props {
  context?: string;
}

const { context = "article" } = Astro.props;
const charlesBase = "https://poids.charles.co/?utm_source=affiliation&utm_medium=glp1france";
const charlesLink = `${charlesBase}&utm_campaign=partenariat_${context}`;
---

<div
  data-partner-block="cta"
  data-partner="charles"
  style="margin:1.5rem 0;max-width:100%;box-sizing:border-box;background:#F8F3E9;border:1px solid #1a1a1a;border-radius:14px;padding:1.5rem 1.25rem;display:flex;align-items:flex-start;gap:1.25rem;flex-wrap:wrap;overflow:hidden;"
>
  <div style="flex-shrink:0;width:52px;height:52px;border-radius:50%;background:#1a1a1a;display:flex;align-items:center;justify-content:center;">
    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F8F3E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
      <line x1="8" y1="21" x2="16" y2="21"/>
      <line x1="12" y1="17" x2="12" y2="21"/>
      <path d="M8 10h.01M12 10h.01M16 10h.01"/>
    </svg>
  </div>
  <div style="flex:1;min-width:220px;">
    <p style="margin:0 0 .5rem 0;font-size:1.1rem;font-weight:700;color:#1a1a1a;line-height:1.3;">
      T&eacute;l&eacute;consultation sp&eacute;cialiste &mdash; ordonnance si &eacute;ligible
    </p>
    <p style="margin:0 0 .6rem 0;font-size:.95rem;color:#3a3a3a;line-height:1.55;">
      Charles est une clinique digitale&nbsp;: m&eacute;decins sp&eacute;cialistes fran&ccedil;ais, t&eacute;l&eacute;consultation et prescription de traitements si votre profil est &eacute;ligible.
    </p>
    <p style="margin:0 0 1rem 0;font-size:.85rem;color:#1a1a1a;line-height:1.4;font-weight:600;background:#fff;display:inline-block;padding:.3rem .7rem;border-radius:6px;border:1px solid #1a1a1a;">
      35&euro; la t&eacute;l&eacute;consultation &middot; moyenne 80&euro; en cabinet
    </p>
    <a
      href={charlesLink}
      rel="noopener sponsored"
      target="_blank"
      style="display:inline-block;background:#1a1a1a;color:#F8F3E9;font-size:.95rem;font-weight:600;padding:.7rem 1.4rem;border-radius:8px;text-decoration:none;transition:background .2s;"
    >
      V&eacute;rifier mon &eacute;ligibilit&eacute; &rarr;
    </a>
    <p style="margin:.75rem 0 0 0;font-size:.8rem;color:#6b6b6b;line-height:1.4;">
      M&eacute;decins sp&eacute;cialistes fran&ccedil;ais &middot; H&eacute;bergeur agr&eacute;&eacute; donn&eacute;es de sant&eacute; &middot; Suivi inclus
    </p>
  </div>
</div>
