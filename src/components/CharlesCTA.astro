---
// CTA Charles — téléconsultation spécialiste + ordonnance si éligible (CPA 19€, prix patient 35€)
interface Props {
  context?: string;
}

const { context = "article" } = Astro.props;
const charlesBase = "https://poids.charles.co/?utm_source=affiliation&utm_medium=glp1france";
const charlesLink = `${charlesBase}&utm_campaign=partenariat_${context}`;
---

<div
  data-partner-block="cta"
  data-partner="charles"
  class="charles-cta-block"
>
  <div class="charles-cta-icon">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F8F3E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
      <line x1="8" y1="21" x2="16" y2="21"/>
      <line x1="12" y1="17" x2="12" y2="21"/>
      <path d="M8 10h.01M12 10h.01M16 10h.01"/>
    </svg>
  </div>
  <div class="charles-cta-content">
    <p class="charles-cta-headline">
      Obtenez votre ordonnance GLP-1 en t&eacute;l&eacute;consultation
    </p>
    <p class="charles-cta-lede">
      M&eacute;decins sp&eacute;cialistes fran&ccedil;ais. Si votre profil est &eacute;ligible, vous repartez avec une ordonnance et un suivi inclus &mdash; sans attendre des mois un rendez-vous.
    </p>

    <div class="charles-cta-pricing">
      <span class="charles-cta-price-strike">80&euro;</span>
      <span class="charles-cta-price-label">en cabinet</span>
      <span class="charles-cta-price-arrow">&rarr;</span>
      <span class="charles-cta-price-new">35&euro;</span>
      <span class="charles-cta-price-label">en ligne</span>
    </div>

    <a
      href={charlesLink}
      rel="noopener sponsored"
      target="_blank"
      class="charles-cta-button"
    >
      D&eacute;marrer ma t&eacute;l&eacute;consultation &mdash; 35&nbsp;&euro;
      <span aria-hidden="true">&rarr;</span>
    </a>

    <p class="charles-cta-trust">
      M&eacute;decins sp&eacute;cialistes fran&ccedil;ais &middot; H&eacute;bergeur agr&eacute;&eacute; donn&eacute;es de sant&eacute; &middot; Suivi inclus
    </p>
  </div>
</div>

<style>
  .charles-cta-block {
    margin: 1.5rem 0;
    max-width: 100%;
    box-sizing: border-box;
    background: linear-gradient(135deg, #F8F3E9 0%, #F2EADA 100%);
    border: 2px solid #1a1a1a;
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex-wrap: wrap;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(26, 26, 26, 0.08);
  }
  .charles-cta-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .charles-cta-content {
    flex: 1;
    min-width: 220px;
  }
  .charles-cta-headline {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .charles-cta-lede {
    margin: 0 0 0.85rem 0;
    font-size: 0.95rem;
    color: #3a3a3a;
    line-height: 1.55;
  }
  .charles-cta-pricing {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0 0 1rem 0;
    background: #fff;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    border: 1px solid #1a1a1a;
  }
  .charles-cta-price-strike {
    font-size: 0.95rem;
    color: #9a9a9a;
    text-decoration: line-through;
    font-weight: 600;
  }
  .charles-cta-price-arrow {
    color: #6b6b6b;
    margin: 0 0.15rem;
  }
  .charles-cta-price-new {
    font-size: 1.5rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: -0.02em;
  }
  .charles-cta-price-label {
    font-size: 0.78rem;
    color: #6b6b6b;
    font-weight: 500;
  }
  .charles-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #1a1a1a;
    color: #F8F3E9;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 4px 12px rgba(26, 26, 26, 0.25);
  }
  .charles-cta-button:hover {
    background: #000;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(26, 26, 26, 0.35);
    color: #F8F3E9;
    text-decoration: none;
  }
  .charles-cta-trust {
    margin: 0.85rem 0 0 0;
    font-size: 0.8rem;
    color: #6b6b6b;
    line-height: 1.4;
  }
  @media (max-width: 480px) {
    .charles-cta-headline { font-size: 1.05rem; }
    .charles-cta-button { width: 100%; justify-content: center; }
  }
</style>
