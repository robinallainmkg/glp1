---
export interface Props {
  title: string;
  description: string;
  author?: string;
  pubDate?: Date;
  image?: string;
  url: string;
  siteUrl: string;
  collection?: string;
}

const { title, description, author, pubDate, image, url, siteUrl, collection } = Astro.props;

// Article schema
const articleSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": new URL(url, siteUrl).href,
  "publisher": {
    "@type": "Organization",
    "name": "GLP-1 France",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/favicon.svg", siteUrl).href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(url, siteUrl).href
  }
};

if (author) {
  articleSchema.author = { "@type": "Person", "name": author };
}
if (pubDate) {
  articleSchema.datePublished = pubDate.toISOString().split('T')[0];
  articleSchema.dateModified = pubDate.toISOString().split('T')[0];
}
if (image) {
  articleSchema.image = new URL(image, siteUrl).href;
}

// BreadcrumbList schema
const breadcrumbItems: any[] = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Accueil",
    "item": siteUrl
  }
];

if (collection) {
  const collectionLabel = collection.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": collectionLabel,
    "item": new URL(`/collections/${collection}/`, siteUrl).href
  });
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 3,
    "name": title
  });
} else {
  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": title
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
