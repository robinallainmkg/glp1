---
import '../styles/global.css';
---

<footer class="site-footer text-white" role="contentinfo" aria-label="Pied de page" style="background:#1a3c34;">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Section principale -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-3" aria-label="GLP-1 France, page d'accueil">
          <span style="width:10px;height:10px;border-radius:50%;background:#6ee7a0;display:inline-block;"></span>
          <span class="font-bold text-lg text-white" style="letter-spacing:-.02em;">GLP-1 France</span>
        </a>
        <p class="text-gray-300 text-sm mb-4">Guide pratique et ressources sur les traitements GLP-1 en France.</p>

        <!-- Newsletter -->
        <div>
          <p class="font-medium text-white mb-2">Newsletter</p>
          <form action="#" method="post" class="flex gap-2" aria-label="Formulaire d'inscription à la newsletter">
            <label for="footer-email" class="sr-only">Votre adresse email</label>
            <input id="footer-email" name="email" type="email" required placeholder="Votre email" class="w-full p-2 rounded-md text-gray-800 text-sm" autocomplete="email" />
            <button class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors duration-150 whitespace-nowrap" type="submit" aria-label="S'inscrire à la newsletter">S'inscrire</button>
          </form>
        </div>
      </div>

      <!-- Traitements et Guides -->
      <div>
        <p class="font-medium text-white mb-4">Traitements GLP-1</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/collections/traitements-glp1/" class="text-gray-300 hover:text-white transition-colors">Tous les traitements</a></li>
          <li><a href="/collections/traitements-glp1/guide-complet-ozempic/" class="text-gray-300 hover:text-white transition-colors">Guide complet Ozempic</a></li>
          <li><a href="/collections/traitements-glp1/guide-complet-wegovy/" class="text-gray-300 hover:text-white transition-colors">Guide complet Wegovy</a></li>
          <li><a href="/collections/traitements-glp1/guide-complet-saxenda/" class="text-gray-300 hover:text-white transition-colors">Guide complet Saxenda</a></li>
          <li><a href="/guides/quel-traitement-glp1-choisir/" class="text-gray-300 hover:text-white transition-colors">Quel traitement choisir ?</a></li>
        </ul>
      </div>

      <!-- Prix et Prise en charge -->
      <div>
        <p class="font-medium text-white mb-4">Prix & Remboursement</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/collections/glp1-cout/" class="text-gray-300 hover:text-white transition-colors">Tous les prix</a></li>
          <li><a href="/collections/glp1-cout/prix-ozempic-france/" class="text-gray-300 hover:text-white transition-colors">Prix Ozempic</a></li>
          <li><a href="/collections/glp1-cout/prix-wegovy-france/" class="text-gray-300 hover:text-white transition-colors">Prix Wegovy</a></li>
          <li><a href="/collections/glp1-cout/wegovy-remboursement-mutuelle/" class="text-gray-300 hover:text-white transition-colors">Remboursement</a></li>
          <li><a href="/collections/glp1-cout/acheter-wegovy-en-france/" class="text-gray-300 hover:text-white transition-colors">Acheter en France</a></li>
        </ul>
      </div>

      <!-- Effets secondaires et Médecins -->
      <div>
        <p class="font-medium text-white mb-4">Sécurité & Suivi</p>
        <ul class="space-y-2 text-sm">
          <li><a href="/collections/effets-secondaires-glp1/" class="text-gray-300 hover:text-white transition-colors">Effets secondaires</a></li>
          <li><a href="/collections/medecins-glp1-france/" class="text-gray-300 hover:text-white transition-colors">Trouver un médecin</a></li>
          <li><a href="/collections/recherche-glp1/" class="text-gray-300 hover:text-white transition-colors">Recherche clinique</a></li>
          <li><a href="/collections/alternatives-glp1/" class="text-gray-300 hover:text-white transition-colors">Alternatives naturelles</a></li>
          <li><a href="/collections/regime-glp1/" class="text-gray-300 hover:text-white transition-colors">Régimes adaptés</a></li>
        </ul>
      </div>
    </div>

    <!-- Section secondaire avec plus de liens -->
    <div class="border-t border-white/10 mt-8 pt-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Pharmacies (NEW) -->
        <div>
          <p class="font-medium text-white mb-3">Pharmacies & Prix</p>
          <ul class="space-y-1 text-sm">
            <li><a href="/outils/carte-prix-pharmacies/" class="text-gray-300 hover:text-white transition-colors">🗺️ Carte des prix</a></li>
            <li><a href="/pharmacies/" class="text-gray-300 hover:text-white transition-colors">Pharmacies par ville</a></li>
            <li><a href="/pharmacies/paris/" class="text-gray-300 hover:text-white transition-colors">Pharmacies Paris</a></li>
            <li><a href="/pharmacies/lyon/" class="text-gray-300 hover:text-white transition-colors">Pharmacies Lyon</a></li>
            <li><a href="/pharmacies/marseille/" class="text-gray-300 hover:text-white transition-colors">Pharmacies Marseille</a></li>
            <li><a href="/pharmacies/toulouse/" class="text-gray-300 hover:text-white transition-colors">Pharmacies Toulouse</a></li>
            <li><a href="/pharmacies/bordeaux/" class="text-gray-300 hover:text-white transition-colors">Pharmacies Bordeaux</a></li>
            <li><a href="/pharmacies/nice/" class="text-gray-300 hover:text-white transition-colors">Pharmacies Nice</a></li>
          </ul>
        </div>

        <!-- Santé et Nutrition -->
        <div>
          <p class="font-medium text-white mb-3">Santé & Nutrition</p>
          <ul class="space-y-1 text-sm">
            <li><a href="/collections/glp1-perte-de-poids/" class="text-gray-300 hover:text-white transition-colors">Perte de poids</a></li>
            <li><a href="/guides/qu-est-ce-que-glp1/" class="text-gray-300 hover:text-white transition-colors">Qu'est-ce que le GLP-1 ?</a></li>
            <li><a href="/guides/guide-beaute-perte-de-poids-glp1/" class="text-gray-300 hover:text-white transition-colors">Guide beauté</a></li>
          </ul>
        </div>

        <!-- Ressources -->
        <div>
          <p class="font-medium text-white mb-3">Ressources</p>
          <ul class="space-y-1 text-sm">
            <li><a href="/collections/temoignages/" class="text-gray-300 hover:text-white transition-colors">Témoignages</a></li>
            <li><a href="/guides/experts/" class="text-gray-300 hover:text-white transition-colors">Experts</a></li>
            <li><a href="/contact/" class="text-gray-300 hover:text-white transition-colors">Contact</a></li>
          </ul>
        </div>

        <!-- Légal -->
        <div>
          <p class="font-medium text-white mb-3">Informations légales</p>
          <ul class="space-y-1 text-sm">
            <li><a href="/legal/mentions-legales/" class="text-gray-300 hover:text-white transition-colors">Mentions légales</a></li>
            <li><a href="/legal/politique-confidentialite/" class="text-gray-300 hover:text-white transition-colors">Confidentialité</a></li>
            <li><a href="/partenaires/" class="text-gray-300 hover:text-white transition-colors">Partenaires</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-white/10 mt-6 pt-6 text-center text-gray-400 text-sm">
      <p>&copy; {new Date().getFullYear()} GLP-1 France. Tous droits réservés. Site d'information médicale non substituable à l'avis d'un professionnel de santé.</p>
    </div>
  </div>
</footer>
