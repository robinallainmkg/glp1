---
// Sinocare sidebar (sticky vertical) — empile 2 produits contextuels par page.
// Sélection automatique via slug + collection détectés depuis Astro.url.
import { getProductsForArticle, buildAwinUrl, SINOCARE_PRODUCTS } from '../lib/sinocareProducts';

interface Props {
  context?: string;
}

const { context = "sidebar" } = Astro.props;

// Détecte slug + collection depuis l'URL : /collections/<collection>/<slug>/
const pathname = (Astro.url?.pathname || '').replace(/\/$/, '');
const segments = pathname.split('/').filter(Boolean);
let slug = '';
let collection = '';
const idx = segments.indexOf('collections');
if (idx >= 0 && segments[idx + 1]) {
  collection = segments[idx + 1];
  slug = segments[idx + 2] || '';
} else {
  slug = segments[segments.length - 1] || '';
}

// Pick top 2 contextual products. Fallback to bestsellers if no match.
let products = getProductsForArticle(slug, collection, 2);
if (products.length < 2) {
  const fallbacks = ['safe-aq-smart', 'ican-cgm', 'bp-monitor-arm', 'insulin-needles'];
  for (const fid of fallbacks) {
    if (products.length >= 2) break;
    const p = SINOCARE_PRODUCTS.find(x => x.id === fid);
    if (p && !products.find(x => x.id === p.id)) products.push(p);
  }
}
products = products.slice(0, 2);

const formatPrice = (n: number) => n.toFixed(2).replace('.', ',');
---

<aside class="sino-sidebar-stack">
  {products.map((p, i) => {
    const url = buildAwinUrl(p.id, `${context}_pos${i + 1}_${p.id}`, slug);
    return (
      <article class="sino-card" data-sinocare-card>
        <a href={url} rel="noopener sponsored" target="_blank" class="sino-image-link" aria-label={`Voir ${p.name}`}>
          <img
            src={p.imageUrl}
            alt={p.name}
            class="sino-image"
            loading="lazy"
            width="600"
            height="600"
          />
        </a>
        <div class="sino-body">
          <span class="sino-eyebrow">SINOCARE</span>
          <h3 class="sino-title">{p.name}</h3>
          <p class="sino-lede">{p.shortDesc}</p>
          <div class="sino-meta">
            <span class="sino-rating">★ {p.rating}/5</span>
            <span class="sino-price">dès {formatPrice(p.priceFromEur)}&nbsp;€</span>
          </div>
          <a href={url} rel="noopener sponsored" target="_blank" class="sino-cta">
            Voir l'offre →
          </a>
          <p class="sino-disclaimer">Lien sponsorisé · prix inchangé pour vous</p>
        </div>
      </article>
    );
  })}
</aside>

<style>
  .sino-sidebar-stack {
    position: sticky;
    top: 2rem;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sino-card {
    background: #fff;
    border: 2px solid #9b1d20;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 6px 22px rgba(155, 29, 32, 0.10);
  }
  .sino-image-link {
    display: block;
    background: #fafafa;
    text-decoration: none;
  }
  .sino-image {
    display: block;
    width: 100%;
    height: 175px;
    object-fit: contain;
    padding: 0.5rem;
    background: #fff;
  }
  .sino-body {
    padding: 0.85rem 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .sino-eyebrow {
    font-size: 0.68rem;
    font-weight: 800;
    color: #9b1d20;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
  .sino-title {
    font-size: 0.98rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .sino-lede {
    margin: 0;
    font-size: 0.8rem;
    color: #4b5563;
    line-height: 1.45;
  }
  .sino-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    background: #fff5f5;
    border: 1px solid #f1c4c5;
    border-radius: 8px;
    margin-top: 0.2rem;
  }
  .sino-rating { font-size: 0.78rem; color: #4b5563; font-weight: 600; }
  .sino-price { font-size: 0.98rem; font-weight: 800; color: #9b1d20; letter-spacing: -0.01em; }
  .sino-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: #9b1d20;
    color: #fff;
    border: none;
    padding: 0.65rem 0.85rem;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s;
    box-shadow: 0 3px 10px rgba(155, 29, 32, 0.25);
    margin-top: 0.2rem;
  }
  .sino-cta:hover {
    background: #7a1518;
    transform: translateY(-1px);
    color: #fff;
    text-decoration: none;
  }
  .sino-disclaimer {
    margin: 0.15rem 0 0;
    text-align: center;
    font-size: 0.68rem;
    color: #8b1517;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .sino-sidebar-stack {
      position: static;
      width: 100%;
      max-width: 420px;
      margin: 2rem auto 0;
    }
  }
</style>
