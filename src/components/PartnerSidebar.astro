---
// Sidebar partenaire Annette — remplace l'ancienne sidebar Talika/Nutrimuscle
interface Props {
  context?: string;
}

const { context = "sidebar" } = Astro.props;
const annetteLink = `https://www.annette.care/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=partenariat_${context}`;
---

<aside class="partner-sidebar">
  <!-- Card Annette -->
  <div class="partner-card">
    <div class="partner-header">
      <img src="/images/partners/annette/logo-black.png" alt="Annette" class="partner-logo" width="120" height="32" loading="lazy" />
      <span class="partner-badge">Partenaire</span>
    </div>

    <p class="partner-tagline">Accompagnement nutritionnel pour patients sous traitement GLP-1</p>

    <div class="partner-rating">
      <span class="rating-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span class="rating-text">4.8/5 sur Google</span>
    </div>

    <div class="partner-features">
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Suivi di&eacute;t&eacute;tique personnalis&eacute;</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Primo-prescription si &eacute;ligible</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Renouvellement de traitement</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Di&eacute;t&eacute;ticiens certifi&eacute;s</span>
      </div>
    </div>

    <div class="partner-pricing">
      <div class="price-row">
        <span class="price-old">49&euro;/mois</span>
        <span class="price-new">24,50&euro;</span>
        <span class="price-period">/mois</span>
      </div>
      <span class="price-note">Premier mois avec notre code</span>
    </div>

    <div class="promo-code">
      <span class="promo-label">CODE PROMO :</span>
      <span class="promo-value">CARE50</span>
    </div>

    <a
      href={annetteLink}
      target="_blank"
      rel="noopener sponsored"
      class="partner-cta"
    >
      D&eacute;couvrir Annette &rarr;
    </a>

    <div class="partner-trust">
      <span>2 000+ patients</span>
      <span class="trust-sep">&middot;</span>
      <span>M&eacute;decins partenaires</span>
    </div>
  </div>

  <!-- Mini disclaimer -->
  <p class="partner-disclaimer">
    Lien d'affiliation. GLP-1 France peut recevoir une commission. Cela n'affecte pas nos recommandations &eacute;ditoriales.
  </p>
</aside>

<style>
.partner-sidebar {
  position: sticky;
  top: 2rem;
  width: 320px;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.partner-card {
  background: #fff;
  border: 1px solid #A9E1FF;
  border-radius: 14px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  box-shadow: 0 4px 12px rgba(27, 111, 160, 0.08);
}

.partner-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.partner-logo {
  height: 28px;
  width: auto;
  object-fit: contain;
}

.partner-badge {
  font-size: 0.7rem;
  font-weight: 600;
  color: #1B6FA0;
  background: #E8F6FF;
  padding: 0.2rem 0.6rem;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.partner-tagline {
  font-size: 0.9rem;
  color: #475569;
  line-height: 1.5;
  margin: 0;
}

.partner-rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #FFFBEB;
  border: 1px solid #FDE68A;
  border-radius: 8px;
  padding: 0.5rem 0.75rem;
}

.rating-stars {
  color: #F59E0B;
  font-size: 0.9rem;
  letter-spacing: 1px;
}

.rating-text {
  font-size: 0.8rem;
  font-weight: 600;
  color: #92400E;
}

.partner-features {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  font-size: 0.85rem;
  color: #374151;
  line-height: 1.4;
}

.feature-icon {
  color: #1B6FA0;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 1px;
}

.partner-pricing {
  text-align: center;
  background: #F0F9FF;
  border-radius: 10px;
  padding: 0.75rem;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 0.4rem;
}

.price-old {
  font-size: 0.85rem;
  color: #9ca3af;
  text-decoration: line-through;
}

.price-new {
  font-size: 1.5rem;
  font-weight: 800;
  color: #1B6FA0;
}

.price-period {
  font-size: 0.85rem;
  color: #6b7280;
}

.price-note {
  font-size: 0.75rem;
  color: #6b7280;
  display: block;
  margin-top: 0.2rem;
}

.promo-code {
  background: linear-gradient(135deg, #1B6FA0, #3B9FD9);
  color: #fff;
  padding: 0.7rem;
  border-radius: 8px;
  text-align: center;
  border: 2px dashed rgba(255,255,255,0.4);
}

.promo-label {
  display: block;
  font-size: 0.7rem;
  opacity: 0.9;
  margin-bottom: 0.15rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.promo-value {
  display: block;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  font-family: 'Courier New', monospace;
}

.partner-cta {
  display: block;
  text-align: center;
  background: #1B6FA0;
  color: #fff;
  font-weight: 700;
  font-size: 0.95rem;
  padding: 0.8rem 1rem;
  border-radius: 10px;
  text-decoration: none;
  transition: background 0.2s, transform 0.1s;
}

.partner-cta:hover {
  background: #0D4F73;
  transform: translateY(-1px);
  color: #fff;
  text-decoration: none;
}

.partner-trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  color: #6b7280;
}

.trust-sep {
  color: #d1d5db;
}

.partner-disclaimer {
  font-size: 0.68rem;
  color: #9ca3af;
  line-height: 1.4;
  text-align: center;
  margin: 0;
  font-style: italic;
}

/* Responsive */
@media (max-width: 1024px) {
  .partner-sidebar {
    position: static;
    width: 100%;
    max-width: 400px;
    margin: 2rem auto 0;
  }
}

@media (max-width: 480px) {
  .partner-card {
    padding: 1.25rem;
  }
}

/* Print */
@media print {
  .partner-sidebar {
    display: none;
  }
}
</style>
