    title: 'Prix et Coûts des GLP-1',
    keywords: ['prix', 'coût', 'remboursement', 'économique', 'glp1']
  },
  {
    path: '/collections/medecins-glp1-france/',
    title: 'Trouver un Médecin GLP-1 en France',
    keywords: ['médecins', 'prescription', 'france', 'trouver', 'consultation']
  },
  {
    path: '/collections/alternatives-glp1/',
    title: 'Alternatives aux GLP-1',
    keywords: ['alternatives', 'naturelles', 'compléments', 'glp1']
  },
  {
    path: '/collections/effets-secondaires-glp1/',
    title: 'Effets Secondaires des GLP-1',
    keywords: ['effets secondaires', 'risques', 'précautions', 'glp1']
  },
  {
    path: '/collections/glp1-perte-de-poids/',
    title: 'GLP-1 et Perte de Poids',
    keywords: ['perte de poids', 'amaigrissement', 'résultats', 'glp1']
  },
  {
    path: '/collections/glp1-diabete/',
    title: 'GLP-1 pour le Diabète',
    keywords: ['diabète', 'type 2', 'glycémie', 'traitement', 'glp1']
  },
  {
    path: '/collections/regime-glp1/',
    title: 'Régime Alimentaire avec GLP-1',
    keywords: ['régime', 'alimentation', 'nutrition', 'glp1']
  },
  {
    path: '/collections/recherche-glp1/',
    title: 'Recherche et Études GLP-1',
    keywords: ['recherche', 'études', 'scientifique', 'glp1']
  },

  // Pages spécifiques
  {
    path: '/glp1-diabete/',
    title: 'GLP-1 et Diabète',
    keywords: ['diabète', 'traitement', 'glp1', 'médicaments']
  },
  {
    path: '/medicaments-glp1/',
