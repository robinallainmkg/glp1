---
const { article, collection, categoryName, colors } = Astro.props;
// Support both Astro content entry (article.data) and preformatted article objects
const data = article?.data ?? {
  title: article?.title,
  description: article?.description,
  author: article?.author,
  publishedAt: article?.lastModified || article?.pubDate || article?.publishedAt,
  thumbnail: article?.thumbnail,
  thumbnailAlt: article?.title
};

const slug = article?.slug ?? data?.slug ?? (article?.url ? article.url.split('/').filter(Boolean).pop() : null);
const url = `/collections/${collection}/${slug || ''}/`;

function getArticleImage(articleData: any): string | null {
  if (!articleData) return null;
  if (articleData.ogImage) return encodeURI(String(articleData.ogImage));
  if (articleData.image) return encodeURI(String(articleData.image));
  if (articleData.thumbnail) return encodeURI(String(articleData.thumbnail));
  return null;
}

const articleImage = getArticleImage(data);
// Compute reading time: prefer explicit value, else estimate from word count or body
const words = article?.wordCount || (article.body ? String(article.body).split(/\s+/).length : 0) || data?.wordCount || 0;
const readingTime = article?.readingTime || Math.max(1, Math.ceil(words / 200));

// Resolve collection color for inline styles (colors.bg may be hex without # or a Tailwind name)
const rawBg = colors?.bg || 'emerald';
const collectionHex = rawBg.match(/^[0-9a-fA-F]{6}$/) ? `#${rawBg}` : null;

// Gradient pairs for fallback thumbnails based on collection
const gradientMap: Record<string, string> = {
  red: 'linear-gradient(135deg, #dc2626 0%, #f97316 100%)',
  blue: 'linear-gradient(135deg, #2d5a4e 0%, #1a3c34 100%)',
  green: 'linear-gradient(135deg, #16a34a 0%, #06b6d4 100%)',
  amber: 'linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)',
  purple: 'linear-gradient(135deg, #8b5cf6 0%, #ec4899 100%)',
  cyan: 'linear-gradient(135deg, #06b6d4 0%, #2d5a4e 100%)',
  pink: 'linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%)',
  orange: 'linear-gradient(135deg, #f97316 0%, #ef4444 100%)',
  emerald: 'linear-gradient(135deg, #10b981 0%, #06b6d4 100%)',
};
const fallbackGradient = collectionHex
  ? `linear-gradient(135deg, ${collectionHex} 0%, ${collectionHex}99 50%, ${collectionHex}55 100%)`
  : (gradientMap[rawBg] || gradientMap.emerald);

const badgeColor = collectionHex || '#10b981';
---

<article class="card-article group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-200 overflow-hidden border border-slate-100 hover:border-blue-100 hover:-translate-y-1.5 focus-within:ring-2 focus-within:ring-blue-300 focus-within:ring-offset-2">
  <!-- Thumbnail -->
  <a href={url} class="block relative h-48 overflow-hidden" tabindex="-1" aria-hidden="true">
    {articleImage ? (
      <img
        src={articleImage}
        alt={data.thumbnailAlt || data.title || 'Article'}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
      />
      <div class="card-fallback w-full h-full items-center justify-center" style={`display:none;background:${fallbackGradient}`}>
        <svg class="w-14 h-14 text-white/70" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
          <path d="M24 14v8m0 0v8m0-8h8m-8 0h-8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M16 34c0-4.418 3.582-8 8-8s8 3.582 8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
          <circle cx="24" cy="18" r="4" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
        </svg>
        <div class="absolute bottom-3 left-0 right-0 text-center">
          <span class="text-white/50 text-xs font-medium tracking-wider uppercase">{categoryName}</span>
        </div>
      </div>
    ) : (
      <div class="card-fallback w-full h-full flex items-center justify-center relative" style={`background:${fallbackGradient}`}>
        <!-- Decorative pattern -->
        <div class="absolute inset-0 opacity-10">
          <svg class="w-full h-full" viewBox="0 0 200 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="160" cy="20" r="40" fill="white"/>
            <circle cx="40" cy="100" r="30" fill="white"/>
            <circle cx="100" cy="60" r="20" fill="white"/>
          </svg>
        </div>
        <!-- Medical/science icon -->
        <svg class="w-16 h-16 text-white/60 relative z-10" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="18" y="8" width="12" height="32" rx="3" stroke="currentColor" stroke-width="1.5"/>
          <rect x="8" y="18" width="32" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <div class="absolute bottom-3 left-0 right-0 text-center relative z-10">
          <span class="text-white/60 text-xs font-medium tracking-wider uppercase">{categoryName}</span>
        </div>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/10 to-transparent pointer-events-none"></div>
  </a>

  <!-- Badge -->
  <div class="absolute top-3 left-3 z-10">
    <span
      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold text-white backdrop-blur-sm shadow-sm"
      style={`background:${badgeColor}dd`}
    >
      <span class="w-1.5 h-1.5 rounded-full bg-white/80"></span>
      {categoryName}
    </span>
  </div>

  <div class="p-5 pb-6">
    <h2 class="text-lg font-bold text-slate-900 mb-2.5 line-clamp-2 leading-snug">
      <a href={url} class="group-hover:text-blue-700 transition-colors duration-150 hover:underline decoration-blue-300 underline-offset-2 decoration-2">
        {data.title || article.title}
      </a>
    </h2>

    {(data.description || article.description) && (
      <p class="card-description text-slate-600 text-sm leading-relaxed mb-4">
        {data.description || article.description}
      </p>
    )}

    <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
      <div class="flex items-center gap-3">
        {data.publishedAt && (
          <time datetime={data.publishedAt} class="flex items-center">
            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            {new Date(data.publishedAt).toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}
          </time>
        )}
      </div>

      <span class="flex items-center gap-1 font-medium text-slate-500">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12A9 9 0 1112 3v0"></path>
        </svg>
        {readingTime} min
      </span>
    </div>

    <a
      href={url}
      class="card-cta inline-flex items-center gap-1.5 text-sm font-semibold transition-all duration-150 group/cta rounded-lg px-3 py-1.5 -ml-1"
      style={`color:${badgeColor}; background-color:${badgeColor}14;`}
      aria-label={`Lire l'article : ${data.title || article.title}`}
    >
      Lire l'article
      <svg class="w-4 h-4 transition-transform duration-150 group-hover/cta:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .card-article {
    position: relative;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-cta:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Améliore la lisibilité du titre au survol */
  .card-article:hover h2 a {
    text-decoration-color: currentColor;
  }

  /* Assure une hauteur de carte uniforme sur les grilles */
  .card-article {
    display: flex;
    flex-direction: column;
  }

  .card-article > div:last-child {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-article > div:last-child .card-cta {
    margin-top: auto;
  }

  .card-fallback {
    position: relative;
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .card-article {
      transition: none;
    }
    .card-article img {
      transition: none;
    }
  }
</style>
