---
// CTA contextuel Annette — injecté dans les articles
// Charles retiré (pas de deal signé)
interface Props {
  partner?: "annette"; // Seul partenaire actif
  context?: string;
}

const { context = "article" } = Astro.props;
const annetteLink = `https://www.annette.care/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=partenariat_${context}`;
---

<div
  data-partner-block="cta"
  data-partner="annette"
  class="annette-cta-block"
>
  <div class="annette-cta-icon">
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M20 8v6"/>
      <path d="M23 11h-6"/>
    </svg>
  </div>
  <div class="annette-cta-content">
    <p class="annette-cta-headline">
      Un accompagnement structur&eacute; pour de meilleurs r&eacute;sultats
    </p>
    <p class="annette-cta-lede">
      Annette propose un suivi di&eacute;t&eacute;tique personnalis&eacute; et un encadrement adapt&eacute; aux patients sous traitement GLP-1. Leurs m&eacute;decins partenaires assurent la primo-prescription (si &eacute;ligibilit&eacute;) et le renouvellement.
    </p>

    <div class="annette-cta-pricing">
      <span class="annette-cta-price-label">Code <strong>CARE50</strong></span>
      <span class="annette-cta-price-arrow">&rarr;</span>
      <span class="annette-cta-price-new">24,50&euro; le 1er mois</span>
    </div>

    <a
      href={annetteLink}
      rel="noopener sponsored"
      target="_blank"
      class="annette-cta-button"
    >
      D&eacute;couvrir Annette
      <span aria-hidden="true">&rarr;</span>
    </a>

    <p class="annette-cta-trust">
      2&nbsp;000+ patients accompagn&eacute;s &middot; 4.8/5 sur Google &middot; Di&eacute;t&eacute;ticiens certifi&eacute;s
    </p>
  </div>
</div>

<style>
  .annette-cta-block {
    margin: 1.5rem 0;
    max-width: 100%;
    box-sizing: border-box;
    background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
    border: 2px solid #15803D;
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex-wrap: wrap;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(21, 128, 61, 0.1);
  }
  .annette-cta-icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #15803D;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .annette-cta-content {
    flex: 1;
    min-width: 220px;
  }
  .annette-cta-headline {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #14532D;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .annette-cta-lede {
    margin: 0 0 0.85rem 0;
    font-size: 0.95rem;
    color: #166534;
    line-height: 1.55;
  }
  .annette-cta-pricing {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0 0 1rem 0;
    background: #fff;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    border: 1px solid #15803D;
  }
  .annette-cta-price-arrow {
    color: #6b7280;
    margin: 0 0.15rem;
  }
  .annette-cta-price-new {
    font-size: 1.2rem;
    font-weight: 800;
    color: #14532D;
    letter-spacing: -0.02em;
  }
  .annette-cta-price-label {
    font-size: 0.85rem;
    color: #166534;
    font-weight: 600;
  }
  .annette-cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #15803D;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    padding: 0.9rem 1.6rem;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background 0.2s ease;
    box-shadow: 0 4px 12px rgba(21, 128, 61, 0.25);
  }
  .annette-cta-button:hover {
    background: #14532D;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(21, 128, 61, 0.35);
    color: #fff;
    text-decoration: none;
  }
  .annette-cta-trust {
    margin: 0.85rem 0 0 0;
    font-size: 0.8rem;
    color: #166534;
    line-height: 1.4;
  }
  @media (max-width: 480px) {
    .annette-cta-headline { font-size: 1.05rem; }
    .annette-cta-button { width: 100%; justify-content: center; }
  }
</style>
