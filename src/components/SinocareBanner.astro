---
// Bandeau Sinocare full-width — rendu sur TOUTES les pages via BaseLayout (footer area).
// Format slim (pas le CTA complet) pour ne pas saturer les pages article qui ont déjà
// SinocareSidebar / inline. Deeplink Awin avec clickref tracking ROI par page.

interface Props {
  context?: string;
}

const { context = "global_banner" } = Astro.props;
// Destination = fiche produit Safe AQ Smart (FR e-com Shopify), pas la homepage corporate
// qui redirige vers une page chinoise sans CTA. Match la copy banner ("lecteur de glycémie").
const sinocareLink = `https://www.awin1.com/cread.php?awinmid=114180&awinaffid=2879557&clickref=glp1france_${context}&ued=${encodeURIComponent("https://en.sinocare.com/fr/products/safe-aq-smart-blood-glucometer")}`;
---

<section class="sino-banner" data-partner-block="banner" data-partner="sinocare">
  <div class="sino-banner-inner">
    <div class="sino-banner-image-wrap">
      <img
        src="/images/glucopulse-hero.png"
        alt="Sinocare — lecteur de glycémie"
        class="sino-banner-image"
        loading="lazy"
        width="784"
        height="1168"
      />
    </div>
    <div class="sino-banner-text">
      <span class="sino-banner-eyebrow">Sinocare · Lecteur de glycémie</span>
      <h3 class="sino-banner-title">
        Sous GLP-1&nbsp;? Mesurez votre glycémie en 5 sec.
      </h3>
      <p class="sino-banner-lede">
        Lecteur fiable utilisé dans <strong>130 pays</strong>, précision ±5% (ISO 15197), à partir de <strong>25 €</strong>. Recommandé sous Ozempic, Mounjaro, Wegovy.
      </p>
    </div>
    <a
      href={sinocareLink}
      rel="noopener sponsored"
      target="_blank"
      class="sino-banner-cta"
    >
      Voir l'offre Sinocare
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
  <p class="sino-banner-disclaimer">Lien sponsorisé · prix inchangé pour vous · CE médical</p>
</section>

<style>
  .sino-banner {
    background: linear-gradient(135deg, #fff5f5 0%, #ffeded 100%);
    border-top: 2px solid #9b1d20;
    border-bottom: 1px solid rgba(155, 29, 32, 0.2);
    padding: 1.75rem 1.5rem 1.25rem;
  }
  .sino-banner-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 1.5rem;
    align-items: center;
  }
  .sino-banner-image-wrap {
    width: 90px;
    height: 90px;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1f1a 0%, #1a3c34 100%);
    flex-shrink: 0;
  }
  .sino-banner-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }
  .sino-banner-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .sino-banner-eyebrow {
    font-size: 0.7rem;
    font-weight: 800;
    color: #9b1d20;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .sino-banner-title {
    font-size: 1.15rem;
    font-weight: 900;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .sino-banner-lede {
    margin: 0;
    font-size: 0.85rem;
    color: #4b5563;
    line-height: 1.5;
    max-width: 620px;
  }
  .sino-banner-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #9b1d20;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s, transform 0.1s, box-shadow 0.2s;
    box-shadow: 0 4px 14px rgba(155, 29, 32, 0.3);
    white-space: nowrap;
  }
  .sino-banner-cta:hover {
    background: #7a1518;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(155, 29, 32, 0.4);
    color: #fff;
    text-decoration: none;
  }
  .sino-banner-disclaimer {
    max-width: 1200px;
    margin: 0.85rem auto 0;
    text-align: center;
    font-size: 0.7rem;
    color: #8b1517;
    font-style: italic;
  }

  @media (max-width: 720px) {
    .sino-banner { padding: 1.25rem 1rem 1rem; }
    .sino-banner-inner {
      grid-template-columns: 70px 1fr;
      gap: 1rem;
    }
    .sino-banner-image-wrap { width: 70px; height: 70px; }
    .sino-banner-title { font-size: 1rem; }
    .sino-banner-lede { font-size: 0.78rem; }
    .sino-banner-cta {
      grid-column: 1 / -1;
      width: 100%;
      margin-top: 0.5rem;
    }
  }
</style>
