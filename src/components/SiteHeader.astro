---
// Composant header utilisé par toutes les layouts
---

<a href="#main-content" class="skip-link">Aller au contenu principal</a>
<header class="new-header sticky top-0 z-50">
  <div class="new-header-container">
    <div class="new-logo" style="flex-shrink:0;">
      <a href="/" class="new-logo-link" style="white-space:nowrap;">
        <span style="width:10px;height:10px;border-radius:50%;background:#16a34a;display:inline-block;flex-shrink:0;"></span>
        <span class="new-logo-text" style="font-weight:700;font-size:1.05rem;color:#1a3c34;letter-spacing:-.02em;">GLP-1 France</span>
      </a>
    </div>

    <nav class="new-nav-desktop" aria-label="Navigation principale">
      <div class="new-dropdown">
        <button class="new-dropdown-toggle" aria-expanded="false">Traitements ▼</button>
        <div class="new-dropdown-menu" role="menu">
          <a href="/guides/quel-traitement-glp1-choisir/">Quel traitement choisir ?</a>
          <a href="/collections/traitements-glp1/guide-complet-ozempic/">Guide Complet Ozempic</a>
          <a href="/collections/traitements-glp1/guide-complet-mounjaro/">Guide Complet Mounjaro</a>
          <a href="/collections/traitements-glp1/guide-complet-wegovy/">Guide Complet Wegovy</a>
          <a href="/collections/traitements-glp1/guide-complet-saxenda/">Guide Complet Saxenda</a>
          <a href="/collections/traitements-glp1/guide-complet-trulicity/">Guide Complet Trulicity</a>
          <a href="/collections/traitements-glp1/guide-complet-victoza/">Guide Complet Victoza</a>
          <a href="/collections/traitements-glp1/guide-complet-rybelsus/">Guide Complet Rybelsus</a>
          <a href="/collections/traitements-glp1/">Autres Traitements</a>
        </div>
      </div>
      <a href="/collections/glp1-cout/" class="new-nav-link">Prix</a>
      <a href="/collections/effets-secondaires-glp1/" class="new-nav-link">Effets</a>
      <a href="/outils/test-eligibilite/" class="new-nav-eligibilite" style="color:#16a34a;border:1.5px solid #16a34a;padding:.45rem .9rem;border-radius:8px;font-weight:700;white-space:nowrap;">Test d'éligibilité</a>
      <a href="/dossier-glp1/" class="new-nav-dossier" style="background:#16a34a;color:#fff;padding:.5rem 1rem;border-radius:8px;font-weight:700;white-space:nowrap;box-shadow:0 2px 8px rgba(22,163,74,.3);">Mon Dossier</a>
      <div class="new-dropdown">
        <button class="new-dropdown-toggle" aria-expanded="false">Plus ▼</button>
        <div class="new-dropdown-menu" role="menu">
          <a href="/mon-espace/" onclick="var t=document.getElementById('coach-toggle');if(t){t.click();return false;}">Coach GLP-1 (gratuit)</a>
          <a href="/retraites/">Retraites perte de poids</a>
          <a href="/collections/temoignages/">Témoignages</a>
          <a href="/collections/regime-glp1/">Régime</a>
          <a href="/collections/alternatives-glp1/">Alternatives</a>
          <a href="/collections/medecins-glp1-france/">Médecins</a>
          <a href="/collections/recherche-glp1/">Recherche</a>
          <a href="/guides/experts/">Nos Experts</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </nav>

    <div class="new-search">
      <input type="text" class="new-search-input" placeholder="Rechercher..." id="new-search-input">
      <div class="new-search-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      </div>
      <div class="new-search-results" id="new-search-results" aria-live="polite"></div>
    </div>

    <button class="new-mobile-toggle" id="new-mobile-toggle" aria-label="Ouvrir le menu mobile">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="new-nav-mobile" id="new-nav-mobile" aria-label="Navigation mobile">
      <details>
        <summary>Traitements</summary>
        <div class="mobile-submenu">
          <a href="/guides/quel-traitement-glp1-choisir/">Quel traitement choisir ?</a>
          <a href="/collections/traitements-glp1/guide-complet-wegovy/">Guide Complet Wegovy</a>
          <a href="/collections/traitements-glp1/guide-complet-ozempic/">Guide Complet Ozempic</a>
          <a href="/collections/traitements-glp1/guide-complet-mounjaro/">Guide Complet Mounjaro</a>
          <a href="/collections/traitements-glp1/guide-complet-trulicity/">Guide Complet Trulicity</a>
          <a href="/collections/traitements-glp1/guide-complet-saxenda/">Guide Complet Saxenda</a>
          <a href="/collections/traitements-glp1/">Autres Traitements</a>
        </div>
      </details>
      <a href="/collections/glp1-cout/">Prix</a>
      <a href="/collections/effets-secondaires-glp1/">Effets</a>
      <a href="/outils/test-eligibilite/" style="color:#16a34a;font-weight:700;">Test d'éligibilité (gratuit)</a>
      <details>
        <summary>Plus</summary>
        <div class="mobile-submenu">
          <a href="/retraites/">Retraites perte de poids</a>
          <a href="/collections/temoignages/">Témoignages</a>
          <a href="/collections/regime-glp1/">Régime</a>
          <a href="/collections/alternatives-glp1/">Alternatives</a>
          <a href="/collections/medecins-glp1-france/">Médecins</a>
          <a href="/collections/recherche-glp1/">Recherche</a>
          <a href="/guides/experts/">Nos Experts</a>
          <a href="/contact/">Contact</a>
        </div>
      </details>
      <a href="/dossier-glp1/" class="mobile-nav-cta" style="background:#16a34a;">Mon Dossier GLP-1 — 4,99 €</a>
      <a href="/mon-espace/" class="mobile-nav-cta" onclick="var t=document.getElementById('coach-toggle');if(t){t.click();return false;}">Parler au Coach GLP-1</a>
    </nav>

    <!-- Overlay pour fermer le menu mobile -->
    <div class="mobile-menu-overlay" id="mobile-menu-overlay"></div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const mobileToggle = document.getElementById('new-mobile-toggle');
      const mobileNav = document.getElementById('new-nav-mobile');
      const mobileOverlay = document.getElementById('mobile-menu-overlay');
      
      // Détection iOS
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
      let scrollPosition = 0;
      
      if (mobileToggle && mobileNav && mobileOverlay) {
        function toggleMobileMenu() {
          const isOpen = mobileNav.classList.contains('open');
          
          if (isOpen) {
            // Fermer le menu
            mobileNav.classList.remove('open');
            mobileToggle.classList.remove('active');
            mobileOverlay.classList.remove('active');
            
            // Restaurer le scroll du body
            if (isIOS) {
              document.body.style.position = '';
              document.body.style.top = '';
              document.body.style.width = '';
              document.body.style.overflow = '';
              window.scrollTo(0, scrollPosition);
              document.body.classList.remove('mobile-menu-open');
            } else {
              document.body.style.overflow = '';
              document.body.style.position = '';
              document.body.style.width = '';
              document.body.classList.remove('mobile-menu-open');
            }
          } else {
            // Ouvrir le menu
            mobileNav.classList.add('open');
            mobileToggle.classList.add('active');
            mobileOverlay.classList.add('active');
            
            // Bloquer le scroll du body
            if (isIOS) {
              scrollPosition = window.pageYOffset;
              document.body.style.position = 'fixed';
              document.body.style.top = `-${scrollPosition}px`;
              document.body.style.width = '100%';
              document.body.style.overflow = 'hidden';
              document.body.classList.add('mobile-menu-open');
            } else {
              document.body.style.overflow = 'hidden';
              document.body.style.position = 'fixed';
              document.body.style.width = '100%';
              document.body.classList.add('mobile-menu-open');
            }
          }
        }
        
        mobileToggle.addEventListener('click', toggleMobileMenu);
        mobileOverlay.addEventListener('click', toggleMobileMenu);
        
        mobileNav.querySelectorAll('a').forEach(link => link.addEventListener('click', function() {
          mobileNav.classList.remove('open');
          mobileToggle.classList.remove('active');
          mobileOverlay.classList.remove('active');
          
          // Restaurer le scroll du body
          if (isIOS) {
            document.body.style.position = '';
            document.body.style.top = '';
            document.body.style.width = '';
            document.body.style.overflow = '';
            window.scrollTo(0, scrollPosition);
            document.body.classList.remove('mobile-menu-open');
          } else {
            document.body.style.overflow = '';
            document.body.style.position = '';
            document.body.style.width = '';
            document.body.classList.remove('mobile-menu-open');
          }
        }));
      }

      const dropdowns = document.querySelectorAll('.new-dropdown');
      dropdowns.forEach(dropdown => {
        const toggle = dropdown.querySelector('.new-dropdown-toggle');
        const menu = dropdown.querySelector('.new-dropdown-menu');
        if (toggle && menu) {
          toggle.addEventListener('click', function(e) {
            e.preventDefault();
            // Ferme les autres dropdowns
            dropdowns.forEach(otherDropdown => {
              if (otherDropdown !== dropdown) {
                otherDropdown.classList.remove('active');
                const otherToggle = otherDropdown.querySelector('.new-dropdown-toggle');
                if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
              }
            });
            // Toggle le dropdown actuel
            dropdown.classList.toggle('active');
            toggle.setAttribute('aria-expanded', String(dropdown.classList.contains('active')));
          });
        }
      });
      
      document.addEventListener('click', function(e) {
        dropdowns.forEach(dropdown => {
          if (!dropdown.contains(e.target as Node)) {
            dropdown.classList.remove('active');
            const toggle = dropdown.querySelector('.new-dropdown-toggle');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
          }
        });
      });

      const searchInput = document.getElementById('new-search-input');
      const searchResults = document.getElementById('new-search-results');
      if (searchInput && searchResults) {
        // Import du module de recherche
        import('/src/data/searchIndex.js').then(({ searchIndex, searchArticles }) => {
          searchInput.addEventListener('input', function() {
            const query = (this as HTMLInputElement).value.toLowerCase().trim();
            if (query.length < 2) {
              searchResults.style.display = 'none';
              return;
            }

            const results = searchArticles(query);

            if (results.length) {
              searchResults.innerHTML = results.map(article =>
                `<a href="${article.url}" class="search-result">
                  <div class="search-title">${article.title}</div>
                  <div class="search-description">${article.description}</div>
                </a>`
              ).join('');
              searchResults.style.display = 'block';
            } else {
              searchResults.innerHTML = `<div class="no-results">Aucun résultat trouvé pour "${query}"</div>`;
              searchResults.style.display = 'block';
            }
          });
        });

        document.addEventListener('click', function(e) {
          if (!searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) {
            (searchResults as HTMLElement).style.display = 'none';
          }
        });

        // Gestion des dropdowns pour mobile
        const dropdownToggles = document.querySelectorAll('.new-dropdown-toggle');
        dropdownToggles.forEach(toggle => {
          toggle.addEventListener('click', function(e) {
            e.preventDefault();
            const dropdown = this.closest('.new-dropdown');
            const isActive = dropdown.classList.contains('active');

            // Fermer tous les dropdowns
            document.querySelectorAll('.new-dropdown.active').forEach(activeDropdown => {
              if (activeDropdown !== dropdown) {
                activeDropdown.classList.remove('active');
              }
            });

            // Basculer l'état du dropdown actuel
            if (isActive) {
              dropdown.classList.remove('active');
            } else {
              dropdown.classList.add('active');
            }
          });
        });

        // Fermer les dropdowns en cliquant ailleurs
        document.addEventListener('click', function(e) {
          if (!e.target.closest('.new-dropdown')) {
            document.querySelectorAll('.new-dropdown.active').forEach(dropdown => {
              dropdown.classList.remove('active');
            });
          }
        });
      }
    });
  </script>
</header>
