---
// Bandeau d'annonce site-wide (top bar). Fermable, persiste via localStorage.
// Actu : remboursement Mounjaro + Wegovy au 15 juin 2026.
const href = "/collections/glp1-cout/remboursement-mounjaro-wegovy-15-juin-2026/";
---
<div id="announce-bar" class="announce-bar" data-key="rembours-15juin-2026">
  <a href={href} class="announce-link">
    <span class="announce-badge">Nouveau</span>
    <span class="announce-text">
      <strong>Mounjaro &amp; Wegovy remboursés à 65&nbsp;% depuis le 15 juin 2026</strong> — qui est éligible&nbsp;?
    </span>
    <span class="announce-cta">Lire&nbsp;→</span>
  </a>
  <button type="button" class="announce-close" aria-label="Fermer l'annonce">&times;</button>
</div>
<style>
  .announce-bar {
    position: relative;
    background: linear-gradient(90deg, #15803d 0%, #16a34a 100%);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 40px 8px 16px;
    font-size: 0.86rem;
    line-height: 1.3;
    text-align: center;
  }
  .announce-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    flex-wrap: wrap;
    justify-content: center;
  }
  .announce-badge {
    background: #fff;
    color: #15803d;
    font-size: 0.64rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .announce-text { opacity: 0.98; }
  .announce-text strong { font-weight: 700; }
  .announce-cta {
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .announce-link:hover .announce-cta { opacity: 0.85; }
  .announce-close {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.18);
    border: none;
    color: #fff;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }
  .announce-close:hover { background: rgba(255, 255, 255, 0.32); }
  @media (max-width: 640px) {
    .announce-bar { font-size: 0.76rem; padding: 7px 34px 7px 12px; }
    .announce-cta { display: none; }
  }
</style>
<script>
  (function () {
    var bar = document.getElementById('announce-bar');
    if (!bar) return;
    var key = 'glp1_announce_' + (bar.getAttribute('data-key') || 'default');
    if (localStorage.getItem(key)) { bar.style.display = 'none'; return; }
    var btn = bar.querySelector('.announce-close');
    if (btn) btn.addEventListener('click', function () {
      bar.style.display = 'none';
      try { localStorage.setItem(key, '1'); } catch (e) {}
    });
  })();
</script>
