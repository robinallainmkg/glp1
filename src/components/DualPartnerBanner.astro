---
// Bloc homepage : 2 partenaires côte-à-côte — Annette (accompagnement) + Charles (téléconsultation)
interface Props {
  context?: string;
}
const { context = "homepage" } = Astro.props;

const annetteLink = `https://www.annette.care/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=partenariat_${context}`;
const charlesLink = `https://poids.charles.co/?utm_source=affiliation&utm_medium=glp1france&utm_campaign=partenariat_${context}`;
---

<section data-partner-block="dual_banner" style="background:linear-gradient(180deg,#f8faf9 0%,#fff 100%);padding:3rem 1.5rem;border-top:1px solid #e5e7eb;">
  <div style="max-width:1000px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:2rem;">
      <h2 style="font-size:1.7rem;font-weight:900;color:#1a3c34;margin:0 0 .5rem 0;letter-spacing:-.03em;">
        Besoin d'aller plus loin&nbsp;?
      </h2>
      <p style="color:#6b7280;margin:0;font-size:.95rem;max-width:520px;margin-left:auto;margin-right:auto;">
        Deux partenaires s&eacute;lectionn&eacute;s&nbsp;: l'un pour l'acc&egrave;s au traitement, l'autre pour l'accompagnement au quotidien.
      </p>
    </div>

    <div class="dual-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;">
      <!-- === CARTE CHARLES — accès traitement === -->
      <div data-partner="charles" style="background:#F8F3E9;border:1px solid #1a1a1a;border-radius:16px;padding:1.75rem;display:flex;flex-direction:column;gap:1rem;">
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
            <span style="font-size:1.5rem;font-weight:800;color:#1a1a1a;letter-spacing:-.02em;">Charles</span>
            <span style="font-size:.7rem;font-weight:600;color:#1a1a1a;background:#fff;padding:.25rem .6rem;border-radius:999px;border:1px solid #1a1a1a;text-transform:uppercase;letter-spacing:.5px;">Clinique digitale</span>
          </div>
          <p style="margin:0;font-size:.92rem;color:#3a3a3a;line-height:1.5;">
            T&eacute;l&eacute;consultation avec un m&eacute;decin sp&eacute;cialiste fran&ccedil;ais et prescription de traitements si vous &ecirc;tes &eacute;ligible.
          </p>
        </div>

        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.4rem;font-size:.88rem;color:#1a1a1a;">
          <li>&#10003;&nbsp; M&eacute;decins sp&eacute;cialistes fran&ccedil;ais</li>
          <li>&#10003;&nbsp; Ordonnance si profil &eacute;ligible</li>
          <li>&#10003;&nbsp; H&eacute;bergeur agr&eacute;&eacute; donn&eacute;es de sant&eacute;</li>
          <li>&#10003;&nbsp; Suivi inclus par l'&eacute;quipe Charles</li>
        </ul>

        <div style="background:#fff;border:1px solid #e5dcc8;border-radius:10px;padding:.75rem;text-align:center;">
          <div style="font-size:.8rem;color:#6b6b6b;margin-bottom:.15rem;">T&eacute;l&eacute;consultation</div>
          <div>
            <span style="font-size:.9rem;color:#9a9a9a;text-decoration:line-through;">80&euro; en cabinet</span>
            <span style="font-size:1.5rem;font-weight:800;color:#1a1a1a;margin-left:.4rem;">35&euro;</span>
          </div>
        </div>

        <a
          href={charlesLink}
          target="_blank"
          rel="noopener sponsored"
          style="display:block;text-align:center;background:#1a1a1a;color:#F8F3E9;font-weight:700;font-size:.95rem;padding:.85rem 1rem;border-radius:10px;text-decoration:none;transition:background .2s;"
        >
          V&eacute;rifier mon &eacute;ligibilit&eacute; &rarr;
        </a>
      </div>

      <!-- === CARTE ANNETTE — accompagnement === -->
      <div data-partner="annette" style="background:#F0F9FF;border:1px solid #A9E1FF;border-radius:16px;padding:1.75rem;display:flex;flex-direction:column;gap:1rem;">
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
            <span style="font-size:1.5rem;font-weight:800;color:#0D4F73;letter-spacing:-.02em;">Annette</span>
            <span style="font-size:.7rem;font-weight:700;color:#fff;background:#1B6FA0;padding:.25rem .6rem;border-radius:999px;text-transform:uppercase;letter-spacing:.5px;">Code CARE50 &middot; -50%</span>
          </div>
          <p style="margin:0;font-size:.92rem;color:#1B6FA0;line-height:1.5;">
            Accompagnement nutritionnel personnalis&eacute; pour patients sous GLP-1&nbsp;: di&eacute;t&eacute;ticien d&eacute;di&eacute;, suivi comportemental, application.
          </p>
        </div>

        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.4rem;font-size:.88rem;color:#0D4F73;">
          <li>&#10003;&nbsp; Di&eacute;t&eacute;ticien d&eacute;di&eacute;</li>
          <li>&#10003;&nbsp; Primo-prescription &amp; renouvellement</li>
          <li>&#10003;&nbsp; Suivi quotidien via l'app</li>
          <li>&#10003;&nbsp; 2&nbsp;000+ patients &middot; 4.8/5 Google</li>
        </ul>

        <div style="background:#fff;border:1px solid #A9E1FF;border-radius:10px;padding:.75rem;text-align:center;">
          <div style="font-size:.8rem;color:#1B6FA0;margin-bottom:.15rem;">Programme d'accompagnement</div>
          <div>
            <span style="font-size:.9rem;color:#9ca3af;text-decoration:line-through;">49&euro;/mois</span>
            <span style="font-size:1.5rem;font-weight:800;color:#1B6FA0;margin-left:.4rem;">24,50&euro;</span>
            <span style="font-size:.8rem;color:#6b7280;">&nbsp;1er mois</span>
          </div>
        </div>

        <a
          href={annetteLink}
          target="_blank"
          rel="noopener sponsored"
          style="display:block;text-align:center;background:#1B6FA0;color:#fff;font-weight:700;font-size:.95rem;padding:.85rem 1rem;border-radius:10px;text-decoration:none;transition:background .2s;"
        >
          D&eacute;couvrir Annette &rarr;
        </a>
      </div>
    </div>

    <p style="font-size:.72rem;color:#9ca3af;text-align:center;margin:1.25rem 0 0;font-style:italic;line-height:1.4;">
      Liens d'affiliation. GLP-1 France peut recevoir une commission. Cela n'affecte pas nos recommandations &eacute;ditoriales.
    </p>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .dual-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
