---
// Composant intelligent pour l'affichage adaptatif des produits d'affiliation
import { getAllAffiliateProducts } from '../lib/affiliate';
import AffiliateSidebar from './AffiliateSidebar.astro';
import InlineAffiliateProduct from './InlineAffiliateProduct.astro';

export interface Props {
  /** Contenu HTML de l'article pour analyse */
  articleContent?: string;
  /** Produits spécifiquement liés à l'article */
  affiliateProducts?: any[];
  /** Catégorie de l'article pour recommandations */
  category?: string;
  /** Auteur de l'article */
  authorName?: string;
  /** Articles connexes */
  relatedArticles?: any[];
  /** Force l'affichage de la sidebar même sur mobile */
  forceSidebar?: boolean;
  /** Désactive l'injection inline */
  disableInline?: boolean;
  /** Configuration personnalisée */
  config?: {
    maxInlineProducts?: number;
    startAfterParagraphs?: number;
    sidebarPosition?: 'left' | 'right';
    mobileStrategy?: 'inline-only' | 'sidebar-only' | 'both';
  };
}

const { 
  affiliateProducts = [],
  authorName,
  relatedArticles = [],
  forceSidebar = false,
  disableInline = false,
  config = {}
} = Astro.props;

// Configuration par défaut
const defaultConfig = {
  maxInlineProducts: 3,
  startAfterParagraphs: 2,
  sidebarPosition: 'right' as const,
  mobileStrategy: 'both' as const,
  ...config
};

// Récupération des produits d'affiliation
let sidebarProducts = [];
let inlineProducts = [];

try {
  if (affiliateProducts && affiliateProducts.length > 0) {
    // Utiliser directement les produits passés (déjà traités par le template)
    sidebarProducts = affiliateProducts;
    
    // Pour les inline, prendre des produits différents pour éviter les doublons
    // Mélanger et prendre max 2 produits pour l'inline
    const shuffledProducts = [...affiliateProducts].sort(() => Math.random() - 0.5);
    inlineProducts = shuffledProducts.slice(0, Math.min(2, defaultConfig.maxInlineProducts));
  } else {
    // Charger les produits depuis Supabase si aucun n'est fourni
    console.log('🔄 Chargement des produits depuis Supabase...');
    const allProducts = await getAllAffiliateProducts();
    
    if (allProducts.length > 0) {
      // Prioriser les produits featured
      const featuredProducts = allProducts.filter(p => p.featured);
      const regularProducts = allProducts.filter(p => !p.featured);
      
      // Mélanger les produits pour la variété
      const shuffledFeatured = [...featuredProducts].sort(() => Math.random() - 0.5);
      const shuffledRegular = [...regularProducts].sort(() => Math.random() - 0.5);
      
      // Combiner : produits featured en premier, puis autres
      const mixedProducts = [...shuffledFeatured, ...shuffledRegular];
      
      sidebarProducts = mixedProducts.slice(0, 3); // Max 3 pour la sidebar
      inlineProducts = mixedProducts.slice(0, Math.min(2, defaultConfig.maxInlineProducts));
    } else {
      console.log(`⚠️ AdaptiveAffiliateDisplay: Aucun produit trouvé dans Supabase`);
    }
  }
} catch (error) {
  console.warn('Erreur lors du chargement des produits d\'affiliation:', error);
  sidebarProducts = [];
  inlineProducts = [];
}

// Détection du contexte (simulée côté serveur - en production utiliser User-Agent ou CSS)
const isMobile = false; // À adapter selon votre détection

// Logique d'affichage adaptative
const shouldShowSidebar = forceSidebar || (!isMobile && sidebarProducts.length > 0);
const shouldShowInline = !disableInline && inlineProducts.length > 0 && (
  // Sur mobile : selon la stratégie
  (isMobile && defaultConfig.mobileStrategy !== 'sidebar-only') || 
  // Sur desktop : toujours afficher si inline-only ou both
  (!isMobile && ['inline-only', 'both'].includes(defaultConfig.mobileStrategy))
);
---

<!-- Fragment pour éviter les wrappers inutiles -->
<Fragment>
  
  <!-- Sidebar pour desktop/tablette -->
  {shouldShowSidebar && (
    <AffiliateSidebar 
      products={sidebarProducts}
      authorName={authorName}
      relatedArticles={relatedArticles}
      className={`adaptive-sidebar ${defaultConfig.sidebarPosition}`}
    />
  )}

  <!-- Produits inline pour mobile ou complément -->
  {shouldShowInline && (
    <div class="inline-products-container" data-strategy={defaultConfig.mobileStrategy}>
      {inlineProducts.map((product, index) => {
        // Alternance des positions pour un affichage dynamique
        const positions = ['right', 'left', 'center'] as const;
        const position = positions[index % positions.length];
        
        // Variation des tailles
        const size = product.featured ? 'medium' : 'small';
        
        return (
          <InlineAffiliateProduct 
            product={product}
            position={position}
            size={size}
            showFullDescription={false}
          />
        );
      })}
    </div>
  )}

</Fragment>

<!-- Styles adaptatifs -->
<style>
  /* Configuration adaptative */
  .adaptive-sidebar {
    display: block;
  }
  
  .adaptive-sidebar.right {
    float: right;
    margin-left: 2rem;
  }
  
  .adaptive-sidebar.left {
    float: left;
    margin-right: 2rem;
  }
  
  /* Container pour produits inline */
  .inline-products-container {
    position: relative;
    z-index: 1;
  }
  
  .inline-products-container[data-strategy="inline-only"] {
    margin: 2rem 0;
  }
  
  /* Responsive adaptatif */
  @media (max-width: 1024px) {
    .adaptive-sidebar {
      display: none;
    }
    
    .inline-products-container {
      display: block;
    }
  }
  
  @media (max-width: 768px) {
    .adaptive-sidebar {
      display: none !important;
    }
    
    .inline-products-container {
      margin: 1rem 0;
    }
  }
  
  /* Strategy-specific styles */
  @media (max-width: 768px) {
    .inline-products-container[data-strategy="sidebar-only"] {
      display: none;
    }
  }
  
  @media (min-width: 1025px) {
    .inline-products-container[data-strategy="inline-only"] {
      display: none;
    }
    
    /* Sur desktop, cache les produits inline seulement si strategy = 'sidebar-only' */
    .inline-products-container[data-strategy="sidebar-only"] {
      display: none;
    }
  }
  
  /* Amélioration de l'accessibilité */
  @media (prefers-reduced-motion: reduce) {
    .adaptive-sidebar,
    .inline-products-container {
      animation: none;
      transition: none;
    }
  }
  
  /* Mode impression */
  @media print {
    .adaptive-sidebar {
      position: static !important;
      float: none !important;
      margin: 0 !important;
      page-break-inside: avoid;
    }
    
    .inline-products-container {
      page-break-inside: avoid;
    }
  }
</style>

<!-- Script pour détection client-side et ajustements dynamiques -->
<script is:inline>
  // Amélioration progressive côté client (JS pur)
  document.addEventListener('DOMContentLoaded', function() {
    var sidebarElements = document.querySelectorAll('.adaptive-sidebar');
    var inlineContainers = document.querySelectorAll('.inline-products-container');

    function adjustDisplayStrategy() {
      var isMobileLocal = window.innerWidth <= 768;

      sidebarElements.forEach(function(sidebar) {
        try {
          if (isMobileLocal) {
            sidebar.style.display = 'none';
          } else {
            sidebar.style.display = 'block';
          }
        } catch (e) {}
      });

      inlineContainers.forEach(function(container) {
        try {
          var strategy = container.getAttribute('data-strategy');
          if (strategy === 'inline-only') {
            container.style.display = 'block';
          } else if (strategy === 'sidebar-only') {
            container.style.display = isMobileLocal ? 'none' : 'block';
          } else {
            container.style.display = 'block';
          }
        } catch (e) {}
      });
    }

    // Ajustement initial
    adjustDisplayStrategy();

    // Redimensionnement avec debounce
    var resizeTimeout;
    window.addEventListener('resize', function() {
      if (resizeTimeout) clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(adjustDisplayStrategy, 150);
    });

    // Analytics des interactions (optionnel)
    document.querySelectorAll('.cta-button').forEach(function(button) {
      try {
        button.addEventListener('click', function() {
          var prodEl = button.closest('[data-product]');
          var productName = prodEl && prodEl.getAttribute ? prodEl.getAttribute('data-product') : null;
          if (productName) {
            console.log('Interaction produit d\'affiliation:', productName);
            if (typeof window.gtag !== 'undefined') {
              try {
                window.gtag('event', 'affiliate_click', {
                  product_name: productName,
                  display_type: button.closest('.adaptive-sidebar') ? 'sidebar' : 'inline'
                });
              } catch (e) {}
            }
          }
        });
      } catch (e) {}
    });
  });
</script>
