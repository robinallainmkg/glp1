---
interface Props {
  variant?: "default" | "compact";
  context?: string;
}

const { variant = "default", context = "" } = Astro.props;

const isCompact = variant === "compact";
const utmSuffix = context ? `_${context}` : "";

const charlesLink = `https://poids.charles.co/?utm_source=glp1france&utm_medium=cpa&utm_campaign=charles_comparator${utmSuffix}`;
const annetteLink = `https://www.annette.care/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=partenariat_comparator${utmSuffix}`;

const titleSize = isCompact ? "1.4rem" : "1.8rem";
const subtitleSize = isCompact ? "0.95rem" : "1.05rem";
const cardPadding = isCompact ? "1.25rem" : "1.75rem";
const nameSize = isCompact ? "1.15rem" : "1.35rem";
const descSize = isCompact ? "0.88rem" : "0.95rem";
const featureSize = isCompact ? "0.85rem" : "0.92rem";
const ctaSize = isCompact ? "0.9rem" : "1rem";
const ctaPadding = isCompact ? "0.65rem 1.25rem" : "0.8rem 1.5rem";
---

<section data-partner-block="comparator" style={`
  max-width: 900px;
  margin: ${isCompact ? "2rem" : "3rem"} auto;
  padding: 0 1rem;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
`}>
  <div style={`text-align: center; margin-bottom: ${isCompact ? "1.5rem" : "2rem"};`}>
    <h2 style={`
      font-size: ${titleSize};
      font-weight: 800;
      color: #1a3c34;
      margin: 0 0 0.5rem 0;
      line-height: 1.25;
    `}>Vous souhaitez commencer un traitement ?</h2>
    <p style={`
      font-size: ${subtitleSize};
      color: #5a6b65;
      margin: 0;
      line-height: 1.5;
    `}>Nos partenaires sant&eacute; de confiance vous accompagnent</p>
  </div>

  <div class="comparator-grid" style={`
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  `}>
    <!-- Charles.co -->
    <div style={`
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: ${cardPadding};
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.2s ease;
    `}>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
        <div style={`
          width: ${isCompact ? "44px" : "52px"};
          height: ${isCompact ? "44px" : "52px"};
          border-radius: 12px;
          background: linear-gradient(135deg, #eef2ff, #e0e7ff);
          display: flex;
          align-items: center;
          justify-content: center;
          font-weight: 700;
          font-size: ${isCompact ? "1rem" : "1.15rem"};
          color: #4f46e5;
          flex-shrink: 0;
        `}>C</div>
        <div style="flex: 1;">
          <div style={`font-size: ${nameSize}; font-weight: 700; color: #1a3c34; line-height: 1.2;`}>Charles.co</div>
        </div>
      </div>

      <span style={`
        display: inline-block;
        width: fit-content;
        background: #eef2ff;
        color: #4f46e5;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        margin-bottom: 0.85rem;
        letter-spacing: 0.02em;
      `}>T&eacute;l&eacute;m&eacute;decine</span>

      <p style={`
        font-size: ${descSize};
        color: #475569;
        line-height: 1.55;
        margin: 0 0 1rem 0;
      `}>Consultation avec des m&eacute;decins sp&eacute;cialis&eacute;s pour d&eacute;marrer votre traitement GLP-1</p>

      <ul style={`
        list-style: none;
        padding: 0;
        margin: 0 0 1.15rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      `}>
        <li style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem;`}>
          <span style="color: #4f46e5; flex-shrink: 0; margin-top: 1px;">&#10003;</span>
          M&eacute;decins endocrinologues certifi&eacute;s
        </li>
        <li style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem;`}>
          <span style="color: #4f46e5; flex-shrink: 0; margin-top: 1px;">&#10003;</span>
          Ordonnance en ligne si &eacute;ligible
        </li>
        <li style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem;`}>
          <span style="color: #4f46e5; flex-shrink: 0; margin-top: 1px;">&#10003;</span>
          Programme Body Reset personnalis&eacute;
        </li>
      </ul>

      <div style={`
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 1.15rem;
        font-size: ${isCompact ? "0.82rem" : "0.88rem"};
        color: #6b7280;
      `}>
        <span style="color: #f59e0b;">&#9733;</span>
        <span style="font-weight: 600; color: #374151;">4.6/5</span>
        <span>Trustpilot</span>
      </div>

      <div style="margin-top: auto;">
        <a
          href={charlesLink}
          target="_blank"
          rel="noopener sponsored"
          style={`
            display: block;
            text-align: center;
            background: #4f46e5;
            color: #fff;
            font-size: ${ctaSize};
            font-weight: 600;
            padding: ${ctaPadding};
            border-radius: 10px;
            text-decoration: none;
            transition: background 0.2s ease;
            letter-spacing: 0.01em;
          `}
          onmouseover="this.style.background='#4338ca'"
          onmouseout="this.style.background='#4f46e5'"
        >Prendre rendez-vous &rarr;</a>
      </div>
    </div>

    <!-- Annette.care -->
    <div style={`
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: ${cardPadding};
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      display: flex;
      flex-direction: column;
      transition: box-shadow 0.2s ease;
    `}>
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
        <div style={`
          width: ${isCompact ? "44px" : "52px"};
          height: ${isCompact ? "44px" : "52px"};
          border-radius: 12px;
          background: linear-gradient(135deg, #F0F9FF, #E8F6FF);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
        `}><img src="/images/partners/annette/logo-black.png" alt="Annette" style="height:22px;"></div>
        <div style="flex: 1;">
          <div style={`font-size: ${nameSize}; font-weight: 700; color: #1a3c34; line-height: 1.2;`}>Annette.care</div>
        </div>
      </div>

      <span style={`
        display: inline-block;
        width: fit-content;
        background: #F0F9FF;
        color: #1B6FA0;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 20px;
        margin-bottom: 0.5rem;
        letter-spacing: 0.02em;
      `}>Accompagnement</span>

      <span style={`
        display: inline-block;
        width: fit-content;
        background: #E8F6FF;
        color: #1B6FA0;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        margin-bottom: 0.85rem;
        letter-spacing: 0.01em;
        border: 1px dashed #1B6FA0;
      `}>Code GLP1FRANCE50 : -50% le 1er mois</span>

      <p style={`
        font-size: ${descSize};
        color: #475569;
        line-height: 1.55;
        margin: 0 0 1rem 0;
      `}>Suivi di&eacute;t&eacute;tique personnalis&eacute; et encadrement adapt&eacute; aux patients sous traitement GLP-1</p>

      <ul style={`
        list-style: none;
        padding: 0;
        margin: 0 0 1.15rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      `}>
        <li style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem;`}>
          <span style="color: #1B6FA0; flex-shrink: 0; margin-top: 1px;">&#10003;</span>
          Di&eacute;t&eacute;ticien d&eacute;di&eacute; et suivi quotidien
        </li>
        <li style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem;`}>
          <span style="color: #1B6FA0; flex-shrink: 0; margin-top: 1px;">&#10003;</span>
          T&eacute;l&eacute;consultations avec m&eacute;decins partenaires
        </li>
        <li style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem;`}>
          <span style="color: #1B6FA0; flex-shrink: 0; margin-top: 1px;">&#10003;</span>
          Application, IA et communaut&eacute; de patients
        </li>
      </ul>

      <div style={`
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: ${isCompact ? "0.82rem" : "0.88rem"};
        color: #6b7280;
        margin-bottom: 0.5rem;
      `}>
        <span style="color: #1B6FA0;">&#9733;</span>
        <span style="font-weight: 600; color: #374151;">2 000+ patients accompagn&eacute;s</span>
      </div>

      <div style={`
        font-size: ${isCompact ? "0.82rem" : "0.88rem"};
        color: #374151;
        font-weight: 600;
        margin-bottom: 1.15rem;
      `}>49&euro;/mois <span style="font-weight: 400; color: #6b7280;">(engagement 3 mois min)</span></div>

      <div style="margin-top: auto;">
        <a
          href={annetteLink}
          target="_blank"
          rel="noopener sponsored"
          style={`
            display: block;
            text-align: center;
            background: #1B6FA0;
            color: #fff;
            font-size: ${ctaSize};
            font-weight: 600;
            padding: ${ctaPadding};
            border-radius: 10px;
            text-decoration: none;
            transition: background 0.2s ease;
            letter-spacing: 0.01em;
          `}
          onmouseover="this.style.background='#155A82'"
          onmouseout="this.style.background='#1B6FA0'"
        >D&eacute;couvrir le programme &rarr;</a>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 680px) {
    .comparator-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
