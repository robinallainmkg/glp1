---
// Bloc de mise en avant Annette — seul partenaire actif
interface Props {
  variant?: "default" | "compact";
  context?: string;
}

const { variant = "default", context = "" } = Astro.props;

const isCompact = variant === "compact";
const utmSuffix = context ? `_${context}` : "";
const annetteLink = `https://www.annette.care/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=partenariat${utmSuffix}`;

const titleSize = isCompact ? "1.4rem" : "1.8rem";
const subtitleSize = isCompact ? "0.95rem" : "1.05rem";
const cardPadding = isCompact ? "1.5rem" : "2rem";
const featureSize = isCompact ? "0.88rem" : "0.95rem";
const ctaSize = isCompact ? "0.95rem" : "1.05rem";
const ctaPadding = isCompact ? "0.7rem 1.5rem" : "0.85rem 2rem";
---

<section data-partner-block="comparator" id="partenaires" style={`
  max-width: 700px;
  margin: ${isCompact ? "2rem" : "3rem"} auto;
  padding: 0 1rem;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
`}>
  <div style={`text-align: center; margin-bottom: ${isCompact ? "1.25rem" : "1.75rem"};`}>
    <h2 style={`
      font-size: ${titleSize};
      font-weight: 800;
      color: #1a3c34;
      margin: 0 0 0.5rem 0;
      line-height: 1.25;
    `}>Un accompagnement adapt&eacute; &agrave; votre traitement</h2>
    <p style={`
      font-size: ${subtitleSize};
      color: #5a6b65;
      margin: 0;
      line-height: 1.5;
    `}>Notre partenaire sant&eacute; de confiance pour les patients sous GLP-1</p>
  </div>

  <!-- Annette Card -->
  <div style={`
    background: #fff;
    border: 2px solid #A9E1FF;
    border-radius: 18px;
    padding: ${cardPadding};
    box-shadow: 0 4px 16px rgba(27, 111, 160, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  `}>
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <div style={`
          width: ${isCompact ? "48px" : "56px"};
          height: ${isCompact ? "48px" : "56px"};
          border-radius: 14px;
          background: linear-gradient(135deg, #F0F9FF, #E8F6FF);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
        `}><img src="/images/partners/annette/logo-black.png" alt="Annette" style="height:24px;"></div>
        <div>
          <div style="font-size: 1.3rem; font-weight: 700; color: #1a3c34; line-height: 1.2;">Annette.care</div>
          <span style="font-size: 0.78rem; color: #3B9FD9; font-weight: 500;">Accompagnement nutritionnel GLP-1</span>
        </div>
      </div>
      <span style="background: #E8F6FF; color: #1B6FA0; font-size: 0.72rem; font-weight: 700; padding: 0.3rem 0.75rem; border-radius: 20px; border: 1px dashed #1B6FA0; white-space: nowrap;">
        Code CARE50 : -50% le 1er mois
      </span>
    </div>

    <!-- Description -->
    <p style={`
      font-size: ${featureSize};
      color: #475569;
      line-height: 1.6;
      margin: 0;
    `}>
      Annette propose un suivi di&eacute;t&eacute;tique personnalis&eacute; et un encadrement complet pour les patients sous traitement GLP-1. Leurs m&eacute;decins partenaires assurent la primo-prescription (si &eacute;ligibilit&eacute;) et le renouvellement de votre traitement.
    </p>

    <!-- Features grid -->
    <div class="features-grid" style={`
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    `}>
      <div style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem; background: #F0F9FF; padding: 0.6rem 0.75rem; border-radius: 10px;`}>
        <span style="color: #1B6FA0; flex-shrink: 0; font-weight: 700;">&#10003;</span>
        Di&eacute;t&eacute;ticien d&eacute;di&eacute;
      </div>
      <div style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem; background: #F0F9FF; padding: 0.6rem 0.75rem; border-radius: 10px;`}>
        <span style="color: #1B6FA0; flex-shrink: 0; font-weight: 700;">&#10003;</span>
        Suivi quotidien
      </div>
      <div style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem; background: #F0F9FF; padding: 0.6rem 0.75rem; border-radius: 10px;`}>
        <span style="color: #1B6FA0; flex-shrink: 0; font-weight: 700;">&#10003;</span>
        Primo-prescription &amp; renouvellement
      </div>
      <div style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem; background: #F0F9FF; padding: 0.6rem 0.75rem; border-radius: 10px;`}>
        <span style="color: #1B6FA0; flex-shrink: 0; font-weight: 700;">&#10003;</span>
        Application &amp; IA
      </div>
      <div style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem; background: #F0F9FF; padding: 0.6rem 0.75rem; border-radius: 10px;`}>
        <span style="color: #1B6FA0; flex-shrink: 0; font-weight: 700;">&#10003;</span>
        Communaut&eacute; patients
      </div>
      <div style={`font-size: ${featureSize}; color: #374151; line-height: 1.45; display: flex; align-items: flex-start; gap: 0.45rem; background: #F0F9FF; padding: 0.6rem 0.75rem; border-radius: 10px;`}>
        <span style="color: #1B6FA0; flex-shrink: 0; font-weight: 700;">&#9733;</span>
        4.8/5 sur Google
      </div>
    </div>

    <!-- Pricing + CTA -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-top: 0.5rem; border-top: 1px solid #E8F6FF;">
      <div>
        <span style="font-size: 0.9rem; color: #9ca3af; text-decoration: line-through;">49&euro;/mois</span>
        <span style="font-size: 1.5rem; font-weight: 800; color: #1B6FA0; margin-left: 0.4rem;">24,50&euro;</span>
        <span style="font-size: 0.85rem; color: #6b7280;">/mois le 1er mois</span>
      </div>
      <a
        href={annetteLink}
        target="_blank"
        rel="noopener sponsored"
        style={`
          display: inline-flex;
          align-items: center;
          gap: 0.5rem;
          background: #1B6FA0;
          color: #fff;
          font-size: ${ctaSize};
          font-weight: 700;
          padding: ${ctaPadding};
          border-radius: 12px;
          text-decoration: none;
          transition: background 0.2s ease, transform 0.1s;
          box-shadow: 0 4px 12px rgba(27, 111, 160, 0.2);
          white-space: nowrap;
        `}
      >D&eacute;couvrir le programme &rarr;</a>
    </div>
  </div>

  <p style="font-size: 0.72rem; color: #9ca3af; text-align: center; margin: 0.75rem 0 0; font-style: italic; line-height: 1.4;">
    Lien d'affiliation. GLP-1 France peut recevoir une commission. Cela n'affecte pas nos recommandations &eacute;ditoriales.
  </p>
</section>

<style>
  @media (max-width: 560px) {
    .features-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>
