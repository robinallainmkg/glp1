---
interface Props {
  initialQuery?: string;
  initialCity?: string;
  placeholder?: string;
}

const { 
  initialQuery = '', 
  initialCity = '',
  placeholder = 'Rechercher un médecin, une spécialité...'
} = Astro.props;
---

<div id="professional-search" class="space-y-6">
  <!-- Barre de recherche principale -->
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <input 
      type="text" 
      id="search-input"
      class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-blue-500 focus:border-blue-500 text-lg"
      placeholder={placeholder}
      value={initialQuery}
    />
  </div>

  <!-- Filtres -->
  <div class="flex flex-wrap gap-4">
    <select id="city-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
      <option value="">Toutes les villes</option>
    </select>
    
    <select id="specialty-filter" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
      <option value="">Toutes les spécialités</option>
      <option value="Endocrinologie">Endocrinologie</option>
      <option value="Diabétologie">Diabétologie</option>
      <option value="Nutrition">Nutrition</option>
      <option value="Médecine générale">Médecine générale</option>
      <option value="Obésité">Médecine de l'obésité</option>
    </select>
    
    <label class="inline-flex items-center">
      <input type="checkbox" id="glp1-filter" class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50">
      <span class="ml-2 text-sm text-gray-700">Prescrit GLP-1</span>
    </label>
    
    <label class="inline-flex items-center">
      <input type="checkbox" id="new-patients-filter" class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50">
      <span class="ml-2 text-sm text-gray-700">Accepte nouveaux patients</span>
    </label>
  </div>

  <!-- Résultats -->
  <div id="search-results" class="space-y-4">
    <!-- Les résultats seront insérés ici -->
  </div>

  <!-- Pagination -->
  <div id="pagination" class="flex justify-center items-center space-x-4 mt-8">
    <!-- Les boutons de pagination seront insérés ici -->
  </div>

  <!-- Loading state -->
  <div id="loading" class="hidden text-center py-8">
    <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
    <p class="mt-2 text-gray-600">Recherche en cours...</p>
  </div>

  <!-- No results -->
  <div id="no-results" class="hidden text-center py-8">
    <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.464.881-6.08 2.328C3.672 17.354 2 18.731 2 20.447V21h20v-.553c0-1.716-1.672-3.093-3.92-3.119A7.962 7.962 0 0112 15c-1.657 0-3.157.5-4.414 1.358z"></path>
    </svg>
    <h3 class="mt-4 text-lg font-medium text-gray-900">Aucun professionnel trouvé</h3>
    <p class="mt-2 text-gray-500">Essayez de modifier vos critères de recherche.</p>
  </div>
</div>

<!-- Template pour les cartes de professionnels -->
<template id="professional-card-template">
  <div class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-200 p-6">
    <div class="flex items-start justify-between">
      <div class="flex-1">
        <div class="flex items-center mb-2">
          <h3 class="text-lg font-semibold text-gray-900 professional-name"></h3>
          <span class="ml-2 inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 verified-badge" style="display: none;">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            Vérifié
          </span>
          <span class="ml-2 inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800 featured-badge" style="display: none;">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
            </svg>
            Recommandé
          </span>
        </div>
        <p class="text-sm text-blue-600 mb-1 professional-specialty"></p>
        <p class="text-sm text-gray-600 mb-2 professional-hospital"></p>
        
        <div class="flex items-center mb-2">
          <svg class="w-4 h-4 text-gray-400 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="text-sm text-gray-600 professional-address"></span>
        </div>
        
        <div class="flex items-center space-x-4 text-sm text-gray-600">
          <div class="flex items-center">
            <svg class="w-4 h-4 text-yellow-400 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
            </svg>
            <span class="professional-rating">0</span>
            <span class="ml-1 professional-review-count">(0 avis)</span>
          </div>
          
          <span class="glp1-indicator" style="display: none;">
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
              GLP-1
            </span>
          </span>
          
          <span class="new-patients-indicator" style="display: none;">
            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
              Nouveaux patients
            </span>
          </span>
        </div>
      </div>
      
      <div class="flex flex-col space-y-2 ml-4">
        <a href="#" class="professional-link inline-flex justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
          Voir le profil
        </a>
        <div class="text-right">
          <span class="consultation-fee text-sm font-medium text-gray-900"></span>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
class ProfessionalSearch {
  constructor() {
    this.currentPage = 0;
    this.limit = 10;
    this.totalResults = 0;
    this.searchTimeout = null;
    
    this.initializeElements();
    this.bindEvents();
    this.loadCities();
    this.performSearch(); // Recherche initiale
  }
  
  initializeElements() {
    this.searchInput = document.getElementById('search-input');
    this.cityFilter = document.getElementById('city-filter');
    this.specialtyFilter = document.getElementById('specialty-filter');
    this.glp1Filter = document.getElementById('glp1-filter');
    this.newPatientsFilter = document.getElementById('new-patients-filter');
    this.resultsContainer = document.getElementById('search-results');
    this.paginationContainer = document.getElementById('pagination');
    this.loadingElement = document.getElementById('loading');
    this.noResultsElement = document.getElementById('no-results');
    this.cardTemplate = document.getElementById('professional-card-template');
  }
  
  bindEvents() {
    // Recherche en temps réel avec debounce
    this.searchInput.addEventListener('input', () => {
      clearTimeout(this.searchTimeout);
      this.searchTimeout = setTimeout(() => {
        this.currentPage = 0;
        this.performSearch();
      }, 500);
    });
    
    // Filtres
    [this.cityFilter, this.specialtyFilter, this.glp1Filter, this.newPatientsFilter].forEach(element => {
      element.addEventListener('change', () => {
        this.currentPage = 0;
        this.performSearch();
      });
    });
  }
  
  async loadCities() {
    try {
      const response = await fetch('/api/cities');
      const data = await response.json();
      
      if (data.cities) {
        data.cities.forEach(city => {
          if (city.professionalCount > 0) {
            const option = document.createElement('option');
            option.value = city.slug;
            option.textContent = `${city.name} (${city.professionalCount})`;
            this.cityFilter.appendChild(option);
          }
        });
      }
    } catch (error) {
      console.error('Erreur chargement villes:', error);
    }
  }
  
  async performSearch() {
    this.showLoading();
    
    try {
      const params = new URLSearchParams({
        q: this.searchInput.value,
        city: this.cityFilter.value,
        specialty: this.specialtyFilter.value,
        glp1: this.glp1Filter.checked,
        new_patients: this.newPatientsFilter.checked,
        limit: this.limit.toString(),
        offset: (this.currentPage * this.limit).toString()
      });
      
      const response = await fetch(`/api/professionals/search?${params}`);
      const data = await response.json();
      
      if (data.error) {
        throw new Error(data.error);
      }
      
      this.totalResults = data.total;
      this.displayResults(data.results);
      this.updatePagination(data.hasMore);
      
    } catch (error) {
      console.error('Erreur recherche:', error);
      this.showError('Erreur lors de la recherche. Veuillez réessayer.');
    } finally {
      this.hideLoading();
    }
  }
  
  displayResults(professionals) {
    this.resultsContainer.innerHTML = '';
    
    if (professionals.length === 0) {
      this.showNoResults();
      return;
    }
    
    this.hideNoResults();
    
    professionals.forEach(professional => {
      const card = this.createProfessionalCard(professional);
      this.resultsContainer.appendChild(card);
    });
  }
  
  createProfessionalCard(professional) {
    const template = this.cardTemplate.content.cloneNode(true);
    
    // Nom et badges
    template.querySelector('.professional-name').textContent = professional.name;
    
    if (professional.verified) {
      template.querySelector('.verified-badge').style.display = 'inline-flex';
    }
    
    if (professional.featured) {
      template.querySelector('.featured-badge').style.display = 'inline-flex';
    }
    
    // Informations principales
    template.querySelector('.professional-specialty').textContent = professional.specialty;
    template.querySelector('.professional-hospital').textContent = professional.hospitalClinic || '';
    template.querySelector('.professional-address').textContent = 
      `${professional.address}, ${professional.city} ${professional.postalCode}`;
    
    // Rating et avis
    template.querySelector('.professional-rating').textContent = professional.rating.toFixed(1);
    template.querySelector('.professional-review-count').textContent = 
      `(${professional.reviewCount} avis)`;
    
    // Indicateurs
    if (professional.acceptsGlp1) {
      template.querySelector('.glp1-indicator').style.display = 'inline-block';
    }
    
    if (professional.acceptsNewPatients) {
      template.querySelector('.new-patients-indicator').style.display = 'inline-block';
    }
    
    // Tarif
    if (professional.consultationFee) {
      template.querySelector('.consultation-fee').textContent = `${professional.consultationFee}€`;
    }
    
    // Lien vers le profil
    template.querySelector('.professional-link').href = 
      `/annuaire-professionnels/${professional.citySlug}/${professional.id}`;
    
    return template;
  }
  
  updatePagination(hasMore) {
    this.paginationContainer.innerHTML = '';
    
    if (this.totalResults <= this.limit) {
      return; // Pas besoin de pagination
    }
    
    const totalPages = Math.ceil(this.totalResults / this.limit);
    
    // Bouton précédent
    if (this.currentPage > 0) {
      const prevButton = this.createPaginationButton('Précédent', () => {
        this.currentPage--;
        this.performSearch();
      });
      this.paginationContainer.appendChild(prevButton);
    }
    
    // Numéros de page
    const startPage = Math.max(0, this.currentPage - 2);
    const endPage = Math.min(totalPages - 1, this.currentPage + 2);
    
    for (let i = startPage; i <= endPage; i++) {
      const button = this.createPaginationButton(
        (i + 1).toString(),
        () => {
          this.currentPage = i;
          this.performSearch();
        },
        i === this.currentPage
      );
      this.paginationContainer.appendChild(button);
    }
    
    // Bouton suivant
    if (hasMore) {
      const nextButton = this.createPaginationButton('Suivant', () => {
        this.currentPage++;
        this.performSearch();
      });
      this.paginationContainer.appendChild(nextButton);
    }
    
    // Affichage du total
    const info = document.createElement('span');
    info.className = 'text-sm text-gray-600';
    info.textContent = `${this.totalResults} professionnel${this.totalResults > 1 ? 's' : ''} trouvé${this.totalResults > 1 ? 's' : ''}`;
    this.paginationContainer.appendChild(info);
  }
  
  createPaginationButton(text, onClick, isActive = false) {
    const button = document.createElement('button');
    button.textContent = text;
    button.className = `px-4 py-2 text-sm font-medium rounded-md ${
      isActive 
        ? 'bg-blue-600 text-white' 
        : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'
    }`;
    button.addEventListener('click', onClick);
    return button;
  }
  
  showLoading() {
    this.loadingElement.classList.remove('hidden');
    this.resultsContainer.classList.add('hidden');
    this.noResultsElement.classList.add('hidden');
  }
  
  hideLoading() {
    this.loadingElement.classList.add('hidden');
    this.resultsContainer.classList.remove('hidden');
  }
  
  showNoResults() {
    this.noResultsElement.classList.remove('hidden');
  }
  
  hideNoResults() {
    this.noResultsElement.classList.add('hidden');
  }
  
  showError(message) {
    // Création d'un élément d'erreur temporaire
    const errorDiv = document.createElement('div');
    errorDiv.className = 'bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4';
    errorDiv.textContent = message;
    
    this.resultsContainer.innerHTML = '';
    this.resultsContainer.appendChild(errorDiv);
  }
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', () => {
  new ProfessionalSearch();
});
</script>
