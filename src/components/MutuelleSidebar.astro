---
// Sidebar partenaire Mutuelle — comparateur mutuelle qui rembourse les GLP-1
// (CPA Awin estimé 50-150€/lead).

interface Props {
  context?: string;
}

const { context = "sidebar" } = Astro.props;
const comparateurLink = `/outils/comparateur-mutuelle-glp1/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=mutuelle_${context}`;
---

<aside class="partner-sidebar partner-sidebar-mutuelle">
  <div class="partner-card">
    <div class="partner-header">
      <span class="partner-name">Mutuelle GLP-1</span>
      <span class="partner-badge">Comparateur</span>
    </div>

    <p class="partner-tagline">Trouvez la mutuelle qui rembourse le mieux Wegovy, Mounjaro et Ozempic en 2026.</p>

    <div class="partner-features">
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>MGEN, Harmonie, Apicil, Alan, Acheel...</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Forfaits 50 à 500 €/an</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Comparateur indépendant 100 %</span>
      </div>
      <div class="feature-item">
        <span class="feature-icon">&#10003;</span>
        <span>Sans engagement, gratuit, RGPD</span>
      </div>
    </div>

    <div class="partner-pricing">
      <div class="price-row">
        <span class="price-label">&Eacute;conomie potentielle</span>
        <span class="price-new">jusqu'&agrave; 1&nbsp;800&nbsp;&euro;/an</span>
      </div>
    </div>

    <a
      href={comparateurLink}
      target="_blank"
      rel="noopener sponsored"
      class="partner-cta"
    >
      Comparer (gratuit) &rarr;
    </a>

    <div class="partner-trust">
      <span>Donn&eacute;es prot&eacute;g&eacute;es</span>
      <span class="trust-sep">&middot;</span>
      <span>2 min</span>
    </div>
  </div>

  <p class="partner-disclaimer">
    Lien d'affiliation. GLP-1 France peut recevoir une commission. Cela n'affecte pas nos recommandations &eacute;ditoriales.
  </p>
</aside>

<style>
  .partner-sidebar-mutuelle {
    position: sticky;
    top: 2rem;
    width: 320px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .partner-sidebar-mutuelle .partner-card {
    background: linear-gradient(135deg, #F0F9FF, #E8F6FF);
    border: 2px solid #0D4F73;
    border-radius: 14px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 12px rgba(13, 79, 115, 0.08);
  }
  .partner-sidebar-mutuelle .partner-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .partner-sidebar-mutuelle .partner-name {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0D4F73;
    letter-spacing: -0.02em;
  }
  .partner-sidebar-mutuelle .partner-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: #0D4F73;
    background: #fff;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid #0D4F73;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .partner-sidebar-mutuelle .partner-tagline {
    font-size: 0.9rem;
    color: #1B6FA0;
    line-height: 1.5;
    margin: 0;
  }
  .partner-sidebar-mutuelle .partner-features {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .partner-sidebar-mutuelle .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #0D4F73;
    line-height: 1.4;
  }
  .partner-sidebar-mutuelle .feature-icon {
    color: #0D4F73;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .partner-sidebar-mutuelle .partner-pricing {
    text-align: center;
    background: #fff;
    border-radius: 10px;
    padding: 0.75rem;
    border: 1px solid #c9e3f0;
  }
  .partner-sidebar-mutuelle .price-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-direction: column;
  }
  .partner-sidebar-mutuelle .price-label {
    font-size: 0.78rem;
    color: #1B6FA0;
    font-weight: 600;
  }
  .partner-sidebar-mutuelle .price-new {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0D4F73;
  }
  .partner-sidebar-mutuelle .partner-cta {
    display: block;
    text-align: center;
    background: #0D4F73;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s, transform 0.1s;
  }
  .partner-sidebar-mutuelle .partner-cta:hover {
    background: #083850;
    transform: translateY(-1px);
    color: #fff;
    text-decoration: none;
  }
  .partner-sidebar-mutuelle .partner-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: #6b7280;
  }
  .partner-sidebar-mutuelle .trust-sep {
    color: #d1d5db;
  }
  .partner-sidebar-mutuelle .partner-disclaimer {
    font-size: 0.68rem;
    color: #9a9a9a;
    line-height: 1.4;
    text-align: center;
    margin: 0;
    font-style: italic;
  }
  @media (max-width: 1024px) {
    .partner-sidebar-mutuelle {
      position: static;
      width: 100%;
      max-width: 400px;
      margin: 2rem auto 0;
    }
  }
  @media print {
    .partner-sidebar-mutuelle {
      display: none;
    }
  }
</style>
