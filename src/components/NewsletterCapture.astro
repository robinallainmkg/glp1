---
// Newsletter Capture Component - Lead Magnet
---

<div class="newsletter-capture bg-gradient-to-br from-blue-600 to-purple-700 text-white p-8 rounded-2xl shadow-2xl my-12">
  <div class="max-w-2xl mx-auto text-center">
    <div class="mb-6">
      <h3 class="text-2xl md:text-3xl font-bold mb-4">
        📋 Guide Gratuit : Prix GLP-1 Actualisés 2026
      </h3>
      <p class="text-blue-100 text-lg">
        Recevez le comparateur complet des prix Ozempic, Wegovy, Mounjaro + liste des médecins qui prescrivent
      </p>
    </div>

    <form id="newsletter-form" class="space-y-4">
      <div class="flex flex-col md:flex-row gap-4 max-w-md mx-auto">
        <input 
          type="email" 
          id="email" 
          placeholder="Votre email"
          class="flex-1 px-4 py-3 rounded-xl text-gray-900 border-2 border-transparent focus:border-yellow-400 focus:outline-none"
          required
        />
        <button 
          type="submit"
          class="px-8 py-3 bg-gradient-to-r from-yellow-400 to-orange-500 text-white font-bold rounded-xl hover:from-yellow-500 hover:to-orange-600 transition-all transform hover:scale-105"
        >
          Recevoir le Guide
        </button>
      </div>
      
      <div class="flex items-center justify-center gap-2 text-sm text-blue-100 mt-4">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
        </svg>
        <span>Données sécurisées - Pas de spam - Désabonnement facile</span>
      </div>
    </form>

    <!-- Social Proof -->
    <div class="mt-6 flex justify-center items-center gap-8 text-blue-100">
      <div class="text-center">
        <div class="text-2xl font-bold text-yellow-400">7</div>
        <div class="text-sm">Traitements comparés</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-yellow-400">★★★★★</div>
        <div class="text-sm">Guide noté 4.8/5</div>
      </div>
      <div class="text-center">
        <div class="text-2xl font-bold text-yellow-400">100%</div>
        <div class="text-sm">Gratuit et sans engagement</div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var SB_URL = "https://ywekaivgjzsmdocchvum.supabase.co";
  var SB_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl3ZWthaXZnanpzbWRvY2NodnVtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTUzNjQ0MDcsImV4cCI6MjA3MDk0MDQwN30.f2Mo-77InzZHnK1o7bMNs1ZC3DyX7EkPl964ksQTafY";

  var form = document.getElementById('newsletter-form');
  if (!form) return;

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    var emailInput = document.getElementById('email');
    var email = emailInput ? emailInput.value : '';
    var button = form.querySelector('button');
    if (!button || !email) return;
    var originalText = button.textContent;

    button.textContent = 'Inscription...';
    button.disabled = true;

    try {
      var resp = await fetch(SB_URL + '/rest/v1/contacts', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SB_KEY,
          'Authorization': 'Bearer ' + SB_KEY
        },
        body: JSON.stringify({
          email: email,
          subject: 'Newsletter - Guide Prix GLP-1',
          message: 'Inscription newsletter via homepage',
          newsletter: true,
          contact_type: 'newsletter',
          status: 'new'
        })
      });

      if (!resp.ok) {
        console.error('Erreur Supabase:', resp.status);
        button.textContent = originalText;
        button.disabled = false;
        alert('Erreur lors de l\'inscription. Veuillez reessayer.');
        return;
      }

      button.textContent = '✅ Inscrit !';
      button.className = button.className.replace('from-yellow-400 to-orange-500', 'from-green-400 to-green-500');
      if (emailInput) emailInput.disabled = true;
    } catch (error) {
      console.error('Erreur:', error);
      button.textContent = originalText;
      button.disabled = false;
      alert('Erreur de connexion. Veuillez reessayer.');
    }
  });
})();
</script>
