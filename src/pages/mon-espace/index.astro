    // ===== WEIGHT HISTORY =====
    async function loadWeightHistory() {
      var s = initSb();
      var result = await s.from('user_checkins')
        .select('weight, checked_at, mood')
        .eq('user_id', currentUser.id)
        .order('checked_at', { ascending: true })
        .limit(30);

      var checkins = result.data;
      if (!checkins || checkins.length === 0) return;

      // Update badges
      updateBadgesFromCheckins(checkins);

      var latest = checkins[checkins.length - 1];
      document.getElementById('psWeight').textContent = latest.weight + ' kg';

      // Update goal progress
      if (profile.weight_goal && checkins.length >= 1) {
        var firstW = checkins[0].weight;
        var currentW = latest.weight;
        var totalToLose = firstW - profile.weight_goal;
        var lost = firstW - currentW;
        var pct = totalToLose > 0 ? Math.min(100, Math.max(0, Math.round((lost / totalToLose) * 100))) : 0;
        document.getElementById('goalPercent').textContent = pct + '%';
        document.getElementById('goalBarFill').style.width = pct + '%';
        document.getElementById('goalStart').textContent = 'D\u00e9part : ' + firstW + ' kg';
      }

      // Show delta
      if (checkins.length >= 2) {
        var first = checkins[0].weight;
        var last = latest.weight;
        var delta = (last - first).toFixed(1);
        var prefix = delta > 0 ? '+' : '';
        var color = delta <= 0 ? '#16a34a' : '#dc2626';
        document.getElementById('weightDelta').innerHTML = '<span style="color:' + color + ';font-weight:700;">' + prefix + delta + ' kg</span>';
      }

      // SVG chart
      var chartEl = document.getElementById('weightChart');
      var weights = checkins.map(function(c) { return c.weight; });
      var min = Math.min.apply(null, weights) - 1;
      var max = Math.max.apply(null, weights) + 1;
      var range = max - min || 1;
      var w = 100;
      var h = 100;
      var padding = 10;

      var points = checkins.map(function(c, i) {
        var x = padding + (i / Math.max(1, checkins.length - 1)) * (w - 2 * padding);
        var y = h - padding - ((c.weight - min) / range) * (h - 2 * padding);
        return { x: x, y: y, weight: c.weight, date: c.checked_at };
      });

      var pathD = points.map(function(p, i) { return (i === 0 ? 'M' : 'L') + p.x + ',' + p.y; }).join(' ');
      var areaD = pathD + ' L' + points[points.length-1].x + ',' + (h - padding) + ' L' + points[0].x + ',' + (h - padding) + ' Z';

      // Goal line
      var goalY = profile.weight_goal ? h - padding - ((profile.weight_goal - min) / range) * (h - 2 * padding) : -1;

      var svg = '<svg viewBox="0 0 ' + w + ' ' + h + '" style="width:100%;height:100%;" preserveAspectRatio="none">';
      svg += '<defs><linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#16a34a" stop-opacity="0.3"/><stop offset="100%" stop-color="#16a34a" stop-opacity="0.02"/></linearGradient></defs>';
      svg += '<path d="' + areaD + '" fill="url(#chartGrad)"/>';
      svg += '<path d="' + pathD + '" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';

      if (goalY > 0 && goalY < h) {
        svg += '<line x1="' + padding + '" y1="' + goalY + '" x2="' + (w - padding) + '" y2="' + goalY + '" stroke="#f59e0b" stroke-width="0.8" stroke-dasharray="3,3"/>';
        svg += '<text x="' + (w - padding) + '" y="' + (goalY - 2) + '" text-anchor="end" font-size="4" fill="#f59e0b">Objectif</text>';
      }

      points.forEach(function(p) {
        svg += '<circle cx="' + p.x + '" cy="' + p.y + '" r="2" fill="#16a34a"/>';
      });

      // Labels
      svg += '<text x="' + points[0].x + '" y="' + (h - 2) + '" text-anchor="start" font-size="4" fill="#94a3b8">' + new Date(points[0].date).toLocaleDateString('fr-FR', {day:'2-digit',month:'short'}) + '</text>';
      svg += '<text x="' + points[points.length-1].x + '" y="' + (h - 2) + '" text-anchor="end" font-size="4" fill="#94a3b8">' + new Date(points[points.length-1].date).toLocaleDateString('fr-FR', {day:'2-digit',month:'short'}) + '</text>';
      svg += '<text x="' + padding + '" y="' + (padding + 3) + '" font-size="4" fill="#64748b">' + max.toFixed(0) + ' kg</text>';
      svg += '<text x="' + padding + '" y="' + (h - padding - 1) + '" font-size="4" fill="#64748b">' + min.toFixed(0) + ' kg</text>';

      svg += '</svg>';
      chartEl.innerHTML = svg;
    }

    function updateBadgesFromCheckins(checkins) {
      if (!checkins || checkins.length === 0) return;
      var first = checkins[0].weight;
      var last = checkins[checkins.length - 1].weight;
      var lost = first - last;

      var badges = [
        { icon: '\uD83C\uDF1F', name: 'Premier pas', condition: true },
        { icon: '\uD83D\uDCAA', name: '1er check-in', condition: checkins.length >= 1 },
        { icon: '\uD83D\uDD25', name: '7 jours', condition: checkins.length >= 7 },
        { icon: '\uD83C\uDFC6', name: '30 jours', condition: checkins.length >= 30 },
        { icon: '\uD83C\uDFAF', name: '-5 kg', condition: lost >= 5 },
        { icon: '\uD83D\uDE80', name: '-10 kg', condition: lost >= 10 },
        { icon: '\uD83D\uDC89', name: '10 injections', condition: checkins.length >= 10 },
        { icon: '\uD83E\uDDD8', name: 'Zen master', condition: checkins.filter(function(c){ return c.mood === 'top'; }).length >= 7 },
      ];

      var html = '';
      badges.forEach(function(b) {
        var cls = b.condition ? 'unlocked' : 'locked';
        html += '<div class="badge-item ' + cls + '">';
        html += '<div class="badge-icon">' + b.icon + '</div>';
        html += '<div class="badge-name">' + b.name + '</div>';
        html += '</div>';
      });
      document.getElementById('badgesGrid').innerHTML = html;
    }

    // ===== RECOMMENDATIONS =====
    function generateRecommendations() {
      var recos = [];
      var p = profile;

      if (p.treatment === 'ozempic' || p.treatment === 'wegovy') {
        recos.push({ icon: '\uD83D\uDC89', text: '<strong>Semaglutide</strong> \u2014 Augmentez progressivement la dose toutes les 4 semaines. Ne sautez jamais une injection.' });
      } else if (p.treatment === 'mounjaro') {
        recos.push({ icon: '\uD83D\uDC89', text: '<strong>Tirzepatide</strong> \u2014 Double action GIP/GLP-1. Injectez toujours dans l\'abdomen, la cuisse ou le bras.' });
      }

      if (p.protein_goal) {
        recos.push({ icon: '\uD83E\uDD69', text: '<strong>' + p.protein_goal + 'g de proteines/jour</strong> \u2014 Essentiel sous GLP-1 pour preserver la masse musculaire. Repartissez sur 3 repas.' });
      }

      recos.push({ icon: '\uD83D\uDCA7', text: '<strong>Hydratation</strong> \u2014 Buvez au moins ' + (p.water_goal || 2) + 'L d\'eau par jour. Les GLP-1 augmentent le risque de d\u00e9shydratation.' });

      if (p.sport_level === 'sedentaire') {
        recos.push({ icon: '\uD83D\uDEB6', text: '<strong>Commencez doucement</strong> \u2014 20 min de marche par jour suffisent pour commencer. Augmentez progressivement.' });
      } else if (p.sport_level === 'leger' || p.sport_level === 'modere') {
        recos.push({ icon: '\uD83C\uDFC3', text: '<strong>Ajoutez de la resistance</strong> \u2014 2-3 seances de musculation legere par semaine pour maintenir la masse musculaire.' });
      } else {
        recos.push({ icon: '\uD83D\uDCAA', text: '<strong>Maintenez l\'intensite</strong> \u2014 Votre niveau d\'activite est excellent. Privilegiez les proteines apres l\'effort.' });
      }

      recos.push({ icon: '\uD83C\uDF7D\uFE0F', text: '<strong>Naus\u00e9es</strong> \u2014 Mangez lentement, en petites portions. \u00c9vitez les aliments gras et \u00e9pic\u00e9s les jours suivant l\'injection.' });

      if (p.weight_current && p.weight_goal) {
        var toGo = (p.weight_current - p.weight_goal).toFixed(1);
        if (toGo > 0) {
          recos.push({ icon: '\uD83C\uDFAF', text: '<strong>' + toGo + ' kg de votre objectif</strong> \u2014 \u00c0 raison de 0.5-1kg/semaine avec un GLP-1, vous pouvez y \u00eatre dans ' + Math.round(toGo / 0.75) + ' semaines.' });
        }
      }

      var html = '';
      recos.forEach(function(r) {
        html += '<div class="reco-item"><div class="reco-icon">' + r.icon + '</div><div class="reco-text">' + r.text + '</div></div>';
      });
      document.getElementById('recoList').innerHTML = html;
    }

    // ===== CHECKIN =====
    async function saveCheckin() {
      var w = parseFloat(document.getElementById('checkinWeight').value);
      if (!w || w < 30 || w > 300) return showToast('Entrez un poids valide (30-300 kg)', 'error');
      var mood = document.getElementById('checkinMood').value;

      var btn = document.getElementById('btnCheckin');
      btn.innerHTML = '<span class="spinner"></span>';
      btn.disabled = true;

      var s = initSb();
      var result = await s.from('user_checkins').insert({
        user_id: currentUser.id,
        weight: w,
        mood: mood,
      });

      if (result.error) {
        btn.innerHTML = 'Enregistrer';
        btn.disabled = false;
        return showToast('Erreur: ' + result.error.message, 'error');
      }

      await s.from('user_profiles').update({ weight_current: w, updated_at: new Date().toISOString() }).eq('user_id', currentUser.id);
      profile.weight_current = w;

      document.getElementById('checkinWeight').value = '';
      document.getElementById('psWeight').textContent = w + ' kg';
      btn.innerHTML = 'Enregistrer';
      btn.disabled = false;

      showToast('Poids enregistr\u00e9 : ' + w + ' kg');
      loadWeightHistory();
      generateRecommendations();

      // Update BMI
      if (profile.height_cm) {
        var hm = profile.height_cm / 100;
        var bmi = (w / (hm * hm)).toFixed(1);
        var bmiBadge = document.getElementById('bmiBadge');
        var bmiClass = bmi < 25 ? 'bmi-normal' : bmi < 30 ? 'bmi-overweight' : 'bmi-obese';
        var bmiLabel = bmi < 18.5 ? 'Insuffisance pond\u00e9rale' : bmi < 25 ? 'Poids normal' : bmi < 30 ? 'Surpoids' : 'Ob\u00e9sit\u00e9';
        bmiBadge.className = 'bmi-badge ' + bmiClass;
        bmiBadge.innerHTML = 'IMC ' + bmi + ' \u2014 ' + bmiLabel;
        bmiBadge.style.display = 'inline-flex';
      }
    }

    // ===== SIDE EFFECTS =====
    var activeSideEffects = [];

    function toggleSe(el) {
      var se = el.dataset.se;
      if (se === 'aucun') {
        activeSideEffects = ['aucun'];
        document.querySelectorAll('.se-tag').forEach(function(t) { t.classList.remove('active'); });
        el.classList.add('active');
        return;
      }
      // Remove 'aucun' if selecting something else
      var aucunIdx = activeSideEffects.indexOf('aucun');
      if (aucunIdx > -1) {
        activeSideEffects.splice(aucunIdx, 1);
        document.querySelector('.se-tag[data-se="aucun"]').classList.remove('active');
      }

      var idx = activeSideEffects.indexOf(se);
      if (idx > -1) {
        activeSideEffects.splice(idx, 1);
        el.classList.remove('active');
      } else {
        activeSideEffects.push(se);
        el.classList.add('active');
      }
    }

    async function saveSideEffects() {
      if (activeSideEffects.length === 0) return showToast('S\u00e9lectionnez au moins un effet', 'info');

      var s = initSb();
      var note = document.getElementById('seNote').value.trim();

      try {
        await s.from('user_side_effects').insert({
          user_id: currentUser.id,
          effects: activeSideEffects,
          note: note || null,
        });
        showToast('Effets secondaires enregistr\u00e9s');
        activeSideEffects = [];
        document.querySelectorAll('.se-tag').forEach(function(t) { t.classList.remove('active'); });
        document.getElementById('seNote').value = '';
      } catch(e) {
        showToast('Table non disponible \u2014 effets not\u00e9s localement', 'info');
        // Store locally as fallback
        var stored = JSON.parse(localStorage.getItem('glp1_side_effects') || '[]');
        stored.push({ date: new Date().toISOString(), effects: activeSideEffects, note: note });
        localStorage.setItem('glp1_side_effects', JSON.stringify(stored));
        activeSideEffects = [];
        document.querySelectorAll('.se-tag').forEach(function(t) { t.classList.remove('active'); });
        document.getElementById('seNote').value = '';
      }
    }

    function viewSeHistory() {
      showToast('Historique des effets secondaires bient\u00f4t disponible', 'info');
    }

    // ===== CALENDAR EXPORT =====
    function exportICS(type) {
      var event = {};
      if (type === 'injection') {
        event = { title: 'Injection ' + (profile.treatment || 'GLP-1'), desc: 'Rappel injection hebdomadaire \u2014 ' + (profile.current_dose || '') + '\\nConseil: alternez les sites d\'injection', freq: 'WEEKLY', duration: '0030' };
      } else if (type === 'stock') {
        event = { title: 'Verifier stock ' + (profile.treatment || 'GLP-1'), desc: 'Verifiez votre stock de stylos/seringues.', freq: 'MONTHLY', duration: '0015' };
      } else if (type === 'rdv') {
        event = { title: 'RDV medecin \u2014 Bilan suivi GLP-1', desc: 'Bilan sanguin recommande :\\n- Glycemie\\n- HbA1c\\n- Bilan lipidique\\n- Fonction renale', freq: 'MONTHLY;INTERVAL=3', duration: '0100' };
      } else if (type === 'checkin') {
        event = { title: 'Pesee hebdomadaire', desc: 'Pesez-vous a jeun, le matin.', freq: 'WEEKLY', duration: '0005' };
      }

      var dtstart = formatICSDate(nextOccurrence(type));
      var uid = type + '-' + Date.now() + '@glp1-france.fr';
      var ics = ['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//GLP1 France//Coach//FR','BEGIN:VEVENT','UID:' + uid,'DTSTART:' + dtstart,'DURATION:PT' + (event.duration || '0030').replace(/^00/, '') + 'M','SUMMARY:' + event.title,'DESCRIPTION:' + (event.desc || ''),'RRULE:FREQ=' + (event.freq || 'WEEKLY'),'BEGIN:VALARM','TRIGGER:-PT30M','ACTION:DISPLAY','DESCRIPTION:Rappel','END:VALARM','END:VEVENT','END:VCALENDAR'].join('\r\n');

      var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'glp1-' + type + '.ics';
      a.click();
      showToast('Fichier calendrier t\u00e9l\u00e9charg\u00e9', 'success');
    }

    function exportAllCalendar() {
      ['injection', 'stock', 'rdv', 'checkin'].forEach(function(t) { exportICS(t); });
    }

    function nextOccurrence(type) {
      var d = new Date();
      if (type === 'injection') {
        var days = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
        var target = days.indexOf(profile.injection_day || 'vendredi');
        var diff = target - d.getDay();
        if (diff <= 0) diff += 7;
        d.setDate(d.getDate() + diff);
        d.setHours(9, 0, 0);
      } else if (type === 'checkin') {
        var diff2 = 1 - d.getDay();
        if (diff2 <= 0) diff2 += 7;
        d.setDate(d.getDate() + diff2);
        d.setHours(7, 0, 0);
      } else {
        d.setDate(d.getDate() + 7);
        d.setHours(10, 0, 0);
      }
      return d;
    }

    function formatICSDate(d) {
      return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    }

    function editProfile() {
      obStep = 0;
      obData = {
        prenom: profile.prenom || '', status: profile.status || '',
        treatment: profile.treatment || '', current_dose: profile.current_dose || '',
        injection_day: profile.injection_day || '', weight_current: profile.weight_current || '',
        weight_goal: profile.weight_goal || '', height_cm: profile.height_cm || '',
        age: profile.age || '', gender: profile.gender || '',
        sport_level: profile.sport_level || '', diet_type: profile.diet_type || '',
      };
      showScreen('Onboarding');
      renderObStep();
    }

    function closePaywall() {
      document.getElementById('paywallOverlay').classList.remove('open');
      window.location.href = '/';
    }

    var pwBillingType = 'monthly';
    function togglePaywallBilling() {
      var toggle = document.getElementById('pw-billing-toggle');
      var priceEl = document.getElementById('pw-price');
      var detailEl = document.getElementById('pw-detail');
      if (toggle.checked) {
        pwBillingType = 'yearly';
        priceEl.innerHTML = '33&#8364; <span>/an</span>';
        detailEl.textContent = 'Soit 2,75\u20ac/mois \u2014 \u00e9conomisez 30%';
      } else {
        pwBillingType = 'monthly';
        priceEl.innerHTML = '4&#8364; <span>/mois</span>';
        detailEl.textContent = '7 jours d\'essai gratuit';
      }
    }

    async function subscribe() {
      var btn = document.getElementById('pw-subscribe-btn');
      btn.disabled = true;
      btn.textContent = 'Chargement...';
      try {
        var session = await sb.auth.getSession();
        if (!session.data.session) {
          showToast('Veuillez vous connecter d\'abord', 'error');
          btn.disabled = false;
          btn.textContent = 'Commencer l\'essai gratuit';
          return;
        }
        var resp = await fetch(supabaseUrl + '/functions/v1/stripe-checkout', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + session.data.session.access_token,
            'apikey': supabaseKey,
          },
          body: JSON.stringify({ price_type: pwBillingType }),
        });
        var data = await resp.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          showToast(data.error || 'Erreur lors du paiement', 'error');
          btn.disabled = false;
          btn.textContent = 'Commencer l\'essai gratuit';
        }
      } catch (err) {
        showToast('Erreur de connexion', 'error');
        btn.disabled = false;
        btn.textContent = 'Commencer l\'essai gratuit';
      }
    }

    async function openStripePortal() {
      try {
        var session = await sb.auth.getSession();
        var resp = await fetch(supabaseUrl + '/functions/v1/stripe-portal', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + session.data.session.access_token,
            'apikey': supabaseKey,
          },
        });
        var data = await resp.json();
        if (data.url) window.location.href = data.url;
        else showToast(data.error || 'Erreur', 'error');
      } catch (err) {
        showToast('Erreur de connexion', 'error');
      }
    }

    // ===== INIT =====
    async function init() {
      try {
        var s = initSb();
        var result = await s.auth.getSession();
        var session = result.data.session;
        if (session && session.user) {
          currentUser = session.user;
          await onUserReady();

          // Handle Stripe return params
          var params = new URLSearchParams(window.location.search);
          if (params.get('subscription') === 'success') {
            showToast('Abonnement activ\u00e9 ! Bienvenue en Premium', 'success');
            window.history.replaceState({}, '', '/mon-espace/');
          } else if (params.get('subscription') === 'cancel') {
            showToast('Paiement annul\u00e9. Vous pouvez r\u00e9essayer.', 'info');
            window.history.replaceState({}, '', '/mon-espace/');
          }
        } else {
          showScreen('Auth');
          var params = new URLSearchParams(window.location.search);
          if (params.get('tab') === 'login') {
            switchAuthTab('login');
          }
          if (params.get('redirect') === 'tarifs') {
            showToast('Connectez-vous pour acc\u00e9der \u00e0 l\'abonnement', 'info');
          }
        }

        s.auth.onAuthStateChange(function(event, session) {
          if (event === 'SIGNED_IN' && session && session.user) {
            currentUser = session.user;
            onUserReady(session.user.user_metadata?.prenom);
          }
        });
      } catch(e) {
        console.error('Init error:', e);
        showScreen('Auth');
      }
      hideLoading();
    }

    // ===== CHAT =====
    var chatConvId = localStorage.getItem('glp1_coach_conv') || null;
    var chatSessionId = localStorage.getItem('glp1_coach_session') || crypto.randomUUID();
    localStorage.setItem('glp1_coach_session', chatSessionId);

    function openChat() {
      document.getElementById('chatOverlay').classList.add('open');
      document.getElementById('chatInput').focus();
      // Update welcome with profile
      if (profile && profile.prenom) {
        document.getElementById('chatWelcome').innerHTML =
          'Bonjour ' + profile.prenom + ' ! Je suis votre Coach GLP-1 personnel. Je connais votre profil et peux vous aider.<br><br>Que puis-je faire pour vous ?';
      }
    }

    function closeChat() {
      document.getElementById('chatOverlay').classList.remove('open');
    }

    function chatQuick(q) {
      document.getElementById('chatInput').value = q;
      sendChat();
    }

    async function sendChat() {
      var input = document.getElementById('chatInput');
      var text = input.value.trim();
      if (!text) return;

      var sendBtn = document.getElementById('chatSendBtn');
      var messagesEl = document.getElementById('chatMessages');
      var quickBtns = document.getElementById('chatQuickBtns');

      // Hide quick buttons
      if (quickBtns) quickBtns.style.display = 'none';

      // Show user message
      var userDiv = document.createElement('div');
      userDiv.className = 'chat-msg chat-msg-user';
      userDiv.textContent = text;
      messagesEl.insertBefore(userDiv, document.getElementById('chatTyping'));
      messagesEl.scrollTop = messagesEl.scrollHeight;

      input.value = '';
      sendBtn.disabled = true;

      // Show typing
      document.getElementById('chatTyping').classList.add('visible');

      try {
        var edgeUrl = supabaseUrl + '/functions/v1/ai-coach';

        var response = await fetch(edgeUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer ' + supabaseKey,
            'apikey': supabaseKey
          },
          body: JSON.stringify({
            session_id: chatSessionId,
            message: text,
            conversation_id: chatConvId,
            page_url: '/mon-espace/',
            user_id: currentUser ? currentUser.id : null,
            user_context: profile ? {
              prenom: profile.prenom,
              treatment: profile.treatment,
              status: profile.status,
              weight_current: profile.weight_current,
              weight_goal: profile.weight_goal,
              current_dose: profile.current_dose,
              sport_level: profile.sport_level,
              diet_type: profile.diet_type
            } : null
          })
        });

        document.getElementById('chatTyping').classList.remove('visible');

        if (!response.ok) {
          var errDiv = document.createElement('div');
          errDiv.className = 'chat-msg chat-msg-assistant';
          errDiv.textContent = 'D\u00e9sol\u00e9, une erreur est survenue. R\u00e9essayez dans quelques instants.';
          messagesEl.insertBefore(errDiv, document.getElementById('chatTyping'));
          sendBtn.disabled = false;
          return;
        }

        var data = await response.json();
        if (data.conversation_id) {
          chatConvId = data.conversation_id;
          localStorage.setItem('glp1_coach_conv', chatConvId);
        }

        var assistDiv = document.createElement('div');
        assistDiv.className = 'chat-msg chat-msg-assistant';
        assistDiv.innerHTML = (data.response || 'D\u00e9sol\u00e9, je n\'ai pas pu r\u00e9pondre.').replace(/\n/g, '<br>');
        messagesEl.insertBefore(assistDiv, document.getElementById('chatTyping'));
        messagesEl.scrollTop = messagesEl.scrollHeight;

      } catch (err) {
        document.getElementById('chatTyping').classList.remove('visible');
        var errDiv2 = document.createElement('div');
        errDiv2.className = 'chat-msg chat-msg-assistant';
        errDiv2.textContent = 'Le service est temporairement indisponible. R\u00e9essayez dans quelques instants.';
        messagesEl.insertBefore(errDiv2, document.getElementById('chatTyping'));
      }
      sendBtn.disabled = false;
    }

    // Expose to global scope
    window.switchAuthTab = switchAuthTab;
    window.signInGoogle = signInGoogle;
    window.signUpEmail = signUpEmail;
    window.signInEmail = signInEmail;
    window.resetPassword = resetPassword;
    window.doLogout = doLogout;
    window.editProfile = editProfile;
    window.saveCheckin = saveCheckin;
    window.exportAllCalendar = exportAllCalendar;
    window.exportICS = exportICS;
    window.subscribe = subscribe;
    window.closePaywall = closePaywall;
    window.obSelect = obSelect;
    window.obPrev = obPrev;
    window.obNext = obNext;
    window.obFinish = obFinish;
    window.togglePw = togglePw;
    window.toggleSe = toggleSe;
    window.saveSideEffects = saveSideEffects;
    window.viewSeHistory = viewSeHistory;
    window.openChat = openChat;
    window.closeChat = closeChat;
    window.sendChat = sendChat;
    window.chatQuick = chatQuick;

    init();
  </script>
</body>
</html>
