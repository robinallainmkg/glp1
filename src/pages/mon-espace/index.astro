  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script is:inline define:vars={{ supabaseUrl: supabaseConfig.url, supabaseKey: supabaseConfig.anonKey }}>
    let sb, currentUser, profile;

    function initSb() {
      if (sb) return sb;
      if (!window.supabase || !window.supabase.createClient) {
        throw new Error('Supabase JS not loaded');
      }
      sb = window.supabase.createClient(supabaseUrl, supabaseKey);
      return sb;
    }

    // ===== AUTH =====
    function showScreen(name) {
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
      document.getElementById('screen' + name).classList.add('active');
    }

    function switchAuthTab(tab) {
      document.querySelectorAll('.auth-tab').forEach(t => t.classList.remove('active'));
      if (tab === 'signup') {
        document.querySelectorAll('.auth-tab')[0].classList.add('active');
        document.getElementById('authFormSignup').style.display = 'block';
        document.getElementById('authFormLogin').style.display = 'none';
      } else {
        document.querySelectorAll('.auth-tab')[1].classList.add('active');
        document.getElementById('authFormSignup').style.display = 'none';
        document.getElementById('authFormLogin').style.display = 'block';
      }
    }

    function showAuthError(msg) {
      var el = document.getElementById('authError');
      el.textContent = msg;
      el.style.display = 'block';
      setTimeout(function() { el.style.display = 'none'; }, 5000);
    }

    async function signInGoogle() {
      try {
        var s = initSb();
        var { error } = await s.auth.signInWithOAuth({
          provider: 'google',
          options: { redirectTo: window.location.origin + '/mon-espace/' }
        });
        if (error) showAuthError(error.message);
      } catch(e) { showAuthError('Erreur de connexion. Rechargez la page.'); console.error(e); }
    }

    async function signUpEmail() {
      try {
        var s = initSb();
        var email = document.getElementById('signupEmail').value.trim();
        var pw = document.getElementById('signupPassword').value;
        var name = document.getElementById('signupName').value.trim();
        if (!email || !pw) return showAuthError('Email et mot de passe requis');
        if (pw.length < 6) return showAuthError('Mot de passe : 6 caracteres minimum');

        var { data, error } = await s.auth.signUp({
          email: email,
          password: pw,
          options: { data: { prenom: name } }
        });
        if (error) return showAuthError(error.message);
        currentUser = data.user;
        if (currentUser) onUserReady(name);
      } catch(e) { showAuthError('Erreur de connexion. Rechargez la page.'); console.error(e); }
    }

    async function signInEmail() {
      try {
        var s = initSb();
        var email = document.getElementById('loginEmail').value.trim();
        var pw = document.getElementById('loginPassword').value;
        if (!email || !pw) return showAuthError('Email et mot de passe requis');

        var { data, error } = await s.auth.signInWithPassword({ email: email, password: pw });
        if (error) return showAuthError(error.message);
        currentUser = data.user;
        if (currentUser) onUserReady();
      } catch(e) { showAuthError('Erreur de connexion. Rechargez la page.'); console.error(e); }
    }

    async function doLogout() {
      var s = await initSb();
      await s.auth.signOut();
      currentUser = null;
      profile = null;
      showScreen('Auth');
    }

    async function onUserReady(prenomHint) {
      var s = await initSb();

      // Link chat session to this user (unified funnel)
      linkChatSession(currentUser.id);

      // Check if profile exists
      var { data } = await s.from('user_profiles').select('*').eq('user_id', currentUser.id).single();
      if (data) {
        profile = data;
        showDashboard();
      } else {
        obData.prenom = prenomHint || currentUser.user_metadata?.prenom || '';
        showScreen('Onboarding');
        renderObStep();
      }
    }

    async function linkChatSession(userId) {
      // Link any anonymous chat conversations from the widget to this user
      var sessionId = localStorage.getItem('glp1_coach_session');
      if (!sessionId) return;
      var s = await initSb();
      try {
        await s.from('coach_conversations').update({ user_id: userId }).eq('session_id', sessionId).is('user_id', null);
        await s.from('coach_messages').update({ user_id: userId }).eq('session_id', sessionId).is('user_id', null);
      } catch(e) { /* ignore */ }
    }

    // ===== ONBOARDING =====
    var obStep = 0;
    var obData = {
      prenom: '',
      status: '',
      treatment: '',
      current_dose: '',
      injection_day: '',
      weight_current: '',
      weight_goal: '',
      height_cm: '',
      age: '',
      gender: '',
      sport_level: '',
      sport_types: [],
      diet_type: 'standard',
    };

    var obSteps = [
      {
        title: 'Quel est votre parcours avec les traitements GLP-1 ?',
        subtitle: 'Votre coach s\u2019adapte selon que vous d\u00e9butez ou que vous \u00eates d\u00e9j\u00e0 suivi(e).',
        field: 'status',
        type: 'select',
        options: [
          { val: 'exploring', emoji: '\uD83D\uDD0D', label: 'Je me renseigne' },
          { val: 'starting', emoji: '\uD83D\uDE80', label: 'Je vais bient\u00f4t commencer' },
          { val: 'ongoing', emoji: '\uD83D\uDC89', label: 'Je suis d\u00e9j\u00e0 sous traitement' },
          { val: 'paused', emoji: '\u23F8\uFE0F', label: 'J\u2019ai arr\u00eat\u00e9 mon traitement' },
        ]
      },
      {
        title: 'Quel traitement GLP-1 prenez-vous ou envisagez-vous ?',
        subtitle: 'Chaque mol\u00e9cule a ses sp\u00e9cificit\u00e9s \u2014 votre suivi sera adapt\u00e9 en cons\u00e9quence.',
        field: 'treatment',
        type: 'select',
        options: [
          { val: 'ozempic', emoji: '\uD83D\uDC8A', label: 'Ozempic (s\u00e9maglutide)' },
          { val: 'wegovy', emoji: '\uD83D\uDC8A', label: 'Wegovy (s\u00e9maglutide HD)' },
          { val: 'mounjaro', emoji: '\uD83D\uDC8A', label: 'Mounjaro (tirzépatide)' },
          { val: 'saxenda', emoji: '\uD83D\uDC8A', label: 'Saxenda (liraglutide)' },
          { val: 'other', emoji: '\uD83D\uDC8A', label: 'Autre traitement' },
          { val: 'none', emoji: '\u2753', label: 'Pas encore d\u00e9cid\u00e9(e)' },
        ]
      },
      {
        title: 'Vos donn\u00e9es corporelles',
        subtitle: 'Ces informations permettent de calculer vos besoins \u00e9nerg\u00e9tiques et prot\u00e9iques adapt\u00e9s au traitement GLP-1.',
        type: 'inputs',
        inputs: [
          { row: [
            { field: 'weight_current', label: 'Poids actuel (kg)', type: 'number', placeholder: '82' },
            { field: 'weight_goal', label: 'Poids objectif (kg)', type: 'number', placeholder: '68' },
          ]},
          { row: [
            { field: 'height_cm', label: 'Taille (cm)', type: 'number', placeholder: '170' },
            { field: 'age', label: '\u00C2ge', type: 'number', placeholder: '45' },
          ]},
          { field: 'gender', label: 'Genre', type: 'select-inline',
            options: [
              { val: 'femme', label: 'Femme' },
              { val: 'homme', label: 'Homme' },
              { val: 'autre', label: 'Autre' },
            ]
          },
        ]
      },
      {
        title: 'Quel est votre niveau d\u2019activit\u00e9 physique ?',
        subtitle: 'L\u2019exercice joue un r\u00f4le cl\u00e9 pour pr\u00e9server la masse musculaire sous GLP-1.',
        field: 'sport_level',
        type: 'select',
        options: [
          { val: 'sedentaire', emoji: '\uD83D\uDECB\uFE0F', label: 'S\u00e9dentaire' },
          { val: 'leger', emoji: '\uD83D\uDEB6', label: 'L\u00e9ger (marche r\u00e9guli\u00e8re)' },
          { val: 'modere', emoji: '\uD83C\uDFC3', label: 'Mod\u00e9r\u00e9 (2-3 s\u00e9ances/sem.)' },
          { val: 'actif', emoji: '\uD83D\uDCAA', label: 'Actif (4-5 s\u00e9ances/sem.)' },
          { val: 'sportif', emoji: '\uD83C\uDFCB\uFE0F', label: 'Sportif confirm\u00e9' },
        ]
      },
      {
        title: 'Comment d\u00e9cririez-vous votre alimentation ?',
        subtitle: 'Vos recommandations nutritionnelles seront personnalis\u00e9es en fonction de votre r\u00e9gime.',
        field: 'diet_type',
        type: 'select',
        options: [
          { val: 'standard', emoji: '\uD83C\uDF7D\uFE0F', label: '\u00C9quilibr\u00e9e / Standard' },
          { val: 'vegetarien', emoji: '\uD83E\uDD6C', label: 'V\u00e9g\u00e9tarienne' },
          { val: 'vegan', emoji: '\uD83C\uDF31', label: 'V\u00e9gane' },
          { val: 'sans-gluten', emoji: '\uD83C\uDF3E', label: 'Sans gluten' },
          { val: 'keto', emoji: '\uD83E\uDD51', label: 'C\u00e9tog\u00e8ne / Low-carb' },
          { val: 'halal', emoji: '\uD83C\uDF56', label: 'Halal' },
        ]
      },
    ];

    function renderObStep() {
      var step = obSteps[obStep];
      document.getElementById('obStepLabel').textContent = 'Etape ' + (obStep + 1) + '/' + obSteps.length;

      // Progress
      var steps = document.querySelectorAll('.onboarding-progress .step');
      steps.forEach(function(s, i) {
        s.className = 'step' + (i < obStep ? ' done' : '') + (i === obStep ? ' active' : '');
      });

      var html = '<h2>' + step.title + '</h2><p class="subtitle">' + step.subtitle + '</p>';

      if (step.type === 'select') {
        html += '<div class="ob-options">';
        step.options.forEach(function(o) {
          var sel = obData[step.field] === o.val ? ' selected' : '';
          html += '<div class="ob-option' + sel + '" onclick="obSelect(\'' + step.field + '\',\'' + o.val + '\')">';
          html += '<span class="emoji">' + o.emoji + '</span>' + o.label + '</div>';
        });
        html += '</div>';
      } else if (step.type === 'inputs') {
        step.inputs.forEach(function(inp) {
          if (inp.row) {
            html += '<div class="ob-input-row">';
            inp.row.forEach(function(r) {
              html += '<div class="form-group"><label>' + r.label + '</label>';
              html += '<input type="' + r.type + '" value="' + (obData[r.field] || '') + '" placeholder="' + r.placeholder + '" onchange="obData[\'' + r.field + '\']=this.value"></div>';
            });
            html += '</div>';
          } else if (inp.type === 'select-inline') {
            html += '<div class="form-group"><label>' + inp.label + '</label></div>';
            html += '<div class="ob-options" style="margin-bottom:1rem;">';
            inp.options.forEach(function(o) {
              var sel = obData[inp.field] === o.val ? ' selected' : '';
              html += '<div class="ob-option' + sel + '" onclick="obSelect(\'' + inp.field + '\',\'' + o.val + '\')">' + o.label + '</div>';
            });
            html += '</div>';
          }
        });
      }

      // Nav
      html += '<div class="ob-nav">';
      if (obStep > 0) html += '<button class="btn-back" onclick="obPrev()">Retour</button>';
      var isLast = obStep === obSteps.length - 1;
      html += '<button class="btn-next" onclick="' + (isLast ? 'obFinish()' : 'obNext()') + '">' + (isLast ? 'Terminer ✓' : 'Suivant →') + '</button>';
      html += '</div>';

      document.getElementById('obContent').innerHTML = html;
    }

    function obSelect(field, val) {
      obData[field] = val;
      renderObStep();
    }

    function obNext() {
      if (obStep < obSteps.length - 1) { obStep++; renderObStep(); }
    }
    function obPrev() {
      if (obStep > 0) { obStep--; renderObStep(); }
    }

    async function obFinish() {
      var s = await initSb();

      // Calculate nutrition targets
      var w = parseFloat(obData.weight_current) || 80;
      var h = parseInt(obData.height_cm) || 170;
      var a = parseInt(obData.age) || 40;
      var g = obData.gender;

      // Mifflin-St Jeor BMR
      var bmr = g === 'homme'
        ? (10 * w + 6.25 * h - 5 * a + 5)
        : (10 * w + 6.25 * h - 5 * a - 161);

      var activityMulti = { sedentaire: 1.2, leger: 1.375, modere: 1.55, actif: 1.725, sportif: 1.9 };
      var tdee = bmr * (activityMulti[obData.sport_level] || 1.3);
      var dailyCal = Math.round(tdee - 500); // Deficit for weight loss
      if (dailyCal < 1200) dailyCal = 1200;

      var proteinGoal = Math.round(w * 1.5); // 1.5g/kg under GLP-1
      var waterGoal = Math.round((w * 0.035) * 10) / 10; // 35ml/kg

      var profileData = {
        user_id: currentUser.id,
        prenom: obData.prenom,
        email: currentUser.email,
        status: obData.status,
        treatment: obData.treatment,
        current_dose: obData.current_dose || null,
        injection_day: obData.injection_day || 'vendredi',
        weight_current: parseFloat(obData.weight_current) || null,
        weight_goal: parseFloat(obData.weight_goal) || null,
        height_cm: parseInt(obData.height_cm) || null,
        age: parseInt(obData.age) || null,
        gender: obData.gender,
        sport_level: obData.sport_level,
        diet_type: obData.diet_type,
        daily_calories: dailyCal,
        protein_goal: proteinGoal,
        water_goal: waterGoal,
        subscription_plan: 'free',
      };

      var { data, error } = await s.from('user_profiles').upsert(profileData, { onConflict: 'user_id' }).select().single();
      if (error) { console.error('Profile save error:', error); alert('Erreur: ' + error.message); return; }

      profile = data;

      // Save first weight checkin
      if (obData.weight_current) {
        await s.from('user_checkins').insert({
          user_id: currentUser.id,
          weight: parseFloat(obData.weight_current),
          mood: 'bien',
        });
      }

      showDashboard();
    }

    // ===== DASHBOARD =====
    async function showDashboard() {
      showScreen('Dashboard');

      // Greeting
      var hour = new Date().getHours();
      var greet = hour < 12 ? 'Bonjour' : hour < 18 ? 'Bon apres-midi' : 'Bonsoir';
      var name = profile.prenom || currentUser.email?.split('@')[0] || '';
      document.getElementById('greetingText').textContent = greet + (name ? ', ' + name : '') + ' !';
      document.getElementById('dashUserName').textContent = name || currentUser.email;

      // Trial banner
      if (!profile.is_subscribed) {
        var trialEnd = new Date(profile.trial_end);
        var now = new Date();
        var daysLeft = Math.max(0, Math.ceil((trialEnd - now) / 86400000));
        if (daysLeft > 0) {
          document.getElementById('trialBanner').style.display = 'block';
          document.getElementById('trialDays').textContent = daysLeft + ' jour' + (daysLeft > 1 ? 's' : '') + ' restant' + (daysLeft > 1 ? 's' : '');
        } else {
          document.getElementById('paywallOverlay').classList.add('open');
        }
      }

      // Profile summary
      var treatNames = { ozempic: 'Ozempic', wegovy: 'Wegovy', mounjaro: 'Mounjaro', saxenda: 'Saxenda', other: 'Autre', none: '-' };
      document.getElementById('psWeight').textContent = profile.weight_current ? profile.weight_current + ' kg' : '-';
      document.getElementById('psGoal').textContent = profile.weight_goal ? profile.weight_goal + ' kg' : '-';
      document.getElementById('psTreatment').textContent = treatNames[profile.treatment] || profile.treatment || '-';
      document.getElementById('psDose').textContent = profile.current_dose || '-';

      // Programme
      document.getElementById('progCalories').textContent = profile.daily_calories || '-';
      document.getElementById('progProtein').textContent = profile.protein_goal || '-';
      document.getElementById('progWater').textContent = profile.water_goal || '-';

      // Injection reminder
      if (profile.injection_day) {
        var days = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
        var targetDay = days.indexOf(profile.injection_day);
        var today = new Date();
        var todayDay = today.getDay();
        var diff = targetDay - todayDay;
        if (diff <= 0) diff += 7;
        if (diff === 7) {
          document.getElementById('reminderInjection').textContent = 'Aujourd\'hui !';
        } else if (diff === 1) {
          document.getElementById('reminderInjection').textContent = 'Demain — ' + profile.injection_day;
        } else {
          document.getElementById('reminderInjection').textContent = 'Dans ' + diff + ' jours — ' + profile.injection_day;
        }
      }

      // Load weight history
      loadWeightHistory();

      // Generate recommendations
      generateRecommendations();
    }

    async function loadWeightHistory() {
      var s = await initSb();
      var { data: checkins } = await s.from('user_checkins')
        .select('weight, checked_at, mood')
        .eq('user_id', currentUser.id)
        .order('checked_at', { ascending: true })
        .limit(30);

      if (!checkins || checkins.length === 0) return;

      // Update current weight from latest
      var latest = checkins[checkins.length - 1];
      document.getElementById('psWeight').textContent = latest.weight + ' kg';

      // Show delta
      if (checkins.length >= 2) {
        var first = checkins[0].weight;
        var last = latest.weight;
        var delta = (last - first).toFixed(1);
        var prefix = delta > 0 ? '+' : '';
        var color = delta <= 0 ? '#16a34a' : '#dc2626';
        document.getElementById('weightDelta').innerHTML = '<span style="color:' + color + ';font-weight:700;">' + prefix + delta + ' kg</span>';
      }

      // Simple text chart (no canvas dependency)
      var chartEl = document.getElementById('weightChart');
      var weights = checkins.map(function(c) { return c.weight; });
      var min = Math.min.apply(null, weights);
      var max = Math.max.apply(null, weights);
      var range = max - min || 1;

      var bars = '';
      checkins.forEach(function(c, i) {
        var pct = ((c.weight - min) / range * 60) + 20;
        var date = new Date(c.checked_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
        var moodEmoji = { top: '😄', bien: '🙂', moyen: '😐', difficile: '😔' };
        bars += '<div style="display:flex;flex-direction:column;align-items:center;flex:1;min-width:0;">';
        bars += '<div style="font-size:0.6rem;color:#64748b;margin-bottom:2px;">' + c.weight + '</div>';
        bars += '<div style="width:100%;max-width:24px;background:#16a34a;border-radius:4px 4px 0 0;height:' + pct + '%;opacity:' + (0.4 + (i / checkins.length) * 0.6) + ';"></div>';
        bars += '<div style="font-size:0.55rem;color:#94a3b8;margin-top:2px;">' + date + '</div>';
        bars += '</div>';
      });

      chartEl.innerHTML = '<div style="display:flex;align-items:end;gap:2px;height:100%;width:100%;padding:8px;">' + bars + '</div>';
    }

    function generateRecommendations() {
      var recos = [];
      var p = profile;

      // Treatment-specific
      if (p.treatment === 'ozempic' || p.treatment === 'wegovy') {
        recos.push({ icon: '💉', text: '<strong>Semaglutide</strong> — Augmentez progressivement la dose toutes les 4 semaines. Ne sautez jamais une injection.' });
      } else if (p.treatment === 'mounjaro') {
        recos.push({ icon: '💉', text: '<strong>Tirzepatide</strong> — Double action GIP/GLP-1. Injectez toujours dans l\'abdomen, la cuisse ou le bras.' });
      }

      // Protein
      if (p.protein_goal) {
        recos.push({ icon: '🥩', text: '<strong>' + p.protein_goal + 'g de proteines/jour</strong> — Essentiel sous GLP-1 pour preserver la masse musculaire. Repartissez sur 3 repas.' });
      }

      // Hydration
      recos.push({ icon: '💧', text: '<strong>Hydratation</strong> — Buvez au moins ' + (p.water_goal || 2) + 'L d\'eau par jour. Les GLP-1 augmentent le risque de deshydratation.' });

      // Sport-specific
      if (p.sport_level === 'sedentaire') {
        recos.push({ icon: '🚶', text: '<strong>Commencez doucement</strong> — 20 min de marche par jour suffisent pour commencer. Augmentez progressivement chaque semaine.' });
      } else if (p.sport_level === 'leger' || p.sport_level === 'modere') {
        recos.push({ icon: '🏃', text: '<strong>Ajoutez de la resistance</strong> — 2-3 seances de musculation legere par semaine pour maintenir la masse musculaire.' });
      } else {
        recos.push({ icon: '💪', text: '<strong>Maintenez l\'intensite</strong> — Votre niveau d\'activite est excellent. Privilegiez les proteines apres l\'effort.' });
      }

      // Nausea tip (common side effect)
      recos.push({ icon: '🍽️', text: '<strong>Nausees</strong> — Mangez lentement, en petites portions. Evitez les aliments gras et epices les jours suivant l\'injection.' });

      // Weight delta motivation
      if (p.weight_current && p.weight_goal) {
        var toGo = (p.weight_current - p.weight_goal).toFixed(1);
        if (toGo > 0) {
          recos.push({ icon: '🎯', text: '<strong>' + toGo + ' kg de votre objectif</strong> — A raison de 0.5-1kg/semaine avec un GLP-1, vous pouvez y etre dans ' + Math.round(toGo / 0.75) + ' semaines.' });
        }
      }

      var html = '';
      recos.forEach(function(r) {
        html += '<div class="reco-item"><div class="reco-icon">' + r.icon + '</div><div class="reco-text">' + r.text + '</div></div>';
      });
      document.getElementById('recoList').innerHTML = html;
    }

    // ===== CHECKIN =====
    async function saveCheckin() {
      var w = parseFloat(document.getElementById('checkinWeight').value);
      if (!w || w < 30 || w > 300) return alert('Entrez un poids valide');
      var mood = document.getElementById('checkinMood').value;

      var s = await initSb();
      var { error } = await s.from('user_checkins').insert({
        user_id: currentUser.id,
        weight: w,
        mood: mood,
      });
      if (error) return alert('Erreur: ' + error.message);

      // Update profile weight
      await s.from('user_profiles').update({ weight_current: w, updated_at: new Date().toISOString() }).eq('user_id', currentUser.id);
      profile.weight_current = w;

      document.getElementById('checkinWeight').value = '';
      document.getElementById('psWeight').textContent = w + ' kg';
      loadWeightHistory();
      generateRecommendations();
    }

    // ===== CALENDAR EXPORT (.ics) =====
    function exportICS(type) {
      var now = new Date();
      var event = {};

      if (type === 'injection') {
        var day = profile.injection_day || 'vendredi';
        event = {
          title: 'Injection ' + (profile.treatment || 'GLP-1'),
          desc: 'Rappel injection hebdomadaire — ' + (profile.current_dose || '') + '\\nConseil: alternez les sites d\'injection',
          freq: 'WEEKLY',
          duration: '0030',
        };
      } else if (type === 'stock') {
        event = {
          title: 'Verifier stock ' + (profile.treatment || 'GLP-1'),
          desc: 'Verifiez votre stock de stylos/seringues.\\nSi < 2 semaines de stock, renouvelez votre ordonnance.',
          freq: 'MONTHLY',
          duration: '0015',
        };
      } else if (type === 'rdv') {
        event = {
          title: 'RDV medecin — Bilan suivi GLP-1',
          desc: 'Bilan sanguin recommande :\\n- Glycemie\\n- HbA1c\\n- Bilan lipidique\\n- Fonction renale',
          freq: 'MONTHLY;INTERVAL=3',
          duration: '0100',
        };
      } else if (type === 'checkin') {
        event = {
          title: 'Pesee hebdomadaire',
          desc: 'Pesez-vous a jeun, le matin.\\nNotez votre poids sur glp1-france.fr/mon-espace/',
          freq: 'WEEKLY',
          duration: '0005',
        };
      }

      // Generate .ics
      var dtstart = formatICSDate(nextOccurrence(type));
      var uid = type + '-' + Date.now() + '@glp1-france.fr';

      var ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//GLP1 France//Coach//FR',
        'BEGIN:VEVENT',
        'UID:' + uid,
        'DTSTART:' + dtstart,
        'DURATION:PT' + (event.duration || '0030').replace(/^00/, '') + 'M',
        'SUMMARY:' + event.title,
        'DESCRIPTION:' + (event.desc || ''),
        'RRULE:FREQ=' + (event.freq || 'WEEKLY'),
        'BEGIN:VALARM',
        'TRIGGER:-PT30M',
        'ACTION:DISPLAY',
        'DESCRIPTION:Rappel',
        'END:VALARM',
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'glp1-' + type + '.ics';
      a.click();
    }

    function exportAllCalendar() {
      ['injection', 'stock', 'rdv', 'checkin'].forEach(function(t) { exportICS(t); });
    }

    function nextOccurrence(type) {
      var d = new Date();
      if (type === 'injection') {
        var days = ['dimanche','lundi','mardi','mercredi','jeudi','vendredi','samedi'];
        var target = days.indexOf(profile.injection_day || 'vendredi');
        var diff = target - d.getDay();
        if (diff <= 0) diff += 7;
        d.setDate(d.getDate() + diff);
        d.setHours(9, 0, 0);
      } else if (type === 'checkin') {
        var diff2 = 1 - d.getDay(); // Monday
        if (diff2 <= 0) diff2 += 7;
        d.setDate(d.getDate() + diff2);
        d.setHours(7, 0, 0);
      } else {
        d.setDate(d.getDate() + 7);
        d.setHours(10, 0, 0);
      }
      return d;
    }

    function formatICSDate(d) {
      return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    }

    function editProfile() {
      obStep = 0;
      obData = {
        prenom: profile.prenom || '',
        status: profile.status || '',
        treatment: profile.treatment || '',
        current_dose: profile.current_dose || '',
        injection_day: profile.injection_day || '',
        weight_current: profile.weight_current || '',
        weight_goal: profile.weight_goal || '',
        height_cm: profile.height_cm || '',
        age: profile.age || '',
        gender: profile.gender || '',
        sport_level: profile.sport_level || '',
        diet_type: profile.diet_type || '',
      };
      showScreen('Onboarding');
      renderObStep();
    }

    function closePaywall() {
      document.getElementById('paywallOverlay').classList.remove('open');
      window.location.href = '/';
    }

    function subscribe() {
      // TODO: Stripe integration
      alert('Paiement Stripe bientot disponible ! Contactez-nous a robin@glp1-france.fr');
    }

    // ===== INIT =====
    async function init() {
      try {
        var s = initSb();
        var { data: { session } } = await s.auth.getSession();
        if (session && session.user) {
          currentUser = session.user;
          onUserReady();
        } else {
          showScreen('Auth');
          // Handle ?tab=login from chat widget redirect
          var params = new URLSearchParams(window.location.search);
          if (params.get('tab') === 'login') {
            switchAuthTab('login');
          }
        }

        // Listen for auth changes (OAuth redirect)
        s.auth.onAuthStateChange(function(event, session) {
          if (event === 'SIGNED_IN' && session && session.user) {
            currentUser = session.user;
            onUserReady(session.user.user_metadata?.prenom);
          }
        });
      } catch(e) {
        console.error('Init error:', e);
        // Show auth screen even if Supabase fails to load
        showScreen('Auth');
      }
    }

    // Expose functions to global scope for onclick handlers
    window.switchAuthTab = switchAuthTab;
    window.signInGoogle = signInGoogle;
    window.signUpEmail = signUpEmail;
    window.signInEmail = signInEmail;
    window.doLogout = doLogout;
    window.editProfile = editProfile;
    window.saveCheckin = saveCheckin;
    window.exportAllCalendar = exportAllCalendar;
    window.exportICS = exportICS;
    window.subscribe = subscribe;
    window.closePaywall = closePaywall;
    window.obSelect = obSelect;
    window.obPrev = obPrev;
    window.obNext = obNext;
    window.obFinish = obFinish;

    init();
  </script>
