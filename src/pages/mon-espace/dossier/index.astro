---
import { supabaseConfig } from '../../../lib/supabase';
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mon Dossier GLP-1 — Coach GLP-1</title>
  <meta name="robots" content="noindex, nofollow" />
  <style is:inline>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f0fdf4;color:#1e293b;min-height:100vh}
    .wrap{max-width:560px;margin:0 auto;padding:40px 20px}
    .card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:28px;box-shadow:0 4px 20px rgba(0,0,0,.06)}
    .hd{background:linear-gradient(135deg,#1a3c34,#16a34a);border-radius:16px 16px 0 0;padding:24px;color:#fff;margin:-28px -28px 22px}
    h1{font-size:1.35rem;margin-bottom:6px;line-height:1.25}
    .muted{color:#6b7280;font-size:.92rem;line-height:1.6}
    .pill{display:inline-block;background:rgba(255,255,255,.22);color:#fff;border-radius:999px;padding:4px 12px;font-size:.72rem;font-weight:700;margin-bottom:12px}
    .btn{display:block;width:100%;background:#16a34a;color:#fff;border:none;border-radius:10px;padding:15px;font-size:1rem;font-weight:700;cursor:pointer;margin-top:18px;text-align:center;text-decoration:none}
    .btn:hover{background:#15803d}
    .btn:disabled{opacity:.6;cursor:default}
    .btn-secondary{display:block;width:100%;background:#fff;color:#1a3c34;border:2px solid #16a34a;border-radius:10px;padding:13px;font-size:.95rem;font-weight:700;cursor:pointer;margin-top:10px;text-align:center;text-decoration:none}
    .btn-secondary:hover{background:#f0fdf4}
    .status-box{padding:16px;border-radius:10px;margin:16px 0;text-align:center}
    .status-success{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534}
    .status-pending{background:#fef9c3;border:1px solid #fde68a;color:#854d0e}
    .status-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .spinner{display:inline-block;width:20px;height:20px;border:3px solid #ddd;border-top-color:#1e40af;border-radius:50%;animation:spin .8s linear infinite;margin-right:8px;vertical-align:middle}
    @keyframes spin{to{transform:rotate(360deg)}}
    a.back{display:inline-block;margin-top:18px;color:#6b7280;font-size:.85rem;text-decoration:none}
    .center{text-align:center}
    /* le dossier est plus large que la carte de statut : on deborde le .wrap */
    #viewer:not(:empty){margin-top:20px;width:min(920px,100vw - 40px);margin-left:50%;transform:translateX(-50%);background:#fff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.06)}
    .viewer-frame{display:block;width:100%;height:78vh;min-height:520px;border:0}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card" id="root"><p class="center muted"><span class="spinner"></span>Chargement...</p></div>
    <div id="viewer"></div>
    <p class="center"><a class="back" href="/">← Retour au site</a></p>
  </div>

  <script define:vars={{ supabaseUrl: supabaseConfig.url, SB_KEY: supabaseConfig.anonKey }}>
  (function(){
    var root = document.getElementById('root');
    var params = new URLSearchParams(window.location.search);
    var status = params.get('status');
    var dossierId = params.get('dossier_id');

    if (status === 'cancel') {
      root.innerHTML =
        '<div class="hd"><div class="pill">ANNULE</div><h1>Paiement annule</h1><p style="opacity:.85;font-size:.9rem">Ton dossier n\'a pas ete genere.</p></div>' +
        '<p class="muted">Tu peux retenter a tout moment depuis le Coach IA.</p>' +
        '<a href="/" class="btn">Retour au site</a>';
      return;
    }

    if (status !== 'success' || !dossierId) {
      root.innerHTML =
        '<div class="status-box status-error"><strong>Lien invalide</strong><br>Verifie ton email pour le lien de telechargement.</div>' +
        '<a href="/" class="btn">Retour au site</a>';
      return;
    }

    // Poll for dossier generation
    root.innerHTML =
      '<div class="hd"><div class="pill">PAIEMENT CONFIRME</div><h1>Merci ! Ton dossier est en preparation...</h1><p style="opacity:.85;font-size:.9rem">Generation en cours, ca prend quelques secondes.</p></div>' +
      '<div class="status-box status-pending" id="gen-status"><span class="spinner"></span>Generation du dossier...</div>';

    var attempts = 0;
    var maxAttempts = 30;

    function checkDossier() {
      attempts++;
      fetch(supabaseUrl + '/rest/v1/dossiers?id=eq.' + dossierId + '&select=status,pdf_url,prenom,verdict', {
        headers: { 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY }
      })
      .then(function(r) { return r.json(); })
      .then(function(rows) {
        if (!rows || !rows.length) {
          document.getElementById('gen-status').innerHTML = '<strong>Dossier introuvable</strong>';
          return;
        }
        var d = rows[0];
        if (d.status === 'generated' && d.pdf_url) {
          // Le Storage supabase.co sert les .html en text/plain (anti-phishing) :
          // un lien direct affiche le code source brut. On force donc le
          // telechargement (&download=) et on propose une lecture via blob.
          var dlUrl = d.pdf_url + (d.pdf_url.indexOf('?') > -1 ? '&' : '?') + 'download=dossier-glp1-personnalise.html';
          root.innerHTML =
            '<div class="hd"><div class="pill">PRET</div><h1>' + (d.prenom ? d.prenom + ', ton' : 'Ton') + ' dossier GLP-1 est pret !</h1><p style="opacity:.85;font-size:.9rem">' + (d.verdict || 'Dossier personnalise') + '</p></div>' +
            '<div class="status-box status-success"><strong>Dossier genere avec succes</strong></div>' +
            '<button id="view-btn" class="btn">Lire mon dossier</button>' +
            '<a href="' + dlUrl + '" class="btn-secondary">Telecharger (fichier a ouvrir dans ton navigateur)</a>' +
            '<p class="muted" style="margin-top:16px;text-align:center">Le lien reste actif — tu peux y revenir a tout moment. Astuce : depuis le dossier ouvert, Ctrl+P / Imprimer pour en faire un PDF.</p>';
          document.getElementById('view-btn').addEventListener('click', function(){
            // Lecture INLINE : window.open() apres un fetch async est bloque par
            // les popup blockers (Safari/iOS surtout) — le client cliquait sans
            // rien voir. On rend le dossier dans un iframe de la page courante.
            var btn = this;
            var host = document.getElementById('viewer');
            if (host.getAttribute('data-loaded') === '1') {
              host.scrollIntoView({ behavior: 'smooth' });
              return;
            }
            btn.disabled = true;
            btn.textContent = 'Ouverture...';
            fetch(d.pdf_url)
              .then(function(r){ return r.text(); })
              .then(function(htmlContent){
                var frame = document.createElement('iframe');
                frame.className = 'viewer-frame';
                frame.setAttribute('title', 'Mon dossier GLP-1');
                frame.srcdoc = htmlContent;
                host.innerHTML = '';
                host.appendChild(frame);
                host.setAttribute('data-loaded', '1');
                btn.disabled = false;
                btn.textContent = 'Revenir a mon dossier';
                host.scrollIntoView({ behavior: 'smooth' });
              })
              .catch(function(){
                btn.disabled = false;
                btn.textContent = 'Lire mon dossier';
                window.location.href = dlUrl;
              });
          });
        } else if (d.status === 'paid' && attempts < maxAttempts) {
          setTimeout(checkDossier, 2000);
        } else if (attempts >= maxAttempts) {
          document.getElementById('gen-status').innerHTML =
            '<strong>La generation prend plus de temps que prevu.</strong><br>Rafraichis cette page dans quelques minutes.';
        }
      })
      .catch(function() {
        if (attempts < maxAttempts) setTimeout(checkDossier, 3000);
      });
    }

    setTimeout(checkDossier, 2000);
  })();
  </script>
</body>
</html>
