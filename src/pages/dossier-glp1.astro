---
import StaticLayout from '../layouts/StaticLayout.astro';
import { supabaseConfig } from '../lib/supabase';
---

<StaticLayout
  title="Mon Dossier GLP-1 Personnalisé — 4,99€ | Éligibilité & Parcours"
  description="Obtenez votre dossier GLP-1 personnalisé : verdict d'éligibilité au remboursement 65%, checklist RDV médecin, CSO près de chez vous, estimation financière. Prêt en 2 minutes."
  keywords="dossier glp1, éligibilité remboursement wegovy, remboursement mounjaro, CSO obésité, parcours glp1"
>

<div class="dossier-page">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-badge">Nouveau</div>
      <h1>Mon Dossier GLP-1 Personnalise</h1>
      <p class="hero-sub">Tout ce qu'il faut pour preparer ton rendez-vous medecin — pret en 2 minutes.</p>
      <div class="hero-features">
        <span>Verdict d'eligibilite</span>
        <span>Checklist RDV</span>
        <span>CSO pres de chez toi</span>
        <span>Estimation financiere</span>
      </div>
      <a href="#formulaire" class="hero-cta">Obtenir mon dossier — 4,99€</a>
      <p class="hero-trust">Paiement securise Stripe &bull; Document pret en 2 min &bull; Telechargement immediat</p>
    </div>
  </section>

  <!-- WHAT YOU GET -->
  <section class="what-you-get">
    <div class="container">
      <h2>Ce que contient ton dossier</h2>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">&#9989;</div>
          <h3>Verdict d'eligibilite</h3>
          <p>Analyse de ton IMC et de tes comorbidites pour savoir si tu as droit au remboursement a 65%.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128176;</div>
          <h3>Estimation financiere</h3>
          <p>Cout reel apres remboursement Secu + mutuelle, pour Wegovy et Mounjaro.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#127973;</div>
          <h3>CSO pres de chez toi</h3>
          <p>Le centre specialise de l'obesite le plus proche, avec coordonnees et telephone.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128203;</div>
          <h3>Checklist RDV medecin</h3>
          <p>Documents a apporter, questions a poser, etapes du parcours — tout est pret.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128105;&#8205;&#9877;&#65039;</div>
          <h3>Parcours detaille</h3>
          <p>De la primo-prescription au renouvellement : chaque etape expliquee simplement.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">&#128196;</div>
          <h3>Pret a imprimer</h3>
          <p>Formate pour A4, emmene-le directement a ton rendez-vous medecin.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section class="form-section" id="formulaire">
    <div class="container">
      <div class="form-card">
        <h2>Remplis tes informations</h2>
        <p class="form-sub">6 questions, 1 minute — ton dossier sera genere apres le paiement.</p>

        <form id="dossier-form">
          <!-- Step 1: Prenom -->
          <div class="form-step active" data-step="1">
            <label for="prenom">Ton prenom</label>
            <input type="text" id="prenom" name="prenom" placeholder="Marie" required autocomplete="given-name">
            <button type="button" class="btn-next" data-next="2">Continuer</button>
          </div>

          <!-- Step 2: Poids + Taille -->
          <div class="form-step" data-step="2">
            <label>Ton poids et ta taille</label>
            <div class="input-row">
              <div class="input-group">
                <input type="number" id="poids" name="poids_kg" placeholder="85" required min="30" max="300" step="0.1">
                <span class="input-suffix">kg</span>
              </div>
              <div class="input-group">
                <input type="number" id="taille" name="taille_cm" placeholder="170" required min="100" max="250" step="1">
                <span class="input-suffix">cm</span>
              </div>
            </div>
            <div id="imc-preview" class="imc-preview" style="display:none"></div>
            <button type="button" class="btn-next" data-next="3">Continuer</button>
          </div>

          <!-- Step 3: Comorbidites -->
          <div class="form-step" data-step="3">
            <label>As-tu une ou plusieurs de ces conditions ?</label>
            <div class="checkbox-grid">
              <label class="checkbox-label"><input type="checkbox" name="comorbidites" value="Diabète T2"><span>Diabete type 2</span></label>
              <label class="checkbox-label"><input type="checkbox" name="comorbidites" value="Hypertension"><span>Hypertension</span></label>
              <label class="checkbox-label"><input type="checkbox" name="comorbidites" value="Apnée du sommeil"><span>Apnee du sommeil</span></label>
              <label class="checkbox-label"><input type="checkbox" name="comorbidites" value="Dyslipidémie"><span>Dyslipidemie</span></label>
              <label class="checkbox-label"><input type="checkbox" name="comorbidites" value="Stéatose hépatique"><span>Steatose hepatique</span></label>
              <label class="checkbox-label"><input type="checkbox" name="comorbidites" value="Arthrose"><span>Arthrose</span></label>
            </div>
            <button type="button" class="btn-next" data-next="4">Continuer</button>
          </div>

          <!-- Step 4: Ville -->
          <div class="form-step" data-step="4">
            <label for="ville">Ta ville (pour trouver le CSO le plus proche)</label>
            <input type="text" id="ville" name="ville" placeholder="Lyon, Paris, Marseille..." autocomplete="address-level2">
            <button type="button" class="btn-next" data-next="5">Continuer</button>
          </div>

          <!-- Step 5: Traitement + Suivi -->
          <div class="form-step" data-step="5">
            <label for="traitement">Quel traitement t'interesse ?</label>
            <select id="traitement" name="traitement_souhaite">
              <option value="">Je ne sais pas encore</option>
              <option value="Wegovy">Wegovy (semaglutide)</option>
              <option value="Mounjaro">Mounjaro (tirzepatide)</option>
              <option value="Ozempic">Ozempic (semaglutide)</option>
              <option value="Saxenda">Saxenda (liraglutide)</option>
            </select>
            <label class="checkbox-single"><input type="checkbox" id="suivi" name="suivi_nutritionnel"><span>J'ai deja suivi un programme nutritionnel</span></label>
            <button type="button" class="btn-next" data-next="6">Continuer</button>
          </div>

          <!-- Step 6: Email + Paiement -->
          <div class="form-step" data-step="6">
            <label for="email">Ton email (pour recevoir le dossier)</label>
            <input type="email" id="email" name="email" placeholder="marie@exemple.fr" required autocomplete="email">
            <div class="recap" id="recap"></div>
            <button type="submit" class="btn-pay" id="btn-pay">Obtenir mon dossier — 4,99€</button>
            <p class="pay-note">Paiement securise par Stripe. Tu recevras ton dossier immediatement.</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="container">
      <h2>Questions frequentes</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>C'est quoi exactement ce dossier ?</summary>
          <p>Un document HTML (imprimable en PDF) personnalise avec tes donnees : verdict d'eligibilite au remboursement a 65%, le CSO le plus proche, une estimation du cout apres remboursement, et une checklist complete pour ton rendez-vous medecin.</p>
        </details>
        <details class="faq-item">
          <summary>Est-ce que c'est un avis medical ?</summary>
          <p>Non. C'est un document d'information qui t'aide a preparer ton rendez-vous. Seul un medecin peut poser un diagnostic et prescrire un traitement.</p>
        </details>
        <details class="faq-item">
          <summary>Combien de temps pour recevoir mon dossier ?</summary>
          <p>Immediat. Apres le paiement, tu es redirige vers une page de telechargement. Le dossier est genere en quelques secondes.</p>
        </details>
        <details class="faq-item">
          <summary>Et si je ne suis pas eligible ?</summary>
          <p>Le dossier t'explique pourquoi et te donne les alternatives. C'est aussi utile de savoir ou tu en es avant d'aller chez le medecin.</p>
        </details>
        <details class="faq-item">
          <summary>C'est quoi le remboursement a 65% ?</summary>
          <p>Depuis le 15 juin 2026, Wegovy et Mounjaro sont rembourses a 65% par l'Assurance Maladie pour l'obesite (IMC &ge; 35 avec comorbidite ou IMC &ge; 40), avec primo-prescription en CSO/CHU.</p>
        </details>
      </div>
    </div>
  </section>
</div>

<style is:inline>
  .dossier-page { font-family: 'Onest', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  .container { max-width: 800px; margin: 0 auto; padding: 0 20px; }

  /* HERO */
  .hero { background: linear-gradient(135deg, #1e3a8a, #2563eb); color: #fff; padding: 60px 20px 50px; text-align: center; }
  .hero-badge { display: inline-block; background: rgba(255,255,255,.18); border-radius: 999px; padding: 4px 14px; font-size: .78rem; font-weight: 700; margin-bottom: 16px; letter-spacing: .04em; }
  .hero h1 { font-size: clamp(1.6rem, 5vw, 2.4rem); font-weight: 800; margin-bottom: 12px; line-height: 1.2; color: #fff; }
  .hero-sub { font-size: 1.1rem; opacity: .9; margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto; }
  .hero-features { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 28px; }
  .hero-features span { background: rgba(255,255,255,.15); border-radius: 8px; padding: 6px 14px; font-size: .82rem; font-weight: 600; }
  .hero-cta { display: inline-block; background: #fff; color: #1e3a8a; font-weight: 800; font-size: 1.1rem; padding: 16px 40px; border-radius: 12px; text-decoration: none; transition: transform .15s; }
  .hero-cta:hover { transform: scale(1.04); }
  .hero-trust { font-size: .78rem; opacity: .7; margin-top: 14px; }

  /* FEATURES */
  .what-you-get { padding: 60px 20px; background: #f8fafc; }
  .what-you-get h2 { text-align: center; font-size: 1.6rem; font-weight: 800; margin-bottom: 36px; color: #1e293b; }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .feature-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 24px; text-align: center; }
  .feature-icon { font-size: 2rem; margin-bottom: 10px; }
  .feature-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 6px; color: #1e293b; }
  .feature-card p { font-size: .88rem; color: #64748b; line-height: 1.5; }

  /* FORM */
  .form-section { padding: 60px 20px; background: #fff; }
  .form-card { max-width: 520px; margin: 0 auto; }
  .form-card h2 { font-size: 1.5rem; font-weight: 800; margin-bottom: 6px; color: #1e293b; }
  .form-sub { color: #64748b; font-size: .92rem; margin-bottom: 28px; }
  .form-step { display: none; animation: fadeUp .3s ease; }
  .form-step.active { display: block; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  .form-step label { display: block; font-weight: 700; font-size: 1.05rem; margin-bottom: 10px; color: #1e293b; }
  .form-step input[type=text],
  .form-step input[type=email],
  .form-step input[type=number],
  .form-step select {
    width: 100%; padding: 14px 16px; border: 2px solid #e2e8f0; border-radius: 10px;
    font-size: 1rem; outline: none; transition: border-color .2s; background: #f8fafc;
  }
  .form-step input:focus, .form-step select:focus { border-color: #2563eb; background: #fff; }
  .input-row { display: flex; gap: 12px; }
  .input-group { flex: 1; position: relative; }
  .input-suffix { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-weight: 600; font-size: .9rem; pointer-events: none; }
  .imc-preview { margin-top: 10px; padding: 10px 14px; border-radius: 8px; font-size: .92rem; font-weight: 600; }

  .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .checkbox-label, .checkbox-single { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border: 2px solid #e2e8f0; border-radius: 10px; cursor: pointer; transition: border-color .2s, background .2s; font-size: .92rem; }
  .checkbox-label:has(input:checked), .checkbox-single:has(input:checked) { border-color: #2563eb; background: #eff6ff; }
  .checkbox-label input, .checkbox-single input { width: 18px; height: 18px; accent-color: #2563eb; }
  .checkbox-single { margin-top: 12px; }

  .btn-next, .btn-pay {
    width: 100%; margin-top: 18px; padding: 14px; border: none; border-radius: 10px;
    font-size: 1rem; font-weight: 700; cursor: pointer; transition: transform .15s, background .2s;
  }
  .btn-next { background: #1e40af; color: #fff; }
  .btn-next:hover { background: #1d4ed8; transform: scale(1.02); }
  .btn-pay { background: linear-gradient(135deg, #1e40af, #3b82f6); color: #fff; font-size: 1.1rem; padding: 16px; }
  .btn-pay:hover { transform: scale(1.02); }
  .btn-pay:disabled { opacity: .6; cursor: default; transform: none; }
  .pay-note { text-align: center; font-size: .8rem; color: #94a3b8; margin-top: 10px; }

  .recap { background: #f0f4ff; border: 1px solid #dbeafe; border-radius: 10px; padding: 14px; margin: 16px 0 4px; font-size: .9rem; line-height: 1.6; color: #1e293b; }

  /* FAQ */
  .faq-section { padding: 60px 20px; background: #f8fafc; }
  .faq-section h2 { text-align: center; font-size: 1.5rem; font-weight: 800; margin-bottom: 28px; color: #1e293b; }
  .faq-list { max-width: 600px; margin: 0 auto; }
  .faq-item { border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 10px; background: #fff; overflow: hidden; }
  .faq-item summary { padding: 16px 18px; font-weight: 700; cursor: pointer; font-size: .95rem; color: #1e293b; list-style: none; }
  .faq-item summary::before { content: '+ '; color: #2563eb; font-weight: 800; }
  .faq-item[open] summary::before { content: '- '; }
  .faq-item p { padding: 0 18px 16px; font-size: .9rem; color: #64748b; line-height: 1.6; }

  @media (max-width: 480px) {
    .input-row { flex-direction: column; }
    .checkbox-grid { grid-template-columns: 1fr; }
    .hero-features { flex-direction: column; align-items: center; }
  }
</style>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
(function() {
  var form = document.getElementById('dossier-form');
  var steps = form.querySelectorAll('.form-step');
  var poidsEl = document.getElementById('poids');
  var tailleEl = document.getElementById('taille');
  var imcPreview = document.getElementById('imc-preview');

  // Step navigation
  form.querySelectorAll('.btn-next').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var nextStep = parseInt(this.getAttribute('data-next'));
      var currentStep = this.closest('.form-step');

      // Validate current step inputs
      var inputs = currentStep.querySelectorAll('input[required], select[required]');
      var valid = true;
      inputs.forEach(function(inp) { if (!inp.value.trim()) { inp.style.borderColor = '#ef4444'; valid = false; } else { inp.style.borderColor = ''; } });
      if (!valid) return;

      // Show recap on last step
      if (nextStep === 6) buildRecap();

      steps.forEach(function(s) { s.classList.remove('active'); });
      form.querySelector('[data-step="' + nextStep + '"]').classList.add('active');
    });
  });

  // IMC live preview
  function updateImc() {
    var p = parseFloat(poidsEl.value);
    var t = parseFloat(tailleEl.value);
    if (p > 0 && t > 0) {
      var imc = (p / ((t / 100) * (t / 100))).toFixed(1);
      var color = imc >= 35 ? '#16a34a' : imc >= 30 ? '#f59e0b' : '#64748b';
      var label = imc >= 40 ? 'Eligible (IMC >= 40)' : imc >= 35 ? 'Seuil atteint (IMC >= 35)' : imc >= 30 ? 'Sous le seuil de 35' : 'IMC < 30';
      imcPreview.style.display = 'block';
      imcPreview.style.background = imc >= 35 ? '#f0fdf4' : imc >= 30 ? '#fffbeb' : '#f8fafc';
      imcPreview.style.color = color;
      imcPreview.innerHTML = 'IMC : <strong>' + imc + '</strong> — ' + label;
    } else {
      imcPreview.style.display = 'none';
    }
  }
  poidsEl.addEventListener('input', updateImc);
  tailleEl.addEventListener('input', updateImc);

  function buildRecap() {
    var prenom = document.getElementById('prenom').value;
    var poids = poidsEl.value;
    var taille = tailleEl.value;
    var imc = (parseFloat(poids) / ((parseFloat(taille) / 100) * (parseFloat(taille) / 100))).toFixed(1);
    var ville = document.getElementById('ville').value || 'Non precisee';
    var comorbs = [];
    form.querySelectorAll('input[name=comorbidites]:checked').forEach(function(c) { comorbs.push(c.value); });
    document.getElementById('recap').innerHTML =
      '<strong>' + prenom + '</strong> — ' + poids + 'kg / ' + taille + 'cm (IMC ' + imc + ')<br>' +
      'Ville : ' + ville + '<br>' +
      'Comorbidites : ' + (comorbs.length ? comorbs.join(', ') : 'Aucune') + '<br>' +
      'Traitement : ' + (document.getElementById('traitement').value || 'Non precise');
  }

  // Submit → Stripe
  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    var btn = document.getElementById('btn-pay');
    btn.disabled = true;
    btn.textContent = 'Redirection vers le paiement...';

    var email = document.getElementById('email').value;
    if (!email || !email.includes('@')) { btn.disabled = false; btn.textContent = 'Obtenir mon dossier — 4,99€'; return; }

    var comorbs = [];
    form.querySelectorAll('input[name=comorbidites]:checked').forEach(function(c) { comorbs.push(c.value); });

    try {
      var res = await fetch(supabaseUrl + '/functions/v1/stripe-payment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': supabaseAnonKey },
        body: JSON.stringify({
          product: 'dossier',
          email: email,
          dossier_data: {
            prenom: document.getElementById('prenom').value,
            poids_kg: parseFloat(poidsEl.value),
            taille_cm: parseFloat(tailleEl.value),
            comorbidites: comorbs,
            ville: document.getElementById('ville').value || null,
            suivi_nutritionnel: document.getElementById('suivi').checked,
            traitement_souhaite: document.getElementById('traitement').value || null
          }
        })
      });
      var result = await res.json();
      if (result.url) {
        window.location.href = result.url;
      } else {
        btn.textContent = 'Erreur — reessayer';
        btn.disabled = false;
      }
    } catch (err) {
      btn.textContent = 'Erreur — reessayer';
      btn.disabled = false;
    }
  });
})();
</script>

</StaticLayout>
