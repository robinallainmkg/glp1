---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SEO Opportunites - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
      font-size: 14px;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: white;
      border-bottom: 1px solid #e2e8f0;
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .header-badge {
      display: inline-block;
      padding: 0.3rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      background: #dcfce7;
      color: #166534;
    }

    .main { padding: 2rem; max-width: 1200px; }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      padding: 1.25rem;
      text-align: center;
    }
    .stat-value { font-size: 2rem; font-weight: 800; color: #0f172a; }
    .stat-label { font-size: 0.78rem; color: #64748b; margin-top: 0.25rem; }
    .stat-value.high { color: #dc2626; }
    .stat-value.med { color: #f59e0b; }
    .stat-value.ok { color: #22c55e; }

    .tabs {
      display: flex;
      gap: 0;
      border-bottom: 2px solid #e2e8f0;
      margin-bottom: 1.5rem;
    }
    .tab {
      padding: 0.75rem 1.25rem;
      font-size: 0.88rem;
      font-weight: 600;
      color: #64748b;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      background: none;
      border-top: none;
      border-left: none;
      border-right: none;
    }
    .tab:hover { color: #334155; }
    .tab.active { color: #1e40af; border-bottom-color: #3b82f6; }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .card {
      background: white;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      padding: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .card-title { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 0.75rem; }

    .opp-item {
      padding: 1rem;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      margin-bottom: 0.75rem;
      transition: border-color 0.15s;
    }
    .opp-item:hover { border-color: #3b82f6; }
    .opp-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
    }
    .opp-title { font-weight: 700; font-size: 0.95rem; }
    .opp-meta {
      font-size: 0.82rem;
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 0.75rem;
    }
    .opp-actions {
      display: flex;
      gap: 0.5rem;
    }

    .badge {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .badge-high { background: #fee2e2; color: #991b1b; }
    .badge-medium { background: #fef3c7; color: #92400e; }
    .badge-low { background: #dbeafe; color: #1e40af; }
    .badge-new { background: #f3e8ff; color: #7c3aed; }
    .badge-enrich { background: #dcfce7; color: #166534; }
    .badge-trending { background: #fee2e2; color: #dc2626; }
    .badge-update { background: #fef3c7; color: #92400e; }

    .status-badge {
      display: inline-block;
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 600;
    }
    .status-pending { background: #fef3c7; color: #92400e; }
    .status-approved { background: #dbeafe; color: #1e40af; }
    .status-content_created { background: #dcfce7; color: #166534; }
    .status-published { background: #d1fae5; color: #065f46; }
    .status-rejected { background: #fee2e2; color: #991b1b; }

    .btn {
      padding: 0.35rem 0.75rem;
      border: none;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-approve { background: #3b82f6; color: white; }
    .btn-approve:hover { background: #2563eb; }
    .btn-reject { background: #f1f5f9; color: #64748b; }
    .btn-reject:hover { background: #e2e8f0; }

    .kw-tag {
      display: inline-block;
      padding: 0.1rem 0.4rem;
      background: #f1f5f9;
      border-radius: 4px;
      font-size: 0.72rem;
      color: #475569;
      margin: 0.1rem;
    }

    .loading { text-align: center; padding: 2rem; color: #64748b; }
    .empty { text-align: center; padding: 2rem; color: #94a3b8; font-size: 0.88rem; }

    .log-item {
      padding: 0.6rem 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.85rem;
      display: flex;
      justify-content: space-between;
    }
    .log-item:last-child { border-bottom: none; }

    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
    }
    @media (max-width: 768px) {
      .main { padding: 1rem; }
      .page-header { padding: 1rem; flex-direction: column; align-items: flex-start; gap: 0.5rem; }
      .stats-row { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>
<script>
  if (!sessionStorage.getItem('admin_auth')) {
    window.location.href = '/admin/login/';
  }
</script>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div>
      <h1>SEO Opportunites</h1>
      <p>Agent automatique — Detection d'opportunites et suivi du contenu</p>
    </div>
    <span class="header-badge">Agent actif</span>
  </div>

  <div class="main">
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-value high" id="statPending">-</div>
        <div class="stat-label">En attente de revue</div>
      </div>
      <div class="stat-card">
        <div class="stat-value ok" id="statApproved">-</div>
        <div class="stat-label">Approuvees</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="statCreated">-</div>
        <div class="stat-label">Articles crees</div>
      </div>
      <div class="stat-card">
        <div class="stat-value med" id="statHigh">-</div>
        <div class="stat-label">Potentiel eleve</div>
      </div>
    </div>

    <div class="tabs">
      <button class="tab active" data-tab="pending">A examiner</button>
      <button class="tab" data-tab="approved">Approuvees</button>
      <button class="tab" data-tab="done">Historique</button>
      <button class="tab" data-tab="logs">Logs agent</button>
    </div>

    <div class="tab-panel active" id="tab-pending">
      <div id="pendingList"><div class="loading">Chargement...</div></div>
    </div>

    <div class="tab-panel" id="tab-approved">
      <div id="approvedList"><div class="loading">Chargement...</div></div>
    </div>

    <div class="tab-panel" id="tab-done">
      <div id="doneList"><div class="loading">Chargement...</div></div>
    </div>

    <div class="tab-panel" id="tab-logs">
      <div class="card">
        <div class="card-title">Logs des agents SEO</div>
        <div id="logsList"><div class="loading">Chargement...</div></div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  async function sbFetch(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function sbUpdate(table, id, data) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?id=eq.${id}`, {
      method: 'PATCH',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify(data)
    });
    if (!r.ok) throw new Error(await r.text());
  }

  function fmtDate(d) {
    if (!d) return '';
    return new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });
  }

  function potentialBadge(p) {
    const cls = p === 'high' ? 'badge-high' : p === 'low' ? 'badge-low' : 'badge-medium';
    const label = p === 'high' ? 'Eleve' : p === 'low' ? 'Faible' : 'Moyen';
    return `<span class="badge ${cls}">${label}</span>`;
  }

  function typeBadge(t) {
    const map = {
      new_article: { cls: 'badge-new', label: 'Nouveau' },
      enrich_existing: { cls: 'badge-enrich', label: 'Enrichir' },
      trending: { cls: 'badge-trending', label: 'Tendance' },
      update_needed: { cls: 'badge-update', label: 'Maj' }
    };
    const m = map[t] || { cls: 'badge-medium', label: t };
    return `<span class="badge ${m.cls}">${m.label}</span>`;
  }

  function renderOpp(opp, showActions) {
    const kws = (opp.keywords_secondary || []).map(k => `<span class="kw-tag">${k}</span>`).join('');
    const actions = showActions ? `
      <div class="opp-actions">
        <button class="btn btn-approve" onclick="approveOpp('${opp.id}')">Approuver</button>
        <button class="btn btn-reject" onclick="rejectOpp('${opp.id}')">Rejeter</button>
      </div>
    ` : '';

    return `
      <div class="opp-item">
        <div class="opp-header">
          <span class="opp-title">${opp.suggested_title || opp.keyword_main}</span>
          <div style="display:flex;gap:0.35rem;align-items:center;">
            ${typeBadge(opp.type)}
            ${potentialBadge(opp.potential)}
            <span class="status-badge status-${opp.status}">${opp.status}</span>
          </div>
        </div>
        <div class="opp-meta">
          <strong>Mot-cle :</strong> ${opp.keyword_main} ${kws}<br>
          <strong>Collection :</strong> ${opp.collection || 'N/A'} |
          <strong>Recherches :</strong> ${opp.estimated_searches || 'N/A'}<br>
          ${opp.rationale ? `<strong>Raison :</strong> ${opp.rationale}<br>` : ''}
          ${opp.content_brief ? `<strong>Brief :</strong> ${opp.content_brief}<br>` : ''}
          ${opp.article_slug ? `<strong>Article :</strong> <code>${opp.article_slug}</code><br>` : ''}
          <em>${fmtDate(opp.created_at)}</em>
        </div>
        ${actions}
      </div>
    `;
  }

  async function loadData() {
    try {
      const opps = await sbFetch('seo_opportunities', 'select=*&order=priority.asc,created_at.desc&limit=200');

      const pending = opps.filter(o => o.status === 'pending_review');
      const approved = opps.filter(o => o.status === 'approved' || o.status === 'in_progress');
      const done = opps.filter(o => ['content_created', 'published', 'rejected'].includes(o.status));
      const highPot = opps.filter(o => o.potential === 'high' && o.status !== 'rejected');

      document.getElementById('statPending').textContent = pending.length;
      document.getElementById('statApproved').textContent = approved.length;
      document.getElementById('statCreated').textContent = done.filter(o => o.status === 'content_created' || o.status === 'published').length;
      document.getElementById('statHigh').textContent = highPot.length;

      document.getElementById('pendingList').innerHTML = pending.length
        ? pending.map(o => renderOpp(o, true)).join('')
        : '<div class="empty">Aucune opportunite en attente. L\'agent SEO tourne chaque mercredi.</div>';

      document.getElementById('approvedList').innerHTML = approved.length
        ? approved.map(o => renderOpp(o, false)).join('')
        : '<div class="empty">Aucune opportunite approuvee. Approuvez des opportunites dans l\'onglet precedent.</div>';

      document.getElementById('doneList').innerHTML = done.length
        ? done.map(o => renderOpp(o, false)).join('')
        : '<div class="empty">Aucun historique.</div>';

      // Logs
      const logs = await sbFetch('agent_logs', 'select=*&or=(agent_type.eq.seo-opportunity,agent_type.eq.content-creator)&order=created_at.desc&limit=20');
      document.getElementById('logsList').innerHTML = logs.length
        ? logs.map(l => `
          <div class="log-item">
            <span><strong>${l.agent_type}</strong> — ${l.status} ${l.error ? '(' + l.error.substring(0, 80) + ')' : ''}</span>
            <span style="color:#94a3b8;">${fmtDate(l.created_at)} ${l.tokens_used ? '| ' + l.tokens_used + ' tokens' : ''} ${l.duration_ms ? '| ' + Math.round(l.duration_ms / 1000) + 's' : ''}</span>
          </div>
        `).join('')
        : '<div class="empty">Aucun log d\'agent SEO.</div>';

    } catch (err) {
      console.error('Load error:', err);
      document.getElementById('pendingList').innerHTML = `<div style="color:#991b1b;padding:1rem;">Erreur: ${err.message}. La table seo_opportunities existe-t-elle ? Lancez la migration.</div>`;
    }
  }

  window.approveOpp = async function(id) {
    try {
      await sbUpdate('seo_opportunities', id, { status: 'approved' });
      loadData();
    } catch (e) { alert('Erreur: ' + e.message); }
  };

  window.rejectOpp = async function(id) {
    try {
      await sbUpdate('seo_opportunities', id, { status: 'rejected' });
      loadData();
    } catch (e) { alert('Erreur: ' + e.message); }
  };

  // Tabs
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
    });
  });

  loadData();
</script>

</body>
</html>
