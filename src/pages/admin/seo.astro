---
// src/pages/admin/seo.astro
// Agent SEO — Empty state (Phase 2)
import AdminNav from '../../components/AdminNav.astro';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SEO - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: white;
      border-bottom: 1px solid #e2e8f0;
      padding: 1.5rem 2rem;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }

    .main { padding: 2rem; }

    .coming-soon {
      max-width: 560px;
      margin: 4rem auto;
      text-align: center;
    }
    .coming-icon {
      width: 80px;
      height: 80px;
      border-radius: 20px;
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
    }
    .coming-icon svg { color: #d97706; }
    .coming-title {
      font-size: 1.35rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: #0f172a;
    }
    .coming-desc {
      font-size: 0.95rem;
      color: #64748b;
      line-height: 1.6;
      margin-bottom: 2rem;
    }
    .feature-list {
      text-align: left;
      background: white;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      padding: 1.25rem;
    }
    .feature-list h3 {
      font-size: 0.88rem;
      font-weight: 700;
      color: #475569;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .feature-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.88rem;
      color: #475569;
    }
    .feature-item:last-child { border-bottom: none; }
    .feature-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #e2e8f0;
      flex-shrink: 0;
    }
    .phase-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
      background: #fef3c7;
      color: #92400e;
      margin-bottom: 1.5rem;
    }

    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
    }
    @media (max-width: 768px) {
      .main { padding: 1rem; }
      .page-header { padding: 1rem; }
      .coming-soon { margin: 2rem auto; }
    }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <h1>SEO</h1>
    <p>Agent Opportunite SEO</p>
  </div>

  <div class="main">
    <div class="coming-soon">
      <div class="coming-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
          <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
      </div>
      <div class="phase-badge">Phase 2</div>
      <h2 class="coming-title">Agent Opportunite SEO</h2>
      <p class="coming-desc">
        L'agent SEO analysera automatiquement les opportunites de positionnement
        pour les articles GLP-1, identifiera les mots-cles manques et proposera
        des optimisations de contenu.
      </p>

      <div class="feature-list">
        <h3>Fonctionnalites prevues</h3>
        <div class="feature-item">
          <div class="feature-dot"></div>
          <span>Analyse automatique des positions Google</span>
        </div>
        <div class="feature-item">
          <div class="feature-dot"></div>
          <span>Detection des opportunites de mots-cles</span>
        </div>
        <div class="feature-item">
          <div class="feature-dot"></div>
          <span>Suggestions d'optimisation de contenu</span>
        </div>
        <div class="feature-item">
          <div class="feature-dot"></div>
          <span>Suivi des performances par article</span>
        </div>
        <div class="feature-item">
          <div class="feature-dot"></div>
          <span>Integration avec Google Search Console</span>
        </div>
      </div>
    </div>
  </div>
</div>

</body>
</html>
