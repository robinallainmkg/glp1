  async function loadConversions() {
    try {
      const [contacts, conversations, stripeEvents] = await Promise.all([
        sbFetch('contacts', 'select=id,email,nom,newsletter,telephone,subject,message,created_at&order=created_at.desc&limit=500'),
        sbFetch('coach_conversations', 'select=id,session_id,started_at,message_count,user_id&order=started_at.desc&limit=500'),
        sbFetch('subscription_events', 'select=id,user_id,stripe_event_id,event_type,metadata,created_at&order=created_at.desc&limit=500'),
      ]);

      const today = new Date().toISOString().slice(0, 10);

      // Categorize contacts by subject (reliable field)
      convData.newsletter = [];
      convData.diagnostic = [];
      convData.contact = [];

      for (const c of contacts) {
        const date = (c.created_at || '').slice(0, 10);
        const subj = (c.subject || '').toLowerCase();

        if (subj.includes('diagnostic') || subj.includes('quiz')) {
          convData.diagnostic.push({ ...c, date });
        } else if (subj.includes('newsletter') || (c.newsletter === true && !subj.includes('diagnostic'))) {
          convData.newsletter.push({ ...c, date });
        } else {
          convData.contact.push({ ...c, date });
        }
      }

      // Chat conversations
      convData.chat = conversations.map(c => ({ ...c, date: (c.started_at || '').slice(0, 10) }));

      // Stripe events
      convData.checkouts = stripeEvents.filter(e => e.event_type === 'checkout.session.completed').map(e => ({ ...e, date: (e.created_at || '').slice(0, 10) }));
      convData.invoices = stripeEvents.filter(e => e.event_type === 'invoice.paid').map(e => ({ ...e, date: (e.created_at || '').slice(0, 10) }));
      convData.trials = convData.checkouts.filter(e => e.metadata && e.metadata.status === 'trialing');

      // Lead stats
      document.getElementById('convNewsletter').textContent = convData.newsletter.length;
      document.getElementById('convDiag').textContent = convData.diagnostic.length;
      document.getElementById('convChat').textContent = convData.chat.length;
      document.getElementById('convContact').textContent = convData.contact.length;

      document.getElementById('convNewsletterToday').textContent = `Aujourd'hui: ${convData.newsletter.filter(c => c.date === today).length}`;
      document.getElementById('convDiagToday').textContent = `Aujourd'hui: ${convData.diagnostic.filter(c => c.date === today).length}`;
      document.getElementById('convChatToday').textContent = `Aujourd'hui: ${convData.chat.filter(c => c.date === today).length}`;
      document.getElementById('convContactToday').textContent = `Aujourd'hui: ${convData.contact.filter(c => c.date === today).length}`;

      // Revenue stats
      document.getElementById('revCheckouts').textContent = convData.checkouts.length;
      document.getElementById('revCheckoutsToday').textContent = `Aujourd'hui: ${convData.checkouts.filter(c => c.date === today).length}`;
      document.getElementById('revTrials').textContent = convData.trials.length;
      document.getElementById('revPaid').textContent = convData.invoices.length;

      // Total for overview (leads 30d)
      const total30d = new Date(Date.now() - 30*86400000).toISOString().slice(0,10);
      const conv30 = [...convData.newsletter, ...convData.diagnostic, ...convData.chat, ...convData.contact].filter(c => c.date >= total30d).length;
      const statsConv = document.querySelector('#statsGrid .stat-card:last-child .value');
      if (statsConv) statsConv.textContent = conv30;

      renderConvChart();
      renderConvFunnel();
      renderConvTable();
    } catch(e) {
      console.error('Conversions load error:', e);
    }
  }

  function renderConvChart() {
    const cutoff = convPeriodDays > 0 ? new Date(Date.now() - convPeriodDays * 86400000).toISOString().slice(0,10) : '2000-01-01';

    function groupByDay(items) {
      const byDay = {};
      for (const item of items) {
        if (item.date < cutoff) continue;
        byDay[item.date] = (byDay[item.date] || 0) + 1;
      }
      return Object.entries(byDay).map(([date, value]) => ({ date, value }));
    }

    buildLineChart('convChart', [
      { points: groupByDay(convData.newsletter), color: '#3b82f6', type: 'bar', hidden: hiddenConvLines.has('newsletter') },
      { points: groupByDay(convData.diagnostic), color: '#22c55e', type: 'bar', hidden: hiddenConvLines.has('diagnostic') },
      { points: groupByDay(convData.chat), color: '#f59e0b', type: 'bar', hidden: hiddenConvLines.has('chat') },
      { points: groupByDay(convData.contact), color: '#ec4899', type: 'bar', hidden: hiddenConvLines.has('contact') },
    ]);
  }

  function renderConvFunnel() {
    const steps = [
      { label: 'Tous leads', value: convData.newsletter.length + convData.diagnostic.length + convData.chat.length + convData.contact.length, color: '#64748b' },
      { label: 'Diagnostic', value: convData.diagnostic.length, color: '#22c55e' },
      { label: 'Chat AI', value: convData.chat.length, color: '#f59e0b' },
      { label: 'Abonnement', value: (convData.checkouts || []).length, color: '#8b5cf6' },
    ];

    const container = document.getElementById('convFunnelChart');
    const maxVal = Math.max(...steps.map(s => s.value), 1);
    const W = 400, H = 240;
    const barH = 38, gap = 16;
    const startY = (H - (steps.length * (barH + gap) - gap)) / 2;
    const maxBarW = W - 140;

    let svg = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">`;

    steps.forEach((step, i) => {
      const y = startY + i * (barH + gap);
      const barW = Math.max(20, (step.value / maxVal) * maxBarW);
      const x = (maxBarW - barW) / 2 + 10;

      // Bar
      svg += `<rect x="${x}" y="${y}" width="${barW}" height="${barH}" rx="6" fill="${step.color}" opacity="0.75"/>`;

      // Value inside bar
      svg += `<text x="${x + barW/2}" y="${y + barH/2 + 1}" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="13" font-weight="800">${step.value}</text>`;

      // Label right
      svg += `<text x="${maxBarW + 20}" y="${y + barH/2 - 4}" fill="#e2e8f0" font-size="11" font-weight="600" dominant-baseline="middle">${step.label}</text>`;

      // Conversion rate
      if (i > 0 && steps[i-1].value > 0) {
        const rate = ((step.value / steps[i-1].value) * 100).toFixed(0);
        svg += `<text x="${maxBarW + 20}" y="${y + barH/2 + 12}" fill="#64748b" font-size="9" dominant-baseline="middle">${rate}% du precedent</text>`;
      }

      // Arrow between steps
      if (i < steps.length - 1) {
        const arrowY = y + barH + gap/2;
        svg += `<text x="${maxBarW/2 + 10}" y="${arrowY + 2}" text-anchor="middle" fill="#334155" font-size="12" dominant-baseline="middle">▼</text>`;
      }
    });

    svg += '</svg>';
    container.innerHTML = svg;
  }

