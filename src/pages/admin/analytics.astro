  // ==================== POSITION EVOLUTION CHART ====================
  const CHART_COLORS = ['#ef4444','#3b82f6','#22c55e','#f59e0b','#8b5cf6','#ec4899','#06b6d4','#84cc16','#f97316','#6366f1'];

  window.toggleKeyword = function(kw) {
    if (hiddenKeywords.has(kw)) hiddenKeywords.delete(kw);
    else hiddenKeywords.add(kw);
    renderPositionChart(window._rawRankings || []);
  };

  function renderPositionChart(rawRankings) {
    const kwHistory = {};
    for (const r of rawRankings) {
      if (!r.position || !r.keyword) continue;
      if (!kwHistory[r.keyword]) kwHistory[r.keyword] = [];
      kwHistory[r.keyword].push({ date: r.checked_at, position: r.position });
    }

    const primaryKws = new Set(rawRankings.filter(r => r.keyword_type === 'primary').map(r => r.keyword));
    const sortedKws = Object.entries(kwHistory)
      .sort((a, b) => {
        const aP = primaryKws.has(a[0]) ? 0 : 1;
        const bP = primaryKws.has(b[0]) ? 0 : 1;
        if (aP !== bP) return aP - bP;
        return b[1].length - a[1].length;
      })
      .slice(0, 10);

    if (sortedKws.length === 0) return;

    sortedKws.forEach(([kw, hist]) => hist.sort((a, b) => new Date(a.date) - new Date(b.date)));

    const datasets = sortedKws.map(([kw, hist], idx) => ({
      points: hist.map(h => ({ date: h.date, value: h.position })),
      color: CHART_COLORS[idx % CHART_COLORS.length],
      hidden: hiddenKeywords.has(kw),
      fill: false
    }));

    buildLineChart('chartCanvas', datasets, { invertY: true });

    // Legend
    document.getElementById('chartLegend').innerHTML = sortedKws.map(([kw], idx) => {
      const color = CHART_COLORS[idx % CHART_COLORS.length];
      const isHidden = hiddenKeywords.has(kw);
      return `<div class="chart-legend-item${isHidden ? ' hidden' : ''}" onclick="toggleKeyword('${esc(kw)}')">
        <div class="chart-legend-dot" style="background:${color}"></div>
        ${esc(kw)}
      </div>`;
    }).join('');
  }

  // ==================== KEYWORDS TABLES ====================
  function renderKeywordTables() {
    const primaryKws = allRankings.filter(r => r.keyword_type === 'primary');
    const secondaryKws = allRankings.filter(r => r.keyword_type !== 'primary');
    const rawRankings = window._rawRankings || [];

    // Build history per keyword
    const kwHistory = {};
    for (const r of rawRankings) {
      if (!r.position || !r.keyword) continue;
      if (!kwHistory[r.keyword]) kwHistory[r.keyword] = [];
      kwHistory[r.keyword].push({ date: r.checked_at, position: r.position });
    }
    Object.values(kwHistory).forEach(h => h.sort((a,b) => new Date(a.date) - new Date(b.date)));

    document.getElementById('primaryCount').textContent = primaryKws.length;
    document.getElementById('secondaryCount').textContent = secondaryKws.length;

    renderKwBody('primaryBody', primaryKws, searchPrimary, kwHistory);
    renderKwBody('secondaryBody', secondaryKws, searchSecondary, kwHistory);
  }

  function renderKwBody(bodyId, kws, search, kwHistory) {
    const body = document.getElementById(bodyId);
    let filtered = kws;
    if (search) {
      filtered = filtered.filter(r =>
        (r.keyword || '').toLowerCase().includes(search) ||
        (articleMap[r.article_id] || '').toLowerCase().includes(search)
      );
    }

    if (filtered.length === 0) {
      body.innerHTML = `<tr><td colspan="6" class="empty-state">${kws.length > 0 ? 'Aucun resultat' : 'Aucune donnee'}</td></tr>`;
      return;
    }

    body.innerHTML = filtered.map(r => {
      const history = kwHistory[r.keyword] || [];
      const trendColor = r.previous_position && r.position && r.position < r.previous_position ? '#4ade80' : (r.previous_position && r.position && r.position > r.previous_position ? '#f87171' : '#64748b');

      return `<tr>
        <td>${posBadge(r.position)}</td>
        <td><span class="kw-name">${esc(r.keyword)}</span></td>
        <td><span class="kw-slug">${esc(articleMap[r.article_id] || '-')}</span></td>
        <td>${trendHtml(r.position, r.previous_position)}</td>
        <td>${sparklineSvg(history.slice(-10), trendColor)}</td>
        <td style="font-size:0.75rem;color:#64748b">${timeAgo(r.checked_at)}</td>
      </tr>`;
    }).join('');
  }

  // ==================== OVERVIEW STATS & CHARTS ====================
  function renderStats(rankings) {
    const total = rankings.length;
    const positioned = rankings.filter(r => r.position !== null && r.position !== undefined);
    const top10 = positioned.filter(r => r.position <= 10).length;
    const improving = rankings.filter(r => r.previous_position !== null && r.previous_position !== undefined && r.position !== null && r.position < r.previous_position).length;
    const avgPos = positioned.length > 0 ? (positioned.reduce((s,r) => s + r.position, 0) / positioned.length).toFixed(1) : '-';

    const cards = document.querySelectorAll('#statsGrid .stat-card');
    if (cards[0]) { cards[0].querySelector('.value').textContent = total; cards[0].querySelector('.sub').textContent = `${positioned.length} positionnes / ${rankings.filter(r => r.keyword_type === 'primary').length} prioritaires`; }
    if (cards[1]) { cards[1].querySelector('.value').textContent = avgPos; cards[1].querySelector('.sub').textContent = positioned.length > 0 ? `Sur ${positioned.length} mots-cles visibles` : 'Lancez l\'agent analytics'; }
    if (cards[2]) { cards[2].querySelector('.value').textContent = top10; cards[2].querySelector('.sub').textContent = `dont ${positioned.filter(r => r.position <= 3).length} en top 3`; }
    if (cards[3]) { cards[3].querySelector('.value').textContent = improving; }
  }

  function renderDistribution(rankings) {
    const total = rankings.length;
    if (total === 0) return;
    const top3 = rankings.filter(r => r.position && r.position <= 3).length;
    const top10 = rankings.filter(r => r.position && r.position > 3 && r.position <= 10).length;
    const top20 = rankings.filter(r => r.position && r.position > 10).length;
    const none = rankings.filter(r => !r.position).length;
    const pct = v => Math.max(0, (v / total * 100)).toFixed(1);

    document.getElementById('distribContainer').style.display = 'block';
    document.getElementById('distribBar').innerHTML = [
      top3 > 0 ? `<div class="distrib-segment seg-top3" style="width:${pct(top3)}%">${top3}</div>` : '',
      top10 > 0 ? `<div class="distrib-segment seg-top10" style="width:${pct(top10)}%">${top10}</div>` : '',
      top20 > 0 ? `<div class="distrib-segment seg-top20" style="width:${pct(top20)}%">${top20}</div>` : '',
      none > 0 ? `<div class="distrib-segment seg-none" style="width:${pct(none)}%">${none}</div>` : '',
    ].join('');
  }

  function renderMovements(rawRankings) {
    const latest = {};
    for (const r of rawRankings) {
      const key = `${r.keyword}__${r.article_id}`;
      if (!latest[key]) latest[key] = r;
    }

    const all = Object.values(latest);
    const improvements = all.filter(r => r.previous_position && r.position && r.position < r.previous_position)
      .map(r => ({ keyword: r.keyword, change: r.previous_position - r.position, pos: r.position }))
      .sort((a, b) => b.change - a.change).slice(0, 5);

    const declines = all.filter(r => r.previous_position && r.position && r.position > r.previous_position)
      .map(r => ({ keyword: r.keyword, change: r.position - r.previous_position, pos: r.position }))
      .sort((a, b) => b.change - a.change).slice(0, 5);

    const newKws = all.filter(r => (r.previous_position === null || r.previous_position === undefined) && r.position)
      .map(r => ({ keyword: r.keyword, pos: r.position })).slice(0, 5);

    if (improvements.length === 0 && declines.length === 0 && newKws.length === 0) return;

    document.getElementById('movementsSection').style.display = 'block';
    document.getElementById('movementsGrid').innerHTML = `
      <div class="movement-col">
        <div class="movement-col-title" style="color:#16a34a">Progressions</div>
        ${improvements.length === 0 ? '<div style="color:#94a3b8;font-size:0.78rem">Aucune</div>' : improvements.map(m =>
          `<div class="movement-item"><span class="movement-kw">${esc(m.keyword)}</span><span class="movement-change mc-up">+${m.change} #${m.pos}</span></div>`
        ).join('')}
      </div>
      <div class="movement-col">
        <div class="movement-col-title" style="color:#dc2626">Reculs</div>
        ${declines.length === 0 ? '<div style="color:#94a3b8;font-size:0.78rem">Aucun</div>' : declines.map(m =>
          `<div class="movement-item"><span class="movement-kw">${esc(m.keyword)}</span><span class="movement-change mc-down">-${m.change} #${m.pos}</span></div>`
        ).join('')}
      </div>
      <div class="movement-col">
        <div class="movement-col-title" style="color:#7c3aed">Nouveaux</div>
        ${newKws.length === 0 ? '<div style="color:#94a3b8;font-size:0.78rem">Aucun</div>' : newKws.map(m =>
          `<div class="movement-item"><span class="movement-kw">${esc(m.keyword)}</span><span class="movement-change mc-new">#${m.pos}</span></div>`
        ).join('')}
      </div>
    `;
  }

  function renderDiagnostic(rankings) {
    const total = rankings.length;
    if (total === 0) {
      document.getElementById('diagBody').innerHTML = '<div class="empty-state">Lancez l\'agent analytics pour obtenir un diagnostic</div>';
      return;
    }

    const positioned = rankings.filter(r => r.position);
    const top3 = positioned.filter(r => r.position <= 3);
    const none = rankings.filter(r => !r.position);
    const improving = rankings.filter(r => r.previous_position && r.position && r.position < r.previous_position);
    const declining = rankings.filter(r => r.previous_position && r.position && r.position > r.previous_position);

    const tips = [];
    if (top3.length > 0) tips.push({ type: 'ok', text: `${top3.length} mot(s)-cle(s) en top 3. Consolidez avec du contenu enrichi et du maillage interne.` });
    if (improving.length > 0) tips.push({ type: 'ok', text: `${improving.length} mot(s)-cle(s) en progression. Le travail SEO porte ses fruits.` });
    if (declining.length > 0) tips.push({ type: 'warn', text: `${declining.length} mot(s)-cle(s) en recul. Verifiez le contenu et les backlinks de ces pages.` });
    if (none.length > total * 0.5) tips.push({ type: 'warn', text: `${Math.round(none.length / total * 100)}% des mots-cles non visibles. Priorisez le contenu.` });
    if (positioned.length > 0 && positioned.length < 10) tips.push({ type: 'tip', text: 'Ciblez les requetes longue traine pour augmenter le nombre de mots-cles positionnes.' });
    tips.push({ type: 'tip', text: 'Relancez l\'agent analytics regulierement pour suivre l\'evolution.' });

    document.getElementById('diagBody').innerHTML = tips.map(t => `
      <div class="diag-item">
        <div class="diag-icon diag-${t.type}">${t.type === 'ok' ? '&#x2713;' : t.type === 'warn' ? '!' : '&#x2192;'}</div>
        <span>${esc(t.text)}</span>
      </div>
    `).join('');
  }

  async function loadRuns() {
    try {
      const runs = await sbFetch('agent_runs', 'select=*&agent_name=eq.analytics&order=started_at.desc&limit=10');
      document.getElementById('runCount').textContent = runs.length;
      if (runs.length === 0) { document.getElementById('runsList').innerHTML = '<div class="empty-state">Aucun run enregistre</div>'; return; }

      document.getElementById('runsList').innerHTML = runs.map(r => {
        const meta = r.metadata || {};
        const dotClass = r.status === 'completed' ? 'run-dot-ok' : r.status === 'failed' ? 'run-dot-fail' : 'run-dot-run';
        const dateStr = new Date(r.started_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        return `<div class="run-item">
          <div class="run-dot ${dotClass}"></div>
          <div class="run-info"><div class="run-date">${esc(dateStr)}</div><div class="run-meta">${r.items_processed || 0} mots-cles${meta.articles_checked ? ` / ${meta.articles_checked} articles` : ''}</div></div>
          <div class="run-stats">
            ${meta.improvements ? `<span class="run-stat-badge" style="background:#dcfce7;color:#166534">+${meta.improvements}</span>` : ''}
            ${meta.declines ? `<span class="run-stat-badge" style="background:#fee2e2;color:#991b1b">-${meta.declines}</span>` : ''}
          </div>
        </div>`;
      }).join('');
    } catch (e) {
      document.getElementById('runsList').innerHTML = `<div class="empty-state" style="color:#ef4444">Erreur: ${esc(e.message)}</div>`;
    }
  }

  // ==================== MAIN LOAD ====================
  async function loadAll() {
    try {
      const [rawRankings, articles, gscRaw, gaRaw] = await Promise.all([
        sbFetch('keyword_rankings', 'select=*&order=checked_at.desc'),
        sbFetch('articles', 'select=id,slug&is_active=eq.true'),
        sbFetch('gsc_metrics', 'select=*&order=date.desc&limit=500'),
        sbFetch('ga_metrics', 'select=*&order=date.desc&limit=500'),
      ]);

      window._rawRankings = rawRankings;
      gscData = gscRaw;
      gaData = gaRaw;

      articleMap = {};
      articles.forEach(a => { articleMap[a.id] = a.slug; });

      // Deduplicate: keep latest per keyword+article
      const latest = {};
      for (const r of rawRankings) {
        const key = `${r.keyword}__${r.article_id}`;
        if (!latest[key]) latest[key] = r;
      }
      allRankings = Object.values(latest);
      allRankings.sort((a, b) => {
        if (a.position && b.position) return a.position - b.position;
        if (a.position) return -1;
        if (b.position) return 1;
        return 0;
      });

      // Render everything
      renderStats(allRankings);
      renderAvgRankingChart();
      renderTrafficChart();
      renderDistribution(allRankings);
      renderMovements(rawRankings);
      renderPositionChart(rawRankings);
      renderKeywordTables();
      renderDiagnostic(allRankings);
      renderTrafficStats();
      renderDetailTrafficChart();
      loadRuns();
      loadConversions();

      document.getElementById('lastUpdate').textContent = 'Maj: ' + new Date().toLocaleTimeString('fr-FR');
    } catch (e) {
      console.error('Load error:', e);
    }
  }

  loadAll();
  setInterval(loadAll, 60000);
</script>

</body>
</html>
