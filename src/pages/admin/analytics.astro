---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Analytics - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0e17; color: #c8d6e5; }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header { background: linear-gradient(180deg, #0f1520 0%, #0a0e17 100%); border-bottom: 1px solid #1a2332; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #e2e8f0; }
    .page-header-left p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn { padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #1e293b; background: #0f1520; color: #94a3b8; font-size: 0.82rem; cursor: pointer; display: flex; align-items: center; gap: 0.4rem; transition: all 0.15s; }
    .refresh-btn:hover { background: #1e293b; color: #e2e8f0; }
    .last-update { font-size: 0.72rem; color: #64748b; }
    .main { padding: 2rem; }

    /* Command box */
    .cmd-box { background: #1a1f2e; border: 1px solid #1e293b; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    .cmd-box code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.82rem; color: #a5f3fc; }
    .cmd-box .copy-btn { padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid #334155; background: transparent; color: #94a3b8; font-size: 0.72rem; cursor: pointer; }
    .cmd-box .copy-btn:hover { background: #334155; color: white; }

    /* Stats grid */
    .stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: #111827; border-radius: 12px; padding: 1.25rem; border: 1px solid #1e293b; position: relative; overflow: hidden; }
    .stat-card .label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.5rem; }
    .stat-card .value { font-size: 2rem; font-weight: 800; line-height: 1; }
    .stat-card .sub { font-size: 0.75rem; color: #475569; margin-top: 0.35rem; display: flex; align-items: center; gap: 0.3rem; }
    .stat-card .icon-bg { position: absolute; top: -6px; right: -6px; width: 52px; height: 52px; border-radius: 50%; opacity: 0.15; }

    /* Position distribution bar */
    .distrib-bar-container { background: #111827; border-radius: 12px; border: 1px solid #1e293b; padding: 1.25rem; margin-bottom: 1.5rem; }
    .distrib-title { font-size: 0.82rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.75rem; }
    .distrib-bar { display: flex; height: 32px; border-radius: 8px; overflow: hidden; background: #1e293b; }
    .distrib-segment { display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: white; min-width: 0; transition: width 0.5s ease; }
    .seg-top3 { background: #22c55e; }
    .seg-top10 { background: #3b82f6; }
    .seg-top20 { background: #f59e0b; }
    .seg-none { background: #475569; color: #94a3b8; }
    .distrib-legend { display: flex; gap: 1.5rem; margin-top: 0.75rem; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: #94a3b8; }
    .legend-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }

    /* Filters */
    .filters { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .filter-btn { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #1e293b; background: #111827; color: #94a3b8; font-size: 0.78rem; cursor: pointer; font-weight: 500; transition: all 0.15s; }
    .filter-btn:hover { border-color: #334155; color: #e2e8f0; }
    .filter-btn.active { background: #3b82f6; color: white; border-color: #3b82f6; }
    .filter-count { font-size: 0.68rem; background: rgba(255,255,255,0.1); padding: 1px 6px; border-radius: 10px; margin-left: 4px; }
    .filter-btn.active .filter-count { background: rgba(255,255,255,0.25); }
    .search-input { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #1e293b; background: #111827; color: #e2e8f0; font-size: 0.78rem; width: 220px; margin-left: auto; }
    .search-input::placeholder { color: #475569; }
    .search-input:focus { outline: none; border-color: #3b82f6; }

    /* Keywords table */
    .kw-table-wrap { background: #111827; border-radius: 12px; border: 1px solid #1e293b; overflow: hidden; margin-bottom: 1.5rem; }
    .kw-table { width: 100%; border-collapse: collapse; }
    .kw-table th { text-align: left; padding: 0.75rem 1rem; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; border-bottom: 1px solid #1e293b; background: #0f1520; }
    .kw-table td { padding: 0.75rem 1rem; font-size: 0.82rem; border-bottom: 1px solid #1a2332; vertical-align: middle; color: #c8d6e5; }
    .kw-table tr:last-child td { border-bottom: none; }
    .kw-table tr:hover td { background: #1a2332; }

    .kw-name { font-weight: 600; color: #e2e8f0; }
    .kw-slug { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.72rem; color: #a78bfa; display: block; margin-top: 2px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .kw-type { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.65rem; font-weight: 600; text-transform: uppercase; }
    .kt-primary { background: #1e3a5f; color: #93c5fd; }
    .kt-secondary { background: #1e293b; color: #94a3b8; }

    /* Position badge */
    .pos-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 30px; border-radius: 8px; font-weight: 800; font-size: 0.85rem; padding: 0 0.5rem; }
    .pos-top3 { background: #052e16; color: #4ade80; }
    .pos-top10 { background: #1e3a5f; color: #60a5fa; }
    .pos-top20 { background: #451a03; color: #fbbf24; }
    .pos-none { background: #1e293b; color: #64748b; font-size: 0.75rem; font-weight: 600; }

    /* Trend indicator */
    .trend { display: inline-flex; align-items: center; gap: 0.2rem; font-size: 0.75rem; font-weight: 600; margin-left: 0.4rem; }
    .trend-up { color: #4ade80; }
    .trend-down { color: #f87171; }
    .trend-stable { color: #64748b; }
    .trend-new { color: #a78bfa; font-size: 0.68rem; font-weight: 500; }

    /* Two cols for bottom section */
    .two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .section-card { background: #111827; border-radius: 12px; border: 1px solid #1e293b; overflow: hidden; }
    .section-header { padding: 1rem 1.25rem; border-bottom: 1px solid #1e293b; font-size: 0.82rem; font-weight: 700; color: #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
    .section-header .badge-count { font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 10px; background: #1e293b; color: #94a3b8; }

    /* Run history */
    .run-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.25rem; border-bottom: 1px solid #1a2332; font-size: 0.82rem; }
    .run-item:last-child { border-bottom: none; }
    .run-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .run-dot-ok { background: #22c55e; }
    .run-dot-fail { background: #ef4444; }
    .run-dot-run { background: #f59e0b; }
    .run-info { flex: 1; min-width: 0; }
    .run-date { font-weight: 500; color: #e2e8f0; }
    .run-meta { font-size: 0.72rem; color: #64748b; }
    .run-stats { display: flex; gap: 0.5rem; }
    .run-stat-badge { padding: 2px 8px; border-radius: 10px; font-size: 0.68rem; font-weight: 600; }

    /* Diagnostic */
    .diag-item { display: flex; gap: 0.75rem; padding: 0.75rem 1.25rem; border-bottom: 1px solid #1a2332; font-size: 0.82rem; color: #94a3b8; line-height: 1.5; }
    .diag-item:last-child { border-bottom: none; }
    .diag-icon { flex-shrink: 0; width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; }
    .diag-tip { background: #3b1764; color: #a78bfa; }
    .diag-warn { background: #451a03; color: #fbbf24; }
    .diag-ok { background: #052e16; color: #4ade80; }

    .empty-state { text-align: center; padding: 3rem; color: #64748b; font-size: 0.85rem; }

    /* Charts */
    .chart-section { background: #111827; border-radius: 12px; border: 1px solid #1e293b; padding: 1.25rem; margin-bottom: 1.5rem; }
    .chart-title { font-size: 0.82rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.75rem; display: flex; align-items: center; justify-content: space-between; }
    .chart-canvas { width: 100%; height: 280px; position: relative; }
    .chart-canvas svg { width: 100%; height: 100%; }
    .chart-legend { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }
    .chart-legend-item { display: flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; color: #94a3b8; cursor: pointer; padding: 0.15rem 0.4rem; border-radius: 4px; transition: opacity 0.2s; }
    .chart-legend-item:hover { background: #1e293b; }
    .chart-legend-item.hidden { opacity: 0.3; }
    .chart-legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

    /* Movements */
    .movements-section { background: #111827; border-radius: 12px; border: 1px solid #1e293b; margin-bottom: 1.5rem; overflow: hidden; }
    .movements-header { padding: 1rem 1.25rem; border-bottom: 1px solid #1e293b; font-size: 0.82rem; font-weight: 700; color: #e2e8f0; }
    .movements-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; }
    .movement-col { padding: 1rem 1.25rem; border-right: 1px solid #1a2332; }
    .movement-col:last-child { border-right: none; }
    .movement-col-title { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: #64748b; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.3rem; }
    .movement-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0; font-size: 0.78rem; }
    .movement-kw { font-weight: 600; color: #e2e8f0; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .movement-change { font-weight: 700; font-size: 0.75rem; padding: 1px 6px; border-radius: 6px; white-space: nowrap; }
    .mc-up { background: #052e16; color: #4ade80; }
    .mc-down { background: #450a0a; color: #fca5a5; }
    .mc-new { background: #3b1764; color: #a78bfa; }

    /* GA/GSC */
    .gsc-section { background: #111827; border-radius: 12px; border: 1px solid #1e293b; margin-bottom: 1.5rem; overflow: hidden; }
    .gsc-header { padding: 1rem 1.25rem; border-bottom: 1px solid #1e293b; font-size: 0.82rem; font-weight: 700; color: #e2e8f0; }
    .gsc-stats { display: flex; gap: 2rem; padding: 1rem 1.25rem; border-bottom: 1px solid #1a2332; flex-wrap: wrap; }
    .gsc-stat .gsc-val { font-size: 1.25rem; font-weight: 800; }
    .gsc-stat .gsc-lbl { font-size: 0.68rem; color: #64748b; }
    .gsc-table { width: 100%; border-collapse: collapse; }
    .gsc-table th { text-align: left; padding: 0.5rem 1rem; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: #64748b; background: #0f1520; border-bottom: 1px solid #1e293b; }
    .gsc-table td { padding: 0.5rem 1rem; font-size: 0.82rem; border-bottom: 1px solid #1a2332; color: #c8d6e5; }
    .gsc-table tr:hover td { background: #1a2332; }

    @media (max-width: 1024px) { .admin-layout { margin-left: 0; padding-top: 56px; } }
    @media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(3, 1fr); } .two-cols { grid-template-columns: 1fr; } }
    @media (max-width: 768px) { .main { padding: 1rem; } .page-header { padding: 1rem; flex-direction: column; gap: 0.5rem; align-items: flex-start; } .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>Analytics — Positionnement</h1>
      <p>Suivi des mots-cles et positions Google — Agent Analytics</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate"></span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <!-- Command box -->
    <div class="cmd-box">
      <code>claude -p "Analyse les keywords" --agent analytics</code>
      <button class="copy-btn" onclick="navigator.clipboard.writeText('claude -p &quot;Analyse les keywords&quot; --agent analytics');this.textContent='Copie !'">Copier</button>
    </div>

    <!-- Stats -->
    <div class="stats-grid" id="statsGrid">
      <div class="stat-card">
        <div class="label">Mots-cles suivis</div>
        <div class="value" style="color:#8b5cf6">-</div>
        <div class="sub">Total unique</div>
        <div class="icon-bg" style="background:#8b5cf6"></div>
      </div>
      <div class="stat-card">
        <div class="label">Positionnes</div>
        <div class="value" style="color:#22c55e">-</div>
        <div class="sub">Visibles sur Google</div>
        <div class="icon-bg" style="background:#22c55e"></div>
      </div>
      <div class="stat-card">
        <div class="label">Top 3</div>
        <div class="value" style="color:#3b82f6">-</div>
        <div class="sub">Podium Google</div>
        <div class="icon-bg" style="background:#3b82f6"></div>
      </div>
      <div class="stat-card">
        <div class="label">Top 10</div>
        <div class="value" style="color:#f59e0b">-</div>
        <div class="sub">Page 1</div>
        <div class="icon-bg" style="background:#f59e0b"></div>
      </div>
      <div class="stat-card">
        <div class="label">Progression</div>
        <div class="value" style="color:#059669">-</div>
        <div class="sub">Mots-cles en hausse</div>
        <div class="icon-bg" style="background:#059669"></div>
      </div>
    </div>

    <!-- Distribution bar -->
    <div class="distrib-bar-container" id="distribContainer" style="display:none">
      <div class="distrib-title">Repartition des positions</div>
      <div class="distrib-bar" id="distribBar"></div>
      <div class="distrib-legend">
        <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div> Top 3</div>
        <div class="legend-item"><div class="legend-dot" style="background:#3b82f6"></div> Top 4-10</div>
        <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div> Top 11-20</div>
        <div class="legend-item"><div class="legend-dot" style="background:#cbd5e1"></div> Non visible</div>
      </div>
    </div>

    <!-- Position evolution chart -->
    <div class="chart-section" id="chartSection" style="display:none">
      <div class="chart-title">
        <span>Evolution des positions</span>
        <span style="font-size:0.72rem;font-weight:400;color:#94a3b8">10 derniers checks</span>
      </div>
      <div class="chart-canvas" id="chartCanvas"></div>
      <div class="chart-legend" id="chartLegend"></div>
    </div>

    <!-- Weekly distribution chart -->
    <div class="chart-section" id="weeklyChartSection" style="display:none">
      <div class="chart-title">Distribution des positions par semaine</div>
      <div class="chart-canvas" id="weeklyChartCanvas"></div>
    </div>

    <!-- Movements -->
    <div class="movements-section" id="movementsSection" style="display:none">
      <div class="movements-header">Mouvements de la semaine</div>
      <div class="movements-grid" id="movementsGrid"></div>
    </div>

    <!-- GSC Data -->
    <div class="gsc-section" id="gscSection" style="display:none">
      <div class="gsc-header">Google Search Console</div>
      <div class="gsc-stats" id="gscStats"></div>
      <table class="gsc-table" id="gscTable"></table>
    </div>

    <!-- Filters -->
    <div class="filters">
      <button class="filter-btn active" data-filter="all" onclick="setFilter('all')">Tous</button>
      <button class="filter-btn" data-filter="top3" onclick="setFilter('top3')">Top 3</button>
      <button class="filter-btn" data-filter="top10" onclick="setFilter('top10')">Top 4-10</button>
      <button class="filter-btn" data-filter="top20" onclick="setFilter('top20')">Top 11-20</button>
      <button class="filter-btn" data-filter="none" onclick="setFilter('none')">Non visibles</button>
      <button class="filter-btn" data-filter="primary" onclick="setFilter('primary')">Principaux</button>
      <button class="filter-btn" data-filter="secondary" onclick="setFilter('secondary')">Secondaires</button>
      <input type="text" class="search-input" placeholder="Rechercher un mot-cle..." oninput="setSearch(this.value)" />
    </div>

    <!-- Keywords table -->
    <div class="kw-table-wrap">
      <table class="kw-table">
        <thead>
          <tr>
            <th>Position</th>
            <th>Mot-cle</th>
            <th>Article</th>
            <th>Type</th>
            <th>Tendance</th>
            <th>Derniere verif.</th>
          </tr>
        </thead>
        <tbody id="kwBody">
          <tr><td colspan="6" class="empty-state">Chargement...</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Bottom: Run history + Diagnostic -->
    <div class="two-cols">
      <div class="section-card">
        <div class="section-header">
          Historique des runs
          <span class="badge-count" id="runCount">0</span>
        </div>
        <div id="runsList">
          <div class="empty-state">Chargement...</div>
        </div>
      </div>

      <div class="section-card" id="diagCard">
        <div class="section-header">
          Diagnostic et recommandations
        </div>
        <div id="diagBody">
          <div class="empty-state">Chargement...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allRankings = [];
  let articleMap = {};
  let currentFilter = 'all';
  let currentSearch = '';

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  function posBadge(pos) {
    if (!pos) return '<span class="pos-badge pos-none">---</span>';
    if (pos <= 3) return `<span class="pos-badge pos-top3">#${pos}</span>`;
    if (pos <= 10) return `<span class="pos-badge pos-top10">#${pos}</span>`;
    return `<span class="pos-badge pos-top20">#${pos}</span>`;
  }

  function trendHtml(pos, prev) {
    if (prev === null || prev === undefined) return '<span class="trend trend-new">NEW</span>';
    if (pos === null && prev === null) return '';
    if (pos === null) return '<span class="trend trend-down">&#x2193; sorti</span>';
    if (prev === null) return '<span class="trend trend-up">&#x2191; entre</span>';
    const diff = prev - pos; // positive = improved
    if (diff > 0) return `<span class="trend trend-up">&#x2191; +${diff}</span>`;
    if (diff < 0) return `<span class="trend trend-down">&#x2193; ${diff}</span>`;
    return '<span class="trend trend-stable">= stable</span>';
  }

  function typeBadge(t) {
    if (t === 'primary') return '<span class="kw-type kt-primary">Principal</span>';
    return '<span class="kw-type kt-secondary">Secondaire</span>';
  }

  function timeAgo(dateStr) {
    if (!dateStr) return '-';
    const d = new Date(dateStr);
    const now = new Date();
    const diffH = Math.round((now - d) / 3600000);
    if (diffH < 1) return "A l'instant";
    if (diffH < 24) return `Il y a ${diffH}h`;
    const diffD = Math.round(diffH / 24);
    if (diffD === 1) return 'Hier';
    if (diffD < 7) return `Il y a ${diffD}j`;
    return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
  }

  window.setFilter = function(f) {
    currentFilter = f;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === f));
    renderTable();
  };

  window.setSearch = function(q) {
    currentSearch = q.toLowerCase();
    renderTable();
  };

  function filterRankings() {
    let list = allRankings;
    switch (currentFilter) {
      case 'top3': list = list.filter(r => r.position && r.position <= 3); break;
      case 'top10': list = list.filter(r => r.position && r.position > 3 && r.position <= 10); break;
      case 'top20': list = list.filter(r => r.position && r.position > 10 && r.position <= 20); break;
      case 'none': list = list.filter(r => !r.position); break;
      case 'primary': list = list.filter(r => r.keyword_type === 'primary'); break;
      case 'secondary': list = list.filter(r => r.keyword_type === 'secondary'); break;
    }
    if (currentSearch) {
      list = list.filter(r =>
        (r.keyword || '').toLowerCase().includes(currentSearch) ||
        (articleMap[r.article_id] || '').toLowerCase().includes(currentSearch)
      );
    }
    return list;
  }

  function renderTable() {
    const filtered = filterRankings();
    const body = document.getElementById('kwBody');

    if (filtered.length === 0) {
      body.innerHTML = `<tr><td colspan="6" class="empty-state">${allRankings.length > 0 ? 'Aucun resultat pour ce filtre' : 'Aucune donnee — lancez l\'agent analytics'}</td></tr>`;
      return;
    }

    body.innerHTML = filtered.map(r => `
      <tr>
        <td>${posBadge(r.position)}</td>
        <td>
          <span class="kw-name">${esc(r.keyword)}</span>
          <span class="kw-slug">${esc(articleMap[r.article_id] || '-')}</span>
        </td>
        <td><span class="kw-slug" style="display:inline">${esc(articleMap[r.article_id] || '-')}</span></td>
        <td>${typeBadge(r.keyword_type)}</td>
        <td>${trendHtml(r.position, r.previous_position)}</td>
        <td style="font-size:0.75rem;color:#64748b">${timeAgo(r.checked_at)}</td>
      </tr>
    `).join('');
  }

  function renderDistribution(rankings) {
    const total = rankings.length;
    if (total === 0) return;

    const top3 = rankings.filter(r => r.position && r.position <= 3).length;
    const top10 = rankings.filter(r => r.position && r.position > 3 && r.position <= 10).length;
    const top20 = rankings.filter(r => r.position && r.position > 10).length;
    const none = rankings.filter(r => !r.position).length;

    const pct = v => Math.max(0, (v / total * 100)).toFixed(1);

    document.getElementById('distribContainer').style.display = 'block';
    document.getElementById('distribBar').innerHTML = [
      top3 > 0 ? `<div class="distrib-segment seg-top3" style="width:${pct(top3)}%">${top3}</div>` : '',
      top10 > 0 ? `<div class="distrib-segment seg-top10" style="width:${pct(top10)}%">${top10}</div>` : '',
      top20 > 0 ? `<div class="distrib-segment seg-top20" style="width:${pct(top20)}%">${top20}</div>` : '',
      none > 0 ? `<div class="distrib-segment seg-none" style="width:${pct(none)}%">${none}</div>` : '',
    ].join('');
  }

  function renderStats(rankings) {
    const total = rankings.length;
    const positioned = rankings.filter(r => r.position !== null && r.position !== undefined);
    const top3 = positioned.filter(r => r.position <= 3).length;
    const top10 = positioned.filter(r => r.position <= 10).length;
    const improving = rankings.filter(r => r.previous_position !== null && r.previous_position !== undefined && r.position !== null && r.position < r.previous_position).length;

    document.getElementById('statsGrid').innerHTML = `
      <div class="stat-card">
        <div class="label">Mots-cles suivis</div>
        <div class="value" style="color:#8b5cf6">${total}</div>
        <div class="sub">${rankings.filter(r => r.keyword_type === 'primary').length} principaux</div>
        <div class="icon-bg" style="background:#8b5cf6"></div>
      </div>
      <div class="stat-card">
        <div class="label">Positionnes</div>
        <div class="value" style="color:#22c55e">${positioned.length}</div>
        <div class="sub">${total > 0 ? Math.round(positioned.length / total * 100) : 0}% de visibilite</div>
        <div class="icon-bg" style="background:#22c55e"></div>
      </div>
      <div class="stat-card">
        <div class="label">Top 3</div>
        <div class="value" style="color:#3b82f6">${top3}</div>
        <div class="sub">Podium Google</div>
        <div class="icon-bg" style="background:#3b82f6"></div>
      </div>
      <div class="stat-card">
        <div class="label">Top 10</div>
        <div class="value" style="color:#f59e0b">${top10}</div>
        <div class="sub">Page 1</div>
        <div class="icon-bg" style="background:#f59e0b"></div>
      </div>
      <div class="stat-card">
        <div class="label">En progression</div>
        <div class="value" style="color:#059669">${improving}</div>
        <div class="sub">&#x2191; vs dernier check</div>
        <div class="icon-bg" style="background:#059669"></div>
      </div>
    `;

    // Update filter counts
    const counts = {
      all: total,
      top3: top3,
      top10: positioned.filter(r => r.position > 3 && r.position <= 10).length,
      top20: positioned.filter(r => r.position > 10).length,
      none: rankings.filter(r => !r.position).length,
      primary: rankings.filter(r => r.keyword_type === 'primary').length,
      secondary: rankings.filter(r => r.keyword_type === 'secondary').length,
    };
    document.querySelectorAll('.filter-btn').forEach(btn => {
      const f = btn.dataset.filter;
      const existing = btn.querySelector('.filter-count');
      if (existing) existing.remove();
      if (counts[f]) btn.insertAdjacentHTML('beforeend', `<span class="filter-count">${counts[f]}</span>`);
    });
  }

  async function loadRuns() {
    try {
      const runs = await sbFetch('agent_runs', 'select=*&agent_name=eq.analytics&order=started_at.desc&limit=10');
      document.getElementById('runCount').textContent = runs.length;

      if (runs.length === 0) {
        document.getElementById('runsList').innerHTML = '<div class="empty-state">Aucun run enregistre</div>';
        return;
      }

      document.getElementById('runsList').innerHTML = runs.map(r => {
        const meta = r.metadata || {};
        const dotClass = r.status === 'completed' ? 'run-dot-ok' : r.status === 'failed' ? 'run-dot-fail' : 'run-dot-run';
        const date = new Date(r.started_at);
        const dateStr = date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

        return `<div class="run-item">
          <div class="run-dot ${dotClass}"></div>
          <div class="run-info">
            <div class="run-date">${esc(dateStr)}</div>
            <div class="run-meta">${r.items_processed || 0} mots-cles verifies${meta.articles_checked ? ` sur ${meta.articles_checked} articles` : ''}</div>
          </div>
          <div class="run-stats">
            ${meta.improvements ? `<span class="run-stat-badge" style="background:#dcfce7;color:#166534">&#x2191;${meta.improvements}</span>` : ''}
            ${meta.declines ? `<span class="run-stat-badge" style="background:#fee2e2;color:#991b1b">&#x2193;${meta.declines}</span>` : ''}
          </div>
        </div>`;
      }).join('');
    } catch (e) {
      document.getElementById('runsList').innerHTML = `<div class="empty-state" style="color:#ef4444">Erreur: ${esc(e.message)}</div>`;
    }
  }

  function renderDiagnostic(rankings) {
    const total = rankings.length;
    if (total === 0) {
      document.getElementById('diagBody').innerHTML = '<div class="empty-state">Lancez l\'agent analytics pour obtenir un diagnostic</div>';
      return;
    }

    const positioned = rankings.filter(r => r.position);
    const top3 = positioned.filter(r => r.position <= 3);
    const none = rankings.filter(r => !r.position);
    const improving = rankings.filter(r => r.previous_position && r.position && r.position < r.previous_position);
    const declining = rankings.filter(r => r.previous_position && r.position && r.position > r.previous_position);

    const tips = [];

    if (top3.length > 0) {
      tips.push({ type: 'ok', text: `${top3.length} mot(s)-cle(s) en top 3 ! Consolidez ces positions avec du contenu enrichi et du maillage interne cible.` });
    }

    if (improving.length > 0) {
      tips.push({ type: 'ok', text: `${improving.length} mot(s)-cle(s) en progression. Le travail SEO porte ses fruits.` });
    }

    if (declining.length > 0) {
      tips.push({ type: 'warn', text: `${declining.length} mot(s)-cle(s) en recul. Verifiez le contenu et les backlinks de ces pages.` });
    }

    if (none.length > total * 0.5) {
      tips.push({ type: 'warn', text: `${Math.round(none.length / total * 100)}% des mots-cles sont non visibles. Priorisez le contenu et les backlinks sur les requetes a fort volume.` });
    }

    if (positioned.length > 0 && positioned.length < 10) {
      tips.push({ type: 'tip', text: 'Ciblez les requetes longue traine pour augmenter rapidement le nombre de mots-cles positionnes.' });
    }

    tips.push({ type: 'tip', text: 'Relancez l\'agent analytics regulierement pour suivre l\'evolution dans le temps.' });

    document.getElementById('diagBody').innerHTML = tips.map(t => `
      <div class="diag-item">
        <div class="diag-icon diag-${t.type}">${t.type === 'ok' ? '&#x2713;' : t.type === 'warn' ? '!' : '&#x2192;'}</div>
        <span>${esc(t.text)}</span>
      </div>
    `).join('');
  }

  const CHART_COLORS = ['#ef4444','#3b82f6','#22c55e','#f59e0b','#8b5cf6','#ec4899','#06b6d4','#84cc16','#f97316','#6366f1'];
  let hiddenKeywords = new Set();

  function renderPositionChart(rawRankings) {
    // Group by keyword, get history
    const kwHistory = {};
    for (const r of rawRankings) {
      if (!r.position || !r.keyword) continue;
      if (!kwHistory[r.keyword]) kwHistory[r.keyword] = [];
      kwHistory[r.keyword].push({ date: r.checked_at, position: r.position });
    }

    // Take top 10 keywords by most data points (primary first)
    const primaryKws = rawRankings.filter(r => r.keyword_type === 'primary').map(r => r.keyword);
    const primarySet = new Set(primaryKws);
    const sortedKws = Object.entries(kwHistory)
      .sort((a, b) => {
        const aP = primarySet.has(a[0]) ? 0 : 1;
        const bP = primarySet.has(b[0]) ? 0 : 1;
        if (aP !== bP) return aP - bP;
        return b[1].length - a[1].length;
      })
      .slice(0, 10);

    if (sortedKws.length === 0) return;
    document.getElementById('chartSection').style.display = 'block';

    // Sort each history by date
    sortedKws.forEach(([kw, hist]) => hist.sort((a, b) => new Date(a.date) - new Date(b.date)));

    // Find date range and position range
    let allDates = [];
    let maxPos = 0;
    sortedKws.forEach(([kw, hist]) => {
      hist.forEach(h => {
        allDates.push(new Date(h.date));
        if (h.position > maxPos) maxPos = h.position;
      });
    });
    allDates.sort((a, b) => a - b);
    const minDate = allDates[0];
    const maxDate = allDates[allDates.length - 1];
    const dateRange = maxDate - minDate || 1;
    maxPos = Math.max(maxPos, 20);

    // SVG dimensions
    const W = 800, H = 240, PAD_L = 40, PAD_R = 20, PAD_T = 10, PAD_B = 30;
    const plotW = W - PAD_L - PAD_R;
    const plotH = H - PAD_T - PAD_B;

    const x = (date) => PAD_L + ((new Date(date) - minDate) / dateRange) * plotW;
    const y = (pos) => PAD_T + ((pos - 1) / (maxPos - 1)) * plotH; // position 1 at top

    // Build SVG
    let svg = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">`;

    // Grid lines
    [1, 3, 10, 20].forEach(p => {
      if (p <= maxPos) {
        const yp = y(p);
        svg += `<line x1="${PAD_L}" y1="${yp}" x2="${W-PAD_R}" y2="${yp}" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="${p === 1 ? '' : '4,4'}"/>`;
        svg += `<text x="${PAD_L-5}" y="${yp+4}" text-anchor="end" fill="#94a3b8" font-size="10">#${p}</text>`;
      }
    });

    // Date labels
    const dateLabels = [...new Set(allDates.map(d => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })))];
    const step = Math.max(1, Math.floor(dateLabels.length / 5));
    dateLabels.forEach((label, i) => {
      if (i % step === 0) {
        const xp = PAD_L + (i / (dateLabels.length - 1 || 1)) * plotW;
        svg += `<text x="${xp}" y="${H-5}" text-anchor="middle" fill="#94a3b8" font-size="10">${label}</text>`;
      }
    });

    // Lines for each keyword
    sortedKws.forEach(([kw, hist], idx) => {
      if (hiddenKeywords.has(kw)) return;
      const color = CHART_COLORS[idx % CHART_COLORS.length];
      if (hist.length < 2) {
        // Single point
        svg += `<circle cx="${x(hist[0].date)}" cy="${y(hist[0].position)}" r="4" fill="${color}"/>`;
        return;
      }
      const points = hist.map(h => `${x(h.date)},${y(h.position)}`).join(' ');
      svg += `<polyline points="${points}" fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`;
      // Dots
      hist.forEach(h => {
        svg += `<circle cx="${x(h.date)}" cy="${y(h.position)}" r="3" fill="${color}"/>`;
      });
    });

    svg += '</svg>';
    document.getElementById('chartCanvas').innerHTML = svg;

    // Legend
    document.getElementById('chartLegend').innerHTML = sortedKws.map(([kw], idx) => {
      const color = CHART_COLORS[idx % CHART_COLORS.length];
      const isHidden = hiddenKeywords.has(kw);
      return `<div class="chart-legend-item${isHidden ? ' hidden' : ''}" onclick="toggleKeyword('${esc(kw)}')">
        <div class="chart-legend-dot" style="background:${color}"></div>
        ${esc(kw)}
      </div>`;
    }).join('');
  }

  window.toggleKeyword = function(kw) {
    if (hiddenKeywords.has(kw)) hiddenKeywords.delete(kw);
    else hiddenKeywords.add(kw);
    renderPositionChart(window._rawRankings || []);
  };

  function renderWeeklyChart(rawRankings) {
    // Group by week
    const weeks = {};
    for (const r of rawRankings) {
      if (!r.week_number && !r.checked_at) continue;
      const weekKey = r.week_number || new Date(r.checked_at).toISOString().slice(0, 10);
      if (!weeks[weekKey]) weeks[weekKey] = { top3: 0, top10: 0, top20: 0, none: 0 };
      if (r.position && r.position <= 3) weeks[weekKey].top3++;
      else if (r.position && r.position <= 10) weeks[weekKey].top10++;
      else if (r.position && r.position <= 20) weeks[weekKey].top20++;
      else weeks[weekKey].none++;
    }

    const sortedWeeks = Object.entries(weeks).sort((a, b) => a[0].localeCompare(b[0]));
    if (sortedWeeks.length < 2) return;

    document.getElementById('weeklyChartSection').style.display = 'block';

    const W = 800, H = 200, PAD_L = 40, PAD_R = 20, PAD_T = 10, PAD_B = 30;
    const barW = Math.min(40, (W - PAD_L - PAD_R) / sortedWeeks.length * 0.8);
    const gap = (W - PAD_L - PAD_R) / sortedWeeks.length;
    const maxVal = Math.max(...sortedWeeks.map(([, v]) => v.top3 + v.top10 + v.top20 + v.none));
    const plotH = H - PAD_T - PAD_B;

    let svg = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">`;

    sortedWeeks.forEach(([week, counts], i) => {
      const cx = PAD_L + gap * i + gap / 2;
      const total = counts.top3 + counts.top10 + counts.top20 + counts.none;
      let currentY = H - PAD_B;

      const segments = [
        { val: counts.top3, color: '#22c55e' },
        { val: counts.top10, color: '#3b82f6' },
        { val: counts.top20, color: '#f59e0b' },
        { val: counts.none, color: '#cbd5e1' },
      ];

      segments.forEach(seg => {
        if (seg.val === 0) return;
        const h = (seg.val / maxVal) * plotH;
        svg += `<rect x="${cx - barW/2}" y="${currentY - h}" width="${barW}" height="${h}" fill="${seg.color}" rx="2"/>`;
        currentY -= h;
      });

      // Label
      const label = week.length > 5 ? week.slice(-5) : week;
      svg += `<text x="${cx}" y="${H-5}" text-anchor="middle" fill="#94a3b8" font-size="9">${label}</text>`;
    });

    svg += '</svg>';
    document.getElementById('weeklyChartCanvas').innerHTML = svg;
  }

  function renderMovements(rawRankings) {
    // Compare latest positions with previous positions
    const latest = {};
    for (const r of rawRankings) {
      const key = `${r.keyword}__${r.article_id}`;
      if (!latest[key]) latest[key] = r;
    }

    const all = Object.values(latest);
    const improvements = all
      .filter(r => r.previous_position && r.position && r.position < r.previous_position)
      .map(r => ({ keyword: r.keyword, change: r.previous_position - r.position, pos: r.position }))
      .sort((a, b) => b.change - a.change)
      .slice(0, 5);

    const declines = all
      .filter(r => r.previous_position && r.position && r.position > r.previous_position)
      .map(r => ({ keyword: r.keyword, change: r.position - r.previous_position, pos: r.position }))
      .sort((a, b) => b.change - a.change)
      .slice(0, 5);

    const newKws = all
      .filter(r => r.previous_position === null || r.previous_position === undefined)
      .filter(r => r.position)
      .map(r => ({ keyword: r.keyword, pos: r.position }))
      .slice(0, 5);

    if (improvements.length === 0 && declines.length === 0 && newKws.length === 0) return;

    document.getElementById('movementsSection').style.display = 'block';
    document.getElementById('movementsGrid').innerHTML = `
      <div class="movement-col">
        <div class="movement-col-title" style="color:#16a34a">&#x2191; Progressions</div>
        ${improvements.length === 0 ? '<div style="color:#94a3b8;font-size:0.78rem">Aucune</div>' : improvements.map(m =>
          `<div class="movement-item">
            <span class="movement-kw">${esc(m.keyword)}</span>
            <span class="movement-change mc-up">+${m.change} &#x2192; #${m.pos}</span>
          </div>`
        ).join('')}
      </div>
      <div class="movement-col">
        <div class="movement-col-title" style="color:#dc2626">&#x2193; Reculs</div>
        ${declines.length === 0 ? '<div style="color:#94a3b8;font-size:0.78rem">Aucun</div>' : declines.map(m =>
          `<div class="movement-item">
            <span class="movement-kw">${esc(m.keyword)}</span>
            <span class="movement-change mc-down">-${m.change} &#x2192; #${m.pos}</span>
          </div>`
        ).join('')}
      </div>
      <div class="movement-col">
        <div class="movement-col-title" style="color:#7c3aed">NEW</div>
        ${newKws.length === 0 ? '<div style="color:#94a3b8;font-size:0.78rem">Aucun</div>' : newKws.map(m =>
          `<div class="movement-item">
            <span class="movement-kw">${esc(m.keyword)}</span>
            <span class="movement-change mc-new">#${m.pos}</span>
          </div>`
        ).join('')}
      </div>
    `;
  }

  async function loadGSCData() {
    try {
      const [gscData, gaData] = await Promise.all([
        sbFetch('gsc_metrics', 'select=*&order=date.desc&limit=100'),
        sbFetch('ga_metrics', 'select=*&order=date.desc&limit=100')
      ]);

      if (gscData.length === 0 && gaData.length === 0) return;

      document.getElementById('gscSection').style.display = 'block';

      // GSC aggregate stats
      const totalClicks = gscData.reduce((s, r) => s + (r.clicks || 0), 0);
      const totalImpressions = gscData.reduce((s, r) => s + (r.impressions || 0), 0);
      const avgCTR = totalImpressions > 0 ? (totalClicks / totalImpressions * 100).toFixed(1) : 0;
      const avgPos = gscData.length > 0 ? (gscData.reduce((s, r) => s + (parseFloat(r.position) || 0), 0) / gscData.length).toFixed(1) : '-';

      document.getElementById('gscStats').innerHTML = `
        <div class="gsc-stat"><div class="gsc-val" style="color:#3b82f6">${totalClicks.toLocaleString()}</div><div class="gsc-lbl">Clics GSC</div></div>
        <div class="gsc-stat"><div class="gsc-val" style="color:#8b5cf6">${totalImpressions.toLocaleString()}</div><div class="gsc-lbl">Impressions</div></div>
        <div class="gsc-stat"><div class="gsc-val" style="color:#22c55e">${avgCTR}%</div><div class="gsc-lbl">CTR moyen</div></div>
        <div class="gsc-stat"><div class="gsc-val" style="color:#f59e0b">${avgPos}</div><div class="gsc-lbl">Position moyenne</div></div>
      `;

      // Top queries
      const queryAgg = {};
      for (const r of gscData) {
        if (!r.query) continue;
        if (!queryAgg[r.query]) queryAgg[r.query] = { clicks: 0, impressions: 0 };
        queryAgg[r.query].clicks += r.clicks || 0;
        queryAgg[r.query].impressions += r.impressions || 0;
      }
      const topQueries = Object.entries(queryAgg).sort((a, b) => b[1].impressions - a[1].impressions).slice(0, 10);

      if (topQueries.length > 0) {
        document.getElementById('gscTable').innerHTML = `
          <thead><tr><th>Query</th><th>Clics</th><th>Impressions</th><th>CTR</th></tr></thead>
          <tbody>${topQueries.map(([q, data]) => {
            const ctr = data.impressions > 0 ? (data.clicks / data.impressions * 100).toFixed(1) : 0;
            return `<tr><td style="font-weight:600">${esc(q)}</td><td>${data.clicks}</td><td>${data.impressions}</td><td>${ctr}%</td></tr>`;
          }).join('')}</tbody>
        `;
      }
    } catch(e) { /* GSC data not available, that's fine */ }
  }

  async function loadAll() {
    try {
      const [rawRankings, articles] = await Promise.all([
        sbFetch('keyword_rankings', 'select=*&order=checked_at.desc'),
        sbFetch('articles', 'select=id,slug&is_active=eq.true')
      ]);

      window._rawRankings = rawRankings;

      articleMap = {};
      articles.forEach(a => { articleMap[a.id] = a.slug; });

      // Deduplicate: keep latest per keyword+article
      const latest = {};
      for (const r of rawRankings) {
        const key = `${r.keyword}__${r.article_id}`;
        if (!latest[key]) latest[key] = r;
      }
      allRankings = Object.values(latest);

      allRankings.sort((a, b) => {
        if (a.position && b.position) return a.position - b.position;
        if (a.position) return -1;
        if (b.position) return 1;
        return 0;
      });

      renderStats(allRankings);
      renderDistribution(allRankings);
      renderPositionChart(rawRankings);
      renderWeeklyChart(rawRankings);
      renderMovements(rawRankings);
      renderTable();
      renderDiagnostic(allRankings);
      loadRuns();
      loadGSCData();

      document.getElementById('lastUpdate').textContent = 'Maj: ' + new Date().toLocaleTimeString('fr-FR');
    } catch (e) {
      document.getElementById('kwBody').innerHTML = `<tr><td colspan="6" class="empty-state" style="color:#ef4444">Erreur: ${esc(e.message)}</td></tr>`;
    }
  }

  loadAll();
  setInterval(loadAll, 30000);
</script>

</body>
</html>
