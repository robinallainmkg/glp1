<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allRankings = [];
  let articleMap = {};
  let searchPrimary = '';
  let searchSecondary = '';
  let rankingPeriodDays = 30;
  let trafficPeriodDays = 30;
  let detailTrafficPeriodDays = 30;
  let convPeriodDays = 30;
  let hiddenTrafficLines = new Set();
  let hiddenDetailTrafficLines = new Set();
  let hiddenConvLines = new Set();
  let hiddenKeywords = new Set();

  // Data stores
  let gscData = [];
  let gaData = [];
  let convData = { newsletter: [], diagnostic: [], chat: [], contact: [], checkouts: [], invoices: [], trials: [] };

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) return [];
    return r.json();
  }

  // ==================== TABS ====================
  window.switchTab = function(tab, el) {
    document.querySelectorAll('.page-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('tab-' + tab).classList.add('active');
  };

  // ==================== HELPERS ====================
  function posBadge(pos) {
    if (!pos) return '<span class="pos-badge pos-none">---</span>';
    if (pos <= 3) return `<span class="pos-badge pos-top3">#${pos}</span>`;
    if (pos <= 10) return `<span class="pos-badge pos-top10">#${pos}</span>`;
    return `<span class="pos-badge pos-top20">#${pos}</span>`;
  }

  function trendHtml(pos, prev) {
    if (prev === null || prev === undefined) return '<span class="trend trend-new">NEW</span>';
    if (pos === null) return '<span class="trend trend-down">sorti</span>';
    if (prev === null) return '<span class="trend trend-up">entre</span>';
    const diff = prev - pos;
    if (diff > 0) return `<span class="trend trend-up">+${diff}</span>`;
    if (diff < 0) return `<span class="trend trend-down">${diff}</span>`;
    return '<span class="trend trend-stable">= stable</span>';
  }

  function timeAgo(dateStr) {
    if (!dateStr) return '-';
    const d = new Date(dateStr);
    const now = new Date();
    const diffH = Math.round((now - d) / 3600000);
    if (diffH < 1) return "A l'instant";
    if (diffH < 24) return `Il y a ${diffH}h`;
    const diffD = Math.round(diffH / 24);
    if (diffD === 1) return 'Hier';
    if (diffD < 7) return `Il y a ${diffD}j`;
    return d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
  }

  function fmtNum(n) { return n >= 1000 ? (n/1000).toFixed(1) + 'k' : n.toString(); }

  // ==================== SVG CHART ENGINE ====================
  function buildLineChart(containerId, datasets, opts = {}) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const W = opts.width || 800;
    const H = opts.height || 240;
    const PAD_L = 50, PAD_R = 20, PAD_T = 15, PAD_B = 35;
    const plotW = W - PAD_L - PAD_R;
    const plotH = H - PAD_T - PAD_B;

    // Flatten dates
    let allDates = [];
    let allVals = [];
    datasets.forEach(ds => {
      if (ds.hidden) return;
      ds.points.forEach(p => { allDates.push(p.date); allVals.push(p.value); });
    });

    if (allDates.length === 0) {
      container.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#64748b;font-size:0.85rem">Aucune donnee disponible</div>';
      return;
    }

    allDates.sort((a,b) => new Date(a) - new Date(b));
    const minDate = new Date(allDates[0]);
    const maxDate = new Date(allDates[allDates.length - 1]);
    const dateRange = maxDate - minDate || 1;
    let minVal = opts.invertY ? 1 : Math.min(...allVals);
    let maxVal = opts.invertY ? Math.max(...allVals, 20) : Math.max(...allVals);
    if (minVal === maxVal) { minVal -= 1; maxVal += 1; }
    const valRange = maxVal - minVal || 1;

    const x = (date) => PAD_L + ((new Date(date) - minDate) / dateRange) * plotW;
    const y = (val) => {
      if (opts.invertY) return PAD_T + ((val - 1) / (maxVal - 1 || 1)) * plotH;
      return PAD_T + plotH - ((val - minVal) / valRange) * plotH;
    };

    let svg = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet">`;

    // Grid lines
    const gridSteps = opts.invertY ? [1, 3, 5, 10, 20].filter(v => v <= maxVal) : 5;
    if (opts.invertY) {
      gridSteps.forEach(p => {
        const yp = y(p);
        svg += `<line x1="${PAD_L}" y1="${yp}" x2="${W-PAD_R}" y2="${yp}" stroke="#1e293b" stroke-width="1" ${p === 1 || p === 10 ? '' : 'stroke-dasharray="4,4"'}/>`;
        svg += `<text x="${PAD_L-8}" y="${yp+4}" text-anchor="end" fill="#64748b" font-size="10">#${p}</text>`;
      });
    } else {
      for (let i = 0; i <= 4; i++) {
        const val = minVal + (valRange * i / 4);
        const yp = y(val);
        svg += `<line x1="${PAD_L}" y1="${yp}" x2="${W-PAD_R}" y2="${yp}" stroke="#1e293b" stroke-width="1" stroke-dasharray="4,4"/>`;
        svg += `<text x="${PAD_L-8}" y="${yp+4}" text-anchor="end" fill="#64748b" font-size="10">${fmtNum(Math.round(val))}</text>`;
      }
    }

    // Date labels
    const uniqueDates = [...new Set(allDates.map(d => new Date(d).toLocaleDateString('fr-FR', { day:'numeric', month:'short' })))];
    const step = Math.max(1, Math.floor(uniqueDates.length / 6));
    uniqueDates.forEach((label, i) => {
      if (i % step === 0) {
        const xp = PAD_L + (i / (uniqueDates.length - 1 || 1)) * plotW;
        svg += `<text x="${xp}" y="${H-8}" text-anchor="middle" fill="#64748b" font-size="10">${label}</text>`;
      }
    });

    // Draw datasets
    datasets.forEach(ds => {
      if (ds.hidden) return;
      const sorted = [...ds.points].sort((a,b) => new Date(a.date) - new Date(b.date));
      if (sorted.length === 0) return;

      if (ds.type === 'bar') {
        const barW = Math.max(4, plotW / sorted.length * 0.6);
        sorted.forEach(p => {
          const h = ((p.value - minVal) / valRange) * plotH;
          svg += `<rect x="${x(p.date) - barW/2}" y="${PAD_T + plotH - h}" width="${barW}" height="${h}" fill="${ds.color}" opacity="0.7" rx="2"/>`;
        });
      } else {
        // Area fill
        if (ds.fill) {
          const area = sorted.map((p, i) => `${x(p.date)},${y(p.value)}`).join(' ');
          const firstX = x(sorted[0].date);
          const lastX = x(sorted[sorted.length-1].date);
          const baseY = opts.invertY ? y(maxVal) : y(minVal);
          svg += `<polygon points="${firstX},${baseY} ${area} ${lastX},${baseY}" fill="${ds.color}" opacity="0.08"/>`;
        }

        if (sorted.length === 1) {
          svg += `<circle cx="${x(sorted[0].date)}" cy="${y(sorted[0].value)}" r="4" fill="${ds.color}"/>`;
        } else {
          const points = sorted.map(p => `${x(p.date)},${y(p.value)}`).join(' ');
          svg += `<polyline points="${points}" fill="none" stroke="${ds.color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>`;
          sorted.forEach(p => {
            svg += `<circle cx="${x(p.date)}" cy="${y(p.value)}" r="3" fill="${ds.color}"/>`;
          });
        }
      }
    });

    svg += '</svg>';
    container.innerHTML = svg;
  }

  // Sparkline for keyword history
  function sparklineSvg(history, color) {
    if (!history || history.length < 2) return '';
    const W = 60, H = 20;
    const maxP = Math.max(...history.map(h => h.position));
    const minP = Math.min(...history.map(h => h.position));
    const range = maxP - minP || 1;
    const pts = history.map((h, i) => {
      const xp = (i / (history.length - 1)) * W;
      const yp = H - ((h.position - minP) / range) * (H - 4) - 2;
      return `${xp},${yp}`;
    }).join(' ');
    return `<svg class="sparkline" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round"/></svg>`;
  }

  // ==================== SEARCH ====================
  window.setSearch = function(q, type) {
    if (type === 'primary') searchPrimary = q.toLowerCase();
    else searchSecondary = q.toLowerCase();
    renderKeywordTables();
  };

  // ==================== RANKING AVG CHART ====================
  window.setRankingPeriod = function(days, el) {
    rankingPeriodDays = days;
    el.parentElement.querySelectorAll('.chart-period-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    renderAvgRankingChart();
  };

  function renderAvgRankingChart() {
    const rawRankings = window._rawRankings || [];
    if (rawRankings.length === 0) return;

    const cutoff = rankingPeriodDays > 0 ? new Date(Date.now() - rankingPeriodDays * 86400000) : null;

    // Group history per keyword
    const kwHistory = {};
    const kwTypes = {};
    for (const r of rawRankings) {
      if (!r.position || !r.checked_at || !r.keyword) continue;
      if (cutoff && new Date(r.checked_at) < cutoff) continue;
      if (!kwHistory[r.keyword]) kwHistory[r.keyword] = [];
      kwHistory[r.keyword].push({ date: r.checked_at.slice(0, 10), value: r.position });
      if (r.keyword_type) kwTypes[r.keyword] = r.keyword_type;
    }

    // Sort: primary first, then by most data points, take top 8
    const sortedKws = Object.entries(kwHistory)
      .sort((a, b) => {
        const aP = kwTypes[a[0]] === 'primary' ? 0 : 1;
        const bP = kwTypes[b[0]] === 'primary' ? 0 : 1;
        if (aP !== bP) return aP - bP;
        return b[1].length - a[1].length;
      })
      .slice(0, 8);

    if (sortedKws.length === 0) return;

    // Dedupe per keyword per day (keep latest)
    sortedKws.forEach(([kw, hist]) => {
      const byDay = {};
      hist.sort((a, b) => a.date.localeCompare(b.date));
      for (const h of hist) byDay[h.date] = h.value;
      kwHistory[kw] = Object.entries(byDay).map(([date, value]) => ({ date, value }));
    });

    const datasets = sortedKws.map(([kw], idx) => ({
      points: kwHistory[kw],
      color: CHART_COLORS[idx % CHART_COLORS.length],
      hidden: false,
      fill: false
    }));

    buildLineChart('avgRankingChart', datasets, { invertY: true });

    // Legend with keyword names
    document.getElementById('overviewRankingLegend').innerHTML = sortedKws.map(([kw], idx) => {
      const color = CHART_COLORS[idx % CHART_COLORS.length];
      const isPrimary = kwTypes[kw] === 'primary';
      return `<div class="chart-legend-item" style="cursor:default">
        <div class="chart-legend-dot" style="background:${color}"></div>
        ${esc(kw)}${isPrimary ? ' <span style="font-size:0.6rem;color:#93c5fd">★</span>' : ''}
      </div>`;
    }).join('');
  }

  // ==================== TRAFFIC CHART ====================
  window.setTrafficPeriod = function(days, el) {
    trafficPeriodDays = days;
    el.parentElement.querySelectorAll('.chart-period-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    renderTrafficChart();
  };

  window.toggleTrafficLine = function(key) {
    if (hiddenTrafficLines.has(key)) hiddenTrafficLines.delete(key);
    else hiddenTrafficLines.add(key);
    renderTrafficChart();
  };

  function renderTrafficChart() {
    const datasets = [];
    const cutoff = trafficPeriodDays > 0 ? new Date(Date.now() - trafficPeriodDays * 86400000) : null;

    // GSC clicks by day
    const clicksByDay = {};
    const impressionsByDay = {};
    for (const r of gscData) {
      if (!r.date) continue;
      if (cutoff && new Date(r.date) < cutoff) continue;
      clicksByDay[r.date] = (clicksByDay[r.date] || 0) + (r.clicks || 0);
      impressionsByDay[r.date] = (impressionsByDay[r.date] || 0) + (r.impressions || 0);
    }

    // GA sessions by day
    const sessionsByDay = {};
    for (const r of gaData) {
      if (!r.date) continue;
      if (cutoff && new Date(r.date) < cutoff) continue;
      sessionsByDay[r.date] = (sessionsByDay[r.date] || 0) + (r.sessions || 0);
    }

    datasets.push({
      points: Object.entries(clicksByDay).map(([date, value]) => ({ date, value })),
      color: '#3b82f6', fill: true, hidden: hiddenTrafficLines.has('clicks')
    });
    datasets.push({
      points: Object.entries(impressionsByDay).map(([date, value]) => ({ date, value })),
      color: '#8b5cf6', fill: true, hidden: hiddenTrafficLines.has('impressions')
    });
    datasets.push({
      points: Object.entries(sessionsByDay).map(([date, value]) => ({ date, value })),
      color: '#22c55e', fill: true, hidden: hiddenTrafficLines.has('sessions')
    });

    buildLineChart('trafficChart', datasets);
  }

  // ==================== DETAIL TRAFFIC ====================
  window.setDetailTrafficPeriod = function(days, el) {
    detailTrafficPeriodDays = days;
    el.parentElement.querySelectorAll('.chart-period-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    renderDetailTrafficChart();
  };

  window.toggleDetailTraffic = function(key) {
    if (hiddenDetailTrafficLines.has(key)) hiddenDetailTrafficLines.delete(key);
    else hiddenDetailTrafficLines.add(key);
    renderDetailTrafficChart();
  };

  function renderDetailTrafficChart() {
    const cutoff = detailTrafficPeriodDays > 0 ? new Date(Date.now() - detailTrafficPeriodDays * 86400000) : null;
    const clicksByDay = {}, impressionsByDay = {}, sessionsByDay = {}, pageviewsByDay = {};

    for (const r of gscData) {
      if (!r.date || (cutoff && new Date(r.date) < cutoff)) continue;
      clicksByDay[r.date] = (clicksByDay[r.date] || 0) + (r.clicks || 0);
      impressionsByDay[r.date] = (impressionsByDay[r.date] || 0) + (r.impressions || 0);
    }
    for (const r of gaData) {
      if (!r.date || (cutoff && new Date(r.date) < cutoff)) continue;
      sessionsByDay[r.date] = (sessionsByDay[r.date] || 0) + (r.sessions || 0);
      pageviewsByDay[r.date] = (pageviewsByDay[r.date] || 0) + (r.pageviews || 0);
    }

    buildLineChart('detailTrafficChart', [
      { points: Object.entries(clicksByDay).map(([d,v]) => ({date:d,value:v})), color:'#3b82f6', fill:true, hidden: hiddenDetailTrafficLines.has('clicks') },
      { points: Object.entries(impressionsByDay).map(([d,v]) => ({date:d,value:v})), color:'#8b5cf6', fill:true, hidden: hiddenDetailTrafficLines.has('impressions') },
      { points: Object.entries(sessionsByDay).map(([d,v]) => ({date:d,value:v})), color:'#22c55e', fill:true, hidden: hiddenDetailTrafficLines.has('sessions') },
      { points: Object.entries(pageviewsByDay).map(([d,v]) => ({date:d,value:v})), color:'#f59e0b', fill:true, hidden: hiddenDetailTrafficLines.has('pageviews') },
    ], { height: 300 });
  }

  function renderTrafficStats() {
    const totalClicks = gscData.reduce((s,r) => s + (r.clicks||0), 0);
    const totalImpressions = gscData.reduce((s,r) => s + (r.impressions||0), 0);
    const avgCTR = totalImpressions > 0 ? (totalClicks / totalImpressions * 100).toFixed(1) : '0';
    const totalSessions = gaData.reduce((s,r) => s + (r.sessions||0), 0);

    document.getElementById('tClicks').textContent = fmtNum(totalClicks);
    document.getElementById('tImpressions').textContent = fmtNum(totalImpressions);
    document.getElementById('tCTR').textContent = avgCTR + '%';
    document.getElementById('tSessions').textContent = fmtNum(totalSessions);

    // Top pages table
    const pageAgg = {};
    for (const r of gscData) {
      const key = r.page_path || r.article_slug || '-';
      if (!pageAgg[key]) pageAgg[key] = { clicks: 0, impressions: 0 };
      pageAgg[key].clicks += r.clicks || 0;
      pageAgg[key].impressions += r.impressions || 0;
    }
    for (const r of gaData) {
      const key = r.page_path || r.article_slug || '-';
      if (!pageAgg[key]) pageAgg[key] = { clicks: 0, impressions: 0 };
      pageAgg[key].sessions = (pageAgg[key].sessions || 0) + (r.sessions || 0);
      pageAgg[key].pageviews = (pageAgg[key].pageviews || 0) + (r.pageviews || 0);
    }

    const topPages = Object.entries(pageAgg).sort((a,b) => (b[1].clicks + (b[1].sessions||0)) - (a[1].clicks + (a[1].sessions||0))).slice(0, 20);
    const body = document.getElementById('topPagesBody');
    if (topPages.length === 0) {
      body.innerHTML = '<tr><td colspan="6" class="empty-state">Aucune donnee de trafic</td></tr>';
      return;
    }
    body.innerHTML = topPages.map(([page, d]) => {
      const ctr = d.impressions > 0 ? (d.clicks / d.impressions * 100).toFixed(1) : '0';
      return `<tr><td style="font-weight:600;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(page)}</td><td>${d.clicks}</td><td>${fmtNum(d.impressions)}</td><td>${ctr}%</td><td>${d.sessions||'-'}</td><td>${d.pageviews||'-'}</td></tr>`;
    }).join('');
  }

