---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SAV - GLP1 Admin</title>
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0a0e17;
      color: #e2e8f0;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: #111827;
      border-bottom: 1px solid #1e293b;
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #e2e8f0; }
    .page-header-left p { font-size: 0.88rem; color: #94a3b8; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: 1px solid #2d3748;
      background: #1e293b;
      color: #c8d6e5;
      font-size: 0.82rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .refresh-btn:hover { background: #2d3748; }
    .last-update { font-size: 0.72rem; color: #94a3b8; }

    .main { padding: 2rem; }

    /* Stats */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: #111827;
      border-radius: 12px;
      padding: 1.25rem;
      border: 1px solid #1e293b;
    }
    .stat-card .label {
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      margin-bottom: 0.5rem;
    }
    .stat-card .value {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
    }
    .stat-card .sub {
      font-size: 0.75rem;
      color: #94a3b8;
      margin-top: 0.35rem;
    }

    /* Layout 2 colonnes */
    .chat-layout {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 1rem;
      height: calc(100vh - 220px);
    }

    /* Liste conversations */
    .conv-list {
      background: #111827;
      border-radius: 12px;
      border: 1px solid #1e293b;
      overflow-y: auto;
    }
    .conv-list-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #1e293b;
      font-weight: 700;
      font-size: 0.85rem;
      color: #e2e8f0;
      position: sticky;
      top: 0;
      background: #111827;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .conv-filter {
      display: flex;
      gap: 0.5rem;
    }
    .conv-filter button {
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      border: 1px solid #2d3748;
      background: #1e293b;
      font-size: 0.72rem;
      cursor: pointer;
      color: #c8d6e5;
    }
    .conv-filter button.active {
      background: #3b82f6;
      color: white;
      border-color: #3b82f6;
    }
    .conv-item.conv-test {
      opacity: 0.6;
      border-left: 2px solid #7c3aed;
    }
    .conv-item {
      padding: 0.9rem 1.25rem;
      border-bottom: 1px solid #1e293b;
      cursor: pointer;
      transition: all 0.15s;
      border-left: 3px solid transparent;
    }
    .conv-item:hover { background: #1a2332; border-left-color: #334155; }
    .conv-item.active { background: rgba(59,130,246,0.12); border-left: 3px solid #3b82f6; }
    .conv-item-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.3rem;
    }
    .conv-visitor {
      font-size: 0.82rem;
      font-weight: 600;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .conv-visitor .flag { font-size: 1rem; }
    .conv-time {
      font-size: 0.7rem;
      color: #94a3b8;
    }
    .conv-preview {
      font-size: 0.78rem;
      color: #94a3b8;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .conv-meta {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.3rem;
    }
    .conv-badge {
      font-size: 0.65rem;
      padding: 0.1rem 0.45rem;
      border-radius: 4px;
      font-weight: 600;
    }
    .conv-badge.llm { background: rgba(34,197,94,0.2); color: #4ade80; }
    .conv-badge.fallback { background: rgba(245,158,11,0.2); color: #fbbf24; }
    .conv-badge-msgs {
      font-size: 0.65rem;
      color: #94a3b8;
    }
    .conv-empty {
      padding: 3rem;
      text-align: center;
      color: #94a3b8;
      font-size: 0.88rem;
    }

    /* Detail conversation */
    .conv-detail {
      background: #0d1117;
      border-radius: 12px;
      border: 1px solid #1e293b;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .conv-detail-header {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid #1e293b;
      background: #111827;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .conv-detail-header h3 {
      font-size: 0.92rem;
      font-weight: 700;
      color: #e2e8f0;
    }
    .conv-detail-meta {
      font-size: 0.72rem;
      color: #94a3b8;
      margin-top: 0.2rem;
    }
    .conv-messages {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      background: #0d1117;
    }
    .conv-messages::-webkit-scrollbar { width: 6px; }
    .conv-messages::-webkit-scrollbar-track { background: transparent; }
    .conv-messages::-webkit-scrollbar-thumb { background: #2d3748; border-radius: 3px; }

    /* Message row */
    .msg-row {
      display: flex;
      gap: 0.75rem;
      max-width: 90%;
    }
    .msg-row.user { align-self: flex-end; flex-direction: row-reverse; }
    .msg-row.assistant { align-self: flex-start; }

    /* Avatar */
    .msg-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      flex-shrink: 0;
      margin-top: 0.15rem;
    }
    .msg-row.user .msg-avatar {
      background: linear-gradient(135deg, #3b82f6, #6366f1);
      color: white;
    }
    .msg-row.assistant .msg-avatar {
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
    }

    /* Message content wrapper */
    .msg-content {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .msg-row.user .msg-content { align-items: flex-end; }
    .msg-row.assistant .msg-content { align-items: flex-start; }

    /* Sender label */
    .msg-sender {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0 0.25rem;
    }
    .msg-row.user .msg-sender { color: #818cf8; }
    .msg-row.assistant .msg-sender { color: #34d399; }

    /* Bubble */
    .msg-bubble {
      padding: 0.85rem 1.1rem;
      border-radius: 16px;
      font-size: 0.84rem;
      line-height: 1.6;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .msg-row.user .msg-bubble {
      background: linear-gradient(135deg, #3b82f6, #4f46e5);
      color: white;
      border-bottom-right-radius: 4px;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.25);
    }
    .msg-row.assistant .msg-bubble {
      background: #161d2d;
      color: #e2e8f0;
      border: 1px solid #1e293b;
      border-bottom-left-radius: 4px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    /* Timestamp */
    .msg-time {
      font-size: 0.65rem;
      color: #64748b;
      padding: 0 0.3rem;
    }
    .msg-model-tag {
      display: inline-block;
      font-size: 0.6rem;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      font-weight: 600;
      margin-left: 0.35rem;
    }

    .no-conv-selected {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      color: #64748b;
      font-size: 0.95rem;
      flex-direction: column;
      gap: 0.75rem;
    }
    .no-conv-selected svg { opacity: 0.2; }
    .no-conv-selected span { font-size: 0.88rem; }

    .loading-spinner {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 3rem;
      color: #94a3b8;
    }

    /* Feedback analytics */
    .feedback-section {
      margin-top: 1.5rem;
    }
    .feedback-section h2 {
      font-size: 1.1rem;
      font-weight: 700;
      color: #e2e8f0;
      margin-bottom: 1rem;
    }
    .feedback-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .feedback-panel {
      background: #111827;
      border-radius: 12px;
      border: 1px solid #1e293b;
      padding: 1.25rem;
    }
    .feedback-panel h3 {
      font-size: 0.85rem;
      font-weight: 600;
      color: #94a3b8;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .feedback-item {
      padding: 0.6rem 0;
      border-bottom: 1px solid #1e293b;
      font-size: 0.82rem;
    }
    .feedback-item:last-child { border-bottom: none; }
    .feedback-item .fb-msg {
      color: #cbd5e1;
      margin-bottom: 0.25rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .feedback-item .fb-meta {
      font-size: 0.72rem;
      color: #64748b;
      display: flex;
      gap: 0.75rem;
    }
    .fb-vote-up { color: #16a34a; }
    .fb-vote-down { color: #dc2626; }
    .feedback-empty {
      color: #64748b;
      font-size: 0.82rem;
      padding: 1rem 0;
      text-align: center;
    }
    .intent-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      font-size: 0.82rem;
    }
    .intent-bar .intent-label {
      min-width: 100px;
      color: #94a3b8;
    }
    .intent-bar .intent-fill {
      flex: 1;
      height: 8px;
      border-radius: 4px;
      background: #1e293b;
      overflow: hidden;
    }
    .intent-bar .intent-fill-inner {
      height: 100%;
      border-radius: 4px;
      transition: width 0.3s;
    }
    .intent-bar .intent-count {
      min-width: 32px;
      text-align: right;
      color: #64748b;
      font-size: 0.75rem;
    }

    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .chat-layout { grid-template-columns: 1fr; height: auto; }
      .feedback-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <AdminNav />
  <div class="admin-layout">
    <div class="page-header">
      <div class="page-header-left">
        <h1>📧 SAV</h1>
        <p>Coach IA + Emails SAV — conversations et reponses emails</p>
      </div>
      <div class="header-actions">
        <span class="last-update" id="lastUpdate"></span>
        <button class="refresh-btn" id="refreshBtn" onclick="loadData()">
          🔄 Rafraichir
        </button>
      </div>
    </div>

    <div class="main">
      <!-- Stats -->
      <div class="stats-grid" id="statsGrid">
        <div class="stat-card">
          <div class="label">Conversations</div>
          <div class="value" id="statConvs">-</div>
          <div class="sub" id="statConvsToday">aujourd'hui: -</div>
        </div>
        <div class="stat-card">
          <div class="label">Messages</div>
          <div class="value" id="statMsgs">-</div>
          <div class="sub" id="statMsgsToday">aujourd'hui: -</div>
        </div>
        <div class="stat-card">
          <div class="label">Visiteurs uniques</div>
          <div class="value" id="statVisitors">-</div>
          <div class="sub">sessions distinctes</div>
        </div>
        <div class="stat-card">
          <div class="label">Modele LLM</div>
          <div class="value" id="statLlmPct" style="color: #16a34a;">-</div>
          <div class="sub" id="statFallback">fallback: -</div>
        </div>
        <div class="stat-card">
          <div class="label">Msg/Conv moyen</div>
          <div class="value" id="statAvgMsgs">-</div>
          <div class="sub">messages par conversation</div>
        </div>
        <div class="stat-card">
          <div class="label">Satisfaction</div>
          <div class="value" id="statSatisfaction" style="color: #16a34a;">-</div>
          <div class="sub" id="statFeedbackTotal">0 votes</div>
        </div>
      </div>

      <!-- Layout 2 colonnes -->
      <div class="chat-layout">
        <!-- Liste -->
        <div class="conv-list" id="convList">
          <div class="conv-list-header">
            <span>Conversations</span>
            <div class="conv-filter">
              <button class="active" data-filter="all" onclick="filterConvs('all', this)">Toutes</button>
              <button data-filter="today" onclick="filterConvs('today', this)">Aujourd'hui</button>
              <button data-filter="week" onclick="filterConvs('week', this)">7j</button>
            </div>
            <label style="display:flex;align-items:center;gap:6px;font-size:0.72rem;color:#94a3b8;cursor:pointer;margin-top:4px;">
              <input type="checkbox" id="hideTests" checked onchange="toggleTests()" style="accent-color:#3b82f6;">
              Masquer les tests
            </label>
          </div>
          <div id="convListContent">
            <div class="loading-spinner">Chargement...</div>
          </div>
        </div>

        <!-- Detail -->
        <div class="conv-detail" id="convDetail">
          <div class="no-conv-selected">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>Selectionnez une conversation pour voir les messages</span>
          </div>
        </div>
      </div>

      <!-- SAV Emails -->
      <div class="feedback-section" id="savSection">
        <h2>📧 Emails SAV</h2>
        <div class="stats-grid" style="margin-bottom: 1.5rem;">
          <div class="stat-card">
            <div class="label">Emails recus</div>
            <div class="value" id="statEmailsTotal">-</div>
            <div class="sub" id="statEmailsNew">nouveaux: -</div>
          </div>
          <div class="stat-card">
            <div class="label">Repondus</div>
            <div class="value" id="statEmailsReplied" style="color: #16a34a;">-</div>
            <div class="sub" id="statEmailsRate">taux: -</div>
          </div>
          <div class="stat-card">
            <div class="label">Dernier envoi</div>
            <div class="value" id="statLastReply" style="font-size: 1rem;">-</div>
            <div class="sub" id="statLastReplyTo">-</div>
          </div>
          <div class="stat-card">
            <div class="label">Categories</div>
            <div class="value" id="statTopCategory">-</div>
            <div class="sub" id="statCategories">-</div>
          </div>
        </div>
        <div class="feedback-grid">
          <div class="feedback-panel" style="flex: 2;">
            <h3>📬 Emails recents (entrants)</h3>
            <div id="emailsList" style="max-height: 400px; overflow-y: auto;">
              <div class="feedback-empty">Chargement...</div>
            </div>
          </div>
          <div class="feedback-panel" style="flex: 1;">
            <h3>✅ Reponses envoyees</h3>
            <div id="repliesList" style="max-height: 400px; overflow-y: auto;">
              <div class="feedback-empty">Chargement...</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Feedback analytics -->
      <div class="feedback-section">
        <h2>📊 Analyse des feedbacks</h2>
        <div class="feedback-grid">
          <div class="feedback-panel">
            <h3>👎 Reponses mal notees (a ameliorer)</h3>
            <div id="feedbackDown">
              <div class="feedback-empty">Chargement...</div>
            </div>
          </div>
          <div class="feedback-panel">
            <h3>📈 Intents detectes</h3>
            <div id="intentStats">
              <div class="feedback-empty">Chargement...</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script is:inline define:vars={{ supabaseUrl: supabaseConfig.url, supabaseKey: supabaseConfig.anonKey }}>
    // Supabase client
    let sb;
    function initSupabase() {
      if (sb) return;
      if (!window.supabase || !window.supabase.createClient) {
        throw new Error('Supabase JS not loaded');
      }
      sb = window.supabase.createClient(supabaseUrl, supabaseKey);
    }

    let allConversations = [];
    let allMessages = {};
    let currentFilter = 'all';
    let hideTestConvs = true;

    async function loadData() {
      try {
        if (!sb) initSupabase();

        // Load conversations
        const { data: convs, error: convErr } = await sb
          .from('coach_conversations')
          .select('*')
          .order('last_message_at', { ascending: false })
          .limit(200);

        if (convErr) { console.error('convs error:', convErr); }
        allConversations = convs || [];

        // Load stats
        const { count: totalMsgs } = await sb
          .from('coach_messages')
          .select('*', { count: 'exact', head: true });

        const today = new Date().toISOString().split('T')[0];
        const { count: todayMsgs } = await sb
          .from('coach_messages')
          .select('*', { count: 'exact', head: true })
          .gte('created_at', today);

        const todayConvs = allConversations.filter(c =>
          c.last_message_at && c.last_message_at.startsWith(today)
        ).length;

        // Unique sessions
        const uniqueSessions = new Set(allConversations.map(c => c.session_id)).size;

        // LLM vs fallback
        const { count: llmCount } = await sb
          .from('coach_messages')
          .select('*', { count: 'exact', head: true })
          .eq('role', 'assistant')
          .neq('model', 'fallback-v1')
          .not('model', 'is', null);

        const { count: fallbackCount } = await sb
          .from('coach_messages')
          .select('*', { count: 'exact', head: true })
          .eq('role', 'assistant')
          .eq('model', 'fallback-v1');

        const totalAssistant = (llmCount || 0) + (fallbackCount || 0);
        const llmPct = totalAssistant > 0 ? Math.round((llmCount / totalAssistant) * 100) : 0;

        // Avg msgs per conv
        const avgMsgs = allConversations.length > 0
          ? Math.round((totalMsgs || 0) / allConversations.length)
          : 0;

        // Feedback stats
        const { count: upVotes } = await sb
          .from('coach_feedback')
          .select('*', { count: 'exact', head: true })
          .eq('vote', 'up');

        const { count: downVotes } = await sb
          .from('coach_feedback')
          .select('*', { count: 'exact', head: true })
          .eq('vote', 'down');

        const totalVotes = (upVotes || 0) + (downVotes || 0);
        const satisfactionPct = totalVotes > 0 ? Math.round(((upVotes || 0) / totalVotes) * 100) : 0;

        // Update stats
        document.getElementById('statConvs').textContent = allConversations.length;
        document.getElementById('statConvsToday').textContent = "aujourd'hui: " + todayConvs;
        document.getElementById('statMsgs').textContent = totalMsgs || 0;
        document.getElementById('statMsgsToday').textContent = "aujourd'hui: " + (todayMsgs || 0);
        document.getElementById('statVisitors').textContent = uniqueSessions;
        document.getElementById('statLlmPct').textContent = llmPct + '%';
        document.getElementById('statFallback').textContent = 'fallback: ' + (fallbackCount || 0);
        document.getElementById('statAvgMsgs').textContent = avgMsgs;
        document.getElementById('statSatisfaction').textContent = totalVotes > 0 ? satisfactionPct + '%' : '-';
        document.getElementById('statSatisfaction').style.color = satisfactionPct >= 70 ? '#16a34a' : satisfactionPct >= 40 ? '#f59e0b' : '#dc2626';
        document.getElementById('statFeedbackTotal').textContent = totalVotes + ' votes (' + (upVotes || 0) + '👍 ' + (downVotes || 0) + '👎)';
        document.getElementById('lastUpdate').textContent = 'MAJ ' + new Date().toLocaleTimeString('fr-FR');

        renderConvList();
        loadFeedbackAnalytics();
        loadSavEmails();
      } catch(e) {
        console.error('loadData error:', e);
        document.getElementById('convListContent').innerHTML = '<div class="conv-empty">Erreur de chargement — voir console</div>';
      }
    }

    function filterConvs(filter, btn) {
      currentFilter = filter;
      document.querySelectorAll('.conv-filter button').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      renderConvList();
    }

    function toggleTests() {
      hideTestConvs = document.getElementById('hideTests').checked;
      renderConvList();
    }

    function isTestConv(c) {
      return c.session_id && c.session_id.startsWith('test-');
    }

    function renderConvList() {
      const container = document.getElementById('convListContent');
      let convs = [...allConversations];

      // Hide test conversations
      if (hideTestConvs) {
        convs = convs.filter(c => !isTestConv(c));
      }

      const now = new Date();
      const today = now.toISOString().split('T')[0];
      const weekAgo = new Date(now - 7 * 86400000).toISOString();

      if (currentFilter === 'today') {
        convs = convs.filter(c => c.last_message_at && c.last_message_at.startsWith(today));
      } else if (currentFilter === 'week') {
        convs = convs.filter(c => c.last_message_at && c.last_message_at >= weekAgo);
      }

      if (convs.length === 0) {
        container.innerHTML = '<div class="conv-empty">Aucune conversation' + (hideTestConvs ? ' (tests masques)' : '') + '</div>';
        return;
      }

      container.innerHTML = convs.map((c, i) => {
        const time = c.last_message_at
          ? new Date(c.last_message_at).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })
          : '-';
        const isTest = isTestConv(c);
        const sessionShort = (c.session_id || '').substring(0, 12) + '...';
        const msgs = c.message_count || 0;
        const testBadge = isTest ? '<span style="background:#7c3aed;color:#fff;padding:1px 5px;border-radius:3px;font-size:0.65rem;margin-left:4px;">TEST</span>' : '';

        return `<div class="conv-item${isTest ? ' conv-test' : ''}" onclick="loadConversation('${c.id}', this)">
          <div class="conv-item-top">
            <span class="conv-visitor">${isTest ? '🧪' : '🇫🇷'} ${sessionShort}${testBadge}</span>
            <span class="conv-time">${time}</span>
          </div>
          <div class="conv-meta">
            <span class="conv-badge-msgs">💬 ${msgs} msgs</span>
          </div>
        </div>`;
      }).join('');
    }

    async function loadConversation(convId, el) {
      if (!sb) initSupabase();

      // Active state
      document.querySelectorAll('.conv-item').forEach(i => i.classList.remove('active'));
      if (el) el.classList.add('active');

      const detail = document.getElementById('convDetail');
      detail.innerHTML = '<div class="loading-spinner">Chargement...</div>';

      // Load messages
      const { data: messages } = await sb
        .from('coach_messages')
        .select('*')
        .eq('conversation_id', convId)
        .order('created_at', { ascending: true });

      if (!messages || messages.length === 0) {
        detail.innerHTML = '<div class="no-conv-selected"><span>Aucun message</span></div>';
        return;
      }

      const conv = allConversations.find(c => c.id === convId);
      const sessionShort = conv ? (conv.session_id || '').substring(0, 16) + '...' : convId;
      const startTime = new Date(messages[0].created_at).toLocaleString('fr-FR');
      const models = [...new Set(messages.filter(m => m.model).map(m => m.model))];

      detail.innerHTML = `
        <div class="conv-detail-header">
          <div>
            <h3>🇫🇷 ${sessionShort}</h3>
            <div class="conv-detail-meta">${startTime} · ${messages.length} messages · ${models.join(', ')}</div>
          </div>
        </div>
        <div class="conv-messages">
          ${messages.map(m => {
            const time = new Date(m.created_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
            const cls = m.role === 'user' ? 'user' : 'assistant';
            const avatarLabel = cls === 'user' ? '👤' : '🤖';
            const senderLabel = cls === 'user' ? 'Visiteur' : 'Coach IA';
            const modelTag = m.model ? '<span class="msg-model-tag">' + escapeHtml(m.model) + '</span>' : '';
            return `<div class="msg-row ${cls}">
              <div class="msg-avatar">${avatarLabel}</div>
              <div class="msg-content">
                <div class="msg-sender">${senderLabel}</div>
                <div class="msg-bubble">${formatMarkdown(m.content)}</div>
                <div class="msg-time">${time}${modelTag}</div>
              </div>
            </div>`;
          }).join('')}
        </div>
      `;

      // Scroll to bottom
      const msgsEl = detail.querySelector('.conv-messages');
      if (msgsEl) msgsEl.scrollTop = msgsEl.scrollHeight;
    }

    async function loadFeedbackAnalytics() {
      try {
        // Load recent negative feedback
        const { data: downFeedback } = await sb
          .from('coach_feedback')
          .select('*')
          .eq('vote', 'down')
          .order('created_at', { ascending: false })
          .limit(10);

        const downEl = document.getElementById('feedbackDown');
        if (downFeedback && downFeedback.length > 0) {
          downEl.innerHTML = downFeedback.map(f => {
            const time = new Date(f.created_at).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
            const page = f.page_url || '-';
            const msg = (f.assistant_message || '').substring(0, 200);
            return `<div class="feedback-item">
              <div class="fb-msg">${escapeHtml(msg)}</div>
              <div class="fb-meta">
                <span class="fb-vote-down">👎</span>
                <span>${time}</span>
                <span>page: ${escapeHtml(page)}</span>
              </div>
            </div>`;
          }).join('');
        } else {
          downEl.innerHTML = '<div class="feedback-empty">Aucun feedback negatif — bravo !</div>';
        }

        // Load intent distribution from messages
        const { data: intentMsgs } = await sb
          .from('coach_messages')
          .select('intent')
          .eq('role', 'user')
          .not('intent', 'is', null)
          .limit(500);

        const intentEl = document.getElementById('intentStats');
        if (intentMsgs && intentMsgs.length > 0) {
          const counts = {};
          intentMsgs.forEach(m => {
            const key = m.intent || 'unknown';
            counts[key] = (counts[key] || 0) + 1;
          });
          const sorted = Object.entries(counts).sort((a, b) => b[1] - a[1]);
          const maxCount = sorted[0][1];

          const colors = {
            'scam': '#dc2626', 'scam:high': '#dc2626', 'scam:low': '#f59e0b',
            'selling': '#3b82f6', 'price': '#8b5cf6', 'prescription': '#06b6d4',
            'weight': '#16a34a', 'diet': '#84cc16', 'diabetes': '#f97316',
            'device': '#64748b', 'general': '#94a3b8'
          };

          intentEl.innerHTML = sorted.map(([intent, count]) => {
            const pct = Math.round((count / maxCount) * 100);
            const color = colors[intent] || '#3b82f6';
            const label = intent.replace('scam:high', 'Arnaque (grave)').replace('scam:low', 'Arnaque (faible)').replace('scam', 'Arnaque');
            return `<div class="intent-bar">
              <span class="intent-label">${escapeHtml(label)}</span>
              <div class="intent-fill"><div class="intent-fill-inner" style="width:${pct}%; background:${color};"></div></div>
              <span class="intent-count">${count}</span>
            </div>`;
          }).join('');
        } else {
          intentEl.innerHTML = '<div class="feedback-empty">Pas encore de donnees d\'intent</div>';
        }
      } catch (e) {
        console.error('loadFeedbackAnalytics error:', e);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function formatMarkdown(str) {
      var safe = escapeHtml(str);
      return safe
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\[(.*?)\]\((\/[^\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener" style="color:#60a5fa;text-decoration:underline;">$1</a>')
        .replace(/\n/g, '<br>');
    }

    // SAV Emails
    async function loadSavEmails() {
      try {
        // Load incoming emails
        const { data: emails, error: emailErr } = await sb
          .from('incoming_emails')
          .select('*')
          .order('received_at', { ascending: false })
          .limit(50);

        // Load replies
        const { data: replies, error: replyErr } = await sb
          .from('email_replies')
          .select('*')
          .order('sent_at', { ascending: false })
          .limit(50);

        if (emailErr || replyErr) {
          // Tables don't exist yet — show message
          const el = document.getElementById('emailsList');
          const rl = document.getElementById('repliesList');
          if (el) el.innerHTML = '<div class="feedback-empty" style="color:#64748b;">Tables SAV pas encore creees.<br>Lance la migration 021_sav_email_tables.sql</div>';
          if (rl) rl.innerHTML = '<div class="feedback-empty" style="color:#64748b;">-</div>';
          return;
        }

        const allEmails = emails || [];
        const allReplies = replies || [];

        // Stats
        const total = allEmails.length;
        const newCount = allEmails.filter(e => e.status === 'new').length;
        const replied = allEmails.filter(e => e.status === 'replied').length;
        const rate = total > 0 ? Math.round((replied / total) * 100) : 0;

        document.getElementById('statEmailsTotal').textContent = total;
        document.getElementById('statEmailsNew').textContent = 'nouveaux: ' + newCount;
        document.getElementById('statEmailsReplied').textContent = replied;
        document.getElementById('statEmailsRate').textContent = 'taux: ' + rate + '%';

        // Last reply
        if (allReplies.length > 0) {
          const last = allReplies[0];
          const d = new Date(last.sent_at);
          document.getElementById('statLastReply').textContent = d.toLocaleDateString('fr-FR', {day:'numeric', month:'short'});
          document.getElementById('statLastReplyTo').textContent = last.to_email;
        }

        // Categories
        const cats = {};
        allEmails.forEach(e => { if (e.category) cats[e.category] = (cats[e.category]||0) + 1; });
        const topCat = Object.entries(cats).sort((a,b) => b[1]-a[1])[0];
        if (topCat) {
          document.getElementById('statTopCategory').textContent = topCat[0].replace('_', ' ');
          document.getElementById('statCategories').textContent = Object.entries(cats).map(([k,v]) => k.replace('_',' ')+': '+v).join(', ');
        }

        // Render emails list
        const emailsEl = document.getElementById('emailsList');
        if (allEmails.length === 0) {
          emailsEl.innerHTML = '<div class="feedback-empty">Aucun email. Lance l\'agent sav-email pour sync IMAP.</div>';
        } else {
          emailsEl.innerHTML = allEmails.map(e => {
            const d = e.received_at ? new Date(e.received_at).toLocaleDateString('fr-FR', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) : '-';
            const statusColor = e.status === 'new' ? '#f59e0b' : e.status === 'replied' ? '#16a34a' : '#64748b';
            const statusLabel = e.status === 'new' ? 'NOUVEAU' : e.status === 'replied' ? 'REPONDU' : e.status.toUpperCase();
            const catBadge = e.category ? '<span style="background:#1e293b;padding:2px 8px;border-radius:4px;font-size:0.7rem;color:#94a3b8;">'+escapeHtml(e.category)+'</span>' : '';
            return '<div style="padding:10px 12px;border-bottom:1px solid #1e293b;cursor:pointer;" class="email-row">'
              + '<div style="display:flex;justify-content:space-between;align-items:center;">'
              + '<strong style="color:#e2e8f0;font-size:0.88rem;">' + escapeHtml(e.from_name || e.from_email) + '</strong>'
              + '<span style="font-size:0.7rem;font-weight:600;color:'+statusColor+';background:'+statusColor+'20;padding:2px 8px;border-radius:4px;">'+statusLabel+'</span>'
              + '</div>'
              + '<div style="font-size:0.82rem;color:#94a3b8;margin-top:2px;">' + escapeHtml(e.subject || '(sans objet)') + '</div>'
              + '<div style="display:flex;gap:8px;align-items:center;margin-top:4px;">'
              + '<span style="font-size:0.72rem;color:#64748b;">' + d + '</span>'
              + catBadge
              + '</div></div>';
          }).join('');
        }

        // Render replies list
        const repliesEl = document.getElementById('repliesList');
        if (allReplies.length === 0) {
          repliesEl.innerHTML = '<div class="feedback-empty">Aucune reponse envoyee.</div>';
        } else {
          repliesEl.innerHTML = allReplies.map(r => {
            const d = new Date(r.sent_at).toLocaleDateString('fr-FR', {day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});
            const imapIcon = r.sent_to_imap ? '✅' : '⚠️';
            return '<div style="padding:8px 12px;border-bottom:1px solid #1e293b;">'
              + '<div style="font-size:0.82rem;color:#e2e8f0;">' + escapeHtml(r.to_email) + '</div>'
              + '<div style="font-size:0.75rem;color:#94a3b8;margin-top:2px;">' + escapeHtml(r.subject || '') + '</div>'
              + '<div style="display:flex;gap:8px;margin-top:4px;font-size:0.72rem;color:#64748b;">'
              + '<span>' + d + '</span>'
              + '<span>' + imapIcon + ' Sent</span>'
              + (r.utm_campaign ? '<span style="color:#3b82f6;">' + escapeHtml(r.utm_campaign) + '</span>' : '')
              + '</div></div>';
          }).join('');
        }
      } catch(e) {
        console.log('SAV emails not available yet:', e.message);
        const el = document.getElementById('emailsList');
        if (el) el.innerHTML = '<div class="feedback-empty" style="color:#64748b;">Section SAV pas encore active.<br>Migration + premier run agent necessaires.</div>';
        const rl = document.getElementById('repliesList');
        if (rl) rl.innerHTML = '<div class="feedback-empty" style="color:#64748b;">-</div>';
      }
    }

    // Expose functions to global scope for onclick handlers
    window.loadData = loadData;
    window.loadConversation = loadConversation;
    window.filterConvs = filterConvs;
    window.toggleTests = toggleTests;

    // Auto-load
    loadData();
    // Auto-refresh every 30s
    setInterval(loadData, 30000);
  </script>
</body>
</html>
