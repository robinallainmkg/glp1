    { n:32, col:"glp1-cout", slug:"prix-rybelsus-france", kw:"prix Rybelsus France", intent:"transactionnel", issues:[] },
    { n:33, col:"glp1-cout", slug:"prix-saxenda-france", kw:"prix Saxenda France", intent:"transactionnel", issues:[] },
