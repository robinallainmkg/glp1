---
import AdminNav from '../../components/AdminNav.astro';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit Contenu - GLP1 Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Bricolage+Grotesque:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style is:inline>
    :root {
      --bg: #f7f5f2;
      --surface: #ffffff;
      --surface2: #f0ede8;
      --surface3: #e8e4dd;
      --border: #e2ddd6;
      --border2: #d0c9be;
      --text: #18150f;
      --text2: #3d3830;
      --muted: #7a7268;
      --urgent: #b83030;
      --urgent-light: #fdf2f2;
      --urgent-border: #edc0c0;
      --warning: #9a6200;
      --warning-light: #fdf8ee;
      --warning-border: #e8d090;
      --ok: #1e6e3a;
      --ok-light: #f0faf4;
      --ok-border: #a8dab8;
      --blue: #1a3f7a;
      --blue-light: #eef3fc;
      --blue-border: #a8c0e8;
      --purple: #5a3a8a;
      --purple-light: #f5f0fc;
      --purple-border: #c8a8e8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Bricolage Grotesque', sans-serif;
      min-height: 100vh;
      font-size: 14px;
    }

    .admin-layout { margin-left: 260px; min-height: 100vh; display: flex; flex-direction: column; }

    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 32px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .topbar-left { display: flex; align-items: center; gap: 16px; }
    .page-title { font-size: 15px; font-weight: 700; letter-spacing: -0.3px; }
    .topbar-meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      color: var(--muted);
      padding: 3px 8px;
      background: var(--surface2);
      border-radius: 4px;
    }

    .content { padding: 28px 32px; overflow-y: auto; flex: 1; }

    /* Stats grid */
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px; }
    .stat {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 18px;
    }
    .stat-label {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .stat-value { font-size: 30px; font-weight: 800; letter-spacing: -1.5px; line-height: 1; }
    .stat-sub { font-size: 11px; color: var(--muted); margin-top: 4px; }

    /* Phase blocks */
    .phase {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      margin-bottom: 20px;
      overflow: hidden;
    }
    .phase-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 12px;
      cursor: pointer;
      user-select: none;
    }
    .phase-header:hover { background: var(--surface2); }
    .phase-number {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      padding: 4px 8px;
      border-radius: 5px;
      flex-shrink: 0;
    }
    .phase-p1 { background: var(--urgent-light); color: var(--urgent); border: 1px solid var(--urgent-border); }
    .phase-p2 { background: var(--warning-light); color: var(--warning); border: 1px solid var(--warning-border); }
    .phase-p3 { background: var(--blue-light); color: var(--blue); border: 1px solid var(--blue-border); }
    .phase-p4 { background: var(--purple-light); color: var(--purple); border: 1px solid var(--purple-border); }
    .phase-title { font-size: 14px; font-weight: 700; flex: 1; }
    .phase-badge {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      padding: 3px 8px;
      border-radius: 5px;
      background: var(--surface2);
      color: var(--muted);
    }
    .phase-chevron {
      width: 16px; height: 16px; color: var(--muted); transition: transform 0.2s;
    }
    .phase.open .phase-chevron { transform: rotate(90deg); }
    .phase-body { padding: 0; max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .phase.open .phase-body { max-height: 5000px; }
    .phase-content { padding: 20px; }

    /* Task items */
    .task {
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 10px;
      font-size: 13px;
      line-height: 1.6;
    }
    .task-head {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 6px;
    }
    .task-icon { flex-shrink: 0; margin-top: 2px; }
    .task-title { font-weight: 700; }
    .task-detail { color: var(--text2); padding-left: 26px; }
    .task-detail code {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      background: var(--surface2);
      padding: 1px 5px;
      border-radius: 3px;
    }
    .task-files {
      margin-top: 8px;
      padding-left: 26px;
    }
    .task-file {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 11px;
      color: var(--blue);
      display: block;
      padding: 2px 0;
    }
    .task-urgent { border-color: var(--urgent-border); background: var(--urgent-light); }
    .task-warning { border-color: var(--warning-border); background: var(--warning-light); }
    .task-info { border-color: var(--blue-border); background: var(--blue-light); }
    .task-done { border-color: var(--ok-border); background: var(--ok-light); opacity: 0.7; }
    .task-done .task-title { text-decoration: line-through; color: var(--ok); }

    /* Alerts section */
    .alerts {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-bottom: 28px;
    }
    .alert {
      padding: 14px 18px;
      border-radius: 10px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 13px;
      line-height: 1.5;
    }
    .alert-icon { width: 20px; height: 20px; flex-shrink: 0; margin-top: 1px; }
    .alert-urgent { background: var(--urgent-light); border: 1px solid var(--urgent-border); color: var(--urgent); }
    .alert-warning { background: var(--warning-light); border: 1px solid var(--warning-border); color: var(--warning); }
    .alert-info { background: var(--blue-light); border: 1px solid var(--blue-border); color: var(--blue); }
    .alert strong { font-weight: 700; }

    /* Section heads */
    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      margin-top: 28px;
    }
    .section-title { font-size: 15px; font-weight: 700; }
    .section-sub { font-family: 'IBM Plex Mono', monospace; font-size: 10px; color: var(--muted); }

    /* Tags */
    .tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 10px;
      padding: 3px 8px;
      border-radius: 5px;
      font-weight: 500;
    }
    .tag-count { background: var(--surface2); color: var(--text2); }
    .tag-info { background: var(--blue-light); color: var(--blue); }
    .tag-transac { background: var(--purple-light); color: var(--purple); }
    .tag-nav { background: var(--ok-light); color: var(--ok); }
    .tag-warn { background: var(--warning-light); color: var(--warning); }
    .tag-urgent { background: var(--urgent-light); color: var(--urgent); }

    /* Collections grid */
    .collections-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 12px;
      margin-bottom: 28px;
    }
    .collection-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 18px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .collection-card:hover { border-color: var(--border2); box-shadow: 0 2px 8px rgba(0,0,0,0.04); }
    .collection-card.active { border-color: var(--blue); box-shadow: 0 0 0 1px var(--blue); }
    .collection-name { font-size: 14px; font-weight: 700; margin-bottom: 6px; }
    .collection-meta { display: flex; gap: 6px; flex-wrap: wrap; }

    /* Articles table */
    .table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 28px;
    }
    .table-toolbar {
      padding: 12px 18px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .search-input {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 12px;
      padding: 7px 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--surface2);
      color: var(--text);
      width: 260px;
      outline: none;
    }
    .search-input:focus { border-color: var(--blue); }
    .filter-btn {
      font-family: 'Bricolage Grotesque', sans-serif;
      font-size: 11px;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      cursor: pointer;
      transition: all 0.15s;
    }
    .filter-btn:hover, .filter-btn.active { background: var(--text); color: #fff; border-color: var(--text); }

    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    thead th {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 9px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--muted);
      text-align: left;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      background: var(--surface2);
    }
    tbody tr { border-bottom: 1px solid var(--surface2); transition: background 0.1s; }
    tbody tr:hover { background: var(--surface2); }
    tbody tr:last-child { border-bottom: none; }
    td { padding: 10px 14px; vertical-align: top; }
    td.slug { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--blue); max-width: 240px; word-break: break-all; }
    td.status-cell { max-width: 100px; }
    td.issues { max-width: 280px; }
    .issue-tag { display: inline-block; font-size: 10px; padding: 2px 7px; border-radius: 4px; margin: 1px 2px; font-weight: 500; }
    .table-footer {
      padding: 10px 18px;
      border-top: 1px solid var(--border);
      font-size: 11px;
      color: var(--muted);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
      .stats { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .stats { grid-template-columns: 1fr; }
      .collections-grid { grid-template-columns: 1fr; }
      .content { padding: 16px; }
      .topbar { padding: 0 16px; }
      .search-input { width: 100%; }
      .table-toolbar { flex-direction: column; align-items: stretch; }
    }
  </style>
</head>
<body>
<script>
  // Auth guard — redirect to login if not authenticated
  if (!sessionStorage.getItem('admin_auth')) {
    window.location.href = '/admin/login/';
  }
</script>

<AdminNav />

<div class="admin-layout">
  <div class="topbar">
    <div class="topbar-left">
      <span class="page-title">Audit Contenu</span>
      <span class="topbar-meta">80 fichiers &middot; 12 collections &middot; P1+P2 corriges &middot; 09/03/2026</span>
    </div>
  </div>

  <div class="content">

    <!-- Stats -->
    <div class="stats">
      <div class="stat">
        <div class="stat-label">Total fichiers</div>
        <div class="stat-value">80</div>
        <div class="stat-sub">12 collections (toutes enregistrees)</div>
      </div>
      <div class="stat">
        <div class="stat-label">Problemes corriges</div>
        <div class="stat-value" style="color: var(--ok);">8/9</div>
        <div class="stat-sub">P1 + P2 termines</div>
      </div>
      <div class="stat">
        <div class="stat-label">Squelettes restants</div>
        <div class="stat-value" style="color: var(--warning);">~25</div>
        <div class="stat-sub">Phase 3 — a rediger ou desindexer</div>
      </div>
      <div class="stat">
        <div class="stat-label">Reste a faire</div>
        <div class="stat-value" style="color: var(--purple);">P3+P4</div>
        <div class="stat-sub">Squelettes + ameliorations SEO</div>
      </div>
    </div>

    <!-- ====================== PLAN D'ACTION ====================== -->
    <div class="section-head" style="margin-top:0">
      <span class="section-title">Plan d'action par priorite</span>
      <span class="section-sub">4 phases &middot; cliquez pour deployer</span>
    </div>

    <!-- PHASE 1 -->
    <div class="phase" id="phase1">
      <div class="phase-header" onclick="this.parentElement.classList.toggle('open')">
        <span class="phase-number" style="background:var(--ok-light);color:var(--ok);border:1px solid var(--ok-border)">P1 CORRIGE</span>
        <span class="phase-title">Corrections critiques (technique + SEO)</span>
        <span class="phase-badge" style="background:var(--ok-light);color:var(--ok)">5/5 fait</span>
        <svg class="phase-chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </div>
      <div class="phase-body">
        <div class="phase-content">

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Supprimer les 2 doublons exacts (cannibalisation SEO)</span>
            </div>
            <div class="task-detail">Fait. Fichiers <code>clinique-pour-obesite-new.md</code> et <code>endocrinologue-pour-maigrir-new.md</code> supprimes.</div>
          </div>

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Nettoyer les 9 fichiers corrompus (balises XML)</span>
            </div>
            <div class="task-detail">Fait. Balises <code>&lt;/content&gt;</code> et <code>&lt;parameter&gt;</code> supprimees des 8 guides traitements-glp1 + serena-williams-glp1.</div>
          </div>

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Corriger le double frontmatter (7 fichiers)</span>
            </div>
            <div class="task-detail">Fait. Champs <code>thumbnail</code>/<code>thumbnailAlt</code> deplaces a l'interieur du frontmatter pour les 6 fichiers effets-secondaires + prix-rybelsus-france.</div>
          </div>

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Enregistrer collections manquantes dans config.ts</span>
            </div>
            <div class="task-detail">Fait. Collections <code>temoignages</code> et <code>avant-apres-glp1</code> ajoutees. Champs <code>thumbnailAlt</code>, <code>date</code>, <code>collection</code>, <code>slug</code> ajoutes au schema.</div>
          </div>

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Deduplication interne de wegovy-prix.md</span>
            </div>
            <div class="task-detail">Fait. Fichier passe de 776 a 209 lignes. Contenu repete 2-3x supprime, meilleurs passages fusionnes.</div>
          </div>

        </div>
      </div>
    </div>

    <!-- PHASE 2 -->
    <div class="phase" id="phase2">
      <div class="phase-header" onclick="this.parentElement.classList.toggle('open')">
        <span class="phase-number" style="background:var(--ok-light);color:var(--ok);border:1px solid var(--ok-border)">P2 CORRIGE</span>
        <span class="phase-title">Classifications et frontmatter</span>
        <span class="phase-badge" style="background:var(--ok-light);color:var(--ok)">3/3 fait</span>
        <svg class="phase-chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </div>
      <div class="phase-body">
        <div class="phase-content">

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Corriger les 4 fichiers mal classes</span>
            </div>
            <div class="task-detail">
              Fait.<br>
              <strong>1.</strong> <code>serena-williams-glp1.md</code> — collection corrigee en <code>"temoignages"</code>.<br>
              <strong>2.</strong> <code>wegovy-dosage.md</code> — deplace de effets-secondaires vers <code>traitements-glp1/</code>.<br>
              <strong>3.</strong> <code>insulevel-effet-indesirable-new.md</code> — renomme sans "-new".<br>
              <strong>4.</strong> <code>isglt2-liste.md</code> — mis en <code>published: false</code> (contenu corrompu).
            </div>
          </div>

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Uniformiser les frontmatters (9 fichiers)</span>
            </div>
            <div class="task-detail">
              Fait. Champ <code>pubDate</code> ajoute a 8 guides traitements-glp1. Champ <code>slug</code> ajoute aux 9 fichiers (8 guides + centres-mounjaro-france).
            </div>
          </div>

          <div class="task task-done">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1e6e3a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              <span class="task-title">Corriger les liens internes casses (25 fichiers)</span>
            </div>
            <div class="task-detail">Fait. 25 fichiers de contenu mis a jour : <code>../medicaments-glp1/</code> remplace par <code>../traitements-glp1/</code>.</div>
          </div>

        </div>
      </div>
    </div>

    <!-- PHASE 3 -->
    <div class="phase" id="phase3">
      <div class="phase-header" onclick="this.parentElement.classList.toggle('open')">
        <span class="phase-number phase-p3">P3 MOYENNE</span>
        <span class="phase-title">Squelettes et contenus placeholder (~28 fichiers)</span>
        <span class="phase-badge">Option A: published false / Option B: rediger</span>
        <svg class="phase-chevron" viewBox="0 0 24 24" fill="currentColor"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg>
      </div>
      <div class="phase-body">
        <div class="phase-content">

          <div class="task task-info">
            <div class="task-head">
              <svg class="task-icon" width="16" height="16" viewBox="0 0 24 24" fill="#1a3f7a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
              <span class="task-title">alternatives-glp1 : 12 squelettes sur 14</span>
            </div>
            <div class="task-detail">Template "Type A" identique avec prix <code>XX-XX EUR/mois</code>, FAQ generiques ("Question frequente 1 sur..."), section "Produits cosmetiques recommandes" hors-sujet. Seuls <code>phytotherapie-glp1</code> et <code>alternatives-naturelles-ozempic</code> ont du contenu partiellement reel.</div>
            <div class="task-files">
