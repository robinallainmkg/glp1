---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Validator - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f1f5f9; color: #1e293b; }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header { background: white; border-bottom: 1px solid #e2e8f0; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header-left p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn { padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #e2e8f0; background: white; color: #475569; font-size: 0.82rem; cursor: pointer; }
    .refresh-btn:hover { background: #f8fafc; }
    .last-update { font-size: 0.72rem; color: #94a3b8; }
    .main { padding: 2rem; }

    .cmd-box { background: #1e293b; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    .cmd-box code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.82rem; color: #a5f3fc; }
    .cmd-box .copy-btn { padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid #475569; background: transparent; color: #94a3b8; font-size: 0.72rem; cursor: pointer; }
    .cmd-box .copy-btn:hover { background: #334155; color: white; }

    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: white; border-radius: 12px; padding: 1.25rem; border: 1px solid #e2e8f0; }
    .stat-card .label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.5rem; }
    .stat-card .value { font-size: 2rem; font-weight: 800; line-height: 1; }
    .stat-card .sub { font-size: 0.75rem; color: #94a3b8; margin-top: 0.35rem; }

    /* Build status banner */
    .build-banner { border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; font-weight: 600; font-size: 0.88rem; }
    .build-ok { background: #dcfce7; border: 1px solid #86efac; color: #166534; }
    .build-fail { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .build-unknown { background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; }

    .filters { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .filter-btn { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #e2e8f0; background: white; color: #64748b; font-size: 0.78rem; cursor: pointer; font-weight: 500; }
    .filter-btn:hover { border-color: #cbd5e1; color: #334155; }
    .filter-btn.active { background: #1e293b; color: white; border-color: #1e293b; }
    .filter-count { font-size: 0.68rem; background: rgba(0,0,0,0.08); padding: 1px 6px; border-radius: 10px; margin-left: 4px; }
    .filter-btn.active .filter-count { background: rgba(255,255,255,0.2); }

    .results-table { width: 100%; background: white; border-radius: 12px; border: 1px solid #e2e8f0; overflow: hidden; }
    .results-table table { width: 100%; border-collapse: collapse; }
    .results-table th { text-align: left; padding: 0.75rem 1rem; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; border-bottom: 1px solid #e2e8f0; background: #f8fafc; }
    .results-table td { padding: 0.75rem 1rem; font-size: 0.82rem; border-bottom: 1px solid #f1f5f9; }
    .results-table tr:last-child td { border-bottom: none; }
    .results-table tr:hover td { background: #f8fafc; }

    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.68rem; font-weight: 600; }
    .badge-error { background: #fee2e2; color: #991b1b; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-info { background: #dbeafe; color: #1e40af; }
    .badge-pass { background: #d1fae5; color: #065f46; }

    .badge-build { background: #f3e8ff; color: #6b21a8; }
    .badge-frontmatter { background: #dbeafe; color: #1e40af; }
    .badge-links { background: #fce7f3; color: #9d174d; }
    .badge-images { background: #fef3c7; color: #92400e; }
    .badge-seo_meta { background: #e0e7ff; color: #3730a3; }
    .badge-schema { background: #d1fae5; color: #065f46; }

    .slug-cell { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.75rem; color: #7c3aed; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .msg-cell { max-width: 350px; line-height: 1.4; }
    .empty-state { text-align: center; padding: 3rem; color: #94a3b8; }

    @media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .admin-layout { margin-left: 0; } .main { padding: 1rem; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>Validator</h1>
      <p>Verification technique — Build, frontmatter, liens, images</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate">-</span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <div class="cmd-box">
      <code>claude -p "Valide le site" --agent validator</code>
      <button class="copy-btn" onclick="navigator.clipboard.writeText('claude -p \"Valide le site\" --agent validator');this.textContent='Copie !'">Copier</button>
    </div>

    <div id="buildBanner" class="build-banner build-unknown">En attente du premier run...</div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">Articles verifies</div>
        <div class="value" id="statTotal" style="color:#1e293b">-</div>
        <div class="sub">Derniere validation</div>
      </div>
      <div class="stat-card">
        <div class="label">Erreurs</div>
        <div class="value" id="statErrors" style="color:#dc2626">-</div>
        <div class="sub">Bloquent le deploiement</div>
      </div>
      <div class="stat-card">
        <div class="label">Warnings</div>
        <div class="value" id="statWarnings" style="color:#d97706">-</div>
        <div class="sub">A corriger</div>
      </div>
      <div class="stat-card">
        <div class="label">Score</div>
        <div class="value" id="statScore" style="color:#059669">-</div>
        <div class="sub">Taux de conformite</div>
      </div>
    </div>

    <div class="filters">
      <button class="filter-btn active" data-filter="all" onclick="setFilter('all')">Tous</button>
      <button class="filter-btn" data-filter="error" onclick="setFilter('error')">Erreurs</button>
      <button class="filter-btn" data-filter="warning" onclick="setFilter('warning')">Warnings</button>
      <button class="filter-btn" data-filter="info" onclick="setFilter('info')">Info</button>
    </div>

    <div id="resultsContainer"><div class="empty-state">Aucun resultat — lancez l'agent validator</div></div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allResults = [];
  let currentFilter = 'all';

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  function sevBadge(sev) {
    const cls = { error: 'badge-error', warning: 'badge-warning', info: 'badge-info', pass: 'badge-pass' };
    return `<span class="badge ${cls[sev] || ''}">${esc(sev)}</span>`;
  }

  function typeBadge(type) {
    return `<span class="badge badge-${type}">${esc(type)}</span>`;
  }

  window.setFilter = function(f) {
    currentFilter = f;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === f));
    renderResults();
  };

  function renderResults() {
    const filtered = currentFilter === 'all' ? allResults.filter(r => r.severity !== 'pass') : allResults.filter(r => r.severity === currentFilter);
    const container = document.getElementById('resultsContainer');

    if (filtered.length === 0) {
      container.innerHTML = currentFilter === 'all' && allResults.length > 0
        ? '<div class="empty-state" style="color:#059669">&#x2705; Aucun probleme detecte !</div>'
        : '<div class="empty-state">Aucun resultat pour ce filtre</div>';
      return;
    }

    let html = '<div class="results-table"><table><thead><tr><th>Severite</th><th>Type</th><th>Article</th><th>Message</th></tr></thead><tbody>';
    for (const r of filtered) {
      html += `<tr>
        <td>${sevBadge(r.severity)}</td>
        <td>${typeBadge(r.check_type)}</td>
        <td class="slug-cell" title="${esc(r.article_slug)}">${esc(r.article_slug)}</td>
        <td class="msg-cell">${esc(r.message)}</td>
      </tr>`;
    }
    html += '</tbody></table></div>';
    container.innerHTML = html;
  }

  async function loadAll() {
    try {
      // Get latest run
      const runs = await sbFetch('agent_runs', 'select=*&agent_name=eq.validator&order=started_at.desc&limit=1');
      const run = runs[0];

      if (run) {
        const meta = run.metadata || {};
        const buildOk = meta.build_ok;
        const banner = document.getElementById('buildBanner');
        if (buildOk === true) { banner.className = 'build-banner build-ok'; banner.textContent = '✅ Build OK — le site compile sans erreur'; }
        else if (buildOk === false) { banner.className = 'build-banner build-fail'; banner.textContent = '❌ Build ECHOUE — des erreurs bloquent la compilation'; }

        document.getElementById('statTotal').textContent = meta.articles_checked || run.items_processed || '-';

        // Get results for this run
        const results = await sbFetch('validation_results', `select=*&agent_run_id=eq.${run.id}&order=severity.asc,article_slug.asc`);
        allResults = results;

        const errors = results.filter(r => r.severity === 'error').length;
        const warnings = results.filter(r => r.severity === 'warning').length;
        const total = meta.articles_checked || run.items_processed || 0;
        const score = total > 0 ? Math.round(((total - errors) / total) * 100) : '-';

        document.getElementById('statErrors').textContent = errors;
        document.getElementById('statWarnings').textContent = warnings;
        document.getElementById('statScore').textContent = score !== '-' ? score + '%' : '-';

        // Update filter counts
        const counts = { all: results.filter(r => r.severity !== 'pass').length, error: errors, warning: warnings, info: results.filter(r => r.severity === 'info').length };
        document.querySelectorAll('.filter-btn').forEach(btn => {
          const f = btn.dataset.filter;
          const existing = btn.querySelector('.filter-count');
          if (existing) existing.remove();
          if (counts[f]) btn.insertAdjacentHTML('beforeend', `<span class="filter-count">${counts[f]}</span>`);
        });

        renderResults();
      }

      document.getElementById('lastUpdate').textContent = 'Mis a jour: ' + new Date().toLocaleTimeString('fr-FR');
    } catch (err) {
      document.getElementById('resultsContainer').innerHTML = `<div style="background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:10px;color:#991b1b;font-size:0.85rem"><strong>Erreur:</strong> ${esc(err.message)}</div>`;
    }
  }

  loadAll();
  setInterval(loadAll, 30000);
</script>

</body>
</html>
