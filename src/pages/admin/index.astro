---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - GLP1 France</title>
  <style is:inline>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: #0a0e17;
      color: #c8d6e5;
      min-height: 100vh;
    }

    .admin-layout { margin-left: 260px; min-height: 100vh; }

    /* Header */
    .mc-header {
      background: linear-gradient(180deg, #0f1520 0%, #0a0e17 100%);
      border-bottom: 1px solid #1a2332;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mc-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .mc-title .pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e88;
      animation: pulse-glow 2s infinite;
    }
    .mc-status {
      font-size: 0.72rem;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .mc-clock {
      font-size: 0.85rem;
      color: #64748b;
      font-variant-numeric: tabular-nums;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; box-shadow: 0 0 8px #22c55e88; }
      50% { opacity: 0.5; box-shadow: 0 0 4px #22c55e44; }
    }

    .mc-main { padding: 1.5rem 2rem; }

    /* Agent grid */
    .agents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .agent-card {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 1rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .agent-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: #1e293b;
      transition: background 0.3s;
    }
    .agent-card.running { border-color: #22c55e44; box-shadow: 0 0 20px #22c55e11; }
    .agent-card.running::before { background: #22c55e; animation: scan-line 2s linear infinite; }
    .agent-card.completed::before { background: #3b82f6; }
    .agent-card.error { border-color: #ef444444; }
    .agent-card.error::before { background: #ef4444; }

    @keyframes scan-line {
      0% { background: linear-gradient(90deg, transparent, #22c55e, transparent); background-size: 200%; background-position: -100%; }
      100% { background: linear-gradient(90deg, transparent, #22c55e, transparent); background-size: 200%; background-position: 200%; }
    }

    .agent-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
    }
    .icon-seo { background: #1e3a5f; color: #38bdf8; }
    .icon-analytics { background: #1e3a1e; color: #4ade80; }
    .icon-factcheck { background: #3a2e1e; color: #fbbf24; }
    .icon-opportunities { background: #2e1e3a; color: #c084fc; }
    .icon-editorial { background: #1e2e3a; color: #67e8f9; }
    .icon-validator { background: #1e3a2e; color: #86efac; }
    .icon-links { background: #3a1e2e; color: #f9a8d4; }

    .agent-name {
      font-size: 0.8rem;
      font-weight: 700;
      color: #e2e8f0;
      margin-bottom: 0.5rem;
    }

    .agent-status-line {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.6rem;
    }
    .status-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .si-idle { background: #475569; }
    .si-running { background: #22c55e; animation: pulse-glow 1.5s infinite; }
    .si-completed { background: #3b82f6; }
    .si-error { background: #ef4444; }
    .si-started { background: #eab308; animation: pulse-glow 1.5s infinite; }

    .status-text {
      font-size: 0.68rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .agent-card.running .status-text { color: #4ade80; }
    .agent-card.error .status-text { color: #f87171; }

    .agent-counters {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.35rem;
      margin-bottom: 0.6rem;
    }
    .counter {
      font-size: 0.68rem;
      color: #475569;
    }
    .counter strong {
      color: #94a3b8;
      font-size: 0.85rem;
      display: block;
    }

    .agent-last-action {
      font-size: 0.65rem;
      color: #374151;
      border-top: 1px solid #1e293b;
      padding-top: 0.5rem;
      min-height: 2.5em;
      line-height: 1.3;
    }

    /* Backlog bar for editorial */
    .agent-backlog {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }
    .backlog-chip {
      font-size: 0.6rem;
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .bc-tickets { background: #3a2e1e; color: #fbbf24; }
    .bc-links { background: #3a1e2e; color: #f9a8d4; }
    .bc-opps { background: #2e1e3a; color: #c084fc; }
    .bc-zero { opacity: 0.4; }

    /* Launch button */
    .agent-launch-btn {
      width: 100%;
      padding: 0.4rem 0;
      margin-top: 0.5rem;
      border: 1px solid #22c55e44;
      border-radius: 6px;
      background: #0a1a0f;
      color: #4ade80;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 600;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }
    .agent-launch-btn:hover {
      background: #0f2a17;
      border-color: #22c55e88;
      box-shadow: 0 0 12px #22c55e22;
    }
    .agent-launch-btn:active { transform: scale(0.97); }
    .agent-launch-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      border-color: #1e293b;
      background: #111827;
      color: #475569;
    }
    .agent-launch-btn.is-running {
      border-color: #22c55e44;
      background: #071a0d;
      color: #22c55e;
      cursor: default;
      animation: pulse-btn 2s infinite;
    }
    .agent-launch-btn.is-error {
      border-color: #ef444444;
      background: #1a0a0a;
      color: #f87171;
    }
    .agent-launch-btn.server-off {
      border-color: #eab30844;
      background: #1a1508;
      color: #fbbf24;
      font-size: 0.58rem;
      text-transform: none;
      letter-spacing: 0;
    }
    @keyframes pulse-btn {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }

    /* Pipeline */
    .pipeline-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }
    .pipeline-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid #1e293b;
    }
    .pipeline-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .pipeline-total { font-size: 0.68rem; color: #94a3b8; }

    .pipeline-body {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
      align-items: stretch;
      min-height: 140px;
    }

    /* Phase labels */
    .pipe-phase {
      padding: 0.6rem 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .pipe-phase-label {
      font-size: 0.55rem;
      color: #374151;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
      padding-bottom: 0.3rem;
      border-bottom: 1px solid #1e293b;
      margin-bottom: 0.2rem;
    }

    /* Factory cards (source agents) */
    .factory-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.25rem 0.4rem;
      border-radius: 5px;
      font-size: 0.62rem;
      transition: background 0.2s;
    }
    .factory-item:hover { background: #1a2332; }
    .factory-dot {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      flex-shrink: 0;
    }
    .factory-name { color: #94a3b8; flex: 1; }
    .factory-count {
      font-weight: 700;
      font-size: 0.72rem;
      min-width: 20px;
      text-align: right;
    }
    .factory-item.fc-zero { opacity: 0.3; }

    /* Arrow separator */
    .pipe-arrow {
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1e293b;
      font-size: 1.2rem;
      padding: 0 0.15rem;
    }
    .pipe-arrow svg { width: 20px; height: 60px; }

    /* Center processor (editorial) */
    .pipe-processor {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.75rem;
    }
    .processor-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      font-weight: 700;
    }
    .processor-label {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .processor-total {
      font-size: 1.3rem;
      font-weight: 700;
    }
    .processor-sub {
      font-size: 0.58rem;
      color: #475569;
    }

    /* Status bar at bottom */
    .pipe-status-bar {
      display: flex;
      height: 4px;
      background: #0a0e17;
    }
    .pipe-status-seg {
      height: 100%;
      transition: width 0.5s;
    }

    /* Dep graph */
    .dep-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
    }
    .dep-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .dep-section svg { width: 100%; max-width: 800px; margin: 0 auto; display: block; }

    /* Log feed */
    .log-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
    }
    .log-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid #1e293b;
    }
    .log-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .log-live {
      font-size: 0.65rem;
      color: #22c55e;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .log-live .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-glow 1.5s infinite;
    }

    .log-feed {
      max-height: 320px;
      overflow-y: auto;
      padding: 0.25rem 0;
      scrollbar-width: thin;
      scrollbar-color: #1e293b transparent;
    }
    .log-feed::-webkit-scrollbar { width: 6px; }
    .log-feed::-webkit-scrollbar-track { background: transparent; }
    .log-feed::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

    .log-entry {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.35rem 1.25rem;
      font-size: 0.72rem;
      transition: background 0.1s;
      animation: log-appear 0.3s ease-out;
    }
    .log-entry:hover { background: #1a2332; }

    @keyframes log-appear {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .log-time {
      color: #374151;
      font-variant-numeric: tabular-nums;
      flex-shrink: 0;
      min-width: 62px;
    }
    .log-agent-tag {
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      flex-shrink: 0;
      min-width: 68px;
      text-align: center;
    }
    .tag-seo-audit { background: #1e3a5f; color: #38bdf8; }
    .tag-analytics { background: #1e3a1e; color: #4ade80; }
    .tag-fact-check { background: #3a2e1e; color: #fbbf24; }
    .tag-opportunities { background: #2e1e3a; color: #c084fc; }
    .tag-editorial { background: #1e2e3a; color: #67e8f9; }

    .log-message { color: #94a3b8; flex: 1; }
    .log-status {
      font-size: 0.62rem;
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .ls-success { background: #052e16; color: #4ade80; }
    .ls-error { background: #450a0a; color: #f87171; }

    .log-empty {
      text-align: center;
      padding: 2rem;
      color: #374151;
      font-size: 0.78rem;
    }

    @media (max-width: 1024px) { .admin-layout { margin-left: 0; padding-top: 56px; } }
    @media (max-width: 1200px) { .agents-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px) {
      .mc-main { padding: 1rem; }
      .mc-header { padding: 1rem; flex-direction: column; gap: 0.5rem; }
      .agents-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) { .agents-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="mc-header">
    <div class="mc-title">
      <span class="pulse-dot"></span>
      MISSION CONTROL
    </div>
    <div class="mc-status">GLP-1 France &mdash; Agent Supervision</div>
    <div class="mc-clock" id="clock"></div>
  </div>

  <div class="mc-main">
    <!-- Agent cards -->
    <div class="agents-grid" id="agentsGrid"></div>

    <!-- Pipeline -->
    <div class="pipeline-section" id="pipelineSection">
      <div class="pipeline-header">
        <span class="pipeline-title">Flux de production</span>
        <span class="pipeline-total" id="pipelineTotal"></span>
      </div>
      <div class="pipeline-body" id="pipelineBody"></div>
      <div class="pipe-status-bar" id="pipelineBar"></div>
    </div>

    <!-- Dependency graph -->
    <div class="dep-section">
      <div class="dep-title" style="display:flex;align-items:center;justify-content:space-between">
        <span>Dependances &amp; Pipeline</span>
        <button class="agent-launch-btn" id="pipelineBtn" style="width:auto;padding:0.35rem 1rem;margin:0" onclick="launchPipeline()">&#9654; Lancer Pipeline</button>
      </div>
      <svg viewBox="0 0 820 240" xmlns="http://www.w3.org/2000/svg">
        <!-- Vague 1 label -->
        <text x="70" y="12" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace" text-transform="uppercase">VAGUE 1 — ANALYSE</text>

        <!-- SEO Audit -->
        <rect x="10" y="22" width="120" height="32" rx="6" fill="#111827" stroke="#1e3a5f" stroke-width="1"/>
        <text x="70" y="43" text-anchor="middle" font-size="9" font-weight="600" fill="#38bdf8" font-family="JetBrains Mono, monospace">SEO Audit</text>
        <line x1="130" y1="38" x2="310" y2="115" stroke="#38bdf866" stroke-width="1.5" marker-end="url(#arrowBlue)"/>
        <text x="205" y="70" text-anchor="middle" font-size="7" fill="#38bdf8" font-family="JetBrains Mono, monospace">tickets</text>

        <!-- Analytics -->
        <rect x="10" y="62" width="120" height="32" rx="6" fill="#111827" stroke="#1e3a1e" stroke-width="1"/>
        <text x="70" y="83" text-anchor="middle" font-size="9" font-weight="600" fill="#4ade80" font-family="JetBrains Mono, monospace">Analytics</text>
        <line x1="130" y1="78" x2="310" y2="118" stroke="#4ade8066" stroke-width="1.5" marker-end="url(#arrowGreen2)"/>
        <text x="205" y="93" text-anchor="middle" font-size="7" fill="#4ade80" font-family="JetBrains Mono, monospace">tickets</text>

        <!-- Fact-Check -->
        <rect x="10" y="102" width="120" height="32" rx="6" fill="#111827" stroke="#3a2e1e" stroke-width="1"/>
        <text x="70" y="123" text-anchor="middle" font-size="9" font-weight="600" fill="#fbbf24" font-family="JetBrains Mono, monospace">Fact-Check</text>
        <line x1="130" y1="118" x2="310" y2="122" stroke="#fbbf2466" stroke-width="1.5" marker-end="url(#arrowGold)"/>
        <text x="220" y="113" text-anchor="middle" font-size="7" fill="#fbbf24" font-family="JetBrains Mono, monospace">tickets</text>

        <!-- Opportunities -->
        <rect x="10" y="142" width="120" height="32" rx="6" fill="#111827" stroke="#2e1e3a" stroke-width="1"/>
        <text x="70" y="163" text-anchor="middle" font-size="9" font-weight="600" fill="#c084fc" font-family="JetBrains Mono, monospace">Opportunities</text>
        <line x1="130" y1="158" x2="310" y2="128" stroke="#c084fc66" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
        <text x="205" y="150" text-anchor="middle" font-size="7" fill="#c084fc" font-family="JetBrains Mono, monospace">sujets</text>

        <!-- Int. Links -->
        <rect x="10" y="182" width="120" height="32" rx="6" fill="#111827" stroke="#3a1e2e" stroke-width="1"/>
        <text x="70" y="203" text-anchor="middle" font-size="9" font-weight="600" fill="#f9a8d4" font-family="JetBrains Mono, monospace">Int. Links</text>
        <line x1="130" y1="198" x2="310" y2="132" stroke="#f9a8d466" stroke-width="1.5" marker-end="url(#arrowPink)"/>
        <text x="205" y="175" text-anchor="middle" font-size="7" fill="#f9a8d4" font-family="JetBrains Mono, monospace">maillage</text>

        <!-- Vague 2 label -->
        <text x="370" y="100" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">VAGUE 2</text>

        <!-- Editorial -->
        <rect x="315" y="108" width="110" height="36" rx="6" fill="#111827" stroke="#1e2e3a" stroke-width="1.5"/>
        <text x="370" y="131" text-anchor="middle" font-size="9" font-weight="600" fill="#67e8f9" font-family="JetBrains Mono, monospace">Editorial</text>
        <line x1="425" y1="126" x2="500" y2="126" stroke="#67e8f966" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

        <!-- Vague 3 label -->
        <text x="555" y="100" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">VAGUE 3</text>

        <!-- Validator -->
        <rect x="505" y="108" width="100" height="36" rx="6" fill="#111827" stroke="#1e3a2e" stroke-width="1"/>
        <text x="555" y="131" text-anchor="middle" font-size="9" font-weight="600" fill="#86efac" font-family="JetBrains Mono, monospace">Validator</text>
        <line x1="605" y1="126" x2="660" y2="126" stroke="#86efac66" stroke-width="1.5" marker-end="url(#arrowMint)"/>

        <!-- Git + Deploy -->
        <rect x="665" y="108" width="90" height="36" rx="6" fill="#111827" stroke="#22c55e44" stroke-width="1"/>
        <text x="710" y="124" text-anchor="middle" font-size="8" font-weight="600" fill="#22c55e" font-family="JetBrains Mono, monospace">Git Push</text>
        <text x="710" y="137" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">Deploy</text>

        <!-- Dashboard -->
        <rect x="700" y="22" width="110" height="36" rx="6" fill="#111827" stroke="#22c55e44" stroke-width="1"/>
        <text x="755" y="45" text-anchor="middle" font-size="9" font-weight="600" fill="#22c55e" font-family="JetBrains Mono, monospace">Dashboard</text>
        <line x1="755" y1="108" x2="755" y2="58" stroke="#22c55e44" stroke-width="1" stroke-dasharray="4" marker-end="url(#arrowGreen)"/>

        <defs>
          <marker id="arrowBlue" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#38bdf8"/></marker>
          <marker id="arrowGreen2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#4ade80"/></marker>
          <marker id="arrowGold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#fbbf24"/></marker>
          <marker id="arrowPurple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#c084fc"/></marker>
          <marker id="arrowPink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#f9a8d4"/></marker>
          <marker id="arrowCyan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#67e8f9"/></marker>
          <marker id="arrowMint" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#86efac"/></marker>
          <marker id="arrowGreen" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#22c55e"/></marker>
        </defs>
      </svg>
    </div>

    <!-- Live log feed -->
    <div class="log-section">
      <div class="log-header">
        <span class="log-title">Live Feed</span>
        <span class="log-live"><span class="live-dot"></span> Realtime</span>
      </div>
      <div class="log-feed" id="logFeed">
        <div class="log-empty">En attente de logs...</div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  const AGENTS = [
    { name: 'seo-audit', label: 'SEO Audit', icon: 'seo', desc: 'Crawl, meta, liens' },
    { name: 'analytics', label: 'Analytics', icon: 'analytics', desc: 'Keywords ranking' },
    { name: 'fact-check', label: 'Fact-Check', icon: 'factcheck', desc: 'Verification medicale' },
    { name: 'opportunities', label: 'Opportunities', icon: 'opportunities', desc: 'Tendances, gaps' },
    { name: 'editorial', label: 'Editorial', icon: 'editorial', desc: 'Redaction, corrections' },
    { name: 'validator', label: 'Validator', icon: 'validator', desc: 'Build, frontmatter, liens' },
    { name: 'internal-links', label: 'Maillage', icon: 'links', desc: 'Liens internes SEO' },
  ];

  const TAG_CLASSES = {
    'seo-audit': 'tag-seo-audit',
    'analytics': 'tag-analytics',
    'fact-check': 'tag-fact-check',
    'opportunities': 'tag-opportunities',
    'editorial': 'tag-editorial',
    'validator': 'tag-seo-audit',
    'internal-links': 'tag-analytics',
  };

  function escapeHtml(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return 'jamais';
    const diff = Date.now() - new Date(dateStr).getTime();
    if (diff < 60000) return 'il y a < 1min';
    if (diff < 3600000) return 'il y a ' + Math.floor(diff / 60000) + 'min';
    if (diff < 86400000) return 'il y a ' + Math.floor(diff / 3600000) + 'h';
    return 'il y a ' + Math.floor(diff / 86400000) + 'j';
  }

  function formatDuration(ms) {
    if (!ms) return '';
    if (ms < 60000) return Math.round(ms / 1000) + 's';
    return Math.floor(ms / 60000) + 'min ' + Math.round((ms % 60000) / 1000) + 's';
  }

  function formatTime(dateStr) {
    if (!dateStr) return '--:--';
    return new Date(dateStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  async function supabaseFetch(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function supabaseInsert(table, data) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}`, {
      method: 'POST',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=representation'
      },
      body: JSON.stringify(data)
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function supabasePatch(table, query, data) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      method: 'PATCH',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify(data)
    });
    if (!r.ok) throw new Error(await r.text());
  }

  // Agent Server connection
  // In dev: proxied via Vite (/__agent -> 127.0.0.1:7854)
  // Direct fallback for non-proxied environments
  const AGENT_SERVER = '/__agent';
  let serverOnline = false;
  let runningAgents = {};

  async function checkServer() {
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 2000);
      const r = await fetch(`${AGENT_SERVER}/status`, { signal: ctrl.signal });
      clearTimeout(timer);
      const data = await r.json();
      serverOnline = true;
      runningAgents = data.running || {};
    } catch(e) {
      serverOnline = false;
      runningAgents = {};
    }
  }

  async function launchAgent(name) {
    if (!serverOnline) {
      alert('Agent Server non connecte !\n\nLance dans un terminal :\nnode scripts/agent-server.mjs');
      return;
    }
    if (runningAgents[name]) {
      alert(name + ' est deja en cours.');
      return;
    }

    try {
      const r = await fetch(`${AGENT_SERVER}/launch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name })
      });
      const data = await r.json();
      if (!data.ok) {
        alert('Erreur: ' + data.error);
        return;
      }
      // Refresh immediately
      await checkServer();
      await loadAgents();
    } catch(e) {
      alert('Erreur: ' + e.message);
    }
  }

  async function stopAgent(name) {
    try {
      const r = await fetch(`${AGENT_SERVER}/stop`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name })
      });
      await checkServer();
      await loadAgents();
    } catch(e) {}
  }

  async function launchPipeline() {
    if (!serverOnline) {
      alert('Agent Server non connecte !\n\nLance dans un terminal :\nnode scripts/agent-server.mjs');
      return;
    }
    if (Object.keys(runningAgents).length > 0) {
      alert('Des agents sont deja en cours: ' + Object.keys(runningAgents).join(', '));
      return;
    }
    if (!confirm('Lancer le pipeline complet ?\n\nVague 1 : seo-audit, analytics, fact-check, opportunities, internal-links\n\nLes 5 agents se lancent en parallele.\nEditorial et Validator a lancer ensuite.')) return;

    try {
      const r = await fetch(`${AGENT_SERVER}/pipeline`, { method: 'POST' });
      const data = await r.json();
      if (!data.ok) {
        alert('Erreur: ' + data.error);
        return;
      }
      await checkServer();
      await loadAgents();
    } catch(e) {
      alert('Erreur: ' + e.message);
    }
  }

  // Expose to onclick
  window.launchAgent = launchAgent;
  window.stopAgent = stopAgent;
  window.launchPipeline = launchPipeline;

  // Clock
  function updateClock() {
    document.getElementById('clock').textContent = new Date().toLocaleString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  updateClock();
  setInterval(updateClock, 1000);

  // Editorial backlog
  let editorialBacklog = { tickets: 0, links: 0, opps: 0 };

  async function supabaseFetchCount(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Prefer': 'count=exact',
        'Range-Unit': 'items',
        'Range': '0-0'
      }
    });
    if (!r.ok) return 0;
    const range = r.headers.get('content-range');
    if (range) {
      const total = range.split('/')[1];
      return total === '*' ? 0 : parseInt(total);
    }
    return 0;
  }

  async function loadEditorialBacklogCounts() {
    try {
      const [tickets, links, opps] = await Promise.all([
        supabaseFetchCount('correction_tickets', 'statut=eq.approved'),
        supabaseFetchCount('internal_link_suggestions', 'status=eq.approved'),
        supabaseFetchCount('content_opportunities', 'status=eq.approved'),
      ]);
      editorialBacklog = { tickets, links, opps };
    } catch(e) {}
  }

  // Pipeline data
  let pipelineData = { tickets: [], links: [], opps: [] };

  async function loadPipelineData() {
    try {
      const [tickets, links, opps] = await Promise.all([
        supabaseFetch('correction_tickets', 'select=source_agent,statut,ticket_type,created_at&order=created_at.desc'),
        supabaseFetch('internal_link_suggestions', 'select=status,priority,created_at&order=created_at.desc'),
        supabaseFetch('content_opportunities', 'select=status,priority,created_at&order=created_at.desc'),
      ]);
      pipelineData = { tickets, links, opps };
      renderPipeline();
    } catch(e) {}
  }

  function renderPipeline() {
    const { tickets, links, opps } = pipelineData;

    // Stats
    const tByStatus = { approved: 0, in_progress: 0, ready_to_deploy: 0, deployed: 0 };
    const tBySource = {};
    for (const t of tickets) {
      const s = t.statut || 'approved';
      if (tByStatus[s] !== undefined) tByStatus[s]++;
      const src = t.source_agent || 'fact-check';
      if (!tBySource[src]) tBySource[src] = { total: 0, approved: 0 };
      tBySource[src].total++;
      if (s === 'approved') tBySource[src].approved++;
    }

    const lApproved = links.filter(l => l.status === 'approved').length;
    const oApproved = opps.filter(o => o.status === 'approved').length;
    const totalPending = tByStatus.approved + lApproved + oApproved;
    const totalAll = tickets.length + links.length + opps.length;

    document.getElementById('pipelineTotal').textContent = totalPending > 0
      ? totalPending + ' en attente editorial'
      : 'Rien a traiter';

    // Factory configs
    const factories = [
      { key: 'fact-check', label: 'Fact-Check', color: '#fbbf24', icon: '&#9888;' },
      { key: 'seo-audit', label: 'SEO Audit', color: '#38bdf8', icon: '&#128269;' },
      { key: 'validator', label: 'Validator', color: '#86efac', icon: '&#9989;' },
      { key: 'analytics', label: 'Analytics', color: '#4ade80', icon: '&#128200;' },
      { key: 'internal-links', label: 'Maillage', color: '#f9a8d4', icon: '&#128279;', count: lApproved, total: links.length },
      { key: 'opportunities', label: 'Nouveaux articles', color: '#c084fc', icon: '&#128161;', count: oApproved, total: opps.length },
    ];

    const arrowSvg = `<div class="pipe-arrow"><svg viewBox="0 0 20 60"><path d="M2 30 L14 30 M10 24 L16 30 L10 36" stroke="#2a3444" stroke-width="2" fill="none" stroke-linecap="round"/></svg></div>`;

    // Build factory items
    const factoryHtml = factories.map(f => {
      const src = tBySource[f.key];
      const approved = f.count !== undefined ? f.count : (src ? src.approved : 0);
      const total = f.total !== undefined ? f.total : (src ? src.total : 0);
      const isEmpty = total === 0;
      return `<div class="factory-item ${isEmpty ? 'fc-zero' : ''}">
        <span class="factory-dot" style="background:${f.color}"></span>
        <span class="factory-name">${f.label}</span>
        <span class="factory-count" style="color:${approved > 0 ? f.color : '#374151'}">${approved}</span>
      </div>`;
    }).join('');

    // Editorial intake
    const editorialTotal = totalPending;

    // Validator & Deploy
    const readyCount = tByStatus.ready_to_deploy;
    const deployedCount = tByStatus.deployed;

    const body = document.getElementById('pipelineBody');
    body.innerHTML = `
      <div class="pipe-phase">
        <div class="pipe-phase-label">&#127981; Production</div>
        ${factoryHtml}
      </div>

      ${arrowSvg}

      <div class="pipe-phase" style="justify-content:center;align-items:center;background:#67e8f908;border-left:2px solid #67e8f922;border-right:2px solid #67e8f922">
        <div class="pipe-phase-label" style="text-align:center;border-color:#67e8f933;color:#67e8f9">&#9998; Traitement</div>
        <div class="processor-icon" style="background:#1e2e3a;color:#67e8f9">E</div>
        <div class="processor-label" style="color:#67e8f9">Editorial</div>
        <div class="processor-total" style="color:${editorialTotal > 0 ? '#fbbf24' : '#22c55e'}">${editorialTotal}</div>
        <div class="processor-sub">${editorialTotal > 0 ? 'a traiter' : 'tout traite'}</div>
      </div>

      ${arrowSvg}

      <div class="pipe-phase" style="justify-content:center;align-items:center;background:#86efac08;border-left:2px solid #86efac22;border-right:2px solid #86efac22">
        <div class="pipe-phase-label" style="text-align:center;border-color:#86efac33;color:#86efac">&#128270; Verification</div>
        <div class="processor-icon" style="background:#1e3a2e;color:#86efac">V</div>
        <div class="processor-label" style="color:#86efac">Validator</div>
        <div class="processor-total" style="color:#3b82f6">${readyCount}</div>
        <div class="processor-sub">prets a deployer</div>
      </div>

      ${arrowSvg}

      <div class="pipe-phase" style="justify-content:center;align-items:center;background:#22c55e08">
        <div class="pipe-phase-label" style="text-align:center;border-color:#22c55e33;color:#22c55e">&#128640; Deploy</div>
        <div class="processor-icon" style="background:#052e16;color:#22c55e">&#10003;</div>
        <div class="processor-total" style="color:#22c55e">${deployedCount}</div>
        <div class="processor-sub">deployes</div>
      </div>
    `;

    // Status bar
    const bar = document.getElementById('pipelineBar');
    if (totalAll > 0) {
      const pctPending = (totalPending / totalAll * 100).toFixed(1);
      const pctReady = (readyCount / totalAll * 100).toFixed(1);
      const pctDeployed = (deployedCount / totalAll * 100).toFixed(1);
      const pctOther = (100 - parseFloat(pctPending) - parseFloat(pctReady) - parseFloat(pctDeployed)).toFixed(1);
      bar.innerHTML = `
        <div class="pipe-status-seg" style="width:${pctPending}%;background:#fbbf24" title="En attente"></div>
        <div class="pipe-status-seg" style="width:${pctOther}%;background:#3b82f6" title="En cours"></div>
        <div class="pipe-status-seg" style="width:${pctReady}%;background:#67e8f9" title="Prets"></div>
        <div class="pipe-status-seg" style="width:${pctDeployed}%;background:#22c55e" title="Deployes"></div>
      `;
    }
  }

  // Agent cards
  async function loadAgents() {
    try {
      const runs = await supabaseFetch('agent_runs', 'select=*&order=started_at.desc&limit=50');
      const latest = {};
      for (const r of runs) {
        if (!latest[r.agent_name]) latest[r.agent_name] = r;
      }

      const grid = document.getElementById('agentsGrid');
      grid.innerHTML = AGENTS.map(a => {
        const run = latest[a.name];
        const status = run ? run.status : 'idle';
        const statusLabel = { completed: 'termine', running: 'en cours', started: 'demarre', error: 'erreur', idle: 'inactif' }[status] || status;
        const meta = run?.metadata || {};
        const items = run?.items_processed ?? '-';

        // Smart counters per agent using metadata
        let counter2Label = 'erreurs';
        let counter2Value = run?.items_errors ?? '-';
        if (a.name === 'seo-audit' && meta.critical !== undefined) {
          counter2Value = meta.critical || 0;
          counter2Label = 'critiques';
        } else if (a.name === 'fact-check' && meta.tickets_created !== undefined) {
          counter2Value = meta.tickets_created;
          counter2Label = 'tickets';
        } else if (a.name === 'analytics' && meta.positioned_keywords !== undefined) {
          counter2Value = meta.positioned_keywords;
          counter2Label = 'positionnes';
        } else if (a.name === 'opportunities' && meta.high_priority !== undefined) {
          counter2Value = meta.high_priority;
          counter2Label = 'prioritaires';
        } else if (a.name === 'editorial') {
          counter2Value = (meta.tickets_corrected || 0) + (meta.links_inserted || 0);
          counter2Label = 'corriges';
        } else if (a.name === 'validator' && meta.errors !== undefined) {
          counter2Value = meta.errors;
          counter2Label = 'erreurs';
        } else if (a.name === 'internal-links' && meta.suggestions_new !== undefined) {
          counter2Value = meta.suggestions_new;
          counter2Label = 'suggestions';
        }

        const duration = run?.duration_ms ? formatDuration(run.duration_ms)
          : (run?.started_at && run?.completed_at)
            ? formatDuration(new Date(run.completed_at) - new Date(run.started_at))
            : '';
        const lastTime = run?.completed_at
          ? timeAgo(run.completed_at)
          : run?.started_at
            ? timeAgo(run.started_at)
            : 'jamais lance';

        // Launch button state
        const isRunningOnServer = !!runningAgents[a.name];
        let btnClass = 'agent-launch-btn';
        let btnLabel = '&#9654; Lancer';
        let btnAction = `launchAgent('${a.name}')`;
        let btnDisabled = '';
        if (!serverOnline) {
          btnClass += ' server-off';
          btnLabel = '&#9888; node scripts/agent-server.mjs';
          btnAction = `alert('Lance d\\'abord le serveur :\\nnode scripts/agent-server.mjs')`;
        } else if (isRunningOnServer) {
          btnClass += ' is-running';
          const uptime = runningAgents[a.name]?.uptime || '';
          btnLabel = '&#9881; En cours... ' + uptime + ' <span style="margin-left:auto;font-size:0.55rem;opacity:0.7;cursor:pointer" onclick="event.stopPropagation();stopAgent(\''+a.name+'\')">&#9724; Stop</span>';
        }

        // Backlog chips — editorial gets full breakdown, others show their output
        let backlogHtml = '';
        const pt = pipelineData.tickets || [];

        // Source agents show how many tickets they've created
        if (['seo-audit', 'fact-check', 'validator', 'analytics'].includes(a.name)) {
          const myTickets = pt.filter(t => (t.source_agent || 'fact-check') === a.name);
          const myApproved = myTickets.filter(t => t.statut === 'approved').length;
          const myDone = myTickets.length - myApproved;
          if (myTickets.length > 0) {
            backlogHtml = `<div class="agent-backlog">
              <span class="backlog-chip bc-tickets">${myApproved} en attente</span>
              <span class="backlog-chip bc-links ${myDone === 0 ? 'bc-zero' : ''}">${myDone} traites</span>
            </div>`;
          }
        }

        // Internal-links shows its suggestions
        if (a.name === 'internal-links') {
          const pl = pipelineData.links || [];
          const lAppr = pl.filter(l => l.status === 'approved').length;
          const lDone = pl.length - lAppr;
          if (pl.length > 0) {
            backlogHtml = `<div class="agent-backlog">
              <span class="backlog-chip bc-links">${lAppr} en attente</span>
              <span class="backlog-chip bc-opps ${lDone === 0 ? 'bc-zero' : ''}">${lDone} inseres</span>
            </div>`;
          }
        }

        // Opportunities shows its opportunities
        if (a.name === 'opportunities') {
          const po = pipelineData.opps || [];
          const oAppr = po.filter(o => o.status === 'approved').length;
          const oDone = po.length - oAppr;
          if (po.length > 0) {
            backlogHtml = `<div class="agent-backlog">
              <span class="backlog-chip bc-opps">${oAppr} a creer</span>
              <span class="backlog-chip bc-links ${oDone === 0 ? 'bc-zero' : ''}">${oDone} publies</span>
            </div>`;
          }
        }

        if (a.name === 'editorial') {
          const bl = editorialBacklog;
          const total = bl.tickets + bl.links + bl.opps;
          backlogHtml = `<div class="agent-backlog">
            <span class="backlog-chip bc-tickets ${bl.tickets === 0 ? 'bc-zero' : ''}">${bl.tickets} tickets</span>
            <span class="backlog-chip bc-links ${bl.links === 0 ? 'bc-zero' : ''}">${bl.links} liens</span>
            <span class="backlog-chip bc-opps ${bl.opps === 0 ? 'bc-zero' : ''}">${bl.opps} sujets</span>
          </div>`;
        }

        return `<div class="agent-card ${status}">
          <div class="agent-icon icon-${a.icon}">${a.label[0]}</div>
          <div class="agent-name">${a.label}</div>
          <div class="agent-status-line">
            <span class="status-indicator si-${status}"></span>
            <span class="status-text">${statusLabel.toUpperCase()}</span>
          </div>
          <div class="agent-counters">
            <div class="counter"><strong>${items}</strong>traites</div>
            <div class="counter"><strong>${counter2Value}</strong>${counter2Label}</div>
          </div>
          ${backlogHtml}
          <div class="agent-last-action">${lastTime}${duration ? ' · ' + duration : ''}</div>
          <button class="${btnClass}" onclick="${btnAction}" ${btnDisabled}>${btnLabel}</button>
        </div>`;
      }).join('');
    } catch (e) {
      document.getElementById('agentsGrid').innerHTML = `<div style="grid-column:1/-1;color:#f87171;padding:1rem;font-size:0.8rem">Erreur: ${escapeHtml(e.message)}</div>`;
    }
  }

  // Log feed
  let lastLogId = null;

  async function loadLogs(append) {
    try {
      let query = 'select=*&order=created_at.desc&limit=50';
      const logs = await supabaseFetch('agent_logs', query);

      const feed = document.getElementById('logFeed');
      if (logs.length === 0) {
        if (!append) feed.innerHTML = '<div class="log-empty">En attente de logs...</div>';
        return;
      }

      if (append && lastLogId === logs[0].id) return; // no new logs
      lastLogId = logs[0].id;

      feed.innerHTML = logs.map(log => {
        const meta = log.metadata || {};
        const details = meta.action || meta.tickets_created !== undefined
          ? `${meta.action || ''} ${meta.tickets_created ? meta.tickets_created + ' tickets' : ''} ${meta.score ? 'score:' + meta.score : ''}`.trim()
          : '';
        const tagClass = TAG_CLASSES[log.agent_type] || 'tag-seo-audit';
        const statusClass = log.status === 'success' ? 'ls-success' : 'ls-error';

        return `<div class="log-entry">
          <span class="log-time">${formatTime(log.created_at)}</span>
          <span class="log-agent-tag ${tagClass}">${escapeHtml(log.agent_type)}</span>
          <span class="log-message">${escapeHtml(details || '-')}</span>
          <span class="log-status ${statusClass}">${escapeHtml(log.status)}</span>
        </div>`;
      }).join('');
    } catch (e) {
      // silent fail on polling
    }
  }

  // Realtime via Supabase
  function setupRealtime() {
    // Use Supabase Realtime WebSocket for live updates
    const wsUrl = SUPABASE_URL.replace('https://', 'wss://') + '/realtime/v1/websocket?apikey=' + SUPABASE_ANON_KEY + '&vsn=1.0.0';
    let ws;

    function connect() {
      ws = new WebSocket(wsUrl);

      ws.onopen = () => {
        // Join agent_runs channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_runs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_runs' }] } },
          ref: '1'
        }));
        // Join agent_logs channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_logs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_logs' }] } },
          ref: '2'
        }));
        // Heartbeat
        setInterval(() => {
          if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ topic: 'phoenix', event: 'heartbeat', payload: {}, ref: 'hb' }));
          }
        }, 30000);
      };

      ws.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.event === 'postgres_changes') {
            loadAgents();
            loadLogs(true);
            loadQueue();
          }
        } catch(e) {}
      };

      ws.onclose = () => {
        // Reconnect after 3s
        setTimeout(connect, 3000);
      };

      ws.onerror = () => ws.close();
    }

    connect();
  }

  // Polling every 5s for reliable updates
  setInterval(() => {
    checkServer().then(() => loadAgents());
    loadLogs(true);
  }, 5000);

  // Refresh editorial backlog + pipeline every 30s
  setInterval(() => {
    Promise.all([loadEditorialBacklogCounts(), loadPipelineData()]).then(() => loadAgents());
  }, 30000);

  // Init
  Promise.all([checkServer(), loadEditorialBacklogCounts(), loadPipelineData()]).then(() => {
    loadAgents();
    loadLogs(false);
  });
  setupRealtime();
</script>

