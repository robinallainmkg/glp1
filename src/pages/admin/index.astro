<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  // Agent definitions with colors
  const ARENA_AGENTS = [
    { key: 'fact-check', label: 'Fact-Check', color: '#fbbf24', icon: '&#10003;', desc: 'Verification medicale' },
    { key: 'seo-audit', label: 'SEO Audit', color: '#38bdf8', icon: '&#128269;', desc: 'Crawl, meta, liens' },
    { key: 'analytics', label: 'Analytics', color: '#4ade80', icon: '&#128202;', desc: 'Keywords ranking' },
    { key: 'opportunities', label: 'Opportunites', color: '#c084fc', icon: '&#128161;', desc: 'Gaps, tendances' },
    { key: 'internal-links', label: 'Maillage', color: '#f9a8d4', icon: '&#128279;', desc: 'Liens internes' },
    { key: 'editorial', label: 'Editorial', color: '#67e8f9', icon: '&#9997;', desc: 'Redaction, corrections' },
    { key: 'validator', label: 'Validator', color: '#86efac', icon: '&#128737;', desc: 'Build, qualite' },
    { key: 'ui-designer', label: 'UI Designer', color: '#ec4899', icon: '&#127912;', desc: 'Design, UX' },
  ];

  function escapeHtml(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return 'jamais';
    const diff = Date.now() - new Date(dateStr).getTime();
    if (diff < 60000) return '< 1min';
    if (diff < 3600000) return Math.floor(diff / 60000) + 'min';
    if (diff < 86400000) return Math.floor(diff / 3600000) + 'h';
    return Math.floor(diff / 86400000) + 'j';
  }

  function formatDuration(ms) {
    if (!ms) return '';
    if (ms < 60000) return Math.round(ms / 1000) + 's';
    return Math.floor(ms / 60000) + 'min ' + Math.round((ms % 60000) / 1000) + 's';
  }

  function formatTime(dateStr) {
    if (!dateStr) return '--:--';
    return new Date(dateStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  function formatDate(dateStr) {
    if (!dateStr) return '--';
    return new Date(dateStr).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' });
  }

  // ========== SUPABASE ==========
  async function supabaseFetch(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function supabaseFetchCount(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Prefer': 'count=exact',
        'Range-Unit': 'items',
        'Range': '0-0'
      }
    });
    if (!r.ok) return 0;
    const range = r.headers.get('content-range');
    if (range) {
      const total = range.split('/')[1];
      return total === '*' ? 0 : parseInt(total);
    }
    return 0;
  }

  // ========== AGENT SERVER ==========
  const AGENT_SERVER = '/__agent';
  let serverOnline = false;
  let runningAgents = {};
  let serverStatus = null;

  async function checkServer() {
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 2000);
      const r = await fetch(`${AGENT_SERVER}/status`, { signal: ctrl.signal });
      clearTimeout(timer);
      const data = await r.json();
      serverOnline = true;
      serverStatus = data;
      runningAgents = data.running || {};
      window._serverBuffers = data.buffers || {};
      window._serverCosts = data.costs || {};
      window._serverTotalCost = data.totalCost || 0;
      renderConsoleTabs();
    } catch(e) {
      serverOnline = false;
      runningAgents = {};
    }
    document.getElementById('serverWarning').style.display = serverOnline ? 'none' : 'block';
  }

  async function launchAgent(name) {
    if (!serverOnline) {
      alert('Agent Server non connecte !\n\nLance: node scripts/agent-server.mjs');
      return;
    }
    if (runningAgents[name]) return;
    try {
      const r = await fetch(`${AGENT_SERVER}/launch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name })
      });
      const data = await r.json();
      if (!data.ok) { alert('Erreur: ' + data.error); return; }
      await checkServer();
      await loadAgentRuns();
      renderArena();
    } catch(e) { alert('Erreur: ' + e.message); }
  }

  async function stopAgent(name) {
    try {
      await fetch(`${AGENT_SERVER}/stop`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name })
      });
      await checkServer();
      await loadAgentRuns();
      renderArena();
    } catch(e) {}
  }

  // ========== ROUTINE PIPELINE ==========
  let routineRunning = false;
  let autopilotRunning = false;

  async function launchRoutine() {
    if (routineRunning) { alert('Pipeline deja en cours...'); return; }
    if (!serverOnline) { alert('Agent Server non connecte !\n\nLance: node scripts/agent-server.mjs'); return; }
    try {
      const r = await fetch(`${AGENT_SERVER}/pipeline`, { method: 'POST' });
      const data = await r.json();
      if (!data.ok) { alert('Erreur: ' + (data.error || 'inconnue')); return; }
      routineRunning = true;
      autopilotRunning = true;
      updateAutopilotUI();
    } catch(e) {
      alert('Erreur connexion agent-server: ' + e.message);
    }
  }

  function showRoutineInfo() {
    alert(
      'ROUTINE GLP-1 — Pipeline complet en 5 phases\n\n' +
      '0. SYNC : Sync analytics GA4/GSC vers Supabase\n\n' +
      '1. GENERATE : Lance fact-check + seo-audit + opportunities + internal-links\n' +
      '   -> Cree des tickets de correction dans Supabase\n\n' +
      '2. EDIT : Lance 4 instances editorial en parallele\n' +
      '   -> Applique les corrections dans les fichiers markdown\n\n' +
      '3. VALIDATE : Lance le validator\n' +
      '   -> Build check, si OK push main -> deploy FTP auto\n\n' +
      '4. CRAWL : Verification post-deploy du site live\n\n' +
      'Equivalent : node scripts/agent-server.mjs + curl POST /pipeline'
    );
  }

  const PHASE_ORDER = ['sync', 'generate', 'edit', 'validate', 'crawl'];

  function updateAutopilotUI() {
    const hero = document.getElementById('autopilotHero');
    const btn = document.getElementById('apBigBtn');
    const label = document.getElementById('apBtnLabel');
    const badge = document.getElementById('apBadge');

    // Try server pipeline status first
    let serverPipelineHandled = false;
    fetch(`${AGENT_SERVER}/pipeline/status`).then(r => r.json()).then(ps => {
      serverPipelineHandled = true;
      routineRunning = ps.running;
      autopilotRunning = ps.running;
      if (ps.running) {
        hero.classList.add('is-running');
        btn.classList.add('running');
        btn.innerHTML = '&#9632;';
        label.textContent = 'En cours...';
        badge.className = 'ap-status-badge running';
        const phaseLabels = { sync: 'SYNC', generate: 'GENERATE', edit: 'EDIT', validate: 'VALIDATE', crawl: 'CRAWL', done: 'DONE', error: 'ERREUR' };
        badge.textContent = phaseLabels[ps.phase] || ps.phase?.toUpperCase() || 'RUNNING';
        updatePhaseIndicators(ps.phase, 'running');
      } else {
        hero.classList.remove('is-running');
        btn.classList.remove('running');
        btn.innerHTML = '&#9654;';
        label.textContent = 'Lancer Pipeline';
        if (ps.phase === 'done') {
          badge.className = 'ap-status-badge done';
          badge.textContent = 'TERMINE';
          updatePhaseIndicators('done', 'completed');
        } else if (ps.phase === 'error') {
          badge.className = 'ap-status-badge error';
          badge.textContent = 'ERREUR';
          updatePhaseIndicators(ps.errorPhase || ps.phase, 'error');
        } else {
          badge.className = 'ap-status-badge idle';
          badge.textContent = 'IDLE';
          // Use Supabase data for last pipeline run
          updatePipelineFromSupabase();
        }
      }
    }).catch(() => {
      // Server offline — use Supabase history
      hero.classList.remove('is-running');
      btn.classList.remove('running');
      btn.innerHTML = '&#9654;';
      label.textContent = 'Lancer Pipeline';
      updatePipelineFromSupabase();
    });

    // Active agents count
    const activeCount = Object.keys(runningAgents).filter(k => k !== 'autopilot').length;
    document.getElementById('apAgentsActive').textContent = activeCount;

    // Token budget estimation
    updateTokenBudget();
  }

  function updatePipelineFromSupabase() {
    const badge = document.getElementById('apBadge');
    // Check last pipeline/autopilot run from agentRuns
    const pipelineRun = agentRuns['autopilot'] || agentRuns['pipeline'];
    if (pipelineRun) {
      const status = pipelineRun.status;
      if (status === 'completed') {
        badge.className = 'ap-status-badge done';
        badge.textContent = 'TERMINE';
        updatePhaseIndicators('done', 'completed');
      } else if (status === 'error' || status === 'failed') {
        badge.className = 'ap-status-badge error';
        badge.textContent = 'ERREUR';
      } else {
        badge.className = 'ap-status-badge idle';
        badge.textContent = 'IDLE';
      }
    } else {
      badge.className = 'ap-status-badge idle';
      badge.textContent = 'IDLE';
    }
  }

  function updatePhaseIndicators(currentPhase, state) {
    const phases = document.querySelectorAll('.ap-phase');
    const phaseIdx = PHASE_ORDER.indexOf(currentPhase);

    phases.forEach(el => {
      const phase = el.dataset.phase;
      const idx = PHASE_ORDER.indexOf(phase);
      el.className = 'ap-phase';

      if (state === 'completed' || currentPhase === 'done') {
        el.classList.add('completed');
      } else if (state === 'error' && phase === currentPhase) {
        el.classList.add('error');
      } else if (state === 'running') {
        if (idx < phaseIdx) el.classList.add('completed');
        else if (idx === phaseIdx) el.classList.add('active');
      }
    });
  }

  function updateTokenBudget() {
    const TOKEN_RATE_PER_MIN = {
      'editorial': 8000, 'validator': 6000, 'fact-check': 10000,
      'seo-audit': 5000, 'analytics': 4000, 'opportunities': 5000,
      'internal-links': 4000, 'ui-designer': 7000, 'strategist': 3000,
      'sav-email': 5000, 'autopilot': 2000,
    };
    const ROLLING_WINDOW_H = 5;
    const MAX_TOKENS = 5000000;
    const windowMs = ROLLING_WINDOW_H * 3600000;
    const now = Date.now();

    const runTokens = Object.values(agentRuns).map(r => {
      const startT = new Date(r.started_at).getTime();
      const endT = r.completed_at ? new Date(r.completed_at).getTime() : now;
      const durationMin = Math.min(30, (endT - startT) / 60000);
      const rate = TOKEN_RATE_PER_MIN[r.agent_name] || 5000;
      const tokens = Math.round(rate * durationMin);
      const age = now - endT;
      return { tokens, age, startT, endT, agent: r.agent_name };
    });

    const inWindow = runTokens.filter(r => r.age < windowMs);
    const estimatedTokens = inWindow.reduce((s, r) => s + r.tokens, 0);
    const recoveringSoon = inWindow.filter(r => r.age > (windowMs - 3600000));
    const recoveryPerHour = recoveringSoon.reduce((s, r) => s + r.tokens, 0);

    const budgetFill = document.getElementById('apBudgetFill');
    const budgetVal = document.getElementById('apBudgetVal');
    if (!budgetFill || !budgetVal) return;

    const tokenPct = Math.min(100, Math.round(estimatedTokens / MAX_TOKENS * 100));
    const tokenDisplay = estimatedTokens > 1000000
      ? (estimatedTokens / 1000000).toFixed(1) + 'M'
      : Math.round(estimatedTokens / 1000) + 'k';
    const recoveryDisplay = recoveryPerHour > 1000
      ? Math.round(recoveryPerHour / 1000) + 'k'
      : recoveryPerHour.toString();
    budgetFill.style.width = tokenPct + '%';
    budgetFill.style.background = tokenPct > 80 ? '#f87171' : tokenPct > 50 ? '#fbbf24' : '#3b82f6';
    budgetVal.innerHTML = `~${tokenDisplay} / 5M &middot; ${inWindow.length} runs &middot; <span style="color:#4ade80">${recoveryDisplay} recup/h</span>`;

    const budgetLabel = document.querySelector('.ap-budget-label');
    if (budgetLabel) {
      budgetLabel.textContent = tokenPct >= 80 ? 'TOKENS (ralentir)' : 'TOKENS';
      budgetLabel.style.color = tokenPct > 80 ? '#f87171' : tokenPct > 50 ? '#fbbf24' : '#475569';
    }
  }

  // ========== CHARACTER HTML BUILDER ==========
  function buildCharacter(state, color, index) {
    const delayClass = 'd' + ((index % 4) + 1);
    const style = `--agent-color:${color}`;

    if (state === 'sleeping') {
      return `<div class="char sleeping" style="${style}">
        <span class="zzz">z</span><span class="zzz">z</span><span class="zzz">z</span>
        <div class="char-head"></div>
        <div class="char-body">
          <div class="char-arms">
            <div class="char-arm left"></div>
            <div class="char-arm right"></div>
          </div>
        </div>
        <div class="char-legs">
          <div class="char-leg left"></div>
          <div class="char-leg right"></div>
        </div>
      </div>`;
    }

    if (state === 'dancing') {
      return `<div class="char dancing ${delayClass}" style="${style}">
        <div class="char-head"></div>
        <div class="char-body">
          <div class="char-arms">
            <div class="char-arm left"></div>
            <div class="char-arm right"></div>
          </div>
        </div>
        <div class="char-legs">
          <div class="char-leg left"></div>
          <div class="char-leg right"></div>
        </div>
      </div>`;
    }

    // idle
    return `<div class="char idle" style="${style}">
      <div class="char-head"></div>
      <div class="char-body">
        <div class="char-arms">
          <div class="char-arm left"></div>
          <div class="char-arm right"></div>
        </div>
      </div>
      <div class="char-legs">
        <div class="char-leg left"></div>
        <div class="char-leg right"></div>
      </div>
    </div>`;
  }

  // ========== ARENA RENDERING ==========
  let arenaPendingCounts = {};

  function renderArena() {
    const grid = document.getElementById('arenaGrid');
    if (!grid) return;
    grid.innerHTML = ARENA_AGENTS.map(agent => {
      const run = agentRuns[agent.key];
      const hasRun = !!run;
      const pending = arenaPendingCounts[agent.key] || 0;

      // Count running instances
      let activeInstances = 0;
      const instanceNames = [];
      for (const k of Object.keys(runningAgents)) {
        if (k === agent.key || k.startsWith(agent.key + '-')) {
          activeInstances++;
          instanceNames.push(k);
        }
      }

      // Determine character states
      let characters = '';
      if (activeInstances > 0) {
        for (let i = 0; i < activeInstances; i++) {
          characters += buildCharacter('dancing', agent.color, i);
        }
        if (pending > 10 && activeInstances < 3) {
          characters += buildCharacter('sleeping', agent.color, activeInstances);
        }
      } else if (hasRun) {
        characters += buildCharacter('idle', agent.color, 0);
      } else {
        characters += buildCharacter('sleeping', agent.color, 0);
      }

      // Cost from server
      const cost = window._serverCosts?.[agent.key] || 0;
      const costHtml = cost > 0 ? `<span style="font-size:0.45rem;color:#475569">$${cost.toFixed(2)}</span>` : '';

      // Pending badge
      let pendingHtml = '';
      if (pending > 0) {
        pendingHtml = `<span class="pending-badge" style="background:${agent.color}22;color:${agent.color}">${pending} en attente</span>`;
      }

      // Meta left: last run info from Supabase
      let metaLeft = '';
      if (activeInstances > 0) {
        const uptime = runningAgents[agent.key]?.uptime || '';
        metaLeft = uptime || 'en cours...';
      } else if (hasRun) {
        metaLeft = timeAgo(run.completed_at || run.started_at);
      } else {
        metaLeft = 'jamais lance';
      }

      // Run result summary from metadata
      let resultHtml = '';
      if (hasRun && run.metadata && activeInstances === 0) {
        const m = run.metadata;
        const parts = [];
        if (m.items_processed) parts.push(`${m.items_processed} traites`);
        if (m.tickets_created) parts.push(`${m.tickets_created} tickets`);
        if (m.links_suggested) parts.push(`${m.links_suggested} liens`);
        if (m.articles_checked) parts.push(`${m.articles_checked} articles`);
        if (m.corrections_applied) parts.push(`${m.corrections_applied} corrections`);
        if (m.errors && m.errors > 0) parts.push(`<span style="color:#f87171">${m.errors} erreurs</span>`);
        if (run.status === 'error' || run.status === 'failed') {
          parts.push(`<span style="color:#f87171">ECHEC</span>`);
        }
        if (parts.length > 0) {
          resultHtml = `<div class="arena-run-result">${parts.join(' &middot; ')}</div>`;
        }
      }

      const countBadge = activeInstances > 0
        ? `<span class="arena-cell-count active" style="--agent-color:${agent.color}">x${activeInstances}</span>`
        : `<span class="arena-cell-count zero">x0</span>`;

      // Action buttons
      let btns = '';
      if (serverOnline) {
        if (activeInstances === 0) {
          btns = `<button class="arena-btn arena-btn-go" onclick="event.stopPropagation();launchAgent('${agent.key}')" title="Lancer">+</button>`;
        } else {
          btns = `<button class="arena-btn arena-btn-console" onclick="event.stopPropagation();selectConsoleAgent('${instanceNames[0]}')" title="Console">&#128187;</button>`
            + `<button class="arena-btn arena-btn-spawn" onclick="event.stopPropagation();launchAgentMulti('${agent.key}')" title="Spawner +1">+1</button>`
            + `<button class="arena-btn arena-btn-stop" onclick="event.stopPropagation();stopAllInstances('${agent.key}')" title="Stopper tout">&#9632;</button>`;
        }
      }

      return `<div class="arena-cell ${activeInstances > 0 ? 'has-active' : ''}" style="--agent-color:${agent.color}" onclick="selectConsoleAgent('${instanceNames[0] || agent.key}')">
        <div class="arena-cell-header">
          <span class="arena-cell-name">${agent.label}</span>
          ${costHtml}
          ${countBadge}
        </div>
        <div class="arena-stage">${characters}</div>
        <div class="arena-cell-actions">${btns}</div>
        <div class="arena-cell-meta">
          <span>${metaLeft}</span>
          ${pendingHtml}
        </div>
        ${resultHtml}
      </div>`;
    }).join('');
  }

  async function launchAgentMulti(name) {
    if (!serverOnline) return;
    try {
      const r = await fetch(`${AGENT_SERVER}/launch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name, allowMultiple: true })
      });
      const data = await r.json();
      if (!data.ok) { alert('Erreur: ' + data.error); return; }
      await checkServer();
      await loadAgentRuns();
      renderArena();
    } catch(e) { alert('Erreur: ' + e.message); }
  }

  async function stopAllInstances(baseKey) {
    for (const k of Object.keys(runningAgents)) {
      if (k === baseKey || k.startsWith(baseKey + '-')) {
        await stopAgent(k);
      }
    }
    renderArena();
  }

  window.launchAgent = launchAgent;
  window.stopAgent = stopAgent;
  window.launchAgentMulti = launchAgentMulti;
  window.stopAllInstances = stopAllInstances;

  // ========== LOAD DATA ==========
  let agentRuns = {};
  let allRecentRuns = [];

  async function loadAgentRuns() {
    try {
      const runs = await supabaseFetch('agent_runs', 'select=*&order=started_at.desc&limit=80');
      allRecentRuns = runs;
      const latest = {};
      for (const r of runs) {
        if (!latest[r.agent_name]) latest[r.agent_name] = r;
      }
      agentRuns = latest;

      // Pipeline stats from last autopilot/pipeline run
      const pipelineRun = latest['autopilot'] || latest['pipeline'];
      const apLast = document.getElementById('apLastRun');
      const apDuration = document.getElementById('apLastDuration');
      if (pipelineRun) {
        apLast.textContent = timeAgo(pipelineRun.completed_at || pipelineRun.started_at);
        if (pipelineRun.completed_at && pipelineRun.started_at) {
          const dur = new Date(pipelineRun.completed_at).getTime() - new Date(pipelineRun.started_at).getTime();
          apDuration.textContent = formatDuration(dur);
        }
      }

      // Tickets processed in last 24h (from all agent runs)
      const now = Date.now();
      const processed24h = runs.filter(r => {
        const age = now - new Date(r.started_at).getTime();
        return age < 86400000 && r.metadata?.items_processed;
      }).reduce((sum, r) => sum + (r.metadata.items_processed || 0), 0);
      document.getElementById('apTicketsProcessed').textContent = processed24h || '0';

      // Article count
      try {
        const artCount = await supabaseFetchCount('articles', 'is_active=eq.true');
        document.getElementById('apArticles').textContent = artCount || '--';
      } catch(e) {}

      updateAutopilotUI();
      renderArena();
    } catch (e) { console.error('Admin load error:', e); }
  }

