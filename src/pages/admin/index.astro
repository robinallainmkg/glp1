        events.push({
          time: t.created_at,
          type: 'ticket',
          icon: t.statut === 'deployed' ? '&#128230;' : '&#127915;',
          tag: 'TICKET',
          tagClass: 'tag-ticket',
          message: `${t.source_agent || '?'}: ${t.ticket_type || 'correction'}${urgLabel} (${t.statut})`
        });
      }

      for (const c of coaches) {
        const preview = (c.content || '').substring(0, 60).replace(/\n/g, ' ');
        events.push({
          time: c.created_at,
          type: 'coach',
          icon: '&#128172;',
          tag: 'COACH',
          tagClass: 'tag-coach',
          message: preview + (preview.length >= 60 ? '...' : '')
        });
      }

      for (const cl of clicks) {
        const page = (cl.page_url || '').replace(/^https?:\/\/[^/]+/, '').substring(0, 40);
        events.push({
          time: cl.created_at,
          type: 'affiliate',
          icon: '&#128279;',
          tag: 'CLIC',
          tagClass: 'tag-affiliate',
          message: `${cl.partner || 'annette'} via ${cl.element || cl.campaign || 'lien'}${page ? ' sur ' + page : ''}`
        });
      }

      for (const co of contacts) {
        events.push({
          time: co.created_at,
          type: 'contact',
          icon: '&#128236;',
          tag: 'LEAD',
          tagClass: 'tag-contact',
          message: `${co.contact_type || 'contact'} — ${co.email || 'anonyme'}`
        });
      }

      // Sort by time descending
      events.sort((a, b) => new Date(b.time) - new Date(a.time));

      if (events.length === 0) {
        feed.innerHTML = '<div class="activity-empty">Aucune activite recente (3 derniers jours)</div>';
        return;
      }

      feed.innerHTML = events.slice(0, 25).map(ev => `
        <div class="activity-entry">
          <span class="activity-time">${formatTime(ev.time)}</span>
          <span class="activity-icon">${ev.icon}</span>
          <span class="activity-tag ${ev.tagClass}">${ev.tag}</span>
          <span class="activity-message">${escapeHtml(ev.message)}</span>
        </div>
      `).join('');
    } catch(e) {
      console.error('Activity load error:', e);
      feed.innerHTML = '<div class="activity-empty">Erreur chargement activite</div>';
    }
  }

  // ========== AGENT CONSOLE ==========
  let consoleAgent = null;
  let consoleSince = 0;
  let consoleAutoScroll = true;
  let consoleTimer = null;

  function levelToClass(level) {
    const map = {
      'tool': 'cl-tool',
      'result': 'cl-result',
      'error': 'cl-error',
      'progress': 'cl-progress',
      'action': 'cl-action',
      'cost': 'cl-cost',
      'info': 'cl-info',
    };
    return map[level] || 'cl-info';
  }

  function levelToLineCls(level) {
    if (level === 'result') return 'has-result';
    if (level === 'error') return 'has-error';
    if (level === 'progress') return 'has-progress';
    return '';
  }

  // Always essential mode
  (function() {
    const body = document.getElementById('consoleBody');
    if (body) body.className = 'console-body filter-essential';
  })();

  function formatConsoleTs(isoStr) {
    if (!isoStr) return '';
    return new Date(isoStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  function renderConsoleTabs() {
    const tabsEl = document.getElementById('consoleTabs');
    if (!tabsEl) return;
    const agentNames = new Set();
    for (const name of Object.keys(runningAgents)) agentNames.add(name);
    if (window._serverBuffers) {
      for (const name of Object.keys(window._serverBuffers)) agentNames.add(name);
    }
    if (agentNames.size === 0) { tabsEl.innerHTML = ''; return; }

    // Check which agents have errors in their buffers
    const errorAgents = new Set();
    if (window._serverBuffers) {
      for (const [name, buf] of Object.entries(window._serverBuffers)) {
        if (buf.hasError) errorAgents.add(name);
      }
    }

    tabsEl.innerHTML = [...agentNames].sort().map(name => {
      const isRunning = !!runningAgents[name];
      const hasError = errorAgents.has(name);
      const isActive = consoleAgent === name;
      const lineCount = window._serverBuffers?.[name]?.lines || 0;
      const dotClass = isRunning ? 'running' : hasError ? 'error' : 'stopped';
      return `<button class="console-tab ${isActive ? 'active' : ''}" onclick="selectConsoleAgent('${name}')" ${hasError ? 'style="border-color:#f8717144"' : ''}>
        <span class="tab-dot ${dotClass}"></span>
        ${name}
        ${lineCount > 0 ? `<span class="tab-lines">(${lineCount})</span>` : ''}
      </button>`;
    }).join('');

    // Auto-open console for agent with errors if no agent selected
    if (!consoleAgent && errorAgents.size > 0) {
      selectConsoleAgent([...errorAgents][0]);
    }
  }

  function selectConsoleAgent(name) {
    consoleAgent = name;
    consoleSince = 0;
    consoleAutoScroll = true;
    document.getElementById('consoleBody').innerHTML = '<div class="console-empty">Chargement...</div>';
    renderConsoleTabs();
    fetchConsoleOutput();
    if (consoleTimer) clearInterval(consoleTimer);
    consoleTimer = setInterval(fetchConsoleOutput, 1500);
  }

  async function fetchConsoleOutput() {
    if (!consoleAgent || !serverOnline) return;
    try {
      const r = await fetch(`${AGENT_SERVER}/output/${consoleAgent}?since=${consoleSince}`);
      const data = await r.json();
      const body = document.getElementById('consoleBody');
      const statusEl = document.getElementById('consoleStatus');

      if (statusEl) {
        statusEl.textContent = data.running ? `RUNNING (${data.total} lines)` : `STOPPED (${data.total} lines)`;
        statusEl.style.color = data.running ? '#22c55e' : '#475569';
      }

      if (data.lines.length === 0 && consoleSince === 0) {
        body.innerHTML = '<div class="console-empty">Aucune sortie</div>';
        return;
      }
      if (data.lines.length === 0) return;
      if (consoleSince === 0) body.innerHTML = '';

      const fragment = document.createDocumentFragment();
      for (const line of data.lines) {
        const div = document.createElement('div');
        const level = line.level || 'info';
        const cls = levelToClass(level);
        const lineCls = levelToLineCls(level);
        div.className = 'console-line level-' + level + (lineCls ? ' ' + lineCls : '');
        div.innerHTML = `<span class="console-line-ts">${formatConsoleTs(line.ts)}</span><span class="console-line-text ${cls}">${escapeHtml(line.text)}</span>`;
        fragment.appendChild(div);
      }
      body.appendChild(fragment);
      consoleSince = data.total;
      if (consoleAutoScroll) body.scrollTop = body.scrollHeight;
    } catch(e) {}
  }

  document.getElementById('consoleBody')?.addEventListener('scroll', function() {
    consoleAutoScroll = (this.scrollHeight - this.scrollTop - this.clientHeight) < 30;
  });

  window.selectConsoleAgent = selectConsoleAgent;
  window.toggleAutopilot = launchRoutine;
  window.launchRoutine = launchRoutine;

  // ========== CLOCK ==========
  function updateClock() {
    document.getElementById('clock').textContent = new Date().toLocaleString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  updateClock();
  setInterval(updateClock, 1000);

  // ========== REALTIME ==========
  function setupRealtime() {
    const wsUrl = SUPABASE_URL.replace('https://', 'wss://') + '/realtime/v1/websocket?apikey=' + SUPABASE_ANON_KEY + '&vsn=1.0.0';
    let ws;
    let heartbeatInterval;

    function connect() {
      ws = new WebSocket(wsUrl);
      ws.onopen = () => {
        // Subscribe to key tables
        const tables = ['agent_runs', 'correction_tickets', 'coach_messages', 'affiliate_clicks', 'contacts'];
        tables.forEach((table, i) => {
          ws.send(JSON.stringify({
            topic: `realtime:public:${table}`,
            event: 'phx_join',
            payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table }] } },
            ref: String(i + 1)
          }));
        });
        heartbeatInterval = setInterval(() => {
          if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ topic: 'phoenix', event: 'heartbeat', payload: {}, ref: 'hb' }));
          }
        }, 30000);
      };
      ws.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.event === 'postgres_changes') {
            const table = msg.topic?.replace('realtime:public:', '');
            // Targeted refresh based on which table changed
            if (table === 'agent_runs') {
              loadAgentRuns();
              loadPendingCounts();
            } else if (table === 'correction_tickets') {
              loadPendingCounts();
              loadHealthKPIs();
            } else if (table === 'coach_messages' || table === 'affiliate_clicks' || table === 'contacts') {
              loadSiteVitals();
            }
            // Always refresh activity on any change
            loadActivity();
          }
        } catch(e) {}
      };
      ws.onclose = () => {
        clearInterval(heartbeatInterval);
        setTimeout(connect, 3000);
      };
      ws.onerror = () => ws.close();
    }
    connect();
  }

  // ========== POLLING ==========
  setInterval(() => {
    checkServer().then(() => {
      updateAutopilotUI();
      renderArena();
      // Auto-open console for first running agent
      if (!consoleAgent) {
        const running = Object.keys(runningAgents);
        if (running.length > 0) selectConsoleAgent(running[0]);
      }
    });
  }, 5000);

  setInterval(() => {
    Promise.all([loadPendingCounts(), loadHealthKPIs(), loadSiteVitals()]).then(() => loadAgentRuns());
  }, 30000);

  // Refresh activity less often
  setInterval(loadActivity, 60000);

  // ========== INIT ==========
  Promise.all([checkServer(), loadPendingCounts(), loadHealthKPIs(), loadSiteVitals()]).then(() => {
    loadAgentRuns();
    loadActivity();
  });
  setupRealtime();
</script>

</body>
</html>
