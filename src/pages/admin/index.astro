---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - GLP1 France</title>
  <style is:inline>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: #0a0e17;
      color: #c8d6e5;
      min-height: 100vh;
    }

    .admin-layout { margin-left: 260px; min-height: 100vh; }

    /* Header */
    .mc-header {
      background: linear-gradient(180deg, #0f1520 0%, #0a0e17 100%);
      border-bottom: 1px solid #1a2332;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mc-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .mc-title .pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e88;
      animation: pulse-glow 2s infinite;
    }
    .mc-status {
      font-size: 0.72rem;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .mc-clock {
      font-size: 0.85rem;
      color: #64748b;
      font-variant-numeric: tabular-nums;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; box-shadow: 0 0 8px #22c55e88; }
      50% { opacity: 0.5; box-shadow: 0 0 4px #22c55e44; }
    }

    .mc-main { padding: 1.5rem 2rem; }

    /* Agent grid */
    .agents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .agent-card {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 1rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .agent-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: #1e293b;
      transition: background 0.3s;
    }
    .agent-card.running { border-color: #22c55e44; box-shadow: 0 0 20px #22c55e11; }
    .agent-card.running::before { background: #22c55e; animation: scan-line 2s linear infinite; }
    .agent-card.completed::before { background: #3b82f6; }
    .agent-card.error { border-color: #ef444444; }
    .agent-card.error::before { background: #ef4444; }

    @keyframes scan-line {
      0% { background: linear-gradient(90deg, transparent, #22c55e, transparent); background-size: 200%; background-position: -100%; }
      100% { background: linear-gradient(90deg, transparent, #22c55e, transparent); background-size: 200%; background-position: 200%; }
    }

    .agent-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
    }
    .icon-seo { background: #1e3a5f; color: #38bdf8; }
    .icon-analytics { background: #1e3a1e; color: #4ade80; }
    .icon-factcheck { background: #3a2e1e; color: #fbbf24; }
    .icon-opportunities { background: #2e1e3a; color: #c084fc; }
    .icon-editorial { background: #1e2e3a; color: #67e8f9; }
    .icon-validator { background: #1e3a2e; color: #86efac; }
    .icon-links { background: #3a1e2e; color: #f9a8d4; }

    .agent-name {
      font-size: 0.8rem;
      font-weight: 700;
      color: #e2e8f0;
      margin-bottom: 0.5rem;
    }

    .agent-status-line {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.6rem;
    }
    .status-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .si-idle { background: #475569; }
    .si-running { background: #22c55e; animation: pulse-glow 1.5s infinite; }
    .si-completed { background: #3b82f6; }
    .si-error { background: #ef4444; }
    .si-started { background: #eab308; animation: pulse-glow 1.5s infinite; }

    .status-text {
      font-size: 0.68rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .agent-card.running .status-text { color: #4ade80; }
    .agent-card.error .status-text { color: #f87171; }

    .agent-counters {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.35rem;
      margin-bottom: 0.6rem;
    }
    .counter {
      font-size: 0.68rem;
      color: #475569;
    }
    .counter strong {
      color: #94a3b8;
      font-size: 0.85rem;
      display: block;
    }

    .agent-last-action {
      font-size: 0.65rem;
      color: #374151;
      border-top: 1px solid #1e293b;
      padding-top: 0.5rem;
      min-height: 2.5em;
      line-height: 1.3;
    }

    /* Launch button */
    .agent-launch-btn {
      width: 100%;
      padding: 0.4rem 0;
      margin-top: 0.5rem;
      border: 1px solid #22c55e44;
      border-radius: 6px;
      background: #0a1a0f;
      color: #4ade80;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.68rem;
      font-weight: 600;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }
    .agent-launch-btn:hover {
      background: #0f2a17;
      border-color: #22c55e88;
      box-shadow: 0 0 12px #22c55e22;
    }
    .agent-launch-btn:active { transform: scale(0.97); }
    .agent-launch-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      border-color: #1e293b;
      background: #111827;
      color: #475569;
    }
    .agent-launch-btn.pending {
      border-color: #eab30844;
      background: #1a1508;
      color: #fbbf24;
      cursor: default;
    }
    .agent-launch-btn.is-running {
      border-color: #22c55e44;
      background: #071a0d;
      color: #22c55e;
      cursor: default;
      animation: pulse-btn 2s infinite;
    }
    @keyframes pulse-btn {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }

    /* Queue panel */
    .queue-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }
    .queue-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid #1e293b;
    }
    .queue-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .queue-count {
      font-size: 0.68rem;
      color: #eab308;
      font-weight: 600;
    }
    .queue-body { padding: 0.5rem 0; }
    .queue-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.45rem 1.25rem;
      font-size: 0.72rem;
    }
    .queue-item:hover { background: #1a2332; }
    .qi-status {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .qi-pending { background: #eab308; }
    .qi-running { background: #22c55e; animation: pulse-glow 1.5s infinite; }
    .qi-completed { background: #3b82f6; }
    .qi-failed { background: #ef4444; }
    .qi-name { color: #e2e8f0; font-weight: 600; flex: 1; }
    .qi-time { color: #475569; font-size: 0.65rem; }
    .qi-cancel {
      background: none;
      border: 1px solid #ef444444;
      color: #f87171;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.6rem;
      padding: 0.15rem 0.4rem;
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .qi-cancel:hover { background: #450a0a; border-color: #ef4444; }
    .queue-empty {
      text-align: center;
      padding: 1rem;
      color: #374151;
      font-size: 0.72rem;
    }

    /* Dep graph */
    .dep-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
    }
    .dep-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .dep-section svg { width: 100%; max-width: 800px; margin: 0 auto; display: block; }

    /* Log feed */
    .log-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
    }
    .log-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid #1e293b;
    }
    .log-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .log-live {
      font-size: 0.65rem;
      color: #22c55e;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .log-live .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-glow 1.5s infinite;
    }

    .log-feed {
      max-height: 320px;
      overflow-y: auto;
      padding: 0.25rem 0;
      scrollbar-width: thin;
      scrollbar-color: #1e293b transparent;
    }
    .log-feed::-webkit-scrollbar { width: 6px; }
    .log-feed::-webkit-scrollbar-track { background: transparent; }
    .log-feed::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

    .log-entry {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.35rem 1.25rem;
      font-size: 0.72rem;
      transition: background 0.1s;
      animation: log-appear 0.3s ease-out;
    }
    .log-entry:hover { background: #1a2332; }

    @keyframes log-appear {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .log-time {
      color: #374151;
      font-variant-numeric: tabular-nums;
      flex-shrink: 0;
      min-width: 62px;
    }
    .log-agent-tag {
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      flex-shrink: 0;
      min-width: 68px;
      text-align: center;
    }
    .tag-seo-audit { background: #1e3a5f; color: #38bdf8; }
    .tag-analytics { background: #1e3a1e; color: #4ade80; }
    .tag-fact-check { background: #3a2e1e; color: #fbbf24; }
    .tag-opportunities { background: #2e1e3a; color: #c084fc; }
    .tag-editorial { background: #1e2e3a; color: #67e8f9; }

    .log-message { color: #94a3b8; flex: 1; }
    .log-status {
      font-size: 0.62rem;
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .ls-success { background: #052e16; color: #4ade80; }
    .ls-error { background: #450a0a; color: #f87171; }

    .log-empty {
      text-align: center;
      padding: 2rem;
      color: #374151;
      font-size: 0.78rem;
    }

    @media (max-width: 1024px) { .admin-layout { margin-left: 0; padding-top: 56px; } }
    @media (max-width: 1200px) { .agents-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px) {
      .mc-main { padding: 1rem; }
      .mc-header { padding: 1rem; flex-direction: column; gap: 0.5rem; }
      .agents-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) { .agents-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="mc-header">
    <div class="mc-title">
      <span class="pulse-dot"></span>
      MISSION CONTROL
    </div>
    <div class="mc-status">GLP-1 France &mdash; Agent Supervision</div>
    <div class="mc-clock" id="clock"></div>
  </div>

  <div class="mc-main">
    <!-- Agent cards -->
    <div class="agents-grid" id="agentsGrid"></div>

    <!-- Agent queue -->
    <div class="queue-section" id="queueSection" style="display:none">
      <div class="queue-header">
        <span class="queue-title">File d'attente</span>
        <span class="queue-count" id="queueCount"></span>
      </div>
      <div class="queue-body" id="queueBody">
        <div class="queue-empty">Aucune tache en attente</div>
      </div>
    </div>

    <!-- Dependency graph -->
    <div class="dep-section">
      <div class="dep-title">Dependances</div>
      <svg viewBox="0 0 820 210" xmlns="http://www.w3.org/2000/svg">
        <!-- Row 1: Independent agents → Dashboard -->
        <rect x="10" y="10" width="120" height="32" rx="6" fill="#111827" stroke="#1e3a5f" stroke-width="1"/>
        <text x="70" y="31" text-anchor="middle" font-size="9" font-weight="600" fill="#38bdf8" font-family="JetBrains Mono, monospace">SEO Audit</text>
        <line x1="130" y1="26" x2="700" y2="40" stroke="#1e293b" stroke-width="1" stroke-dasharray="4"/>

        <rect x="10" y="50" width="120" height="32" rx="6" fill="#111827" stroke="#1e3a1e" stroke-width="1"/>
        <text x="70" y="71" text-anchor="middle" font-size="9" font-weight="600" fill="#4ade80" font-family="JetBrains Mono, monospace">Analytics</text>
        <line x1="130" y1="66" x2="700" y2="50" stroke="#1e293b" stroke-width="1" stroke-dasharray="4"/>

        <!-- Dashboard -->
        <rect x="700" y="25" width="110" height="40" rx="6" fill="#111827" stroke="#22c55e44" stroke-width="1"/>
        <text x="755" y="50" text-anchor="middle" font-size="9" font-weight="600" fill="#22c55e" font-family="JetBrains Mono, monospace">Dashboard</text>

        <!-- Row 2: Fact-Check + Opportunities + Int.Links → Editorial → Validator → Git → Dashboard -->
        <rect x="10" y="100" width="120" height="32" rx="6" fill="#111827" stroke="#3a2e1e" stroke-width="1"/>
        <text x="70" y="121" text-anchor="middle" font-size="9" font-weight="600" fill="#fbbf24" font-family="JetBrains Mono, monospace">Fact-Check</text>
        <line x1="130" y1="116" x2="250" y2="116" stroke="#fbbf2466" stroke-width="1.5" marker-end="url(#arrowGold)"/>
        <text x="190" y="108" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">tickets</text>

        <rect x="10" y="140" width="120" height="32" rx="6" fill="#111827" stroke="#2e1e3a" stroke-width="1"/>
        <text x="70" y="161" text-anchor="middle" font-size="9" font-weight="600" fill="#c084fc" font-family="JetBrains Mono, monospace">Opportunities</text>
        <line x1="130" y1="156" x2="250" y2="126" stroke="#c084fc66" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
        <text x="190" y="148" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">sujets</text>

        <rect x="10" y="180" width="120" height="32" rx="6" fill="#111827" stroke="#3a1e2e" stroke-width="1"/>
        <text x="70" y="201" text-anchor="middle" font-size="9" font-weight="600" fill="#f9a8d4" font-family="JetBrains Mono, monospace">Int. Links</text>
        <line x1="130" y1="196" x2="250" y2="130" stroke="#f9a8d466" stroke-width="1.5" marker-end="url(#arrowPink)"/>
        <text x="190" y="188" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">maillage</text>

        <!-- Editorial -->
        <rect x="255" y="100" width="110" height="36" rx="6" fill="#111827" stroke="#1e2e3a" stroke-width="1"/>
        <text x="310" y="123" text-anchor="middle" font-size="9" font-weight="600" fill="#67e8f9" font-family="JetBrains Mono, monospace">Editorial</text>
        <line x1="365" y1="118" x2="440" y2="118" stroke="#67e8f966" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

        <!-- Validator -->
        <rect x="445" y="100" width="100" height="36" rx="6" fill="#111827" stroke="#1e3a2e" stroke-width="1"/>
        <text x="495" y="123" text-anchor="middle" font-size="9" font-weight="600" fill="#86efac" font-family="JetBrains Mono, monospace">Validator</text>
        <line x1="545" y1="118" x2="600" y2="118" stroke="#86efac66" stroke-width="1.5" marker-end="url(#arrowMint)"/>

        <!-- Git + Deploy -->
        <rect x="605" y="100" width="90" height="36" rx="6" fill="#111827" stroke="#22c55e44" stroke-width="1"/>
        <text x="650" y="117" text-anchor="middle" font-size="8" font-weight="600" fill="#22c55e" font-family="JetBrains Mono, monospace">Git Push</text>
        <text x="650" y="129" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">Deploy</text>
        <line x1="695" y1="118" x2="700" y2="60" stroke="#22c55e44" stroke-width="1" stroke-dasharray="4" marker-end="url(#arrowGreen)"/>

        <defs>
          <marker id="arrowGold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#fbbf24"/></marker>
          <marker id="arrowPurple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#c084fc"/></marker>
          <marker id="arrowPink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#f9a8d4"/></marker>
          <marker id="arrowCyan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#67e8f9"/></marker>
          <marker id="arrowMint" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#86efac"/></marker>
          <marker id="arrowGreen" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#22c55e"/></marker>
        </defs>
      </svg>
    </div>

    <!-- Live log feed -->
    <div class="log-section">
      <div class="log-header">
        <span class="log-title">Live Feed</span>
        <span class="log-live"><span class="live-dot"></span> Realtime</span>
      </div>
      <div class="log-feed" id="logFeed">
        <div class="log-empty">En attente de logs...</div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  const AGENTS = [
    { name: 'seo-audit', label: 'SEO Audit', icon: 'seo', desc: 'Crawl, meta, liens' },
    { name: 'analytics', label: 'Analytics', icon: 'analytics', desc: 'Keywords ranking' },
    { name: 'fact-check', label: 'Fact-Check', icon: 'factcheck', desc: 'Verification medicale' },
    { name: 'opportunities', label: 'Opportunities', icon: 'opportunities', desc: 'Tendances, gaps' },
    { name: 'editorial', label: 'Editorial', icon: 'editorial', desc: 'Redaction, corrections' },
    { name: 'validator', label: 'Validator', icon: 'validator', desc: 'Build, frontmatter, liens' },
    { name: 'internal-links', label: 'Maillage', icon: 'links', desc: 'Liens internes SEO' },
  ];

  const TAG_CLASSES = {
    'seo-audit': 'tag-seo-audit',
    'analytics': 'tag-analytics',
    'fact-check': 'tag-fact-check',
    'opportunities': 'tag-opportunities',
    'editorial': 'tag-editorial',
    'validator': 'tag-seo-audit',
    'internal-links': 'tag-analytics',
  };

  function escapeHtml(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return 'jamais';
    const diff = Date.now() - new Date(dateStr).getTime();
    if (diff < 60000) return 'il y a < 1min';
    if (diff < 3600000) return 'il y a ' + Math.floor(diff / 60000) + 'min';
    if (diff < 86400000) return 'il y a ' + Math.floor(diff / 3600000) + 'h';
    return 'il y a ' + Math.floor(diff / 86400000) + 'j';
  }

  function formatDuration(ms) {
    if (!ms) return '';
    if (ms < 60000) return Math.round(ms / 1000) + 's';
    return Math.floor(ms / 60000) + 'min ' + Math.round((ms % 60000) / 1000) + 's';
  }

  function formatTime(dateStr) {
    if (!dateStr) return '--:--';
    return new Date(dateStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  async function supabaseFetch(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function supabaseInsert(table, data) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}`, {
      method: 'POST',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=representation'
      },
      body: JSON.stringify(data)
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function supabasePatch(table, query, data) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      method: 'PATCH',
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify(data)
    });
    if (!r.ok) throw new Error(await r.text());
  }

  // Queue state
  let queueItems = [];

  async function loadQueue() {
    try {
      queueItems = await supabaseFetch('agent_queue', 'select=*&order=requested_at.desc&limit=20');
      renderQueue();
    } catch(e) {}
  }

  function renderQueue() {
    const active = queueItems.filter(q => q.status === 'pending' || q.status === 'running');
    const recent = queueItems.filter(q => q.status === 'completed' || q.status === 'failed').slice(0, 5);
    const all = [...active, ...recent];

    const section = document.getElementById('queueSection');
    const body = document.getElementById('queueBody');
    const count = document.getElementById('queueCount');

    if (all.length === 0) {
      section.style.display = 'none';
      return;
    }

    section.style.display = 'block';
    count.textContent = active.length > 0 ? active.length + ' en cours' : '';

    body.innerHTML = all.map(q => {
      const canCancel = q.status === 'pending';
      return `<div class="queue-item">
        <span class="qi-status qi-${q.status}"></span>
        <span class="qi-name">${escapeHtml(q.agent_name)}</span>
        <span class="qi-time">${q.status === 'pending' ? 'en attente' : q.status === 'running' ? 'en cours...' : q.status} · ${timeAgo(q.requested_at)}</span>
        ${canCancel ? `<button class="qi-cancel" onclick="cancelQueueItem('${q.id}')">Annuler</button>` : ''}
      </div>`;
    }).join('');
  }

  async function launchAgent(name) {
    const btn = document.querySelector(`[data-launch="${name}"]`);
    if (btn) { btn.disabled = true; btn.textContent = '...'; }

    try {
      // Check if agent already pending or running
      const existing = queueItems.find(q => q.agent_name === name && (q.status === 'pending' || q.status === 'running'));
      if (existing) {
        alert(name + ' est deja en file d\'attente ou en cours.');
        return;
      }

      await supabaseInsert('agent_queue', { agent_name: name, status: 'pending' });
      await loadQueue();
      await loadAgents();
    } catch(e) {
      alert('Erreur: ' + e.message);
    }
  }

  async function cancelQueueItem(id) {
    try {
      await supabasePatch('agent_queue', `id=eq.${id}`, { status: 'cancelled', completed_at: new Date().toISOString() });
      await loadQueue();
    } catch(e) {
      alert('Erreur: ' + e.message);
    }
  }

  // Expose to onclick
  window.launchAgent = launchAgent;
  window.cancelQueueItem = cancelQueueItem;

  // Clock
  function updateClock() {
    document.getElementById('clock').textContent = new Date().toLocaleString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  updateClock();
  setInterval(updateClock, 1000);

  // Agent cards
  async function loadAgents() {
    try {
      const runs = await supabaseFetch('agent_runs', 'select=*&order=started_at.desc&limit=50');
      const latest = {};
      for (const r of runs) {
        if (!latest[r.agent_name]) latest[r.agent_name] = r;
      }

      const grid = document.getElementById('agentsGrid');
      grid.innerHTML = AGENTS.map(a => {
        const run = latest[a.name];
        const status = run ? run.status : 'idle';
        const statusLabel = { completed: 'termine', running: 'en cours', started: 'demarre', error: 'erreur', idle: 'inactif' }[status] || status;
        const meta = run?.metadata || {};
        const items = run?.items_processed ?? '-';

        // Smart counters per agent using metadata
        let counter2Label = 'erreurs';
        let counter2Value = run?.items_errors ?? '-';
        if (a.name === 'seo-audit' && meta.critical !== undefined) {
          counter2Value = meta.critical || 0;
          counter2Label = 'critiques';
        } else if (a.name === 'fact-check' && meta.tickets_created !== undefined) {
          counter2Value = meta.tickets_created;
          counter2Label = 'tickets';
        } else if (a.name === 'analytics' && meta.positioned_keywords !== undefined) {
          counter2Value = meta.positioned_keywords;
          counter2Label = 'positionnes';
        } else if (a.name === 'opportunities' && meta.high_priority !== undefined) {
          counter2Value = meta.high_priority;
          counter2Label = 'prioritaires';
        } else if (a.name === 'editorial' && meta.tickets_corrected !== undefined) {
          counter2Value = meta.articles_created || 0;
          counter2Label = 'crees';
        } else if (a.name === 'validator' && meta.errors !== undefined) {
          counter2Value = meta.errors;
          counter2Label = 'erreurs';
        } else if (a.name === 'internal-links' && meta.suggestions_new !== undefined) {
          counter2Value = meta.suggestions_new;
          counter2Label = 'suggestions';
        }

        const duration = run?.duration_ms ? formatDuration(run.duration_ms)
          : (run?.started_at && run?.completed_at)
            ? formatDuration(new Date(run.completed_at) - new Date(run.started_at))
            : '';
        const lastTime = run?.completed_at
          ? timeAgo(run.completed_at)
          : run?.started_at
            ? timeAgo(run.started_at)
            : 'jamais lance';

        // Queue state for this agent
        const queueEntry = queueItems.find(q => q.agent_name === a.name && (q.status === 'pending' || q.status === 'running'));
        const queueStatus = queueEntry ? queueEntry.status : null;
        let btnClass = 'agent-launch-btn';
        let btnLabel = '&#9654; Lancer';
        let btnDisabled = '';
        if (queueStatus === 'pending') { btnClass += ' pending'; btnLabel = '&#9203; En attente'; btnDisabled = 'disabled'; }
        else if (queueStatus === 'running' || status === 'running' || status === 'started') { btnClass += ' is-running'; btnLabel = '&#9881; En cours...'; btnDisabled = 'disabled'; }

        return `<div class="agent-card ${status}">
          <div class="agent-icon icon-${a.icon}">${a.label[0]}</div>
          <div class="agent-name">${a.label}</div>
          <div class="agent-status-line">
            <span class="status-indicator si-${status}"></span>
            <span class="status-text">${statusLabel.toUpperCase()}</span>
          </div>
          <div class="agent-counters">
            <div class="counter"><strong>${items}</strong>traites</div>
            <div class="counter"><strong>${counter2Value}</strong>${counter2Label}</div>
          </div>
          <div class="agent-last-action">${lastTime}${duration ? ' · ' + duration : ''}</div>
          <button class="${btnClass}" data-launch="${a.name}" onclick="launchAgent('${a.name}')" ${btnDisabled}>${btnLabel}</button>
        </div>`;
      }).join('');
    } catch (e) {
      document.getElementById('agentsGrid').innerHTML = `<div style="grid-column:1/-1;color:#f87171;padding:1rem;font-size:0.8rem">Erreur: ${escapeHtml(e.message)}</div>`;
    }
  }

  // Log feed
  let lastLogId = null;

  async function loadLogs(append) {
    try {
      let query = 'select=*&order=created_at.desc&limit=50';
      const logs = await supabaseFetch('agent_logs', query);

      const feed = document.getElementById('logFeed');
      if (logs.length === 0) {
        if (!append) feed.innerHTML = '<div class="log-empty">En attente de logs...</div>';
        return;
      }

      if (append && lastLogId === logs[0].id) return; // no new logs
      lastLogId = logs[0].id;

      feed.innerHTML = logs.map(log => {
        const meta = log.metadata || {};
        const details = meta.action || meta.tickets_created !== undefined
          ? `${meta.action || ''} ${meta.tickets_created ? meta.tickets_created + ' tickets' : ''} ${meta.score ? 'score:' + meta.score : ''}`.trim()
          : '';
        const tagClass = TAG_CLASSES[log.agent_type] || 'tag-seo-audit';
        const statusClass = log.status === 'success' ? 'ls-success' : 'ls-error';

        return `<div class="log-entry">
          <span class="log-time">${formatTime(log.created_at)}</span>
          <span class="log-agent-tag ${tagClass}">${escapeHtml(log.agent_type)}</span>
          <span class="log-message">${escapeHtml(details || '-')}</span>
          <span class="log-status ${statusClass}">${escapeHtml(log.status)}</span>
        </div>`;
      }).join('');
    } catch (e) {
      // silent fail on polling
    }
  }

  // Realtime via Supabase
  function setupRealtime() {
    // Use Supabase Realtime WebSocket for live updates
    const wsUrl = SUPABASE_URL.replace('https://', 'wss://') + '/realtime/v1/websocket?apikey=' + SUPABASE_ANON_KEY + '&vsn=1.0.0';
    let ws;

    function connect() {
      ws = new WebSocket(wsUrl);

      ws.onopen = () => {
        // Join agent_runs channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_runs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_runs' }] } },
          ref: '1'
        }));
        // Join agent_logs channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_logs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_logs' }] } },
          ref: '2'
        }));
        // Join agent_queue channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_queue',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_queue' }] } },
          ref: '3'
        }));
        // Heartbeat
        setInterval(() => {
          if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ topic: 'phoenix', event: 'heartbeat', payload: {}, ref: 'hb' }));
          }
        }, 30000);
      };

      ws.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.event === 'postgres_changes') {
            loadAgents();
            loadLogs(true);
            loadQueue();
          }
        } catch(e) {}
      };

      ws.onclose = () => {
        // Reconnect after 3s
        setTimeout(connect, 3000);
      };

      ws.onerror = () => ws.close();
    }

    connect();
  }

  // Polling every 5s for reliable updates
  setInterval(() => {
    loadAgents();
    loadLogs(true);
    loadQueue();
  }, 5000);

  // Init
  loadQueue().then(() => {
    loadAgents();
    loadLogs(false);
  });
  setupRealtime();
</script>

</body>
</html>
