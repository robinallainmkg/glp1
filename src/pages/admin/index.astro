---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - GLP1 France</title>
  <style is:inline>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: #0a0e17;
      color: #c8d6e5;
      min-height: 100vh;
    }

    .admin-layout { margin-left: 260px; min-height: 100vh; }

    /* Header */
    .mc-header {
      background: linear-gradient(180deg, #0f1520 0%, #0a0e17 100%);
      border-bottom: 1px solid #1a2332;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mc-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .mc-title .pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e88;
      animation: pulse-glow 2s infinite;
    }
    .mc-clock {
      font-size: 0.8rem;
      color: #64748b;
      font-variant-numeric: tabular-nums;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; box-shadow: 0 0 8px #22c55e88; }
      50% { opacity: 0.5; box-shadow: 0 0 4px #22c55e44; }
    }

    .mc-main { padding: 1.5rem 2rem; }

    /* ==================== AUTOPILOT HERO ==================== */
    .autopilot-hero {
      background: linear-gradient(135deg, #0a1a0f 0%, #111827 50%, #0f172a 100%);
      border: 1px solid #22c55e33;
      border-radius: 16px;
      padding: 1.5rem 2rem;
      margin-bottom: 1.5rem;
      position: relative;
      overflow: hidden;
    }
    .autopilot-hero::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at 30% 50%, #22c55e06 0%, transparent 50%);
      pointer-events: none;
    }
    .autopilot-hero.is-running {
      border-color: #22c55e66;
      box-shadow: 0 0 30px #22c55e11;
    }
    .autopilot-hero.is-running::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, #22c55e, transparent);
      animation: scan-line 3s linear infinite;
    }
    @keyframes scan-line {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    .ap-top {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: relative;
      z-index: 1;
    }
    .ap-btn-area { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
    .ap-big-btn {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 2px solid #22c55e55;
      background: radial-gradient(circle, #0f2a17 0%, #0a1a0f 100%);
      color: #4ade80;
      font-size: 2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s;
      position: relative;
    }
    .ap-big-btn:hover {
      border-color: #22c55e;
      box-shadow: 0 0 20px #22c55e33;
      transform: scale(1.05);
    }
    .ap-big-btn.running {
      border-color: #ef444488;
      background: radial-gradient(circle, #1a0f0f 0%, #150a0a 100%);
      color: #f87171;
      animation: ap-pulse 2s infinite;
    }
    @keyframes ap-pulse {
      0%, 100% { box-shadow: 0 0 20px #22c55e22; }
      50% { box-shadow: 0 0 30px #22c55e44; }
    }
    .ap-btn-label {
      font-size: 0.6rem;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
    }

    .ap-info { flex: 1; }
    .ap-title-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.4rem;
    }
    .ap-name {
      font-size: 1.3rem;
      font-weight: 700;
      color: #4ade80;
    }
    .ap-status-badge {
      font-size: 0.55rem;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .ap-status-badge.idle { background: #1e293b; color: #475569; }
    .ap-status-badge.running { background: #052e16; color: #22c55e; animation: pulse-glow 2s infinite; }
    .ap-status-badge.error { background: #450a0a; color: #f87171; }

    .ap-desc {
      font-size: 0.65rem;
      color: #64748b;
      line-height: 1.6;
      max-width: 500px;
    }

    .ap-stats {
      display: flex;
      gap: 1.5rem;
      margin-top: 0.75rem;
    }
    .ap-stat {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }
    .ap-stat-val {
      font-size: 1.1rem;
      font-weight: 700;
      color: #e2e8f0;
    }
    .ap-stat-label {
      font-size: 0.5rem;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* Budget meter */
    .ap-budget {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.3rem;
      position: relative;
      z-index: 1;
      min-width: 120px;
    }
    .ap-budget-label {
      font-size: 0.5rem;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .ap-budget-bar {
      width: 100%;
      height: 10px;
      background: #1e293b;
      border-radius: 5px;
      overflow: hidden;
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.3);
    }
    .ap-budget-fill {
      height: 100%;
      border-radius: 3px;
      transition: width 0.5s;
    }
    .ap-budget-val {
      font-size: 0.65rem;
      font-weight: 700;
      color: #94a3b8;
    }

    /* ==================== AGENT ARENA ==================== */
    .arena-section {
      margin-bottom: 1.5rem;
    }
    .arena-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .arena-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .arena-legend {
      display: flex;
      gap: 1rem;
      font-size: 0.55rem;
      color: #475569;
    }
    .arena-legend-item {
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .arena-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.75rem;
    }

    .arena-cell {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 1rem;
      cursor: pointer;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }
    .arena-cell:hover {
      border-color: #334155;
      background: #1a2332;
    }
    .arena-cell.has-active {
      border-color: var(--agent-color, #22c55e)33;
      background: linear-gradient(180deg, #111827 0%, color-mix(in srgb, var(--agent-color, #22c55e) 3%, #111827) 100%);
    }

    .arena-cell-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .arena-cell-name {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--agent-color, #94a3b8);
    }
    .arena-cell-count {
      font-size: 0.55rem;
      padding: 0.1rem 0.4rem;
      border-radius: 3px;
      font-weight: 700;
    }
    .arena-cell-count.active {
      background: var(--agent-color, #22c55e)22;
      color: var(--agent-color, #22c55e);
    }
    .arena-cell-count.zero {
      background: #1e293b;
      color: #374151;
    }

    /* Character stage */
    .arena-stage {
      height: 70px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 8px;
      margin-bottom: 0.5rem;
    }

    /* ==================== CSS CHARACTERS ==================== */
    .char {
      width: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
    }

    /* Head */
    .char-head {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--agent-color, #94a3b8);
      position: relative;
      z-index: 2;
    }

    /* Body */
    .char-body {
      width: 2px;
      height: 16px;
      background: var(--agent-color, #94a3b8);
      position: relative;
    }

    /* Arms */
    .char-arms {
      position: absolute;
      top: 2px;
      width: 20px;
      height: 12px;
      left: 50%;
      transform: translateX(-50%);
    }
    .char-arm {
      position: absolute;
      width: 10px;
      height: 2px;
      background: var(--agent-color, #94a3b8);
      top: 0;
      transform-origin: left center;
      border-radius: 1px;
    }
    .char-arm.left { left: 0; transform-origin: right center; right: 50%; left: auto; }
    .char-arm.right { left: 50%; transform-origin: left center; }

    /* Legs */
    .char-legs {
      display: flex;
      gap: 2px;
    }
    .char-leg {
      width: 2px;
      height: 14px;
      background: var(--agent-color, #94a3b8);
      transform-origin: top center;
      border-radius: 0 0 1px 1px;
    }

    /* === DANCING animation === */
    .char.dancing {
      animation: char-bounce 0.6s ease-in-out infinite;
    }
    .char.dancing .char-arm.left {
      animation: arm-wave-l 0.6s ease-in-out infinite;
    }
    .char.dancing .char-arm.right {
      animation: arm-wave-r 0.6s ease-in-out infinite;
    }
    .char.dancing .char-leg.left {
      animation: leg-kick-l 0.6s ease-in-out infinite;
    }
    .char.dancing .char-leg.right {
      animation: leg-kick-r 0.6s ease-in-out infinite;
    }

    @keyframes char-bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
    @keyframes arm-wave-l {
      0%, 100% { transform: rotate(30deg); }
      50% { transform: rotate(-60deg); }
    }
    @keyframes arm-wave-r {
      0%, 100% { transform: rotate(-30deg); }
      50% { transform: rotate(60deg); }
    }
    @keyframes leg-kick-l {
      0%, 100% { transform: rotate(15deg); }
      50% { transform: rotate(-15deg); }
    }
    @keyframes leg-kick-r {
      0%, 100% { transform: rotate(-15deg); }
      50% { transform: rotate(15deg); }
    }

    /* Offset animation for multiple characters */
    .char.dancing.d1 { animation-delay: 0s; }
    .char.dancing.d1 .char-arm, .char.dancing.d1 .char-leg { animation-delay: 0s; }
    .char.dancing.d2 { animation-delay: 0.15s; }
    .char.dancing.d2 .char-arm, .char.dancing.d2 .char-leg { animation-delay: 0.15s; }
    .char.dancing.d3 { animation-delay: 0.3s; }
    .char.dancing.d3 .char-arm, .char.dancing.d3 .char-leg { animation-delay: 0.3s; }
    .char.dancing.d4 { animation-delay: 0.45s; }
    .char.dancing.d4 .char-arm, .char.dancing.d4 .char-leg { animation-delay: 0.45s; }

    /* === IDLE animation === */
    .char.idle {
      animation: char-breathe 3s ease-in-out infinite;
    }
    .char.idle .char-arm.left { transform: rotate(10deg); }
    .char.idle .char-arm.right { transform: rotate(-10deg); }
    @keyframes char-breathe {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-1px); }
    }

    /* === SLEEPING animation === */
    .char.sleeping {
      transform: rotate(90deg) translateY(5px);
      opacity: 0.35;
    }
    .char.sleeping .char-arm.left { transform: rotate(5deg); }
    .char.sleeping .char-arm.right { transform: rotate(-5deg); }

    .zzz {
      position: absolute;
      top: -8px;
      right: -4px;
      font-size: 0.5rem;
      color: #475569;
      animation: zzz-float 2.5s ease-in-out infinite;
      font-style: italic;
    }
    .zzz:nth-child(2) { right: -10px; top: -14px; font-size: 0.42rem; animation-delay: 0.8s; opacity: 0.6; }
    .zzz:nth-child(3) { right: -14px; top: -20px; font-size: 0.35rem; animation-delay: 1.6s; opacity: 0.3; }
    @keyframes zzz-float {
      0%, 100% { transform: translateY(0); opacity: 0.5; }
      50% { transform: translateY(-4px); opacity: 1; }
    }

    /* Arena cell action buttons */
    .arena-cell-actions {
      display: flex;
      justify-content: center;
      gap: 0.35rem;
      margin-bottom: 0.4rem;
      min-height: 22px;
    }
    .arena-btn {
      padding: 0.15rem 0.4rem;
      border-radius: 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.5rem;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
    }
    .arena-btn:hover { transform: scale(1.05); }
    .arena-btn-go {
      border-color: #22c55e44;
      background: #0a1a0f;
      color: #4ade80;
      font-size: 0.6rem;
      padding: 0.2rem 0.6rem;
    }
    .arena-btn-go:hover { border-color: #22c55e; box-shadow: 0 0 8px #22c55e22; }
    .arena-btn-console {
      border-color: #3b82f644;
      background: #0a0f1a;
      color: #60a5fa;
    }
    .arena-btn-spawn {
      border-color: #22c55e44;
      background: #0a1a0f;
      color: #4ade80;
    }
    .arena-btn-spawn:hover { border-color: #22c55e; }
    .arena-btn-stop {
      border-color: #ef444444;
      background: #1a0a0a;
      color: #f87171;
      font-size: 0.55rem;
    }
    .arena-btn-stop:hover { border-color: #ef4444; }

    /* Arena cell info bar */
    .arena-cell-meta {
      font-size: 0.52rem;
      color: #374151;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .arena-cell-meta .pending-badge {
      font-size: 0.52rem;
      font-weight: 700;
      padding: 0.08rem 0.3rem;
      border-radius: 3px;
    }

    /* ==================== KPI ROW ==================== */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 0.6rem;
      margin-bottom: 1.5rem;
    }
    .kpi-card {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 0.75rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      transition: border-color 0.2s;
      cursor: pointer;
      text-decoration: none;
    }
    .kpi-card:hover { border-color: #334155; }
    .kpi-label {
      font-size: 0.52rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #475569;
      font-weight: 600;
    }
    .kpi-value {
      font-size: 1.3rem;
      font-weight: 700;
      color: #e2e8f0;
      line-height: 1;
    }
    .kpi-sub {
      font-size: 0.52rem;
      color: #64748b;
    }
    .kpi-bar {
      height: 3px;
      border-radius: 2px;
      background: #1e293b;
      margin-top: 0.2rem;
      overflow: hidden;
    }
    .kpi-bar-fill {
      height: 100%;
      border-radius: 2px;
      transition: width 0.5s;
    }

    /* ==================== CONSOLE ==================== */
    .console-section {
      background: #0c1018;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      max-height: 450px;
    }
    .console-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 1rem;
      border-bottom: 1px solid #1e293b;
      background: #111827;
      flex-shrink: 0;
    }
    .console-title {
      font-size: 0.68rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      flex-shrink: 0;
    }
    .console-tabs {
      display: flex;
      gap: 0.25rem;
      flex: 1;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .console-tabs::-webkit-scrollbar { display: none; }
    .console-tab {
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.55rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      border: 1px solid transparent;
      background: transparent;
      color: #475569;
      font-family: 'JetBrains Mono', monospace;
      transition: all 0.15s;
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .console-tab:hover { background: #1a2332; color: #94a3b8; }
    .console-tab.active { background: #1e293b; color: #e2e8f0; border-color: #334155; }
    .console-tab .tab-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .console-tab .tab-dot.running { background: #22c55e; animation: pulse-glow 1.5s infinite; }
    .console-tab .tab-dot.stopped { background: #475569; }
    .console-tab .tab-lines {
      font-size: 0.45rem;
      color: #374151;
      font-weight: 400;
    }
    .console-status {
      font-size: 0.55rem;
      color: #374151;
      flex-shrink: 0;
      font-variant-numeric: tabular-nums;
    }
    .console-body {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem 0;
      font-size: 0.62rem;
      line-height: 1.5;
      min-height: 180px;
      max-height: 380px;
      scrollbar-width: thin;
      scrollbar-color: #1e293b transparent;
    }
    .console-body::-webkit-scrollbar { width: 6px; }
    .console-body::-webkit-scrollbar-track { background: transparent; }
    .console-body::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }
    .console-empty {
      text-align: center;
      padding: 2.5rem 1rem;
      color: #374151;
      font-size: 0.68rem;
    }
    .console-line {
      display: flex;
      gap: 0.5rem;
      padding: 0.08rem 1rem;
      font-family: 'JetBrains Mono', monospace;
      transition: background 0.1s;
    }
    .console-line:hover { background: #111827; }
    .console-line-ts {
      color: #1e293b;
      font-size: 0.52rem;
      flex-shrink: 0;
      min-width: 55px;
      font-variant-numeric: tabular-nums;
      padding-top: 0.05rem;
    }
    .console-line-text { color: #94a3b8; word-break: break-word; white-space: pre-wrap; }
    /* Level-based styling (from server) */
    .console-line-text.cl-tool { color: #64748b; font-size: 0.55rem; padding-left: 0.5rem; }
    .console-line-text.cl-result { color: #4ade80; font-weight: 600; background: #052e1633; padding: 0.12rem 0.4rem; border-radius: 3px; border-left: 3px solid #4ade80; }
    .console-line-text.cl-error { color: #f87171; font-weight: 700; background: #450a0a66; padding: 0.15rem 0.4rem; border-radius: 3px; border-left: 3px solid #f87171; }
    .console-line-text.cl-progress { color: #fbbf24; font-weight: 700; font-size: 0.68rem; margin-top: 0.3rem; }
    .console-line-text.cl-action { color: #e2e8f0; }
    .console-line-text.cl-cost { color: #a78bfa; font-weight: 600; font-size: 0.6rem; }
    .console-line-text.cl-info { color: #94a3b8; }
    .console-line.has-result { background: #0a1a0a; }
    .console-line.has-error { background: #1a0a0a; }
    .console-line.has-progress { background: #1a1a0a; }
    /* Filter: hide tool lines in essential mode */
    .console-body.filter-essential .console-line.level-tool { display: none; }
    .console-body.filter-essential .console-line.level-info { display: none; }
    /* Filter: show all in detail mode (default) */
    /* Filter: hide nothing in raw mode */
    /* Console filter bar */
    .console-filters {
      display: flex;
      gap: 0.2rem;
      flex-shrink: 0;
    }
    .console-filter-btn {
      padding: 0.12rem 0.4rem;
      border-radius: 3px;
      font-size: 0.5rem;
      font-weight: 600;
      cursor: pointer;
      border: 1px solid #1e293b;
      background: transparent;
      color: #475569;
      font-family: 'JetBrains Mono', monospace;
      transition: all 0.15s;
    }
    .console-filter-btn:hover { border-color: #334155; color: #94a3b8; }
    .console-filter-btn.active { background: #1e293b; color: #e2e8f0; border-color: #334155; }

    /* ==================== LOG FEED ==================== */
    .log-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
    }
    .log-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1rem;
      border-bottom: 1px solid #1e293b;
    }
    .log-title {
      font-size: 0.68rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .log-live {
      font-size: 0.6rem;
      color: #22c55e;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .log-live .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-glow 1.5s infinite;
    }
    .log-feed {
      max-height: 260px;
      overflow-y: auto;
      padding: 0.25rem 0;
      scrollbar-width: thin;
      scrollbar-color: #1e293b transparent;
    }
    .log-feed::-webkit-scrollbar { width: 6px; }
    .log-feed::-webkit-scrollbar-track { background: transparent; }
    .log-feed::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }
    .log-entry {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      padding: 0.3rem 1rem;
      font-size: 0.65rem;
      transition: background 0.1s;
      animation: log-appear 0.3s ease-out;
    }
    .log-entry:hover { background: #1a2332; }
    @keyframes log-appear {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .log-time { color: #374151; font-variant-numeric: tabular-nums; flex-shrink: 0; min-width: 58px; }
    .log-agent-tag {
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      font-size: 0.58rem;
      font-weight: 700;
      text-transform: uppercase;
      flex-shrink: 0;
      min-width: 64px;
      text-align: center;
    }
    .tag-seo-audit { background: #1e3a5f; color: #38bdf8; }
    .tag-analytics { background: #1e3a1e; color: #4ade80; }
    .tag-fact-check { background: #3a2e1e; color: #fbbf24; }
    .tag-opportunities { background: #2e1e3a; color: #c084fc; }
    .tag-editorial { background: #1e2e3a; color: #67e8f9; }
    .log-message { color: #94a3b8; flex: 1; }
    .log-status {
      font-size: 0.58rem;
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .ls-success { background: #052e16; color: #4ade80; }
    .ls-error { background: #450a0a; color: #f87171; }
    .log-empty {
      text-align: center;
      padding: 1.5rem;
      color: #374151;
      font-size: 0.72rem;
    }

    /* Server warning */
    .server-warning {
      display: none;
      background: #1a1508;
      border: 1px solid #eab30844;
      border-radius: 8px;
      padding: 0.5rem 1rem;
      margin-bottom: 1rem;
      font-size: 0.62rem;
      color: #fbbf24;
      text-align: center;
    }

    @media (max-width: 1024px) { .admin-layout { margin-left: 0; padding-top: 56px; } }
    @media (max-width: 768px) {
      .mc-main { padding: 1rem; }
      .arena-grid { grid-template-columns: repeat(2, 1fr); }
      .ap-top { flex-direction: column; text-align: center; }
      .ap-stats { justify-content: center; }
      .ap-budget { align-items: center; }
      .kpi-row { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
