---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - GLP1 France</title>
  <style is:inline>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap');

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: #0a0e17;
      color: #c8d6e5;
      min-height: 100vh;
    }

    .admin-layout { margin-left: 260px; min-height: 100vh; }

    /* Header */
    .mc-header {
      background: linear-gradient(180deg, #0f1520 0%, #0a0e17 100%);
      border-bottom: 1px solid #1a2332;
      padding: 1.25rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mc-title {
      font-size: 1.2rem;
      font-weight: 700;
      color: #e2e8f0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .mc-title .pulse-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 8px #22c55e88;
      animation: pulse-glow 2s infinite;
    }
    .mc-status {
      font-size: 0.72rem;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .mc-clock {
      font-size: 0.85rem;
      color: #64748b;
      font-variant-numeric: tabular-nums;
    }

    @keyframes pulse-glow {
      0%, 100% { opacity: 1; box-shadow: 0 0 8px #22c55e88; }
      50% { opacity: 0.5; box-shadow: 0 0 4px #22c55e44; }
    }

    .mc-main { padding: 1.5rem 2rem; }

    /* Agent grid */
    .agents-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .agent-card {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 1rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .agent-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: #1e293b;
      transition: background 0.3s;
    }
    .agent-card.running { border-color: #22c55e44; box-shadow: 0 0 20px #22c55e11; }
    .agent-card.running::before { background: #22c55e; animation: scan-line 2s linear infinite; }
    .agent-card.completed::before { background: #3b82f6; }
    .agent-card.error { border-color: #ef444444; }
    .agent-card.error::before { background: #ef4444; }

    @keyframes scan-line {
      0% { background: linear-gradient(90deg, transparent, #22c55e, transparent); background-size: 200%; background-position: -100%; }
      100% { background: linear-gradient(90deg, transparent, #22c55e, transparent); background-size: 200%; background-position: 200%; }
    }

    .agent-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      margin-bottom: 0.75rem;
    }
    .icon-seo { background: #1e3a5f; color: #38bdf8; }
    .icon-analytics { background: #1e3a1e; color: #4ade80; }
    .icon-factcheck { background: #3a2e1e; color: #fbbf24; }
    .icon-opportunities { background: #2e1e3a; color: #c084fc; }
    .icon-editorial { background: #1e2e3a; color: #67e8f9; }

    .agent-name {
      font-size: 0.8rem;
      font-weight: 700;
      color: #e2e8f0;
      margin-bottom: 0.5rem;
    }

    .agent-status-line {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.6rem;
    }
    .status-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .si-idle { background: #475569; }
    .si-running { background: #22c55e; animation: pulse-glow 1.5s infinite; }
    .si-completed { background: #3b82f6; }
    .si-error { background: #ef4444; }
    .si-started { background: #eab308; animation: pulse-glow 1.5s infinite; }

    .status-text {
      font-size: 0.68rem;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .agent-card.running .status-text { color: #4ade80; }
    .agent-card.error .status-text { color: #f87171; }

    .agent-counters {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.35rem;
      margin-bottom: 0.6rem;
    }
    .counter {
      font-size: 0.68rem;
      color: #475569;
    }
    .counter strong {
      color: #94a3b8;
      font-size: 0.85rem;
      display: block;
    }

    .agent-last-action {
      font-size: 0.65rem;
      color: #374151;
      border-top: 1px solid #1e293b;
      padding-top: 0.5rem;
      min-height: 2.5em;
      line-height: 1.3;
    }

    /* Dep graph */
    .dep-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 1rem 1.5rem;
      margin-bottom: 1.5rem;
    }
    .dep-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }
    .dep-section svg { width: 100%; max-width: 800px; margin: 0 auto; display: block; }

    /* Log feed */
    .log-section {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 10px;
      overflow: hidden;
    }
    .log-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.25rem;
      border-bottom: 1px solid #1e293b;
    }
    .log-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #475569;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .log-live {
      font-size: 0.65rem;
      color: #22c55e;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .log-live .live-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse-glow 1.5s infinite;
    }

    .log-feed {
      max-height: 320px;
      overflow-y: auto;
      padding: 0.25rem 0;
      scrollbar-width: thin;
      scrollbar-color: #1e293b transparent;
    }
    .log-feed::-webkit-scrollbar { width: 6px; }
    .log-feed::-webkit-scrollbar-track { background: transparent; }
    .log-feed::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }

    .log-entry {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.35rem 1.25rem;
      font-size: 0.72rem;
      transition: background 0.1s;
      animation: log-appear 0.3s ease-out;
    }
    .log-entry:hover { background: #1a2332; }

    @keyframes log-appear {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .log-time {
      color: #374151;
      font-variant-numeric: tabular-nums;
      flex-shrink: 0;
      min-width: 62px;
    }
    .log-agent-tag {
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      flex-shrink: 0;
      min-width: 68px;
      text-align: center;
    }
    .tag-seo-audit { background: #1e3a5f; color: #38bdf8; }
    .tag-analytics { background: #1e3a1e; color: #4ade80; }
    .tag-fact-check { background: #3a2e1e; color: #fbbf24; }
    .tag-opportunities { background: #2e1e3a; color: #c084fc; }
    .tag-editorial { background: #1e2e3a; color: #67e8f9; }

    .log-message { color: #94a3b8; flex: 1; }
    .log-status {
      font-size: 0.62rem;
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
      font-weight: 600;
      flex-shrink: 0;
    }
    .ls-success { background: #052e16; color: #4ade80; }
    .ls-error { background: #450a0a; color: #f87171; }

    .log-empty {
      text-align: center;
      padding: 2rem;
      color: #374151;
      font-size: 0.78rem;
    }

    @media (max-width: 1024px) { .admin-layout { margin-left: 0; padding-top: 56px; } }
    @media (max-width: 1200px) { .agents-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 768px) {
      .mc-main { padding: 1rem; }
      .mc-header { padding: 1rem; flex-direction: column; gap: 0.5rem; }
      .agents-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) { .agents-grid { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="mc-header">
    <div class="mc-title">
      <span class="pulse-dot"></span>
      MISSION CONTROL
    </div>
    <div class="mc-status">GLP-1 France &mdash; Agent Supervision</div>
    <div class="mc-clock" id="clock"></div>
  </div>

  <div class="mc-main">
    <!-- Agent cards -->
    <div class="agents-grid" id="agentsGrid"></div>

    <!-- Dependency graph -->
    <div class="dep-section">
      <div class="dep-title">Dependances</div>
      <svg viewBox="0 0 800 160" xmlns="http://www.w3.org/2000/svg">
        <!-- SEO Audit → Dashboard -->
        <rect x="10" y="15" width="120" height="36" rx="6" fill="#111827" stroke="#1e3a5f" stroke-width="1"/>
        <text x="70" y="38" text-anchor="middle" font-size="10" font-weight="600" fill="#38bdf8" font-family="JetBrains Mono, monospace">SEO Audit</text>
        <line x1="130" y1="33" x2="680" y2="50" stroke="#1e293b" stroke-width="1" stroke-dasharray="4"/>
        <!-- Analytics → Dashboard -->
        <rect x="10" y="60" width="120" height="36" rx="6" fill="#111827" stroke="#1e3a1e" stroke-width="1"/>
        <text x="70" y="83" text-anchor="middle" font-size="10" font-weight="600" fill="#4ade80" font-family="JetBrains Mono, monospace">Analytics</text>
        <line x1="130" y1="78" x2="680" y2="60" stroke="#1e293b" stroke-width="1" stroke-dasharray="4"/>
        <!-- Dashboard -->
        <rect x="680" y="35" width="110" height="50" rx="6" fill="#111827" stroke="#22c55e44" stroke-width="1"/>
        <text x="735" y="65" text-anchor="middle" font-size="10" font-weight="600" fill="#22c55e" font-family="JetBrains Mono, monospace">Dashboard</text>
        <!-- Fact-Check → Editorial -->
        <rect x="10" y="110" width="120" height="36" rx="6" fill="#111827" stroke="#3a2e1e" stroke-width="1"/>
        <text x="70" y="133" text-anchor="middle" font-size="10" font-weight="600" fill="#fbbf24" font-family="JetBrains Mono, monospace">Fact-Check</text>
        <line x1="130" y1="128" x2="280" y2="128" stroke="#fbbf2466" stroke-width="1.5" marker-end="url(#arrowGold)"/>
        <!-- Tickets auto-approved -->
        <text x="205" y="120" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">tickets</text>
        <!-- Opportunities → Editorial -->
        <rect x="10" y="155" width="120" height="36" rx="6" fill="#111827" stroke="#2e1e3a" stroke-width="1"/>
        <text x="70" y="178" text-anchor="middle" font-size="10" font-weight="600" fill="#c084fc" font-family="JetBrains Mono, monospace">Opportunities</text>
        <line x1="130" y1="173" x2="280" y2="148" stroke="#c084fc66" stroke-width="1.5" marker-end="url(#arrowPurple)"/>
        <text x="205" y="168" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">sujets</text>
        <!-- Editorial -->
        <rect x="280" y="118" width="120" height="36" rx="6" fill="#111827" stroke="#1e2e3a" stroke-width="1"/>
        <text x="340" y="141" text-anchor="middle" font-size="10" font-weight="600" fill="#67e8f9" font-family="JetBrains Mono, monospace">Editorial</text>
        <line x1="400" y1="136" x2="490" y2="136" stroke="#67e8f966" stroke-width="1.5" marker-end="url(#arrowCyan)"/>
        <!-- Git + Deploy -->
        <rect x="490" y="118" width="100" height="36" rx="6" fill="#111827" stroke="#22c55e44" stroke-width="1"/>
        <text x="540" y="135" text-anchor="middle" font-size="9" font-weight="600" fill="#22c55e" font-family="JetBrains Mono, monospace">Git Push</text>
        <text x="540" y="147" text-anchor="middle" font-size="7" fill="#475569" font-family="JetBrains Mono, monospace">→ Deploy</text>
        <line x1="590" y1="136" x2="680" y2="80" stroke="#22c55e44" stroke-width="1" stroke-dasharray="4" marker-end="url(#arrowGreen)"/>
        <defs>
          <marker id="arrowGold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#fbbf24"/></marker>
          <marker id="arrowPurple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#c084fc"/></marker>
          <marker id="arrowCyan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#67e8f9"/></marker>
          <marker id="arrowGreen" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#22c55e"/></marker>
        </defs>
      </svg>
    </div>

    <!-- Live log feed -->
    <div class="log-section">
      <div class="log-header">
        <span class="log-title">Live Feed</span>
        <span class="log-live"><span class="live-dot"></span> Realtime</span>
      </div>
      <div class="log-feed" id="logFeed">
        <div class="log-empty">En attente de logs...</div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  const AGENTS = [
    { name: 'seo-audit', label: 'SEO Audit', icon: 'seo', desc: 'Crawl, meta, liens' },
    { name: 'analytics', label: 'Analytics', icon: 'analytics', desc: 'Keywords ranking' },
    { name: 'fact-check', label: 'Fact-Check', icon: 'factcheck', desc: 'Verification medicale' },
    { name: 'opportunities', label: 'Opportunities', icon: 'opportunities', desc: 'Tendances, gaps' },
    { name: 'editorial', label: 'Editorial', icon: 'editorial', desc: 'Redaction, corrections' },
  ];

  const TAG_CLASSES = {
    'seo-audit': 'tag-seo-audit',
    'analytics': 'tag-analytics',
    'fact-check': 'tag-fact-check',
    'opportunities': 'tag-opportunities',
    'editorial': 'tag-editorial',
  };

  function escapeHtml(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return 'jamais';
    const diff = Date.now() - new Date(dateStr).getTime();
    if (diff < 60000) return 'il y a < 1min';
    if (diff < 3600000) return 'il y a ' + Math.floor(diff / 60000) + 'min';
    if (diff < 86400000) return 'il y a ' + Math.floor(diff / 3600000) + 'h';
    return 'il y a ' + Math.floor(diff / 86400000) + 'j';
  }

  function formatDuration(ms) {
    if (!ms) return '';
    if (ms < 60000) return Math.round(ms / 1000) + 's';
    return Math.floor(ms / 60000) + 'min ' + Math.round((ms % 60000) / 1000) + 's';
  }

  function formatTime(dateStr) {
    if (!dateStr) return '--:--';
    return new Date(dateStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  async function supabaseFetch(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  // Clock
  function updateClock() {
    document.getElementById('clock').textContent = new Date().toLocaleString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  updateClock();
  setInterval(updateClock, 1000);

  // Agent cards
  async function loadAgents() {
    try {
      const runs = await supabaseFetch('agent_runs', 'select=*&order=started_at.desc&limit=50');
      const latest = {};
      for (const r of runs) {
        if (!latest[r.agent_name]) latest[r.agent_name] = r;
      }

      const grid = document.getElementById('agentsGrid');
      grid.innerHTML = AGENTS.map(a => {
        const run = latest[a.name];
        const status = run ? run.status : 'idle';
        const statusLabel = { completed: 'termine', running: 'en cours', started: 'demarre', error: 'erreur', idle: 'inactif' }[status] || status;
        const meta = run?.metadata || {};
        const items = run?.items_processed ?? '-';

        // Smart counters per agent using metadata
        let counter2Label = 'erreurs';
        let counter2Value = run?.items_errors ?? '-';
        if (a.name === 'seo-audit' && meta.critical !== undefined) {
          counter2Value = meta.critical || 0;
          counter2Label = 'critiques';
        } else if (a.name === 'fact-check' && meta.tickets_created !== undefined) {
          counter2Value = meta.tickets_created;
          counter2Label = 'tickets';
        } else if (a.name === 'analytics' && meta.positioned_keywords !== undefined) {
          counter2Value = meta.positioned_keywords;
          counter2Label = 'positionnes';
        } else if (a.name === 'opportunities' && meta.high_priority !== undefined) {
          counter2Value = meta.high_priority;
          counter2Label = 'prioritaires';
        } else if (a.name === 'editorial' && meta.tickets_corrected !== undefined) {
          counter2Value = meta.articles_created || 0;
          counter2Label = 'crees';
        }

        const duration = run?.duration_ms ? formatDuration(run.duration_ms)
          : (run?.started_at && run?.completed_at)
            ? formatDuration(new Date(run.completed_at) - new Date(run.started_at))
            : '';
        const lastTime = run?.completed_at
          ? timeAgo(run.completed_at)
          : run?.started_at
            ? timeAgo(run.started_at)
            : 'jamais lance';

        return `<div class="agent-card ${status}">
          <div class="agent-icon icon-${a.icon}">${a.label[0]}</div>
          <div class="agent-name">${a.label}</div>
          <div class="agent-status-line">
            <span class="status-indicator si-${status}"></span>
            <span class="status-text">${statusLabel.toUpperCase()}</span>
          </div>
          <div class="agent-counters">
            <div class="counter"><strong>${items}</strong>traites</div>
            <div class="counter"><strong>${counter2Value}</strong>${counter2Label}</div>
          </div>
          <div class="agent-last-action">${lastTime}${duration ? ' · ' + duration : ''}</div>
        </div>`;
      }).join('');
    } catch (e) {
      document.getElementById('agentsGrid').innerHTML = `<div style="grid-column:1/-1;color:#f87171;padding:1rem;font-size:0.8rem">Erreur: ${escapeHtml(e.message)}</div>`;
    }
  }

  // Log feed
  let lastLogId = null;

  async function loadLogs(append) {
    try {
      let query = 'select=*&order=created_at.desc&limit=50';
      const logs = await supabaseFetch('agent_logs', query);

      const feed = document.getElementById('logFeed');
      if (logs.length === 0) {
        if (!append) feed.innerHTML = '<div class="log-empty">En attente de logs...</div>';
        return;
      }

      if (append && lastLogId === logs[0].id) return; // no new logs
      lastLogId = logs[0].id;

      feed.innerHTML = logs.map(log => {
        const meta = log.metadata || {};
        const details = meta.action || meta.tickets_created !== undefined
          ? `${meta.action || ''} ${meta.tickets_created ? meta.tickets_created + ' tickets' : ''} ${meta.score ? 'score:' + meta.score : ''}`.trim()
          : '';
        const tagClass = TAG_CLASSES[log.agent_type] || 'tag-seo-audit';
        const statusClass = log.status === 'success' ? 'ls-success' : 'ls-error';

        return `<div class="log-entry">
          <span class="log-time">${formatTime(log.created_at)}</span>
          <span class="log-agent-tag ${tagClass}">${escapeHtml(log.agent_type)}</span>
          <span class="log-message">${escapeHtml(details || '-')}</span>
          <span class="log-status ${statusClass}">${escapeHtml(log.status)}</span>
        </div>`;
      }).join('');
    } catch (e) {
      // silent fail on polling
    }
  }

  // Realtime via Supabase
  function setupRealtime() {
    // Use Supabase Realtime WebSocket for live updates
    const wsUrl = SUPABASE_URL.replace('https://', 'wss://') + '/realtime/v1/websocket?apikey=' + SUPABASE_ANON_KEY + '&vsn=1.0.0';
    let ws;

    function connect() {
      ws = new WebSocket(wsUrl);

      ws.onopen = () => {
        // Join agent_runs channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_runs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_runs' }] } },
          ref: '1'
        }));
        // Join agent_logs channel
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_logs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_logs' }] } },
          ref: '2'
        }));
        // Heartbeat
        setInterval(() => {
          if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ topic: 'phoenix', event: 'heartbeat', payload: {}, ref: 'hb' }));
          }
        }, 30000);
      };

      ws.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.event === 'postgres_changes') {
            // Reload on any change
            loadAgents();
            loadLogs(true);
          }
        } catch(e) {}
      };

      ws.onclose = () => {
        // Reconnect after 3s
        setTimeout(connect, 3000);
      };

      ws.onerror = () => ws.close();
    }

    connect();
  }

  // Polling every 5s for reliable updates
  setInterval(() => {
    loadAgents();
    loadLogs(true);
  }, 5000);

  // Init
  loadAgents();
  loadLogs(false);
  setupRealtime();
</script>

</body>
</html>
