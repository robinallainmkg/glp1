<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  // Agent definitions with colors
  const ARENA_AGENTS = [
    { key: 'fact-check', label: 'Fact-Check', color: '#fbbf24', icon: '&#10003;', desc: 'Verification medicale' },
    { key: 'seo-audit', label: 'SEO Audit', color: '#38bdf8', icon: '&#128269;', desc: 'Crawl, meta, liens' },
    { key: 'analytics', label: 'Analytics', color: '#4ade80', icon: '&#128202;', desc: 'Keywords ranking' },
    { key: 'opportunities', label: 'Opportunites', color: '#c084fc', icon: '&#128161;', desc: 'Gaps, tendances' },
    { key: 'internal-links', label: 'Maillage', color: '#f9a8d4', icon: '&#128279;', desc: 'Liens internes' },
    { key: 'editorial', label: 'Editorial', color: '#67e8f9', icon: '&#9997;', desc: 'Redaction, corrections' },
    { key: 'validator', label: 'Validator', color: '#86efac', icon: '&#128737;', desc: 'Build, qualite' },
    { key: 'ui-designer', label: 'UI Designer', color: '#ec4899', icon: '&#127912;', desc: 'Design, UX' },
  ];

  const TAG_CLASSES = {
    'seo-audit': 'tag-seo-audit',
    'analytics': 'tag-analytics',
    'fact-check': 'tag-fact-check',
    'opportunities': 'tag-opportunities',
    'editorial': 'tag-editorial',
    'validator': 'tag-seo-audit',
    'internal-links': 'tag-analytics',
  };

  function escapeHtml(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return 'jamais';
    const diff = Date.now() - new Date(dateStr).getTime();
    if (diff < 60000) return '< 1min';
    if (diff < 3600000) return Math.floor(diff / 60000) + 'min';
    if (diff < 86400000) return Math.floor(diff / 3600000) + 'h';
    return Math.floor(diff / 86400000) + 'j';
  }

  function formatDuration(ms) {
    if (!ms) return '';
    if (ms < 60000) return Math.round(ms / 1000) + 's';
    return Math.floor(ms / 60000) + 'min ' + Math.round((ms % 60000) / 1000) + 's';
  }

  function formatTime(dateStr) {
    if (!dateStr) return '--:--';
    return new Date(dateStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  // ========== SUPABASE ==========
  async function supabaseFetch(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SUPABASE_ANON_KEY, 'Authorization': `Bearer ${SUPABASE_ANON_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function supabaseFetchCount(table, query) {
    const r = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Prefer': 'count=exact',
        'Range-Unit': 'items',
        'Range': '0-0'
      }
    });
    if (!r.ok) return 0;
    const range = r.headers.get('content-range');
    if (range) {
      const total = range.split('/')[1];
      return total === '*' ? 0 : parseInt(total);
    }
    return 0;
  }

  // ========== AGENT SERVER ==========
  const AGENT_SERVER = '/__agent';
  let serverOnline = false;
  let runningAgents = {};
  let serverStatus = null;

  async function checkServer() {
    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 2000);
      const r = await fetch(`${AGENT_SERVER}/status`, { signal: ctrl.signal });
      clearTimeout(timer);
      const data = await r.json();
      serverOnline = true;
      serverStatus = data;
      runningAgents = data.running || {};
      window._serverBuffers = data.buffers || {};
      window._serverCosts = data.costs || {};
      window._serverTotalCost = data.totalCost || 0;
      renderConsoleTabs();
    } catch(e) {
      serverOnline = false;
      runningAgents = {};
    }
    document.getElementById('serverWarning').style.display = serverOnline ? 'none' : 'block';
  }

  async function launchAgent(name) {
    if (!serverOnline) {
      alert('Agent Server non connecte !\n\nLance: node scripts/agent-server.mjs');
      return;
    }
    if (runningAgents[name]) return;
    try {
      const r = await fetch(`${AGENT_SERVER}/launch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name })
      });
      const data = await r.json();
      if (!data.ok) { alert('Erreur: ' + data.error); return; }
      await checkServer();
      await loadAgentRuns();
      renderArena();
    } catch(e) { alert('Erreur: ' + e.message); }
  }

  async function stopAgent(name) {
    try {
      await fetch(`${AGENT_SERVER}/stop`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name })
      });
      await checkServer();
      await loadAgentRuns();
      renderArena();
    } catch(e) {}
  }

  // ========== AUTOPILOT ==========
  let autopilotRunning = false;

  async function toggleAutopilot() {
    if (autopilotRunning) {
      if (!confirm('Stopper l\'Autopilot ? Tous les agents en cours seront tués.')) return;
      try {
        const r = await fetch(`${AGENT_SERVER}/autopilot/stop`, { method: 'POST' });
        const data = await r.json();
        if (data.killed && data.killed.length > 0) {
          console.log('Autopilot stopped, killed agents:', data.killed);
          // Clear local running state for killed agents
          for (const name of data.killed) {
            delete runningAgents[name];
          }
        }
        autopilotRunning = false;
        updateAutopilotUI();
        renderArena();
      } catch(e) { stopAgent('autopilot'); }
    } else {
      if (!serverOnline) {
        alert('Agent Server non connecte !\n\nLance: node scripts/agent-server.mjs');
        return;
      }
      try {
        const r = await fetch(`${AGENT_SERVER}/autopilot/start`, { method: 'POST' });
        const data = await r.json();
        if (!data.ok) alert('Erreur: ' + data.message);
      } catch(e) { alert('Erreur: ' + e.message); }
    }
  }

  function updateAutopilotUI() {
    const hero = document.getElementById('autopilotHero');
    const btn = document.getElementById('apBigBtn');
    const label = document.getElementById('apBtnLabel');
    const badge = document.getElementById('apBadge');

    // Check autopilot state from server
    autopilotRunning = !!runningAgents['autopilot'] || (serverStatus && serverStatus.autopilot && serverStatus.autopilot.enabled);

    if (autopilotRunning) {
      hero.classList.add('is-running');
      btn.classList.add('running');
      btn.innerHTML = '&#9632;';
      label.textContent = 'Stopper';
      badge.className = 'ap-status-badge running';
      const ap = serverStatus && serverStatus.autopilot;
      const cycle = ap ? ap.cycle : '';
      const phase = ap ? (ap.phase || '') : '';
      const phaseLabels = { check: 'CHECK', generate: 'GENERATE', edit: 'EDIT', validate: 'VALIDATE', done: 'DONE' };
      const phaseLabel = phaseLabels[phase] || phase.toUpperCase();
      badge.textContent = cycle ? `CYCLE ${cycle} · ${phaseLabel}` : 'RUNNING';
    } else {
      hero.classList.remove('is-running');
      btn.classList.remove('running');
      btn.innerHTML = '&#9654;';
      label.textContent = 'Lancer';

      const apRun = agentRuns['autopilot'];
      if (apRun) {
        badge.className = 'ap-status-badge idle';
        badge.textContent = 'LAST: ' + timeAgo(apRun.completed_at || apRun.started_at);
      } else {
        badge.className = 'ap-status-badge idle';
        badge.textContent = 'IDLE';
      }
    }

    // Active agents count
    const activeCount = Object.keys(runningAgents).filter(k => k !== 'autopilot').length;
    document.getElementById('apAgentsActive').textContent = activeCount;

    // Token estimation per agent type (tokens/minute based on observed patterns)
    // Claude Max: rolling window — tokens consumed > WINDOW hours ago are recovered
    const TOKEN_RATE_PER_MIN = {
      'editorial': 8000, 'validator': 6000, 'fact-check': 10000,
      'seo-audit': 5000, 'analytics': 4000, 'opportunities': 5000,
      'internal-links': 4000, 'ui-designer': 7000, 'strategist': 3000,
      'sav-email': 5000, 'autopilot': 2000,
    };
    const ROLLING_WINDOW_H = 5;
    const MAX_TOKENS = 5000000;
    const windowMs = ROLLING_WINDOW_H * 3600000;
    const now = Date.now();

    // Estimate tokens per run with age tracking
    const runTokens = Object.values(agentRuns).map(r => {
      const startT = new Date(r.started_at).getTime();
      const endT = r.completed_at ? new Date(r.completed_at).getTime() : now;
      const durationMin = Math.min(30, (endT - startT) / 60000);
      const rate = TOKEN_RATE_PER_MIN[r.agent_name] || 5000;
      const tokens = Math.round(rate * durationMin);
      const age = now - endT; // ms since run ended
      return { tokens, age, startT, endT, agent: r.agent_name };
    });

    // Current window: only runs that ended within the rolling window
    const inWindow = runTokens.filter(r => r.age < windowMs);
    const estimatedTokens = inWindow.reduce((s, r) => s + r.tokens, 0);

    // Tokens recovering soon (runs ending 4-5h ago, about to fall off)
    const recoveringSoon = inWindow.filter(r => r.age > (windowMs - 3600000)); // last hour of window
    const recoveryPerHour = recoveringSoon.reduce((s, r) => s + r.tokens, 0);

    // Active burn: tokens from runs started in last 30min (currently consuming)
    const activeBurn = inWindow.filter(r => (now - r.startT) < 1800000);
    const activeBurnPerMin = activeBurn.reduce((s, r) => {
      const rate = TOKEN_RATE_PER_MIN[r.agent] || 5000;
      // If still running, it's actively burning
      return s + (r.age < 0 || !r.endT ? rate : 0);
    }, 0);

    const budgetFill = document.getElementById('apBudgetFill');
    const budgetVal = document.getElementById('apBudgetVal');
    const tokenPct = Math.min(100, Math.round(estimatedTokens / MAX_TOKENS * 100));
    const tokenDisplay = estimatedTokens > 1000000
      ? (estimatedTokens / 1000000).toFixed(1) + 'M'
      : Math.round(estimatedTokens / 1000) + 'k';
    const recoveryDisplay = recoveryPerHour > 1000
      ? Math.round(recoveryPerHour / 1000) + 'k'
      : recoveryPerHour.toString();
    budgetFill.style.width = tokenPct + '%';
    budgetFill.style.background = tokenPct > 80 ? '#f87171' : tokenPct > 50 ? '#fbbf24' : '#3b82f6';
    budgetVal.innerHTML = `~${tokenDisplay} / 5M · ${inWindow.length} runs · <span style="color:#4ade80">↻${recoveryDisplay} recup/h</span>`;

    const budgetLabel = document.querySelector('.ap-budget-label');
    if (budgetLabel) {
      budgetLabel.textContent = tokenPct >= 80 ? '⚠ TOKENS (ralentir)' : tokenPct >= 50 ? '◐ TOKENS' : '● TOKENS';
      budgetLabel.style.color = tokenPct > 80 ? '#f87171' : tokenPct > 50 ? '#fbbf24' : '#475569';
    }

    // ---- BURN RATE (net: consumption - recovery) ----
    if (!window._tokenSnapshots) window._tokenSnapshots = [];
    const snapshots = window._tokenSnapshots;
    snapshots.push({ t: now, tokens: estimatedTokens, activeAgents: activeBurn.length });
    while (snapshots.length > 0 && (now - snapshots[0].t) > 300000) snapshots.shift();

    const burnFill = document.getElementById('apBurnFill');
    const burnVal = document.getElementById('apBurnVal');
    const burnLabel = document.getElementById('apBurnLabel');

    if (snapshots.length >= 2) {
      let refSnap = snapshots[0];
      for (const s of snapshots) {
        if ((now - s.t) >= 60000) refSnap = s;
      }
      const dtMin = (now - refSnap.t) / 60000;
      const dTokens = estimatedTokens - refSnap.tokens;

      if (dtMin > 0.3) {
        const grossBurn = Math.round(dTokens / dtMin); // observed change per min
        const recoveryPerMin = Math.round(recoveryPerHour / 60);
        const netBurn = grossBurn; // already net (estimatedTokens accounts for window)
        const fmtRate = (v) => Math.abs(v) > 1000 ? Math.round(v / 1000) + 'k' : v.toString();

        const MAX_BURN = 100000;
        const burnPct = Math.min(100, Math.round(Math.abs(netBurn) / MAX_BURN * 100));
        burnFill.style.width = burnPct + '%';

        if (netBurn > 50000) {
          burnFill.style.background = '#f87171';
          burnLabel.textContent = '🔥 BURN RATE';
          burnLabel.style.color = '#f87171';
        } else if (netBurn > 20000) {
          burnFill.style.background = '#fbbf24';
          burnLabel.textContent = '◐ BURN RATE';
          burnLabel.style.color = '#fbbf24';
        } else if (netBurn > 0) {
          burnFill.style.background = '#3b82f6';
          burnLabel.textContent = '● BURN RATE';
          burnLabel.style.color = '#475569';
        } else if (netBurn < -1000) {
          // Recovering! More tokens falling off than being consumed
          burnFill.style.background = '#22c55e';
          burnLabel.textContent = '♻ RECOVERING';
          burnLabel.style.color = '#22c55e';
        } else {
          burnFill.style.background = '#1e293b';
          burnLabel.textContent = '○ BURN RATE';
          burnLabel.style.color = '#334155';
        }

        const remaining = MAX_TOKENS - estimatedTokens;
        if (netBurn > 0 && remaining > 0) {
          const minsLeft = Math.round(remaining / netBurn);
          const hLeft = Math.floor(minsLeft / 60);
          const mLeft = minsLeft % 60;
          const timeStr = hLeft > 0 ? `${hLeft}h${mLeft.toString().padStart(2,'0')}` : `${mLeft}min`;
          const color = minsLeft < 30 ? '#f87171' : minsLeft < 120 ? '#fbbf24' : '#4ade80';
          burnVal.innerHTML = `${fmtRate(netBurn)} tok/min · <span style="color:${color}">${timeStr} restant</span>`;
        } else if (netBurn < -1000) {
          burnVal.innerHTML = `<span style="color:#4ade80">+${fmtRate(Math.abs(netBurn))} tok/min recup</span> · capacite en hausse`;
        } else if (netBurn <= 0) {
          burnVal.textContent = 'idle — tokens se recuperent';
        } else {
          burnVal.textContent = `${fmtRate(netBurn)} tok/min`;
        }
      } else {
        burnVal.textContent = 'mesure en cours...';
      }
    } else {
      burnVal.textContent = 'en attente (30s)...';
    }
  }

  // ========== CHARACTER HTML BUILDER ==========
  function buildCharacter(state, color, index) {
    const delayClass = 'd' + ((index % 4) + 1);
    const style = `--agent-color:${color}`;

    if (state === 'sleeping') {
      return `<div class="char sleeping" style="${style}">
        <span class="zzz">z</span><span class="zzz">z</span><span class="zzz">z</span>
        <div class="char-head"></div>
        <div class="char-body">
          <div class="char-arms">
            <div class="char-arm left"></div>
            <div class="char-arm right"></div>
          </div>
        </div>
        <div class="char-legs">
          <div class="char-leg left"></div>
          <div class="char-leg right"></div>
        </div>
      </div>`;
    }

    if (state === 'dancing') {
      return `<div class="char dancing ${delayClass}" style="${style}">
        <div class="char-head"></div>
        <div class="char-body">
          <div class="char-arms">
            <div class="char-arm left"></div>
            <div class="char-arm right"></div>
          </div>
        </div>
        <div class="char-legs">
          <div class="char-leg left"></div>
          <div class="char-leg right"></div>
        </div>
      </div>`;
    }

    // idle
    return `<div class="char idle" style="${style}">
      <div class="char-head"></div>
      <div class="char-body">
        <div class="char-arms">
          <div class="char-arm left"></div>
          <div class="char-arm right"></div>
        </div>
      </div>
      <div class="char-legs">
        <div class="char-leg left"></div>
        <div class="char-leg right"></div>
      </div>
    </div>`;
  }

  // ========== ARENA RENDERING ==========
  let arenaPendingCounts = {};

  function renderArena() {
    const grid = document.getElementById('arenaGrid');
    if (!grid) return;

    grid.innerHTML = ARENA_AGENTS.map(agent => {
      const run = agentRuns[agent.key];
      const hasRun = !!run;
      const pending = arenaPendingCounts[agent.key] || 0;

      // Count running instances
      let activeInstances = 0;
      const instanceNames = [];
      for (const k of Object.keys(runningAgents)) {
        if (k === agent.key || k.startsWith(agent.key + '-')) {
          activeInstances++;
          instanceNames.push(k);
        }
      }

      // Determine character states
      let characters = '';
      if (activeInstances > 0) {
        for (let i = 0; i < activeInstances; i++) {
          characters += buildCharacter('dancing', agent.color, i);
        }
        // Hint: sleeping bonhomme if lots of pending work
        if (pending > 10 && activeInstances < 3) {
          characters += buildCharacter('sleeping', agent.color, activeInstances);
        }
      } else if (hasRun) {
        characters += buildCharacter('idle', agent.color, 0);
      } else {
        characters += buildCharacter('sleeping', agent.color, 0);
      }

      // Cost from server
      const cost = window._serverCosts?.[agent.key] || 0;
      const costHtml = cost > 0 ? `<span style="font-size:0.45rem;color:#475569">$${cost.toFixed(2)}</span>` : '';

      // Pending badge
      let pendingHtml = '';
      if (pending > 0) {
        pendingHtml = `<span class="pending-badge" style="background:${agent.color}22;color:${agent.color}">${pending} en attente</span>`;
      }

      // Meta left
      let metaLeft = '';
      if (activeInstances > 0) {
        const uptime = runningAgents[agent.key]?.uptime || '';
        metaLeft = uptime || 'en cours...';
      } else if (hasRun) {
        metaLeft = timeAgo(run.completed_at || run.started_at);
      } else {
        metaLeft = 'jamais lance';
      }

      const countBadge = activeInstances > 0
        ? `<span class="arena-cell-count active" style="--agent-color:${agent.color}">x${activeInstances}</span>`
        : `<span class="arena-cell-count zero">x0</span>`;

      // Action buttons — inline, no more prompt()
      let btns = '';
      if (serverOnline) {
        if (activeInstances === 0) {
          btns = `<button class="arena-btn arena-btn-go" onclick="event.stopPropagation();launchAgent('${agent.key}')" title="Lancer">+</button>`;
        } else {
          // Show console button + spawn more button
          btns = `<button class="arena-btn arena-btn-console" onclick="event.stopPropagation();selectConsoleAgent('${instanceNames[0]}')" title="Console">&#128187;</button>`
            + `<button class="arena-btn arena-btn-spawn" onclick="event.stopPropagation();launchAgentMulti('${agent.key}')" title="Spawner +1">+1</button>`
            + `<button class="arena-btn arena-btn-stop" onclick="event.stopPropagation();stopAllInstances('${agent.key}')" title="Stopper tout">&#9632;</button>`;
        }
      }

      return `<div class="arena-cell ${activeInstances > 0 ? 'has-active' : ''}" style="--agent-color:${agent.color}" onclick="selectConsoleAgent('${instanceNames[0] || agent.key}')">
        <div class="arena-cell-header">
          <span class="arena-cell-name">${agent.label}</span>
          ${costHtml}
          ${countBadge}
        </div>
        <div class="arena-stage">${characters}</div>
        <div class="arena-cell-actions">${btns}</div>
        <div class="arena-cell-meta">
          <span>${metaLeft}</span>
          ${pendingHtml}
        </div>
      </div>`;
    }).join('');
  }

  async function launchAgentMulti(name) {
    if (!serverOnline) return;
    try {
      const r = await fetch(`${AGENT_SERVER}/launch`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ agent: name, allowMultiple: true })
      });
      const data = await r.json();
      if (!data.ok) { alert('Erreur: ' + data.error); return; }
      await checkServer();
      await loadAgentRuns();
      renderArena();
    } catch(e) { alert('Erreur: ' + e.message); }
  }

  async function stopAllInstances(baseKey) {
    for (const k of Object.keys(runningAgents)) {
      if (k === baseKey || k.startsWith(baseKey + '-')) {
        await stopAgent(k);
      }
    }
    renderArena();
  }

  window.launchAgent = launchAgent;
  window.stopAgent = stopAgent;
  window.launchAgentMulti = launchAgentMulti;
  window.stopAllInstances = stopAllInstances;

  // ========== LOAD DATA ==========
  let agentRuns = {};

  async function loadAgentRuns() {
    try {
      const runs = await supabaseFetch('agent_runs', 'select=*&order=started_at.desc&limit=50');
      const latest = {};
      for (const r of runs) {
        if (!latest[r.agent_name]) latest[r.agent_name] = r;
      }
      agentRuns = latest;

      // Update autopilot stats
      const apRun = latest['autopilot'];
      if (apRun && apRun.metadata) {
        const m = apRun.metadata;
        if (m.cycle) document.getElementById('apCycle').textContent = m.cycle;
      }
      const apLast = document.getElementById('apLastRun');
      if (apRun) apLast.textContent = timeAgo(apRun.completed_at || apRun.started_at);

      // Tickets processed 24h
      const processed24h = runs.filter(r => {
        const age = Date.now() - new Date(r.started_at).getTime();
        return age < 86400000 && r.metadata?.items_processed;
      }).reduce((sum, r) => sum + (r.metadata.items_processed || 0), 0);
      document.getElementById('apTicketsProcessed').textContent = processed24h || '--';

      updateAutopilotUI();
      renderArena();
    } catch (e) {}
  }

  async function loadPendingCounts() {
    try {
      const [tickets, links, opps] = await Promise.all([
        supabaseFetch('correction_tickets', 'select=source_agent,statut&statut=eq.approved'),
        supabaseFetchCount('internal_link_suggestions', 'status=eq.approved'),
        supabaseFetchCount('content_opportunities', 'status=eq.approved'),
      ]);

      // Count tickets by source
      const bySource = {};
      for (const t of tickets) {
        const src = t.source_agent || 'fact-check';
        bySource[src] = (bySource[src] || 0) + 1;
      }

      arenaPendingCounts = {
        'fact-check': bySource['fact-check'] || 0,
        'seo-audit': bySource['seo-audit'] || 0,
        'analytics': bySource['analytics'] || 0,
        'validator': bySource['validator'] || 0,
        'internal-links': links,
        'opportunities': opps,
        'editorial': (tickets.length || 0) + links + opps,
      };

      renderArena();
    } catch(e) {}
  }

  // ========== KPIs ==========
  async function loadHealthKPIs() {
    try {
      const [articles, seoTickets, keywords, opps, ticketsAll] = await Promise.all([
        supabaseFetch('articles', 'select=id,is_active,last_fact_checked&is_active=eq.true'),
        supabaseFetch('correction_tickets', 'select=id,statut,source_agent&source_agent=eq.seo-audit'),
        supabaseFetch('keyword_rankings', 'select=keyword,position,checked_at&order=checked_at.desc&limit=500'),
        supabaseFetch('content_opportunities', 'select=id,status'),
        supabaseFetch('correction_tickets', 'select=id,statut,created_at'),
      ]);

      // Articles
      document.getElementById('kpiArticles').textContent = articles.length;
      const now = Date.now();
      const recent = articles.filter(a => a.last_fact_checked && (now - new Date(a.last_fact_checked).getTime()) < 14 * 86400000).length;
      document.getElementById('kpiArticlesSub').innerHTML = `<span style="color:#4ade80">${recent}</span> verifies < 14j`;

      // Fact-check coverage
      const verified = articles.filter(a => a.last_fact_checked && (now - new Date(a.last_fact_checked).getTime()) < 14 * 86400000).length;
      const pct = articles.length > 0 ? Math.round(verified / articles.length * 100) : 0;
      document.getElementById('kpiFactCheck').textContent = pct + '%';
      document.getElementById('kpiFactCheckSub').textContent = `${verified}/${articles.length} < 14j`;
      document.getElementById('kpiFactCheckBar').style.width = pct + '%';
      document.getElementById('kpiFactCheckBar').style.background = pct > 70 ? '#22c55e' : pct > 40 ? '#fbbf24' : '#f87171';

      // SEO
      const seoApproved = seoTickets.filter(t => t.statut === 'approved').length;
      const seoDone = seoTickets.filter(t => t.statut === 'deployed' || t.statut === 'ready_to_deploy').length;
      document.getElementById('kpiSeoIssues').textContent = seoApproved;
      document.getElementById('kpiSeoIssues').style.color = seoApproved > 0 ? '#f87171' : '#22c55e';
      document.getElementById('kpiSeoSub').textContent = seoApproved > 0 ? `a corriger (${seoDone}/${seoTickets.length} resolus)` : `OK (${seoTickets.length} total)`;
      const seoPct = seoTickets.length > 0 ? Math.round(seoDone / seoTickets.length * 100) : 100;
      document.getElementById('kpiSeoBar').style.width = seoPct + '%';

      // Keywords
      const latestKw = {};
      for (const k of keywords) { if (!latestKw[k.keyword]) latestKw[k.keyword] = k; }
      const uniqueKw = Object.values(latestKw);
      const top10 = uniqueKw.filter(k => k.position && k.position <= 10).length;
      const avgPos = uniqueKw.length > 0 ? (uniqueKw.reduce((s, k) => s + (k.position || 100), 0) / uniqueKw.length).toFixed(1) : '--';
      document.getElementById('kpiKeywords').textContent = top10;
      document.getElementById('kpiKeywordsSub').innerHTML = `/${uniqueKw.length} &middot; moy ${avgPos}`;
      document.getElementById('kpiKeywordsBar').style.width = (uniqueKw.length > 0 ? Math.round(top10 / uniqueKw.length * 100) : 0) + '%';

      // Opps
      const oppApproved = opps.filter(o => o.status === 'approved').length;
      const oppPublished = opps.filter(o => o.status === 'published').length;
      document.getElementById('kpiOpps').textContent = oppApproved;
      document.getElementById('kpiOppsSub').innerHTML = `en attente &middot; <span style="color:#4ade80">${oppPublished} publiees</span>`;

      // Throughput
      const last7d = now - 7 * 86400000;
      const last24h = now - 86400000;
      const deployedRecent = ticketsAll.filter(t => t.statut === 'deployed' && new Date(t.created_at).getTime() > last7d).length;
      const pendingAll = ticketsAll.filter(t => t.statut === 'approved').length;
      const inProgress = ticketsAll.filter(t => t.statut === 'in_progress').length;
      document.getElementById('kpiThroughput').textContent = deployedRecent;
      document.getElementById('kpiThroughputSub').innerHTML = `deployes &middot; <span style="color:#fbbf24">${pendingAll} en stock</span>`;
      // Throughput bar: ratio deployed vs total active
      const totalActive = pendingAll + inProgress + deployedRecent;
      const throughputPct = totalActive > 0 ? Math.round(deployedRecent / totalActive * 100) : 0;
      document.getElementById('kpiThroughputBar').style.width = throughputPct + '%';
      document.getElementById('kpiThroughputBar').style.background = throughputPct > 70 ? '#22c55e' : throughputPct > 40 ? '#fbbf24' : '#f87171';

      // Debit / Charge — tickets created vs resolved last 24h
      const created24h = ticketsAll.filter(t => new Date(t.created_at).getTime() > last24h).length;
      const resolved24h = ticketsAll.filter(t => (t.statut === 'deployed' || t.statut === 'ready_to_deploy') && new Date(t.created_at).getTime() > last24h).length;
      const ratio = created24h > 0 ? (resolved24h / created24h) : (resolved24h > 0 ? 99 : 0);
      const ratioDisplay = created24h > 0 ? ratio.toFixed(1) + 'x' : '--';
      document.getElementById('kpiEfficiency').textContent = ratioDisplay;
      document.getElementById('kpiEfficiency').style.color = ratio >= 1 ? '#22c55e' : ratio >= 0.5 ? '#fbbf24' : '#f87171';
      document.getElementById('kpiEfficiencySub').innerHTML = `<span style="color:#4ade80">↑${resolved24h}</span> resolus &middot; <span style="color:#f87171">↓${created24h}</span> crees (24h)`;
      const effPct = Math.min(100, Math.round(ratio * 50));
      document.getElementById('kpiEfficiencyBar').style.width = effPct + '%';
      document.getElementById('kpiEfficiencyBar').style.background = ratio >= 1 ? '#22c55e' : ratio >= 0.5 ? '#fbbf24' : '#f87171';
    } catch(e) {}
  }

  // ========== LOG FEED ==========
  let lastLogId = null;

  async function loadLogs(append) {
    try {
      const logs = await supabaseFetch('agent_logs', 'select=*&order=created_at.desc&limit=50');
      const feed = document.getElementById('logFeed');
      if (logs.length === 0) {
        if (!append) feed.innerHTML = '<div class="log-empty">En attente de logs...</div>';
        return;
      }
      if (append && lastLogId === logs[0].id) return;
      lastLogId = logs[0].id;

      feed.innerHTML = logs.map(log => {
        const meta = log.metadata || {};
        const details = meta.action || meta.tickets_created !== undefined
          ? `${meta.action || ''} ${meta.tickets_created ? meta.tickets_created + ' tickets' : ''} ${meta.score ? 'score:' + meta.score : ''}`.trim()
          : '';
        const tagClass = TAG_CLASSES[log.agent_type] || 'tag-seo-audit';
        const statusClass = log.status === 'success' ? 'ls-success' : 'ls-error';

        return `<div class="log-entry">
          <span class="log-time">${formatTime(log.created_at)}</span>
          <span class="log-agent-tag ${tagClass}">${escapeHtml(log.agent_type)}</span>
          <span class="log-message">${escapeHtml(details || '-')}</span>
          <span class="log-status ${statusClass}">${escapeHtml(log.status)}</span>
        </div>`;
      }).join('');
    } catch (e) {}
  }

  // ========== AGENT CONSOLE ==========
  let consoleAgent = null;
  let consoleSince = 0;
  let consoleAutoScroll = true;
  let consoleTimer = null;

  // Map server-side level to CSS class
  function levelToClass(level) {
    const map = {
      'tool': 'cl-tool',
      'result': 'cl-result',
      'error': 'cl-error',
      'progress': 'cl-progress',
      'action': 'cl-action',
      'cost': 'cl-cost',
      'info': 'cl-info',
    };
    return map[level] || 'cl-info';
  }

  function levelToLineCls(level) {
    if (level === 'result') return 'has-result';
    if (level === 'error') return 'has-error';
    if (level === 'progress') return 'has-progress';
    return '';
  }

  // Console filter
  // Always essential mode — hide tool/info noise
  (function() {
    const body = document.getElementById('consoleBody');
    if (body) body.className = 'console-body filter-essential';
  })();

  function formatConsoleTs(isoStr) {
    if (!isoStr) return '';
    return new Date(isoStr).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
  }

  function renderConsoleTabs() {
    const tabsEl = document.getElementById('consoleTabs');
    if (!tabsEl) return;
    const agentNames = new Set();
    for (const name of Object.keys(runningAgents)) agentNames.add(name);
    if (window._serverBuffers) {
      for (const name of Object.keys(window._serverBuffers)) agentNames.add(name);
    }
    if (agentNames.size === 0) { tabsEl.innerHTML = ''; return; }

    tabsEl.innerHTML = [...agentNames].sort().map(name => {
      const isRunning = !!runningAgents[name];
      const isActive = consoleAgent === name;
      const lineCount = window._serverBuffers?.[name]?.lines || 0;
      return `<button class="console-tab ${isActive ? 'active' : ''}" onclick="selectConsoleAgent('${name}')">
        <span class="tab-dot ${isRunning ? 'running' : 'stopped'}"></span>
        ${name}
        ${lineCount > 0 ? `<span class="tab-lines">(${lineCount})</span>` : ''}
      </button>`;
    }).join('');
  }

  function selectConsoleAgent(name) {
    consoleAgent = name;
    consoleSince = 0;
    consoleAutoScroll = true;
    document.getElementById('consoleBody').innerHTML = '<div class="console-empty">Chargement...</div>';
    renderConsoleTabs();
    fetchConsoleOutput();
    if (consoleTimer) clearInterval(consoleTimer);
    consoleTimer = setInterval(fetchConsoleOutput, 1500);
  }

  async function fetchConsoleOutput() {
    if (!consoleAgent || !serverOnline) return;
    try {
      const r = await fetch(`${AGENT_SERVER}/output/${consoleAgent}?since=${consoleSince}`);
      const data = await r.json();
      const body = document.getElementById('consoleBody');
      const statusEl = document.getElementById('consoleStatus');

      if (statusEl) {
        statusEl.textContent = data.running ? `RUNNING (${data.total} lines)` : `STOPPED (${data.total} lines)`;
        statusEl.style.color = data.running ? '#22c55e' : '#475569';
      }

      if (data.lines.length === 0 && consoleSince === 0) {
        body.innerHTML = '<div class="console-empty">Aucune sortie</div>';
        return;
      }
      if (data.lines.length === 0) return;
      if (consoleSince === 0) body.innerHTML = '';

      const fragment = document.createDocumentFragment();
      for (const line of data.lines) {
        const div = document.createElement('div');
        const level = line.level || 'info';
        const cls = levelToClass(level);
        const lineCls = levelToLineCls(level);
        div.className = 'console-line level-' + level + (lineCls ? ' ' + lineCls : '');
        div.innerHTML = `<span class="console-line-ts">${formatConsoleTs(line.ts)}</span><span class="console-line-text ${cls}">${escapeHtml(line.text)}</span>`;
        fragment.appendChild(div);
      }
      body.appendChild(fragment);
      consoleSince = data.total;
      if (consoleAutoScroll) body.scrollTop = body.scrollHeight;
    } catch(e) {}
  }

  document.getElementById('consoleBody')?.addEventListener('scroll', function() {
    consoleAutoScroll = (this.scrollHeight - this.scrollTop - this.clientHeight) < 30;
  });

  window.selectConsoleAgent = selectConsoleAgent;
  window.toggleAutopilot = toggleAutopilot;

  // ========== CLOCK ==========
  function updateClock() {
    document.getElementById('clock').textContent = new Date().toLocaleString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  updateClock();
  setInterval(updateClock, 1000);

  // ========== REALTIME ==========
  function setupRealtime() {
    const wsUrl = SUPABASE_URL.replace('https://', 'wss://') + '/realtime/v1/websocket?apikey=' + SUPABASE_ANON_KEY + '&vsn=1.0.0';
    let ws;

    function connect() {
      ws = new WebSocket(wsUrl);
      ws.onopen = () => {
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_runs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_runs' }] } },
          ref: '1'
        }));
        ws.send(JSON.stringify({
          topic: 'realtime:public:agent_logs',
          event: 'phx_join',
          payload: { config: { broadcast: { self: false }, postgres_changes: [{ event: '*', schema: 'public', table: 'agent_logs' }] } },
          ref: '2'
        }));
        setInterval(() => {
          if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ topic: 'phoenix', event: 'heartbeat', payload: {}, ref: 'hb' }));
          }
        }, 30000);
      };
      ws.onmessage = (event) => {
        try {
          const msg = JSON.parse(event.data);
          if (msg.event === 'postgres_changes') {
            loadAgentRuns();
            loadLogs(true);
            loadPendingCounts();
          }
        } catch(e) {}
      };
      ws.onclose = () => setTimeout(connect, 3000);
      ws.onerror = () => ws.close();
    }
    connect();
  }

  // ========== POLLING ==========
  setInterval(() => {
    checkServer().then(() => {
      updateAutopilotUI();
      renderArena();
      // Auto-open console for first running agent
      if (!consoleAgent) {
        const running = Object.keys(runningAgents);
        if (running.length > 0) selectConsoleAgent(running[0]);
      }
    });
    loadLogs(true);
  }, 5000);

  setInterval(() => {
    Promise.all([loadPendingCounts(), loadHealthKPIs()]).then(() => loadAgentRuns());
  }, 30000);

  // ========== INIT ==========
  Promise.all([checkServer(), loadPendingCounts(), loadHealthKPIs()]).then(() => {
    loadAgentRuns();
    loadLogs(false);
  });
  setupRealtime();
</script>

</body>
</html>
