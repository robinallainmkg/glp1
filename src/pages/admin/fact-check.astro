---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fact-Check - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0e17; color: #c8d6e5; }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header { background: linear-gradient(180deg, #0f1520 0%, #0a0e17 100%); border-bottom: 1px solid #1a2332; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #e2e8f0; }
    .page-header-left p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn { padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #1e293b; background: #0f1520; color: #94a3b8; font-size: 0.82rem; cursor: pointer; transition: all 0.15s; }
    .refresh-btn:hover { background: #1e293b; color: #e2e8f0; }
    .last-update { font-size: 0.72rem; color: #64748b; }
    .main { padding: 2rem; }

    /* Command box */
    .cmd-box { background: #1a1f2e; border: 1px solid #1e293b; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    .cmd-box code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.82rem; color: #a5f3fc; }
    .cmd-box .copy-btn { padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid #334155; background: transparent; color: #94a3b8; font-size: 0.72rem; cursor: pointer; }
    .cmd-box .copy-btn:hover { background: #334155; color: white; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: #111827; border-radius: 12px; padding: 1.25rem; border: 1px solid #1e293b; }
    .stat-card .label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.5rem; }
    .stat-card .value { font-size: 2rem; font-weight: 800; line-height: 1; }
    .stat-card .sub { font-size: 0.75rem; color: #475569; margin-top: 0.35rem; }

    /* Score distribution */
    .score-distrib { background: #111827; border-radius: 12px; border: 1px solid #1e293b; padding: 1.25rem; margin-bottom: 1.5rem; }
    .score-distrib-title { font-size: 0.82rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.75rem; }
    .score-bar { display: flex; height: 32px; border-radius: 8px; overflow: hidden; background: #1e293b; }
    .score-seg { display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: white; transition: width 0.5s; }
    .seg-urgent { background: #ef4444; }
    .seg-warn { background: #f59e0b; }
    .seg-ok { background: #22c55e; }
    .score-legend { display: flex; gap: 1.5rem; margin-top: 0.75rem; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: #94a3b8; }
    .legend-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }

    /* Coverage section */
    .coverage-section { background: #111827; border-radius: 12px; border: 1px solid #1e293b; padding: 1.25rem; margin-bottom: 1.5rem; }
    .coverage-title { font-size: 0.82rem; font-weight: 700; color: #e2e8f0; margin-bottom: 0.75rem; }
    .coverage-stats { display: flex; gap: 2rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .coverage-stat { display: flex; flex-direction: column; }
    .coverage-stat .cv-value { font-size: 1.5rem; font-weight: 800; line-height: 1; }
    .coverage-stat .cv-label { font-size: 0.72rem; color: #64748b; margin-top: 0.25rem; }
    .freshness-bar { display: flex; height: 32px; border-radius: 8px; overflow: hidden; background: #1e293b; margin-bottom: 0.5rem; }
    .fresh-seg { display: flex; align-items: center; justify-content: center; font-size: 0.72rem; font-weight: 700; color: white; transition: width 0.5s; }
    .fseg-fresh { background: #22c55e; }
    .fseg-aging { background: #f59e0b; }
    .fseg-stale { background: #ef4444; }
    .fseg-never { background: #64748b; }
    .freshness-legend { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .freshness-legend .legend-item { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; color: #94a3b8; }
    .stale-list { margin-top: 1rem; }
    .stale-list-title { font-size: 0.78rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem; }
    .stale-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 0.75rem; border-bottom: 1px solid #1e293b; font-size: 0.82rem; }
    .stale-item:last-child { border-bottom: none; }
    .stale-slug { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.72rem; color: #a78bfa; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .stale-days { font-size: 0.72rem; font-weight: 600; padding: 2px 8px; border-radius: 10px; }
    .sd-stale { background: #450a0a; color: #fca5a5; }
    .sd-aging { background: #451a03; color: #fcd34d; }
    .sd-never { background: #1e293b; color: #94a3b8; }

    /* Filters */
    .filters { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .filter-btn { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #1e293b; background: #111827; color: #94a3b8; font-size: 0.78rem; cursor: pointer; font-weight: 500; transition: all 0.15s; }
    .filter-btn:hover { border-color: #334155; color: #e2e8f0; }
    .filter-btn.active { background: #3b82f6; color: white; border-color: #3b82f6; }
    .filter-count { font-size: 0.68rem; background: rgba(255,255,255,0.1); padding: 1px 6px; border-radius: 10px; margin-left: 4px; }
    .filter-btn.active .filter-count { background: rgba(255,255,255,0.25); }
    .search-input { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #1e293b; background: #111827; color: #e2e8f0; font-size: 0.78rem; width: 220px; margin-left: auto; }
    .search-input::placeholder { color: #475569; }
    .search-input:focus { outline: none; border-color: #3b82f6; }

    /* Article cards */
    .article-cards { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
    .article-card { background: #111827; border: 1px solid #1e293b; border-radius: 12px; overflow: hidden; }
    .article-card-header { display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; cursor: pointer; transition: background 0.1s; }
    .article-card-header:hover { background: #1a2332; }
    .article-card.open .article-card-header { border-bottom: 1px solid #1e293b; }

    .score-circle { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; flex-shrink: 0; }
    .sc-urgent { background: #450a0a; color: #f87171; border: 2px solid #7f1d1d; }
    .sc-warn { background: #451a03; color: #fbbf24; border: 2px solid #78350f; }
    .sc-ok { background: #052e16; color: #4ade80; border: 2px solid #166534; }

    .article-info { flex: 1; min-width: 0; }
    .article-title { font-size: 0.88rem; font-weight: 600; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .article-slug { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.72rem; color: #a78bfa; }
    .article-meta { display: flex; gap: 0.5rem; align-items: center; }
    .ticket-count-badge { padding: 2px 8px; border-radius: 10px; font-size: 0.68rem; font-weight: 600; }
    .tcb-urgent { background: #450a0a; color: #fca5a5; }
    .tcb-warn { background: #451a03; color: #fcd34d; }
    .tcb-ok { background: #052e16; color: #86efac; }
    .chevron { font-size: 0.72rem; color: #64748b; transition: transform 0.2s; }
    .article-card.open .chevron { transform: rotate(180deg); }

    .article-card-body { display: none; padding: 0 1.25rem 1.25rem; }
    .article-card.open .article-card-body { display: block; }

    /* Tickets within article */
    .ticket { border: 1px solid #1e293b; border-radius: 10px; margin-top: 0.75rem; overflow: hidden; }
    .ticket-header { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.75rem; background: #0f1520; border-bottom: 1px solid #1e293b; flex-wrap: wrap; }
    .urgence-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .ud-urgent { background: #ef4444; }
    .ud-warning { background: #f59e0b; }
    .ud-ok { background: #22c55e; }
    .ticket-type { font-size: 0.68rem; font-weight: 600; padding: 2px 6px; border-radius: 4px; }
    .tt-urgent { background: #450a0a; color: #fca5a5; }
    .tt-warning { background: #451a03; color: #fcd34d; }
    .tt-ok { background: #052e16; color: #86efac; }
    .ticket-desc { font-size: 0.78rem; color: #94a3b8; flex: 1; }
    .ticket-status { font-size: 0.65rem; font-weight: 600; padding: 2px 6px; border-radius: 4px; margin-left: auto; }
    .ts-approved { background: #1e3a5f; color: #93c5fd; }
    .ts-deployed { background: #052e16; color: #86efac; }
    .ts-in_progress { background: #451a03; color: #fcd34d; }
    .ts-ready_to_deploy { background: #312e81; color: #a5b4fc; }
    .ts-rejected { background: #450a0a; color: #fca5a5; }

    .ticket-body { padding: 0.75rem; }
    .diff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
    .diff-block { border-radius: 8px; padding: 0.75rem; font-size: 0.78rem; line-height: 1.5; }
    .diff-before { background: #1c0a0a; border-left: 3px solid #ef4444; color: #fca5a5; }
    .diff-after { background: #051c0b; border-left: 3px solid #22c55e; color: #86efac; }
    .diff-label { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.35rem; color: inherit; opacity: 0.7; }
    .ticket-context { font-size: 0.75rem; color: #94a3b8; line-height: 1.5; padding: 0.5rem 0.65rem; background: #0f1520; border-radius: 6px; margin-top: 0.5rem; }
    .ticket-source { font-size: 0.72rem; margin-top: 0.35rem; }
    .ticket-source a { color: #60a5fa; text-decoration: none; }
    .ticket-source a:hover { text-decoration: underline; }

    /* Bottom panels */
    .two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .section-card { background: #111827; border-radius: 12px; border: 1px solid #1e293b; overflow: hidden; }
    .section-header { padding: 1rem 1.25rem; border-bottom: 1px solid #1e293b; font-size: 0.82rem; font-weight: 700; color: #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
    .section-header .badge-count { font-size: 0.72rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 10px; background: #1e293b; color: #94a3b8; }
    .run-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1.25rem; border-bottom: 1px solid #1e293b; font-size: 0.82rem; }
    .run-item:last-child { border-bottom: none; }
    .run-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .run-dot-ok { background: #22c55e; }
    .run-dot-fail { background: #ef4444; }
    .run-info { flex: 1; }
    .run-date { font-weight: 500; color: #e2e8f0; }
    .run-meta { font-size: 0.72rem; color: #64748b; }
    .run-badges { display: flex; gap: 0.35rem; }
    .run-badge { padding: 2px 6px; border-radius: 8px; font-size: 0.65rem; font-weight: 700; }

    .empty-state { text-align: center; padding: 3rem; color: #64748b; font-size: 0.85rem; }

    @media (max-width: 1024px) { .admin-layout { margin-left: 0; padding-top: 56px; } }
    @media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(3, 1fr); } .two-cols { grid-template-columns: 1fr; } .diff-grid { grid-template-columns: 1fr; } }
    @media (max-width: 768px) { .main { padding: 1rem; } .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  </style>
</head>
<body>
<script>
  // Auth guard — redirect to login if not authenticated
  if (!sessionStorage.getItem('admin_auth')) {
    window.location.href = '/admin/login/';
  }
</script>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>Fact-Check</h1>
      <p>Verification medicale des articles — Agent Fact-Check</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate">-</span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <div class="cmd-box">
      <code>claude -p "Verifie les articles" --agent fact-check</code>
      <button class="copy-btn" onclick="navigator.clipboard.writeText('claude -p &quot;Verifie les articles&quot; --agent fact-check');this.textContent='Copie !'">Copier</button>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">Articles verifies</div>
        <div class="value" id="statTotal" style="color:#1e293b">-</div>
        <div class="sub">Total unique</div>
      </div>
      <div class="stat-card">
        <div class="label">Urgents</div>
        <div class="value" id="statUrgent" style="color:#dc2626">-</div>
        <div class="sub">Action requise</div>
      </div>
      <div class="stat-card">
        <div class="label">A verifier</div>
        <div class="value" id="statWarn" style="color:#d97706">-</div>
        <div class="sub">Corrections mineures</div>
      </div>
      <div class="stat-card">
        <div class="label">Conformes</div>
        <div class="value" id="statOk" style="color:#22c55e">-</div>
        <div class="sub">Aucune action</div>
      </div>
      <div class="stat-card">
        <div class="label">Tickets crees</div>
        <div class="value" id="statTickets" style="color:#8b5cf6">-</div>
        <div class="sub">Corrections pour l'editorial</div>
      </div>
    </div>

    <!-- Score distribution bar -->
    <div class="score-distrib" id="distribContainer" style="display:none">
      <div class="score-distrib-title">Repartition des scores de fiabilite</div>
      <div class="score-bar" id="distribBar"></div>
      <div class="score-legend">
        <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div> Urgent (&lt;50)</div>
        <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div> A verifier (50-74)</div>
        <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div> Conforme (75+)</div>
      </div>
    </div>

    <!-- Coverage & freshness -->
    <div class="coverage-section" id="coverageSection" style="display:none">
      <div class="coverage-title">Couverture fact-check</div>
      <div class="coverage-stats" id="coverageStats"></div>
      <div class="freshness-bar" id="freshnessBar"></div>
      <div class="freshness-legend">
        <div class="legend-item"><div class="legend-dot" style="background:#22c55e"></div> &lt; 14 jours</div>
        <div class="legend-item"><div class="legend-dot" style="background:#f59e0b"></div> 14-30 jours</div>
        <div class="legend-item"><div class="legend-dot" style="background:#ef4444"></div> &gt; 30 jours</div>
        <div class="legend-item"><div class="legend-dot" style="background:#94a3b8"></div> Jamais verifie</div>
      </div>
      <div class="stale-list" id="staleList"></div>
    </div>

    <!-- Filters -->
    <div class="filters">
      <button class="filter-btn active" data-filter="all" onclick="setFilter('all')">Tous</button>
      <button class="filter-btn" data-filter="urgent" onclick="setFilter('urgent')">Urgents</button>
      <button class="filter-btn" data-filter="warning" onclick="setFilter('warning')">A verifier</button>
      <button class="filter-btn" data-filter="ok" onclick="setFilter('ok')">Conformes</button>
      <input type="text" class="search-input" placeholder="Rechercher un article..." oninput="setSearch(this.value)" />
    </div>

    <!-- Article cards -->
    <div id="articlesContainer"><div class="empty-state">Chargement...</div></div>

    <!-- Bottom: runs + ticket status -->
    <div class="two-cols" style="margin-top:1.5rem">
      <div class="section-card">
        <div class="section-header">
          Historique des runs
          <span class="badge-count" id="runCount">0</span>
        </div>
        <div id="runsList"><div class="empty-state">Chargement...</div></div>
      </div>
      <div class="section-card">
        <div class="section-header">
          Pipeline tickets
          <span class="badge-count" id="pipelineCount">0</span>
        </div>
        <div id="pipelineList"><div class="empty-state">Chargement...</div></div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allArticles = [];
  let currentFilter = 'all';
  let currentSearch = '';

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  function scoreCircle(score) {
    if (score < 50) return `<div class="score-circle sc-urgent">${score}</div>`;
    if (score < 75) return `<div class="score-circle sc-warn">${score}</div>`;
    return `<div class="score-circle sc-ok">${score}</div>`;
  }

  function scoreCategory(score) {
    if (score < 50) return 'urgent';
    if (score < 75) return 'warning';
    return 'ok';
  }

  function typeLabel(t) {
    const m = { price_update: 'Prix', info_outdated: 'Info obsolete', false_claim: 'Claim faux', missing_info: 'Info manquante', context_fr: 'Contexte FR' };
    return m[t] || t || '?';
  }

  function statusLabel(s) {
    const m = { approved: 'Approuve', in_progress: 'En cours', ready_to_deploy: 'Pret', deployed: 'Deploye', rejected: 'Rejete' };
    return m[s] || s;
  }

  function timeAgo(d) {
    if (!d) return '-';
    const now = new Date(), then = new Date(d);
    const h = Math.round((now - then) / 3600000);
    if (h < 1) return "A l'instant";
    if (h < 24) return `Il y a ${h}h`;
    const days = Math.round(h / 24);
    if (days === 1) return 'Hier';
    if (days < 7) return `Il y a ${days}j`;
    return then.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
  }

  window.setFilter = function(f) {
    currentFilter = f;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === f));
    renderArticles();
  };

  window.setSearch = function(q) {
    currentSearch = q.toLowerCase();
    renderArticles();
  };

  window.toggleArticle = function(id) {
    document.getElementById('article-' + id)?.classList.toggle('open');
  };

  function renderArticles() {
    let filtered = allArticles;
    if (currentFilter !== 'all') {
      filtered = filtered.filter(a => scoreCategory(a.score) === currentFilter);
    }
    if (currentSearch) {
      filtered = filtered.filter(a =>
        (a.title || '').toLowerCase().includes(currentSearch) ||
        (a.slug || '').toLowerCase().includes(currentSearch)
      );
    }

    const container = document.getElementById('articlesContainer');
    if (filtered.length === 0) {
      container.innerHTML = allArticles.length > 0
        ? '<div class="empty-state">Aucun resultat pour ce filtre</div>'
        : '<div class="empty-state">Aucun fact-check — lancez l\'agent fact-check</div>';
      return;
    }

    container.innerHTML = '<div class="article-cards">' + filtered.map((a, i) => {
      const cat = scoreCategory(a.score);
      const urgentTickets = a.tickets.filter(t => t.urgence === 'urgent').length;
      const warnTickets = a.tickets.filter(t => t.urgence === 'warning').length;

      let ticketBadges = '';
      if (urgentTickets > 0) ticketBadges += `<span class="ticket-count-badge tcb-urgent">${urgentTickets} urgent${urgentTickets > 1 ? 's' : ''}</span>`;
      if (warnTickets > 0) ticketBadges += `<span class="ticket-count-badge tcb-warn">${warnTickets} warning${warnTickets > 1 ? 's' : ''}</span>`;
      if (a.tickets.length === 0) ticketBadges = `<span class="ticket-count-badge tcb-ok">OK</span>`;

      return `<div class="article-card${i === 0 ? ' open' : ''}" id="article-${a.resultId}">
        <div class="article-card-header" onclick="toggleArticle('${a.resultId}')">
          ${scoreCircle(a.score)}
          <div class="article-info">
            <div class="article-title">${esc(a.title)}</div>
            <div class="article-slug">${esc(a.slug)} · ${a.tickets.length} ticket${a.tickets.length > 1 ? 's' : ''} · ${timeAgo(a.checkedAt)}</div>
          </div>
          <div class="article-meta">${ticketBadges}</div>
          <div class="chevron">&#x25BC;</div>
        </div>
        <div class="article-card-body">
          ${a.tickets.length === 0
            ? `<div style="padding:0.75rem;color:#94a3b8;font-size:0.82rem">Aucun probleme detecte — score ${a.score}/100</div>`
            : a.tickets.map(t => {
              const urgClass = t.urgence === 'urgent' ? 'ud-urgent' : t.urgence === 'warning' ? 'ud-warning' : 'ud-ok';
              const ttClass = t.urgence === 'urgent' ? 'tt-urgent' : t.urgence === 'warning' ? 'tt-warning' : 'tt-ok';
              const tsClass = 'ts-' + (t.statut || 'approved');
              return `<div class="ticket">
                <div class="ticket-header">
                  <div class="urgence-dot ${urgClass}"></div>
                  <span class="ticket-type ${ttClass}">${esc(typeLabel(t.ticket_type))}</span>
                  <span class="ticket-desc">${esc((t.claim_original || t.before_exact || '').substring(0, 80))}</span>
                  <span class="ticket-status ${tsClass}">${esc(statusLabel(t.statut))}</span>
                </div>
                <div class="ticket-body">
                  ${t.before_exact || t.after_suggested ? `<div class="diff-grid">
                    ${t.before_exact ? `<div class="diff-block diff-before"><div class="diff-label">Erreur detectee</div>${esc(t.before_exact)}</div>` : ''}
                    ${t.after_suggested ? `<div class="diff-block diff-after"><div class="diff-label">Correction suggeree</div>${esc(t.after_suggested)}</div>` : ''}
                  </div>` : ''}
                  ${t.realite_actuelle ? `<div class="ticket-context">${esc(t.realite_actuelle)}</div>` : ''}
                  ${t.source_reference ? `<div class="ticket-source">&#x1F4CE; <a href="${esc(t.source_reference)}" target="_blank" rel="noopener">${esc(t.source_reference)}</a></div>` : ''}
                </div>
              </div>`;
            }).join('')
          }
        </div>
      </div>`;
    }).join('') + '</div>';
  }

  function renderDistrib() {
    if (allArticles.length === 0) return;
    const total = allArticles.length;
    const urgent = allArticles.filter(a => a.score < 50).length;
    const warn = allArticles.filter(a => a.score >= 50 && a.score < 75).length;
    const ok = allArticles.filter(a => a.score >= 75).length;
    const pct = v => (v / total * 100).toFixed(1);

    document.getElementById('distribContainer').style.display = 'block';
    document.getElementById('distribBar').innerHTML = [
      urgent > 0 ? `<div class="score-seg seg-urgent" style="width:${pct(urgent)}%">${urgent}</div>` : '',
      warn > 0 ? `<div class="score-seg seg-warn" style="width:${pct(warn)}%">${warn}</div>` : '',
      ok > 0 ? `<div class="score-seg seg-ok" style="width:${pct(ok)}%">${ok}</div>` : '',
    ].join('');
  }

  async function loadRuns() {
    try {
      const runs = await sbFetch('agent_runs', 'select=*&agent_name=eq.fact-check&order=started_at.desc&limit=10');
      document.getElementById('runCount').textContent = runs.length;
      if (runs.length === 0) {
        document.getElementById('runsList').innerHTML = '<div class="empty-state">Aucun run</div>';
        return;
      }
      document.getElementById('runsList').innerHTML = runs.map(r => {
        const meta = r.metadata || {};
        const dotClass = r.status === 'completed' ? 'run-dot-ok' : 'run-dot-fail';
        const date = new Date(r.started_at);
        const dateStr = date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
        return `<div class="run-item">
          <div class="run-dot ${dotClass}"></div>
          <div class="run-info">
            <div class="run-date">${esc(dateStr)}</div>
            <div class="run-meta">${r.items_processed || '?'} articles verifies</div>
          </div>
          <div class="run-badges">
            ${r.items_errors ? `<span class="run-badge" style="background:#fee2e2;color:#991b1b">${r.items_errors} issues</span>` : `<span class="run-badge" style="background:#d1fae5;color:#065f46">OK</span>`}
          </div>
        </div>`;
      }).join('');
    } catch(e) {}
  }

  function renderPipeline(tickets) {
    const statuses = ['approved', 'in_progress', 'ready_to_deploy', 'deployed', 'rejected'];
    const counts = {};
    statuses.forEach(s => counts[s] = tickets.filter(t => t.statut === s).length);
    const total = tickets.length;
    document.getElementById('pipelineCount').textContent = total;

    if (total === 0) {
      document.getElementById('pipelineList').innerHTML = '<div class="empty-state">Aucun ticket</div>';
      return;
    }

    const colors = { approved: '#3b82f6', in_progress: '#f59e0b', ready_to_deploy: '#8b5cf6', deployed: '#22c55e', rejected: '#ef4444' };
    const labels = { approved: 'A traiter', in_progress: 'En cours', ready_to_deploy: 'Pret', deployed: 'Deploye', rejected: 'Rejete' };

    document.getElementById('pipelineList').innerHTML = statuses.filter(s => counts[s] > 0).map(s => `
      <div class="run-item">
        <div class="run-dot" style="background:${colors[s]}"></div>
        <div class="run-info">
          <div class="run-date">${labels[s]}</div>
          <div class="run-meta">${counts[s]} ticket${counts[s] > 1 ? 's' : ''}</div>
        </div>
        <div style="font-size:1.2rem;font-weight:800;color:${colors[s]}">${counts[s]}</div>
      </div>
    `).join('');
  }

  function renderCoverage(articles) {
    if (!articles || articles.length === 0) return;
    const now = new Date();
    const DAY = 86400000;

    const total = articles.length;
    const verified = articles.filter(a => a.last_fact_checked).length;
    const fresh = articles.filter(a => a.last_fact_checked && (now - new Date(a.last_fact_checked)) < 14 * DAY).length;
    const aging = articles.filter(a => a.last_fact_checked && (now - new Date(a.last_fact_checked)) >= 14 * DAY && (now - new Date(a.last_fact_checked)) < 30 * DAY).length;
    const stale = articles.filter(a => a.last_fact_checked && (now - new Date(a.last_fact_checked)) >= 30 * DAY).length;
    const never = articles.filter(a => !a.last_fact_checked).length;

    document.getElementById('coverageSection').style.display = 'block';

    // Coverage stats
    const pctVerified = total > 0 ? Math.round(verified / total * 100) : 0;
    const pctFresh = total > 0 ? Math.round(fresh / total * 100) : 0;
    document.getElementById('coverageStats').innerHTML = `
      <div class="coverage-stat">
        <div class="cv-value" style="color:#1e293b">${verified}/${total}</div>
        <div class="cv-label">Articles verifies (${pctVerified}%)</div>
      </div>
      <div class="coverage-stat">
        <div class="cv-value" style="color:#22c55e">${fresh}</div>
        <div class="cv-label">Verifies &lt; 14 jours (${pctFresh}%)</div>
      </div>
      <div class="coverage-stat">
        <div class="cv-value" style="color:#f59e0b">${aging}</div>
        <div class="cv-label">14-30 jours</div>
      </div>
      <div class="coverage-stat">
        <div class="cv-value" style="color:#ef4444">${stale + never}</div>
        <div class="cv-label">&gt; 30 jours ou jamais</div>
      </div>
    `;

    // Freshness bar
    const pct = v => (v / total * 100).toFixed(1);
    document.getElementById('freshnessBar').innerHTML = [
      fresh > 0 ? `<div class="fresh-seg fseg-fresh" style="width:${pct(fresh)}%">${fresh}</div>` : '',
      aging > 0 ? `<div class="fresh-seg fseg-aging" style="width:${pct(aging)}%">${aging}</div>` : '',
      stale > 0 ? `<div class="fresh-seg fseg-stale" style="width:${pct(stale)}%">${stale}</div>` : '',
      never > 0 ? `<div class="fresh-seg fseg-never" style="width:${pct(never)}%">${never}</div>` : '',
    ].join('');

    // Stale articles list (top 10 most outdated)
    const staleArticles = articles
      .filter(a => !a.last_fact_checked || (now - new Date(a.last_fact_checked)) >= 14 * DAY)
      .slice(0, 10); // Already sorted by last_fact_checked ASC NULLS FIRST

    if (staleArticles.length > 0) {
      document.getElementById('staleList').innerHTML = `
        <div class="stale-list-title">&#x26A0; Articles a re-verifier en priorite</div>
        ${staleArticles.map(a => {
          let daysText, daysClass;
          if (!a.last_fact_checked) {
            daysText = 'Jamais verifie';
            daysClass = 'sd-never';
          } else {
            const days = Math.round((now - new Date(a.last_fact_checked)) / DAY);
            if (days > 30) {
              daysText = days + 'j';
              daysClass = 'sd-stale';
            } else {
              daysText = days + 'j';
              daysClass = 'sd-aging';
            }
          }
          return `<div class="stale-item">
            <span class="stale-slug" title="${esc(a.title)}">${esc(a.slug)}</span>
            <span class="stale-days ${daysClass}">${daysText}</span>
          </div>`;
        }).join('')}
      `;
    }
  }

  async function loadAll() {
    try {
      const [results, tickets, allArticlesData] = await Promise.all([
        sbFetch('fact_check_results', 'select=id,article_id,score_fiabilite,statut,checked_at,articles(id,slug,title,collection)&order=score_fiabilite.asc,checked_at.desc&limit=100'),
        sbFetch('correction_tickets', 'select=*&source_agent=eq.fact-check&order=created_at.desc&limit=500'),
        sbFetch('articles', 'select=id,slug,title,collection,is_active,last_fact_checked&is_active=eq.true&order=last_fact_checked.asc.nullsfirst')
      ]);

      // Group tickets by fact_check_result_id
      const ticketsByResult = {};
      for (const t of tickets) {
        const key = t.fact_check_result_id;
        if (key) {
          if (!ticketsByResult[key]) ticketsByResult[key] = [];
          ticketsByResult[key].push(t);
        }
      }

      // Deduplicate results by article (keep latest)
      const seen = {};
      const uniqueResults = [];
      for (const r of results) {
        const artId = r.article_id;
        if (!seen[artId]) {
          seen[artId] = true;
          uniqueResults.push(r);
        }
      }

      allArticles = uniqueResults.map(r => ({
        resultId: r.id,
        articleId: r.article_id,
        title: r.articles?.title || 'Article inconnu',
        slug: r.articles?.slug || '-',
        collection: r.articles?.collection || '',
        score: r.score_fiabilite || 0,
        statut: r.statut,
        checkedAt: r.checked_at,
        tickets: ticketsByResult[r.id] || []
      }));

      // Sort: urgent first
      allArticles.sort((a, b) => a.score - b.score);

      // Stats
      const urgent = allArticles.filter(a => a.score < 50).length;
      const warn = allArticles.filter(a => a.score >= 50 && a.score < 75).length;
      const ok = allArticles.filter(a => a.score >= 75).length;

      document.getElementById('statTotal').textContent = allArticles.length;
      document.getElementById('statUrgent').textContent = urgent;
      document.getElementById('statWarn').textContent = warn;
      document.getElementById('statOk').textContent = ok;
      document.getElementById('statTickets').textContent = tickets.length;

      // Filter counts
      const counts = { all: allArticles.length, urgent, warning: warn, ok };
      document.querySelectorAll('.filter-btn').forEach(btn => {
        const f = btn.dataset.filter;
        const existing = btn.querySelector('.filter-count');
        if (existing) existing.remove();
        if (counts[f]) btn.insertAdjacentHTML('beforeend', `<span class="filter-count">${counts[f]}</span>`);
      });

      renderDistrib();
      renderCoverage(allArticlesData);
      renderArticles();
      renderPipeline(tickets);
      loadRuns();

      document.getElementById('lastUpdate').textContent = 'Mis a jour: ' + new Date().toLocaleTimeString('fr-FR');
    } catch (err) {
      document.getElementById('articlesContainer').innerHTML = `<div style="background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:10px;color:#991b1b;font-size:0.85rem"><strong>Erreur:</strong> ${esc(err.message)}</div>`;
    }
  }

  loadAll();
  setInterval(loadAll, 30000);
</script>

</body>
</html>
