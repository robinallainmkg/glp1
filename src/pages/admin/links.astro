---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Maillage Interne - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f1f5f9; color: #1e293b; }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header { background: white; border-bottom: 1px solid #e2e8f0; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header-left p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn { padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #e2e8f0; background: white; color: #475569; font-size: 0.82rem; cursor: pointer; }
    .refresh-btn:hover { background: #f8fafc; }
    .last-update { font-size: 0.72rem; color: #94a3b8; }
    .main { padding: 2rem; }

    .cmd-box { background: #1e293b; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; }
    .cmd-box code { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.82rem; color: #a5f3fc; }
    .cmd-box .copy-btn { padding: 0.35rem 0.75rem; border-radius: 6px; border: 1px solid #475569; background: transparent; color: #94a3b8; font-size: 0.72rem; cursor: pointer; }
    .cmd-box .copy-btn:hover { background: #334155; color: white; }

    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card { background: white; border-radius: 12px; padding: 1.25rem; border: 1px solid #e2e8f0; }
    .stat-card .label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.5rem; }
    .stat-card .value { font-size: 2rem; font-weight: 800; line-height: 1; }
    .stat-card .sub { font-size: 0.75rem; color: #94a3b8; margin-top: 0.35rem; }

    .filters { display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .filter-btn { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #e2e8f0; background: white; color: #64748b; font-size: 0.78rem; cursor: pointer; font-weight: 500; }
    .filter-btn:hover { border-color: #cbd5e1; color: #334155; }
    .filter-btn.active { background: #1e293b; color: white; border-color: #1e293b; }
    .filter-count { font-size: 0.68rem; background: rgba(0,0,0,0.08); padding: 1px 6px; border-radius: 10px; margin-left: 4px; }
    .filter-btn.active .filter-count { background: rgba(255,255,255,0.2); }
    .search-input { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #e2e8f0; font-size: 0.78rem; width: 200px; margin-left: auto; }
    .search-input:focus { outline: none; border-color: #7c3aed; }

    /* Link suggestion cards */
    .link-cards { display: flex; flex-direction: column; gap: 0.75rem; }
    .link-card { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.25rem; }
    .link-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .link-card-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
    .link-card-priority { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; flex-shrink: 0; }
    .priority-high { background: #dcfce7; color: #166534; }
    .priority-mid { background: #dbeafe; color: #1e40af; }
    .priority-low { background: #f1f5f9; color: #64748b; }
    .link-card-flow { display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 0; }
    .link-slug { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 0.75rem; color: #7c3aed; padding: 2px 6px; background: #f5f3ff; border-radius: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 200px; }
    .link-arrow { color: #94a3b8; font-size: 1.1rem; flex-shrink: 0; }
    .link-card-body { margin-left: 2.4rem; }
    .link-anchor { font-size: 0.82rem; font-weight: 600; color: #1e293b; margin-bottom: 0.25rem; }
    .link-context { font-size: 0.78rem; color: #64748b; line-height: 1.5; font-style: italic; }
    .link-meta { display: flex; gap: 0.75rem; margin-top: 0.5rem; align-items: center; flex-wrap: wrap; }

    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.68rem; font-weight: 600; }
    .badge-contextual { background: #dbeafe; color: #1e40af; }
    .badge-related { background: #f3e8ff; color: #6b21a8; }
    .badge-see_also { background: #fef3c7; color: #92400e; }
    .badge-definition { background: #d1fae5; color: #065f46; }
    .badge-suggested { background: #f1f5f9; color: #475569; }
    .badge-approved { background: #fef3c7; color: #92400e; }
    .badge-applied { background: #d1fae5; color: #065f46; }
    .badge-rejected { background: #fee2e2; color: #991b1b; }

    .empty-state { text-align: center; padding: 3rem; color: #94a3b8; }

    @media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .admin-layout { margin-left: 0; } .main { padding: 1rem; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>Maillage Interne</h1>
      <p>Suggestions de liens entre articles — Agent Internal Links</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate">-</span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <div class="cmd-box">
      <code>claude -p "Analyse le maillage interne" --agent internal-links</code>
      <button class="copy-btn" onclick="navigator.clipboard.writeText('claude -p \"Analyse le maillage interne\" --agent internal-links');this.textContent='Copie !'">Copier</button>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">Suggestions totales</div>
        <div class="value" id="statTotal" style="color:#1e293b">-</div>
        <div class="sub">Liens suggeres</div>
      </div>
      <div class="stat-card">
        <div class="label">Haute priorite</div>
        <div class="value" id="statHigh" style="color:#059669">-</div>
        <div class="sub">Priorite 1-3</div>
      </div>
      <div class="stat-card">
        <div class="label">Appliques</div>
        <div class="value" id="statApplied" style="color:#2563eb">-</div>
        <div class="sub">Integres par l'editorial</div>
      </div>
      <div class="stat-card">
        <div class="label">En attente</div>
        <div class="value" id="statPending" style="color:#d97706">-</div>
        <div class="sub">A traiter</div>
      </div>
    </div>

    <div class="filters">
      <button class="filter-btn active" data-filter="all" onclick="setFilter('all')">Tous</button>
      <button class="filter-btn" data-filter="approved" onclick="setFilter('approved')">A traiter</button>
      <button class="filter-btn" data-filter="applied" onclick="setFilter('applied')">Appliques</button>
      <button class="filter-btn" data-filter="rejected" onclick="setFilter('rejected')">Rejetes</button>
      <input type="text" class="search-input" placeholder="Rechercher un article..." oninput="setSearch(this.value)" />
    </div>

    <div id="linksContainer"><div class="empty-state">Aucune suggestion — lancez l'agent internal-links</div></div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allLinks = [];
  let currentFilter = 'all';
  let currentSearch = '';

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  function priorityClass(p) {
    if (p <= 3) return 'priority-high';
    if (p <= 6) return 'priority-mid';
    return 'priority-low';
  }

  window.setFilter = function(f) {
    currentFilter = f;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === f));
    renderLinks();
  };

  window.setSearch = function(q) {
    currentSearch = q;
    renderLinks();
  };

  function renderLinks() {
    let filtered = allLinks;
    if (currentFilter !== 'all') filtered = filtered.filter(l => l.status === currentFilter);
    if (currentSearch) {
      const q = currentSearch.toLowerCase();
      filtered = filtered.filter(l =>
        (l.source_slug || '').toLowerCase().includes(q) ||
        (l.target_slug || '').toLowerCase().includes(q) ||
        (l.anchor_text || '').toLowerCase().includes(q)
      );
    }

    const container = document.getElementById('linksContainer');
    if (filtered.length === 0) {
      container.innerHTML = '<div class="empty-state">Aucune suggestion pour ce filtre</div>';
      return;
    }

    container.innerHTML = '<div class="link-cards">' + filtered.map(l => `
      <div class="link-card">
        <div class="link-card-header">
          <div class="link-card-priority ${priorityClass(l.priority)}">${l.priority}</div>
          <div class="link-card-flow">
            <span class="link-slug" title="${esc(l.source_slug)}">${esc(l.source_slug)}</span>
            <span class="link-arrow">&#x2192;</span>
            <span class="link-slug" title="${esc(l.target_slug)}">${esc(l.target_slug)}</span>
          </div>
        </div>
        <div class="link-card-body">
          <div class="link-anchor">Ancre : "${esc(l.anchor_text)}"</div>
          ${l.context_sentence ? `<div class="link-context">"...${esc(l.context_sentence)}..."</div>` : ''}
          <div class="link-meta">
            <span class="badge badge-${l.link_type}">${esc(l.link_type)}</span>
            <span class="badge badge-${l.status}">${esc(l.status)}</span>
          </div>
        </div>
      </div>
    `).join('') + '</div>';
  }

  async function loadAll() {
    try {
      const links = await sbFetch('internal_link_suggestions', 'select=*&order=priority.asc,created_at.desc&limit=200');
      allLinks = links;

      const high = links.filter(l => l.priority <= 3).length;
      const applied = links.filter(l => l.status === 'applied').length;
      const pending = links.filter(l => l.status === 'approved' || l.status === 'suggested').length;

      document.getElementById('statTotal').textContent = links.length;
      document.getElementById('statHigh').textContent = high;
      document.getElementById('statApplied').textContent = applied;
      document.getElementById('statPending').textContent = pending;

      // Update filter counts
      const counts = { all: links.length, approved: links.filter(l => l.status === 'approved').length, applied, rejected: links.filter(l => l.status === 'rejected').length };
      document.querySelectorAll('.filter-btn').forEach(btn => {
        const f = btn.dataset.filter;
        const existing = btn.querySelector('.filter-count');
        if (existing) existing.remove();
        if (counts[f]) btn.insertAdjacentHTML('beforeend', `<span class="filter-count">${counts[f]}</span>`);
      });

      renderLinks();
      document.getElementById('lastUpdate').textContent = 'Mis a jour: ' + new Date().toLocaleTimeString('fr-FR');
    } catch (err) {
      document.getElementById('linksContainer').innerHTML = `<div style="background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:10px;color:#991b1b;font-size:0.85rem"><strong>Erreur:</strong> ${esc(err.message)}</div>`;
    }
  }

  loadAll();
  setInterval(loadAll, 30000);
</script>

</body>
</html>
