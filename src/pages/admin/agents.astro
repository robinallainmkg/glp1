---
// src/pages/admin/agents.astro
// Dashboard de supervision des Agent Teams
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Agent Teams - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: white;
      border-bottom: 1px solid #e2e8f0;
      padding: 1.5rem 2rem;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .main { padding: 2rem; }

    /* Agent cards grid */
    .agents-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .agent-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.25rem;
      transition: box-shadow 0.2s;
    }
    .agent-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .agent-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.75rem;
    }
    .agent-name {
      font-weight: 700;
      font-size: 1rem;
      color: #0f172a;
    }
    .agent-status {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.2rem 0.6rem;
      border-radius: 12px;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }
    .status-completed { background: #f0fdf4; color: #16a34a; }
    .status-completed .status-dot { background: #22c55e; }
    .status-running { background: #fefce8; color: #ca8a04; }
    .status-running .status-dot { background: #eab308; animation: pulse 1.5s infinite; }
    .status-error { background: #fef2f2; color: #dc2626; }
    .status-error .status-dot { background: #ef4444; }
    .status-started { background: #eff6ff; color: #2563eb; }
    .status-started .status-dot { background: #3b82f6; animation: pulse 1.5s infinite; }
    .status-unknown { background: #f1f5f9; color: #94a3b8; }
    .status-unknown .status-dot { background: #cbd5e1; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    .agent-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }
    .agent-stat {
      font-size: 0.78rem;
      color: #64748b;
    }
    .agent-stat strong {
      display: block;
      font-size: 1.1rem;
      color: #1e293b;
    }
    .agent-last-run {
      font-size: 0.75rem;
      color: #94a3b8;
      border-top: 1px solid #f1f5f9;
      padding-top: 0.5rem;
    }

    /* Dependency graph */
    .dep-graph {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .dep-graph h2 {
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: #0f172a;
    }
    .dep-graph svg {
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
      display: block;
    }

    /* Log table */
    .log-section {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
    }
    .log-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #e2e8f0;
    }
    .log-header h2 {
      font-size: 1rem;
      font-weight: 700;
      color: #0f172a;
    }
    .log-refresh {
      font-size: 0.72rem;
      color: #94a3b8;
    }
    .log-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .log-table th {
      text-align: left;
      padding: 0.6rem 1rem;
      font-weight: 600;
      color: #64748b;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
    }
    .log-table td {
      padding: 0.5rem 1rem;
      border-bottom: 1px solid #f1f5f9;
      color: #475569;
    }
    .log-agent {
      font-weight: 600;
      color: #1e293b;
    }
    .log-status-badge {
      display: inline-block;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 600;
    }
    .log-success { background: #f0fdf4; color: #16a34a; }
    .log-error { background: #fef2f2; color: #dc2626; }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #94a3b8;
      font-size: 0.92rem;
    }
    .loading {
      text-align: center;
      padding: 3rem;
      color: #64748b;
    }

    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
    }
    @media (max-width: 768px) {
      .main { padding: 1rem; }
      .page-header { padding: 1rem; }
      .agents-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <h1>Agent Teams</h1>
    <p>Supervision des agents Claude Code — statut, dependances et logs</p>
  </div>

  <div class="main">
    <!-- Agent cards -->
    <div class="agents-grid" id="agentsGrid">
      <div class="loading">Chargement des agents...</div>
    </div>

    <!-- Dependency graph -->
    <div class="dep-graph">
      <h2>Dependances entre agents</h2>
      <svg viewBox="0 0 800 200" xmlns="http://www.w3.org/2000/svg">
        <!-- SEO Audit -->
        <rect x="10" y="20" width="130" height="40" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/>
        <text x="75" y="45" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">SEO Audit</text>
        <line x1="140" y1="40" x2="680" y2="40" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4"/>
        <!-- Analytics -->
        <rect x="10" y="80" width="130" height="40" rx="8" fill="#eff6ff" stroke="#3b82f6" stroke-width="1.5"/>
        <text x="75" y="105" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">Analytics</text>
        <line x1="140" y1="100" x2="680" y2="100" stroke="#cbd5e1" stroke-width="1.5" stroke-dasharray="4"/>
        <!-- Dashboard box -->
        <rect x="680" y="30" width="110" height="80" rx="8" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.5"/>
        <text x="735" y="75" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">Dashboard</text>
        <!-- Fact-Check -->
        <rect x="10" y="150" width="130" height="40" rx="8" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.5"/>
        <text x="75" y="175" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">Fact-Check</text>
        <line x1="140" y1="170" x2="280" y2="170" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow)"/>
        <!-- Opportunities -->
        <rect x="10" y="210" width="130" height="40" rx="8" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.5"/>
        <text x="75" y="235" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">Opportunites</text>
        <line x1="140" y1="230" x2="280" y2="200" stroke="#f59e0b" stroke-width="1.5" marker-end="url(#arrow)"/>
        <!-- Human review -->
        <rect x="280" y="160" width="140" height="50" rx="8" fill="#fef2f2" stroke="#ef4444" stroke-width="1.5"/>
        <text x="350" y="182" text-anchor="middle" font-size="11" font-weight="600" fill="#1e293b">Revue humaine</text>
        <text x="350" y="198" text-anchor="middle" font-size="9" fill="#64748b">(approbation)</text>
        <line x1="420" y1="185" x2="490" y2="185" stroke="#8b5cf6" stroke-width="1.5" marker-end="url(#arrow)"/>
        <!-- Editorial -->
        <rect x="490" y="165" width="120" height="40" rx="8" fill="#f5f3ff" stroke="#8b5cf6" stroke-width="1.5"/>
        <text x="550" y="190" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">Editorial</text>
        <line x1="610" y1="185" x2="680" y2="185" stroke="#22c55e" stroke-width="1.5" marker-end="url(#arrow)"/>
        <!-- Deploy -->
        <rect x="680" y="165" width="110" height="40" rx="8" fill="#f0fdf4" stroke="#22c55e" stroke-width="1.5"/>
        <text x="735" y="190" text-anchor="middle" font-size="12" font-weight="600" fill="#1e293b">Deploy</text>
        <!-- Arrow marker -->
        <defs>
          <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#64748b"/>
          </marker>
        </defs>
      </svg>
    </div>

    <!-- Agent logs -->
    <div class="log-section">
      <div class="log-header">
        <h2>Logs recents</h2>
        <span class="log-refresh" id="logRefresh">Actualisation toutes les 30s</span>
      </div>
      <div id="logContent">
        <div class="loading">Chargement des logs...</div>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  const AGENTS = [
    { name: 'seo-audit', label: 'SEO Audit', desc: 'Crawlabilite, meta, liens, performance' },
    { name: 'analytics', label: 'Analytics', desc: 'Suivi mots-cles et positionnement' },
    { name: 'fact-check', label: 'Fact-Check', desc: 'Verification informations medicales' },
    { name: 'opportunities', label: 'Opportunites', desc: 'Detection tendances et gaps' },
    { name: 'editorial', label: 'Editorial', desc: 'Redaction et correction articles' },
  ];

  function formatDate(dateStr) {
    if (!dateStr) return 'Jamais';
    return new Date(dateStr).toLocaleDateString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
  }

  function formatDuration(ms) {
    if (!ms) return '-';
    if (ms < 60000) return `${Math.round(ms / 1000)}s`;
    return `${Math.round(ms / 60000)}min`;
  }

  function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  async function supabaseFetch(table, query) {
    const response = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
      }
    });
    if (!response.ok) throw new Error(await response.text());
    return response.json();
  }

  async function loadAgents() {
    try {
      const runs = await supabaseFetch(
        'agent_runs',
        'select=*&order=started_at.desc&limit=50'
      );

      const latestByAgent = {};
      for (const run of runs) {
        if (!latestByAgent[run.agent_name]) {
          latestByAgent[run.agent_name] = run;
        }
      }

      const grid = document.getElementById('agentsGrid');
      let html = '';

      for (const agent of AGENTS) {
        const run = latestByAgent[agent.name];
        const status = run ? run.status : 'unknown';
        const statusLabel = {
          completed: 'Termine',
          running: 'En cours',
          started: 'Demarre',
          error: 'Erreur',
          unknown: 'Pas encore lance'
        }[status] || status;

        const meta = run?.metadata || {};

        html += `
          <div class="agent-card">
            <div class="agent-header">
              <span class="agent-name">${agent.label}</span>
              <span class="agent-status status-${status}">
                <span class="status-dot"></span>
                ${statusLabel}
              </span>
            </div>
            <div style="font-size:0.78rem;color:#64748b;margin-bottom:0.75rem">${agent.desc}</div>
            <div class="agent-stats">
              <div class="agent-stat">
                <strong>${run ? run.items_processed : '-'}</strong>
                Traites
              </div>
              <div class="agent-stat">
                <strong>${run ? run.items_errors : '-'}</strong>
                Erreurs
              </div>
              <div class="agent-stat">
                <strong>${run ? formatDuration(run.duration_ms) : '-'}</strong>
                Duree
              </div>
              <div class="agent-stat">
                <strong>${meta.tickets_created ?? meta.new_opportunities ?? meta.keywords_tracked ?? meta.critical ?? '-'}</strong>
                Output
              </div>
            </div>
            <div class="agent-last-run">
              Dernier run : ${formatDate(run?.started_at)}
              ${run?.error ? `<br><span style="color:#dc2626">${escapeHtml(run.error.substring(0, 100))}</span>` : ''}
            </div>
          </div>
        `;
      }

      grid.innerHTML = html;
    } catch (err) {
      document.getElementById('agentsGrid').innerHTML = `
        <div style="grid-column:1/-1;background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:10px;color:#991b1b">
          <strong>Erreur</strong> : ${escapeHtml(err.message)}
        </div>
      `;
    }
  }

  async function loadLogs() {
    try {
      const logs = await supabaseFetch(
        'agent_logs',
        'select=id,agent_type,status,created_at,metadata&order=created_at.desc&limit=30'
      );

      const logContent = document.getElementById('logContent');

      if (logs.length === 0) {
        logContent.innerHTML = '<div class="empty-state">Aucun log disponible</div>';
        return;
      }

      let html = `
        <table class="log-table">
          <thead>
            <tr>
              <th>Agent</th>
              <th>Statut</th>
              <th>Details</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
      `;

      for (const log of logs) {
        const statusClass = log.status === 'success' ? 'log-success' : 'log-error';
        const meta = log.metadata || {};
        const details = meta.action || meta.tickets_created !== undefined
          ? `${meta.action || ''} ${meta.tickets_created ? meta.tickets_created + ' tickets' : ''} ${meta.score ? 'score:' + meta.score : ''}`.trim()
          : '-';

        html += `
          <tr>
            <td class="log-agent">${escapeHtml(log.agent_type)}</td>
            <td><span class="log-status-badge ${statusClass}">${escapeHtml(log.status)}</span></td>
            <td>${escapeHtml(details)}</td>
            <td>${formatDate(log.created_at)}</td>
          </tr>
        `;
      }

      html += '</tbody></table>';
      logContent.innerHTML = html;
    } catch (err) {
      document.getElementById('logContent').innerHTML = `
        <div style="padding:1rem;color:#991b1b">Erreur : ${escapeHtml(err.message)}</div>
      `;
    }
  }

  // Initial load
  loadAgents();
  loadLogs();

  // Auto-refresh every 30s
  setInterval(() => {
    loadAgents();
    loadLogs();
  }, 30000);
</script>

</body>
</html>
