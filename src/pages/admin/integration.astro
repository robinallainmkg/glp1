---
// src/pages/admin/integration.astro
// Historique des corrections deployees
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Integration - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: white;
      border-bottom: 1px solid #e2e8f0;
      padding: 1.5rem 2rem;
    }
    .page-header h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }

    .stats-bar {
      display: flex;
      gap: 1rem;
      padding: 1.25rem 2rem;
      background: white;
      border-bottom: 1px solid #e2e8f0;
    }
    .stat-card {
      flex: 1;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      text-align: center;
    }
    .stat-card .stat-value { font-size: 1.5rem; font-weight: 700; }
    .stat-card .stat-label { font-size: 0.75rem; color: #64748b; margin-top: 0.15rem; font-weight: 500; }

    .main { padding: 2rem; }

    /* Deployed ticket list */
    .deployed-list { display: flex; flex-direction: column; gap: 0.65rem; }
    .deploy-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      overflow: hidden;
      transition: box-shadow 0.2s;
    }
    .deploy-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
    .deploy-header {
      padding: 0.85rem 1.25rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      gap: 1rem;
    }
    .deploy-header:hover { background: #f8fafc; }
    .deploy-info { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .deploy-title { font-weight: 600; font-size: 0.92rem; }
    .deploy-meta { font-size: 0.78rem; color: #94a3b8; display: flex; gap: 0.6rem; align-items: center; }
    .deploy-body { display: none; padding: 0 1.25rem 1.25rem; border-top: 1px solid #f1f5f9; }
    .deploy-card.open .deploy-body { display: block; }

    .deployed-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.18rem 0.55rem;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 600;
      background: #dcfce7;
      color: #166534;
    }
    .type-badge {
      display: inline-block;
      padding: 0.12rem 0.45rem;
      border-radius: 4px;
      font-size: 0.72rem;
      font-weight: 500;
      background: #e0e7ff;
      color: #4338ca;
    }

    /* Diff blocks */
    .diff-before, .diff-after {
      border-radius: 8px;
      margin-top: 0.65rem;
      overflow: hidden;
    }
    .diff-label {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.35rem 0.75rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }
    .diff-content {
      padding: 0.75rem;
      font-size: 0.85rem;
      line-height: 1.65;
      white-space: pre-wrap;
      word-break: break-word;
      font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    }
    .diff-before .diff-label { background: #fecaca; color: #991b1b; }
    .diff-before .diff-content { background: #fef2f2; border: 1px solid #fecaca; border-top: none; color: #991b1b; text-decoration: line-through; }
    .diff-after .diff-label { background: #bbf7d0; color: #166534; }
    .diff-after .diff-content { background: #f0fdf4; border: 1px solid #bbf7d0; border-top: none; color: #166534; }

    .ticket-source { font-size: 0.78rem; color: #3b82f6; margin-top: 0.5rem; }
    .ticket-source a { color: #3b82f6; }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #94a3b8;
      font-size: 0.92rem;
    }
    .loading {
      text-align: center;
      padding: 3rem;
      color: #64748b;
    }

    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
    }
    @media (max-width: 768px) {
      .stats-bar { flex-wrap: wrap; padding: 1rem; gap: 0.5rem; }
      .stat-card { min-width: calc(50% - 0.5rem); }
      .main { padding: 1rem; }
      .page-header { padding: 1rem; }
      .deploy-header { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <h1>Integration</h1>
    <p>Historique des corrections deployees sur le site</p>
  </div>

  <div class="stats-bar">
    <div class="stat-card" style="background:#dcfce7;color:#166534">
      <div class="stat-value" id="stat-total">-</div>
      <div class="stat-label">Total deployes</div>
    </div>
    <div class="stat-card" style="background:#dbeafe;color:#1e40af">
      <div class="stat-value" id="stat-this-week">-</div>
      <div class="stat-label">Cette semaine</div>
    </div>
    <div class="stat-card" style="background:#f3e8ff;color:#7c3aed">
      <div class="stat-value" id="stat-types">-</div>
      <div class="stat-label">Types distincts</div>
    </div>
  </div>

  <div class="main" id="content">
    <div class="loading">Chargement des donnees...</div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SUPABASE_URL = supabaseUrl;
  const SUPABASE_ANON_KEY = supabaseAnonKey;

  function formatDate(dateStr) {
    if (!dateStr) return 'N/A';
    return new Date(dateStr).toLocaleDateString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
    });
  }

  function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function typeLabel(type) {
    return { price_update: 'Prix', info_outdated: 'Info obsolete', false_claim: 'Claim faux', missing_info: 'Info manquante' }[type] || type;
  }

  async function supabaseFetch(table, query) {
    const response = await fetch(`${SUPABASE_URL}/rest/v1/${table}?${query}`, {
      headers: {
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
      }
    });
    if (!response.ok) throw new Error(await response.text());
    return response.json();
  }

  async function loadDashboard() {
    try {
      const tickets = await supabaseFetch(
        'correction_tickets',
        'select=*&statut=eq.deployed&order=deployed_at.desc,updated_at.desc&limit=200'
      );

      document.getElementById('stat-total').textContent = tickets.length;

      // This week
      const weekAgo = new Date();
      weekAgo.setDate(weekAgo.getDate() - 7);
      const thisWeek = tickets.filter(t => {
        const d = new Date(t.deployed_at || t.updated_at);
        return d >= weekAgo;
      }).length;
      document.getElementById('stat-this-week').textContent = thisWeek;

      // Distinct types
      const types = new Set(tickets.map(t => t.ticket_type));
      document.getElementById('stat-types').textContent = types.size;

      const contentEl = document.getElementById('content');

      if (tickets.length === 0) {
        contentEl.innerHTML = `
          <div class="empty-state">
            <p style="font-size:1.15rem;margin-bottom:0.5rem">Aucune correction deployee</p>
            <p>Les corrections deployees depuis le <a href="/admin/editorial/" style="color:#3b82f6">dashboard editorial</a> apparaitront ici.</p>
          </div>
        `;
        return;
      }

      contentEl.innerHTML = `
        <div class="deployed-list">
          ${tickets.map(t => `
            <div class="deploy-card" data-card>
              <div class="deploy-header" onclick="this.closest('[data-card]').classList.toggle('open')">
                <div class="deploy-info">
                  <span class="deployed-badge">Deploye</span>
                  <span class="deploy-title">${escapeHtml(t.title || 'Correction')}</span>
                  <span class="type-badge">${escapeHtml(typeLabel(t.ticket_type))}</span>
                </div>
                <div class="deploy-meta">
                  <span>${formatDate(t.deployed_at || t.updated_at)}</span>
                </div>
              </div>
              <div class="deploy-body">
                <div class="diff-before">
                  <div class="diff-label">Avant</div>
                  <div class="diff-content">${escapeHtml(t.before_exact)}</div>
                </div>
                <div class="diff-after">
                  <div class="diff-label">Apres (final)</div>
                  <div class="diff-content">${escapeHtml(t.after_final || t.after_suggested)}</div>
                </div>
                ${t.source_reference ? `<div class="ticket-source">Source : <a href="${escapeHtml(t.source_reference)}" target="_blank" rel="noopener">${escapeHtml(t.source_reference)}</a></div>` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      `;

    } catch (err) {
      document.getElementById('content').innerHTML = `
        <div style="background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:10px;color:#991b1b">
          <strong>Erreur Supabase</strong> : ${escapeHtml(err.message)}
        </div>
      `;
    }
  }

  loadDashboard();
</script>

</body>
</html>
