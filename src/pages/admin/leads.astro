---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Leads & Data - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0a0e17;
      color: #e2e8f0;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: #111827;
      border-bottom: 1px solid #1e293b;
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #e2e8f0; }
    .page-header-left p { font-size: 0.88rem; color: #94a3b8; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: 1px solid #2d3748;
      background: #1e293b;
      color: #c8d6e5;
      font-size: 0.82rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .refresh-btn:hover { background: #2d3748; }
    .last-update { font-size: 0.72rem; color: #94a3b8; }

    .main { padding: 2rem; }

    /* Stats grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: #111827;
      border-radius: 12px;
      padding: 1.25rem;
      border: 1px solid #1e293b;
    }
    .stat-card .label {
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      margin-bottom: 0.5rem;
    }
    .stat-card .value {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
    }
    .stat-card .sub {
      font-size: 0.75rem;
      color: #94a3b8;
      margin-top: 0.35rem;
    }

    /* Source tabs */
    .source-tabs {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .source-tab {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: 1px solid #2d3748;
      background: #1e293b;
      font-size: 0.82rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      color: #c8d6e5;
      font-weight: 500;
    }
    .source-tab:hover { background: #2d3748; }
    .source-tab.active { background: #3b82f6; color: white; border-color: #3b82f6; }
    .source-tab .count {
      background: rgba(0,0,0,0.1);
      padding: 0.1rem 0.4rem;
      border-radius: 10px;
      font-size: 0.7rem;
      font-weight: 700;
    }
    .source-tab.active .count { background: rgba(255,255,255,0.25); }

    /* Feed table */
    .feed-table-wrap {
      background: #111827;
      border-radius: 12px;
      border: 1px solid #1e293b;
      overflow: hidden;
    }
    .feed-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
    }
    .feed-table th {
      text-align: left;
      padding: 0.75rem 1rem;
      background: #0d1321;
      border-bottom: 1px solid #1e293b;
      font-weight: 600;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
    }
    .feed-table td {
      padding: 0.7rem 1rem;
      border-bottom: 1px solid #1e293b;
      vertical-align: top;
    }
    .feed-table tr:hover td { background: #1a2332; }
    .feed-table tr:last-child td { border-bottom: none; }

    .badge {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 6px;
      font-size: 0.68rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .badge-newsletter { background: rgba(59,130,246,0.2); color: #60a5fa; }
    .badge-contact { background: rgba(236,72,153,0.2); color: #f472b6; }
    .badge-chat { background: rgba(34,197,94,0.2); color: #4ade80; }
    .badge-feedback { background: rgba(245,158,11,0.2); color: #fbbf24; }
    .badge-email { background: rgba(139,92,246,0.2); color: #a78bfa; }
    .badge-review { background: rgba(99,102,241,0.2); color: #818cf8; }
    .badge-testimonial { background: rgba(168,85,247,0.2); color: #c084fc; }

    .badge-intent {
      display: inline-block;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.65rem;
      font-weight: 600;
      background: #1e293b;
      color: #94a3b8;
    }

    .email-cell {
      font-weight: 600;
      color: #e2e8f0;
    }
    .preview-cell {
      max-width: 350px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: #94a3b8;
    }
    .time-cell {
      font-size: 0.75rem;
      color: #94a3b8;
      white-space: nowrap;
    }

    .empty-state {
      padding: 3rem;
      text-align: center;
      color: #94a3b8;
    }

    /* Detail modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 300;
      backdrop-filter: blur(2px);
      align-items: center;
      justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 16px;
      width: 90%;
      max-width: 600px;
      max-height: 80vh;
      overflow-y: auto;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
    }
    .modal-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid #1e293b;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-header h3 { font-size: 1rem; font-weight: 700; color: #e2e8f0; }
    .modal-close {
      background: none;
      border: none;
      font-size: 1.2rem;
      cursor: pointer;
      color: #94a3b8;
      padding: 0.25rem;
    }
    .modal-body { padding: 1.5rem; }
    .modal-field {
      margin-bottom: 1rem;
    }
    .modal-field label {
      display: block;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #94a3b8;
      margin-bottom: 0.25rem;
    }
    .modal-field .val {
      font-size: 0.88rem;
      color: #e2e8f0;
      line-height: 1.5;
      white-space: pre-wrap;
    }

    @media (max-width: 1024px) {
      .admin-layout { margin-left: 0; padding-top: 56px; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</head>
<body>
  <AdminNav />
  <div class="admin-layout">
    <div class="page-header">
      <div class="page-header-left">
        <h1>📊 Leads & Data</h1>
        <p>Toutes les donnees entrantes — emails, newsletter, contact, chat, feedback</p>
      </div>
      <div class="header-actions">
        <span class="last-update" id="lastUpdate"></span>
        <button class="refresh-btn" onclick="loadAllData()">🔄 Rafraichir</button>
      </div>
    </div>

    <div class="main">
      <!-- Stats -->
      <div class="stats-grid" id="statsGrid">
        <div class="stat-card">
          <div class="label">Total leads</div>
          <div class="value" id="statTotal">-</div>
          <div class="sub" id="statTotalSub">toutes sources</div>
        </div>
        <div class="stat-card">
          <div class="label">Emails</div>
          <div class="value" style="color: #8b5cf6;" id="statEmails">-</div>
          <div class="sub" id="statEmailsSub">robin@glp1-france.fr</div>
        </div>
        <div class="stat-card">
          <div class="label">Newsletter</div>
          <div class="value" style="color: #3b82f6;" id="statNewsletter">-</div>
          <div class="sub" id="statNewsletterSub">inscriptions</div>
        </div>
        <div class="stat-card">
          <div class="label">Contact</div>
          <div class="value" style="color: #ec4899;" id="statContact">-</div>
          <div class="sub" id="statContactSub">messages</div>
        </div>
        <div class="stat-card">
          <div class="label">Chat IA</div>
          <div class="value" style="color: #16a34a;" id="statChat">-</div>
          <div class="sub" id="statChatSub">conversations</div>
        </div>
        <div class="stat-card">
          <div class="label">Feedback</div>
          <div class="value" style="color: #f59e0b;" id="statFeedback">-</div>
          <div class="sub" id="statFeedbackSub">avis + temoignages</div>
        </div>
      </div>

      <!-- Source filter tabs -->
      <div class="source-tabs" id="sourceTabs">
        <button class="source-tab active" data-source="all" onclick="filterSource('all', this)">
          🔥 Tout <span class="count" id="countAll">-</span>
        </button>
        <button class="source-tab" data-source="email" onclick="filterSource('email', this)">
          📩 Emails <span class="count" id="countEmails">-</span>
        </button>
        <button class="source-tab" data-source="newsletter" onclick="filterSource('newsletter', this)">
          📧 Newsletter <span class="count" id="countNewsletter">-</span>
        </button>
        <button class="source-tab" data-source="contact" onclick="filterSource('contact', this)">
          ✉️ Contact <span class="count" id="countContact">-</span>
        </button>
        <button class="source-tab" data-source="chat" onclick="filterSource('chat', this)">
          💬 Chat IA <span class="count" id="countChat">-</span>
        </button>
        <button class="source-tab" data-source="feedback" onclick="filterSource('feedback', this)">
          ⭐ Feedback <span class="count" id="countFeedback">-</span>
        </button>
      </div>

      <!-- Feed table -->
      <div class="feed-table-wrap">
        <table class="feed-table">
          <thead>
            <tr>
              <th>Source</th>
              <th>Identifiant</th>
              <th>Apercu</th>
              <th>Intent / Sujet</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody id="feedBody">
            <tr><td colspan="5" class="empty-state">Chargement...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Detail modal -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modalTitle">Detail</h3>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body" id="modalBody"></div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
  <script is:inline define:vars={{ supabaseUrl: supabaseConfig.url, supabaseKey: supabaseConfig.anonKey }}>
    let sb;
    function initSb() {
      if (sb) return sb;
      if (!window.supabase || !window.supabase.createClient) {
        throw new Error('Supabase JS not loaded');
      }
      sb = window.supabase.createClient(supabaseUrl, supabaseKey);
      return sb;
    }

    let allEntries = [];
    let currentSource = 'all';

    async function loadAllData() {
      try {
      const s = await initSb();

      // 1. Contacts (newsletter + contact form)
      const { data: contacts, error: errContacts } = await s
        .from('contacts')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(200);
      if (errContacts) console.error('contacts error:', errContacts);

      // 2. Chat conversations with first messages
      const { data: convs, error: errConvs } = await s
        .from('coach_conversations')
        .select('*')
        .order('last_message_at', { ascending: false })
        .limit(100);
      if (errConvs) console.error('convs error:', errConvs);

      // Get first user message per conversation for preview
      let chatPreviews = {};
      if (convs && convs.length > 0) {
        const convIds = convs.map(c => c.id);
        const { data: firstMsgs } = await s
          .from('coach_messages')
          .select('conversation_id, content')
          .in('conversation_id', convIds)
          .eq('role', 'user')
          .order('created_at', { ascending: true });

        if (firstMsgs) {
          firstMsgs.forEach(m => {
            if (!chatPreviews[m.conversation_id]) {
              chatPreviews[m.conversation_id] = m.content;
            }
          });
        }
      }

      // 3. Feedback
      const { data: feedback, error: errFeedback } = await s
        .from('user_feedback')
        .select('*')
        .order('created_at', { ascending: false })
        .limit(100);
      if (errFeedback) console.error('feedback error:', errFeedback);

      // 4. Incoming emails (robin@glp1-france.fr)
      const { data: emails, error: errEmails } = await s
        .from('incoming_emails')
        .select('*')
        .order('received_at', { ascending: false })
        .limit(200);
      if (errEmails) console.error('emails error:', errEmails);

      console.log('Leads data loaded:', { contacts: contacts?.length, convs: convs?.length, feedback: feedback?.length, emails: emails?.length });

      // Build unified feed
      allEntries = [];

      // Newsletter entries
      (contacts || []).forEach(c => {
        const isNewsletter = c.newsletter === true && (!c.nom && !c.telephone);
        allEntries.push({
          source: isNewsletter ? 'newsletter' : 'contact',
          id: c.id,
          identifier: c.email || '-',
          preview: isNewsletter
            ? (c.message || 'Inscription newsletter')
            : (c.message || c.subject || '-'),
          intent: c.subject || (isNewsletter ? 'Newsletter' : 'Contact'),
          date: c.created_at,
          raw: c,
        });
      });

      // Chat entries
      (convs || []).forEach(c => {
        allEntries.push({
          source: 'chat',
          id: c.id,
          identifier: (c.session_id || '').substring(0, 12) + '...',
          preview: chatPreviews[c.id] || '(conversation)',
          intent: (c.message_count || 0) + ' msgs',
          date: c.last_message_at || c.started_at,
          raw: c,
        });
      });

      // Email entries
      (emails || []).forEach(em => {
        allEntries.push({
          source: 'email',
          id: em.id,
          identifier: em.from_email || '-',
          preview: em.subject || '(sans objet)',
          intent: em.category || 'inbox',
          date: em.received_at || em.created_at,
          raw: em,
        });
      });

      // Feedback entries
      (feedback || []).forEach(f => {
        const isTesti = f.type === 'testimonial';
        allEntries.push({
          source: 'feedback',
          id: f.id,
          identifier: f.name || f.email || 'Anonyme',
          preview: f.story || f.comment || ('Note: ' + (f.rating || '-') + '/5'),
          intent: isTesti ? 'Temoignage' : (f.interest || f.discovery || 'Avis'),
          date: f.created_at,
          raw: f,
          subtype: isTesti ? 'testimonial' : 'feedback',
        });
      });

      // Sort by date desc
      allEntries.sort((a, b) => new Date(b.date) - new Date(a.date));

      // Update stats
      const emailsF = allEntries.filter(e => e.source === 'email');
      const newsletters = allEntries.filter(e => e.source === 'newsletter');
      const contactsF = allEntries.filter(e => e.source === 'contact');
      const chats = allEntries.filter(e => e.source === 'chat');
      const feedbacks = allEntries.filter(e => e.source === 'feedback');

      document.getElementById('statTotal').textContent = allEntries.length;
      document.getElementById('statEmails').textContent = emailsF.length;
      document.getElementById('statNewsletter').textContent = newsletters.length;
      document.getElementById('statContact').textContent = contactsF.length;
      document.getElementById('statChat').textContent = chats.length;
      document.getElementById('statFeedback').textContent = feedbacks.length;

      // Today counts
      const today = new Date().toISOString().split('T')[0];
      const todayTotal = allEntries.filter(e => e.date && e.date.startsWith(today)).length;
      document.getElementById('statTotalSub').textContent = "aujourd'hui: " + todayTotal;
      document.getElementById('statEmailsSub').textContent = "aujourd'hui: " + emailsF.filter(e => e.date && e.date.startsWith(today)).length;
      document.getElementById('statNewsletterSub').textContent = "aujourd'hui: " + newsletters.filter(e => e.date && e.date.startsWith(today)).length;
      document.getElementById('statContactSub').textContent = "aujourd'hui: " + contactsF.filter(e => e.date && e.date.startsWith(today)).length;
      document.getElementById('statChatSub').textContent = "aujourd'hui: " + chats.filter(e => e.date && e.date.startsWith(today)).length;
      document.getElementById('statFeedbackSub').textContent = "aujourd'hui: " + feedbacks.filter(e => e.date && e.date.startsWith(today)).length;

      // Tab counts
      document.getElementById('countAll').textContent = allEntries.length;
      document.getElementById('countEmails').textContent = emailsF.length;
      document.getElementById('countNewsletter').textContent = newsletters.length;
      document.getElementById('countContact').textContent = contactsF.length;
      document.getElementById('countChat').textContent = chats.length;
      document.getElementById('countFeedback').textContent = feedbacks.length;

      document.getElementById('lastUpdate').textContent = 'MAJ ' + new Date().toLocaleTimeString('fr-FR');

      renderFeed();
      } catch (err) {
        console.error('loadAllData crash:', err);
        document.getElementById('feedBody').innerHTML = '<tr><td colspan="5" class="empty-state">Erreur: ' + err.message + '</td></tr>';
      }
    }

    function filterSource(source, btn) {
      currentSource = source;
      document.querySelectorAll('.source-tab').forEach(t => t.classList.remove('active'));
      if (btn) btn.classList.add('active');
      renderFeed();
    }

    function renderFeed() {
      const body = document.getElementById('feedBody');
      let entries = currentSource === 'all'
        ? allEntries
        : allEntries.filter(e => e.source === currentSource);

      if (entries.length === 0) {
        body.innerHTML = '<tr><td colspan="5" class="empty-state">Aucune donnee</td></tr>';
        return;
      }

      body.innerHTML = entries.slice(0, 100).map((e, i) => {
        const badgeClass = e.subtype === 'testimonial' ? 'badge-testimonial' : 'badge-' + e.source;
        const badgeLabel = e.subtype === 'testimonial' ? 'Temoignage' :
          e.source === 'email' ? 'Email' :
          e.source === 'newsletter' ? 'Newsletter' :
          e.source === 'contact' ? 'Contact' :
          e.source === 'chat' ? 'Chat IA' : 'Feedback';

        const time = e.date
          ? new Date(e.date).toLocaleString('fr-FR', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })
          : '-';

        return `<tr onclick="showDetail(${i})" style="cursor:pointer;">
          <td><span class="badge ${badgeClass}">${badgeLabel}</span></td>
          <td class="email-cell">${escapeHtml(e.identifier)}</td>
          <td class="preview-cell">${escapeHtml(e.preview.substring(0, 80))}</td>
          <td><span class="badge-intent">${escapeHtml(e.intent)}</span></td>
          <td class="time-cell">${time}</td>
        </tr>`;
      }).join('');
    }

    function showDetail(index) {
      const entries = currentSource === 'all'
        ? allEntries
        : allEntries.filter(e => e.source === currentSource);
      const e = entries[index];
      if (!e) return;

      const badgeLabel = e.source === 'email' ? '📩 Email' :
        e.source === 'newsletter' ? '📧 Newsletter' :
        e.source === 'contact' ? '✉️ Contact' :
        e.source === 'chat' ? '💬 Chat IA' : '⭐ Feedback';

      document.getElementById('modalTitle').textContent = badgeLabel;

      let html = '';
      const raw = e.raw;

      if (e.source === 'email') {
        html = field('De', (raw.from_name ? raw.from_name + ' ' : '') + '<' + raw.from_email + '>')
          + field('Sujet', raw.subject)
          + field('Categorie', raw.category)
          + field('Date', fmtDate(raw.received_at))
          + '<div class="modal-field"><label>Contenu</label><div class="val" style="background:#0d1321;padding:12px;border-radius:8px;margin-top:4px;max-height:400px;overflow-y:auto;">'
          + escapeHtml(raw.body_text || '(pas de texte)')
          + '</div></div>'
          + field('Notes', raw.notes);
      } else if (e.source === 'newsletter') {
        html = field('Email', raw.email) + field('Date', fmtDate(raw.created_at)) + field('Status', raw.status);
      } else if (e.source === 'contact') {
        html = field('Nom', raw.nom) + field('Email', raw.email) + field('Telephone', raw.telephone)
          + field('Age', raw.age) + field('Sujet', raw.subject) + field('Traitement', raw.treatment)
          + field('Message', raw.message) + field('Newsletter', raw.newsletter ? 'Oui' : 'Non')
          + field('Date', fmtDate(raw.created_at));
      } else if (e.source === 'chat') {
        html = field('Session', raw.session_id) + field('Messages', raw.message_count)
          + field('Page', raw.page_url) + field('Debut', fmtDate(raw.started_at))
          + field('Dernier msg', fmtDate(raw.last_message_at))
          + `<p style="margin-top:1rem;"><a href="/admin/chats/" style="color:#3b82f6;font-weight:600;text-decoration:none;">→ Voir dans Chats IA</a></p>`;
      } else if (e.source === 'feedback') {
        html = field('Nom', raw.name) + field('Email', raw.email) + field('Type', raw.type)
          + field('Note', raw.rating ? raw.rating + '/5' : '-')
          + field('Decouverte', raw.discovery) + field('Interet', raw.interest)
          + field('Contenu', raw.story || raw.comment || '-')
          + field('Page', raw.page_url) + field('Date', fmtDate(raw.created_at));
      }

      document.getElementById('modalBody').innerHTML = html;
      document.getElementById('modalOverlay').classList.add('open');
    }

    function closeModal() {
      document.getElementById('modalOverlay').classList.remove('open');
    }

    // Close modal on overlay click
    document.getElementById('modalOverlay').addEventListener('click', function(ev) {
      if (ev.target === this) closeModal();
    });

    function field(label, val) {
      if (!val && val !== 0) return '';
      return `<div class="modal-field"><label>${escapeHtml(label)}</label><div class="val">${escapeHtml(String(val))}</div></div>`;
    }

    function fmtDate(d) {
      if (!d) return '-';
      return new Date(d).toLocaleString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function escapeHtml(str) {
      if (!str) return '';
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    // Expose functions to global scope for onclick handlers
    window.loadAllData = loadAllData;
    window.filterSource = filterSource;
    window.showDetail = showDetail;
    window.closeModal = closeModal;

    // Auto-load + refresh
    loadAllData();
