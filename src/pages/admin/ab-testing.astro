---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex, nofollow">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A/B Testing - GLP1 Admin</title>
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0e17; color: #e2e8f0; }
    .admin-layout { margin-left: 260px; min-height: 100vh; }

    /* ===== HEADER ===== */
    .page-header {
      background: #111827;
      border-bottom: 1px solid #1e293b;
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; }
    .page-header-left p { font-size: 0.85rem; color: #94a3b8; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn { padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #1e293b; background: #111827; color: #c8d6e5; font-size: 0.82rem; cursor: pointer; }
    .refresh-btn:hover { background: #1a2332; }
    .last-update { font-size: 0.72rem; color: #64748b; }
    .main { padding: 2rem; }

    /* ===== STAT CARDS ===== */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
    }
    .stat-card {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      border-top: 3px solid #334155;
    }
    .stat-card.sc-green { border-top-color: #22c55e; }
    .stat-card.sc-yellow { border-top-color: #eab308; }
    .stat-card.sc-blue { border-top-color: #3b82f6; }
    .stat-card.sc-purple { border-top-color: #8b5cf6; }
    .stat-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #64748b; margin-bottom: 0.4rem; }
    .stat-value { font-size: 2rem; font-weight: 800; }
    .stat-sub { font-size: 0.72rem; color: #475569; margin-top: 0.3rem; }

    /* ===== ACTIONS BAR ===== */
    .actions-bar { display: flex; gap: 0.75rem; margin-bottom: 1.75rem; align-items: center; flex-wrap: wrap; }
    .btn { padding: 0.55rem 1.15rem; border-radius: 8px; border: 1px solid #1e293b; background: #111827; color: #e2e8f0; font-size: 0.82rem; cursor: pointer; font-weight: 600; transition: all 0.15s; font-family: inherit; }
    .btn:hover { background: #1e293b; }
    .btn-primary { background: #6366f1; border-color: #6366f1; color: white; }
    .btn-primary:hover { background: #4f46e5; }
    .btn-green { background: #059669; border-color: #059669; color: white; }
    .btn-green:hover { background: #047857; }
    .btn-red { background: #dc2626; border-color: #dc2626; color: white; }
    .btn-red:hover { background: #b91c1c; }
    .btn-sm { padding: 0.4rem 0.85rem; font-size: 0.75rem; }
    .pills { display: flex; gap: 4px; margin-left: auto; background: #111827; border: 1px solid #1e293b; border-radius: 10px; padding: 3px; }
    .pill { padding: 0.35rem 0.85rem; border-radius: 7px; border: none; background: transparent; color: #94a3b8; font-size: 0.78rem; cursor: pointer; font-weight: 500; font-family: inherit; }
    .pill.active { background: #3b82f6; color: white; }

    /* ===== TEST CARD ===== */
    .test-card {
      background: #111827;
      border: 1px solid #1e293b;
      border-radius: 16px;
      margin-bottom: 1.5rem;
      overflow: hidden;
    }
    .tc-header {
      padding: 1.5rem 1.75rem 1.25rem;
      border-bottom: 1px solid #1e293b;
    }
    .tc-header-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
    .tc-badge {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 3px 10px; border-radius: 20px;
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    }
    .tc-badge-running { background: #052e16; color: #4ade80; }
    .tc-badge-running::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #4ade80; animation: blink 2s infinite; }
    .tc-badge-paused { background: #422006; color: #fbbf24; }
    .tc-badge-completed { background: #172554; color: #60a5fa; }
    .tc-badge-draft { background: #1e293b; color: #94a3b8; }
    @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
    .tc-name { font-size: 1.1rem; font-weight: 700; color: #f1f5f9; font-family: 'Courier New', monospace; }
    .tc-meta { font-size: 0.75rem; color: #64748b; margin-top: 0.15rem; }
    .tc-desc { font-size: 0.82rem; color: #94a3b8; line-height: 1.6; margin-top: 0.65rem; }

    /* ===== VARIANT PREVIEWS (visual mockup) ===== */
    .tc-previews {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      padding: 1.5rem 1.75rem;
      border-bottom: 1px solid #1e293b;
      background: #0d1117;
    }
    .preview-card {
      border: 1px solid #1e293b;
      border-radius: 12px;
      overflow: hidden;
      background: #111827;
    }
    .preview-label {
      padding: 0.6rem 1rem;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      border-bottom: 1px solid #1e293b;
    }
    .preview-label-a { background: #172554; color: #60a5fa; }
    .preview-label-b { background: #052e16; color: #4ade80; }
    .preview-mockup {
      padding: 1.25rem;
      background: #f8fafc;
      color: #1e293b;
      min-height: 120px;
    }
    .mock-badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.6rem; font-weight: 600; margin-bottom: 0.6rem; }
    .mock-h1 { font-size: 0.95rem; font-weight: 800; color: #1e293b; margin-bottom: 0.5rem; line-height: 1.3; }
    .mock-p { font-size: 0.68rem; color: #64748b; margin-bottom: 0.85rem; line-height: 1.5; }
    .mock-btn {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 6px 14px; border-radius: 10px;
      font-size: 0.72rem; font-weight: 700; color: white;
      border: none;
    }
    .mock-btn-blue { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
    .mock-btn-green { background: linear-gradient(135deg, #16a34a, #059669); }
    .mock-btn-secondary {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 6px 14px; border-radius: 10px;
      font-size: 0.72rem; font-weight: 700; color: white;
      background: linear-gradient(135deg, #16a34a, #059669);
      border: none; margin-left: 6px;
    }

    /* ===== DATA TABLE ===== */
    .tc-data { padding: 1.5rem 1.75rem; }
    .tc-section-label {
      font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
      color: #475569; margin-bottom: 0.85rem;
      padding-bottom: 0.5rem; border-bottom: 1px solid #1e293b;
    }
    .vtable { width: 100%; border-collapse: collapse; margin-bottom: 1.25rem; }
    .vtable th {
      text-align: left; padding: 0.6rem 0.85rem;
      font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
      color: #475569; background: #0d1117; border-bottom: 1px solid #1e293b;
    }
    .vtable td { padding: 0.75rem 0.85rem; font-size: 0.85rem; border-bottom: 1px solid #141c2e; }
    .vtable tr:last-child td { border-bottom: none; }
    .vtable tr:hover td { background: rgba(255,255,255,0.02); }
    .vname { font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .vid-tag {
      font-family: 'Courier New', monospace;
      font-size: 0.7rem; font-weight: 700;
      padding: 2px 7px; border-radius: 5px;
    }
    .vid-a { background: #172554; color: #60a5fa; }
    .vid-b { background: #052e16; color: #4ade80; }
    .vid-c { background: #422006; color: #fbbf24; }
    .vlabel { color: #94a3b8; font-weight: 500; font-size: 0.82rem; }
    .mono { font-family: 'Courier New', monospace; font-weight: 600; }
    .delta-up { color: #4ade80; font-weight: 800; font-family: 'Courier New', monospace; }
    .delta-down { color: #f87171; font-weight: 800; font-family: 'Courier New', monospace; }
    .delta-none { color: #475569; }
    .winner-tag { background: #422006; color: #fbbf24; font-size: 0.65rem; font-weight: 700; padding: 2px 6px; border-radius: 5px; margin-left: 0.4rem; }

    /* ===== SIGNIFICANCE PANEL ===== */
    .sig-panel {
      background: #0d1117;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 1.25rem;
      margin-bottom: 1.25rem;
    }
    .sig-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.85rem; }
    .sig-title { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #64748b; }
    .sig-verdict {
      font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 8px;
    }
    .sig-yes { background: #052e16; color: #4ade80; }
    .sig-no { background: #1e293b; color: #fbbf24; }
    .sig-bar-bg { height: 6px; background: #1e293b; border-radius: 3px; overflow: hidden; margin-bottom: 1rem; position: relative; }
    .sig-bar-fill { height: 100%; border-radius: 3px; transition: width 0.5s; }
    .sig-fill-ok { background: linear-gradient(90deg, #22c55e, #4ade80); }
    .sig-fill-wait { background: linear-gradient(90deg, #ca8a04, #eab308); }
    .sig-threshold { position: absolute; top: -3px; bottom: -3px; width: 2px; background: white; opacity: 0.3; border-radius: 1px; }
    .sig-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
    .sig-box { background: #111827; border: 1px solid #1e293b; border-radius: 8px; padding: 0.75rem; }
    .sig-box-label { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #475569; margin-bottom: 0.3rem; }
    .sig-box-val { font-size: 1rem; font-weight: 800; font-family: 'Courier New', monospace; }
    .sig-ok { color: #4ade80; }
    .sig-wait { color: #fbbf24; }
    .sig-neutral { color: #94a3b8; }
    .sample-row { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px solid #1e293b; }
    .sample-bar-bg { flex: 1; height: 4px; background: #1e293b; border-radius: 2px; overflow: hidden; }
    .sample-bar-fill { height: 100%; background: #6366f1; border-radius: 2px; transition: width 0.5s; }
    .sample-text { font-size: 0.7rem; color: #64748b; font-family: 'Courier New', monospace; white-space: nowrap; }

    /* ===== CHART ===== */
    .chart-box { background: #0d1117; border: 1px solid #1e293b; border-radius: 12px; padding: 1rem; margin-bottom: 1.25rem; }
    .chart-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.75rem; }
    .chart-title { font-size: 0.75rem; font-weight: 700; color: #94a3b8; }
    .chart-legend { display: flex; gap: 1rem; }
    .chart-legend-item { display: flex; align-items: center; gap: 5px; font-size: 0.7rem; color: #64748b; }
    .chart-dot { width: 8px; height: 8px; border-radius: 2px; }
    canvas { width: 100% !important; height: 180px !important; display: block; }

    /* ===== CARD FOOTER ===== */
    .tc-actions {
      padding: 1rem 1.75rem;
      background: #0d1117;
      border-top: 1px solid #1e293b;
      display: flex; gap: 0.5rem; align-items: center;
    }
    .tc-actions .spacer { flex: 1; }
    .tc-duration { font-size: 0.7rem; color: #475569; font-family: 'Courier New', monospace; }

    /* ===== MODAL ===== */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 500; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
    .modal-overlay.open { display: flex; }
    .modal { background: #111827; border: 1px solid #1e293b; border-radius: 16px; padding: 2rem; width: 600px; max-width: 92vw; max-height: 85vh; overflow-y: auto; }
    .modal h2 { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.35rem; }
    .modal .modal-sub { font-size: 0.82rem; color: #64748b; margin-bottom: 1.5rem; }
    .form-group { margin-bottom: 1.15rem; }
    .form-group label { display: block; font-size: 0.72rem; font-weight: 700; color: #94a3b8; margin-bottom: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .form-input { width: 100%; padding: 0.6rem 0.85rem; border-radius: 8px; border: 1px solid #1e293b; background: #0d1117; color: #e2e8f0; font-size: 0.85rem; font-family: inherit; }
    .form-input:focus { outline: none; border-color: #6366f1; }
    .form-input::placeholder { color: #334155; }
    textarea.form-input { resize: vertical; min-height: 70px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .variant-builder { background: #0d1117; border-radius: 10px; padding: 0.85rem; border: 1px solid #1e293b; }
    .variant-row { display: grid; grid-template-columns: 70px 1fr 65px 30px; gap: 0.4rem; align-items: center; margin-bottom: 0.4rem; }
    .variant-row input { padding: 0.4rem 0.6rem; border-radius: 6px; border: 1px solid #1e293b; background: #111827; color: #e2e8f0; font-size: 0.82rem; font-family: inherit; }
    .variant-row input:focus { outline: none; border-color: #6366f1; }
    .variant-row .rm-v { background: none; border: none; color: #475569; cursor: pointer; font-size: 1rem; }
    .variant-row .rm-v:hover { color: #f87171; }
    .add-v { background: none; border: 1px dashed #334155; color: #64748b; padding: 0.4rem 0.85rem; border-radius: 6px; font-size: 0.75rem; cursor: pointer; margin-top: 0.4rem; font-family: inherit; }
    .add-v:hover { border-color: #6366f1; color: #818cf8; }
    .modal-btns { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid #1e293b; }

    /* ===== HISTORY ===== */
    .history-section { margin-top: 2rem; }
    .section-divider { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #475569; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #1e293b; }

    .empty-state { text-align: center; padding: 3rem; color: #475569; }
    .empty-state-title { font-size: 0.9rem; font-weight: 600; margin-bottom: 0.3rem; }
    .empty-state-sub { font-size: 0.78rem; color: #334155; }

    @media (max-width: 1100px) { .stats-grid { grid-template-columns: 1fr 1fr; } .sig-grid { grid-template-columns: 1fr 1fr; } .tc-previews { grid-template-columns: 1fr; } }
    @media (max-width: 768px) { .admin-layout { margin-left: 0; } .main { padding: 1rem; } .stats-grid { grid-template-columns: 1fr 1fr; } .form-row { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>A/B Testing</h1>
      <p>Experimentation et optimisation des conversions</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate">--:--</span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card sc-green">
        <div class="stat-label">Tests actifs</div>
        <div class="stat-value" id="statRunning" style="color:#4ade80">-</div>
        <div class="stat-sub">En cours</div>
      </div>
      <div class="stat-card sc-yellow">
        <div class="stat-label">En pause</div>
        <div class="stat-value" id="statPaused" style="color:#eab308">-</div>
        <div class="stat-sub">En attente</div>
      </div>
      <div class="stat-card sc-blue">
        <div class="stat-label">Termines</div>
        <div class="stat-value" id="statCompleted" style="color:#3b82f6">-</div>
        <div class="stat-sub">Winners declares</div>
      </div>
      <div class="stat-card sc-purple">
        <div class="stat-label">Lift moyen</div>
        <div class="stat-value" id="statAvgLift" style="color:#a78bfa">-</div>
        <div class="stat-sub">Sur tests gagnes</div>
      </div>
    </div>

    <!-- Actions -->
    <div class="actions-bar">
      <button class="btn btn-primary" onclick="openCreateModal()">+ Nouveau test</button>
      <div class="pills">
        <button class="pill active" data-filter="all" onclick="setStatusFilter('all')">Tous</button>
        <button class="pill" data-filter="running" onclick="setStatusFilter('running')">Actifs</button>
        <button class="pill" data-filter="paused" onclick="setStatusFilter('paused')">Pauses</button>
        <button class="pill" data-filter="draft" onclick="setStatusFilter('draft')">Brouillons</button>
        <button class="pill" data-filter="completed" onclick="setStatusFilter('completed')">Termines</button>
      </div>
    </div>

    <!-- Tests -->
    <div id="testsContainer"><div class="empty-state"><div class="empty-state-title">Chargement...</div></div></div>

    <div class="history-section" id="historySection" style="display:none">
      <div class="section-divider">Tests termines</div>
      <div id="historyContainer"></div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal-overlay" id="createModal">
  <div class="modal">
    <h2 id="modalTitle">Nouveau test A/B</h2>
    <p class="modal-sub">Definissez l'hypothese, les variantes et la metrique a suivre.</p>
    <input type="hidden" id="editTestId" value="">
    <div class="form-group">
      <label>Nom du test</label>
      <input type="text" class="form-input" id="formName" placeholder="ex: homepage_hero_cta_v2">
    </div>
    <div class="form-group">
      <label>Description / Hypothese</label>
      <textarea class="form-input" id="formDescription" placeholder="Hypothese : ..."></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Page cible</label>
        <input type="text" class="form-input" id="formPage" placeholder="/" value="/">
      </div>
      <div class="form-group">
        <label>Selecteur CSS (optionnel)</label>
        <input type="text" class="form-input" id="formSelector" placeholder=".hero-cta">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Metrique primaire</label>
        <select class="form-input" id="formMetric">
          <option value="coach_open">Coach IA ouvert</option>
          <option value="newsletter_signup">Newsletter signup</option>
          <option value="affiliate_click">Clic affiliate</option>
          <option value="cta_click">Clic CTA</option>
          <option value="tarifs_visit">Visite /tarifs</option>
          <option value="diagnostic_start">Diagnostic demarre</option>
        </select>
      </div>
      <div class="form-group">
        <label>Seuil de confiance</label>
        <select class="form-input" id="formConfidence">
          <option value="0.90">90%</option>
          <option value="0.95" selected>95%</option>
          <option value="0.99">99%</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Echantillon min. / variante</label>
        <input type="number" class="form-input" id="formSample" value="1000" min="100">
      </div>
      <div class="form-group">
        <label>Metriques secondaires</label>
        <input type="text" class="form-input" id="formSecondary" placeholder="coach_open, tarifs_visit">
      </div>
    </div>
    <div class="form-group">
      <label>Variantes</label>
      <div class="variant-builder" id="variantBuilder">
        <div class="variant-row">
          <input type="text" value="control" readonly style="opacity:0.5" class="vid">
          <input type="text" value="Original" placeholder="Label" class="vlabel">
          <input type="number" value="50" min="1" max="100" class="vweight">
          <span style="color:#475569;font-size:0.7rem">%</span>
        </div>
        <div class="variant-row">
          <input type="text" value="B" placeholder="ID" class="vid">
          <input type="text" value="Variante B" placeholder="Label" class="vlabel">
          <input type="number" value="50" min="1" max="100" class="vweight">
          <button class="rm-v" onclick="this.closest('.variant-row').remove()">&times;</button>
        </div>
      </div>
      <button class="add-v" onclick="addVariantRow()">+ Ajouter une variante</button>
    </div>
    <div class="modal-btns">
      <button class="btn" onclick="closeCreateModal()">Annuler</button>
      <button class="btn btn-primary" onclick="saveTest()">Creer le test</button>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allTests = [];
  let allStats = {};
  let statusFilter = 'all';

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(SB_URL + '/rest/v1/' + table + '?' + query, {
      headers: { 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function sbRpc(body, table, method, query) {
    const r = await fetch(SB_URL + '/rest/v1/' + table + (query ? '?' + query : ''), {
      method: method || 'POST',
      headers: { 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY, 'Content-Type': 'application/json', 'Prefer': 'return=representation' },
      body: body ? JSON.stringify(body) : undefined
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  // Z-test
  function calcZTest(nA, cA, nB, cB) {
    if (nA < 1 || nB < 1) return { z: 0, pValue: 1, confidence: 0, lift: 0 };
    var pA = cA / nA, pB = cB / nB;
    var pPool = (cA + cB) / (nA + nB);
    var se = Math.sqrt(pPool * (1 - pPool) * (1 / nA + 1 / nB));
    if (se === 0) return { z: 0, pValue: 1, confidence: 0, lift: 0 };
    var z = (pB - pA) / se;
    var pValue = 2 * (1 - normalCDF(Math.abs(z)));
    return { z: z, pValue: pValue, confidence: 1 - pValue, lift: pA > 0 ? ((pB - pA) / pA * 100) : 0 };
  }
  function normalCDF(x) {
    var a1=0.254829592, a2=-0.284496736, a3=1.421413741, a4=-1.453152027, a5=1.061405429, p=0.3275911;
    var sign = x < 0 ? -1 : 1;
    x = Math.abs(x) / Math.SQRT2;
    var t = 1 / (1 + p * x);
    var y = 1 - (((((a5*t+a4)*t)+a3)*t+a2)*t+a1)*t*Math.exp(-x*x);
    return 0.5 * (1 + sign * y);
  }

  // ===== VISUAL MOCKUPS for known tests =====
  var TEST_PREVIEWS = {
    'homepage_hero_cta': {
