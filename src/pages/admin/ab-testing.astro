  // ===== Load =====
  async function loadAll() {
    try {
      allTests = await sbFetch('ab_tests', 'select=*&order=created_at.desc');
      allStats = {};
      for (var t of allTests) {
        if (t.status === 'draft') continue;
        var res = await Promise.all([
          sbFetch('ab_impressions', 'select=variant_id&test_id=eq.' + t.id),
          sbFetch('ab_conversions', 'select=variant_id,metric_name&test_id=eq.' + t.id)
        ]);
        var impressions = res[0], conversions = res[1];
        var stats = {};
        for (var v of (t.variants || [])) stats[v.id] = { impressions: 0, conversions: {}, totalPrimaryConv: 0 };
        for (var imp of impressions) { if (stats[imp.variant_id]) stats[imp.variant_id].impressions++; }
        for (var conv of conversions) {
          if (!stats[conv.variant_id]) continue;
          stats[conv.variant_id].conversions[conv.metric_name] = (stats[conv.variant_id].conversions[conv.metric_name] || 0) + 1;
          if (conv.metric_name === t.primary_metric) stats[conv.variant_id].totalPrimaryConv++;
        }
        allStats[t.id] = stats;
      }
      renderStats();
      renderAndDrawCharts();
      document.getElementById('lastUpdate').textContent = new Date().toLocaleTimeString('fr-FR');
    } catch(err) {
      document.getElementById('testsContainer').innerHTML = '<div style="background:#450a0a;border:1px solid #991b1b;padding:1rem;border-radius:10px;color:#fca5a5;font-size:0.85rem"><strong>Erreur:</strong> ' + esc(err.message) + '</div>';
    }
  }

  function renderStats() {
    var running = allTests.filter(function(t){return t.status==='running'}).length;
    var paused = allTests.filter(function(t){return t.status==='paused'}).length;
    var completed = allTests.filter(function(t){return t.status==='completed'}).length;
    document.getElementById('statRunning').textContent = running;
    document.getElementById('statPaused').textContent = paused;
    document.getElementById('statCompleted').textContent = completed;
    var lifts = [];
    for (var t of allTests) {
      if (t.status !== 'completed' || !t.winner_variant || t.winner_variant === 'control') continue;
      var s = allStats[t.id]; if (!s) continue;
      var c = s['control'], w = s[t.winner_variant];
      if (c && w && c.impressions > 0) { var rC = c.totalPrimaryConv/c.impressions, rW = w.totalPrimaryConv/w.impressions; if (rC > 0) lifts.push((rW-rC)/rC*100); }
    }
    document.getElementById('statAvgLift').textContent = lifts.length > 0 ? '+' + (lifts.reduce(function(a,b){return a+b},0)/lifts.length).toFixed(1) + '%' : '-';
  }

  var METRIC_LABELS = { coach_open:'Coach IA ouvert', newsletter_signup:'Newsletter signup', affiliate_click:'Clic affiliate', cta_click:'Clic CTA', tarifs_visit:'Visite /tarifs', diagnostic_start:'Diagnostic' };

  function renderTests() {
    var tests = statusFilter === 'all' ? allTests : allTests.filter(function(t){return t.status === statusFilter});
    var active = tests.filter(function(t){return t.status !== 'completed'});
    var completed = tests.filter(function(t){return t.status === 'completed'});
    if (active.length === 0 && completed.length === 0) {
      document.getElementById('testsContainer').innerHTML = '<div class="empty-state"><div class="empty-state-title">Aucun test A/B</div><div class="empty-state-sub">Cliquez "+ Nouveau test" pour commencer</div></div>';
      document.getElementById('historySection').style.display = 'none';
      return;
    }
    document.getElementById('testsContainer').innerHTML = active.length > 0 ? active.map(renderTestCard).join('') : '<div class="empty-state"><div class="empty-state-sub">Aucun test avec ce filtre</div></div>';
    if (completed.length > 0) {
      document.getElementById('historySection').style.display = '';
      document.getElementById('historyContainer').innerHTML = completed.map(renderTestCard).join('');
    } else {
      document.getElementById('historySection').style.display = 'none';
    }
  }

  function renderTestCard(test) {
    var variants = test.variants || [];
    var stats = allStats[test.id] || {};
    var badgeCls = { running:'tc-badge-running', paused:'tc-badge-paused', completed:'tc-badge-completed', draft:'tc-badge-draft' };
    var badgeTxt = { running:'En cours', paused:'En pause', completed:'Termine', draft:'Brouillon' };
    var duration = '';
    if (test.started_at) {
      var days = Math.ceil((( test.ended_at ? new Date(test.ended_at) : new Date()) - new Date(test.started_at)) / 86400000);
      duration = days + 'j';
    }
    var controlStats = stats['control'] || { impressions:0, totalPrimaryConv:0 };
    var controlRate = controlStats.impressions > 0 ? controlStats.totalPrimaryConv / controlStats.impressions : 0;

    // Variant table rows
    var rows = '', bestSig = null;
    for (var i = 0; i < variants.length; i++) {
      var v = variants[i], vs = stats[v.id] || { impressions:0, totalPrimaryConv:0 };
      var rate = vs.impressions > 0 ? vs.totalPrimaryConv / vs.impressions : 0;
      var isCtrl = v.id === 'control';
      var deltaHtml = '<span class="delta-none">&mdash;</span>';
      if (!isCtrl && controlRate > 0) {
        var lift = (rate - controlRate) / controlRate * 100;
        deltaHtml = '<span class="' + (lift > 0 ? 'delta-up' : lift < 0 ? 'delta-down' : 'delta-none') + '">' + (lift >= 0 ? '+' : '') + lift.toFixed(1) + '%</span>';
      }
      if (!isCtrl && controlStats.impressions > 0 && vs.impressions > 0) {
        var sig = calcZTest(controlStats.impressions, controlStats.totalPrimaryConv, vs.impressions, vs.totalPrimaryConv);
        if (!bestSig || sig.confidence > bestSig.confidence) bestSig = sig;
      }
      var vidCls = isCtrl ? 'vid-a' : i === 1 ? 'vid-b' : 'vid-c';
      var winTag = test.winner_variant === v.id ? '<span class="winner-tag">&#9733; WINNER</span>' : '';
      rows += '<tr><td><div class="vname"><span class="vid-tag ' + vidCls + '">' + esc(v.id) + '</span><span class="vlabel">' + esc(v.label) + '</span>' + winTag + '</div></td><td class="mono">' + vs.impressions.toLocaleString('fr-FR') + '</td><td class="mono">' + vs.totalPrimaryConv.toLocaleString('fr-FR') + '</td><td class="mono">' + (rate * 100).toFixed(2) + '%</td><td>' + deltaHtml + '</td></tr>';
    }

    // Significance
    var sigHtml = '';
    if (bestSig && test.status !== 'draft') {
      var confPct = (bestSig.confidence * 100).toFixed(1);
      var target = (test.confidence_target || 0.95) * 100;
      var isSig = bestSig.confidence >= (test.confidence_target || 0.95);
      var barW = Math.min(parseFloat(confPct), 100);
      var minSample = test.min_sample_size || 1000;
      var minImp = Math.min.apply(null, variants.map(function(v){ return (stats[v.id]||{impressions:0}).impressions; }));
      var samplePct = Math.min(Math.round(minImp / minSample * 100), 100);
      sigHtml = '<div class="sig-panel"><div class="sig-top"><span class="sig-title">Significativite statistique</span><span class="sig-verdict ' + (isSig ? 'sig-yes' : 'sig-no') + '">' + (isSig ? '&#10003; Significatif' : '&#9679; En attente de donnees') + '</span></div><div class="sig-bar-bg"><div class="sig-bar-fill ' + (isSig ? 'sig-fill-ok' : 'sig-fill-wait') + '" style="width:' + barW + '%"></div><div class="sig-threshold" style="left:' + target + '%"></div></div><div class="sig-grid"><div class="sig-box"><div class="sig-box-label">p-value</div><div class="sig-box-val ' + (isSig?'sig-ok':'sig-wait') + '">' + bestSig.pValue.toFixed(4) + '</div></div><div class="sig-box"><div class="sig-box-label">Confiance</div><div class="sig-box-val ' + (isSig?'sig-ok':'sig-wait') + '">' + confPct + '%</div></div><div class="sig-box"><div class="sig-box-label">Seuil cible</div><div class="sig-box-val sig-neutral">' + target + '%</div></div><div class="sig-box"><div class="sig-box-label">Lift observe</div><div class="sig-box-val ' + (bestSig.lift > 0 ? 'sig-ok' : bestSig.lift < 0 ? 'sig-wait' : 'sig-neutral') + '">' + (bestSig.lift ? (bestSig.lift > 0 ? '+' : '') + bestSig.lift.toFixed(1) + '%' : '&mdash;') + '</div></div></div><div class="sample-row"><div class="sample-bar-bg"><div class="sample-bar-fill" style="width:' + samplePct + '%"></div></div><span class="sample-text">' + minImp.toLocaleString('fr-FR') + ' / ' + minSample.toLocaleString('fr-FR') + ' impressions (' + samplePct + '%)</span></div></div>';
    }

    // Visual previews
    var previewsHtml = '';
    var previews = TEST_PREVIEWS[test.name];
    if (previews && test.status !== 'draft') {
      var previewCards = '';
      for (var j = 0; j < variants.length; j++) {
        var vv = variants[j];
        var mockHtml = previews[vv.id] || '<div class="mock-p" style="text-align:center;padding:2rem 0;color:#94a3b8">Apercu non configure</div>';
        var labelCls = vv.id === 'control' ? 'preview-label-a' : 'preview-label-b';
        previewCards += '<div class="preview-card"><div class="preview-label ' + labelCls + '"><span class="vid-tag ' + (vv.id === 'control' ? 'vid-a' : 'vid-b') + '">' + esc(vv.id) + '</span> ' + esc(vv.label) + '</div><div class="preview-mockup">' + mockHtml + '</div></div>';
      }
      previewsHtml = '<div class="tc-previews">' + previewCards + '</div>';
    }

    // Actions
    var actions = '';
    if (test.status === 'draft') {
      actions = '<button class="btn btn-sm btn-green" onclick="startTest(\'' + test.id + '\')">&#9654; Lancer</button><button class="btn btn-sm" onclick="openEditModal(\'' + test.id + '\')">Modifier</button><span class="spacer"></span><button class="btn btn-sm btn-red" onclick="deleteTest(\'' + test.id + '\')">Supprimer</button>';
    } else if (test.status === 'running') {
      actions = '<button class="btn btn-sm" onclick="pauseTest(\'' + test.id + '\')">&#10074;&#10074; Pause</button><button class="btn btn-sm btn-green" onclick="declareWinner(\'' + test.id + '\')">&#9733; Winner</button><span class="spacer"></span>' + (duration ? '<span class="tc-duration">' + duration + '</span>' : '') + '<button class="btn btn-sm btn-red" onclick="stopTest(\'' + test.id + '\')">Arreter</button>';
    } else if (test.status === 'paused') {
      actions = '<button class="btn btn-sm btn-green" onclick="resumeTest(\'' + test.id + '\')">&#9654; Reprendre</button><span class="spacer"></span><button class="btn btn-sm btn-red" onclick="stopTest(\'' + test.id + '\')">Arreter</button>';
    } else {
      actions = '<span class="tc-duration">' + duration + '</span><span class="spacer"></span>';
    }

    return '<div class="test-card"><div class="tc-header"><div class="tc-header-row"><span class="tc-badge ' + (badgeCls[test.status]||'') + '">' + (badgeTxt[test.status]||test.status) + '</span><span class="tc-name">' + esc(test.name) + '</span></div><div class="tc-meta">' + esc(test.page_target) + ' &middot; ' + esc(METRIC_LABELS[test.primary_metric]||test.primary_metric) + (duration ? ' &middot; ' + duration : '') + '</div>' + (test.description ? '<div class="tc-desc">' + esc(test.description) + '</div>' : '') + '</div>' + previewsHtml + (test.status !== 'draft' ? '<div class="tc-data"><div class="tc-section-label">Resultats par variante</div><table class="vtable"><thead><tr><th>Variante</th><th>Impressions</th><th>Conversions</th><th>Taux</th><th>Delta</th></tr></thead><tbody>' + rows + '</tbody></table>' + sigHtml + '<div class="chart-box"><div class="chart-top"><span class="chart-title">Taux de conversion / jour</span><div class="chart-legend" id="legend-' + test.id + '"></div></div><canvas id="chart-' + test.id + '" height="180"></canvas></div></div>' : '') + '<div class="tc-actions">' + actions + '</div></div>';
  }

  // ===== Charts =====
  var COLORS = ['#60a5fa','#4ade80','#fbbf24','#f87171','#a78bfa'];

  async function loadDailyData(testId, metric) {
    var res = await Promise.all([
      sbFetch('ab_impressions', 'select=variant_id,created_at&test_id=eq.' + testId + '&order=created_at.asc'),
      sbFetch('ab_conversions', 'select=variant_id,created_at&test_id=eq.' + testId + '&metric_name=eq.' + metric + '&order=created_at.asc')
    ]);
    var byDay = {};
    for (var imp of res[0]) { var d = imp.created_at.slice(0,10), k = d+':'+imp.variant_id; if(!byDay[k]) byDay[k]={day:d,variant:imp.variant_id,impressions:0,conversions:0}; byDay[k].impressions++; }
    for (var conv of res[1]) { var d2 = conv.created_at.slice(0,10), k2 = d2+':'+conv.variant_id; if(!byDay[k2]) byDay[k2]={day:d2,variant:conv.variant_id,impressions:0,conversions:0}; byDay[k2].conversions++; }
    return Object.values(byDay);
  }

  function drawChart(canvasId, test) {
    var canvas = document.getElementById(canvasId);
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var rect = canvas.parentElement.getBoundingClientRect();
    var dpr = window.devicePixelRatio || 1;
    canvas.width = (rect.width - 24) * dpr; canvas.height = 180 * dpr;
    canvas.style.width = (rect.width - 24) + 'px'; canvas.style.height = '180px';
    ctx.scale(dpr, dpr);
    var W = rect.width - 24, H = 180;
    var pad = { top: 10, right: 12, bottom: 26, left: 44 };

    var legendEl = document.getElementById('legend-' + test.id);
    if (legendEl) legendEl.innerHTML = test.variants.map(function(v, i) {
      return '<div class="chart-legend-item"><div class="chart-dot" style="background:' + COLORS[i] + '"></div>' + esc(v.label || v.id) + '</div>';
    }).join('');

    loadDailyData(test.id, test.primary_metric).then(function(data) {
      ctx.clearRect(0, 0, W, H);
      if (data.length === 0) { ctx.fillStyle = '#334155'; ctx.font = '12px sans-serif'; ctx.textAlign = 'center'; ctx.fillText('En attente de donnees...', W/2, H/2); return; }
      var vs = test.variants.map(function(v){return v.id});
      var days = []; data.forEach(function(d){ if(days.indexOf(d.day)===-1) days.push(d.day); }); days.sort();
      var ratesBy = {};
      vs.forEach(function(v){ ratesBy[v] = days.map(function(day){ var e = data.find(function(d){return d.day===day && d.variant===v}); return (!e||e.impressions===0) ? null : e.conversions/e.impressions*100; }); });
      var all = []; Object.values(ratesBy).forEach(function(r){ r.forEach(function(v){ if(v!==null) all.push(v); }); });
      var maxR = all.length > 0 ? Math.max.apply(null, all) * 1.3 : 10;
      var pW = W-pad.left-pad.right, pH = H-pad.top-pad.bottom;
      ctx.strokeStyle = '#1e293b'; ctx.lineWidth = 1;
      for (var g = 0; g <= 4; g++) { var y = pad.top+(pH/4)*g; ctx.beginPath(); ctx.moveTo(pad.left,y); ctx.lineTo(W-pad.right,y); ctx.stroke(); ctx.fillStyle='#475569'; ctx.font='10px monospace'; ctx.textAlign='right'; ctx.fillText((maxR-(maxR/4)*g).toFixed(1)+'%', pad.left-6, y+3); }
      ctx.fillStyle='#475569'; ctx.font='10px monospace'; ctx.textAlign='center';
      var step = Math.max(1, Math.floor(days.length / 6));
      for (var xi = 0; xi < days.length; xi += step) { var xx = pad.left + (xi / Math.max(days.length-1,1)) * pW; ctx.fillText(days[xi].slice(5), xx, H-6); }
      vs.forEach(function(v, vi) {
        var rates = ratesBy[v], color = COLORS[vi % COLORS.length];
        ctx.strokeStyle = color; ctx.lineWidth = 2.5; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
        ctx.beginPath(); var started = false;
        for (var di = 0; di < days.length; di++) { if (rates[di] === null) continue; var x2 = pad.left + (di/Math.max(days.length-1,1))*pW; var y2 = pad.top+pH-(rates[di]/maxR)*pH; if(!started){ctx.moveTo(x2,y2);started=true;}else ctx.lineTo(x2,y2); }
        ctx.stroke();
        for (var di2 = 0; di2 < days.length; di2++) { if (rates[di2] === null) continue; var x3 = pad.left+(di2/Math.max(days.length-1,1))*pW; var y3 = pad.top+pH-(rates[di2]/maxR)*pH; ctx.beginPath(); ctx.arc(x3,y3,3,0,Math.PI*2); ctx.fillStyle='#0a0e17'; ctx.fill(); ctx.strokeStyle=color; ctx.lineWidth=2; ctx.stroke(); }
      });
    });
  }

  function renderAndDrawCharts() {
    renderTests();
    requestAnimationFrame(function() {
      allTests.forEach(function(t) { if (t.status !== 'draft') drawChart('chart-' + t.id, t); });
    });
  }

  // ===== Actions =====
  window.setStatusFilter = function(f) { statusFilter = f; document.querySelectorAll('.pill').forEach(function(p){p.classList.toggle('active', p.dataset.filter===f)}); renderAndDrawCharts(); };
  window.startTest = async function(id) { await sbRpc({status:'running',started_at:new Date().toISOString()},'ab_tests','PATCH','id=eq.'+id); loadAll(); };
  window.pauseTest = async function(id) { await sbRpc({status:'paused'},'ab_tests','PATCH','id=eq.'+id); loadAll(); };
  window.resumeTest = async function(id) { await sbRpc({status:'running'},'ab_tests','PATCH','id=eq.'+id); loadAll(); };
  window.stopTest = async function(id) { if(!confirm('Arreter ce test ?')) return; await sbRpc({status:'completed',ended_at:new Date().toISOString()},'ab_tests','PATCH','id=eq.'+id); loadAll(); };
  window.deleteTest = async function(id) { if(!confirm('Supprimer ce test ?')) return; await fetch(SB_URL+'/rest/v1/ab_tests?id=eq.'+id,{method:'DELETE',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY}}); loadAll(); };
  window.declareWinner = async function(id) {
    var test = allTests.find(function(t){return t.id===id});
    if(!test) return;
    var vs = (test.variants||[]).filter(function(v){return v.id!=='control'});
    var winner = prompt('Declarer le winner :\n' + vs.map(function(v){return '  '+v.id+' — '+v.label}).join('\n') + '\n\nEntrez l\'ID:', vs[0]?.id||'');
    if(!winner) return;
    await sbRpc({status:'completed',winner_variant:winner,ended_at:new Date().toISOString()},'ab_tests','PATCH','id=eq.'+id); loadAll();
  };

