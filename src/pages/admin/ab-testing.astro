---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A/B Testing - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0a0e17; color: #e2e8f0; }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header { background: #111827; border-bottom: 1px solid #1e293b; padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #e2e8f0; }
    .page-header-left p { font-size: 0.88rem; color: #94a3b8; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn { padding: 0.5rem 1rem; border-radius: 8px; border: 1px solid #1e293b; background: #111827; color: #c8d6e5; font-size: 0.82rem; cursor: pointer; }
    .refresh-btn:hover { background: #1a2332; }
    .last-update { font-size: 0.72rem; color: #64748b; }
    .main { padding: 2rem; }

    /* Stats grid */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: #111827; border-radius: 12px; padding: 1.25rem; border: 1px solid #1e293b; }
    .stat-card .label { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin-bottom: 0.5rem; }
    .stat-card .value { font-size: 2rem; font-weight: 800; line-height: 1; }
    .stat-card .sub { font-size: 0.75rem; color: #64748b; margin-top: 0.35rem; }

    /* Actions bar */
    .actions-bar { display: flex; gap: 0.75rem; margin-bottom: 2rem; align-items: center; }
    .btn { padding: 0.55rem 1.1rem; border-radius: 8px; border: 1px solid #1e293b; background: #111827; color: #e2e8f0; font-size: 0.82rem; cursor: pointer; font-weight: 600; transition: all 0.15s; }
    .btn:hover { background: #1e293b; }
    .btn-primary { background: #3b82f6; border-color: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-green { background: #059669; border-color: #059669; color: white; }
    .btn-green:hover { background: #047857; }
    .btn-red { background: #dc2626; border-color: #dc2626; color: white; }
    .btn-red:hover { background: #b91c1c; }
    .filter-pills { display: flex; gap: 0.5rem; margin-left: auto; }
    .pill { padding: 0.4rem 0.85rem; border-radius: 20px; border: 1px solid #1e293b; background: #111827; color: #94a3b8; font-size: 0.78rem; cursor: pointer; font-weight: 500; }
    .pill:hover { border-color: #334155; color: #e2e8f0; }
    .pill.active { background: #3b82f6; color: white; border-color: #3b82f6; }

    /* Test cards */
    .test-card { background: #111827; border: 1px solid #1e293b; border-radius: 14px; padding: 1.5rem; margin-bottom: 1.25rem; transition: border-color 0.15s; }
    .test-card:hover { border-color: #334155; }
    .test-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .test-status { display: inline-flex; align-items: center; gap: 0.35rem; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .ts-running { background: #052e16; color: #4ade80; }
    .ts-running::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #4ade80; animation: pulse-dot 2s infinite; }
    .ts-paused { background: #451a03; color: #fbbf24; }
    .ts-completed { background: #1e3a5f; color: #93c5fd; }
    .ts-draft { background: #1e293b; color: #64748b; }
    .test-name { font-size: 1.1rem; font-weight: 700; color: #f1f5f9; flex: 1; }
    .test-meta { font-size: 0.75rem; color: #64748b; }
    .test-description { font-size: 0.85rem; color: #94a3b8; margin-bottom: 1.25rem; line-height: 1.5; }

    /* Variant table inside test card */
    .variant-table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
    .variant-table th { text-align: left; padding: 0.6rem 0.75rem; font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; border-bottom: 1px solid #1e293b; }
    .variant-table td { padding: 0.6rem 0.75rem; font-size: 0.85rem; border-bottom: 1px solid #1a2332; }
    .variant-table tr:last-child td { border-bottom: none; }
    .variant-table tr:hover td { background: #0f1520; }
    .variant-name { font-weight: 600; color: #e2e8f0; }
    .variant-control { color: #94a3b8; }
    .delta-positive { color: #4ade80; font-weight: 700; }
    .delta-negative { color: #f87171; font-weight: 700; }
    .delta-neutral { color: #64748b; }

    /* Significance bar */
    .sig-box { background: #0f1520; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
    .sig-bar-wrap { height: 8px; background: #1e293b; border-radius: 4px; overflow: hidden; margin-bottom: 0.6rem; }
    .sig-bar { height: 100%; border-radius: 4px; transition: width 0.5s; }
    .sig-bar.significant { background: linear-gradient(90deg, #059669, #4ade80); }
    .sig-bar.not-significant { background: linear-gradient(90deg, #d97706, #fbbf24); }
    .sig-details { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .sig-detail { font-size: 0.78rem; }
    .sig-label { color: #64748b; }
    .sig-value { font-weight: 700; margin-left: 0.35rem; }
    .sig-pass { color: #4ade80; }
    .sig-fail { color: #fbbf24; }

    /* Chart */
    .chart-container { background: #0f1520; border-radius: 10px; padding: 1rem; margin-bottom: 1rem; }
    .chart-title { font-size: 0.78rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.75rem; }
    canvas { width: 100% !important; height: 200px !important; }

    /* Test card actions */
    .test-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .test-actions .btn { font-size: 0.75rem; padding: 0.4rem 0.85rem; }

    /* Create test modal */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 500; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
    .modal-overlay.open { display: flex; }
    .modal { background: #111827; border: 1px solid #1e293b; border-radius: 16px; padding: 2rem; width: 600px; max-width: 90vw; max-height: 85vh; overflow-y: auto; }
    .modal h2 { font-size: 1.2rem; font-weight: 700; margin-bottom: 1.5rem; }
    .form-group { margin-bottom: 1.25rem; }
    .form-group label { display: block; font-size: 0.78rem; font-weight: 600; color: #94a3b8; margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .form-input { width: 100%; padding: 0.6rem 0.85rem; border-radius: 8px; border: 1px solid #1e293b; background: #0f1520; color: #e2e8f0; font-size: 0.85rem; }
    .form-input:focus { outline: none; border-color: #3b82f6; }
    .form-input::placeholder { color: #475569; }
    textarea.form-input { resize: vertical; min-height: 80px; }
    select.form-input { cursor: pointer; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .variant-builder { background: #0f1520; border-radius: 10px; padding: 1rem; }
    .variant-row { display: grid; grid-template-columns: 80px 1fr 80px 40px; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .variant-row input { padding: 0.4rem 0.6rem; border-radius: 6px; border: 1px solid #1e293b; background: #111827; color: #e2e8f0; font-size: 0.82rem; }
    .variant-row .remove-variant { background: none; border: none; color: #64748b; cursor: pointer; font-size: 1rem; padding: 0.25rem; }
    .variant-row .remove-variant:hover { color: #ef4444; }
    .add-variant-btn { background: none; border: 1px dashed #334155; color: #64748b; padding: 0.4rem 0.85rem; border-radius: 6px; font-size: 0.78rem; cursor: pointer; margin-top: 0.5rem; }
    .add-variant-btn:hover { border-color: #3b82f6; color: #3b82f6; }
    .modal-actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem; }

    /* History */
    .history-section { margin-top: 2rem; }
    .section-title { font-size: 1rem; font-weight: 700; color: #e2e8f0; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid #1e293b; }

    .empty-state { text-align: center; padding: 3rem; color: #64748b; font-size: 0.85rem; }

    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    @media (max-width: 1100px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .admin-layout { margin-left: 0; } .main { padding: 1rem; } .stats-grid { grid-template-columns: 1fr 1fr; } .form-row { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>A/B Testing</h1>
      <p>Experimentation et optimisation des conversions — Coach IA, leads, affiliates</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate">-</span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">Tests actifs</div>
        <div class="value" id="statRunning" style="color:#4ade80">-</div>
        <div class="sub">En cours</div>
      </div>
      <div class="stat-card">
        <div class="label">Tests pauses</div>
        <div class="value" id="statPaused" style="color:#fbbf24">-</div>
        <div class="sub">En attente</div>
      </div>
      <div class="stat-card">
        <div class="label">Winners declares</div>
        <div class="value" id="statCompleted" style="color:#3b82f6">-</div>
        <div class="sub">Termines</div>
      </div>
      <div class="stat-card">
        <div class="label">Lift moyen</div>
        <div class="value" id="statAvgLift" style="color:#a78bfa">-</div>
        <div class="sub">Sur les winners</div>
      </div>
    </div>

    <!-- Actions bar -->
    <div class="actions-bar">
      <button class="btn btn-primary" onclick="openCreateModal()">+ Nouveau test</button>
      <div class="filter-pills">
        <button class="pill active" data-filter="all" onclick="setStatusFilter('all')">Tous</button>
        <button class="pill" data-filter="running" onclick="setStatusFilter('running')">Actifs</button>
        <button class="pill" data-filter="paused" onclick="setStatusFilter('paused')">Pauses</button>
        <button class="pill" data-filter="draft" onclick="setStatusFilter('draft')">Brouillons</button>
        <button class="pill" data-filter="completed" onclick="setStatusFilter('completed')">Termines</button>
      </div>
    </div>

    <!-- Test cards -->
    <div id="testsContainer"><div class="empty-state">Chargement...</div></div>

    <!-- Completed tests history -->
    <div class="history-section" id="historySection" style="display:none">
      <div class="section-title">Historique des tests termines</div>
      <div id="historyContainer"></div>
    </div>
  </div>
</div>

<!-- Create/Edit Modal -->
<div class="modal-overlay" id="createModal">
  <div class="modal">
    <h2 id="modalTitle">Nouveau test A/B</h2>
    <input type="hidden" id="editTestId" value="">
    <div class="form-group">
      <label>Nom du test</label>
      <input type="text" class="form-input" id="formName" placeholder="ex: homepage_hero_cta_v2">
    </div>
    <div class="form-group">
      <label>Description</label>
      <textarea class="form-input" id="formDescription" placeholder="Hypothese : changer le CTA principal augmente les conversions coach IA..."></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Page cible</label>
        <input type="text" class="form-input" id="formPage" placeholder="/" value="/">
      </div>
      <div class="form-group">
        <label>Selecteur CSS (optionnel)</label>
        <input type="text" class="form-input" id="formSelector" placeholder=".hero-cta">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Metrique primaire</label>
        <select class="form-input" id="formMetric">
          <option value="coach_open">Coach IA ouvert</option>
          <option value="newsletter_signup">Newsletter signup</option>
          <option value="affiliate_click">Clic affiliate</option>
          <option value="cta_click">Clic CTA</option>
          <option value="tarifs_visit">Visite /tarifs</option>
          <option value="diagnostic_start">Diagnostic demarre</option>
        </select>
      </div>
      <div class="form-group">
        <label>Seuil de confiance</label>
        <select class="form-input" id="formConfidence">
          <option value="0.90">90%</option>
          <option value="0.95" selected>95%</option>
          <option value="0.99">99%</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Echantillon min. par variante</label>
        <input type="number" class="form-input" id="formSample" value="1000" min="100">
      </div>
      <div class="form-group">
        <label>Metriques secondaires</label>
        <input type="text" class="form-input" id="formSecondary" placeholder="coach_open, tarifs_visit">
      </div>
    </div>

    <div class="form-group">
      <label>Variantes</label>
      <div class="variant-builder" id="variantBuilder">
        <div class="variant-row">
          <input type="text" value="control" readonly style="opacity:0.6" class="vid">
          <input type="text" value="Original" placeholder="Label" class="vlabel">
          <input type="number" value="50" min="1" max="100" class="vweight">
          <span style="color:#64748b;font-size:0.72rem">%</span>
        </div>
        <div class="variant-row">
          <input type="text" value="B" placeholder="ID" class="vid">
          <input type="text" value="Variante B" placeholder="Label" class="vlabel">
          <input type="number" value="50" min="1" max="100" class="vweight">
          <button class="remove-variant" onclick="this.closest('.variant-row').remove()">x</button>
        </div>
      </div>
      <button class="add-variant-btn" onclick="addVariantRow()">+ Ajouter une variante</button>
    </div>

    <div class="modal-actions">
      <button class="btn" onclick="closeCreateModal()">Annuler</button>
      <button class="btn btn-primary" onclick="saveTest()">Creer le test</button>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allTests = [];
  let allStats = [];
  let statusFilter = 'all';

  function esc(s) { if (!s) return ''; const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  async function sbRpc(body, table, method, query) {
    const opts = {
      method: method || 'POST',
      headers: {
        'apikey': SB_KEY,
        'Authorization': `Bearer ${SB_KEY}`,
        'Content-Type': 'application/json',
        'Prefer': 'return=representation'
      }
    };
    if (body) opts.body = JSON.stringify(body);
    const url = `${SB_URL}/rest/v1/${table}${query ? '?' + query : ''}`;
    const r = await fetch(url, opts);
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  // ============= Statistical significance =============
  function calcZTest(impressionsA, conversionsA, impressionsB, conversionsB) {
    if (impressionsA < 1 || impressionsB < 1) return { z: 0, pValue: 1, significant: false, confidence: 0 };
    const pA = conversionsA / impressionsA;
    const pB = conversionsB / impressionsB;
    const pPool = (conversionsA + conversionsB) / (impressionsA + impressionsB);
    const se = Math.sqrt(pPool * (1 - pPool) * (1 / impressionsA + 1 / impressionsB));
    if (se === 0) return { z: 0, pValue: 1, significant: false, confidence: 0 };
    const z = (pB - pA) / se;
    // Two-tailed p-value approximation
    const pValue = 2 * (1 - normalCDF(Math.abs(z)));
    return { z, pValue, significant: false, confidence: 1 - pValue, lift: pA > 0 ? ((pB - pA) / pA * 100) : 0 };
  }

  function normalCDF(x) {
    const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429;
    const p = 0.3275911;
    const sign = x < 0 ? -1 : 1;
    x = Math.abs(x) / Math.SQRT2;
    const t = 1.0 / (1.0 + p * x);
    const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
    return 0.5 * (1.0 + sign * y);
  }

  // ============= Load data =============
  async function loadAll() {
    try {
      // Load tests
      allTests = await sbFetch('ab_tests', 'select=*&order=created_at.desc');

      // Load stats per test (impressions + conversions aggregated)
      allStats = {};
      for (const test of allTests) {
        if (test.status === 'draft') continue;
        const [impressions, conversions] = await Promise.all([
          sbFetch('ab_impressions', `select=variant_id&test_id=eq.${test.id}`),
          sbFetch('ab_conversions', `select=variant_id,metric_name&test_id=eq.${test.id}`)
        ]);

        const variants = test.variants || [];
        const stats = {};
        for (const v of variants) {
          stats[v.id] = { impressions: 0, conversions: {}, totalPrimaryConv: 0 };
        }
        for (const imp of impressions) {
          if (stats[imp.variant_id]) stats[imp.variant_id].impressions++;
        }
        for (const conv of conversions) {
          if (!stats[conv.variant_id]) continue;
          if (!stats[conv.variant_id].conversions[conv.metric_name]) stats[conv.variant_id].conversions[conv.metric_name] = 0;
          stats[conv.variant_id].conversions[conv.metric_name]++;
          if (conv.metric_name === test.primary_metric) stats[conv.variant_id].totalPrimaryConv++;
        }
        allStats[test.id] = stats;
      }

      renderStats();
      renderTests();
      document.getElementById('lastUpdate').textContent = 'Mis a jour: ' + new Date().toLocaleTimeString('fr-FR');
    } catch(err) {
      document.getElementById('testsContainer').innerHTML = `<div style="background:#450a0a;border:1px solid #991b1b;padding:1rem;border-radius:10px;color:#fca5a5;font-size:0.85rem"><strong>Erreur:</strong> ${esc(err.message)}</div>`;
    }
  }

  function renderStats() {
    const running = allTests.filter(t => t.status === 'running').length;
    const paused = allTests.filter(t => t.status === 'paused').length;
    const completed = allTests.filter(t => t.status === 'completed').length;

    document.getElementById('statRunning').textContent = running;
    document.getElementById('statPaused').textContent = paused;
    document.getElementById('statCompleted').textContent = completed;

    // Average lift from completed tests with winners
    const lifts = [];
    for (const test of allTests) {
      if (test.status !== 'completed' || !test.winner_variant || test.winner_variant === 'control') continue;
      const stats = allStats[test.id];
      if (!stats) continue;
      const control = stats['control'];
      const winner = stats[test.winner_variant];
      if (control && winner && control.impressions > 0) {
        const rateC = control.totalPrimaryConv / control.impressions;
        const rateW = winner.totalPrimaryConv / winner.impressions;
        if (rateC > 0) lifts.push((rateW - rateC) / rateC * 100);
      }
    }
    document.getElementById('statAvgLift').textContent = lifts.length > 0 ? '+' + (lifts.reduce((a, b) => a + b, 0) / lifts.length).toFixed(1) + '%' : '-';
  }

  function renderTests() {
    let tests = allTests;
    if (statusFilter !== 'all') tests = tests.filter(t => t.status === statusFilter);

    const active = tests.filter(t => t.status !== 'completed');
    const completed = tests.filter(t => t.status === 'completed');

    if (active.length === 0 && completed.length === 0) {
      document.getElementById('testsContainer').innerHTML = '<div class="empty-state">Aucun test A/B — cliquez "Nouveau test" pour commencer</div>';
      document.getElementById('historySection').style.display = 'none';
      return;
    }

    document.getElementById('testsContainer').innerHTML = active.length > 0 ? active.map(t => renderTestCard(t)).join('') : '<div class="empty-state">Aucun test actif avec ce filtre</div>';

    if (completed.length > 0) {
      document.getElementById('historySection').style.display = '';
      document.getElementById('historyContainer').innerHTML = completed.map(t => renderTestCard(t)).join('');
    } else {
      document.getElementById('historySection').style.display = 'none';
    }
  }

  function renderTestCard(test) {
    const variants = test.variants || [];
    const stats = allStats[test.id] || {};
    const statusCls = { running: 'ts-running', paused: 'ts-paused', completed: 'ts-completed', draft: 'ts-draft' };
    const statusLabels = { running: 'Actif', paused: 'Pause', completed: 'Termine', draft: 'Brouillon' };

    // Duration
    let duration = '';
    if (test.started_at) {
      const start = new Date(test.started_at);
      const end = test.ended_at ? new Date(test.ended_at) : new Date();
      const days = Math.ceil((end - start) / 86400000);
      duration = `${days} jour${days > 1 ? 's' : ''}`;
    }

    // Control stats for delta calculations
    const controlStats = stats['control'] || { impressions: 0, totalPrimaryConv: 0 };
    const controlRate = controlStats.impressions > 0 ? controlStats.totalPrimaryConv / controlStats.impressions : 0;

    // Build variant rows
    let variantRows = '';
    let bestVariant = null;
    let bestSignificance = null;

    for (const v of variants) {
      const vs = stats[v.id] || { impressions: 0, totalPrimaryConv: 0 };
      const rate = vs.impressions > 0 ? vs.totalPrimaryConv / vs.impressions : 0;
      const rateStr = (rate * 100).toFixed(2) + '%';
      const isControl = v.id === 'control';

      let deltaStr = '-';
      let deltaCls = 'delta-neutral';
      if (!isControl && controlRate > 0) {
        const lift = ((rate - controlRate) / controlRate * 100);
        deltaStr = (lift >= 0 ? '+' : '') + lift.toFixed(1) + '%';
        deltaCls = lift > 0 ? 'delta-positive' : lift < 0 ? 'delta-negative' : 'delta-neutral';
      }

      // Significance vs control
      if (!isControl && controlStats.impressions > 0 && vs.impressions > 0) {
        const result = calcZTest(controlStats.impressions, controlStats.totalPrimaryConv, vs.impressions, vs.totalPrimaryConv);
        if (!bestSignificance || result.confidence > bestSignificance.confidence) {
          bestSignificance = result;
          bestVariant = v.id;
        }
      }

      const nameClass = isControl ? 'variant-control' : 'variant-name';
      const winBadge = test.winner_variant === v.id ? ' &#x1F3C6;' : '';
      variantRows += `<tr>
        <td class="${nameClass}">${esc(v.id)}${winBadge} <span style="color:#64748b;font-size:0.72rem">${esc(v.label)}</span></td>
        <td>${vs.impressions.toLocaleString('fr-FR')}</td>
        <td>${vs.totalPrimaryConv.toLocaleString('fr-FR')}</td>
        <td>${rateStr}</td>
        <td class="${deltaCls}">${deltaStr}</td>
      </tr>`;
    }

    // Significance box
    let sigBox = '';
    if (bestSignificance && test.status !== 'draft') {
      const confPct = (bestSignificance.confidence * 100).toFixed(1);
      const target = (test.confidence_target || 0.95) * 100;
      const isSig = bestSignificance.confidence >= (test.confidence_target || 0.95);
      const barWidth = Math.min(confPct, 100);
      const barClass = isSig ? 'significant' : 'not-significant';

      // Sample size progress
      const minSample = test.min_sample_size || 1000;
      const minImpressions = Math.min(...variants.map(v => (stats[v.id] || { impressions: 0 }).impressions));
      const samplePct = Math.min(Math.round(minImpressions / minSample * 100), 100);
      const sampleOk = minImpressions >= minSample;

      sigBox = `<div class="sig-box">
        <div class="sig-bar-wrap"><div class="sig-bar ${barClass}" style="width:${barWidth}%"></div></div>
        <div class="sig-details">
          <div class="sig-detail"><span class="sig-label">p-value :</span><span class="sig-value ${isSig ? 'sig-pass' : 'sig-fail'}">${bestSignificance.pValue.toFixed(4)}</span></div>
          <div class="sig-detail"><span class="sig-label">Confiance :</span><span class="sig-value ${isSig ? 'sig-pass' : 'sig-fail'}">${confPct}%</span></div>
          <div class="sig-detail"><span class="sig-label">Seuil :</span><span class="sig-value">${target}%</span></div>
          <div class="sig-detail"><span class="sig-label">Significatif :</span><span class="sig-value ${isSig ? 'sig-pass' : 'sig-fail'}">${isSig ? 'Oui' : 'Pas encore'}</span></div>
          <div class="sig-detail"><span class="sig-label">Echantillon :</span><span class="sig-value ${sampleOk ? 'sig-pass' : 'sig-fail'}">${samplePct}% (${minImpressions}/${minSample})</span></div>
        </div>
      </div>`;
    }

    // Actions
    let actions = '';
    if (test.status === 'draft') {
      actions = `<button class="btn btn-green" onclick="startTest('${test.id}')">Lancer</button>
        <button class="btn" onclick="openEditModal('${test.id}')">Modifier</button>
        <button class="btn btn-red" onclick="deleteTest('${test.id}')">Supprimer</button>`;
    } else if (test.status === 'running') {
      actions = `<button class="btn" onclick="pauseTest('${test.id}')">Pause</button>
        <button class="btn btn-green" onclick="declareWinner('${test.id}')">Declarer winner</button>
        <button class="btn btn-red" onclick="stopTest('${test.id}')">Arreter</button>`;
    } else if (test.status === 'paused') {
      actions = `<button class="btn btn-green" onclick="resumeTest('${test.id}')">Reprendre</button>
        <button class="btn btn-red" onclick="stopTest('${test.id}')">Arreter</button>`;
    }

    const metricLabels = { coach_open: 'Coach IA ouvert', newsletter_signup: 'Newsletter signup', affiliate_click: 'Clic affiliate', cta_click: 'Clic CTA', tarifs_visit: 'Visite /tarifs', diagnostic_start: 'Diagnostic' };

    return `<div class="test-card">
      <div class="test-header">
        <span class="test-status ${statusCls[test.status] || ''}">${statusLabels[test.status] || test.status}</span>
        <span class="test-name">${esc(test.name)}</span>
        <span class="test-meta">${esc(test.page_target)} · ${esc(metricLabels[test.primary_metric] || test.primary_metric)}${duration ? ' · ' + duration : ''}</span>
      </div>
      ${test.description ? `<div class="test-description">${esc(test.description)}</div>` : ''}
      ${test.status !== 'draft' ? `
        <table class="variant-table">
          <thead><tr><th>Variante</th><th>Impressions</th><th>Conversions</th><th>Taux</th><th>Delta</th></tr></thead>
          <tbody>${variantRows}</tbody>
        </table>
        ${sigBox}
        <div class="chart-container">
          <div class="chart-title">Taux de conversion par jour — ${esc(metricLabels[test.primary_metric] || test.primary_metric)}</div>
          <canvas id="chart-${test.id}" height="200"></canvas>
        </div>
      ` : ''}
      <div class="test-actions">${actions}</div>
    </div>`;
  }

  // ============= Charts =============
  async function loadDailyData(testId, metric) {
    const [impressions, conversions] = await Promise.all([
      sbFetch('ab_impressions', `select=variant_id,created_at&test_id=eq.${testId}&order=created_at.asc`),
      sbFetch('ab_conversions', `select=variant_id,created_at&test_id=eq.${testId}&metric_name=eq.${metric}&order=created_at.asc`)
    ]);

    // Aggregate by day + variant
    const byDay = {};
    for (const imp of impressions) {
      const day = imp.created_at.slice(0, 10);
      const key = day + ':' + imp.variant_id;
      if (!byDay[key]) byDay[key] = { day, variant: imp.variant_id, impressions: 0, conversions: 0 };
      byDay[key].impressions++;
    }
    for (const conv of conversions) {
      const day = conv.created_at.slice(0, 10);
      const key = day + ':' + conv.variant_id;
      if (!byDay[key]) byDay[key] = { day, variant: conv.variant_id, impressions: 0, conversions: 0 };
      byDay[key].conversions++;
    }
    return Object.values(byDay);
  }

  const VARIANT_COLORS = ['#64748b', '#3b82f6', '#f59e0b', '#ef4444', '#8b5cf6', '#06b6d4'];

  function drawChart(canvasId, test) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const rect = canvas.parentElement.getBoundingClientRect();
    canvas.width = rect.width - 32;
    canvas.height = 200;
    const W = canvas.width, H = canvas.height;
    const pad = { top: 20, right: 20, bottom: 30, left: 50 };

    loadDailyData(test.id, test.primary_metric).then(data => {
      if (data.length === 0) {
        ctx.fillStyle = '#64748b';
        ctx.font = '13px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Pas encore de donnees', W / 2, H / 2);
        return;
      }

      const variants = test.variants.map(v => v.id);
      const days = [...new Set(data.map(d => d.day))].sort();

      // Compute daily rates per variant
      const ratesByVariant = {};
      for (const v of variants) {
        ratesByVariant[v] = days.map(day => {
          const entry = data.find(d => d.day === day && d.variant === v);
          if (!entry || entry.impressions === 0) return null;
          return entry.conversions / entry.impressions * 100;
        });
      }

      const allRates = Object.values(ratesByVariant).flat().filter(r => r !== null);
      const maxRate = allRates.length > 0 ? Math.max(...allRates) * 1.2 : 10;

      const plotW = W - pad.left - pad.right;
      const plotH = H - pad.top - pad.bottom;

      // Background
      ctx.fillStyle = '#0f1520';
      ctx.fillRect(0, 0, W, H);

      // Grid lines
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1;
      for (let i = 0; i <= 4; i++) {
        const y = pad.top + (plotH / 4) * i;
        ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(W - pad.right, y); ctx.stroke();
        ctx.fillStyle = '#475569';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'right';
        ctx.fillText((maxRate - (maxRate / 4) * i).toFixed(1) + '%', pad.left - 6, y + 3);
      }

      // X labels
      ctx.fillStyle = '#475569';
      ctx.font = '10px sans-serif';
      ctx.textAlign = 'center';
      const step = Math.max(1, Math.floor(days.length / 7));
      for (let i = 0; i < days.length; i += step) {
        const x = pad.left + (i / Math.max(days.length - 1, 1)) * plotW;
        ctx.fillText(days[i].slice(5), x, H - 8);
      }

      // Lines per variant
      variants.forEach((v, vi) => {
        const rates = ratesByVariant[v];
        const color = VARIANT_COLORS[vi % VARIANT_COLORS.length];
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.beginPath();
        let started = false;
        for (let i = 0; i < days.length; i++) {
          if (rates[i] === null) continue;
          const x = pad.left + (i / Math.max(days.length - 1, 1)) * plotW;
          const y = pad.top + plotH - (rates[i] / maxRate) * plotH;
          if (!started) { ctx.moveTo(x, y); started = true; } else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // Dots
        for (let i = 0; i < days.length; i++) {
          if (rates[i] === null) continue;
          const x = pad.left + (i / Math.max(days.length - 1, 1)) * plotW;
          const y = pad.top + plotH - (rates[i] / maxRate) * plotH;
          ctx.beginPath(); ctx.arc(x, y, 3, 0, Math.PI * 2); ctx.fillStyle = color; ctx.fill();
        }
      });

      // Legend
      let lx = pad.left;
      ctx.font = '11px sans-serif';
      variants.forEach((v, vi) => {
        const color = VARIANT_COLORS[vi % VARIANT_COLORS.length];
        ctx.fillStyle = color;
        ctx.fillRect(lx, 4, 12, 3);
        ctx.fillStyle = '#94a3b8';
        ctx.textAlign = 'left';
        const label = (test.variants[vi] || {}).label || v;
        ctx.fillText(label, lx + 16, 10);
        lx += ctx.measureText(label).width + 32;
      });
    });
  }

  // ============= Render & draw charts after DOM update =============
  function renderAndDrawCharts() {
    renderTests();
    // Small delay for DOM update, then draw charts
    requestAnimationFrame(() => {
      for (const test of allTests) {
        if (test.status === 'draft') continue;
        drawChart('chart-' + test.id, test);
      }
    });
  }

  // ============= Test actions =============
  window.setStatusFilter = function(f) {
    statusFilter = f;
    document.querySelectorAll('.pill').forEach(p => p.classList.toggle('active', p.dataset.filter === f));
    renderAndDrawCharts();
  };

  window.startTest = async function(id) {
    await sbRpc({ status: 'running', started_at: new Date().toISOString() }, 'ab_tests', 'PATCH', `id=eq.${id}`);
    loadAll().then(renderAndDrawCharts);
  };

  window.pauseTest = async function(id) {
    await sbRpc({ status: 'paused' }, 'ab_tests', 'PATCH', `id=eq.${id}`);
    loadAll().then(renderAndDrawCharts);
  };

  window.resumeTest = async function(id) {
    await sbRpc({ status: 'running' }, 'ab_tests', 'PATCH', `id=eq.${id}`);
    loadAll().then(renderAndDrawCharts);
  };

  window.stopTest = async function(id) {
    if (!confirm('Arreter ce test definitivement ?')) return;
    await sbRpc({ status: 'completed', ended_at: new Date().toISOString() }, 'ab_tests', 'PATCH', `id=eq.${id}`);
    loadAll().then(renderAndDrawCharts);
  };

  window.deleteTest = async function(id) {
    if (!confirm('Supprimer ce test et toutes ses donnees ?')) return;
    await fetch(`${SB_URL}/rest/v1/ab_tests?id=eq.${id}`, {
      method: 'DELETE',
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    loadAll().then(renderAndDrawCharts);
  };

  window.declareWinner = async function(id) {
    const test = allTests.find(t => t.id === id);
    if (!test) return;
    const variants = (test.variants || []).filter(v => v.id !== 'control');
    const options = variants.map(v => v.id + ' (' + v.label + ')').join(', ');
    const winner = prompt('Declarer le winner parmi: ' + options + '\n\nEntrez l\'ID de la variante gagnante:', variants.length > 0 ? variants[0].id : '');
    if (!winner) return;
    await sbRpc({ status: 'completed', winner_variant: winner, ended_at: new Date().toISOString() }, 'ab_tests', 'PATCH', `id=eq.${id}`);
    loadAll().then(renderAndDrawCharts);
  };

  // ============= Create/Edit Modal =============
  window.openCreateModal = function() {
    document.getElementById('editTestId').value = '';
    document.getElementById('modalTitle').textContent = 'Nouveau test A/B';
    document.getElementById('formName').value = '';
    document.getElementById('formDescription').value = '';
    document.getElementById('formPage').value = '/';
    document.getElementById('formSelector').value = '';
    document.getElementById('formMetric').value = 'coach_open';
    document.getElementById('formConfidence').value = '0.95';
    document.getElementById('formSample').value = '1000';
    document.getElementById('formSecondary').value = '';
    document.getElementById('variantBuilder').innerHTML = `
      <div class="variant-row">
        <input type="text" value="control" readonly style="opacity:0.6" class="vid">
        <input type="text" value="Original" placeholder="Label" class="vlabel">
        <input type="number" value="50" min="1" max="100" class="vweight">
        <span style="color:#64748b;font-size:0.72rem">%</span>
      </div>
      <div class="variant-row">
        <input type="text" value="B" placeholder="ID" class="vid">
        <input type="text" value="Variante B" placeholder="Label" class="vlabel">
        <input type="number" value="50" min="1" max="100" class="vweight">
        <button class="remove-variant" onclick="this.closest('.variant-row').remove()">x</button>
      </div>`;
    document.getElementById('createModal').classList.add('open');
  };

  window.openEditModal = function(id) {
    const test = allTests.find(t => t.id === id);
    if (!test) return;
    document.getElementById('editTestId').value = id;
    document.getElementById('modalTitle').textContent = 'Modifier le test';
    document.getElementById('formName').value = test.name;
    document.getElementById('formDescription').value = test.description || '';
    document.getElementById('formPage').value = test.page_target;
    document.getElementById('formSelector').value = test.element_selector || '';
    document.getElementById('formMetric').value = test.primary_metric;
    document.getElementById('formConfidence').value = String(test.confidence_target || 0.95);
    document.getElementById('formSample').value = test.min_sample_size || 1000;
    document.getElementById('formSecondary').value = (test.secondary_metrics || []).join(', ');

    const variants = test.variants || [];
    document.getElementById('variantBuilder').innerHTML = variants.map((v, i) => `
      <div class="variant-row">
        <input type="text" value="${esc(v.id)}" ${i === 0 ? 'readonly style="opacity:0.6"' : ''} class="vid">
        <input type="text" value="${esc(v.label)}" placeholder="Label" class="vlabel">
        <input type="number" value="${v.weight}" min="1" max="100" class="vweight">
        ${i === 0 ? '<span style="color:#64748b;font-size:0.72rem">%</span>' : '<button class="remove-variant" onclick="this.closest(\'.variant-row\').remove()">x</button>'}
      </div>`).join('');

    document.getElementById('createModal').classList.add('open');
  };

  window.closeCreateModal = function() {
    document.getElementById('createModal').classList.remove('open');
  };

  window.addVariantRow = function() {
    const builder = document.getElementById('variantBuilder');
    const count = builder.querySelectorAll('.variant-row').length;
    const letter = String.fromCharCode(65 + count); // B, C, D...
    const div = document.createElement('div');
    div.className = 'variant-row';
    div.innerHTML = `
      <input type="text" value="${letter}" placeholder="ID" class="vid">
      <input type="text" value="Variante ${letter}" placeholder="Label" class="vlabel">
      <input type="number" value="33" min="1" max="100" class="vweight">
      <button class="remove-variant" onclick="this.closest('.variant-row').remove()">x</button>`;
    builder.appendChild(div);
  };

  window.saveTest = async function() {
    const editId = document.getElementById('editTestId').value;
    const name = document.getElementById('formName').value.trim();
    if (!name) { alert('Nom requis'); return; }

    const rows = document.querySelectorAll('#variantBuilder .variant-row');
    const variants = [];
    rows.forEach(row => {
      const vid = row.querySelector('.vid').value.trim();
      const vlabel = row.querySelector('.vlabel').value.trim();
      const vweight = parseInt(row.querySelector('.vweight').value) || 50;
      if (vid) variants.push({ id: vid, label: vlabel || vid, weight: vweight });
    });

    const secondaryStr = document.getElementById('formSecondary').value;
    const secondary = secondaryStr ? secondaryStr.split(',').map(s => s.trim()).filter(Boolean) : [];

    const body = {
      name,
      description: document.getElementById('formDescription').value.trim() || null,
      page_target: document.getElementById('formPage').value.trim() || '/',
      element_selector: document.getElementById('formSelector').value.trim() || null,
      primary_metric: document.getElementById('formMetric').value,
      confidence_target: parseFloat(document.getElementById('formConfidence').value),
      min_sample_size: parseInt(document.getElementById('formSample').value) || 1000,
      secondary_metrics: secondary,
      variants
    };

    if (editId) {
      await sbRpc(body, 'ab_tests', 'PATCH', `id=eq.${editId}`);
    } else {
      await sbRpc(body, 'ab_tests', 'POST', '');
    }

    closeCreateModal();
    loadAll().then(renderAndDrawCharts);
  };

  // Close modal on overlay click
  document.getElementById('createModal').addEventListener('click', function(e) {
    if (e.target === this) closeCreateModal();
  });

  // ============= Init =============
  loadAll().then(renderAndDrawCharts);
  setInterval(function() { loadAll().then(renderAndDrawCharts); }, 30000);
</script>

</body>
</html>
