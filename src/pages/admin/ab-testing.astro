    document.getElementById('variantBuilder').innerHTML=(test.variants||[]).map(function(v,i){return '<div class="variant-row"><input type="text" value="'+esc(v.id)+'" '+(i===0?'readonly style="opacity:0.5"':'')+' class="vid"><input type="text" value="'+esc(v.label)+'" placeholder="Label" class="vlabel"><input type="number" value="'+v.weight+'" min="1" max="100" class="vweight">'+(i===0?'<span style="color:#475569;font-size:0.7rem">%</span>':'<button class="rm-v" onclick="this.closest(\'.variant-row\').remove()">&times;</button>')+'</div>';}).join('');
    document.getElementById('createModal').classList.add('open');
  };
  window.closeCreateModal = function() { document.getElementById('createModal').classList.remove('open'); };
  window.addVariantRow = function() {
    var b = document.getElementById('variantBuilder'), c = b.querySelectorAll('.variant-row').length, l = String.fromCharCode(65+c);
    var d = document.createElement('div'); d.className='variant-row';
    d.innerHTML='<input type="text" value="'+l+'" class="vid"><input type="text" value="Variante '+l+'" class="vlabel"><input type="number" value="33" min="1" max="100" class="vweight"><button class="rm-v" onclick="this.closest(\'.variant-row\').remove()">&times;</button>';
    b.appendChild(d);
  };
  window.saveTest = async function() {
    var editId = document.getElementById('editTestId').value;
    var name = document.getElementById('formName').value.trim(); if(!name){alert('Nom requis');return;}
    var variants = [];
    document.querySelectorAll('#variantBuilder .variant-row').forEach(function(row){
      var vid=row.querySelector('.vid').value.trim(), vl=row.querySelector('.vlabel').value.trim(), vw=parseInt(row.querySelector('.vweight').value)||50;
      if(vid) variants.push({id:vid,label:vl||vid,weight:vw});
    });
    var sec = document.getElementById('formSecondary').value;
    var body = { name:name, description:document.getElementById('formDescription').value.trim()||null, page_target:document.getElementById('formPage').value.trim()||'/', element_selector:document.getElementById('formSelector').value.trim()||null, primary_metric:document.getElementById('formMetric').value, confidence_target:parseFloat(document.getElementById('formConfidence').value), min_sample_size:parseInt(document.getElementById('formSample').value)||1000, secondary_metrics:sec?sec.split(',').map(function(s){return s.trim()}).filter(Boolean):[], variants:variants };
    if(editId) await sbRpc(body,'ab_tests','PATCH','id=eq.'+editId);
    else await sbRpc(body,'ab_tests','POST','');
    closeCreateModal(); loadAll();
  };
  document.getElementById('createModal').addEventListener('click',function(e){if(e.target===this) closeCreateModal()});

  loadAll();
  setInterval(loadAll, 30000);
</script>
</body>
</html>
