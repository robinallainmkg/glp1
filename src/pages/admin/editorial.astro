---
import AdminNav from '../../components/AdminNav.astro';
import { supabaseConfig } from '../../lib/supabase';
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editorial - GLP1 Admin</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f1f5f9;
      color: #1e293b;
    }
    .admin-layout { margin-left: 260px; min-height: 100vh; }
    .page-header {
      background: white;
      border-bottom: 1px solid #e2e8f0;
      padding: 1.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .page-header-left h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; }
    .page-header-left p { font-size: 0.88rem; color: #64748b; margin-top: 0.25rem; }
    .header-actions { display: flex; gap: 0.75rem; align-items: center; }
    .refresh-btn {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
      background: white;
      color: #475569;
      font-size: 0.82rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .refresh-btn:hover { background: #f8fafc; border-color: #cbd5e1; }
    .last-update { font-size: 0.72rem; color: #94a3b8; }

    .main { padding: 2rem; }

    /* Stats cards */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: white;
      border-radius: 12px;
      padding: 1.25rem;
      border: 1px solid #e2e8f0;
    }
    .stat-card .label {
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #64748b;
      margin-bottom: 0.5rem;
    }
    .stat-card .value {
      font-size: 2rem;
      font-weight: 800;
      line-height: 1;
    }
    .stat-card .sub {
      font-size: 0.75rem;
      color: #94a3b8;
      margin-top: 0.35rem;
    }

    /* Command box */
    .cmd-box {
      background: #1e293b;
      border-radius: 10px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .cmd-box code {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.82rem;
      color: #a5f3fc;
    }
    .cmd-box .copy-btn {
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      border: 1px solid #475569;
      background: transparent;
      color: #94a3b8;
      font-size: 0.72rem;
      cursor: pointer;
    }
    .cmd-box .copy-btn:hover { background: #334155; color: white; }

    /* Filters */
    .filters {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      align-items: center;
    }
    .filter-btn {
      padding: 0.4rem 0.85rem;
      border-radius: 20px;
      border: 1px solid #e2e8f0;
      background: white;
      color: #64748b;
      font-size: 0.78rem;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.15s;
    }
    .filter-btn:hover { border-color: #cbd5e1; color: #334155; }
    .filter-btn.active { background: #1e293b; color: white; border-color: #1e293b; }
    .filter-count {
      font-size: 0.68rem;
      background: rgba(0,0,0,0.08);
      padding: 1px 6px;
      border-radius: 10px;
      margin-left: 4px;
    }
    .filter-btn.active .filter-count { background: rgba(255,255,255,0.2); }
    .search-input {
      padding: 0.4rem 0.85rem;
      border-radius: 20px;
      border: 1px solid #e2e8f0;
      font-size: 0.78rem;
      color: #334155;
      width: 200px;
      margin-left: auto;
    }
    .search-input:focus { outline: none; border-color: #7c3aed; }

    /* Sections */
    .section-title {
      font-size: 0.92rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Ticket table */
    .ticket-table {
      width: 100%;
      background: white;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }
    .ticket-table table { width: 100%; border-collapse: collapse; }
    .ticket-table th {
      text-align: left;
      padding: 0.75rem 1rem;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #64748b;
      border-bottom: 1px solid #e2e8f0;
      background: #f8fafc;
    }
    .ticket-table td {
      padding: 0.75rem 1rem;
      font-size: 0.82rem;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: top;
    }
    .ticket-table tr:last-child td { border-bottom: none; }
    .ticket-table tr:hover td { background: #f8fafc; }

    /* Badges */
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.68rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .badge-approved { background: #fef3c7; color: #92400e; }
    .badge-in_progress { background: #dbeafe; color: #1e40af; }
    .badge-ready { background: #e0e7ff; color: #3730a3; }
    .badge-deployed { background: #d1fae5; color: #065f46; }
    .badge-rejected { background: #fee2e2; color: #991b1b; }

    .badge-urgent { background: #fee2e2; color: #991b1b; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-ok { background: #d1fae5; color: #065f46; }

    .badge-price { background: #fce7f3; color: #9d174d; }
    .badge-info { background: #e0e7ff; color: #3730a3; }
    .badge-claim { background: #fee2e2; color: #991b1b; }
    .badge-missing { background: #f3e8ff; color: #6b21a8; }

    /* Diff preview */
    .diff-toggle {
      color: #7c3aed;
      font-size: 0.75rem;
      cursor: pointer;
      text-decoration: underline;
      background: none;
      border: none;
      font-family: inherit;
    }
    .diff-toggle:hover { color: #5b21b6; }
    .diff-panel {
      display: none;
      margin-top: 0.5rem;
      padding: 0.75rem;
      background: #f8fafc;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
    }
    .diff-panel.open { display: block; }
    .diff-before {
      background: #fef2f2;
      border-left: 3px solid #ef4444;
      padding: 0.5rem 0.75rem;
      border-radius: 4px;
      margin-bottom: 0.5rem;
      font-size: 0.78rem;
      color: #991b1b;
      text-decoration: line-through;
      line-height: 1.5;
    }
    .diff-after {
      background: #f0fdf4;
      border-left: 3px solid #22c55e;
      padding: 0.5rem 0.75rem;
      border-radius: 4px;
      font-size: 0.78rem;
      color: #166534;
      line-height: 1.5;
    }
    .diff-label {
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
      opacity: 0.7;
    }

    /* Slug cell */
    .slug-cell {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.75rem;
      color: #7c3aed;
      max-width: 200px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Empty/loading */
    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #94a3b8;
    }
    .loading { text-align: center; padding: 3rem; color: #94a3b8; }

    /* Opportunities section */
    .opp-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .opp-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.25rem;
    }
    .opp-card .opp-topic { font-weight: 700; font-size: 0.88rem; margin-bottom: 0.35rem; }
    .opp-card .opp-keyword {
      font-family: 'SF Mono', 'Fira Code', monospace;
      font-size: 0.72rem;
      color: #7c3aed;
      margin-bottom: 0.5rem;
    }
    .opp-card .opp-meta {
      font-size: 0.72rem;
      color: #94a3b8;
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    @media (max-width: 1100px) {
      .stats-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) {
      .admin-layout { margin-left: 0; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .main { padding: 1rem; }
    }
  </style>
</head>
<body>

<AdminNav />

<div class="admin-layout">
  <div class="page-header">
    <div class="page-header-left">
      <h1>Editorial</h1>
      <p>Corrections et redaction — Agent Editorial</p>
    </div>
    <div class="header-actions">
      <span class="last-update" id="lastUpdate">-</span>
      <button class="refresh-btn" onclick="loadAll()">&#x27F3; Rafraichir</button>
    </div>
  </div>

  <div class="main">
    <!-- Command -->
    <div class="cmd-box">
      <code>claude -p "Traite les corrections" --agent editorial</code>
      <button class="copy-btn" onclick="navigator.clipboard.writeText('claude -p \"Traite les corrections\" --agent editorial');this.textContent='Copie !'">Copier</button>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">Total tickets</div>
        <div class="value" id="statTotal" style="color:#1e293b">-</div>
        <div class="sub">Tous statuts confondus</div>
      </div>
      <div class="stat-card">
        <div class="label">En attente</div>
        <div class="value" id="statApproved" style="color:#d97706">-</div>
        <div class="sub">Approuves, a traiter</div>
      </div>
      <div class="stat-card">
        <div class="label">En cours</div>
        <div class="value" id="statProgress" style="color:#2563eb">-</div>
        <div class="sub">Agent en train de corriger</div>
      </div>
      <div class="stat-card">
        <div class="label">Prets</div>
        <div class="value" id="statReady" style="color:#7c3aed">-</div>
        <div class="sub">Corriges, prets a deployer</div>
      </div>
      <div class="stat-card">
        <div class="label">Deployes</div>
        <div class="value" id="statDeployed" style="color:#059669">-</div>
        <div class="sub">En production</div>
      </div>
    </div>

    <!-- Opportunities in progress -->
    <div id="oppSection" style="display:none">
      <div class="section-title">&#x1F4DD; Articles en cours de redaction (opportunites)</div>
      <div class="opp-cards" id="oppCards"></div>
    </div>

    <!-- Filters -->
    <div class="filters">
      <button class="filter-btn active" data-filter="all" onclick="setFilter('all')">Tous</button>
      <button class="filter-btn" data-filter="approved" onclick="setFilter('approved')">En attente</button>
      <button class="filter-btn" data-filter="in_progress" onclick="setFilter('in_progress')">En cours</button>
      <button class="filter-btn" data-filter="ready_to_deploy" onclick="setFilter('ready_to_deploy')">Prets</button>
      <button class="filter-btn" data-filter="deployed" onclick="setFilter('deployed')">Deployes</button>
      <button class="filter-btn" data-filter="rejected" onclick="setFilter('rejected')">Rejetes</button>
      <input type="text" class="search-input" placeholder="Rechercher un article..." oninput="setSearch(this.value)" />
    </div>

    <!-- Tickets table -->
    <div id="ticketsContainer">
      <div class="loading">Chargement...</div>
    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl: supabaseConfig.url, supabaseAnonKey: supabaseConfig.anonKey }}>
  const SB_URL = supabaseUrl;
  const SB_KEY = supabaseAnonKey;
  let allTickets = [];
  let currentFilter = 'all';
  let currentSearch = '';

  function esc(str) {
    if (!str) return '';
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  function timeAgo(dateStr) {
    if (!dateStr) return '-';
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'a l\'instant';
    if (mins < 60) return mins + ' min';
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h';
    const days = Math.floor(hrs / 24);
    return days + 'j';
  }

  function formatDate(dateStr) {
    if (!dateStr) return '-';
    return new Date(dateStr).toLocaleDateString('fr-FR', {
      day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
    });
  }

  async function sbFetch(table, query) {
    const r = await fetch(`${SB_URL}/rest/v1/${table}?${query}`, {
      headers: { 'apikey': SB_KEY, 'Authorization': `Bearer ${SB_KEY}` }
    });
    if (!r.ok) throw new Error(await r.text());
    return r.json();
  }

  function statusBadge(statut) {
    const map = {
      approved: ['En attente', 'badge-approved'],
      in_progress: ['En cours', 'badge-in_progress'],
      ready_to_deploy: ['Pret', 'badge-ready'],
      deployed: ['Deploye', 'badge-deployed'],
      rejected: ['Rejete', 'badge-rejected'],
    };
    const [label, cls] = map[statut] || [statut, ''];
    return `<span class="badge ${cls}">${esc(label)}</span>`;
  }

  function urgBadge(urgence) {
    const map = { urgent: 'badge-urgent', warning: 'badge-warning', ok: 'badge-ok' };
    return `<span class="badge ${map[urgence] || ''}">${esc(urgence || '-')}</span>`;
  }

  function typeBadge(type) {
    const labels = {
      price_update: 'Prix',
      info_outdated: 'Obsolete',
      false_claim: 'Faux',
      missing_info: 'Manquant',
      context_fr: 'Contexte FR',
    };
    const classes = {
      price_update: 'badge-price',
      info_outdated: 'badge-info',
      false_claim: 'badge-claim',
      missing_info: 'badge-missing',
    };
    return `<span class="badge ${classes[type] || 'badge-info'}">${esc(labels[type] || type || '-')}</span>`;
  }

  function toggleDiff(id) {
    const el = document.getElementById('diff-' + id);
    if (el) el.classList.toggle('open');
  }

  function renderTickets(tickets) {
    const container = document.getElementById('ticketsContainer');
    if (tickets.length === 0) {
      container.innerHTML = `<div class="empty-state">Aucun ticket pour ce filtre</div>`;
      return;
    }

    let html = `<div class="ticket-table"><table>
      <thead><tr>
        <th>Urgence</th>
        <th>Type</th>
        <th>Article</th>
        <th>Titre</th>
        <th>Statut</th>
        <th>Date</th>
        <th>Diff</th>
      </tr></thead><tbody>`;

    for (const t of tickets) {
      const shortId = t.id.substring(0, 8);
      const afterText = t.after_final || t.after_suggested || '';
      html += `<tr>
        <td>${urgBadge(t.urgence)}</td>
        <td>${typeBadge(t.ticket_type)}</td>
        <td class="slug-cell" title="${esc(t.slug)}">${esc(t.slug)}</td>
        <td>${esc(t.title || t.claim_original || '-')}</td>
        <td>${statusBadge(t.statut)}</td>
        <td style="white-space:nowrap;font-size:0.75rem;color:#64748b" title="${formatDate(t.updated_at)}">${timeAgo(t.updated_at)}</td>
        <td>
          <button class="diff-toggle" onclick="toggleDiff('${shortId}')">Voir</button>
          <div class="diff-panel" id="diff-${shortId}">
            <div class="diff-before">
              <div class="diff-label">Avant</div>
              ${esc(t.before_exact)}
            </div>
            <div class="diff-after">
              <div class="diff-label">${t.after_final ? 'Apres (editorial)' : 'Apres (suggestion)'}</div>
              ${esc(afterText)}
            </div>
            ${t.realite_actuelle ? `<div style="margin-top:0.5rem;font-size:0.75rem;color:#64748b;line-height:1.4"><strong>Contexte:</strong> ${esc(t.realite_actuelle)}</div>` : ''}
            ${t.source_reference ? `<div style="margin-top:0.35rem;font-size:0.72rem"><a href="${esc(t.source_reference)}" target="_blank" rel="noopener" style="color:#7c3aed">${esc(t.source_reference)}</a></div>` : ''}
          </div>
        </td>
      </tr>`;
    }

    html += '</tbody></table></div>';
    container.innerHTML = html;
  }

  function applyFilters() {
    let filtered = allTickets;
    if (currentFilter !== 'all') {
      filtered = filtered.filter(t => t.statut === currentFilter);
    }
    if (currentSearch) {
      const q = currentSearch.toLowerCase();
      filtered = filtered.filter(t =>
        (t.slug || '').toLowerCase().includes(q) ||
        (t.title || '').toLowerCase().includes(q) ||
        (t.claim_original || '').toLowerCase().includes(q)
      );
    }
    renderTickets(filtered);
  }

  window.setFilter = function(f) {
    currentFilter = f;
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.filter === f);
    });
    applyFilters();
  };

  window.setSearch = function(q) {
    currentSearch = q;
    applyFilters();
  };

  function updateFilterCounts() {
    const counts = { all: allTickets.length };
    for (const t of allTickets) {
      counts[t.statut] = (counts[t.statut] || 0) + 1;
    }
    document.querySelectorAll('.filter-btn').forEach(btn => {
      const f = btn.dataset.filter;
      const count = counts[f] || 0;
      const existing = btn.querySelector('.filter-count');
      if (existing) existing.remove();
      if (count > 0 || f === 'all') {
        btn.insertAdjacentHTML('beforeend', `<span class="filter-count">${count}</span>`);
      }
    });
  }

  async function loadAll() {
    try {
      // Load tickets
      const tickets = await sbFetch(
        'correction_tickets',
        'select=*&order=updated_at.desc&limit=200'
      );
      allTickets = tickets;

      // Stats
      const approved = tickets.filter(t => t.statut === 'approved').length;
      const inProgress = tickets.filter(t => t.statut === 'in_progress').length;
      const ready = tickets.filter(t => t.statut === 'ready_to_deploy').length;
      const deployed = tickets.filter(t => t.statut === 'deployed').length;

      document.getElementById('statTotal').textContent = tickets.length;
      document.getElementById('statApproved').textContent = approved;
      document.getElementById('statProgress').textContent = inProgress;
      document.getElementById('statReady').textContent = ready;
      document.getElementById('statDeployed').textContent = deployed;

      updateFilterCounts();
      applyFilters();

      // Load opportunities in_progress or published
      try {
        const opps = await sbFetch(
          'content_opportunities',
          'select=*&status=in.(in_progress,published)&order=priority.asc&limit=20'
        );
        const oppSection = document.getElementById('oppSection');
        const oppCards = document.getElementById('oppCards');
        if (opps.length > 0) {
          oppSection.style.display = 'block';
          oppCards.innerHTML = opps.map(o => `
            <div class="opp-card">
              <div class="opp-topic">${esc(o.topic)}</div>
              <div class="opp-keyword">${esc(o.target_keyword)}</div>
              <div class="opp-meta">
                <span>${statusBadge(o.status)}</span>
                <span>Priorite: ${o.priority}</span>
                <span>Collection: ${esc(o.suggested_collection)}</span>
                ${o.suggested_slug ? `<span>Slug: ${esc(o.suggested_slug)}</span>` : ''}
              </div>
            </div>
          `).join('');
        } else {
          oppSection.style.display = 'none';
        }
      } catch (e) { /* ignore if no opps */ }

      document.getElementById('lastUpdate').textContent = 'Mis a jour: ' + new Date().toLocaleTimeString('fr-FR');

    } catch (err) {
      document.getElementById('ticketsContainer').innerHTML = `
        <div style="background:#fef2f2;border:1px solid #fecaca;padding:1rem;border-radius:10px;color:#991b1b;font-size:0.85rem">
          <strong>Erreur Supabase:</strong> ${esc(err.message)}
        </div>
      `;
    }
  }

  // Initial load + auto-refresh 30s
  loadAll();
  setInterval(loadAll, 30000);
</script>

</body>
</html>
