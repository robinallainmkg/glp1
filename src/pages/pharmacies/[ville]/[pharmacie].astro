---
import StaticLayout from '../../../layouts/StaticLayout.astro';
import { computePharmacyPrices, slugifyName } from '../../../lib/pharmacyPricing';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dataPath = path.resolve(process.cwd(), 'public/data/pharmacies.json');
  let pharmacies = { schema: [], rows: [] };
  try { pharmacies = JSON.parse(fs.readFileSync(dataPath, 'utf-8')); } catch {}

  const iId = pharmacies.schema.indexOf('id');
  const iFin = pharmacies.schema.indexOf('finess');
  const iName = pharmacies.schema.indexOf('name');
  const iCity = pharmacies.schema.indexOf('city');
  const iSlug = pharmacies.schema.indexOf('city_slug');
  const iCP = pharmacies.schema.indexOf('postal_code');
  const iDept = pharmacies.schema.indexOf('department');
  const iLat = pharmacies.schema.indexOf('lat');
  const iLng = pharmacies.schema.indexOf('lng');

  // Calcule quelles villes ont une page /pharmacies/[ville]/ (top 100)
  // et quels CP ont une page /pharmacies/cp/[zip]/ (≥3 pharmacies)
  const cityCounts = new Map<string, number>();
  const zipCounts = new Map<string, number>();
  for (const row of pharmacies.rows) {
    const slug = row[iSlug];
    const zip = row[iCP];
    if (slug) cityCounts.set(slug, (cityCounts.get(slug) || 0) + 1);
    if (zip) zipCounts.set(zip, (zipCounts.get(zip) || 0) + 1);
  }
  const validCitySlugs = new Set(
    [...cityCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 100).map(([s]) => s)
  );
  const validZipCodes = new Set(
    [...zipCounts.entries()].filter(([, c]) => c >= 3).map(([z]) => z)
  );

  // Pré-calcule pour chaque pharmacie ses voisines (même ville) — pour enrichir le contenu unique.
  // On indexe d'abord toutes les pharmacies par citySlug puis par postal_code.
  const byCity = new Map<string, any[]>();
  const byZip = new Map<string, any[]>();
  for (const row of pharmacies.rows) {
    const citySlug = row[iSlug];
    const zip = row[iCP];
    if (citySlug) {
      if (!byCity.has(citySlug)) byCity.set(citySlug, []);
      byCity.get(citySlug)!.push(row);
    }
    if (zip) {
      if (!byZip.has(zip)) byZip.set(zip, []);
      byZip.get(zip)!.push(row);
    }
  }

  // Génère une page par pharmacie. Pour éviter des collisions de slug dans la même ville,
  // on suffixe le slug avec les 4 derniers chars du FINESS si plusieurs pharmacies ont le même nom.
  // On pré-calcule aussi les slugs de pharmacie pour pouvoir les croiser entre voisines.
  const allPharmaSlugs = new Map<string, string>(); // finess -> pharmaSlug (final, déduplé)
  const slugSeen = new Map<string, number>();
  for (const row of pharmacies.rows) {
    const citySlug = row[iSlug];
    const finess = row[iFin];
    const name = row[iName];
    if (!citySlug || !finess || !name) continue;
    let pharmaSlug = slugifyName(name);
    if (!pharmaSlug) continue;
    const key = citySlug + '|' + pharmaSlug;
    const seenCount = slugSeen.get(key) || 0;
    slugSeen.set(key, seenCount + 1);
    if (seenCount > 0) pharmaSlug = pharmaSlug + '-' + String(finess).slice(-4);
    allPharmaSlugs.set(String(finess), pharmaSlug);
  }

  const paths = [];
  for (const row of pharmacies.rows) {
    const citySlug = row[iSlug];
    const finess = row[iFin];
    const name = row[iName];
    if (!citySlug || !finess || !name) continue;
    const pharmaSlug = allPharmaSlugs.get(String(finess));
    if (!pharmaSlug) continue;
    const postalCode = row[iCP];

    // Sélectionne jusqu'à 5 pharmacies voisines dans la même ville (différentes de celle-ci),
    // priorisées par proximité postale (même CP en premier).
    const cityPharmas = byCity.get(citySlug) || [];
    const neighbours = cityPharmas
      .filter((r) => r[iFin] !== finess)
      .sort((a, b) => {
        const aSame = a[iCP] === postalCode ? 0 : 1;
        const bSame = b[iCP] === postalCode ? 0 : 1;
        return aSame - bSame;
      })
      .slice(0, 5)
      .map((r) => ({
        name: r[iName],
        finess: String(r[iFin]),
        slug: allPharmaSlugs.get(String(r[iFin])),
        postal: r[iCP],
      }))
      .filter((n) => n.slug);

    paths.push({
      params: { ville: citySlug, pharmacie: pharmaSlug },
      props: {
        pharmacy: {
          id: row[iId],
          finess,
          name,
          city: row[iCity],
          city_slug: citySlug,
          postal: postalCode,
          department: row[iDept],
          lat: row[iLat],
          lng: row[iLng],
        },
        hasCityPage: validCitySlugs.has(citySlug),
        hasZipPage: validZipCodes.has(postalCode),
        neighbours,
        cityCount: cityPharmas.length,
        zipCount: (byZip.get(postalCode) || []).length,
      },
    });
  }
  return paths;
}

const { pharmacy, hasCityPage, hasZipPage, neighbours = [], cityCount = 0, zipCount = 0 } = Astro.props;

function titleCase(s: string) {
  return (s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}
const nameCap = titleCase(pharmacy.name);
const cityCap = titleCase(pharmacy.city);
const prices = computePharmacyPrices(pharmacy.finess, pharmacy.department);

// Date de mise à jour pour signal E-E-A-T (mensuelle, alignée sur la sync prix CEPS)
const updateDate = new Date();
const updateMonth = updateDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });

// Contexte département : libellé humain (selon code INSEE)
const DEPT_LABELS: Record<string, string> = {
  '01': 'Ain', '02': 'Aisne', '03': 'Allier', '04': 'Alpes-de-Haute-Provence', '05': 'Hautes-Alpes',
  '06': 'Alpes-Maritimes', '07': 'Ardèche', '08': 'Ardennes', '09': 'Ariège', '10': 'Aube',
  '11': 'Aude', '12': 'Aveyron', '13': 'Bouches-du-Rhône', '14': 'Calvados', '15': 'Cantal',
  '16': 'Charente', '17': 'Charente-Maritime', '18': 'Cher', '19': 'Corrèze', '21': 'Côte-d\'Or',
  '22': 'Côtes-d\'Armor', '23': 'Creuse', '24': 'Dordogne', '25': 'Doubs', '26': 'Drôme',
  '27': 'Eure', '28': 'Eure-et-Loir', '29': 'Finistère', '30': 'Gard', '31': 'Haute-Garonne',
  '32': 'Gers', '33': 'Gironde', '34': 'Hérault', '35': 'Ille-et-Vilaine', '36': 'Indre',
  '37': 'Indre-et-Loire', '38': 'Isère', '39': 'Jura', '40': 'Landes', '41': 'Loir-et-Cher',
  '42': 'Loire', '43': 'Haute-Loire', '44': 'Loire-Atlantique', '45': 'Loiret', '46': 'Lot',
  '47': 'Lot-et-Garonne', '48': 'Lozère', '49': 'Maine-et-Loire', '50': 'Manche', '51': 'Marne',
  '52': 'Haute-Marne', '53': 'Mayenne', '54': 'Meurthe-et-Moselle', '55': 'Meuse', '56': 'Morbihan',
  '57': 'Moselle', '58': 'Nièvre', '59': 'Nord', '60': 'Oise', '61': 'Orne', '62': 'Pas-de-Calais',
  '63': 'Puy-de-Dôme', '64': 'Pyrénées-Atlantiques', '65': 'Hautes-Pyrénées', '66': 'Pyrénées-Orientales',
  '67': 'Bas-Rhin', '68': 'Haut-Rhin', '69': 'Rhône', '70': 'Haute-Saône', '71': 'Saône-et-Loire',
  '72': 'Sarthe', '73': 'Savoie', '74': 'Haute-Savoie', '75': 'Paris', '76': 'Seine-Maritime',
  '77': 'Seine-et-Marne', '78': 'Yvelines', '79': 'Deux-Sèvres', '80': 'Somme', '81': 'Tarn',
  '82': 'Tarn-et-Garonne', '83': 'Var', '84': 'Vaucluse', '85': 'Vendée', '86': 'Vienne',
  '87': 'Haute-Vienne', '88': 'Vosges', '89': 'Yonne', '90': 'Territoire de Belfort', '91': 'Essonne',
  '92': 'Hauts-de-Seine', '93': 'Seine-Saint-Denis', '94': 'Val-de-Marne', '95': 'Val-d\'Oise',
};
const deptLabel = DEPT_LABELS[String(pharmacy.department)] || pharmacy.department;
const PREMIUM_DEPTS = new Set(['75','92','78','06','69','13','74','77','93','94','91','95']);
const RURAL_DEPTS = new Set(['23','15','48','19','46','55','39','52','58','43','04']);
const isPremiumDept = PREMIUM_DEPTS.has(String(pharmacy.department));
const isRuralDept = RURAL_DEPTS.has(String(pharmacy.department));
const deptZone = isPremiumDept ? 'urbaine premium' : isRuralDept ? 'rurale' : 'standard';

const title = `${nameCap} ${cityCap} — Prix Ozempic, Wegovy, Mounjaro`;
const description = `Prix GLP-1 à ${nameCap} (${pharmacy.postal} ${cityCap}). Ozempic 80,18 € CEPS officiel (remboursé 65% DT2 bithérapie), estimations Wegovy/Mounjaro/Saxenda par dosage. Mis à jour ${updateMonth}.`;

// Position pour la map — bbox étroit autour de la pharmacie
const bbox = [
  Number(pharmacy.lng) - 0.01, Number(pharmacy.lat) - 0.006,
  Number(pharmacy.lng) + 0.01, Number(pharmacy.lat) + 0.006,
];

// FAQ — enrichie avec questions spécifiques à la ville et au département
const faq = [
  {
    q: `Quels traitements GLP-1 sont disponibles à ${nameCap} ?`,
    a: `Comme toutes les pharmacies d'officine françaises, ${nameCap} peut délivrer Ozempic, Wegovy, Mounjaro, Trulicity, Victoza et Saxenda sur présentation d'une ordonnance médicale en cours de validité. Les stocks dépendent des approvisionnements Novo Nordisk / Eli Lilly et peuvent varier — contactez directement la pharmacie pour confirmer la disponibilité avant de vous déplacer.`,
  },
  {
    q: `Quel est le prix d'Ozempic à ${nameCap} ?`,
    a: `Ozempic est commercialisé au prix CEPS officiel de **80,18 €** par stylo en France entière, identique dans toutes les pharmacies (le CEPS — Comité Économique des Produits de Santé — fixe le prix public). En 2026, Ozempic est remboursé à **65 %** par la Sécurité sociale en bithérapie avec metformine pour le diabète de type 2 (30 % en trithérapie avec insuline). Le reste à charge dépend de votre mutuelle.`,
  },
  {
    q: `Pourquoi les prix Wegovy et Mounjaro varient-ils d'une pharmacie à l'autre ?`,
    a: `Wegovy, Mounjaro et Saxenda sont commercialisés en "prix libéré" : chaque pharmacie fixe librement son tarif (contrairement à Ozempic dont le prix est encadré par le CEPS). Les prix affichés sur cette page sont des estimations calculées à partir de la moyenne marché française + variance liée à la zone (${deptZone}). Pour le prix exact, demandez un devis à la pharmacie.`,
  },
  {
    q: `Combien y a-t-il de pharmacies dispensant les GLP-1 à ${cityCap} ?`,
    a: `Notre référentiel recense **${cityCount.toLocaleString('fr-FR')} pharmacie${cityCount > 1 ? 's' : ''}** à ${cityCap} (${pharmacy.postal}, département ${deptLabel}). Toutes peuvent en théorie délivrer les traitements GLP-1 sur ordonnance — les stocks réels varient selon les pharmacies. Notre liste est issue du référentiel FINESS officiel (data.gouv.fr).`,
  },
  {
    q: `Faut-il une ordonnance pour obtenir un GLP-1 ?`,
    a: `Oui, tous les traitements GLP-1 (Ozempic, Wegovy, Mounjaro, Trulicity, Victoza, Saxenda) sont sur **ordonnance médicale obligatoire** — tentative d'achat sans ordonnance = délit. Depuis juin 2025, la restriction aux endocrinologues a été levée : tout médecin (généraliste, diabétologue, etc.) peut désormais prescrire les agonistes GLP-1. Si vous n'avez pas encore de prescription, la téléconsultation est une voie rapide (consultation en 24h, ordonnance numérique transmise à la pharmacie de votre choix).`,
  },
  {
    q: `Quelles alternatives si ${nameCap} est en rupture de stock ?`,
    a: `${zipCount > 1 ? `Le code postal ${pharmacy.postal} compte ${zipCount} pharmacies ; commencez par celles-ci. ` : ''}Vous pouvez aussi appeler les pharmacies voisines de ${cityCap} (liste plus bas), demander à votre médecin un médicament équivalent (par exemple Trulicity à la place d'Ozempic, même classe thérapeutique des agonistes GLP-1, remboursé 65 % bithérapie metformine), ou consulter notre [carte interactive des prix GLP-1 en pharmacie](/outils/carte-prix-pharmacies/) pour identifier les pharmacies les plus proches qui ont déclaré du stock.`,
  },
  {
    q: `Quel est le coût final d'un traitement GLP-1 si j'ai une mutuelle ?`,
    a: `Pour Ozempic / Trulicity / Victoza (DT2, remboursés Sécu 65 %), votre reste à charge avant mutuelle est ~28 € sur Ozempic 0,5 mg. Une mutuelle "responsable" couvre généralement les 35 % restants. Pour Wegovy, Mounjaro et Saxenda (non remboursés Sécu), certaines mutuelles haut-de-gamme (à partir de ~80 €/mois) prennent en charge 50 à 100 €/mois — vérifiez votre contrat. Détails complets : [Wegovy remboursement mutuelle](/collections/glp1-cout/wegovy-remboursement-mutuelle/) et [Remboursement GLP-1 2026](/collections/glp1-cout/remboursement-glp1-2026/).`,
  },
];
---

<StaticLayout title={title} description={description} keywords={`${nameCap}, pharmacie ${pharmacy.postal}, prix Ozempic ${cityCap}, prix Mounjaro ${pharmacy.postal}`}>
  <!-- Schema.org : Pharmacy + Breadcrumb + FAQ -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Pharmacy",
        "@id": `https://glp1-france.fr/pharmacies/${pharmacy.city_slug}/${Astro.params.pharmacie}/#pharmacy`,
        "name": nameCap,
        "address": {
          "@type": "PostalAddress",
          "postalCode": pharmacy.postal,
          "addressLocality": cityCap,
          "addressCountry": "FR",
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": pharmacy.lat,
          "longitude": pharmacy.lng,
        },
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://glp1-france.fr/" },
          { "@type": "ListItem", "position": 2, "name": "Pharmacies", "item": "https://glp1-france.fr/pharmacies/" },
          hasCityPage ? { "@type": "ListItem", "position": 3, "name": cityCap, "item": `https://glp1-france.fr/pharmacies/${pharmacy.city_slug}/` } : { "@type": "ListItem", "position": 3, "name": cityCap },
          { "@type": "ListItem", "position": 4, "name": nameCap },
        ],
      },
      {
        "@type": "FAQPage",
        "mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
      },
    ],
  })} />

  <div class="pharma-page">
    <section class="pharma-hero">
      <div class="pharma-hero-inner">
        <nav class="breadcrumb">
          <a href="/">Accueil</a> <span>›</span>
          <a href="/pharmacies/">Pharmacies</a> <span>›</span>
          {hasCityPage ? <a href={`/pharmacies/${pharmacy.city_slug}/`}>{cityCap}</a> : <span>{cityCap}</span>} <span>›</span>
          <strong>{nameCap}</strong>
        </nav>
        <h1>{nameCap}</h1>
        <p class="pharma-addr">{pharmacy.postal} {cityCap} · Département {pharmacy.department}</p>
        <div class="pharma-ctas">
          {hasZipPage && <a href={`/pharmacies/cp/${pharmacy.postal}/`} class="btn-secondary">Autres pharmacies {pharmacy.postal}</a>}
          <a href="/outils/carte-prix-pharmacies/" class="btn-primary">Voir sur la carte →</a>
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(nameCap + ' ' + pharmacy.postal + ' ' + cityCap)}`} target="_blank" rel="noopener" class="btn-ghost">Google Maps ↗</a>
        </div>
      </div>
    </section>

    <section class="pharma-map-section">
      <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
      <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
      <div id="pharma-map"></div>
      <script is:inline define:vars={{ lat: pharmacy.lat, lng: pharmacy.lng, name: nameCap, bbox }}>
        (function () {
          if (typeof maplibregl === 'undefined') return;
          const map = new maplibregl.Map({
            container: 'pharma-map',
            style: {
              version: 8,
              sources: { tiles: { type: 'raster', tiles: ['https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png'], tileSize: 256, attribution: '© OSM · CARTO' } },
              layers: [{ id: 'bg', type: 'raster', source: 'tiles' }],
            },
            bounds: [[bbox[0], bbox[1]], [bbox[2], bbox[3]]],
            fitBoundsOptions: { padding: 40, maxZoom: 16 },
          });
          map.addControl(new maplibregl.NavigationControl(), 'top-right');
          const ready = new Promise((resolve) => {
            let done = false;
            const go = () => { if (done) return; done = true; resolve(); };
            map.on('styledata', () => { if (map.isStyleLoaded()) go(); });
            map.on('load', go);
            setTimeout(go, 6000);
          });
          ready.then(() => {
            new maplibregl.Marker({ color: '#16a34a' })
              .setLngLat([Number(lng), Number(lat)])
              .setPopup(new maplibregl.Popup().setHTML('<strong>' + name + '</strong>'))
              .addTo(map);
          });
        })();
      </script>
    </section>

    <!-- Contexte ville/département : contenu unique pour signal SEO local + E-E-A-T -->
    <section class="pharma-context">
      <div class="pharma-section-inner">
        <h2>Contexte local : GLP-1 à {cityCap} ({deptLabel})</h2>
        <div class="context-grid">
          <div class="context-card">
            <div class="context-num">{cityCount.toLocaleString('fr-FR')}</div>
            <div class="context-label">pharmacie{cityCount > 1 ? 's' : ''} recensée{cityCount > 1 ? 's' : ''} à {cityCap}</div>
          </div>
          <div class="context-card">
            <div class="context-num">{zipCount.toLocaleString('fr-FR')}</div>
            <div class="context-label">au code postal {pharmacy.postal}</div>
          </div>
          <div class="context-card">
            <div class="context-num">{deptLabel}</div>
            <div class="context-label">département {pharmacy.department} · zone {deptZone}</div>
          </div>
        </div>
        <p class="context-text">
          {nameCap} est implantée à <strong>{cityCap}</strong> ({pharmacy.postal}), dans le département <strong>{deptLabel}</strong>.
          {isPremiumDept && ' Cette zone fait partie des départements où les prix libérés (Wegovy, Mounjaro, Saxenda) tendent à se positionner légèrement au-dessus de la moyenne nationale en raison du coût immobilier et du pouvoir d\'achat local.'}
          {isRuralDept && ' Cette zone rurale présente généralement des prix libérés (Wegovy, Mounjaro, Saxenda) légèrement inférieurs à la moyenne nationale.'}
          {!isPremiumDept && !isRuralDept && ' Cette zone se situe dans la moyenne nationale pour les prix des traitements en prix libéré (Wegovy, Mounjaro, Saxenda).'}
          Les estimations affichées plus bas tiennent compte de cette variance régionale.
        </p>
        <p class="context-text">
          Pour comprendre le marché GLP-1 en France et choisir le traitement adapté, consultez nos guides détaillés :
          <a href="/collections/glp1-cout/prix-ozempic-france/">Prix Ozempic France</a>,
          <a href="/collections/glp1-cout/prix-wegovy-france/">Prix Wegovy France</a>,
          <a href="/collections/glp1-cout/prix-mounjaro-france/">Prix Mounjaro France</a>,
          <a href="/collections/glp1-cout/remboursement-glp1-2026/">Remboursement GLP-1 2026</a>.
        </p>
      </div>
    </section>

    <section class="pharma-prices">
      <div class="pharma-section-inner">
        <h2>Prix des traitements GLP-1 à {nameCap}</h2>
        <p class="prices-intro">Tableau complet des prix par traitement et dosage. <strong>Ozempic</strong> = prix CEPS légal de <strong>80,18 €/stylo</strong>, identique France entière, remboursé 65 % en bithérapie metformine pour le DT2. <strong>Wegovy, Mounjaro, Saxenda</strong> = prix libéré, estimation basée sur la moyenne marché française + variance géographique de la zone {deptZone} (département {pharmacy.department}). Données mises à jour {updateMonth}.</p>

        <div class="drug-sections">
          {Object.entries(prices).map(([slug, d]) => (
            <div class="drug-section">
              <div class="drug-section-head">
                <h3>{d.name}</h3>
                <span class={`src-badge ${d.fixed ? 'src-off' : 'src-est'}`}>{d.fixed ? 'Officiel CEPS' : 'Estimation'}</span>
              </div>
              <p class="drug-note">{d.note}</p>
              <table class="price-table">
                <thead>
                  <tr><th>Dosage</th><th>Prix</th></tr>
                </thead>
                <tbody>
                  {d.rows.map((r) => (
                    <tr>
                      <td>{r.dose}</td>
                      <td><strong>{r.price.toFixed(2)} €</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Pharmacies voisines : contenu unique + maillage interne entre pages pharmacies -->
    {neighbours.length > 0 && (
      <section class="pharma-neighbours">
        <div class="pharma-section-inner">
          <h2>Autres pharmacies à {cityCap}</h2>
          <p class="neighbours-intro">
            Si {nameCap} est en rupture de stock ou si vous cherchez une seconde estimation tarifaire, voici {neighbours.length} pharmacie{neighbours.length > 1 ? 's' : ''} voisine{neighbours.length > 1 ? 's' : ''} à {cityCap} qui peuvent également dispenser vos traitements GLP-1. Le prix Ozempic (CEPS) est identique partout ; les estimations Wegovy / Mounjaro / Saxenda peuvent légèrement varier selon le FINESS de l'officine.
          </p>
          <div class="neighbours-grid">
            {neighbours.map((n) => (
              <a href={`/pharmacies/${pharmacy.city_slug}/${n.slug}/`} class="neighbour-card">
                <span class="neighbour-name">{titleCase(n.name)}</span>
                <span class="neighbour-postal">{n.postal} {cityCap}</span>
                <span class="neighbour-link">Voir les prix →</span>
              </a>
            ))}
          </div>
          {hasCityPage && (
            <p class="neighbours-more">
              <a href={`/pharmacies/${pharmacy.city_slug}/`}>→ Voir toutes les {cityCount.toLocaleString('fr-FR')} pharmacies de {cityCap}</a>
            </p>
          )}
        </div>
      </section>
    )}

    <!-- E-E-A-T : sources et méthodologie -->
    <section class="pharma-trust">
      <div class="pharma-section-inner">
        <h2>Sources et méthodologie</h2>
        <ul class="trust-list">
