---
import StaticLayout from '../../layouts/StaticLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dataPath = path.resolve(process.cwd(), 'public/data/pharmacies.json');
  const pricesPath = path.resolve(process.cwd(), 'public/data/latest-prices.json');
  let pharmacies = { schema: [], rows: [] };
  let latestPrices = {};
  try { pharmacies = JSON.parse(fs.readFileSync(dataPath, 'utf-8')); } catch {}
  try { latestPrices = JSON.parse(fs.readFileSync(pricesPath, 'utf-8')); } catch {}

  const iId = pharmacies.schema.indexOf('id');
  const iName = pharmacies.schema.indexOf('name');
  const iCity = pharmacies.schema.indexOf('city');
  const iSlug = pharmacies.schema.indexOf('city_slug');
  const iDept = pharmacies.schema.indexOf('department');
  const iCP = pharmacies.schema.indexOf('postal_code');
  const iLat = pharmacies.schema.indexOf('lat');
  const iLng = pharmacies.schema.indexOf('lng');

  // Index par ville
  const byCity = {};
  for (const row of pharmacies.rows) {
    const slug = row[iSlug];
    if (!slug) continue;
    if (!byCity[slug]) {
      byCity[slug] = { slug, city: row[iCity], department: row[iDept], pharmacies: [], centerLat: 0, centerLng: 0 };
    }
    byCity[slug].pharmacies.push({
      id: row[iId],
      name: row[iName],
      postal: row[iCP],
      lat: row[iLat],
      lng: row[iLng],
      prices: latestPrices[row[iId]] || [],
    });
  }

  // Calcule le centre de chaque ville + tri pharmacies par prix (meilleur d'abord)
  for (const slug of Object.keys(byCity)) {
    const c = byCity[slug];
    c.centerLat = c.pharmacies.reduce((a, p) => a + Number(p.lat), 0) / c.pharmacies.length;
    c.centerLng = c.pharmacies.reduce((a, p) => a + Number(p.lng), 0) / c.pharmacies.length;
  }

  // Top 100 villes seulement (budget build time)
  const topCities = Object.values(byCity)
    .sort((a, b) => b.pharmacies.length - a.pharmacies.length)
    .slice(0, 100);

  // Calcule les "villes proches" pour chaque ville : même département d'abord, puis top global
  const sameDeptByCity = {};
  for (const c of topCities) {
    sameDeptByCity[c.slug] = topCities
      .filter((o) => o.department === c.department && o.slug !== c.slug)
      .slice(0, 8);
  }
  const topGlobalForOthers = topCities.slice(0, 12);

  // Groupe par code postal pour chaque ville (arrondissements Paris, districts Marseille, etc.)
  const zipcodesByCity = {};
  for (const c of topCities) {
    const zipCounts = {};
    for (const p of c.pharmacies) {
      const zip = p.postal;
      if (!zip) continue;
      zipCounts[zip] = (zipCounts[zip] || 0) + 1;
    }
    zipcodesByCity[c.slug] = Object.entries(zipCounts)
      .sort((a, b) => a[0].localeCompare(b[0]))
      .map(([zip, count]) => ({ zip, count }));
  }

  // Calcule le bbox de chaque ville (pour zoomer la mini-map)
  for (const c of topCities) {
    let minLat = Infinity, minLng = Infinity, maxLat = -Infinity, maxLng = -Infinity;
    for (const p of c.pharmacies) {
      const lat = Number(p.lat), lng = Number(p.lng);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) continue;
      if (lat < minLat) minLat = lat;
      if (lng < minLng) minLng = lng;
      if (lat > maxLat) maxLat = lat;
      if (lng > maxLng) maxLng = lng;
    }
    c.bbox = [minLng, minLat, maxLng, maxLat];
  }

  return topCities.map((c) => ({
    params: { ville: c.slug },
    props: {
      city: c,
      sameDept: sameDeptByCity[c.slug] || [],
      topGlobal: topGlobalForOthers.filter((o) => o.slug !== c.slug).slice(0, 10),
      zipcodes: zipcodesByCity[c.slug] || [],
    },
  }));
}

const { city, sameDept = [], topGlobal = [], zipcodes = [] } = Astro.props;
const ville = city.slug;

// Pharmacies sérialisées pour la mini-map (limitées à 1000 pour la perf)
const mapPharmacies = city.pharmacies.slice(0, 1000).map((p) => ({
  id: p.id,
  name: p.name,
  postal: p.postal,
  lat: p.lat,
  lng: p.lng,
}));
const bbox = city.bbox || [city.centerLng - 0.05, city.centerLat - 0.05, city.centerLng + 0.05, city.centerLat + 0.05];

// Capitalise proprement "PARIS" → "Paris", "AIX EN PROVENCE" → "Aix en Provence"
function titleCase(s) {
  return (s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}

const DEPT_NAMES = {
  '75': 'Paris', '13': 'Bouches-du-Rhône', '69': 'Rhône', '31': 'Haute-Garonne',
  '06': 'Alpes-Maritimes', '33': 'Gironde', '34': 'Hérault', '44': 'Loire-Atlantique',
  '67': 'Bas-Rhin', '59': 'Nord', '83': 'Var', '51': 'Marne', '38': 'Isère',
  '35': 'Ille-et-Vilaine', '87': 'Haute-Vienne', '30': 'Gard', '63': 'Puy-de-Dôme',
  '66': 'Pyrénées-Orientales', '21': 'Côte-d\'Or', '37': 'Indre-et-Loire',
  '42': 'Loire', '80': 'Somme', '76': 'Seine-Maritime', '974': 'La Réunion',
  '49': 'Maine-et-Loire', '54': 'Meurthe-et-Moselle', '74': 'Haute-Savoie',
  '25': 'Doubs', '72': 'Sarthe', '57': 'Moselle', '92': 'Hauts-de-Seine',
  '78': 'Yvelines', '77': 'Seine-et-Marne', '93': 'Seine-Saint-Denis',
  '94': 'Val-de-Marne', '91': 'Essonne', '95': 'Val-d\'Oise',
};
const villeCap = titleCase(city.city);

// Stats par drug : prix moyen, min, max, pharmacies qui ont un prix
const DRUGS = [
  { slug: 'ozempic', name: 'Ozempic', note: 'remboursé 30% (diabète type 2)' },
  { slug: 'wegovy', name: 'Wegovy', note: 'prix libéré, non remboursé' },
  { slug: 'mounjaro', name: 'Mounjaro', note: 'prix libéré, non remboursé' },
  { slug: 'saxenda', name: 'Saxenda', note: 'prix libéré, non remboursé' },
];

const drugStats = DRUGS.map((d) => {
  const prices = [];
  const pharmaWithPrice = [];
  for (const p of city.pharmacies) {
    const pr = p.prices.find((x) => x.d === d.slug);
    if (pr) {
      prices.push(Number(pr.p));
      pharmaWithPrice.push({ ...p, pr });
    }
  }
  if (!prices.length) return { ...d, count: 0 };
  return {
    ...d,
    count: prices.length,
    min: Math.min(...prices),
    max: Math.max(...prices),
    avg: prices.reduce((a, b) => a + b, 0) / prices.length,
    topPharmacies: pharmaWithPrice
      .sort((a, b) => a.pr.p - b.pr.p)
      .slice(0, 10),
  };
});

const hasUserPrices = drugStats.some((d) => d.count > 0 && d.slug !== 'ozempic');

// Top 10 pharmacies par prix Ozempic (77,60€ uniforme donc tri alphabétique)
const topPharmacies = [...city.pharmacies]
  .sort((a, b) => a.name.localeCompare(b.name))
  .slice(0, 20);

const title = `Pharmacies GLP-1 à ${villeCap} — Prix Ozempic, Wegovy, Mounjaro 2026`;
const description = `${city.pharmacies.length} pharmacies référencées à ${villeCap} (${city.department}). Prix Ozempic officiel 77,60 €, prix Wegovy et Mounjaro variables. Carte interactive + contributions communautaires.`;

// FAQ schema
const faq = [
  {
    q: `Combien de pharmacies vendent Ozempic, Wegovy ou Mounjaro à ${villeCap} ?`,
    a: `Nous avons référencé ${city.pharmacies.length} pharmacies d'officine à ${villeCap}. Toutes peuvent potentiellement délivrer Ozempic (remboursé pour diabète type 2) sur ordonnance. Wegovy et Mounjaro sont également disponibles sur ordonnance mais leur prix varie selon l'officine.`,
  },
  {
    q: `Quel est le prix d'Ozempic à ${villeCap} ?`,
    a: `Ozempic est vendu au prix public CEPS de 77,60 € par stylo, identique dans toutes les pharmacies de France, y compris à ${villeCap}. Il est remboursé à 30% par l'Assurance Maladie pour les patients atteints de diabète de type 2 (100% en ALD).`,
  },
  {
    q: `Wegovy et Mounjaro sont-ils remboursés à ${villeCap} ?`,
    a: `Non. Wegovy et Mounjaro ne sont pas remboursés par l'Assurance Maladie en France (avril 2026). Leur prix est libéré, ce qui signifie que chaque pharmacie fixe son propre tarif. Les prix observés varient généralement entre 169 et 360 € pour Wegovy et entre 230 et 440 € pour Mounjaro selon le dosage.`,
  },
  {
    q: `Comment obtenir une ordonnance pour ces traitements ?`,
    a: `Tous les traitements GLP-1 nécessitent une prescription médicale. Pour Ozempic et Wegovy, la restriction aux endocrinologues a été levée en juin 2025 : tout médecin peut désormais prescrire. Pour une téléconsultation rapide, vous pouvez passer par des plateformes comme Charles ou Annette.`,
  },
];
---

<StaticLayout title={title} description={description} keywords={`pharmacie GLP-1 ${villeCap}, prix Ozempic ${villeCap}, prix Wegovy ${villeCap}, prix Mounjaro ${villeCap}, pharmacie ${city.department}`}>
  <!-- Breadcrumb + FAQ schema -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://glp1-france.fr/" },
          { "@type": "ListItem", "position": 2, "name": "Pharmacies", "item": "https://glp1-france.fr/pharmacies/" },
          { "@type": "ListItem", "position": 3, "name": villeCap, "item": `https://glp1-france.fr/pharmacies/${ville}/` },
        ],
      },
      {
        "@type": "FAQPage",
        "mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
      },
    ],
  })} />

  <div class="ville-page">
    <section class="ville-hero">
      <div class="ville-hero-inner">
        <nav class="breadcrumb">
          <a href="/">Accueil</a> <span>›</span>
          <a href="/pharmacies/">Pharmacies</a> <span>›</span>
          <strong>{villeCap}</strong>
        </nav>
        <h1>Pharmacies GLP-1 à {villeCap}</h1>
        <p class="ville-sub">
          <strong>{city.pharmacies.length} pharmacies</strong> référencées à {villeCap} ({city.department}) · Prix Ozempic officiel, prix Wegovy/Mounjaro variables
        </p>
        <div class="ville-ctas">
          <a href={`/outils/carte-prix-pharmacies/?lat=${city.centerLat.toFixed(4)}&lng=${city.centerLng.toFixed(4)}&zoom=12`} class="btn-primary">Voir sur la carte →</a>
          <a href="/outils/carte-prix-pharmacies/#partager" class="btn-secondary">Partager un prix</a>
        </div>
      </div>
    </section>

    <!-- Mini-map : pharmacies de la ville -->
    <section class="ville-map-section">
      <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
      <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
      <div id="ville-map" class="ville-map" aria-label={`Carte des pharmacies à ${villeCap}`}></div>
      <script is:inline define:vars={{ pharmaciesData: mapPharmacies, bbox, cityName: villeCap }}>
        (function () {
          if (typeof maplibregl === 'undefined') return;
          const style = {
            version: 8,
            sources: {
              'tiles': {
                type: 'raster',
                tiles: [
                  'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
                  'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
                ],
                tileSize: 256,
                attribution: '© OpenStreetMap · © CARTO',
              },
            },
            layers: [{ id: 'bg', type: 'raster', source: 'tiles' }],
          };
          const map = new maplibregl.Map({
            container: 'ville-map',
            style,
            bounds: [[bbox[0], bbox[1]], [bbox[2], bbox[3]]],
            fitBoundsOptions: { padding: 30, maxZoom: 14 },
          });
          map.addControl(new maplibregl.NavigationControl(), 'top-right');

          const ready = new Promise((resolve) => {
            let done = false;
            const go = () => { if (done) return; done = true; resolve(); };
            map.on('styledata', () => { if (map.isStyleLoaded()) go(); });
            map.on('load', go);
            setTimeout(go, 6000);
          });

          ready.then(() => {
            const features = pharmaciesData.map((p) => ({
              type: 'Feature',
              geometry: { type: 'Point', coordinates: [Number(p.lng), Number(p.lat)] },
              properties: { name: p.name, postal: p.postal },
            }));
            map.addSource('pharma', {
              type: 'geojson',
              data: { type: 'FeatureCollection', features },
              cluster: true,
              clusterRadius: 40,
              clusterMaxZoom: 14,
            });
            map.addLayer({
              id: 'clusters', type: 'circle', source: 'pharma', filter: ['has', 'point_count'],
              paint: {
                'circle-color': ['step', ['get', 'point_count'], '#93c5fd', 20, '#60a5fa', 100, '#2563eb'],
                'circle-radius': ['step', ['get', 'point_count'], 14, 20, 18, 100, 22],
                'circle-stroke-width': 2, 'circle-stroke-color': '#fff',
              },
            });
            map.addLayer({
              id: 'cluster-count', type: 'symbol', source: 'pharma', filter: ['has', 'point_count'],
              layout: { 'text-field': '{point_count_abbreviated}', 'text-font': ['Noto Sans Regular'], 'text-size': 12 },
              paint: { 'text-color': '#fff' },
            });
            map.addLayer({
              id: 'points', type: 'circle', source: 'pharma', filter: ['!', ['has', 'point_count']],
              paint: { 'circle-color': '#16a34a', 'circle-radius': 6, 'circle-stroke-width': 1.5, 'circle-stroke-color': '#fff' },
            });
            map.on('click', 'points', (e) => {
              const f = e.features[0];
              new maplibregl.Popup({ maxWidth: '280px' })
                .setLngLat(f.geometry.coordinates)
                .setHTML('<strong>' + f.properties.name + '</strong><br><small>' + f.properties.postal + '</small>')
                .addTo(map);
            });
            map.on('mouseenter', 'points', () => { map.getCanvas().style.cursor = 'pointer'; });
            map.on('mouseleave', 'points', () => { map.getCanvas().style.cursor = ''; });
          });
        })();
      </script>
    </section>

    {zipcodes.length > 1 && (
      <section class="ville-zipcodes">
        <div class="ville-section-inner">
          <h2>Pharmacies par code postal à {villeCap}</h2>
          <p class="zip-intro">{zipcodes.length} codes postaux référencés. Cliquez pour voir les pharmacies de chaque secteur.</p>
          <div class="zip-grid">
            {zipcodes.map((z) => (
              <a href={`/pharmacies/cp/${z.zip}/`} class="zip-card">
                <span class="zip-code">{z.zip}</span>
                <span class="zip-count">{z.count} pharmacies</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Tableau prix par médicament -->
    <section class="ville-prices">
      <div class="ville-section-inner">
        <h2>Prix des traitements GLP-1 à {villeCap}</h2>

        <div class="drug-grid">
          {drugStats.map((d) => (
            <div class="drug-card">
              <div class="drug-head">
                <h3>{d.name}</h3>
                <span class="drug-note">{d.note}</span>
              </div>
              {d.count > 0 ? (
                <div class="drug-stats">
                  {d.slug === 'ozempic' ? (
                    <div class="drug-price-row">
                      <div class="price-label">Prix officiel</div>
                      <div class="price-big">77,60 €</div>
                      <div class="price-meta">par stylo · identique France entière</div>
                    </div>
                  ) : (
                    <>
                      <div class="drug-price-row">
                        <div class="price-label">Prix le plus bas</div>
                        <div class="price-big">{d.min.toFixed(2)} €</div>
                      </div>
                      <div class="drug-price-row">
                        <div class="price-label">Prix moyen</div>
                        <div class="price-mid">{d.avg.toFixed(2)} €</div>
                        <div class="price-meta">{d.count} prix soumis</div>
                      </div>
                    </>
                  )}
                </div>
              ) : (
                <div class="drug-empty">
                  <p>Aucun prix soumis par la communauté pour l'instant.</p>
                  <a href="/outils/carte-prix-pharmacies/" class="link-small">Partagez le vôtre →</a>
                </div>
              )}
            </div>
          ))}
        </div>

        <p class="prices-note">
          Les prix Wegovy, Mounjaro et Saxenda sont <strong>libérés</strong> (non remboursés) : chaque pharmacie fixe son tarif. Les valeurs ci-dessus proviennent des soumissions communautaires vérifiées. Pour une information temps réel, <a href="/outils/carte-prix-pharmacies/">consultez la carte</a>.
        </p>
      </div>
    </section>

    <!-- Liste pharmacies -->
    <section class="ville-list">
      <div class="ville-section-inner">
        <h2>Pharmacies à {villeCap}</h2>
        <p class="list-intro">{city.pharmacies.length} pharmacies d'officine référencées (FINESS). Affichage alphabétique des 20 premières.</p>

        <div class="pharmacy-list">
          {topPharmacies.map((p) => (
            <div class="pharmacy-row">
              <div class="pharmacy-info">
                <div class="pharmacy-name">{titleCase(p.name)}</div>
                <div class="pharmacy-postal">{p.postal} {titleCase(city.city)}</div>
              </div>
              <div class="pharmacy-prices">
                {p.prices.length > 0 ? (
                  p.prices.map((pr) => (
                    <span class="price-pill">
                      <strong>{DRUGS.find((d) => d.slug === pr.d)?.name || pr.d}</strong>
                      {' '}{Number(pr.p).toFixed(2)} €
                    </span>
                  ))
                ) : (
                  <span class="price-pill price-none">Pas de prix soumis</span>
                )}
              </div>
            </div>
          ))}
        </div>
        {city.pharmacies.length > 20 && (
          <p class="list-more">
            Et <strong>{city.pharmacies.length - 20}</strong> autres pharmacies à {villeCap}. <a href={`/outils/carte-prix-pharmacies/?lat=${city.centerLat.toFixed(4)}&lng=${city.centerLng.toFixed(4)}&zoom=12`}>Voir toutes sur la carte →</a>
          </p>
        )}
      </div>
    </section>

    <!-- FAQ -->
    <section class="ville-faq">
      <div class="ville-section-inner">
        <h2>Questions fréquentes</h2>
        <div class="faq-list">
          {faq.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-answer">{f.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Maillage : autres villes -->
    <section class="ville-interlinks">
      <div class="ville-section-inner">
        <div class="interlinks-grid">
          {sameDept.length > 0 && (
            <div class="interlinks-col">
              <h2>Autres villes en {DEPT_NAMES[city.department] || 'département ' + city.department}</h2>
              <ul class="interlinks-list">
                {sameDept.map((c) => (
                  <li>
                    <a href={`/pharmacies/${c.slug}/`}>
                      <strong>{titleCase(c.city)}</strong>
                      <span>{c.pharmacies.length} pharmacies</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <div class="interlinks-col">
            <h2>Grandes villes françaises</h2>
            <ul class="interlinks-list">
              {topGlobal.map((c) => (
                <li>
                  <a href={`/pharmacies/${c.slug}/`}>
                    <strong>{titleCase(c.city)}</strong>
                    <span>{c.pharmacies.length} pharmacies</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="interlinks-col">
            <h2>Ressources GLP-1</h2>
            <ul class="interlinks-list interlinks-simple">
              <li><a href="/outils/carte-prix-pharmacies/">🗺️ Carte des prix pharmacies</a></li>
              <li><a href="/pharmacies/">Annuaire pharmacies par ville</a></li>
              <li><a href="/collections/glp1-cout/prix-ozempic-france/">Prix Ozempic</a></li>
              <li><a href="/collections/glp1-cout/prix-wegovy-france/">Prix Wegovy</a></li>
              <li><a href="/collections/glp1-cout/prix-mounjaro-france/">Prix Mounjaro</a></li>
              <li><a href="/collections/glp1-cout/wegovy-remboursement-mutuelle/">Remboursement & mutuelles</a></li>
              <li><a href="/collections/medecins-glp1-france/">Médecins prescripteurs</a></li>
              <li><a href="/guides/quel-traitement-glp1-choisir/">Quel traitement choisir&nbsp;?</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="ville-disclaimer">
      <p>
        <strong>Avertissement médical :</strong> cette page est informative et ne remplace pas un avis médical. Tous les traitements GLP-1 nécessitent une prescription médicale. Les prix indiqués (hors Ozempic) sont des contributions communautaires, vérifiez le tarif directement auprès de la pharmacie.
        Sources : référentiel FINESS (Atlasanté / data.gouv.fr), CEPS.
      </p>
    </section>
  </div>

  <style>
  .ville-page { background: #f8faf9; min-height: 100vh; }

  .ville-hero {
    background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f0f9ff 100%);
    border-bottom: 1px solid #e5e7eb;
    padding: 2rem 1.5rem 1.75rem;
  }
  .ville-hero-inner, .ville-section-inner { max-width: 1100px; margin: 0 auto; }
  .breadcrumb { font-size: .82rem; color: #6b7280; margin-bottom: .75rem; }
  .breadcrumb a { color: #1a3c34; text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { margin: 0 .35rem; color: #9ca3af; }
  .ville-hero h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    font-weight: 900; color: #1a3c34;
    margin: 0 0 .5rem; letter-spacing: -.02em; line-height: 1.2;
  }
  .ville-sub { color: #475569; font-size: clamp(.9rem, 2vw, 1rem); margin: 0 0 1.25rem; line-height: 1.5; }
  .ville-ctas { display: flex; gap: .6rem; flex-wrap: wrap; }
  .btn-primary, .btn-secondary {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .65rem 1.3rem; font-weight: 700; font-size: .88rem;
