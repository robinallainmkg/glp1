---
import StaticLayout from '../../../layouts/StaticLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Libellés humains des départements (codes INSEE → nom)
const DEPT_LABELS: Record<string, string> = {
  '01': 'Ain', '02': 'Aisne', '03': 'Allier', '04': 'Alpes-de-Haute-Provence', '05': 'Hautes-Alpes',
  '06': 'Alpes-Maritimes', '07': 'Ardèche', '08': 'Ardennes', '09': 'Ariège', '10': 'Aube',
  '11': 'Aude', '12': 'Aveyron', '13': 'Bouches-du-Rhône', '14': 'Calvados', '15': 'Cantal',
  '16': 'Charente', '17': 'Charente-Maritime', '18': 'Cher', '19': 'Corrèze', '21': 'Côte-d\'Or',
  '22': 'Côtes-d\'Armor', '23': 'Creuse', '24': 'Dordogne', '25': 'Doubs', '26': 'Drôme',
  '27': 'Eure', '28': 'Eure-et-Loir', '29': 'Finistère', '30': 'Gard', '31': 'Haute-Garonne',
  '32': 'Gers', '33': 'Gironde', '34': 'Hérault', '35': 'Ille-et-Vilaine', '36': 'Indre',
  '37': 'Indre-et-Loire', '38': 'Isère', '39': 'Jura', '40': 'Landes', '41': 'Loir-et-Cher',
  '42': 'Loire', '43': 'Haute-Loire', '44': 'Loire-Atlantique', '45': 'Loiret', '46': 'Lot',
  '47': 'Lot-et-Garonne', '48': 'Lozère', '49': 'Maine-et-Loire', '50': 'Manche', '51': 'Marne',
  '52': 'Haute-Marne', '53': 'Mayenne', '54': 'Meurthe-et-Moselle', '55': 'Meuse', '56': 'Morbihan',
  '57': 'Moselle', '58': 'Nièvre', '59': 'Nord', '60': 'Oise', '61': 'Orne', '62': 'Pas-de-Calais',
  '63': 'Puy-de-Dôme', '64': 'Pyrénées-Atlantiques', '65': 'Hautes-Pyrénées', '66': 'Pyrénées-Orientales',
  '67': 'Bas-Rhin', '68': 'Haut-Rhin', '69': 'Rhône', '70': 'Haute-Saône', '71': 'Saône-et-Loire',
  '72': 'Sarthe', '73': 'Savoie', '74': 'Haute-Savoie', '75': 'Paris', '76': 'Seine-Maritime',
  '77': 'Seine-et-Marne', '78': 'Yvelines', '79': 'Deux-Sèvres', '80': 'Somme', '81': 'Tarn',
  '82': 'Tarn-et-Garonne', '83': 'Var', '84': 'Vaucluse', '85': 'Vendée', '86': 'Vienne',
  '87': 'Haute-Vienne', '88': 'Vosges', '89': 'Yonne', '90': 'Territoire de Belfort', '91': 'Essonne',
  '92': 'Hauts-de-Seine', '93': 'Seine-Saint-Denis', '94': 'Val-de-Marne', '95': 'Val-d\'Oise',
  '971': 'Guadeloupe', '972': 'Martinique', '973': 'Guyane', '974': 'La Réunion', '976': 'Mayotte',
};

// Chefs-lieux des départements (préfecture)
const DEPT_PREFECTURES: Record<string, string> = {
  '59': 'Lille', '75': 'Paris', '13': 'Marseille', '69': 'Lyon', '33': 'Bordeaux',
  '62': 'Arras', '92': 'Nanterre', '06': 'Nice', '31': 'Toulouse', '93': 'Bobigny',
  '44': 'Nantes', '34': 'Montpellier', '94': 'Créteil', '38': 'Grenoble', '78': 'Versailles',
  '83': 'Toulon', '77': 'Melun', '76': 'Rouen', '91': 'Évry-Courcouronnes', '95': 'Cergy',
};

// Régions / contexte géographique pour storytelling unique par département
const DEPT_REGION: Record<string, string> = {
  '59': 'Hauts-de-France', '62': 'Hauts-de-France',
  '75': 'Île-de-France', '92': 'Île-de-France', '93': 'Île-de-France', '94': 'Île-de-France',
  '78': 'Île-de-France', '77': 'Île-de-France', '91': 'Île-de-France', '95': 'Île-de-France',
  '13': 'Provence-Alpes-Côte d\'Azur', '06': 'Provence-Alpes-Côte d\'Azur', '83': 'Provence-Alpes-Côte d\'Azur',
  '69': 'Auvergne-Rhône-Alpes', '38': 'Auvergne-Rhône-Alpes',
  '33': 'Nouvelle-Aquitaine',
  '31': 'Occitanie', '34': 'Occitanie',
  '44': 'Pays de la Loire',
  '76': 'Normandie',
};

const PREMIUM_DEPTS = new Set(['75', '92', '78', '06', '69', '13', '74', '77', '93', '94', '91', '95']);
const RURAL_DEPTS = new Set(['23', '15', '48', '19', '46', '55', '39', '52', '58', '43', '04']);

export async function getStaticPaths() {
  const dataPath = path.resolve(process.cwd(), 'public/data/pharmacies.json');
  let pharmacies = { schema: [], rows: [] };
  try { pharmacies = JSON.parse(fs.readFileSync(dataPath, 'utf-8')); } catch {}

  const iId = pharmacies.schema.indexOf('id');
  const iName = pharmacies.schema.indexOf('name');
  const iCity = pharmacies.schema.indexOf('city');
  const iSlug = pharmacies.schema.indexOf('city_slug');
  const iDept = pharmacies.schema.indexOf('department');
  const iCP = pharmacies.schema.indexOf('postal_code');
  const iLat = pharmacies.schema.indexOf('lat');
  const iLng = pharmacies.schema.indexOf('lng');

  // Index par département
  const byDept: Record<string, any> = {};
  for (const row of pharmacies.rows) {
    const dept = row[iDept];
    if (!dept) continue;
    if (!byDept[dept]) {
      byDept[dept] = { dept, pharmacies: [], byCity: {} };
    }
    const slug = row[iSlug];
    const city = row[iCity];
    byDept[dept].pharmacies.push({
      id: row[iId],
      name: row[iName],
      city,
      city_slug: slug,
      postal: row[iCP],
      lat: Number(row[iLat]),
      lng: Number(row[iLng]),
    });
    if (slug) {
      if (!byDept[dept].byCity[slug]) {
        byDept[dept].byCity[slug] = { slug, city, count: 0 };
      }
      byDept[dept].byCity[slug].count++;
    }
  }

  // Top 20 départements par nombre de pharmacies (MVP)
  const topDepts = Object.values(byDept)
    .sort((a: any, b: any) => b.pharmacies.length - a.pharmacies.length)
    .slice(0, 20);

  // Pré-calcule pour chaque dept: top villes, bbox, centre, top global pour maillage
  const allDeptsTop20: any[] = topDepts.map((d: any) => ({
    dept: d.dept,
    count: d.pharmacies.length,
  }));

  return topDepts.map((d: any) => {
    // Bbox du département
    let minLat = Infinity, minLng = Infinity, maxLat = -Infinity, maxLng = -Infinity;
    let sumLat = 0, sumLng = 0, count = 0;
    for (const p of d.pharmacies) {
      const lat = Number(p.lat), lng = Number(p.lng);
      if (!Number.isFinite(lat) || !Number.isFinite(lng)) continue;
      if (lat < minLat) minLat = lat;
      if (lng < minLng) minLng = lng;
      if (lat > maxLat) maxLat = lat;
      if (lng > maxLng) maxLng = lng;
      sumLat += lat;
      sumLng += lng;
      count++;
    }
    const centerLat = count ? sumLat / count : 0;
    const centerLng = count ? sumLng / count : 0;
    const bbox = [minLng, minLat, maxLng, maxLat];

    // Top villes par nombre de pharmacies (top 20)
    const topCities = (Object.values(d.byCity) as any[])
      .sort((a, b) => b.count - a.count)
      .slice(0, 20);

    // Liste paginée des pharmacies (200 premières par ordre alpha)
    const sortedPharmas = [...d.pharmacies]
      .sort((a, b) => (a.name || '').localeCompare(b.name || ''))
      .slice(0, 200);

    // Codes postaux uniques
    const zipSet = new Set<string>();
    for (const p of d.pharmacies) {
      if (p.postal) zipSet.add(p.postal);
    }

    return {
      params: { dept: d.dept },
      props: {
        deptCode: d.dept,
        totalPharmas: d.pharmacies.length,
        totalCities: Object.keys(d.byCity).length,
        totalZipcodes: zipSet.size,
        topCities,
        sortedPharmas,
        bbox,
        centerLat,
        centerLng,
        // pharmacies sérialisées pour la mini-map (limitées à 1500 pour la perf)
        mapPharmacies: d.pharmacies.slice(0, 1500).map((p: any) => ({
          name: p.name,
          postal: p.postal,
          lat: p.lat,
          lng: p.lng,
        })),
        // Autres départements top pour maillage interne
        otherDepts: allDeptsTop20.filter((o) => o.dept !== d.dept).slice(0, 12),
      },
    };
  });
}

const {
  deptCode,
  totalPharmas,
  totalCities,
  totalZipcodes,
  topCities,
  sortedPharmas,
  bbox,
  centerLat,
  centerLng,
  mapPharmacies,
  otherDepts,
} = Astro.props;

function titleCase(s: string) {
  return (s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}

const deptLabel = DEPT_LABELS[deptCode] || `Département ${deptCode}`;
const prefecture = DEPT_PREFECTURES[deptCode] || titleCase(topCities[0]?.city || '');
const region = DEPT_REGION[deptCode] || '';
const isPremiumDept = PREMIUM_DEPTS.has(deptCode);
const isRuralDept = RURAL_DEPTS.has(deptCode);
const deptZone = isPremiumDept ? 'urbaine premium' : isRuralDept ? 'rurale' : 'standard';

// Prix officiels réglementés (BDPM / arrêtés JO du 28/05/2026, en vigueur 15/06/2026) — identiques partout
const OZEMPIC_PRICE = '77,60 €';
const WEGOVY_RANGE = '146,91 – 195,10 €';
const MOUNJARO_RANGE = '176,10 – 433,80 €';

const updateDate = new Date();
const updateMonth = updateDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });

const title = `Pharmacies GLP-1 ${deptLabel} (${deptCode}) — Prix Ozempic Wegovy Mounjaro 2026`;
const description = `${totalPharmas.toLocaleString('fr-FR')} pharmacies du département ${deptLabel} (${deptCode}) — chef-lieu ${prefecture}. Prix officiels 2026 : Ozempic 77,60 €, Wegovy 146,91–195,10 €, Mounjaro 176,10–433,80 € (réglementés, identiques partout). Carte + ${totalCities} villes.`;

// FAQ — questions départementales spécifiques (pas de duplicate avec pages villes)
const faq = [
  {
    q: `Combien y a-t-il de pharmacies en ${deptLabel} (${deptCode}) ?`,
    a: `Notre référentiel FINESS officiel recense **${totalPharmas.toLocaleString('fr-FR')} pharmacies d'officine** dans le département ${deptLabel} (${deptCode}), réparties dans **${totalCities.toLocaleString('fr-FR')} communes** et ${totalZipcodes} codes postaux différents. Toutes peuvent dispenser les traitements GLP-1 (Ozempic, Wegovy, Mounjaro, Trulicity, Victoza, Saxenda) sur ordonnance médicale.`,
  },
  {
    q: `Quel est le prix de Wegovy et Mounjaro en ${deptLabel} ?`,
    a: `Depuis le 15 juin 2026, les prix sont **réglementés et identiques dans toutes les pharmacies** du ${deptLabel} comme partout en France : Wegovy de **146,91 à 195,10 €** et Mounjaro de **176,10 à 433,80 €** par mois selon le dosage. Les deux sont remboursés à **65 %** par l'Assurance Maladie dans l'obésité, sous conditions. Ozempic est à **77,60 €** partout.`,
  },
  {
    q: `Ozempic est-il remboursé par la Sécurité sociale en ${deptLabel} ?`,
    a: `Oui — le remboursement Ozempic dépend de l'indication, pas de la géographie. En 2026, Ozempic est remboursé à **30 %** par l'Assurance Maladie pour le diabète de type 2 — et à **100 %** en ALD (Affection Longue Durée). Wegovy et Mounjaro sont quant à eux remboursés à **65 %** dans l'obésité depuis le 15 juin 2026, sous conditions (IMC, primo-prescription spécialiste). Détails : [Remboursement GLP-1 2026](/collections/glp1-cout/remboursement-glp1-2026/).`,
  },
  {
    q: `Quelle est la ville avec le plus de pharmacies en ${deptLabel} ?`,
    a: `Dans le département ${deptLabel}, ${titleCase(topCities[0]?.city || prefecture)} concentre le plus grand nombre de pharmacies avec **${topCities[0]?.count || '—'} officines** référencées. Les autres communes principales du département figurent dans la section "Top 10 villes" plus haut. Pour la liste complète des pharmacies par ville, cliquez sur une commune pour accéder à sa page dédiée.`,
  },
  {
    q: `Comment obtenir une ordonnance GLP-1 en ${deptLabel} ?`,
    a: `Tout médecin (généraliste, endocrinologue, diabétologue) peut prescrire Ozempic, Wegovy ou Mounjaro depuis juin 2025 (la restriction aux endocrinologues a été levée). Si vous n'avez pas de rendez-vous proche dans le ${deptLabel}, la téléconsultation est une alternative rapide : consultation en 24h, ordonnance numérique transmise à la pharmacie de votre choix. Voir [médecins prescripteurs GLP-1](/collections/medecins-glp1-france/).`,
  },
  {
    q: `Les prix varient-ils entre ${prefecture} et le reste du ${deptLabel} ?`,
    a: `Non. Depuis le 15 juin 2026, les prix d'Ozempic (77,60 €), de Wegovy (146,91 – 195,10 €) et de Mounjaro (176,10 – 433,80 €) sont **réglementés par arrêté** : ils sont identiques dans toutes les pharmacies françaises, à ${prefecture} comme dans les plus petites communes du ${deptLabel}. Seul Saxenda reste en prix libre et peut varier d'une officine à l'autre.`,
  },
];

// URL Wikipedia officielle du département (pour signal E-E-A-T)
const wikiUrl = `https://fr.wikipedia.org/wiki/${encodeURIComponent(deptLabel.replace(/'/g, '\''))}_(département)`;
---

<StaticLayout title={title} description={description} keywords={`pharmacie ${deptLabel}, prix Ozempic ${deptLabel}, prix Wegovy ${deptCode}, pharmacie GLP-1 ${deptLabel}, ${prefecture} pharmacies`}>
  <!-- Schema.org : Breadcrumb + FAQ + ItemList -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://glp1-france.fr/" },
          { "@type": "ListItem", "position": 2, "name": "Pharmacies", "item": "https://glp1-france.fr/pharmacies/" },
          { "@type": "ListItem", "position": 3, "name": deptLabel, "item": `https://glp1-france.fr/pharmacies/dept/${deptCode}/` },
        ],
      },
      {
        "@type": "FAQPage",
        "mainEntity": faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
      },
      {
        "@type": "ItemList",
        "name": `Top villes du département ${deptLabel}`,
        "numberOfItems": Math.min(10, topCities.length),
        "itemListElement": topCities.slice(0, 10).map((c: any, i: number) => ({
          "@type": "ListItem",
          "position": i + 1,
          "name": titleCase(c.city),
          "url": `https://glp1-france.fr/pharmacies/${c.slug}/`,
        })),
      },
    ],
  })} />

  <div class="dept-page">
    <!-- Hero -->
    <section class="dept-hero">
      <div class="dept-hero-inner">
        <nav class="breadcrumb">
          <a href="/">Accueil</a> <span>›</span>
          <a href="/pharmacies/">Pharmacies</a> <span>›</span>
          <strong>{deptLabel}</strong>
        </nav>
        <div class="dept-badge">Département {deptCode}{region && ` · ${region}`}</div>
        <h1>Pharmacies GLP-1 en {deptLabel}</h1>
        <p class="dept-sub">
          <strong>{totalPharmas.toLocaleString('fr-FR')} pharmacies</strong> référencées dans {totalCities.toLocaleString('fr-FR')} communes ·
          Chef-lieu : <strong>{prefecture}</strong> · Prix Ozempic, Wegovy et Mounjaro réglementés, identiques partout
        </p>
        <div class="dept-stats-row">
          <div class="dept-stat">
            <div class="dept-stat-num">{totalPharmas.toLocaleString('fr-FR')}</div>
            <div class="dept-stat-lbl">pharmacies</div>
          </div>
          <div class="dept-stat">
            <div class="dept-stat-num">{totalCities.toLocaleString('fr-FR')}</div>
            <div class="dept-stat-lbl">communes</div>
          </div>
          <div class="dept-stat">
            <div class="dept-stat-num">{totalZipcodes}</div>
            <div class="dept-stat-lbl">codes postaux</div>
          </div>
          <div class="dept-stat">
            <div class="dept-stat-num">77,60 €</div>
            <div class="dept-stat-lbl">prix Ozempic officiel</div>
          </div>
        </div>
        <div class="dept-ctas">
          <a href={`/outils/carte-prix-pharmacies/?lat=${centerLat.toFixed(4)}&lng=${centerLng.toFixed(4)}&zoom=9`} class="btn-primary">Voir sur la carte →</a>
          <a href="#villes" class="btn-secondary">Top 10 villes du département</a>
        </div>
      </div>
    </section>

    <!-- Carte interactive du département -->
    <section class="dept-map-section">
      <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
      <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
      <div id="dept-map" class="dept-map" aria-label={`Carte des pharmacies en ${deptLabel}`}></div>
      <script is:inline define:vars={{ pharmaciesData: mapPharmacies, bbox, deptName: deptLabel }}>
        (function () {
          if (typeof maplibregl === 'undefined') return;
          const style = {
            version: 8,
            sources: {
              'tiles': {
                type: 'raster',
                tiles: [
                  'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
                  'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
                ],
                tileSize: 256,
                attribution: '© OpenStreetMap · © CARTO',
              },
            },
            layers: [{ id: 'bg', type: 'raster', source: 'tiles' }],
          };
          const map = new maplibregl.Map({
            container: 'dept-map',
            style,
            bounds: [[bbox[0], bbox[1]], [bbox[2], bbox[3]]],
            fitBoundsOptions: { padding: 35, maxZoom: 11 },
          });
          map.addControl(new maplibregl.NavigationControl(), 'top-right');

          const ready = new Promise((resolve) => {
            let done = false;
            const go = () => { if (done) return; done = true; resolve(); };
            map.on('styledata', () => { if (map.isStyleLoaded()) go(); });
            map.on('load', go);
            setTimeout(go, 6000);
          });

          ready.then(() => {
            const features = pharmaciesData.map((p) => ({
              type: 'Feature',
              geometry: { type: 'Point', coordinates: [Number(p.lng), Number(p.lat)] },
              properties: { name: p.name, postal: p.postal },
            }));
            map.addSource('pharma', {
              type: 'geojson',
              data: { type: 'FeatureCollection', features },
              cluster: true,
              clusterRadius: 50,
              clusterMaxZoom: 13,
            });
            map.addLayer({
              id: 'clusters', type: 'circle', source: 'pharma', filter: ['has', 'point_count'],
              paint: {
                'circle-color': ['step', ['get', 'point_count'], '#93c5fd', 20, '#60a5fa', 100, '#2563eb'],
                'circle-radius': ['step', ['get', 'point_count'], 14, 20, 18, 100, 24],
                'circle-stroke-width': 2, 'circle-stroke-color': '#fff',
              },
            });
            map.addLayer({
              id: 'cluster-count', type: 'symbol', source: 'pharma', filter: ['has', 'point_count'],
              layout: { 'text-field': '{point_count_abbreviated}', 'text-font': ['Noto Sans Regular'], 'text-size': 12 },
              paint: { 'text-color': '#fff' },
            });
            map.addLayer({
              id: 'points', type: 'circle', source: 'pharma', filter: ['!', ['has', 'point_count']],
              paint: { 'circle-color': '#16a34a', 'circle-radius': 5, 'circle-stroke-width': 1.2, 'circle-stroke-color': '#fff' },
            });
            map.on('click', 'points', (e) => {
              const f = e.features[0];
              new maplibregl.Popup({ maxWidth: '280px' })
                .setLngLat(f.geometry.coordinates)
                .setHTML('<strong>' + f.properties.name + '</strong><br><small>' + f.properties.postal + '</small>')
                .addTo(map);
            });
            map.on('mouseenter', 'points', () => { map.getCanvas().style.cursor = 'pointer'; });
            map.on('mouseleave', 'points', () => { map.getCanvas().style.cursor = ''; });
          });
        })();
      </script>
    </section>

    <!-- Top 10 villes du département -->
    <section id="villes" class="dept-cities">
      <div class="dept-section-inner">
        <h2>Top 10 villes du {deptLabel} avec le plus de pharmacies</h2>
        <p class="cities-intro">
          Ces 10 villes représentent la part la plus dense du maillage pharmaceutique du département {deptCode}.
          Chaque page ville liste toutes les pharmacies, les codes postaux et les prix observés.
        </p>
        <div class="cities-grid">
          {topCities.slice(0, 10).map((c: any, i: number) => (
            <a href={`/pharmacies/${c.slug}/`} class="city-card">
              <div class="city-rank">#{i + 1}</div>
              <div class="city-info">
                <div class="city-name">{titleCase(c.city)}</div>
                <div class="city-count">{c.count} pharmacie{c.count > 1 ? 's' : ''}</div>
              </div>
              <div class="city-arrow">→</div>
            </a>
          ))}
        </div>
        {topCities.length > 10 && (
          <details class="cities-more">
            <summary>Voir 10 villes supplémentaires</summary>
            <div class="cities-grid">
              {topCities.slice(10, 20).map((c: any, i: number) => (
                <a href={`/pharmacies/${c.slug}/`} class="city-card">
                  <div class="city-rank">#{i + 11}</div>
                  <div class="city-info">
                    <div class="city-name">{titleCase(c.city)}</div>
                    <div class="city-count">{c.count} pharmacie{c.count > 1 ? 's' : ''}</div>
                  </div>
                  <div class="city-arrow">→</div>
                </a>
              ))}
            </div>
          </details>
        )}
      </div>
    </section>

    <!-- Prix officiels -->
    <section class="dept-prices">
      <div class="dept-section-inner">
        <h2>Prix des traitements GLP-1 en {deptLabel}</h2>
        <p class="prices-intro">
          Depuis le <strong>15 juin 2026</strong>, les prix d'Ozempic, Wegovy et Mounjaro sont <strong>réglementés par arrêté</strong> : ils sont identiques dans toutes les pharmacies du {deptLabel} comme partout en France. Inutile de comparer les officines — la seule question est la disponibilité en stock.
          Données mises à jour {updateMonth}.
        </p>

        <div class="drug-grid">
          <div class="drug-card">
            <div class="drug-head">
              <h3>Ozempic</h3>
