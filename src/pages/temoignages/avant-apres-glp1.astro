---
import StaticLayout from '../../layouts/StaticLayout.astro';

const title = "Avant/Après GLP-1 : 3 Transformations Réelles et Inspirantes";
const description = "Découvrez les transformations authentiques de Marie (-32kg), Laurent (-15kg) et Sophie (-22kg) avec les traitements GLP-1. Photos avant/après, parcours détaillés et conseils pratiques.";

// Données pour le layout - articleContent doit être du HTML string
const articleContent = `<p>${description}</p><p>Suivez les parcours inspirants de trois personnes qui ont transformé leur vie grâce aux traitements GLP-1.</p>`;
const affiliateProducts = [];
const affiliateConfig = { enableAutoInjection: false };
---

<StaticLayout 
  title={title} 
  description={description} 
  articleContent={articleContent} 
  affiliateProducts={affiliateProducts} 
  affiliateConfig={affiliateConfig} 
  image="/images/thumbnails/avant-apres-glp1.svg"
  showAffiliateSidebar={true}
>
  <main class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-green-50">
    
    <!-- Hero Section -->
    <section class="relative py-20 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 to-green-600/10"></div>
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <span class="inline-block px-4 py-2 bg-blue-100 text-blue-700 rounded-full text-sm font-medium mb-6">
            ✨ Témoignages Authentiques 2025
          </span>
          <h1 class="text-4xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-blue-600 to-green-600 bg-clip-text text-transparent">
            Avant/Après GLP-1
          </h1>
          <p class="text-xl text-gray-600 mb-12 leading-relaxed">
            Découvrez les <strong>transformations réelles</strong> de 3 patients qui ont changé leur vie avec les traitements GLP-1. 
            Des parcours authentiques, des résultats mesurés, des conseils pratiques.
          </p>
        </div>
      </div>
    </section>

    <!-- Témoignages Principaux -->
    <section class="py-16">
      <div class="container mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 text-gray-800">
            3 Parcours, 3 Réussites Exceptionnelles
          </h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            Chaque transformation est unique. Découvrez comment Marie, Laurent et Sophie ont surmonté leurs défis 
            avec l'aide des traitements GLP-1 et un accompagnement médical adapté.
          </p>
        </div>

        <!-- Marie L. -->
        <div class="mb-20">
          <div class="bg-gradient-to-r from-pink-500 to-rose-500 rounded-3xl p-8 mb-8 text-white">
            <div class="flex flex-col md:flex-row items-center gap-8">
              <div class="md:w-1/3">
                <div class="bg-white/20 rounded-2xl p-6 text-center">
                  <!-- Photo de Marie -->
                  <div class="mb-6">
                    <img src="/images/temoignages/mariejourney9.jpg" alt="Marie 39 ans transformation GLP-1 32kg 12 mois" 
                         class="w-32 h-32 mx-auto rounded-full object-cover border-4 border-white/50 shadow-lg">
                  </div>
                  <h3 class="text-2xl font-bold mb-2">Marie L.</h3>
                  <p class="text-pink-100 mb-4">39 ans • Lyon • Mère de famille</p>
                  <div class="space-y-2">
                    <div class="bg-white/30 rounded-lg p-3">
                      <div class="text-sm text-pink-100">Avant</div>
                      <div class="text-xl font-bold">94 kg</div>
                    </div>
                    <div class="text-2xl">➡️</div>
                    <div class="bg-white/30 rounded-lg p-3">
                      <div class="text-sm text-pink-100">Après</div>
                      <div class="text-xl font-bold">62 kg</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="md:w-2/3">
                <h4 class="text-2xl font-bold mb-4">🌟 Transformation Exceptionnelle : -32 kg avec Wegovy</h4>
                <blockquote class="text-lg italic mb-6 border-l-4 border-white/50 pl-4">
                  "Après mes deux grossesses, j'avais perdu confiance en moi. Wegovy m'a aidée à retrouver ma santé et ma joie de vivre. 
                  Mes enfants me disent que maman sourit tout le temps maintenant !"
                </blockquote>
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <h5 class="font-semibold mb-2">✅ Défis surmontés :</h5>
                    <ul class="space-y-1 text-sm">
                      <li>• Grignotage émotionnel</li>
                      <li>• Portions trop importantes</li>
                      <li>• Manque de temps pour cuisiner</li>
                    </ul>
                  </div>
                  <div>
                    <h5 class="font-semibold mb-2">🎯 Stratégies gagnantes :</h5>
                    <ul class="space-y-1 text-sm">
                      <li>• Préparation de repas le weekend</li>
                      <li>• Marche quotidienne avec les enfants</li>
                      <li>• Suivi nutritionniste mensuel</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Timeline Marie -->
          <div class="bg-white rounded-2xl shadow-lg p-8">
            <h4 class="text-xl font-bold mb-6 text-center text-gray-800">📅 Évolution de Marie mois par mois</h4>
            <div class="grid md:grid-cols-4 gap-4">
              <div class="text-center p-4 bg-pink-50 rounded-lg">
                <div class="text-2xl font-bold text-pink-600">Mois 1-3</div>
                <div class="text-sm text-gray-600 mt-2">-8kg • Adaptation au traitement</div>
              </div>
              <div class="text-center p-4 bg-pink-100 rounded-lg">
                <div class="text-2xl font-bold text-pink-600">Mois 4-6</div>
                <div class="text-sm text-gray-600 mt-2">-12kg • Nouvelles habitudes</div>
              </div>
              <div class="text-center p-4 bg-pink-200 rounded-lg">
                <div class="text-2xl font-bold text-pink-600">Mois 7-9</div>
                <div class="text-sm text-gray-600 mt-2">-8kg • Plateau temporaire</div>
              </div>
              <div class="text-center p-4 bg-pink-300 rounded-lg">
                <div class="text-2xl font-bold text-pink-600">Mois 10-12</div>
                <div class="text-sm text-gray-600 mt-2">-4kg • Objectif atteint !</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Laurent B. -->
        <div class="mb-20">
          <div class="bg-gradient-to-r from-blue-500 to-cyan-500 rounded-3xl p-8 mb-8 text-white">
            <div class="flex flex-col md:flex-row items-center gap-8">
              <div class="md:w-1/3">
                <div class="bg-white/20 rounded-2xl p-6 text-center">
                  <!-- Photo de Laurent -->
                  <div class="mb-6">
                    <img src="/images/temoignages/Laurent-journey8.jpg" alt="Laurent 35 ans transformation GLP-1 15kg 8 mois" 
                         class="w-32 h-32 mx-auto rounded-full object-cover border-4 border-white/50 shadow-lg">
                  </div>
                  <h3 class="text-2xl font-bold mb-2">Laurent B.</h3>
                  <p class="text-blue-100 mb-4">35 ans • Marseille • Cadre commercial</p>
                  <div class="space-y-2">
                    <div class="bg-white/30 rounded-lg p-3">
                      <div class="text-sm text-blue-100">Avant</div>
                      <div class="text-xl font-bold">89 kg</div>
                    </div>
                    <div class="text-2xl">➡️</div>
                    <div class="bg-white/30 rounded-lg p-3">
                      <div class="text-sm text-blue-100">Après</div>
                      <div class="text-xl font-bold">74 kg</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="md:w-2/3">
                <h4 class="text-2xl font-bold mb-4">🎯 Adieu Ventre Gonflé : -15 kg avec Ozempic</h4>
                <blockquote class="text-lg italic mb-6 border-l-4 border-white/50 pl-4">
                  "J'étais constamment ballonné après les repas. Ozempic a transformé ma digestion et ma silhouette. 
                  Je me sens léger, énergique, et mes costumes me vont à nouveau parfaitement !"
                </blockquote>
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <h5 class="font-semibold mb-2">✅ Problèmes résolus :</h5>
                    <ul class="space-y-1 text-sm">
                      <li>• Ballonnements chroniques</li>
                      <li>• Digestion difficile</li>
                      <li>• Repas d'affaires excessifs</li>
                    </ul>
                  </div>
                  <div>
                    <h5 class="font-semibold mb-2">🎯 Nouvelles habitudes :</h5>
                    <ul class="space-y-1 text-sm">
                      <li>• Portions contrôlées</li>
                      <li>• Sport 3x/semaine</li>
                      <li>• Jeûne intermittent 16h</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Timeline Laurent -->
          <div class="bg-white rounded-2xl shadow-lg p-8">
            <h4 class="text-xl font-bold mb-6 text-center text-gray-800">📅 Progression de Laurent sur 8 mois</h4>
            <div class="grid md:grid-cols-4 gap-4">
              <div class="text-center p-4 bg-blue-50 rounded-lg">
                <div class="text-2xl font-bold text-blue-600">Mois 1-2</div>
                <div class="text-sm text-gray-600 mt-2">-4kg • Fin des ballonnements</div>
              </div>
              <div class="text-center p-4 bg-blue-100 rounded-lg">
                <div class="text-2xl font-bold text-blue-600">Mois 3-4</div>
                <div class="text-sm text-gray-600 mt-2">-6kg • Digestion améliorée</div>
              </div>
              <div class="text-center p-4 bg-blue-200 rounded-lg">
                <div class="text-2xl font-bold text-blue-600">Mois 5-6</div>
                <div class="text-sm text-gray-600 mt-2">-3kg • Masse musculaire</div>
              </div>
              <div class="text-center p-4 bg-blue-300 rounded-lg">
                <div class="text-2xl font-bold text-blue-600">Mois 7-8</div>
                <div class="text-sm text-gray-600 mt-2">-2kg • Stabilisation</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sophie T. -->
        <div class="mb-20">
          <div class="bg-gradient-to-r from-purple-500 to-violet-500 rounded-3xl p-8 mb-8 text-white">
            <div class="flex flex-col md:flex-row items-center gap-8">
              <div class="md:w-1/3">
                <div class="bg-white/20 rounded-2xl p-6 text-center">
                  <!-- Photo de Sophie -->
                  <div class="mb-6">
                    <img src="/images/temoignages/sophie29.jpg" alt="Sophie 29 ans transformation GLP-1 22kg 10 mois" 
                         class="w-32 h-32 mx-auto rounded-full object-cover border-4 border-white/50 shadow-lg">
                  </div>
                  <h3 class="text-2xl font-bold mb-2">Sophie T.</h3>
                  <p class="text-purple-100 mb-4">29 ans • Toulouse • Infirmière</p>
                  <div class="space-y-2">
                    <div class="bg-white/30 rounded-lg p-3">
                      <div class="text-sm text-purple-100">Avant</div>
                      <div class="text-xl font-bold">78 kg</div>
                    </div>
                    <div class="text-2xl">➡️</div>
                    <div class="bg-white/30 rounded-lg p-3">
                      <div class="text-sm text-purple-100">Après</div>
                      <div class="text-xl font-bold">56 kg</div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="md:w-2/3">
                <h4 class="text-2xl font-bold mb-4">💪 Réussite Malgré les Contraintes : -22 kg avec Wegovy</h4>
                <blockquote class="text-lg italic mb-6 border-l-4 border-white/50 pl-4">
                  "Avec mes horaires d'infirmière de nuit, manger équilibré était un défi. Wegovy m'a aidée à réguler mon appétit 
                  et à retrouver un poids santé. Mes collègues n'en reviennent pas !"
                </blockquote>
                <div class="grid md:grid-cols-2 gap-4">
                  <div>
                    <h5 class="font-semibold mb-2">✅ Défis spécifiques :</h5>
                    <ul class="space-y-1 text-sm">
                      <li>• Horaires de nuit décalés</li>
                      <li>• Stress professionnel</li>
                      <li>• Grignotage nocturne</li>
                    </ul>
                  </div>
                  <div>
                    <h5 class="font-semibold mb-2">🎯 Solutions trouvées :</h5>
                    <ul class="space-y-1 text-sm">
                      <li>• Préparation meal-prep</li>
                      <li>• Yoga anti-stress</li>
                      <li>• Planning repas adapté</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Timeline Sophie -->
          <div class="bg-white rounded-2xl shadow-lg p-8">
            <h4 class="text-xl font-bold mb-6 text-center text-gray-800">📅 Transformation de Sophie en 10 mois</h4>
            <div class="grid md:grid-cols-5 gap-3">
              <div class="text-center p-3 bg-purple-50 rounded-lg">
                <div class="text-lg font-bold text-purple-600">Mois 1-2</div>
                <div class="text-xs text-gray-600 mt-1">-5kg • Adaptation</div>
              </div>
              <div class="text-center p-3 bg-purple-100 rounded-lg">
                <div class="text-lg font-bold text-purple-600">Mois 3-4</div>
                <div class="text-xs text-gray-600 mt-1">-6kg • Routine</div>
              </div>
              <div class="text-center p-3 bg-purple-200 rounded-lg">
                <div class="text-lg font-bold text-purple-600">Mois 5-6</div>
                <div class="text-xs text-gray-600 mt-1">-5kg • Constance</div>
              </div>
              <div class="text-center p-3 bg-purple-300 rounded-lg">
                <div class="text-lg font-bold text-purple-600">Mois 7-8</div>
                <div class="text-xs text-gray-600 mt-1">-4kg • Sprint final</div>
              </div>
              <div class="text-center p-3 bg-purple-400 rounded-lg text-white">
                <div class="text-lg font-bold">Mois 9-10</div>
                <div class="text-xs mt-1">-2kg • Maintien</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Analyse Comparative -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">
            📊 Analyse Comparative des Transformations
          </h2>
          
          <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gradient-to-r from-blue-500 to-purple-500 text-white">
                  <tr>
                    <th class="px-6 py-4 text-left">Patient</th>
                    <th class="px-6 py-4 text-center">Traitement</th>
                    <th class="px-6 py-4 text-center">Durée</th>
                    <th class="px-6 py-4 text-center">Perte</th>
                    <th class="px-6 py-4 text-center">% Total</th>
                    <th class="px-6 py-4 text-center">Défi Principal</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  <tr class="hover:bg-pink-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="flex items-center">
                        <div class="w-10 h-10 bg-pink-100 rounded-full flex items-center justify-center mr-3">
                          <span class="text-pink-600 font-bold">M</span>
                        </div>
                        <div>
                          <div class="font-semibold">Marie L.</div>
                          <div class="text-sm text-gray-500">39 ans, Lyon</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="bg-pink-100 text-pink-800 px-3 py-1 rounded-full text-sm font-medium">Wegovy</span>
                    </td>
                    <td class="px-6 py-4 text-center font-semibold">12 mois</td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-2xl font-bold text-pink-600">-32 kg</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-lg font-bold text-green-600">-34%</span>
                    </td>
                    <td class="px-6 py-4 text-center text-sm">Grignotage émotionnel</td>
                  </tr>
                  <tr class="hover:bg-blue-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="flex items-center">
                        <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center mr-3">
                          <span class="text-blue-600 font-bold">L</span>
                        </div>
                        <div>
                          <div class="font-semibold">Laurent B.</div>
                          <div class="text-sm text-gray-500">35 ans, Marseille</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">Ozempic</span>
                    </td>
                    <td class="px-6 py-4 text-center font-semibold">8 mois</td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-2xl font-bold text-blue-600">-15 kg</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-lg font-bold text-green-600">-17%</span>
                    </td>
                    <td class="px-6 py-4 text-center text-sm">Ballonnements</td>
                  </tr>
                  <tr class="hover:bg-purple-50 transition-colors">
                    <td class="px-6 py-4">
                      <div class="flex items-center">
                        <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center mr-3">
                          <span class="text-purple-600 font-bold">S</span>
                        </div>
                        <div>
                          <div class="font-semibold">Sophie T.</div>
                          <div class="text-sm text-gray-500">29 ans, Toulouse</div>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-medium">Wegovy</span>
                    </td>
                    <td class="px-6 py-4 text-center font-semibold">10 mois</td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-2xl font-bold text-purple-600">-22 kg</span>
                    </td>
                    <td class="px-6 py-4 text-center">
                      <span class="text-lg font-bold text-green-600">-28%</span>
                    </td>
                    <td class="px-6 py-4 text-center text-sm">Horaires décalés</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Questions Fréquentes -->
    <section class="py-16">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-800">
            ❓ Questions Fréquentes sur les Transformations
          </h2>
          
          <div class="space-y-6">
            <details class="bg-white rounded-xl shadow-lg overflow-hidden">
              <summary class="px-8 py-6 cursor-pointer font-semibold text-lg hover:bg-gray-50 transition-colors">
                🤔 Combien de temps pour voir les premiers résultats ?
              </summary>
              <div class="px-8 pb-6 text-gray-600">
                <p>D'après nos 3 témoignages, les premiers résultats sont visibles dès les <strong>4-6 premières semaines</strong>. 
                Marie a perdu 8kg en 3 mois, Laurent 4kg en 2 mois, et Sophie 5kg en 2 mois. 
                La perte de poids s'accélère généralement après le 3ème mois avec l'adaptation du corps au traitement.</p>
              </div>
            </details>

            <details class="bg-white rounded-xl shadow-lg overflow-hidden">
              <summary class="px-8 py-6 cursor-pointer font-semibold text-lg hover:bg-gray-50 transition-colors">
                ⚖️ Quelle perte de poids peut-on espérer ?
              </summary>
              <div class="px-8 pb-6 text-gray-600">
                <p>Nos patients ont perdu entre <strong>17% et 34%</strong> de leur poids initial :</p>
                <ul class="list-disc list-inside mt-2 space-y-1">
                  <li>Marie : -34% (94kg → 62kg) en 12 mois</li>
                  <li>Sophie : -28% (78kg → 56kg) en 10 mois</li>
                  <li>Laurent : -17% (89kg → 74kg) en 8 mois</li>
                </ul>
                <p class="mt-2">Les études cliniques montrent une perte moyenne de 15-20% avec Wegovy et 10-15% avec Ozempic.</p>
              </div>
            </details>

            <details class="bg-white rounded-xl shadow-lg overflow-hidden">
              <summary class="px-8 py-6 cursor-pointer font-semibold text-lg hover:bg-gray-50 transition-colors">
                🍽️ Comment adapter son alimentation ?
              </summary>
              <div class="px-8 pb-6 text-gray-600">
                <p>Nos patients ont adopté des stratégies simples et durables :</p>
                <ul class="list-disc list-inside mt-2 space-y-1">
                  <li><strong>Marie :</strong> Préparation de repas le weekend, portions réduites naturellement</li>
                  <li><strong>Laurent :</strong> Jeûne intermittent 16h, fin des ballonnements</li>
                  <li><strong>Sophie :</strong> Meal-prep adapté aux horaires de nuit</li>
                </ul>
                <p class="mt-2">Le traitement GLP-1 réduit naturellement l'appétit, facilitant ces changements alimentaires.</p>
              </div>
            </details>

            <details class="bg-white rounded-xl shadow-lg overflow-hidden">
              <summary class="px-8 py-6 cursor-pointer font-semibold text-lg hover:bg-gray-50 transition-colors">
                💪 Faut-il faire du sport obligatoirement ?
              </summary>
              <div class="px-8 pb-6 text-gray-600">
                <p>Le sport n'est pas obligatoire mais recommandé pour optimiser les résultats :</p>
                <ul class="list-disc list-inside mt-2 space-y-1">
                  <li><strong>Marie :</strong> Marche quotidienne avec les enfants (30 min)</li>
                  <li><strong>Laurent :</strong> Musculation 3x/semaine + tennis</li>
                  <li><strong>Sophie :</strong> Yoga anti-stress + vélo d'appartement</li>
                </ul>
                <p class="mt-2">L'activité physique aide à maintenir la masse musculaire et améliore le bien-être général.</p>
              </div>
            </details>

            <details class="bg-white rounded-xl shadow-lg overflow-hidden">
              <summary class="px-8 py-6 cursor-pointer font-semibold text-lg hover:bg-gray-50 transition-colors">
                👨‍⚕️ Quel suivi médical ont-ils eu ?
              </summary>
              <div class="px-8 pb-6 text-gray-600">
                <p>Nos 3 patients ont bénéficié d'un suivi médical régulier :</p>
                <ul class="list-disc list-inside mt-2 space-y-1">
                  <li><strong>Consultation initiale :</strong> Bilan complet, prescription personnalisée</li>
                  <li><strong>Suivi mensuel :</strong> Adaptation des doses, surveillance des effets</li>
                  <li><strong>Accompagnement nutritionnel :</strong> Diététicienne ou nutritionniste</li>
                  <li><strong>Bilan sanguin :</strong> Contrôle tous les 3 mois</li>
                </ul>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
