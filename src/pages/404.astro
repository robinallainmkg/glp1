---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page non trouvée - GLP1-France.fr";
const description = "La page que vous cherchez n'existe pas. Découvrez nos conseils sur les traitements GLP-1.";
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-br from-red-50 to-orange-100 py-12">
    <div class="container mx-auto px-4 max-w-4xl text-center">

      <!-- 404 Illustration -->
      <div class="mb-12">
        <div class="text-9xl mb-4">😵</div>
        <h1 class="text-6xl font-bold text-gray-800 mb-4">404</h1>
        <h2 class="text-3xl font-semibold text-gray-600 mb-8">Page non trouvée</h2>
        <p class="text-xl text-gray-500 mb-8">
          Désolé, la page que vous cherchez semble avoir disparu ou changé d'adresse.
        </p>
      </div>

      <!-- Suggestions -->
      <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
        <h3 class="text-2xl font-bold text-gray-800 mb-6">Que cherchez-vous ?</h3>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/guides/quel-traitement-glp1-choisir/"
             class="bg-blue-50 hover:bg-blue-100 p-6 rounded-lg transition-all duration-300 transform hover:scale-105">
            <div class="text-3xl mb-3">💊</div>
            <h4 class="font-semibold text-blue-800 mb-2">Choisir un traitement</h4>
            <p class="text-blue-600 text-sm">Guide complet pour choisir votre GLP-1</p>
          </a>

          <a href="/collections/traitements-glp1/"
             class="bg-green-50 hover:bg-green-100 p-6 rounded-lg transition-all duration-300 transform hover:scale-105">
            <div class="text-3xl mb-3">⭐</div>
            <h4 class="font-semibold text-green-800 mb-2">Traitements GLP-1</h4>
            <p class="text-green-600 text-sm">Guides complets des médicaments</p>
          </a>

          <a href="/contact/"
             class="bg-purple-50 hover:bg-purple-100 p-6 rounded-lg transition-all duration-300 transform hover:scale-105">
            <div class="text-3xl mb-3">📧</div>
            <h4 class="font-semibold text-purple-800 mb-2">Nous contacter</h4>
            <p class="text-purple-600 text-sm">Conseils personnalisés</p>
          </a>

          <a href="/legal/mentions-legales/"
             class="bg-yellow-50 hover:bg-yellow-100 p-6 rounded-lg transition-all duration-300 transform hover:scale-105">
            <div class="text-3xl mb-3">📋</div>
            <h4 class="font-semibold text-yellow-800 mb-2">Mentions légales</h4>
            <p class="text-yellow-600 text-sm">Informations légales</p>
          </a>

          <a href="/legal/politique-confidentialite/"
             class="bg-indigo-50 hover:bg-indigo-100 p-6 rounded-lg transition-all duration-300 transform hover:scale-105">
            <div class="text-3xl mb-3">🔒</div>
            <h4 class="font-semibold text-indigo-800 mb-2">Confidentialité</h4>
            <p class="text-indigo-600 text-sm">Protection de vos données</p>
          </a>

          <a href="/"
             class="bg-gray-50 hover:bg-gray-100 p-6 rounded-lg transition-all duration-300 transform hover:scale-105">
            <div class="text-3xl mb-3">🏠</div>
            <h4 class="font-semibold text-gray-800 mb-2">Accueil</h4>
            <p class="text-gray-600 text-sm">Retour à la page d'accueil</p>
          </a>
        </div>
      </div>

      <!-- Bouton principal -->
      <div class="text-center">
        <a href="/"
           class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-semibold text-lg rounded-lg hover:from-blue-600 hover:to-indigo-700 transition-all duration-300 transform hover:scale-105 shadow-lg">
          🏠 Retour à l'accueil
        </a>
      </div>

      <!-- Message d'aide -->
      <div class="mt-12 p-6 bg-blue-50 rounded-lg">
        <p class="text-blue-800">
          <strong>💡 Conseil :</strong> Si vous pensez que cette page devrait exister, contactez-nous pour nous le signaler !
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
