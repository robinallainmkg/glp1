---
// Page 404 améliorée pour GLP1 France
---

<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page non trouvée - GLP1 France</title>
  <meta name="description" content="La page que vous recherchez n'existe pas ou a été déplacée. Découvrez nos guides complets sur les traitements GLP-1 en France.">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="https://glp1-france.fr/">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: #333;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem;
      text-align: center;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      backdrop-filter: blur(10px);
    }

    .error-code {
      font-size: 8rem;
      font-weight: bold;
      color: #667eea;
      margin-bottom: 1rem;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
    }

    h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      color: #333;
    }

    .description {
      font-size: 1.2rem;
      margin-bottom: 2rem;
      color: #666;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .search-section {
      margin: 2rem 0;
      padding: 1.5rem;
      background: #f8f9fa;
      border-radius: 10px;
    }

    .search-input {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid #e9ecef;
      border-radius: 8px;
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .search-input:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      transition: transform 0.2s, box-shadow 0.2s;
      margin: 0.5rem;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
      color: white;
    }

    .btn-secondary {
      background: #6c757d;
    }

    .btn-secondary:hover {
      background: #5a6268;
    }

    .suggestions {
      margin-top: 2rem;
      text-align: left;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .suggestions h3 {
      color: #333;
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    .suggestions ul {
      list-style: none;
      padding: 0;
    }

    .suggestions li {
      margin-bottom: 0.5rem;
      padding: 0.5rem;
      background: #f8f9fa;
      border-radius: 6px;
      border-left: 4px solid #667eea;
    }

    .suggestions a {
      color: #333;
      text-decoration: none;
      font-weight: 500;
    }

    .suggestions a:hover {
      color: #667eea;
    }

    .contact-info {
      margin-top: 2rem;
      padding: 1rem;
      background: #e3f2fd;
      border-radius: 8px;
      font-size: 0.9rem;
      color: #1976d2;
    }

    @media (max-width: 768px) {
      .container {
        margin: 1rem;
        padding: 1.5rem;
      }

      .error-code {
        font-size: 5rem;
      }

      h1 {
        font-size: 2rem;
      }

      .suggestions {
        text-align: center;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="error-code">404</div>
    <h1>Page non trouvée</h1>
    <p class="description">
      Désolé, la page que vous recherchez n'existe pas ou a été déplacée.
      Découvrez nos guides complets sur les traitements GLP-1 en France.
    </p>

    <div class="search-section">
      <input
        type="text"
        class="search-input"
        placeholder="Rechercher un traitement GLP-1..."
        onkeyup="searchContent(this.value)"
      >
      <a href="/" class="btn">Retour à l'accueil</a>
      <a href="/guides/quel-traitement-glp1-choisir/" class="btn">Guide des traitements</a>
    </div>

    <div class="suggestions">
      <h3>🔍 Pages populaires</h3>
      <ul>
        <li><a href="/collections/traitements-glp1/">📋 Tous les traitements GLP-1</a></li>
        <li><a href="/collections/glp1-perte-de-poids/">⚖️ Perte de poids avec GLP-1</a></li>
        <li><a href="/collections/alternatives-glp1/">🌿 Alternatives naturelles</a></li>
        <li><a href="/collections/effets-secondaires-glp1/">⚠️ Effets secondaires</a></li>
        <li><a href="/guides/qu-est-ce-que-glp1/">❓ Qu'est-ce que le GLP-1 ?</a></li>
        <li><a href="/temoignages/">💬 Témoignages patients</a></li>
        <li><a href="/contact/">📞 Nous contacter</a></li>
      </ul>
    </div>

    <div class="contact-info">
      <strong>💡 Conseil :</strong> Si vous pensez que cette page devrait exister,
      <a href="/contact/" style="color: #1976d2; text-decoration: underline;">contactez-nous</a>
      pour nous le signaler.
    </div>
  </div>

  <script>
    function searchContent(query) {
      if (query.length > 2) {
        // Redirection vers la page de recherche ou collection appropriée
        const searchUrls = {
          'ozempic': '/collections/traitements-glp1/',
          'wegovy': '/collections/traitements-glp1/',
          'mounjaro': '/collections/traitements-glp1/',
          'saxenda': '/collections/traitements-glp1/',
          'trulicity': '/collections/traitements-glp1/',
          'victoza': '/collections/traitements-glp1/',
          'rybelsus': '/collections/traitements-glp1/',
          'prix': '/collections/glp1-cout/',
          'coût': '/collections/glp1-cout/',
          'effets': '/collections/effets-secondaires-glp1/',
          'secondaires': '/collections/effets-secondaires-glp1/',
          'alternatives': '/collections/alternatives-glp1/',
          'naturelles': '/collections/alternatives-glp1/',
          'régime': '/collections/regime-glp1/',
          'perte de poids': '/collections/glp1-perte-de-poids/',
          'diabète': '/collections/glp1-diabete/',
          'guide': '/guides/',
          'médecins': '/collections/medecins-glp1-france/',
          'témoin': '/temoignages/',
          'contact': '/contact/'
        };

        for (const [keyword, url] of Object.entries(searchUrls)) {
          if (query.toLowerCase().includes(keyword)) {
            window.location.href = url;
            return;
          }
        }

        // Redirection par défaut vers la page d'accueil
        window.location.href = '/';
      }
    }

    // Animation d'entrée
    document.addEventListener('DOMContentLoaded', function() {
      const container = document.querySelector('.container');
      container.style.opacity = '0';
      container.style.transform = 'translateY(20px)';

      setTimeout(() => {
        container.style.transition = 'all 0.6s ease';
        container.style.opacity = '1';
        container.style.transform = 'translateY(0)';
      }, 100);
    });
  </script>
</body>
</html>
