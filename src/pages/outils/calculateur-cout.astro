---
import StaticLayout from '../../layouts/StaticLayout.astro';
---

<StaticLayout 
  title="Calculateur Coût GLP-1 : Budget Traitement 2026"
  description="Calculez le coût réel de votre traitement GLP-1 (Ozempic, Wegovy, Mounjaro) avec remboursement. Estimation précise du budget mensuel et annuel."
  keywords="calculateur coût glp1, prix ozempic, budget wegovy, coût traitement"
>
  <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-50 py-12">
    <div class="container mx-auto px-4 max-w-4xl">
      
      <!-- En-tête -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          💰 Calculateur de Coût GLP-1
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Estimez le coût réel de votre traitement avec remboursement Sécu et mutuelle
        </p>
      </div>

      <!-- Calculateur -->
      <h2 class="sr-only">Paramètres du calcul</h2>
      <div class="bg-white rounded-2xl shadow-2xl p-8 mb-8">
        
        <form id="costCalculator" class="space-y-6">
          
          <!-- Choix du traitement -->
          <div>
            <label class="block text-lg font-semibold text-gray-900 mb-3">
              1️⃣ Quel traitement GLP-1 ?
            </label>
            <div class="grid md:grid-cols-3 gap-4">
              <label class="treatment-option">
                <input type="radio" name="treatment" value="wegovy" checked class="sr-only">
                <div class="option-card">
                  <div class="text-3xl mb-2">💊</div>
                  <h3 class="font-bold text-gray-900">Wegovy</h3>
                  <p class="text-sm text-gray-600">272€/mois</p>
                  <p class="text-xs text-green-600">Perte de poids</p>
                </div>
              </label>
              
              <label class="treatment-option">
                <input type="radio" name="treatment" value="ozempic" class="sr-only">
                <div class="option-card">
                  <div class="text-3xl mb-2">💉</div>
                  <h3 class="font-bold text-gray-900">Ozempic</h3>
                  <p class="text-sm text-gray-600">85€/mois</p>
                  <p class="text-xs text-blue-600">Diabète type 2</p>
                </div>
              </label>
              
              <label class="treatment-option">
                <input type="radio" name="treatment" value="mounjaro" class="sr-only">
                <div class="option-card">
                  <div class="text-3xl mb-2">🔬</div>
                  <h3 class="font-bold text-gray-900">Mounjaro</h3>
                  <p class="text-sm text-gray-600">285€/mois</p>
                  <p class="text-xs text-purple-600">Nouvelle génération</p>
                </div>
              </label>
            </div>
          </div>

          <!-- Durée du traitement -->
          <div>
            <label class="block text-lg font-semibold text-gray-900 mb-3">
              2️⃣ Durée du traitement ?
            </label>
            <div class="flex items-center gap-4">
              <input 
                type="range" 
                id="duration" 
                name="duration" 
                min="1" 
                max="24" 
                value="6" 
                class="flex-1 h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                oninput="updateDuration(this.value)"
              >
              <div class="w-24 text-center">
                <span id="durationDisplay" class="text-2xl font-bold text-blue-600">6</span>
                <span class="text-gray-600 text-sm ml-1">mois</span>
              </div>
            </div>
            <div class="flex justify-between text-sm text-gray-500 mt-2">
              <span>1 mois</span>
              <span>6 mois</span>
              <span>12 mois</span>
              <span>24 mois</span>
            </div>
          </div>

          <!-- Remboursement Sécu -->
          <div>
            <label class="block text-lg font-semibold text-gray-900 mb-3">
              3️⃣ Remboursement Sécurité Sociale ?
            </label>
            <div class="grid md:grid-cols-2 gap-4">
              <label class="option-label">
                <input type="radio" name="secu" value="65" class="mr-2">
                <span>✅ Oui, 65% (diabète type 2)</span>
              </label>
              <label class="option-label">
                <input type="radio" name="secu" value="0" checked class="mr-2">
                <span>❌ Non, hors AMM</span>
              </label>
            </div>
          </div>

          <!-- Remboursement Mutuelle -->
          <div>
            <label class="block text-lg font-semibold text-gray-900 mb-3">
              4️⃣ Remboursement Mutuelle ?
            </label>
            <div class="flex items-center gap-4">
              <input 
                type="range" 
                id="mutuelle" 
                name="mutuelle" 
                min="0" 
                max="100" 
                value="0" 
                step="10"
                class="flex-1 h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
                oninput="updateMutuelle(this.value)"
              >
              <div class="w-24 text-center">
                <span id="mutuelleDisplay" class="text-2xl font-bold text-green-600">0</span>
                <span class="text-gray-600 text-sm ml-1">%</span>
              </div>
            </div>
            <p class="text-sm text-gray-500 mt-2">
              💡 Vérifiez votre contrat de mutuelle pour le taux exact
            </p>
          </div>

          <!-- Bouton de calcul -->
          <button 
            type="button"
            onclick="calculateCost()"
            class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold py-4 rounded-xl hover:from-blue-700 hover:to-indigo-700 transform hover:scale-105 transition-all duration-200 shadow-lg"
          >
            🧮 Calculer mon Budget
          </button>
        </form>
      </div>

      <!-- Résultats -->
      <div id="results" class="hidden">
        <div class="bg-white rounded-2xl shadow-2xl p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
            📊 Résultat de votre Estimation
          </h2>

          <div class="grid md:grid-cols-3 gap-6 mb-8">
            <!-- Coût total -->
            <div class="text-center p-6 bg-gray-50 rounded-xl">
              <div class="text-sm text-gray-600 mb-2">Coût Total</div>
              <div id="totalCost" class="text-4xl font-bold text-gray-900 mb-1">-</div>
              <div class="text-xs text-gray-500">Sans remboursement</div>
            </div>

            <!-- Remboursement -->
            <div class="text-center p-6 bg-green-50 rounded-xl">
              <div class="text-sm text-gray-600 mb-2">Remboursé</div>
              <div id="reimbursement" class="text-4xl font-bold text-green-600 mb-1">-</div>
              <div class="text-xs text-gray-500">Sécu + Mutuelle</div>
            </div>

            <!-- Reste à charge -->
            <div class="text-center p-6 bg-blue-50 rounded-xl">
              <div class="text-sm text-gray-600 mb-2">Reste à Payer</div>
              <div id="finalCost" class="text-4xl font-bold text-blue-600 mb-1">-</div>
              <div class="text-xs text-gray-500">Par mois : <span id="monthlyCost">-</span></div>
            </div>
          </div>

          <!-- Détails -->
          <div id="breakdown" class="bg-indigo-50 rounded-xl p-6">
            <h3 class="font-bold text-gray-900 mb-4">📋 Détail du Calcul</h3>
            <div class="space-y-2 text-sm" id="breakdownDetails">
              <!-- Rempli dynamiquement -->
            </div>
          </div>

          <!-- CTA -->
          <div class="mt-8 text-center">
            <a href="/collections/glp1-cout/" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-green-600 to-green-700 text-white font-bold rounded-xl hover:from-green-700 hover:to-green-800 transition-all">
              💰 Voir les Prix Détaillés par Traitement
            </a>
          </div>
        </div>

        <!-- Conseils -->
        <div class="bg-white rounded-2xl shadow-xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">💡 Conseils pour Réduire vos Coûts</h3>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <span class="text-2xl">✅</span>
              <div>
                <h3 class="font-semibold text-gray-900">Vérifiez votre éligibilité au remboursement</h3>
                <p class="text-gray-600 text-sm">Si vous avez un diabète type 2 + IMC > 30, Ozempic peut être remboursé à 65%</p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <span class="text-2xl">💊</span>
              <div>
                <h3 class="font-semibold text-gray-900">Demandez une prescription longue durée</h3>
                <p class="text-gray-600 text-sm">Certains médecins peuvent prescrire pour 3-6 mois, réduisant les frais de consultation</p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <span class="text-2xl">🏥</span>
              <div>
                <h3 class="font-semibold text-gray-900">Comparez les mutuelles</h3>
                <p class="text-gray-600 text-sm">Certaines mutuelles remboursent jusqu'à 100% du ticket modérateur</p>
                <a href="/collections/glp1-cout/wegovy-remboursement-mutuelle" class="text-blue-600 hover:underline text-sm">
                  → Guide des mutuelles qui remboursent
                </a>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <span class="text-2xl">🔍</span>
              <div>
                <h3 class="font-semibold text-gray-900">Trouvez un médecin près de chez vous</h3>
                <p class="text-gray-600 text-sm">Consultez notre annuaire de médecins qui prescrivent le GLP-1</p>
                <a href="/annuaire/" class="text-blue-600 hover:underline text-sm">
                  → Rechercher un médecin
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Info box -->
      <div class="mt-8 bg-yellow-50 border border-yellow-200 rounded-xl p-6">
        <div class="flex items-start gap-3">
          <span class="text-2xl">⚠️</span>
          <div>
            <h3 class="font-bold text-gray-900 mb-2">Information Importante</h3>
            <p class="text-gray-700 text-sm">
              Cette estimation est indicative et peut varier selon votre situation personnelle, votre contrat de mutuelle et les évolutions de prix. 
              Consultez toujours votre médecin et votre mutuelle pour une estimation précise.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <style>
    .treatment-option input:checked ~ .option-card {
      border: 3px solid #2563eb;
      background: #eff6ff;
    }

    .option-card {
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      padding: 1.5rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    .option-card:hover {
      border-color: #93c5fd;
      background: #f0f9ff;
    }

    .option-label {
      display: flex;
      align-items: center;
      padding: 1rem;
      border: 2px solid #e5e7eb;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .option-label:hover {
      border-color: #93c5fd;
      background: #f0f9ff;
    }

    input[type="range"] {
      accent-color: #2563eb;
    }
  </style>

  <script>
    const treatments = {
      wegovy: { name: 'Wegovy', price: 272, info: 'Perte de poids (semaglutide 2.4mg)' },
      ozempic: { name: 'Ozempic', price: 85, info: 'Diabète type 2 (semaglutide 1mg)' },
      mounjaro: { name: 'Mounjaro', price: 285, info: 'Nouvelle génération (tirzepatide)' }
    };

    function updateDuration(value) {
      document.getElementById('durationDisplay').textContent = value;
    }

    function updateMutuelle(value) {
      document.getElementById('mutuelleDisplay').textContent = value;
    }

    function calculateCost() {
      // Récupérer les valeurs
      const treatment = document.querySelector('input[name="treatment"]:checked').value;
      const duration = parseInt(document.getElementById('duration').value);
      const secuPercent = parseInt(document.querySelector('input[name="secu"]:checked').value);
      const mutuellePercent = parseInt(document.getElementById('mutuelle').value);

      // Calculs
      const monthlyPrice = treatments[treatment].price;
      const totalCost = monthlyPrice * duration;
      
      // Remboursement Sécu (sur le prix de base)
      const secuReimbursement = (monthlyPrice * secuPercent / 100) * duration;
      
      // Remboursement Mutuelle (sur le reste à charge après Sécu)
      const afterSecu = totalCost - secuReimbursement;
      const mutuelleReimbursement = (afterSecu * mutuellePercent / 100);
      
      const totalReimbursement = secuReimbursement + mutuelleReimbursement;
      const finalCost = totalCost - totalReimbursement;
      const monthlyCost = finalCost / duration;

      // Afficher les résultats
      document.getElementById('totalCost').textContent = `${totalCost.toFixed(0)}€`;
      document.getElementById('reimbursement').textContent = `${totalReimbursement.toFixed(0)}€`;
      document.getElementById('finalCost').textContent = `${finalCost.toFixed(0)}€`;
      document.getElementById('monthlyCost').textContent = `${monthlyCost.toFixed(0)}€`;

      // Détails
      const breakdown = `
        <div class="flex justify-between">
          <span>💊 Traitement choisi :</span>
          <span class="font-semibold">${treatments[treatment].name}</span>
        </div>
        <div class="flex justify-between">
          <span>📅 Durée :</span>
          <span class="font-semibold">${duration} mois</span>
        </div>
        <div class="flex justify-between">
          <span>💰 Prix mensuel :</span>
          <span class="font-semibold">${monthlyPrice}€</span>
        </div>
        <div class="flex justify-between">
          <span>💵 Coût total :</span>
          <span class="font-semibold">${totalCost}€</span>
        </div>
        <hr class="my-2">
        <div class="flex justify-between text-green-700">
          <span>🏥 Remboursement Sécu (${secuPercent}%) :</span>
          <span class="font-semibold">-${secuReimbursement.toFixed(0)}€</span>
        </div>
        <div class="flex justify-between text-green-700">
          <span>🛡️ Remboursement Mutuelle (${mutuellePercent}%) :</span>
          <span class="font-semibold">-${mutuelleReimbursement.toFixed(0)}€</span>
        </div>
        <hr class="my-2">
        <div class="flex justify-between text-blue-700 text-lg">
          <span class="font-bold">💳 Reste à votre charge :</span>
          <span class="font-bold">${finalCost.toFixed(0)}€</span>
        </div>
        <div class="text-right text-sm text-gray-600 mt-1">
          Soit ${monthlyCost.toFixed(0)}€/mois
        </div>
      `;

      document.getElementById('breakdownDetails').innerHTML = breakdown;
      document.getElementById('results').classList.remove('hidden');
      
      // Scroll vers les résultats
      document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'start' });

      // Track analytics
      if (typeof gtag !== 'undefined') {
        gtag('event', 'calculator_used', {
          'treatment': treatment,
          'duration': duration,
          'final_cost': finalCost.toFixed(0)
        });
      }
    }

    // Écouteurs pour les options de traitement
    document.querySelectorAll('input[name="treatment"]').forEach(input => {
      input.addEventListener('change', () => {
        document.querySelectorAll('.option-card').forEach(card => {
          card.style.borderColor = '#e5e7eb';
          card.style.background = 'white';
        });
        input.parentElement.querySelector('.option-card').style.borderColor = '#2563eb';
        input.parentElement.querySelector('.option-card').style.background = '#eff6ff';
      });
    });
  </script>
</StaticLayout>
