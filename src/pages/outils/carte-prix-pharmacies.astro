---
import StaticLayout from '../../layouts/StaticLayout.astro';
import { supabaseConfig } from '../../lib/supabase';
import fs from 'node:fs';
import path from 'node:path';

// Stats
let stats = { pharmacies: 0, prices: 0, by_drug: {}, updated_at: null };
try {
  const statsPath = path.resolve(process.cwd(), 'public/data/pharmacy-stats.json');
  if (fs.existsSync(statsPath)) {
    stats = JSON.parse(fs.readFileSync(statsPath, 'utf-8'));
  }
} catch {}

// Pharmacies pour générer les liens villes + départements
let pharmaciesData = { schema: [], rows: [] };
try {
  const dataPath = path.resolve(process.cwd(), 'public/data/pharmacies.json');
  pharmaciesData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
} catch {}

const iCity = pharmaciesData.schema.indexOf('city');
const iSlug = pharmaciesData.schema.indexOf('city_slug');
const iDept = pharmaciesData.schema.indexOf('department');

// Top cities
const cityMap = {};
const deptMap = {};
for (const row of pharmaciesData.rows) {
  const slug = row[iSlug];
  const city = row[iCity];
  const dept = row[iDept];
  if (slug && !cityMap[slug]) cityMap[slug] = { slug, city, dept, count: 0 };
  if (slug) cityMap[slug].count += 1;
  if (dept) deptMap[dept] = (deptMap[dept] || 0) + 1;
}
const topCities = Object.values(cityMap).sort((a, b) => b.count - a.count).slice(0, 100);
const topDepartments = Object.entries(deptMap).sort((a, b) => b[1] - a[1]).slice(0, 30);

// Noms officiels département (top 30 suffit)
const DEPT_NAMES = {
  '75': 'Paris', '13': 'Bouches-du-Rhône', '69': 'Rhône', '31': 'Haute-Garonne',
  '06': 'Alpes-Maritimes', '33': 'Gironde', '34': 'Hérault', '44': 'Loire-Atlantique',
  '67': 'Bas-Rhin', '59': 'Nord', '83': 'Var', '51': 'Marne', '38': 'Isère',
  '35': 'Ille-et-Vilaine', '87': 'Haute-Vienne', '30': 'Gard', '63': 'Puy-de-Dôme',
  '66': 'Pyrénées-Orientales', '21': 'Côte-d\'Or', '37': 'Indre-et-Loire',
  '42': 'Loire', '80': 'Somme', '76': 'Seine-Maritime', '974': 'La Réunion',
  '49': 'Maine-et-Loire', '54': 'Meurthe-et-Moselle', '74': 'Haute-Savoie',
  '25': 'Doubs', '72': 'Sarthe', '57': 'Moselle', '92': 'Hauts-de-Seine',
  '78': 'Yvelines', '77': 'Seine-et-Marne', '93': 'Seine-Saint-Denis',
  '94': 'Val-de-Marne', '91': 'Essonne', '95': 'Val-d\'Oise',
};

function titleCase(s) {
  return (s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}

const fmtNum = (n) => new Intl.NumberFormat('fr-FR').format(n);
const updatedFr = stats.updated_at
  ? new Date(stats.updated_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' })
  : '—';
---

<StaticLayout
  title="Carte des prix Ozempic, Wegovy, Mounjaro, Saxenda en pharmacie France"
  description="Carte interactive des prix GLP-1 en pharmacie : Ozempic, Wegovy, Mounjaro, Saxenda. Données officielles + contributions patients. Trouvez la pharmacie la moins chère près de chez vous."
  keywords="prix Ozempic pharmacie, prix Wegovy pharmacie, prix Mounjaro pharmacie, carte pharmacie GLP-1"
>
  <!-- MapLibre GL JS depuis CDN (zéro dépendance npm, gratuit, open source) -->
  <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>

  <div class="map-page">
    <!-- Hero compact -->
    <section class="map-hero">
      <div class="map-hero-inner">
        <h1>Carte GLP-1 France&nbsp;: pharmacies, endocrinologues, CSO</h1>
        <p class="map-hero-sub">
          <strong>{fmtNum(stats.pharmacies)}</strong> pharmacies · <strong>{fmtNum((stats as any).endocrinologues || 2204)}</strong> endocrinologues · <strong>{(stats as any).cso || 40}</strong> CSO · Mis à jour le {updatedFr}
        </p>

        <!-- Toggle layer : pharmacies / endocrino / CSO -->
        <div class="layer-toggle" role="tablist" aria-label="Type de professionnel">
          <button type="button" class="layer-pill active" data-layer="pharmacies">
            <span class="layer-dot" style="background:#16a34a;"></span>
            Pharmacies
          </button>
          <button type="button" class="layer-pill" data-layer="endocrinologues">
            <span class="layer-dot" style="background:#7c3aed;"></span>
            Endocrinologues
          </button>
          <button type="button" class="layer-pill" data-layer="cso">
            <span class="layer-dot" style="background:#dc2626;"></span>
            Centres obésité (CSO)
          </button>
        </div>

        <!-- Filtre drug (visible uniquement pour layer=pharmacies) -->
        <div class="drug-filter" id="drug-filter" role="tablist" aria-label="Filtrer par traitement">
          <button type="button" class="drug-pill active" data-drug="all">Tous</button>
          <button type="button" class="drug-pill" data-drug="ozempic">Ozempic</button>
          <button type="button" class="drug-pill" data-drug="wegovy">Wegovy</button>
          <button type="button" class="drug-pill" data-drug="mounjaro">Mounjaro</button>
          <button type="button" class="drug-pill" data-drug="saxenda">Saxenda</button>
        </div>
      </div>
    </section>

    <!-- Carte -->
    <div id="map-wrap">
      <div id="map" role="region" aria-label="Carte des pharmacies"></div>
      <div id="map-loading" class="map-loading">Chargement de la carte…</div>
    </div>

    <!-- CTA éligibilité (plan K1, go Robin 06/08/2026) -->
    <section style="background:#f0fdf4;border-top:1px solid #dcfce7;border-bottom:1px solid #dcfce7;padding:28px 16px;">
      <div style="max-width:960px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;">
        <div style="flex:1 1 480px;">
          <h2 style="margin:0 0 6px;color:#1a3c34;font-size:1.25rem;">Les prix sont identiques partout — votre reste à charge, non</h2>
          <p style="margin:0;color:#374151;">Wegovy et Mounjaro sont remboursés à 65&nbsp;% depuis juin 2026, sous conditions (IMC, comorbidités, suivi). La vraie question n'est pas où acheter, mais si vous êtes éligible.</p>
        </div>
        <a href="/outils/test-eligibilite/" style="display:inline-block;background:#16a34a;color:#fff;padding:12px 22px;border-radius:8px;text-decoration:none;font-weight:600;white-space:nowrap;">Vérifier mon éligibilité → 2 min</a>
      </div>
    </section>

    <!-- Contrib CTA -->
    <section class="contrib-banner">
      <div class="contrib-inner">
        <div>
          <h2>Vous avez vu un prix en pharmacie&nbsp;?</h2>
          <p>Partagez-le pour aider la communauté. Anonyme, 30&nbsp;secondes.</p>
        </div>
        <button type="button" class="contrib-btn" id="open-submit">Partager un prix →</button>
      </div>
    </section>

    <!-- Liens SEO : villes + départements -->
    <section class="map-links">
      <div class="map-links-inner">
        <div class="links-col">
          <h2>Pharmacies par ville</h2>
          <p class="links-intro">Les 100 plus grandes villes françaises référencées. Cliquez pour voir toutes les pharmacies + prix estimés GLP-1.</p>
          <div class="city-grid">
            {topCities.map((c) => (
              <a href={`/pharmacies/${c.slug}/`} class="city-link">
                {titleCase(c.city)}
                <span class="city-link-count">{c.count}</span>
              </a>
            ))}
          </div>
          <p style="margin-top:1rem;font-size:.85rem;"><a href="/pharmacies/" style="color:#1B6FA0;font-weight:600;">Voir toutes les villes →</a></p>
        </div>

        <div class="links-col">
          <h2>Par département</h2>
          <p class="links-intro">Les 30 départements avec le plus de pharmacies.</p>
          <div class="dept-list">
            {topDepartments.map(([dept, count]) => (
              <div class="dept-item">
                <span class="dept-num">{dept}</span>
                <span class="dept-name">{DEPT_NAMES[dept] || 'France'}</span>
                <span class="dept-count">{count}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="links-col">
          <h2>Pages associées</h2>
          <ul class="related-list">
            <li><a href="/pharmacies/">Annuaire pharmacies par ville</a></li>
            <li><a href="/collections/glp1-cout/">Tous les prix GLP-1 en France</a></li>
            <li><a href="/collections/glp1-cout/prix-ozempic-france/">Prix Ozempic France</a></li>
            <li><a href="/collections/glp1-cout/prix-wegovy-france/">Prix Wegovy France</a></li>
            <li><a href="/collections/glp1-cout/prix-mounjaro-france/">Prix Mounjaro France</a></li>
            <li><a href="/collections/glp1-cout/wegovy-remboursement-mutuelle/">Remboursement Wegovy / mutuelles</a></li>
            <li><a href="/collections/medecins-glp1-france/">Trouver un médecin prescripteur</a></li>
            <li><a href="/collections/effets-secondaires-glp1/">Effets secondaires GLP-1</a></li>
            <li><a href="/guides/quel-traitement-glp1-choisir/">Quel traitement GLP-1 choisir ?</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="map-disclaimer">
      <p>
        <strong>Source&nbsp;:</strong> Référentiel FINESS (data.gouv.fr / Atlasanté — mis à jour bimensuel) · Prix Ozempic (77,60&nbsp;€, remboursé 30&nbsp;% diabète type 2, 100&nbsp;% en ALD), Wegovy (146,91–195,10&nbsp;€) et Mounjaro (176,10–433,80&nbsp;€) <strong>réglementés</strong> depuis le 15 juin 2026 (remboursés 65&nbsp;% dans l'obésité sous conditions) — identiques dans toutes les pharmacies · Saxenda = prix libre, non remboursé.
        Cette page est informative et ne remplace pas un avis médical.
      </p>
    </section>
  </div>

  <!-- Drawer pharmacie : remplace les popups MapLibre (mauvaise UX / clipping) -->
  <div id="pharmacy-drawer" class="pharmacy-drawer" hidden aria-hidden="true">
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <aside class="drawer-panel" role="dialog" aria-labelledby="drawer-title">
      <button type="button" class="drawer-close" id="drawer-close" aria-label="Fermer">×</button>
      <div class="drawer-head">
        <h3 id="drawer-title" class="drawer-name"></h3>
        <div class="drawer-city"></div>
      </div>
      <div class="drawer-body" id="drawer-body"></div>
      <div class="drawer-footer">
        <div class="drawer-legend">
          <span class="pop-src-off">Officiel</span> prix réglementé, identique dans toutes les pharmacies
        </div>
        <button type="button" class="drawer-cta" id="drawer-submit-btn">Vous avez vu un prix ici ? Partagez-le</button>
      </div>
    </aside>
  </div>

  <!-- Modal soumission -->
  <div id="submit-modal" class="submit-modal" hidden aria-hidden="true">
    <div class="submit-modal-inner" role="dialog" aria-labelledby="submit-title">
      <button type="button" class="modal-close" id="close-submit" aria-label="Fermer">×</button>
      <h3 id="submit-title">Partager un prix</h3>
      <p class="submit-help">Vous avez vu un prix en pharmacie&nbsp;? Partagez-le pour aider la communauté.<br>Votre soumission sera vérifiée avant affichage.</p>

      <form id="submit-form">
        <!-- Pharmacie : champ autocomplete (ou lecture seule si préfilled) -->
        <div class="form-row">
          <label for="f-pharmacy">Pharmacie</label>
          <input type="text" id="f-pharmacy" autocomplete="off" placeholder="Nom ou ville de la pharmacie…" required>
          <input type="hidden" id="f-pharmacy-id" name="pharmacy_id" required>
          <div id="f-pharmacy-results" class="autocomplete-results" hidden></div>
          <div id="f-pharmacy-selected" class="pharmacy-selected" hidden>
            <span class="ps-name"></span>
            <span class="ps-city"></span>
            <button type="button" class="ps-change" id="f-pharmacy-change">Changer</button>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <label for="f-drug">Médicament</label>
            <select id="f-drug" required>
              <option value="">Choisir…</option>
              <option value="ozempic">Ozempic</option>
              <option value="wegovy">Wegovy</option>
              <option value="mounjaro">Mounjaro</option>
              <option value="saxenda">Saxenda</option>
            </select>
          </div>
          <div class="form-row">
            <label for="f-dose">Dose <span class="optional">(optionnel)</span></label>
            <input type="text" id="f-dose" placeholder="ex. 1 mg, 2,5 mg" maxlength="16">
          </div>
        </div>

        <div class="form-row">
          <label for="f-price">Prix en euros</label>
          <input type="number" id="f-price" min="1" max="1000" step="0.01" placeholder="ex. 285,50" required>
        </div>

        <div class="form-row">
          <label for="f-notes">Remarque <span class="optional">(optionnel)</span></label>
          <textarea id="f-notes" rows="2" maxlength="200" placeholder="ex. Prix vu le 12 avril, pharmacie habituelle…"></textarea>
        </div>

        <div class="form-row form-row-check">
          <label>
            <input type="checkbox" id="f-confirm" required>
            Je confirme avoir vu ce prix en pharmacie (toute fausse déclaration sera supprimée).
          </label>
        </div>

        <div id="f-error" class="form-error" hidden></div>
        <div id="f-success" class="form-success" hidden>
          Merci&nbsp;! Votre prix a été soumis. Il sera affiché après vérification.
        </div>

        <button type="submit" class="submit-btn" id="f-submit">Envoyer</button>
      </form>
    </div>
  </div>

  <script define:vars={{ SB_URL: supabaseConfig.url, SB_KEY: supabaseConfig.anonKey }}>
  // ═══════════════════════════════════════════════════════════════
  // MAP LOGIC — MapLibre GL + clustering natif sur 20k+ markers
  // ═══════════════════════════════════════════════════════════════
  (async function() {
    'use strict';

    const DRUG_COLORS = {
      ozempic: '#16a34a',  // vert (remboursé)
      wegovy: '#f59e0b',   // orange
      mounjaro: '#3b82f6', // bleu
      saxenda: '#a855f7',  // violet
    };
    const DRUG_LABELS = {
      ozempic: 'Ozempic',
      wegovy: 'Wegovy',
      mounjaro: 'Mounjaro',
      saxenda: 'Saxenda',
    };

    // Prix officiels réglementés depuis le 15/06/2026 (arrêtés JO du 28/05/2026) —
    // identiques dans toutes les pharmacies françaises. Sources : BDPM, Vidal, Légifrance.
    // Saxenda reste en prix libre : aucun prix affiché (zéro estimation).
    const DRUG_REF = {
      ozempic: {
        note: 'Remboursé 30% (diabète type 2) · 100% en ALD · prix officiel identique France entière',
        fixed: true,
        doses: [
          { dose: '0,25 mg', price: 77.60 },
          { dose: '0,5 mg', price: 77.60 },
          { dose: '1 mg', price: 77.60 },
        ],
      },
      wegovy: {
        note: 'Remboursé 65% depuis le 15/06/2026 (obésité, sous conditions) · prix réglementé identique partout',
        fixed: true,
        doses: [
          { dose: '0,25 mg', price: 146.91 },
          { dose: '0,5 mg', price: 146.91 },
          { dose: '1 mg', price: 146.91 },
          { dose: '1,7 mg', price: 169.31 },
          { dose: '2,4 mg', price: 195.10 },
        ],
      },
      mounjaro: {
        note: 'Remboursé 65% depuis le 15/06/2026 (obésité, sous conditions) · prix réglementé identique partout',
        fixed: true,
        doses: [
          { dose: '2,5 mg', price: 176.10 },
          { dose: '5 mg', price: 237.68 },
          { dose: '7,5 mg', price: 335.95 },
          { dose: '10 mg', price: 335.95 },
          { dose: '12,5 mg', price: 433.80 },
          { dose: '15 mg', price: 433.80 },
        ],
      },
      saxenda: {
        note: 'Prix libre · non remboursé · demandez le tarif à la pharmacie',
        fixed: true,
        doses: [],
      },
    };

    let currentDrug = 'all';
    let currentLayer = 'pharmacies';
    let pharmacies = null;
    let pharmaciesSchema = null;
    let latestPrices = null;
    let endocrinologues = null;
    let endoSchema = null;
    let csos = null;

    const LAYER_COLORS = {
      pharmacies: '#16a34a',
      endocrinologues: '#7c3aed',
      cso: '#dc2626',
    };

    // Tiles gratuits : Carto Voyager (style neutre lisible)
    const style = {
      version: 8,
      sources: {
        'raster-tiles': {
          type: 'raster',
          tiles: [
            'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
            'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
            'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
          ],
          tileSize: 256,
          attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · © <a href="https://carto.com/attributions">CARTO</a>',
        },
      },
      layers: [{ id: 'raster', type: 'raster', source: 'raster-tiles' }],
    };

    // ── 1) Fetch data first (modal et autocomplete en dépendent) ──
    try {
      const [phResp, prResp] = await Promise.all([
        fetch('/data/pharmacies.json').then((r) => r.json()),
        fetch('/data/latest-prices.json').then((r) => r.json()),
      ]);
      pharmaciesSchema = phResp.schema;
      pharmacies = phResp.rows;
      latestPrices = prResp;
    } catch (err) {
      document.getElementById('map-loading').textContent = 'Erreur de chargement des données.';
      console.error('[map] data error:', err);
      return;
    }

    const idxId = pharmaciesSchema.indexOf('id');
    const idxFiness = pharmaciesSchema.indexOf('finess');
    const idxName = pharmaciesSchema.indexOf('name');
    const idxCity = pharmaciesSchema.indexOf('city');
    const idxCitySlug = pharmaciesSchema.indexOf('city_slug');
    const idxCP = pharmaciesSchema.indexOf('postal_code');
    const idxDept = pharmaciesSchema.indexOf('department');
    const idxLat = pharmaciesSchema.indexOf('lat');
    const idxLng = pharmaciesSchema.indexOf('lng');

    // Câble le modal immédiatement (indépendant de la map)
    setupSubmissionModal();
    // Câble le filtre drug — on n'a pas encore la map ni la source, mais le click
    // mettra à jour currentDrug et, si la map est prête, fera aussi setData + fitBounds.
    setupDrugFilter();
    // Layer toggle : switch entre Pharmacies / Endocrinologues / CSO
    setupLayerToggle();

    // ── 2) Créer la map ── (si les tiles sont bloquées, la map ne rendra rien
    // visuellement, mais le reste de la page — filtres, modal, CTA — fonctionne)
    // eslint-disable-next-line no-var
    var map = new maplibregl.Map({
      container: 'map',
      style,
      center: [2.4, 46.5],
      zoom: 5.2,
      minZoom: 4,
      maxZoom: 18,
    });
    map.addControl(new maplibregl.NavigationControl(), 'top-right');
    map.addControl(new maplibregl.GeolocateControl({
      positionOptions: { enableHighAccuracy: true },
      trackUserLocation: false,
    }), 'top-right');

    await new Promise((resolve) => {
      let done = false;
      const finish = () => { if (done) return; done = true; resolve(); };
      const onceReady = () => {
        if (map.isStyleLoaded && map.isStyleLoaded()) finish();
      };
      map.on('styledata', onceReady);
      map.on('load', finish);
      // Check synchronously (au cas où le style est déjà loaded)
      onceReady();
      // Safety net : si rien ne fire en 6s (CDN lent, sandbox...), on continue
      setTimeout(finish, 6000);
    });

    function buildGeoJSON(drugFilter) {
      // Toutes les pharmacies ont des prix (soumis ou estimés) pour les 4 drugs.
      // Le filtre drug sert à colorer + prioriser l'affichage, pas à filtrer.
      const features = [];
      for (const row of pharmacies) {
        const id = row[idxId];
        const prices = latestPrices[id] || [];
        let drugShown = drugFilter !== 'all' ? drugFilter : null;
        let hasRealPrice = false;
        if (drugShown) hasRealPrice = prices.some((x) => x.d === drugShown);
        features.push({
          type: 'Feature',
          geometry: { type: 'Point', coordinates: [row[idxLng], row[idxLat]] },
          properties: {
            layer: 'pharmacies',
            id, finess: row[idxFiness], name: row[idxName],
            city: row[idxCity], city_slug: row[idxCitySlug],
            cp: row[idxCP], dept: row[idxDept],
            drug: drugShown, hasRealPrice,
          },
        });
      }
      return { type: 'FeatureCollection', features };
    }

    function buildEndoGeoJSON() {
      if (!endocrinologues || !endoSchema) return { type: 'FeatureCollection', features: [] };
      const s = endoSchema;
      const iid = s.indexOf('id'), iciv = s.indexOf('civility'),
            ifn = s.indexOf('first_name'), iln = s.indexOf('last_name'),
            istr = s.indexOf('structure'), ic = s.indexOf('city'),
            icslug = s.indexOf('city_slug'), icp = s.indexOf('cp'),
            idept = s.indexOf('dept'), ilat = s.indexOf('lat'),
            ilng = s.indexOf('lng'), imode = s.indexOf('mode'),
            iphone = s.indexOf('phone');
      return {
        type: 'FeatureCollection',
        features: endocrinologues.map((r) => ({
          type: 'Feature',
          geometry: { type: 'Point', coordinates: [r[ilng], r[ilat]] },
          properties: {
            layer: 'endocrinologues',
            id: r[iid],
            name: [r[iciv], r[ifn], r[iln]].filter(Boolean).join(' '),
            structure: r[istr] || '',
            city: r[ic], city_slug: r[icslug], cp: r[icp], dept: r[idept],
            mode: r[imode], phone: r[iphone] || '',
          },
        })),
      };
    }

    function buildCsoGeoJSON() {
      if (!csos) return { type: 'FeatureCollection', features: [] };
      return {
        type: 'FeatureCollection',
        features: csos
          .filter((c) => c.lat !== null)
          .map((c) => ({
            type: 'Feature',
            geometry: { type: 'Point', coordinates: [c.lng, c.lat] },
            properties: {
              layer: 'cso',
              id: c.id, slug: c.slug, name: c.name,
              parent: c.parent_hospital, address: c.address,
              city: c.city, city_slug: c.city_slug,
              cp: c.postal_code, dept: c.department,
              phone: c.phone || '', website: c.website || '',
              is_pediatric: c.is_pediatric,
            },
          })),
      };
    }

    function buildCurrentGeoJSON() {
      if (currentLayer === 'pharmacies') return buildGeoJSON(currentDrug);
      if (currentLayer === 'endocrinologues') return buildEndoGeoJSON();
      if (currentLayer === 'cso') return buildCsoGeoJSON();
      return { type: 'FeatureCollection', features: [] };
    }

    async function ensureLayerData(layer) {
      if (layer === 'endocrinologues' && !endocrinologues) {
        const data = await fetch('/data/endocrinologues.json').then((r) => r.json());
        endoSchema = data.schema;
        endocrinologues = data.rows;
      } else if (layer === 'cso' && !csos) {
        csos = await fetch('/data/cso.json').then((r) => r.json());
      }
    }

    // À ce stade : map loaded + data fetched. On injecte directement.
    document.getElementById('map-loading').style.display = 'none';

    {
      map.addSource('pharmacies', {
        type: 'geojson',
        data: buildGeoJSON(currentDrug),
        cluster: true,
        clusterRadius: 50,
        clusterMaxZoom: 12,
      });

      // Clusters
      map.addLayer({
        id: 'clusters',
        type: 'circle',
        source: 'pharmacies',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': [
            'step', ['get', 'point_count'],
            '#93c5fd', 20,
            '#60a5fa', 100,
            '#2563eb',
          ],
          'circle-radius': [
            'step', ['get', 'point_count'],
            14, 20,
            18, 100,
            24,
          ],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#fff',
        },
      });
      map.addLayer({
        id: 'cluster-count',
        type: 'symbol',
        source: 'pharmacies',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': '{point_count_abbreviated}',
          'text-font': ['Noto Sans Regular'],
          'text-size': 12,
        },
        paint: { 'text-color': '#fff' },
      });

      // Points individuels — couleur par layer
      map.addLayer({
        id: 'pharmacy-points',
        type: 'circle',
        source: 'pharmacies',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-color': [
            'case',
            ['==', ['get', 'layer'], 'endocrinologues'], LAYER_COLORS.endocrinologues,
            ['==', ['get', 'layer'], 'cso'], LAYER_COLORS.cso,
            ['==', ['get', 'drug'], 'ozempic'], DRUG_COLORS.ozempic,
            ['==', ['get', 'drug'], 'wegovy'], DRUG_COLORS.wegovy,
            ['==', ['get', 'drug'], 'mounjaro'], DRUG_COLORS.mounjaro,
            ['==', ['get', 'drug'], 'saxenda'], DRUG_COLORS.saxenda,
            LAYER_COLORS.pharmacies,
          ],
          'circle-radius': [
            'case',
            ['==', ['get', 'layer'], 'cso'], 9,
            6,
          ],
          'circle-stroke-width': 1.5,
          'circle-stroke-color': '#fff',
        },
      });

      // Zoom sur cluster
      map.on('click', 'clusters', async (e) => {
        const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
        const clusterId = features[0].properties.cluster_id;
        const src = map.getSource('pharmacies');
        const zoom = await src.getClusterExpansionZoom(clusterId);
        map.easeTo({ center: features[0].geometry.coordinates, zoom });
      });

      // Click marker → open side drawer (remplace popup MapLibre pour éviter les soucis de clipping/z-index)
      map.on('click', 'pharmacy-points', (e) => {
        const f = e.features[0];
        openPharmacyDrawer(f.properties);
      });

      // Curseur pointer sur éléments cliquables
      ['clusters', 'pharmacy-points'].forEach((layer) => {
        map.on('mouseenter', layer, () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', layer, () => { map.getCanvas().style.cursor = ''; });
      });
    }

    function setupDrugFilter() {
      document.querySelectorAll('.drug-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.drug-pill').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentDrug = btn.dataset.drug;

          const mapWrap = document.getElementById('map-wrap');
          if (mapWrap) mapWrap.scrollIntoView({ behavior: 'auto', block: 'start' });

          if (typeof map === 'undefined' || !map) return;
          const src = map.getSource('pharmacies');
          if (!src) return;
          src.setData(buildCurrentGeoJSON());

          if (currentDrug === 'all') map.jumpTo({ center: [2.4, 46.5], zoom: 5.5 });
          else map.jumpTo({ center: [2.35, 48.86], zoom: 11 });
        });
      });
    }

    function setupLayerToggle() {
      document.querySelectorAll('.layer-pill').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const newLayer = btn.dataset.layer;
          if (newLayer === currentLayer) return;
          document.querySelectorAll('.layer-pill').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentLayer = newLayer;

          // Drug filter visible uniquement pour pharmacies
          const drugFilter = document.getElementById('drug-filter');
          if (drugFilter) drugFilter.style.display = currentLayer === 'pharmacies' ? '' : 'none';

          // Scroll map into view
          const mapWrap = document.getElementById('map-wrap');
          if (mapWrap) mapWrap.scrollIntoView({ behavior: 'auto', block: 'start' });

          // Lazy-load les données du nouveau layer
          try {
            await ensureLayerData(currentLayer);
          } catch (e) {
            console.error('Layer data load failed', e);
          }

          if (typeof map === 'undefined' || !map) return;
          const src = map.getSource('pharmacies');
          if (!src) return;
          src.setData(buildCurrentGeoJSON());

          // Vue adaptée par layer : CSO = vue France (37 points éparpillés), endo/pharma = Paris
          if (currentLayer === 'cso') map.jumpTo({ center: [2.4, 46.5], zoom: 5.5 });
          else if (currentLayer === 'endocrinologues') map.jumpTo({ center: [2.35, 48.86], zoom: 10 });
          else map.jumpTo({ center: [2.4, 46.5], zoom: 5.5 });
        });
      });
    }

    // ═══════════════════════════════════════════════════════════════
    // DRAWER — side panel, contenu adapté par type de marker
    // ═══════════════════════════════════════════════════════════════
    function openPharmacyDrawer(props) {
      // Route vers le bon renderer selon le layer
      if (props.layer === 'endocrinologues') return openEndoDrawer(props);
      if (props.layer === 'cso') return openCsoDrawer(props);
      return openPharmacyPriceDrawer(props);
    }

    function openPharmacyPriceDrawer(props) {
      const drawer = document.getElementById('pharmacy-drawer');
      if (!drawer) return;
      const id = props.id;
      const finess = props.finess;
      const dept = (props.cp || '').slice(0, 2);
      const submittedPrices = latestPrices[id] || [];

      const submitted = {};
      for (const pr of submittedPrices) {
        submitted[pr.d + '|' + (pr.dose || '')] = pr;
      }

      const drugOrder = ['ozempic', 'wegovy', 'mounjaro', 'saxenda'];
      const ordered = [...drugOrder].sort((a, b) =>
        a === currentDrug ? -1 : b === currentDrug ? 1 : 0
      );

      const drugSections = ordered.map((d) => {
        const ref = DRUG_REF[d];
        if (!ref) return '';
        const highlight = d === currentDrug ? ' pop-drug-active' : '';

        const rows = ref.doses.map((ds) => {
          // Prix réglementés depuis le 15/06/2026 : le prix officiel prime toujours
          // sur les anciennes soumissions communautaires (potentiellement obsolètes).
          const priceHtml = ds.price.toFixed(2);
          const srcPill = '<span class="pop-dose-src pop-src-off">Officiel</span>';
          return `<div class="pop-dose-row"><span class="pop-dose">${escapeHtml(ds.dose)}</span><strong>${priceHtml}&nbsp;€</strong>${srcPill}</div>`;
        }).join('');

        const globalBadge = '<span class="pop-src-off">Prix officiel</span>';

        return `
          <div class="pop-drug${highlight}">
            <div class="pop-drug-head">
              <span class="pop-drug-name">${escapeHtml(DRUG_LABELS[d] || d)}</span>
              ${globalBadge}
            </div>
            <div class="pop-dose-list">${rows}</div>
            ${ref.note ? '<div class="pop-drug-note">' + ref.note + '</div>' : ''}
          </div>`;
      }).join('');

      drawer.querySelector('.drawer-name').textContent = props.name || '';
      drawer.querySelector('.drawer-city').textContent =
        (props.city || '') + (props.cp ? ' · ' + props.cp : '');
      document.getElementById('drawer-body').innerHTML = drugSections;
      const cta = document.getElementById('drawer-submit-btn');
      cta.dataset.pharmacy = id;
      cta.dataset.action = '';
      cta.textContent = 'Vous avez vu un prix ici ? Partagez-le';

      drawer.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => drawer.classList.add('open'));
    }

    function closePharmacyDrawer() {
      const drawer = document.getElementById('pharmacy-drawer');
      if (!drawer) return;
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      setTimeout(() => { drawer.hidden = true; }, 220);
    }

    function openEndoDrawer(props) {
      const drawer = document.getElementById('pharmacy-drawer');
      if (!drawer) return;
      drawer.querySelector('.drawer-name').textContent = props.name || 'Endocrinologue';
      drawer.querySelector('.drawer-city').textContent =
        (props.city || '') + (props.cp ? ' · ' + props.cp : '');

      const phoneLink = props.phone
        ? `<a href="tel:${escapeHtml(props.phone.replace(/\s/g, ''))}" class="pro-phone">${escapeHtml(props.phone)}</a>`
        : '<span class="pro-nophone">Téléphone non renseigné</span>';

      const structure = props.structure
        ? `<div class="pro-structure">${escapeHtml(props.structure)}</div>`
        : '';

      const mode = props.mode
        ? `<span class="pro-badge">${escapeHtml(props.mode)}</span>`
        : '';

      document.getElementById('drawer-body').innerHTML = `
        <div class="pro-info">
          <div class="pro-meta">
            <span class="pro-specialty">Endocrinologie et métabolisme</span>
            ${mode}
          </div>
          ${structure}
          <div class="pro-contact">${phoneLink}</div>
        </div>
        <div class="pro-note">
          <strong>À savoir</strong> — Les endocrinologues sont historiquement les spécialistes de référence pour la prescription des GLP-1 (Ozempic, Wegovy, Mounjaro). Depuis juin 2025, <strong>tout médecin peut prescrire</strong>, mais l'endocrino reste recommandé pour les profils complexes ou diabétiques.
        </div>
      `;
      // Adapt CTA
      const cta = document.getElementById('drawer-submit-btn');
      cta.textContent = 'Consultation plus rapide : téléconsultation spécialiste →';
      cta.dataset.action = 'external-charles';
      drawer.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => drawer.classList.add('open'));
    }

    function openCsoDrawer(props) {
      const drawer = document.getElementById('pharmacy-drawer');
      if (!drawer) return;
      drawer.querySelector('.drawer-name').textContent = props.name || 'CSO';
      drawer.querySelector('.drawer-city').textContent =
        (props.city || '') + (props.cp ? ' · ' + props.cp : '');

      const pediatric = props.is_pediatric
        ? '<span class="pro-badge pro-badge-peds">Pédiatrique</span>'
        : '<span class="pro-badge">Adultes</span>';

      const parent = props.parent
        ? `<div class="pro-structure">${escapeHtml(props.parent)}</div>`
        : '';

      const address = props.address
        ? `<div class="pro-address">${escapeHtml(props.address)}<br>${escapeHtml(props.cp || '')} ${escapeHtml(props.city || '')}</div>`
        : '';

      const phoneLink = props.phone
        ? `<a href="tel:${escapeHtml(props.phone.replace(/\s/g, ''))}" class="pro-phone">${escapeHtml(props.phone)}</a>`
        : '';

      document.getElementById('drawer-body').innerHTML = `
        <div class="pro-info">
          <div class="pro-meta">
            <span class="pro-specialty">Centre Spécialisé Obésité</span>
            ${pediatric}
          </div>
          ${parent}
          ${address}
          <div class="pro-contact">${phoneLink}</div>
        </div>
        <div class="pro-note">
          <strong>Qu'est-ce qu'un CSO&nbsp;?</strong> — Les Centres Spécialisés de l'Obésité prennent en charge les obésités sévères et complexes (IMC &gt; 35, complications, récidives). Prise en charge multidisciplinaire&nbsp;: endocrino, chirurgien bariatrique, diététicien, psychologue, médecin du sport. Accès généralement sur <strong>adressage médecin</strong>.
        </div>
      `;
      const cta = document.getElementById('drawer-submit-btn');
      cta.textContent = 'Accompagnement nutritionnel personnalisé →';
      cta.dataset.action = 'external-annette';
      drawer.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => drawer.classList.add('open'));
    }

    // Wire drawer close
    document.getElementById('drawer-close')?.addEventListener('click', closePharmacyDrawer);
    document.getElementById('drawer-backdrop')?.addEventListener('click', closePharmacyDrawer);
    document.getElementById('drawer-submit-btn')?.addEventListener('click', (e) => {
      const action = e.currentTarget.dataset.action;
      closePharmacyDrawer();
      if (action === 'external-charles' || action === 'external-annette') {
        // Sinocare-only policy (2026-05-12) : tous les anciens partners redirigent vers la fiche produit Safe AQ Smart
        window.open('https://www.awin1.com/cread.php?awinmid=114180&awinaffid=2879557&clickref=glp1france_carte_drawer&ued=https%3A%2F%2Fen.sinocare.com%2Ffr%2Fproducts%2Fsafe-aq-smart-blood-glucometer', '_blank', 'noopener');
        return;
      }
      // Default : soumission pharmacie
      const pid = e.currentTarget.dataset.pharmacy;
      document.dispatchEvent(new CustomEvent('open-submit-for', { detail: { pharmacyId: pid } }));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const drawer = document.getElementById('pharmacy-drawer');
        if (drawer && !drawer.hidden) closePharmacyDrawer();
      }
    });

    // ═══════════════════════════════════════════════════════════════
    // SUBMISSION MODAL — autocomplete pharmacie + insert Supabase
    // ═══════════════════════════════════════════════════════════════
    function setupSubmissionModal() {
    const modal = document.getElementById('submit-modal');
    const fPharmacy = document.getElementById('f-pharmacy');
    const fPharmacyId = document.getElementById('f-pharmacy-id');
    const fPharmacyResults = document.getElementById('f-pharmacy-results');
    const fPharmacySelected = document.getElementById('f-pharmacy-selected');
    const fForm = document.getElementById('submit-form');
    const fError = document.getElementById('f-error');
    const fSuccess = document.getElementById('f-success');
    const fSubmit = document.getElementById('f-submit');

    function openModal(pharmacyId) {
      resetForm();
      if (pharmacyId) {
        const row = pharmacies.find((p) => p[idxId] === pharmacyId);
        if (row) selectPharmacy(row);
      }
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
    }
    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
    }
    function resetForm() {
      fForm.reset();
      fPharmacyId.value = '';
      fPharmacySelected.hidden = true;
      fPharmacy.hidden = false;
      fPharmacyResults.hidden = true;
      fError.hidden = true;
      fSuccess.hidden = true;
      fSubmit.disabled = false;
      fSubmit.textContent = 'Envoyer';
    }

    function selectPharmacy(row) {
      fPharmacyId.value = row[idxId];
      fPharmacy.hidden = true;
      fPharmacyResults.hidden = true;
      fPharmacySelected.querySelector('.ps-name').textContent = row[idxName] || '';
      fPharmacySelected.querySelector('.ps-city').textContent =
        (row[idxCity] || '') + (row[idxCP] ? ' · ' + row[idxCP] : '');
      fPharmacySelected.hidden = false;
    }

    // Autocomplete (débouncé)
    let acTimer = null;
    fPharmacy.addEventListener('input', () => {
      clearTimeout(acTimer);
      acTimer = setTimeout(() => renderAutocomplete(fPharmacy.value.trim()), 180);
    });
    function renderAutocomplete(q) {
      if (!q || q.length < 2) {
        fPharmacyResults.hidden = true;
        return;
      }
      const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const qn = norm(q);
      const hits = [];
      for (const row of pharmacies) {
        const name = norm(row[idxName]);
        const city = norm(row[idxCity]);
        if (name.indexOf(qn) > -1 || city.indexOf(qn) > -1) {
          hits.push(row);
          if (hits.length >= 10) break;
        }
      }
      if (!hits.length) {
        fPharmacyResults.innerHTML = '<div class="ac-empty">Aucune pharmacie trouvée</div>';
      } else {
        fPharmacyResults.innerHTML = hits.map((row, i) =>
          `<button type="button" class="ac-item" data-i="${i}">
             <span class="ac-name">${escapeHtml(row[idxName] || '')}</span>
             <span class="ac-city">${escapeHtml(row[idxCity] || '')} · ${escapeHtml(row[idxCP] || '')}</span>
           </button>`
        ).join('');
        // Bind clicks
        fPharmacyResults.querySelectorAll('.ac-item').forEach((btn, i) => {
          btn.addEventListener('click', () => selectPharmacy(hits[i]));
        });
      }
      fPharmacyResults.hidden = false;
    }

    document.getElementById('f-pharmacy-change').addEventListener('click', () => {
      fPharmacyId.value = '';
      fPharmacySelected.hidden = true;
      fPharmacy.hidden = false;
      fPharmacy.value = '';
      fPharmacy.focus();
    });

    // Open/close modal
    document.getElementById('open-submit').addEventListener('click', () => openModal());
    document.getElementById('close-submit').addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
    document.addEventListener('click', (e) => {
      if (e.target && e.target.matches('[data-action="submit-for"]')) {
        openModal(e.target.getAttribute('data-pharmacy'));
      }
    });
    // Event custom déclenché par le drawer pharmacie
    document.addEventListener('open-submit-for', (e) => {
      openModal(e.detail && e.detail.pharmacyId);
    });

    // Submit
    fForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      fError.hidden = true;
      fSuccess.hidden = true;

      const pharmacy_id = fPharmacyId.value;
      const drug_slug = document.getElementById('f-drug').value;
      const dose = document.getElementById('f-dose').value.trim() || null;
      const priceStr = document.getElementById('f-price').value.replace(',', '.');
      const price_eur = parseFloat(priceStr);
      const notes = document.getElementById('f-notes').value.trim() || null;

      if (!pharmacy_id) {
        showErr('Sélectionne une pharmacie dans la liste.');
        return;
      }
      if (!drug_slug) {
        showErr('Choisis un médicament.');
        return;
      }
      if (!Number.isFinite(price_eur) || price_eur <= 0 || price_eur > 1000) {
        showErr('Prix invalide (entre 1 et 1000 €).');
        return;
      }

      const session_id = localStorage.getItem('glp1_coach_session')
        || 'anon_' + Math.random().toString(36).slice(2, 10);

      fSubmit.disabled = true;
      fSubmit.textContent = 'Envoi…';
      try {
        const r = await fetch(SB_URL + '/rest/v1/pharmacy_prices', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SB_KEY,
            'Authorization': 'Bearer ' + SB_KEY,
            'Prefer': 'return=minimal',
          },
          body: JSON.stringify({
            pharmacy_id, drug_slug, dose, price_eur,
            source: 'user', verified: false, display: true,
            submitted_by_session: session_id,
            notes,
          }),
        });
        if (!r.ok) {
          const t = await r.text();
          throw new Error(t || ('HTTP ' + r.status));
        }
        fSuccess.hidden = false;
        fSubmit.textContent = 'Merci !';
        setTimeout(closeModal, 2500);
      } catch (err) {
        console.error(err);
        showErr('Erreur lors de l\'envoi. Réessaie dans un instant.');
        fSubmit.disabled = false;
        fSubmit.textContent = 'Envoyer';
      }
    });

    function showErr(msg) {
      fError.textContent = msg;
      fError.hidden = false;
    }
    } // end setupSubmissionModal

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }
  })();
  </script>

