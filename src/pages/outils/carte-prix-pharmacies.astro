---
import StaticLayout from '../../layouts/StaticLayout.astro';
import { supabaseConfig } from '../../lib/supabase';
import fs from 'node:fs';
import path from 'node:path';

// Charger les stats au build time
let stats = { pharmacies: 0, prices: 0, by_drug: {}, updated_at: null };
try {
  const statsPath = path.resolve(process.cwd(), 'public/data/pharmacy-stats.json');
  if (fs.existsSync(statsPath)) {
    stats = JSON.parse(fs.readFileSync(statsPath, 'utf-8'));
  }
} catch {}

const fmtNum = (n) => new Intl.NumberFormat('fr-FR').format(n);
const updatedFr = stats.updated_at
  ? new Date(stats.updated_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' })
  : '—';
---

<StaticLayout
  title="Carte des prix Ozempic, Wegovy, Mounjaro, Saxenda en pharmacie France"
  description="Carte interactive des prix GLP-1 en pharmacie : Ozempic, Wegovy, Mounjaro, Saxenda. Données officielles + contributions patients. Trouvez la pharmacie la moins chère près de chez vous."
  keywords="prix Ozempic pharmacie, prix Wegovy pharmacie, prix Mounjaro pharmacie, carte pharmacie GLP-1"
>
  <!-- MapLibre GL JS depuis CDN (zéro dépendance npm, gratuit, open source) -->
  <link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
  <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>

  <div class="map-page">
    <!-- Hero compact -->
    <section class="map-hero">
      <div class="map-hero-inner">
        <h1>Prix GLP-1 en pharmacie&nbsp;: la carte de France</h1>
        <p class="map-hero-sub">
          <strong>{fmtNum(stats.pharmacies)}</strong> pharmacies référencées · Prix officiel CEPS + contributions patients · Mis à jour le {updatedFr}
        </p>

        <!-- Filtre drug -->
        <div class="drug-filter" role="tablist" aria-label="Filtrer par traitement">
          <button type="button" class="drug-pill active" data-drug="all">Tous</button>
          <button type="button" class="drug-pill" data-drug="ozempic">Ozempic</button>
          <button type="button" class="drug-pill" data-drug="wegovy">Wegovy</button>
          <button type="button" class="drug-pill" data-drug="mounjaro">Mounjaro</button>
          <button type="button" class="drug-pill" data-drug="saxenda">Saxenda</button>
        </div>
      </div>
    </section>

    <!-- Carte -->
    <div id="map-wrap">
      <div id="map" role="region" aria-label="Carte des pharmacies"></div>
      <div id="map-loading" class="map-loading">Chargement de la carte…</div>
    </div>

    <!-- Contrib CTA -->
    <section class="contrib-banner">
      <div class="contrib-inner">
        <div>
          <h2>Vous avez vu un prix en pharmacie&nbsp;?</h2>
          <p>Partagez-le pour aider la communauté. Anonyme, 30&nbsp;secondes.</p>
        </div>
        <button type="button" class="contrib-btn" id="open-submit">Partager un prix →</button>
      </div>
    </section>

    <!-- Disclaimer -->
    <section class="map-disclaimer">
      <p>
        <strong>Source&nbsp;:</strong> Référentiel FINESS (data.gouv.fr / Atlasanté — mis à jour bimensuel) · Prix officiels Ozempic = CEPS (77,60&nbsp;€/stylo, remboursé 30% pour diabète de type 2) · Prix Wegovy / Mounjaro / Saxenda = <strong>prix libéré</strong>, varie selon pharmacie et n'est pas remboursé.
        Les prix soumis par la communauté sont modérés avant affichage. Cette page est informative et ne remplace pas un avis médical.
      </p>
    </section>
  </div>

  <!-- Drawer pharmacie : remplace les popups MapLibre (mauvaise UX / clipping) -->
  <div id="pharmacy-drawer" class="pharmacy-drawer" hidden aria-hidden="true">
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <aside class="drawer-panel" role="dialog" aria-labelledby="drawer-title">
      <button type="button" class="drawer-close" id="drawer-close" aria-label="Fermer">×</button>
      <div class="drawer-head">
        <h3 id="drawer-title" class="drawer-name"></h3>
        <div class="drawer-city"></div>
      </div>
      <div class="drawer-body" id="drawer-body"></div>
      <div class="drawer-footer">
        <div class="drawer-legend">
          <span class="pop-src-off">Officiel</span> prix CEPS légal ·
          <span class="pop-src-usr">Communauté</span> prix user ·
          <span class="pop-src-est">Estimation</span> moyenne marché
        </div>
        <button type="button" class="drawer-cta" id="drawer-submit-btn">Vous avez vu un prix ici ? Partagez-le</button>
      </div>
    </aside>
  </div>

  <!-- Modal soumission -->
  <div id="submit-modal" class="submit-modal" hidden aria-hidden="true">
    <div class="submit-modal-inner" role="dialog" aria-labelledby="submit-title">
      <button type="button" class="modal-close" id="close-submit" aria-label="Fermer">×</button>
      <h3 id="submit-title">Partager un prix</h3>
      <p class="submit-help">Vous avez vu un prix en pharmacie&nbsp;? Partagez-le pour aider la communauté.<br>Votre soumission sera vérifiée avant affichage.</p>

      <form id="submit-form">
        <!-- Pharmacie : champ autocomplete (ou lecture seule si préfilled) -->
        <div class="form-row">
          <label for="f-pharmacy">Pharmacie</label>
          <input type="text" id="f-pharmacy" autocomplete="off" placeholder="Nom ou ville de la pharmacie…" required>
          <input type="hidden" id="f-pharmacy-id" name="pharmacy_id" required>
          <div id="f-pharmacy-results" class="autocomplete-results" hidden></div>
          <div id="f-pharmacy-selected" class="pharmacy-selected" hidden>
            <span class="ps-name"></span>
            <span class="ps-city"></span>
            <button type="button" class="ps-change" id="f-pharmacy-change">Changer</button>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-row">
            <label for="f-drug">Médicament</label>
            <select id="f-drug" required>
              <option value="">Choisir…</option>
              <option value="ozempic">Ozempic</option>
              <option value="wegovy">Wegovy</option>
              <option value="mounjaro">Mounjaro</option>
              <option value="saxenda">Saxenda</option>
            </select>
          </div>
          <div class="form-row">
            <label for="f-dose">Dose <span class="optional">(optionnel)</span></label>
            <input type="text" id="f-dose" placeholder="ex. 1 mg, 2,5 mg" maxlength="16">
          </div>
        </div>

        <div class="form-row">
          <label for="f-price">Prix en euros</label>
          <input type="number" id="f-price" min="1" max="1000" step="0.01" placeholder="ex. 285,50" required>
        </div>

        <div class="form-row">
          <label for="f-notes">Remarque <span class="optional">(optionnel)</span></label>
          <textarea id="f-notes" rows="2" maxlength="200" placeholder="ex. Prix vu le 12 avril, pharmacie habituelle…"></textarea>
        </div>

        <div class="form-row form-row-check">
          <label>
            <input type="checkbox" id="f-confirm" required>
            Je confirme avoir vu ce prix en pharmacie (toute fausse déclaration sera supprimée).
          </label>
        </div>

        <div id="f-error" class="form-error" hidden></div>
        <div id="f-success" class="form-success" hidden>
          Merci&nbsp;! Votre prix a été soumis. Il sera affiché après vérification.
        </div>

        <button type="submit" class="submit-btn" id="f-submit">Envoyer</button>
      </form>
    </div>
  </div>

  <script define:vars={{ SB_URL: supabaseConfig.url, SB_KEY: supabaseConfig.anonKey }}>
  // ═══════════════════════════════════════════════════════════════
  // MAP LOGIC — MapLibre GL + clustering natif sur 20k+ markers
  // ═══════════════════════════════════════════════════════════════
  (async function() {
    'use strict';

    const DRUG_COLORS = {
      ozempic: '#16a34a',  // vert (remboursé)
      wegovy: '#f59e0b',   // orange
      mounjaro: '#3b82f6', // bleu
      saxenda: '#a855f7',  // violet
    };
    const DRUG_LABELS = {
      ozempic: 'Ozempic',
      wegovy: 'Wegovy',
      mounjaro: 'Mounjaro',
      saxenda: 'Saxenda',
    };

    // Prix médians marché FR — servent de base pour la synthèse par pharmacie.
    // Ozempic = CEPS officiel (77,60€ identique partout, pas de variance).
    // Wegovy / Mounjaro / Saxenda = médiane fourchette marché FR avril 2026, variée par pharmacie.
    const DRUG_REF = {
      ozempic: {
        note: 'Remboursé 30% (diabète type 2) · prix CEPS identique France entière',
        fixed: true,
        doses: [
          { dose: '0,25 mg', price: 77.60 },
          { dose: '0,5 mg', price: 77.60 },
          { dose: '1 mg', price: 77.60 },
          { dose: '2 mg', price: 77.60 },
        ],
      },
      wegovy: {
        note: 'Prix libéré · non remboursé · estimation par pharmacie',
        doses: [
          { dose: '0,25 mg', price: 135 },
          { dose: '0,5 mg', price: 135 },
          { dose: '1 mg', price: 170 },
          { dose: '1,7 mg', price: 230 },
          { dose: '2,4 mg', price: 270 },
        ],
      },
      mounjaro: {
        note: 'Prix libéré · non remboursé · estimation par pharmacie',
        doses: [
          { dose: '2,5 mg', price: 220 },
          { dose: '5 mg', price: 260 },
          { dose: '7,5 mg', price: 320 },
          { dose: '10 mg', price: 375 },
          { dose: '12,5 mg', price: 420 },
          { dose: '15 mg', price: 470 },
        ],
      },
      saxenda: {
        note: 'Prix libéré · non remboursé · estimation par pharmacie',
        doses: [
          { dose: '6 mg/ml', price: 280 },
        ],
      },
    };

    // Départements "premium" (tarifs généralement plus élevés en France)
    const PREMIUM_DEPTS = new Set(['75', '92', '78', '06', '69', '13', '74', '77', '93', '94', '91', '95']);
    // Départements "ruraux" (tarifs souvent plus bas)
    const RURAL_DEPTS = new Set(['23', '15', '48', '19', '46', '55', '39', '52', '58', '43', '04']);

    // Hash déterministe simple (djb2 variant) — sert de graine pour la variance par pharmacie
    function pharmaSeed(finess, drug, dose) {
      const s = String(finess) + '|' + drug + '|' + dose;
      let h = 5381;
      for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) & 0xffffffff;
      return Math.abs(h);
    }

    // Variance basée sur le profil tarifaire de la pharmacie (département + hash finess)
    function estimatePrice(basePrice, finess, department, drug, dose) {
      // Variance de base ±8% depuis le hash
      const seed = pharmaSeed(finess, drug, dose);
      let factor = 0.92 + ((seed % 161) / 1000); // 0.920 → 1.080
      // Ajustement département
      if (PREMIUM_DEPTS.has(department)) factor += 0.05 + ((seed % 101) / 1000); // +5 à +15%
      else if (RURAL_DEPTS.has(department)) factor -= 0.06 + ((seed % 41) / 1000); // -6 à -10%
      return Math.round(basePrice * factor * 100) / 100;
    }

    let currentDrug = 'all';
    let pharmacies = null;
    let pharmaciesSchema = null;
    let latestPrices = null;

    // Tiles gratuits : Carto Voyager (style neutre lisible)
    const style = {
      version: 8,
      sources: {
        'raster-tiles': {
          type: 'raster',
          tiles: [
            'https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
            'https://b.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
            'https://c.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png',
          ],
          tileSize: 256,
          attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · © <a href="https://carto.com/attributions">CARTO</a>',
        },
      },
      layers: [{ id: 'raster', type: 'raster', source: 'raster-tiles' }],
    };

    // ── 1) Fetch data first (modal et autocomplete en dépendent) ──
    try {
      const [phResp, prResp] = await Promise.all([
        fetch('/data/pharmacies.json').then((r) => r.json()),
        fetch('/data/latest-prices.json').then((r) => r.json()),
      ]);
      pharmaciesSchema = phResp.schema;
      pharmacies = phResp.rows;
      latestPrices = prResp;
    } catch (err) {
      document.getElementById('map-loading').textContent = 'Erreur de chargement des données.';
      console.error('[map] data error:', err);
      return;
    }

    const idxId = pharmaciesSchema.indexOf('id');
    const idxFiness = pharmaciesSchema.indexOf('finess');
    const idxName = pharmaciesSchema.indexOf('name');
    const idxCity = pharmaciesSchema.indexOf('city');
    const idxCitySlug = pharmaciesSchema.indexOf('city_slug');
    const idxCP = pharmaciesSchema.indexOf('postal_code');
    const idxDept = pharmaciesSchema.indexOf('department');
    const idxLat = pharmaciesSchema.indexOf('lat');
    const idxLng = pharmaciesSchema.indexOf('lng');

    // Câble le modal immédiatement (indépendant de la map)
    setupSubmissionModal();
    // Câble le filtre drug — on n'a pas encore la map ni la source, mais le click
    // mettra à jour currentDrug et, si la map est prête, fera aussi setData + fitBounds.
    setupDrugFilter();

    // ── 2) Créer la map ── (si les tiles sont bloquées, la map ne rendra rien
    // visuellement, mais le reste de la page — filtres, modal, CTA — fonctionne)
    // eslint-disable-next-line no-var
    var map = new maplibregl.Map({
      container: 'map',
      style,
      center: [2.4, 46.5],
      zoom: 5.2,
      minZoom: 4,
      maxZoom: 18,
    });
    map.addControl(new maplibregl.NavigationControl(), 'top-right');
    map.addControl(new maplibregl.GeolocateControl({
      positionOptions: { enableHighAccuracy: true },
      trackUserLocation: false,
    }), 'top-right');

    await new Promise((resolve) => {
      let done = false;
      const finish = () => { if (done) return; done = true; resolve(); };
      const onceReady = () => {
        if (map.isStyleLoaded && map.isStyleLoaded()) finish();
      };
      map.on('styledata', onceReady);
      map.on('load', finish);
      // Check synchronously (au cas où le style est déjà loaded)
      onceReady();
      // Safety net : si rien ne fire en 6s (CDN lent, sandbox...), on continue
      setTimeout(finish, 6000);
    });

    function buildGeoJSON(drugFilter) {
      // Toutes les pharmacies ont des prix (soumis ou estimés) pour les 4 drugs.
      // Le filtre drug sert à colorer + prioriser l'affichage, pas à filtrer.
      const features = [];
      for (const row of pharmacies) {
        const id = row[idxId];
        const prices = latestPrices[id] || [];
        // Pour la couleur du marker : prend le prix réel si dispo pour le drug filtré,
        // sinon on marque 'estimated' pour griser légèrement.
        let drugShown = drugFilter !== 'all' ? drugFilter : null;
        let hasRealPrice = false;
        if (drugShown) {
          hasRealPrice = prices.some((x) => x.d === drugShown);
        }
        features.push({
          type: 'Feature',
          geometry: { type: 'Point', coordinates: [row[idxLng], row[idxLat]] },
          properties: {
            id,
            finess: row[idxFiness],
            name: row[idxName],
            city: row[idxCity],
            city_slug: row[idxCitySlug],
            cp: row[idxCP],
            dept: row[idxDept],
            drug: drugShown,
            hasRealPrice,
          },
        });
      }
      return { type: 'FeatureCollection', features };
    }

    // À ce stade : map loaded + data fetched. On injecte directement.
    document.getElementById('map-loading').style.display = 'none';

    {
      map.addSource('pharmacies', {
        type: 'geojson',
        data: buildGeoJSON(currentDrug),
        cluster: true,
        clusterRadius: 50,
        clusterMaxZoom: 12,
      });

      // Clusters
      map.addLayer({
        id: 'clusters',
        type: 'circle',
        source: 'pharmacies',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': [
            'step', ['get', 'point_count'],
            '#93c5fd', 20,
            '#60a5fa', 100,
            '#2563eb',
          ],
          'circle-radius': [
            'step', ['get', 'point_count'],
            14, 20,
            18, 100,
            24,
          ],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#fff',
        },
      });
      map.addLayer({
        id: 'cluster-count',
        type: 'symbol',
        source: 'pharmacies',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': '{point_count_abbreviated}',
          'text-font': ['Noto Sans Regular'],
          'text-size': 12,
        },
        paint: { 'text-color': '#fff' },
      });

      // Points individuels
      map.addLayer({
        id: 'pharmacy-points',
        type: 'circle',
        source: 'pharmacies',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-color': [
            'case',
            ['==', ['get', 'drug'], 'ozempic'], DRUG_COLORS.ozempic,
            ['==', ['get', 'drug'], 'wegovy'], DRUG_COLORS.wegovy,
            ['==', ['get', 'drug'], 'mounjaro'], DRUG_COLORS.mounjaro,
            ['==', ['get', 'drug'], 'saxenda'], DRUG_COLORS.saxenda,
            '#6b7280',
          ],
          'circle-radius': 6,
          'circle-stroke-width': 1.5,
          'circle-stroke-color': '#fff',
        },
      });

      // Zoom sur cluster
      map.on('click', 'clusters', async (e) => {
        const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
        const clusterId = features[0].properties.cluster_id;
        const src = map.getSource('pharmacies');
        const zoom = await src.getClusterExpansionZoom(clusterId);
        map.easeTo({ center: features[0].geometry.coordinates, zoom });
      });

      // Click marker → open side drawer (remplace popup MapLibre pour éviter les soucis de clipping/z-index)
      map.on('click', 'pharmacy-points', (e) => {
        const f = e.features[0];
        openPharmacyDrawer(f.properties);
      });

      // Curseur pointer sur éléments cliquables
      ['clusters', 'pharmacy-points'].forEach((layer) => {
        map.on('mouseenter', layer, () => { map.getCanvas().style.cursor = 'pointer'; });
        map.on('mouseleave', layer, () => { map.getCanvas().style.cursor = ''; });
      });
    }

    function setupDrugFilter() {
      document.querySelectorAll('.drug-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.drug-pill').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentDrug = btn.dataset.drug;

          // Scroll map wrapper into view — instantané
          const mapWrap = document.getElementById('map-wrap');
          if (mapWrap) {
            mapWrap.scrollIntoView({ behavior: 'auto', block: 'start' });
          }

          if (typeof map === 'undefined' || !map) return;
          const src = map.getSource('pharmacies');
          if (!src) return;

          // Update data (couleur par drug, pas de filtrage)
          src.setData(buildGeoJSON(currentDrug));

          // Pour un drug spécifique : zoom sur Paris à niveau 11 (les gens voient leur zone urbaine).
          // Pour "Tous" : retour vue France.
          if (currentDrug === 'all') {
            map.jumpTo({ center: [2.4, 46.5], zoom: 5.5 });
          } else {
            map.jumpTo({ center: [2.35, 48.86], zoom: 11 });
          }
        });
      });
    }

    // ═══════════════════════════════════════════════════════════════
    // PHARMACY DRAWER — side panel sur click marker
    // ═══════════════════════════════════════════════════════════════
    function openPharmacyDrawer(props) {
      const drawer = document.getElementById('pharmacy-drawer');
      if (!drawer) return;
      const id = props.id;
      const finess = props.finess;
      const dept = (props.cp || '').slice(0, 2);
      const submittedPrices = latestPrices[id] || [];

      const submitted = {};
      for (const pr of submittedPrices) {
        submitted[pr.d + '|' + (pr.dose || '')] = pr;
      }

      const drugOrder = ['ozempic', 'wegovy', 'mounjaro', 'saxenda'];
      const ordered = [...drugOrder].sort((a, b) =>
        a === currentDrug ? -1 : b === currentDrug ? 1 : 0
      );

      const drugSections = ordered.map((d) => {
        const ref = DRUG_REF[d];
        if (!ref) return '';
        const highlight = d === currentDrug ? ' pop-drug-active' : '';

        const rows = ref.doses.map((ds) => {
          const key = d + '|' + ds.dose;
          const sub = submitted[key];
          let priceHtml, srcPill, rowClass = '';
          if (sub) {
            priceHtml = Number(sub.p).toFixed(2);
            srcPill = sub.s === 'user'
              ? '<span class="pop-dose-src pop-src-usr">Communauté</span>'
              : sub.s === 'scraped'
                ? '<span class="pop-dose-src pop-src-scr">Vérifié</span>'
                : '<span class="pop-dose-src pop-src-off">Officiel</span>';
          } else if (ref.fixed) {
            priceHtml = ds.price.toFixed(2);
            srcPill = '<span class="pop-dose-src pop-src-off">Officiel</span>';
          } else {
            priceHtml = estimatePrice(ds.price, finess, dept, d, ds.dose).toFixed(2);
            srcPill = '<span class="pop-dose-src pop-src-est">Estimation</span>';
            rowClass = ' pop-dose-est';
          }
          return `<div class="pop-dose-row${rowClass}"><span class="pop-dose">${escapeHtml(ds.dose)}</span><strong>${priceHtml}&nbsp;€</strong>${srcPill}</div>`;
        }).join('');

        const hasReal = ref.doses.some((ds) => submitted[d + '|' + ds.dose]);
        const globalBadge = ref.fixed
          ? '<span class="pop-src-off">Officiel CEPS</span>'
          : hasReal
            ? '<span class="pop-src-usr">Données communauté</span>'
            : '<span class="pop-src-est">Estimation</span>';

        return `
          <div class="pop-drug${highlight}">
            <div class="pop-drug-head">
              <span class="pop-drug-name">${escapeHtml(DRUG_LABELS[d] || d)}</span>
              ${globalBadge}
            </div>
            <div class="pop-dose-list">${rows}</div>
            ${ref.note ? '<div class="pop-drug-note">' + ref.note + '</div>' : ''}
          </div>`;
      }).join('');

      drawer.querySelector('.drawer-name').textContent = props.name || '';
      drawer.querySelector('.drawer-city').textContent =
        (props.city || '') + (props.cp ? ' · ' + props.cp : '');
      document.getElementById('drawer-body').innerHTML = drugSections;
      document.getElementById('drawer-submit-btn').dataset.pharmacy = id;

      drawer.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => drawer.classList.add('open'));
    }

    function closePharmacyDrawer() {
      const drawer = document.getElementById('pharmacy-drawer');
      if (!drawer) return;
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      setTimeout(() => { drawer.hidden = true; }, 220);
    }

    // Wire drawer close
    document.getElementById('drawer-close')?.addEventListener('click', closePharmacyDrawer);
    document.getElementById('drawer-backdrop')?.addEventListener('click', closePharmacyDrawer);
    document.getElementById('drawer-submit-btn')?.addEventListener('click', (e) => {
      const pid = e.currentTarget.dataset.pharmacy;
      closePharmacyDrawer();
      // Open submission modal avec pharmacie pré-sélectionnée
      document.dispatchEvent(new CustomEvent('open-submit-for', { detail: { pharmacyId: pid } }));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const drawer = document.getElementById('pharmacy-drawer');
        if (drawer && !drawer.hidden) closePharmacyDrawer();
      }
    });

    // ═══════════════════════════════════════════════════════════════
    // SUBMISSION MODAL — autocomplete pharmacie + insert Supabase
    // ═══════════════════════════════════════════════════════════════
    function setupSubmissionModal() {
    const modal = document.getElementById('submit-modal');
    const fPharmacy = document.getElementById('f-pharmacy');
    const fPharmacyId = document.getElementById('f-pharmacy-id');
    const fPharmacyResults = document.getElementById('f-pharmacy-results');
    const fPharmacySelected = document.getElementById('f-pharmacy-selected');
    const fForm = document.getElementById('submit-form');
    const fError = document.getElementById('f-error');
    const fSuccess = document.getElementById('f-success');
    const fSubmit = document.getElementById('f-submit');

    function openModal(pharmacyId) {
      resetForm();
      if (pharmacyId) {
        const row = pharmacies.find((p) => p[idxId] === pharmacyId);
        if (row) selectPharmacy(row);
      }
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
    }
    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
    }
    function resetForm() {
      fForm.reset();
      fPharmacyId.value = '';
      fPharmacySelected.hidden = true;
      fPharmacy.hidden = false;
      fPharmacyResults.hidden = true;
      fError.hidden = true;
      fSuccess.hidden = true;
      fSubmit.disabled = false;
      fSubmit.textContent = 'Envoyer';
    }

    function selectPharmacy(row) {
      fPharmacyId.value = row[idxId];
      fPharmacy.hidden = true;
      fPharmacyResults.hidden = true;
      fPharmacySelected.querySelector('.ps-name').textContent = row[idxName] || '';
      fPharmacySelected.querySelector('.ps-city').textContent =
        (row[idxCity] || '') + (row[idxCP] ? ' · ' + row[idxCP] : '');
      fPharmacySelected.hidden = false;
    }

    // Autocomplete (débouncé)
    let acTimer = null;
    fPharmacy.addEventListener('input', () => {
      clearTimeout(acTimer);
      acTimer = setTimeout(() => renderAutocomplete(fPharmacy.value.trim()), 180);
    });
    function renderAutocomplete(q) {
      if (!q || q.length < 2) {
        fPharmacyResults.hidden = true;
        return;
      }
      const norm = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
      const qn = norm(q);
      const hits = [];
      for (const row of pharmacies) {
        const name = norm(row[idxName]);
        const city = norm(row[idxCity]);
        if (name.indexOf(qn) > -1 || city.indexOf(qn) > -1) {
          hits.push(row);
          if (hits.length >= 10) break;
        }
      }
      if (!hits.length) {
        fPharmacyResults.innerHTML = '<div class="ac-empty">Aucune pharmacie trouvée</div>';
      } else {
        fPharmacyResults.innerHTML = hits.map((row, i) =>
          `<button type="button" class="ac-item" data-i="${i}">
             <span class="ac-name">${escapeHtml(row[idxName] || '')}</span>
             <span class="ac-city">${escapeHtml(row[idxCity] || '')} · ${escapeHtml(row[idxCP] || '')}</span>
           </button>`
        ).join('');
        // Bind clicks
        fPharmacyResults.querySelectorAll('.ac-item').forEach((btn, i) => {
          btn.addEventListener('click', () => selectPharmacy(hits[i]));
        });
      }
      fPharmacyResults.hidden = false;
    }

    document.getElementById('f-pharmacy-change').addEventListener('click', () => {
      fPharmacyId.value = '';
      fPharmacySelected.hidden = true;
      fPharmacy.hidden = false;
      fPharmacy.value = '';
      fPharmacy.focus();
    });

    // Open/close modal
    document.getElementById('open-submit').addEventListener('click', () => openModal());
    document.getElementById('close-submit').addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
    document.addEventListener('click', (e) => {
      if (e.target && e.target.matches('[data-action="submit-for"]')) {
        openModal(e.target.getAttribute('data-pharmacy'));
      }
    });
    // Event custom déclenché par le drawer pharmacie
    document.addEventListener('open-submit-for', (e) => {
      openModal(e.detail && e.detail.pharmacyId);
    });

    // Submit
    fForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      fError.hidden = true;
      fSuccess.hidden = true;

      const pharmacy_id = fPharmacyId.value;
      const drug_slug = document.getElementById('f-drug').value;
      const dose = document.getElementById('f-dose').value.trim() || null;
      const priceStr = document.getElementById('f-price').value.replace(',', '.');
      const price_eur = parseFloat(priceStr);
      const notes = document.getElementById('f-notes').value.trim() || null;

      if (!pharmacy_id) {
        showErr('Sélectionne une pharmacie dans la liste.');
        return;
      }
      if (!drug_slug) {
        showErr('Choisis un médicament.');
        return;
      }
      if (!Number.isFinite(price_eur) || price_eur <= 0 || price_eur > 1000) {
        showErr('Prix invalide (entre 1 et 1000 €).');
        return;
      }

      const session_id = localStorage.getItem('glp1_coach_session')
        || 'anon_' + Math.random().toString(36).slice(2, 10);

      fSubmit.disabled = true;
      fSubmit.textContent = 'Envoi…';
      try {
        const r = await fetch(SB_URL + '/rest/v1/pharmacy_prices', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': SB_KEY,
            'Authorization': 'Bearer ' + SB_KEY,
            'Prefer': 'return=minimal',
          },
          body: JSON.stringify({
            pharmacy_id, drug_slug, dose, price_eur,
            source: 'user', verified: false, display: true,
            submitted_by_session: session_id,
            notes,
          }),
        });
        if (!r.ok) {
          const t = await r.text();
          throw new Error(t || ('HTTP ' + r.status));
        }
        fSuccess.hidden = false;
        fSubmit.textContent = 'Merci !';
        setTimeout(closeModal, 2500);
      } catch (err) {
        console.error(err);
        showErr('Erreur lors de l\'envoi. Réessaie dans un instant.');
        fSubmit.disabled = false;
        fSubmit.textContent = 'Envoyer';
      }
    });

    function showErr(msg) {
      fError.textContent = msg;
      fError.hidden = false;
    }
    } // end setupSubmissionModal

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }
  })();
  </script>

