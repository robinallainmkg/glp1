---
import ArticleWithAffiliateSidebar from '../../layouts/ArticleWithAffiliateSidebar.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('glp1-perte-de-poids');
  return entries.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// entry can be dynamic; cast to any to satisfy TypeScript in mixed frontmatter setups
const { entry: rawEntry } = Astro.props as any;
const entry: any = rawEntry;
const renderResult = entry && typeof entry.render === 'function' ? await entry.render() : { Content: null };
const { Content } = renderResult;
const content = entry && entry.body ? entry.body : '';

// Utiliser le nom de la collection au lieu de la catégorie du frontmatter
const collectionName = "glp1-perte-de-poids";
---

<ArticleWithAffiliateSidebar showAffiliateSidebar={true} title={entry.data.title}
  description={entry.data.description || entry.data.metaDescription || ""}
  author={entry.data.author || "Équipe GLP-1 France"}
  category={collectionName}
  keywords={entry.data.keywords || ""}
  readingTime={entry.data.readingTime || 5}
  lastModified={entry.data.pubDate}
  content={content}
  collectionTheme="weight-loss"
  thumbnail={entry.data.thumbnail}
>
  <Content />
</ArticleWithAffiliateSidebar>
