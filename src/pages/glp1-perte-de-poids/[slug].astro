---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('glp1-perte-de-poids');
  return entries.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { slug: entry.slug },
  }));
}

const { slug } = Astro.props;
const redirectUrl = `/collections/glp1-perte-de-poids/${slug}/`;
---

<html>
<head>
  <title>Redirection</title>
  <meta http-equiv="refresh" content={`0; url=${redirectUrl}`}>
  <link rel="canonical" href={`https://glp1-france.fr${redirectUrl}`}>
  <meta name="robots" content="noindex, follow">
  <script define:vars={{ redirectUrl }}>window.location.replace(redirectUrl);</script>
</head>
<body>
  <p>Redirection vers <a href={redirectUrl}>cet article</a>...</p>
</body>
</html>
