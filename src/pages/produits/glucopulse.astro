---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutOfStockModal from '../../components/OutOfStockModal.astro';

const productId = 'glucopulse';
const productName = 'GlucoPulse';
const productPrice = 59;
const productOldPrice = 89;
const productDiscount = Math.round(((productOldPrice - productPrice) / productOldPrice) * 100);
---

<BaseLayout
  title="GlucoPulse — Glucomètre connecté Bluetooth, pack démarrage 59€"
  description="Lecteur de glycémie GlucoPulse : résultat 5s, sync Bluetooth iOS/Android, mémoire 500 mesures, précision ±5%. Pack démarrage 59€ (au lieu de 89€), livraison 48h offerte, garantie 2 ans."
  keywords="glucomètre connecté, lecteur glycémie Bluetooth, glycémie smartphone, GlucoPulse"
>
  <!-- ============================================ -->
  <!-- 1. HERO                                      -->
  <!-- ============================================ -->
  <section class="gp-hero">
    <div class="gp-hero-inner">
      <div class="gp-hero-text">
        <span class="gp-pill">Bluetooth · iOS &amp; Android · CE m&eacute;dical</span>
        <h1 class="gp-h1">
          GlucoPulse.<br>
          <span class="gp-h1-accent">Votre glyc&eacute;mie, dans votre poche.</span>
        </h1>
        <p class="gp-hero-sub">
          R&eacute;sultat en <strong>5 secondes</strong>, synchronisation Bluetooth instantan&eacute;e
          avec l'app GlucoPulse (iOS &amp; Android). M&eacute;moire 500 mesures, courbes
          7/14/30 jours, export PDF pour votre m&eacute;decin.
        </p>

        <div class="gp-hero-pricing">
          <div class="gp-price-block">
            <span class="gp-price-old">{productOldPrice}&nbsp;€</span>
            <span class="gp-price-new">{productPrice}&nbsp;€</span>
            <span class="gp-price-discount">−{productDiscount}%</span>
          </div>
          <p class="gp-price-meta">
            Pack d&eacute;marrage : appareil + 50 bandelettes + 50 lancettes + autopiqueur + &eacute;tui
          </p>
        </div>

        <div class="gp-hero-ctas">
          <button
            type="button"
            class="gp-cta-primary"
            data-checkout-trigger
            data-product={productId}
            data-variant="starter-pack"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
            </svg>
            Ajouter au panier
          </button>
          <a href="#demo" class="gp-cta-secondary">Voir la d&eacute;mo ↓</a>
        </div>

        <ul class="gp-trust-row">
          <li><span class="gp-check">✓</span> Livraison 48h offerte</li>
          <li><span class="gp-check">✓</span> Garantie constructeur 2 ans</li>
          <li><span class="gp-check">✓</span> Pr&eacute;cision &plusmn;5% (ISO 15197:2013)</li>
          <li><span class="gp-check">✓</span> Retour 30 jours</li>
        </ul>
      </div>

      <div class="gp-hero-visual">
        <img
          src="/images/glucopulse-hero.png"
          alt="GlucoPulse glucomètre connecté Bluetooth avec son application smartphone"
          class="gp-hero-image"
          width="784"
          height="1168"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 2. TRUST BAR                                 -->
  <!-- ============================================ -->
  <section class="gp-trust-bar">
    <div class="gp-trust-bar-inner">
      <span><strong>CE médical</strong> · ISO 15197:2013</span>
      <span class="gp-sep">·</span>
      <span><strong>RGPD</strong> · hébergement UE</span>
      <span class="gp-sep">·</span>
      <span><strong>Garantie 2 ans</strong></span>
      <span class="gp-sep">·</span>
      <span><strong>Retour 30 jours</strong></span>
      <span class="gp-sep">·</span>
      <span><strong>Support FR</strong></span>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 3. PITCH STORY (image + copy)                -->
  <!-- ============================================ -->
  <section class="gp-section gp-pitch">
    <div class="gp-section-inner gp-pitch-grid">
      <div class="gp-pitch-text">
        <span class="gp-eyebrow">Pourquoi GlucoPulse</span>
        <h2 class="gp-h2">Conçu pour les patients sous traitement GLP-1.</h2>
        <p class="gp-pitch-lede">
          Sous Ozempic, Mounjaro ou Wegovy, les variations glycémiques sont plus fréquentes
          au démarrage du traitement. Mesurer régulièrement permet à votre médecin d'ajuster
          la dose et d'éviter les hypoglycémies. <strong>Mais carnet papier + Excel + photos
          de l'écran, c'est lourd.</strong>
        </p>
        <p class="gp-pitch-lede">
          GlucoPulse synchronise <strong>chaque mesure automatiquement</strong> dans une app
          conçue avec des diabétologues : courbes, alertes hypo/hyper personnalisées selon
          votre traitement, et un PDF prêt à envoyer à Doctolib avant chaque rendez-vous.
        </p>
        <ul class="gp-pitch-bullets">
          <li><span class="gp-check-lg">✓</span> Plus de saisie manuelle, plus d'oubli</li>
          <li><span class="gp-check-lg">✓</span> Alertes adaptées (Ozempic, Mounjaro, Wegovy, Trulicity, Victoza, Rybelsus)</li>
          <li><span class="gp-check-lg">✓</span> Partage médecin en 1 clic (PDF format dossier médical)</li>
        </ul>
      </div>
      <div class="gp-pitch-visual">
        <img
          src="/images/glucopulse-hero.png"
          alt="GlucoPulse posé sur une table avec son application affichée sur smartphone"
          class="gp-pitch-image"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 4. DEMO VIDEO                                -->
  <!-- ============================================ -->
  <section id="demo" class="gp-section gp-section-tinted">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Démo en 6 secondes</span>
        <h2 class="gp-h2">Voyez GlucoPulse en action.</h2>
        <p class="gp-section-lede">
          De la piqûre à l'enregistrement dans l'app, sans toucher au téléphone.
        </p>
      </header>

      <div class="gp-demo-wrap">
        <video
          id="gp-demo-video"
          class="gp-demo-video"
          src="/images/video2.mp4"
          poster="/images/glucopulse-hero.png"
          autoplay loop muted playsinline disablepictureinpicture
          aria-label="Démonstration vidéo de GlucoPulse"
        ></video>
        <script is:inline>
          (function () {
            var v = document.getElementById('gp-demo-video');
            if (!v) return;
            var tryPlay = function () { v.play().catch(function () {}); };
            tryPlay();
            v.addEventListener('canplay', tryPlay);
            if ('IntersectionObserver' in window) {
              var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) { if (e.isIntersecting) tryPlay(); else v.pause(); });
              }, { threshold: 0.2 });
              io.observe(v);
            }
            var unlock = function () { tryPlay(); };
            document.addEventListener('click', unlock, { once: true, passive: true });
            document.addEventListener('touchstart', unlock, { once: true, passive: true });
          })();
        </script>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 5. SPÉCIFICATIONS (features bento)           -->
  <!-- ============================================ -->
  <section id="features" class="gp-section">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Fonctionnalités</span>
        <h2 class="gp-h2">Ce que GlucoPulse fait, concrètement.</h2>
        <p class="gp-section-lede">
          Conçu avec des diabétologues, validé par le marquage CE médical.
        </p>
      </header>

      <div class="gp-features-grid">
        <article class="gp-feat gp-feat-large">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6.5 3l11 9-11 9V3z" transform="rotate(45 12 12)"/>
              <path d="M12 3v18M5 6l14 12M19 6L5 18"/>
            </svg>
          </div>
          <h3>Synchronisation Bluetooth Low Energy 5.2</h3>
          <p>Chaque mesure remonte instantanément dans l'app iOS &amp; Android. Plus de saisie manuelle, plus d'oubli, plus de carnet papier.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3>Résultat en 5 secondes</h3>
          <p>Précision ±5%, conforme ISO 15197:2013. Échantillon de 0,5 µL (la plus petite goutte du marché).</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <h3>Mémoire 500 mesures</h3>
          <p>Historique complet, courbes hebdo &amp; mensuelles, moyennes glissantes 7/14/30 jours, écart-type, % temps dans la cible.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </div>
          <h3>Alertes intelligentes</h3>
          <p>Notifications hypo/hyper personnalisées selon votre traitement (Ozempic, Mounjaro, Wegovy...). Rappels avant repas paramétrables.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3>Partage médecin en 1 clic</h3>
          <p>Export PDF compatible Doctolib / dossier médical. Vos courbes au prochain rendez-vous, sans paperasse.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L4 7l8 5 8-5-8-5z"/><path d="M4 17l8 5 8-5M4 12l8 5 8-5"/>
            </svg>
          </div>
          <h3>Bandelettes économiques</h3>
          <p>0,15 €/bandelette en pack 100 (vs 0,40 € chez la concurrence). Conservation 18 mois après ouverture, codage automatique.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="6" width="20" height="14" rx="2"/><line x1="22" y1="13" x2="22" y2="13"/>
            </svg>
          </div>
          <h3>Batterie 1000 mesures</h3>
          <p>Pile lithium CR2032 (incluse), remplaçable. Indicateur de charge sur l'écran OLED. Sans charge USB.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <h3>Compatible iOS &amp; Android</h3>
          <p>App gratuite (iOS 14+ / Android 9+), mises à jour à vie. Compatible Apple Health et Google Fit.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2 L20 6 V12 C20 16 16 20 12 22 C8 20 4 16 4 12 V6 Z"/><path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h3>Données chiffrées · RGPD</h3>
          <p>Stockage end-to-end encrypted, hébergement UE (OVH France). Vos mesures restent à vous, vous pouvez tout exporter ou supprimer.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 6. COMMENT ÇA MARCHE                         -->
  <!-- ============================================ -->
  <section class="gp-section gp-section-tinted">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Comment ça marche</span>
        <h2 class="gp-h2">3 étapes, 30 secondes max.</h2>
      </header>

      <div class="gp-steps">
        <div class="gp-step">
          <div class="gp-step-num">1</div>
          <h3>Insérez la bandelette</h3>
          <p>L'appareil s'allume automatiquement. Codage auto, pas de calibration manuelle.</p>
        </div>
        <div class="gp-step-arrow" aria-hidden="true">→</div>
        <div class="gp-step">
          <div class="gp-step-num">2</div>
          <h3>Une goutte (0,5 µL)</h3>
          <p>Lancette ajustable 5 niveaux (indolore au minimum). Résultat affiché en 5 sec.</p>
        </div>
        <div class="gp-step-arrow" aria-hidden="true">→</div>
        <div class="gp-step">
          <div class="gp-step-num">3</div>
          <h3>Sync auto vers l'app</h3>
          <p>Bluetooth Low Energy, transfert instantané. Mesure horodatée, prête à exporter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 7. COMPATIBILITÉ TRAITEMENTS GLP-1           -->
  <!-- ============================================ -->
  <section class="gp-section">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Compatibilité traitement</span>
        <h2 class="gp-h2">Conçu pour tous les traitements GLP-1 et antidiabétiques.</h2>
        <p class="gp-section-lede">
          Les seuils d'alerte hypo/hyper sont préconfigurés selon votre traitement.
          Modifiables à tout moment.
        </p>
      </header>

      <div class="gp-compat-grid">
        <div class="gp-compat-item"><strong>Ozempic</strong><span>Sémaglutide · DT2</span></div>
        <div class="gp-compat-item"><strong>Wegovy</strong><span>Sémaglutide · obésité</span></div>
        <div class="gp-compat-item"><strong>Mounjaro</strong><span>Tirzépatide · DT2</span></div>
        <div class="gp-compat-item"><strong>Trulicity</strong><span>Dulaglutide · DT2</span></div>
        <div class="gp-compat-item"><strong>Victoza</strong><span>Liraglutide · DT2</span></div>
        <div class="gp-compat-item"><strong>Rybelsus</strong><span>Sémaglutide oral</span></div>
        <div class="gp-compat-item"><strong>Insuline</strong><span>Lente, rapide, mixte</span></div>
        <div class="gp-compat-item"><strong>Metformine</strong><span>+ iSGLT2, sulfamides</span></div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 8. CONTENU DU PACK                           -->
  <!-- ============================================ -->
  <section class="gp-section gp-section-tinted">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Contenu du pack démarrage</span>
        <h2 class="gp-h2">Tout est inclus, prêt à mesurer dès l'ouverture.</h2>
      </header>

      <div class="gp-pack-grid">
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📟</div>
          <h4>1× Lecteur GlucoPulse</h4>
          <p>Bluetooth LE 5.2, écran OLED 2.4", batterie 1000 mesures, mémoire 500 mesures</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">🩸</div>
          <h4>50× Bandelettes test</h4>
          <p>Codage automatique, conservation 18 mois après ouverture, 0,15 €/bandelette en pack 100</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📍</div>
          <h4>50× Lancettes stériles</h4>
          <p>Calibre 30G ultra-fin, indolore au niveau 1, usage unique</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">🖊️</div>
          <h4>1× Autopiqueur ajustable</h4>
          <p>5 niveaux de profondeur (1 = peau fine, 5 = peau épaisse), nettoyable</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">👜</div>
          <h4>1× Étui de transport</h4>
          <p>Compact, EVA résistant, intérieur compartimenté pour appareil + bandelettes</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📱</div>
          <h4>App iOS &amp; Android</h4>
          <p>Gratuite, sans publicité, mises à jour à vie. Pas de compte obligatoire.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 9. SPECS TECHNIQUES                          -->
  <!-- ============================================ -->
  <section class="gp-section">
    <div class="gp-section-inner gp-section-narrow">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Spécifications techniques</span>
        <h2 class="gp-h2">La fiche technique complète.</h2>
      </header>

      <dl class="gp-specs">
        <div class="gp-spec-row"><dt>Méthode de mesure</dt><dd>Glucose oxydase, électrochimique</dd></div>
        <div class="gp-spec-row"><dt>Plage de mesure</dt><dd>1,1 à 33,3 mmol/L (20 à 600 mg/dL)</dd></div>
        <div class="gp-spec-row"><dt>Précision</dt><dd>±5% (conforme ISO 15197:2013)</dd></div>
        <div class="gp-spec-row"><dt>Temps de mesure</dt><dd>5 secondes</dd></div>
        <div class="gp-spec-row"><dt>Échantillon sanguin</dt><dd>0,5 µL (capillaire frais)</dd></div>
        <div class="gp-spec-row"><dt>Mémoire</dt><dd>500 mesures avec date &amp; heure</dd></div>
        <div class="gp-spec-row"><dt>Connectivité</dt><dd>Bluetooth Low Energy 5.2</dd></div>
        <div class="gp-spec-row"><dt>Écran</dt><dd>OLED 2.4", rétroéclairé</dd></div>
        <div class="gp-spec-row"><dt>Alimentation</dt><dd>1 pile lithium CR2032 (incluse), ~1000 mesures</dd></div>
        <div class="gp-spec-row"><dt>Dimensions</dt><dd>92 × 55 × 16 mm</dd></div>
        <div class="gp-spec-row"><dt>Poids</dt><dd>52 g (sans pile)</dd></div>
        <div class="gp-spec-row"><dt>Conditions d'utilisation</dt><dd>10-40°C, humidité 10-90%</dd></div>
        <div class="gp-spec-row"><dt>Hématocrite supporté</dt><dd>20-60%</dd></div>
        <div class="gp-spec-row"><dt>Codage</dt><dd>Automatique (chip dans la bandelette)</dd></div>
        <div class="gp-spec-row"><dt>Système d'exploitation app</dt><dd>iOS 14+, Android 9+</dd></div>
        <div class="gp-spec-row"><dt>Marquage</dt><dd>CE médical (dispositif médical de classe IIb)</dd></div>
        <div class="gp-spec-row"><dt>Norme</dt><dd>ISO 15197:2013</dd></div>
      </dl>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 10. COMPARATIF                               -->
  <!-- ============================================ -->
  <section class="gp-section gp-section-tinted">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Comparatif</span>
        <h2 class="gp-h2">GlucoPulse vs les autres lecteurs du marché.</h2>
      </header>

      <div class="gp-compare-wrap">
        <table class="gp-compare-table">
          <thead>
            <tr>
              <th></th>
              <th class="gp-col-us">GlucoPulse</th>
              <th>Sinocare Safe AQ</th>
              <th>Accu-Chek Instant</th>
              <th>FreeStyle Libre 2</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Prix pack démarrage</td><td class="gp-col-us"><strong>59 €</strong></td><td>32 €</td><td>49 €</td><td>59 €/14j</td></tr>
            <tr><td>App smartphone</td><td class="gp-col-us">✓ iOS &amp; Android</td><td>✓</td><td>✓</td><td>✓</td></tr>
            <tr><td>Mémoire mesures</td><td class="gp-col-us"><strong>500</strong></td><td>500</td><td>720</td><td>90 jours</td></tr>
            <tr><td>Précision (norme ISO)</td><td class="gp-col-us">±5%</td><td>±10%</td><td>±5%</td><td>±9%</td></tr>
            <tr><td>Échantillon sanguin</td><td class="gp-col-us"><strong>0,5 µL</strong></td><td>0,7 µL</td><td>0,6 µL</td><td>—</td></tr>
            <tr><td>Garantie</td><td class="gp-col-us"><strong>2 ans</strong></td><td>1 an</td><td>2 ans</td><td>—</td></tr>
            <tr><td>Bandelettes (unité)</td><td class="gp-col-us"><strong>0,15 €</strong></td><td>0,18 €</td><td>0,40 €</td><td>—</td></tr>
            <tr><td>Export PDF médecin</td><td class="gp-col-us">✓</td><td>—</td><td>—</td><td>✓</td></tr>
            <tr><td>Apple Health / Google Fit</td><td class="gp-col-us">✓</td><td>—</td><td>✓</td><td>✓</td></tr>
            <tr><td>Hébergement données</td><td class="gp-col-us"><strong>UE (France)</strong></td><td>Chine</td><td>Suisse</td><td>USA</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- 11. SÉCURITÉ & CONFIDENTIALITÉ               -->
  <!-- ============================================ -->
  <section class="gp-section">
    <div class="gp-section-inner gp-section-narrow">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Sécurité &amp; confidentialité</span>
