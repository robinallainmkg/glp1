---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutOfStockModal from '../../components/OutOfStockModal.astro';

const productId = 'glucopulse';
const productName = 'GlucoPulse';
const productPrice = 59;
const productOldPrice = 89;
const productDiscount = Math.round(((productOldPrice - productPrice) / productOldPrice) * 100);
---

<BaseLayout
  title="GlucoPulse — Glucomètre connecté Bluetooth, pack démarrage 59€"
  description="Lecteur de glycémie GlucoPulse : résultat 5s, sync Bluetooth iOS/Android, mémoire 500 mesures, précision ±5%. Pack démarrage 59€ (au lieu de 89€), livraison 48h offerte, garantie 2 ans."
  keywords="glucomètre connecté, lecteur glycémie Bluetooth, glycémie smartphone, GlucoPulse"
>
  <!-- ============================================ -->
  <!-- HERO                                         -->
  <!-- ============================================ -->
  <section class="gp-hero">
    <div class="gp-hero-inner">
      <div class="gp-hero-text">
        <span class="gp-pill">Bluetooth · iOS &amp; Android · CE m&eacute;dical</span>
        <h1 class="gp-h1">
          GlucoPulse.<br>
          <span class="gp-h1-accent">Votre glyc&eacute;mie, dans votre poche.</span>
        </h1>
        <p class="gp-hero-sub">
          R&eacute;sultat en <strong>5 secondes</strong>, synchronisation Bluetooth instantan&eacute;e
          avec l'app GlucoPulse (iOS &amp; Android). M&eacute;moire 500 mesures, courbes
          7/14/30 jours, export PDF pour votre m&eacute;decin.
        </p>

        <div class="gp-hero-pricing">
          <div class="gp-price-block">
            <span class="gp-price-old">{productOldPrice}&nbsp;€</span>
            <span class="gp-price-new">{productPrice}&nbsp;€</span>
            <span class="gp-price-discount">−{productDiscount}%</span>
          </div>
          <p class="gp-price-meta">
            Pack d&eacute;marrage : appareil + 50 bandelettes + 50 lancettes + autopiqueur + &eacute;tui
          </p>
        </div>

        <div class="gp-hero-ctas">
          <button
            type="button"
            class="gp-cta-primary"
            data-checkout-trigger
            data-product={productId}
            data-variant="starter-pack"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-8 2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
            </svg>
            Ajouter au panier
          </button>
          <a href="#features" class="gp-cta-secondary">Voir les sp&eacute;cifications ↓</a>
        </div>

        <ul class="gp-trust-row">
          <li><span class="gp-check">✓</span> Livraison 48h offerte</li>
          <li><span class="gp-check">✓</span> Garantie constructeur 2 ans</li>
          <li><span class="gp-check">✓</span> Pr&eacute;cision &plusmn;5% (ISO 15197:2013)</li>
          <li><span class="gp-check">✓</span> Retour 30 jours</li>
        </ul>
      </div>

      <div class="gp-hero-visual">
        <!-- Photo produit + vidéo loop (autoplay muted) ; SVG conservé en fallback ci-dessous, supprimable plus tard -->
        <video
          id="gp-hero-video"
          class="gp-mockup gp-mockup-video"
          src="/images/video2.mp4"
          poster="/images/glucopulse-hero.png"
          autoplay
          loop
          muted
          playsinline
          disablepictureinpicture
          aria-label="GlucoPulse, glucomètre connecté Bluetooth en démonstration"
        ></video>
        <script is:inline>
          (function () {
            var v = document.getElementById('gp-hero-video');
            if (!v) return;
            // Force la lecture (Chrome bloque parfois autoplay même sur muted)
            var tryPlay = function () { v.play().catch(function () {}); };
            tryPlay();
            v.addEventListener('canplay', tryPlay);
            // Pause hors viewport pour économiser batterie/CPU
            if ('IntersectionObserver' in window) {
              var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                  if (e.isIntersecting) tryPlay();
                  else v.pause();
                });
              }, { threshold: 0.15 });
              io.observe(v);
            }
            // Premier clic anywhere = play (au cas où autoplay reste bloqué)
            var unlock = function () {
              tryPlay();
              document.removeEventListener('click', unlock);
              document.removeEventListener('touchstart', unlock);
            };
            document.addEventListener('click', unlock, { once: true, passive: true });
            document.addEventListener('touchstart', unlock, { once: true, passive: true });
          })();
        </script>

        <!-- Fallback SVG (caché par CSS quand la vidéo est présente) — ancien mockup vectoriel -->
        <svg class="gp-mockup gp-mockup-svg" viewBox="0 0 560 520" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <!-- Plastique blanc avec dégradé subtil top→bottom -->
            <linearGradient id="g-body" x1="50%" y1="0%" x2="50%" y2="100%">
              <stop offset="0%" stop-color="#ffffff"/>
              <stop offset="50%" stop-color="#f1f5f9"/>
              <stop offset="100%" stop-color="#cbd5e1"/>
            </linearGradient>
            <!-- Reflet glossy sur le corps -->
            <linearGradient id="g-gloss" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.65"/>
              <stop offset="40%" stop-color="#ffffff" stop-opacity="0"/>
            </linearGradient>
            <!-- Écran LCD vert sombre avec léger dégradé -->
            <linearGradient id="g-screen" x1="50%" y1="0%" x2="50%" y2="100%">
              <stop offset="0%" stop-color="#0a1f1a"/>
              <stop offset="50%" stop-color="#102a23"/>
              <stop offset="100%" stop-color="#0a1f1a"/>
            </linearGradient>
            <!-- Reflet sur l'écran -->
            <linearGradient id="g-screen-reflect" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#6ee7a0" stop-opacity="0.18"/>
              <stop offset="40%" stop-color="#6ee7a0" stop-opacity="0"/>
            </linearGradient>
            <!-- Smartphone body : aluminium dark -->
            <linearGradient id="g-phone-frame" x1="50%" y1="0%" x2="50%" y2="100%">
              <stop offset="0%" stop-color="#3f3f46"/>
              <stop offset="100%" stop-color="#18181b"/>
            </linearGradient>
            <!-- App graph fill -->
            <linearGradient id="g-graph" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#16a34a" stop-opacity="0.4"/>
              <stop offset="100%" stop-color="#16a34a" stop-opacity="0"/>
            </linearGradient>
            <!-- Bouton power vert glossy -->
            <radialGradient id="g-button-power" cx="35%" cy="30%" r="80%">
              <stop offset="0%" stop-color="#86efac"/>
              <stop offset="60%" stop-color="#22c55e"/>
              <stop offset="100%" stop-color="#15803d"/>
            </radialGradient>
            <!-- Background ambient -->
            <radialGradient id="g-ambient" cx="55%" cy="40%" r="65%">
              <stop offset="0%" stop-color="#6ee7a0" stop-opacity="0.22"/>
              <stop offset="100%" stop-color="#6ee7a0" stop-opacity="0"/>
            </radialGradient>
            <!-- Ombre douce profonde -->
            <filter id="f-shadow-deep" x="-30%" y="-30%" width="160%" height="160%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="14"/>
              <feOffset dx="0" dy="22" result="off"/>
              <feFlood flood-color="#0a1f1a" flood-opacity="0.42"/>
              <feComposite in2="off" operator="in"/>
              <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="f-shadow-soft" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="8"/>
              <feOffset dx="0" dy="10" result="off"/>
              <feFlood flood-color="#0a1f1a" flood-opacity="0.28"/>
              <feComposite in2="off" operator="in"/>
              <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>

          <!-- Ambient glow background -->
          <circle cx="320" cy="240" r="280" fill="url(#g-ambient)"/>

          <!-- ============= SMARTPHONE (back-left, smaller, partial visible) ============= -->
          <g transform="translate(20 80) rotate(-8 110 200)" filter="url(#f-shadow-soft)">
            <!-- Phone aluminium frame -->
            <rect x="0" y="0" width="220" height="400" rx="32" fill="url(#g-phone-frame)"/>
            <!-- Screen black -->
            <rect x="6" y="6" width="208" height="388" rx="26" fill="#000"/>
            <!-- App background white -->
            <rect x="10" y="10" width="200" height="380" rx="24" fill="#fafafa"/>
            <!-- Dynamic island -->
            <rect x="78" y="22" width="64" height="20" rx="10" fill="#000"/>

            <!-- Status bar -->
            <text x="22" y="62" font-family="-apple-system, SF Pro, sans-serif" font-size="11" font-weight="600" fill="#1f2937">9:41</text>
            <g transform="translate(178 56)" fill="#1f2937">
              <rect x="0" y="-8" width="3" height="8" rx="0.5"/>
              <rect x="5" y="-6" width="3" height="6" rx="0.5"/>
              <rect x="10" y="-4" width="3" height="4" rx="0.5"/>
              <rect x="22" y="-9" width="20" height="10" rx="2" fill="none" stroke="#1f2937" stroke-width="1"/>
              <rect x="24" y="-7" width="13" height="6" rx="1"/>
            </g>

            <!-- App header -->
            <text x="22" y="100" font-family="-apple-system, SF Pro, sans-serif" font-size="15" font-weight="800" fill="#0a1f1a" letter-spacing="-0.3">GlucoPulse</text>

            <!-- Last measure card -->
            <rect x="18" y="118" width="184" height="100" rx="14" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1"/>
            <text x="28" y="138" font-family="-apple-system, SF Pro, sans-serif" font-size="8" font-weight="700" fill="#166534" letter-spacing="0.6">DERNIÈRE MESURE</text>
            <text x="28" y="184" font-family="-apple-system, SF Pro, sans-serif" font-size="44" font-weight="900" fill="#15803d" letter-spacing="-1.5">5.6</text>
            <text x="120" y="184" font-family="-apple-system, SF Pro, sans-serif" font-size="13" font-weight="600" fill="#15803d">mmol/L</text>
            <g transform="translate(28 196)">
              <circle cx="5" cy="5" r="5" fill="#16a34a"/>
              <text x="14" y="9" font-family="-apple-system, SF Pro, sans-serif" font-size="9" font-weight="600" fill="#15803d">Dans la cible · il y a 12 min</text>
            </g>

            <!-- Graph card -->
            <rect x="18" y="232" width="184" height="92" rx="12" fill="#fff" stroke="#e5e7eb" stroke-width="1"/>
            <text x="28" y="252" font-family="-apple-system, SF Pro, sans-serif" font-size="8" font-weight="700" fill="#6b7280" letter-spacing="0.6">7 DERNIERS JOURS</text>
            <path d="M28 305 L 52 290 L 76 274 L 100 296 L 124 264 L 148 282 L 172 270 L 192 274 L 192 318 L 28 318 Z" fill="url(#g-graph)"/>
            <path d="M28 305 L 52 290 L 76 274 L 100 296 L 124 264 L 148 282 L 172 270 L 192 274" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <g fill="#fff" stroke="#16a34a" stroke-width="1.5">
              <circle cx="124" cy="264" r="3"/>
            </g>

            <!-- Bottom tabs -->
            <rect x="18" y="338" width="184" height="32" rx="10" fill="#f3f4f6"/>
            <rect x="22" y="342" width="58" height="24" rx="8" fill="#fff"/>
            <text x="51" y="358" font-family="-apple-system, SF Pro, sans-serif" font-size="9" font-weight="700" fill="#16a34a" text-anchor="middle">Mesures</text>
            <text x="115" y="358" font-family="-apple-system, SF Pro, sans-serif" font-size="9" font-weight="500" fill="#6b7280" text-anchor="middle">Repas</text>
            <text x="170" y="358" font-family="-apple-system, SF Pro, sans-serif" font-size="9" font-weight="500" fill="#6b7280" text-anchor="middle">Médecin</text>
          </g>

          <!-- ============= GLUCOMETER (front, hero piece) ============= -->
          <g transform="translate(225 70) rotate(6 130 200)" filter="url(#f-shadow-deep)">
            <!-- Main body : white plastic with subtle gradient -->
            <rect x="0" y="0" width="280" height="400" rx="40" fill="url(#g-body)"/>
            <!-- Top accent : green strip = brand identity -->
            <rect x="0" y="0" width="280" height="14" rx="40" fill="#16a34a"/>
            <rect x="0" y="6" width="280" height="8" fill="#16a34a"/>
            <!-- Subtle highlight on top edge -->
            <rect x="20" y="14" width="240" height="1" fill="#fff" opacity="0.7"/>

            <!-- Brand -->
            <text x="28" y="48" font-family="-apple-system, SF Pro, sans-serif" font-size="13" font-weight="800" fill="#0a1f1a" letter-spacing="0.3">GlucoPulse</text>
            <text x="28" y="62" font-family="-apple-system, SF Pro, sans-serif" font-size="8" font-weight="500" fill="#6b7280" letter-spacing="1">CONNECTED · ISO 15197</text>
            <!-- Bluetooth indicator -->
            <g transform="translate(244 42)">
              <circle cx="0" cy="0" r="11" fill="#dcfce7"/>
              <path d="M-3 -5 L 3 1 L -1 4 L -1 -4 L 3 -1 L -3 5" stroke="#16a34a" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </g>

            <!-- BIG SCREEN — réaliste avec bordure intérieure + reflet -->
            <rect x="24" y="80" width="232" height="148" rx="14" fill="#1f2937"/>
            <rect x="28" y="84" width="224" height="140" rx="11" fill="url(#g-screen)"/>
            <!-- Subtle screen reflection (top-left diagonal) -->
            <rect x="28" y="84" width="224" height="140" rx="11" fill="url(#g-screen-reflect)"/>
            <!-- Status icons in screen top -->
            <g transform="translate(40 100)" fill="#6ee7a0" opacity="0.55">
              <rect x="0" y="0" width="2" height="6" rx="0.5"/>
              <rect x="3" y="-1" width="2" height="7" rx="0.5"/>
              <rect x="6" y="-2" width="2" height="8" rx="0.5"/>
              <rect x="9" y="-3" width="2" height="9" rx="0.5"/>
            </g>
            <text x="240" y="106" font-family="-apple-system, SF Pro, sans-serif" font-size="9" font-weight="500" fill="#6ee7a0" opacity="0.55" text-anchor="end">09:41 · BLE</text>
            <!-- Big value -->
            <text x="140" y="170" font-family="-apple-system, SF Pro, sans-serif" font-size="58" font-weight="900" fill="#86efac" text-anchor="middle" letter-spacing="-2">5.6</text>
            <text x="140" y="194" font-family="-apple-system, SF Pro, sans-serif" font-size="14" font-weight="600" fill="#bbf7d0" text-anchor="middle">mmol/L · dans la cible</text>
            <text x="140" y="214" font-family="-apple-system, SF Pro, sans-serif" font-size="9" font-weight="500" fill="#6ee7a0" opacity="0.65" text-anchor="middle">SYNCHRONISÉ AVEC L'APP</text>

            <!-- Buttons row : power (gloss green) + memory (brushed) -->
            <g transform="translate(72 280)" filter="url(#f-shadow-soft)">
              <circle cx="0" cy="0" r="26" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
              <circle cx="0" cy="0" r="20" fill="url(#g-button-power)"/>
              <circle cx="-5" cy="-6" r="6" fill="#fff" opacity="0.4"/>
              <path d="M-6 -2 L -6 4 M 0 -6 L 0 6 M 6 -2 L 6 4" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity="0.85" transform="scale(0.7)"/>
            </g>
            <g transform="translate(208 280)">
              <circle cx="0" cy="0" r="26" fill="#fff" stroke="#cbd5e1" stroke-width="1"/>
              <circle cx="0" cy="0" r="20" fill="#f8fafc" stroke="#e5e7eb" stroke-width="1"/>
              <text x="0" y="6" font-family="-apple-system, SF Pro, sans-serif" font-size="14" font-weight="800" fill="#475569" text-anchor="middle">M</text>
            </g>

            <!-- Test strip slot (réaliste avec bandelette qui dépasse) -->
            <rect x="118" y="332" width="44" height="50" rx="4" fill="#0a1f1a"/>
            <rect x="124" y="338" width="32" height="4" rx="1" fill="#fbbf24"/>
            <rect x="124" y="344" width="32" height="4" rx="1" fill="#fbbf24" opacity="0.6"/>
            <text x="140" y="395" font-family="-apple-system, SF Pro, sans-serif" font-size="6" font-weight="500" fill="#9ca3af" text-anchor="middle" letter-spacing="0.5">TEST STRIP PORT</text>

            <!-- Glossy highlight overlay (top-left soft) -->
            <rect x="0" y="14" width="280" height="386" rx="40" fill="url(#g-gloss)" pointer-events="none"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- TRUST BAR                                    -->
  <!-- ============================================ -->
  <section class="gp-trust-bar">
    <div class="gp-trust-bar-inner">
      <span><strong>CE médical</strong> · ISO 15197:2013</span>
      <span class="gp-sep">·</span>
      <span><strong>RGPD</strong> · hébergement UE</span>
      <span class="gp-sep">·</span>
      <span><strong>Garantie 2 ans</strong></span>
      <span class="gp-sep">·</span>
      <span><strong>Retour 30 jours</strong></span>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FEATURES BENTO                               -->
  <!-- ============================================ -->
  <section id="features" class="gp-section">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Spécifications</span>
        <h2 class="gp-h2">Ce que GlucoPulse fait, concrètement.</h2>
        <p class="gp-section-lede">
          Six fonctions qui changent le suivi quotidien sous Ozempic, Mounjaro,
          Wegovy, Trulicity, Victoza ou Rybelsus.
        </p>
      </header>

      <div class="gp-features-grid">
        <article class="gp-feat gp-feat-large">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6.5 3l11 9-11 9V3z" transform="rotate(45 12 12)"/>
              <path d="M12 3v18M5 6l14 12M19 6L5 18"/>
            </svg>
          </div>
          <h3>Synchronisation Bluetooth automatique</h3>
          <p>Chaque mesure remonte instantanément dans l'app iOS &amp; Android. Plus de saisie manuelle, plus d'oubli.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3>Résultat en 5 secondes</h3>
          <p>Précision ±5%, conforme ISO 15197:2013. Échantillon de 0,5 µL.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <h3>Mémoire 500 mesures</h3>
          <p>Historique complet, courbes hebdo &amp; mensuelles, moyennes glissantes 7/14/30 jours.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3>Alertes intelligentes</h3>
          <p>Notifications hypo/hyper, rappels avant repas, suivi adapté à votre traitement (Ozempic, Mounjaro...).</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3>Partage médecin en 1 clic</h3>
          <p>Export PDF compatible Doctolib / dossier médical. Vos courbes au prochain rendez-vous, sans paperasse.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L4 7l8 5 8-5-8-5z"/><path d="M4 17l8 5 8-5M4 12l8 5 8-5"/>
            </svg>
          </div>
          <h3>Bandelettes économiques</h3>
          <p>0,15 €/bandelette en pack 100 (vs 0,40 € chez la concurrence). Disponibles en pharmacie.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PACK CONTENTS                                -->
  <!-- ============================================ -->
  <section class="gp-section gp-section-tinted">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Contenu du pack démarrage</span>
        <h2 class="gp-h2">Tout est inclus, prêt à mesurer dès l'ouverture.</h2>
      </header>

      <div class="gp-pack-grid">
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📟</div>
          <h4>1× Lecteur GlucoPulse</h4>
          <p>Bluetooth Low Energy, écran OLED, batterie 1000 mesures</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">🩸</div>
          <h4>50× Bandelettes test</h4>
          <p>Codage automatique, conservation 18 mois</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📍</div>
          <h4>50× Lancettes stériles</h4>
          <p>Calibre 30G, indolore</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">🖊️</div>
          <h4>1× Autopiqueur ajustable</h4>
          <p>5 niveaux de profondeur</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">👜</div>
          <h4>1× Étui de transport</h4>
          <p>Compact, EVA résistant</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📱</div>
          <h4>App iOS &amp; Android</h4>
          <p>Gratuite, mises à jour à vie</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- COMPARISON                                   -->
  <!-- ============================================ -->
  <section class="gp-section">
