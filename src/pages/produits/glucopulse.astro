---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OutOfStockModal from '../../components/OutOfStockModal.astro';

const productId = 'glucopulse';
const productName = 'GlucoPulse';
const productPrice = 59;
const productOldPrice = 89;
const productDiscount = Math.round(((productOldPrice - productPrice) / productOldPrice) * 100);
---

<BaseLayout
  title="Notre sélection : GlucoPulse, glucomètre connecté pour GLP-1 | GLP-1 France"
  description="Après comparatif des principaux lecteurs de glycémie, voici celui que nous recommandons aux patients sous GLP-1. Pré-lancement S2 2026, accès anticipé sur inscription."
  keywords="glucomètre connecté GLP-1, lecteur glycémie patients diabète, sélection GLP1 France, GlucoPulse"
>
  <!-- Bandeau "early access" — assume pleinement le statut pré-lancement -->
  <div class="gp-banner">
    <div class="gp-banner-inner">
      <span class="gp-banner-dot"></span>
      <span><strong>Sélection GLP1 France</strong> · Pré-lancement S2 2026 · accès anticipé sur inscription</span>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- HERO                                         -->
  <!-- ============================================ -->
  <section class="gp-hero">
    <div class="gp-hero-inner">
      <div class="gp-hero-text">
        <span class="gp-pill">Notre recommandation après comparatif</span>
        <h1 class="gp-h1">
          Le glucomètre connecté<br>
          <span class="gp-h1-accent">qu'on recommande aux patients sous GLP-1.</span>
        </h1>
        <p class="gp-hero-sub">
          Après avoir testé les principaux lecteurs (Sinocare, Accu-Chek, FreeStyle),
          on a conçu <strong>GlucoPulse</strong> pour le profil que vous nous décrivez :
          quelqu'un sous Ozempic, Mounjaro ou Wegovy qui veut suivre sa glycémie
          sans Excel. Sortie prévue S2 2026.
        </p>

        <div class="gp-hero-pricing">
          <div class="gp-price-block">
            <span class="gp-price-old">{productOldPrice}&nbsp;€</span>
            <span class="gp-price-new">{productPrice}&nbsp;€</span>
            <span class="gp-price-discount">Tarif accès anticipé</span>
          </div>
          <p class="gp-price-meta">
            Pack démarrage : appareil + 50 bandelettes + autopiqueur + étui · Livraison offerte
          </p>
        </div>

        <div class="gp-hero-ctas">
          <button
            type="button"
            class="gp-cta-primary"
            data-checkout-trigger
            data-product={productId}
            data-variant="starter-pack"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01" transform="translate(-3 0)"/>
            </svg>
            Pré-réserver ma place
          </button>
          <a href="#features" class="gp-cta-secondary">Voir les fonctionnalités ↓</a>
        </div>

        <ul class="gp-trust-row">
          <li><span class="gp-check">✓</span> Aucun engagement, aucun paiement</li>
          <li><span class="gp-check">✓</span> Tarif anticipé garanti</li>
          <li><span class="gp-check">✓</span> Marquage CE médical</li>
          <li><span class="gp-check">✓</span> Notification dès la dispo</li>
        </ul>
      </div>

      <div class="gp-hero-visual">
        <!-- Mockup device + smartphone (SVG inline, scalable, zero load time) -->
        <svg class="gp-mockup" viewBox="0 0 540 480" xmlns="http://www.w3.org/2000/svg" aria-label="GlucoPulse glucomètre connecté avec son application smartphone">
          <defs>
            <linearGradient id="gp-bg-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#6ee7a0" stop-opacity="0.4"/>
              <stop offset="100%" stop-color="#6ee7a0" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="gp-device-body" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#fafafa"/>
              <stop offset="100%" stop-color="#e5e7eb"/>
            </linearGradient>
            <linearGradient id="gp-screen" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#0f2e27"/>
              <stop offset="100%" stop-color="#1a3c34"/>
            </linearGradient>
            <linearGradient id="gp-phone-body" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#1f2937"/>
              <stop offset="100%" stop-color="#111827"/>
            </linearGradient>
            <linearGradient id="gp-graph" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#16a34a" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="#16a34a" stop-opacity="0.05"/>
            </linearGradient>
            <filter id="gp-shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur in="SourceAlpha" stdDeviation="12"/>
              <feOffset dx="0" dy="14" result="off"/>
              <feFlood flood-color="#0f2e27" flood-opacity="0.32"/>
              <feComposite in2="off" operator="in"/>
              <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>

          <!-- Background glow -->
          <ellipse cx="270" cy="240" rx="260" ry="220" fill="url(#gp-bg-glow)"/>

          <!-- ============= SMARTPHONE (back-left) ============= -->
          <g transform="translate(40 40) rotate(-6 130 220)" filter="url(#gp-shadow)">
            <!-- Phone body -->
            <rect x="0" y="0" width="260" height="440" rx="34" fill="url(#gp-phone-body)" stroke="#0b0f17" stroke-width="2"/>
            <!-- Screen -->
            <rect x="10" y="10" width="240" height="420" rx="26" fill="#fafafa"/>
            <!-- Notch -->
            <rect x="100" y="20" width="60" height="14" rx="7" fill="#111827"/>
            <!-- Status bar -->
            <text x="22" y="56" font-family="-apple-system, sans-serif" font-size="11" font-weight="600" fill="#1f2937">9:41</text>
            <g transform="translate(210 50)" fill="#1f2937">
              <rect x="0" y="-8" width="3" height="8" rx="0.5"/>
              <rect x="5" y="-6" width="3" height="6" rx="0.5"/>
              <rect x="10" y="-4" width="3" height="4" rx="0.5"/>
              <rect x="20" y="-9" width="22" height="11" rx="2" fill="none" stroke="#1f2937" stroke-width="1"/>
              <rect x="22" y="-7" width="14" height="7" rx="1"/>
            </g>

            <!-- App header -->
            <text x="22" y="92" font-family="-apple-system, sans-serif" font-size="16" font-weight="800" fill="#1a3c34" letter-spacing="-0.3">GlucoPulse</text>
            <text x="22" y="110" font-family="-apple-system, sans-serif" font-size="9" font-weight="500" fill="#6b7280" letter-spacing="0.5">AUJOURD'HUI</text>

            <!-- Big number card -->
            <rect x="20" y="124" width="220" height="120" rx="14" fill="#f0fdf4" stroke="#bbf7d0" stroke-width="1"/>
            <text x="30" y="148" font-family="-apple-system, sans-serif" font-size="9" font-weight="600" fill="#166534" letter-spacing="0.5">DERNIÈRE MESURE</text>
            <text x="30" y="200" font-family="-apple-system, sans-serif" font-size="56" font-weight="900" fill="#166534" letter-spacing="-2">5.6</text>
            <text x="156" y="200" font-family="-apple-system, sans-serif" font-size="14" font-weight="600" fill="#166534">mmol/L</text>
            <g transform="translate(30 215)">
              <circle cx="6" cy="6" r="6" fill="#16a34a"/>
              <text x="18" y="10" font-family="-apple-system, sans-serif" font-size="10" font-weight="600" fill="#15803d">Dans la cible · il y a 12 min</text>
            </g>

            <!-- Graph -->
            <text x="22" y="272" font-family="-apple-system, sans-serif" font-size="9" font-weight="600" fill="#6b7280" letter-spacing="0.5">7 DERNIERS JOURS</text>
            <rect x="20" y="282" width="220" height="100" rx="10" fill="#fff" stroke="#e5e7eb" stroke-width="1"/>
            <!-- Graph fill -->
            <path d="M30 360 L 60 340 L 90 320 L 120 348 L 150 308 L 180 332 L 210 318 L 230 322 L 230 374 L 30 374 Z" fill="url(#gp-graph)"/>
            <!-- Graph line -->
            <path d="M30 360 L 60 340 L 90 320 L 120 348 L 150 308 L 180 332 L 210 318 L 230 322" fill="none" stroke="#16a34a" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            <!-- Data points -->
            <g fill="#16a34a">
              <circle cx="30" cy="360" r="2.4"/>
              <circle cx="60" cy="340" r="2.4"/>
              <circle cx="90" cy="320" r="2.4"/>
              <circle cx="120" cy="348" r="2.4"/>
              <circle cx="150" cy="308" r="2.4" stroke="#fff" stroke-width="1.5"/>
              <circle cx="180" cy="332" r="2.4"/>
              <circle cx="210" cy="318" r="2.4"/>
              <circle cx="230" cy="322" r="2.4"/>
            </g>
            <!-- Axis labels -->
            <g font-family="-apple-system, sans-serif" font-size="7" fill="#9ca3af">
              <text x="28" y="392">L</text><text x="58" y="392">M</text><text x="88" y="392">M</text><text x="118" y="392">J</text><text x="148" y="392">V</text><text x="178" y="392">S</text><text x="208" y="392">D</text>
            </g>

            <!-- Bottom: tabs -->
            <g transform="translate(20 400)">
              <rect x="0" y="0" width="220" height="28" rx="10" fill="#f3f4f6"/>
              <text x="22" y="18" font-family="-apple-system, sans-serif" font-size="10" font-weight="600" fill="#16a34a">Mesures</text>
              <text x="92" y="18" font-family="-apple-system, sans-serif" font-size="10" font-weight="500" fill="#6b7280">Repas</text>
              <text x="142" y="18" font-family="-apple-system, sans-serif" font-size="10" font-weight="500" fill="#6b7280">Médecin</text>
            </g>
          </g>

          <!-- ============= GLUCOMETER (front-right) ============= -->
          <g transform="translate(265 130) rotate(8 110 160)" filter="url(#gp-shadow)">
            <!-- Body -->
            <rect x="0" y="0" width="220" height="320" rx="32" fill="url(#gp-device-body)" stroke="#cbd5e1" stroke-width="1.5"/>
            <!-- Top accent strip -->
            <rect x="0" y="0" width="220" height="8" rx="32" fill="#16a34a"/>
            <rect x="0" y="3" width="220" height="6" fill="#16a34a"/>

            <!-- Brand -->
            <text x="20" y="36" font-family="-apple-system, sans-serif" font-size="11" font-weight="800" fill="#1a3c34" letter-spacing="0.5">GlucoPulse</text>
            <!-- Bluetooth icon -->
            <g transform="translate(190 24)" stroke="#16a34a" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M0 0 L 8 8 L 4 12 L 4 -4 L 8 0 L 0 8"/>
            </g>

            <!-- Big screen -->
            <rect x="22" y="58" width="176" height="120" rx="10" fill="url(#gp-screen)"/>
            <!-- Screen content : value -->
            <text x="110" y="120" font-family="-apple-system, sans-serif" font-size="44" font-weight="900" fill="#6ee7a0" text-anchor="middle" letter-spacing="-1">5.6</text>
            <text x="110" y="142" font-family="-apple-system, sans-serif" font-size="11" font-weight="600" fill="#bbf7d0" text-anchor="middle">mmol/L</text>
            <text x="110" y="160" font-family="-apple-system, sans-serif" font-size="8" font-weight="500" fill="#6ee7a0" opacity="0.7" text-anchor="middle">DANS LA CIBLE  ·  09:41</text>

            <!-- Buttons -->
            <circle cx="60" cy="220" r="22" fill="#fafafa" stroke="#cbd5e1" stroke-width="1"/>
            <circle cx="60" cy="220" r="14" fill="#fff" stroke="#16a34a" stroke-width="1.5"/>
            <circle cx="160" cy="220" r="22" fill="#fafafa" stroke="#cbd5e1" stroke-width="1"/>
            <text x="160" y="225" font-family="-apple-system, sans-serif" font-size="14" font-weight="700" fill="#6b7280" text-anchor="middle">M</text>

            <!-- Test strip slot -->
            <rect x="84" y="270" width="52" height="42" rx="6" fill="#1a3c34"/>
            <rect x="92" y="278" width="36" height="6" rx="2" fill="#fbbf24"/>
            <rect x="92" y="288" width="36" height="6" rx="2" fill="#fbbf24" opacity="0.6"/>

            <!-- Bottom shadow line -->
            <rect x="20" y="300" width="180" height="1" fill="#cbd5e1" opacity="0.5"/>
          </g>
        </svg>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- TRUST BAR                                    -->
  <!-- ============================================ -->
  <section class="gp-trust-bar">
    <div class="gp-trust-bar-inner">
      <span><strong>CE médical</strong> · ISO 15197:2013</span>
      <span class="gp-sep">·</span>
      <span><strong>RGPD</strong> · données santé chiffrées</span>
      <span class="gp-sep">·</span>
      <span><strong>Conçu en UE</strong> · made in France</span>
      <span class="gp-sep">·</span>
      <span><strong>Garantie 2 ans</strong> · retour 30 jours</span>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FEATURES BENTO                               -->
  <!-- ============================================ -->
  <section id="features" class="gp-section">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Fonctionnalités</span>
        <h2 class="gp-h2">Tout ce qu'un patient sous GLP-1 attend d'un glucomètre.</h2>
        <p class="gp-section-lede">
          Simple à utiliser, précis, et qui parle à votre smartphone. Pas besoin
          d'être ingénieur pour suivre votre glycémie au quotidien.
        </p>
      </header>

      <div class="gp-features-grid">
        <article class="gp-feat gp-feat-large">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6.5 3l11 9-11 9V3z" transform="rotate(45 12 12)"/>
              <path d="M12 3v18M5 6l14 12M19 6L5 18"/>
            </svg>
          </div>
          <h3>Synchronisation Bluetooth automatique</h3>
          <p>Chaque mesure remonte instantanément dans l'app iOS &amp; Android. Plus de saisie manuelle, plus d'oubli.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <h3>Résultat en 5 secondes</h3>
          <p>Précision ±5%, conforme ISO 15197:2013. Échantillon de 0,5 µL.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <h3>Mémoire 500 mesures</h3>
          <p>Historique complet, courbes hebdo &amp; mensuelles, moyennes glissantes 7/14/30 jours.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h3>Alertes intelligentes</h3>
          <p>Notifications hypo/hyper, rappels avant repas, suivi adapté à votre traitement (Ozempic, Mounjaro...).</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3>Partage médecin en 1 clic</h3>
          <p>Export PDF compatible Doctolib / dossier médical. Vos courbes au prochain rendez-vous, sans paperasse.</p>
        </article>

        <article class="gp-feat">
          <div class="gp-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L4 7l8 5 8-5-8-5z"/><path d="M4 17l8 5 8-5M4 12l8 5 8-5"/>
            </svg>
          </div>
          <h3>Bandelettes économiques</h3>
          <p>0,15 €/bandelette en pack 100 (vs 0,40 € chez la concurrence). Disponibles en pharmacie.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PACK CONTENTS                                -->
  <!-- ============================================ -->
  <section class="gp-section gp-section-tinted">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Contenu du pack</span>
        <h2 class="gp-h2">Ce qu'on inclut dans le pack démarrage.</h2>
      </header>

      <div class="gp-pack-grid">
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📟</div>
          <h4>1× Lecteur GlucoPulse</h4>
          <p>Bluetooth Low Energy, écran OLED, batterie 1000 mesures</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">🩸</div>
          <h4>50× Bandelettes test</h4>
          <p>Codage automatique, conservation 18 mois</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📍</div>
          <h4>50× Lancettes stériles</h4>
          <p>Calibre 30G, indolore</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">🖊️</div>
          <h4>1× Autopiqueur ajustable</h4>
          <p>5 niveaux de profondeur</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">👜</div>
          <h4>1× Étui de transport</h4>
          <p>Compact, EVA résistant</p>
        </div>
        <div class="gp-pack-item">
          <div class="gp-pack-icon">📱</div>
          <h4>App iOS &amp; Android</h4>
          <p>Gratuite, mises à jour à vie</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- COMPARISON                                   -->
  <!-- ============================================ -->
  <section class="gp-section">
    <div class="gp-section-inner">
      <header class="gp-section-header">
        <span class="gp-eyebrow">Comparatif</span>
        <h2 class="gp-h2">Comment GlucoPulse se compare aux autres.</h2>
      </header>

      <div class="gp-compare-wrap">
        <table class="gp-compare-table">
          <thead>
            <tr>
              <th></th>
              <th class="gp-col-us">GlucoPulse</th>
              <th>Sinocare Safe AQ</th>
              <th>Accu-Chek Instant</th>
              <th>FreeStyle Libre 2</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Prix pack démarrage</td>
              <td class="gp-col-us"><strong>59 €</strong></td>
              <td>32 €</td>
              <td>49 €</td>
              <td>59 €/14j</td>
            </tr>
            <tr>
              <td>App smartphone</td>
              <td class="gp-col-us">✓</td>
              <td>✓</td>
              <td>✓</td>
              <td>✓</td>
            </tr>
            <tr>
              <td>Mémoire mesures</td>
              <td class="gp-col-us"><strong>500</strong></td>
              <td>500</td>
              <td>720</td>
              <td>90 jours</td>
            </tr>
            <tr>
              <td>Précision (norme ISO)</td>
              <td class="gp-col-us">±5%</td>
              <td>±10%</td>
              <td>±5%</td>
              <td>±9%</td>
            </tr>
            <tr>
              <td>Garantie</td>
              <td class="gp-col-us"><strong>2 ans</strong></td>
              <td>1 an</td>
              <td>2 ans</td>
              <td>—</td>
            </tr>
            <tr>
              <td>Bandelettes (unité)</td>
              <td class="gp-col-us"><strong>0,15 €</strong></td>
              <td>0,18 €</td>
              <td>0,40 €</td>
              <td>—</td>
            </tr>
            <tr>
              <td>Export PDF médecin</td>
              <td class="gp-col-us">✓</td>
              <td>—</td>
              <td>—</td>
              <td>✓</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FAQ                                          -->
  <!-- ============================================ -->
  <section class="gp-section gp-section-tinted">
    <div class="gp-section-inner gp-section-narrow">
      <header class="gp-section-header">
        <span class="gp-eyebrow">FAQ</span>
        <h2 class="gp-h2">Les questions qu'on nous pose.</h2>
      </header>

      <div class="gp-faq">
        <details class="gp-faq-item">
          <summary>Quand le produit sera-t-il disponible ?</summary>
          <p>
            Le lancement public est prévu <strong>S2 2026</strong>. La phase
            d'accès anticipé permet aux premiers inscrits de recevoir leur appareil
            au tarif garanti de <strong>{productPrice} €</strong> (vs {productOldPrice} € en prix public).
            Pré-réservez votre place — aucun paiement aujourd'hui, juste votre email.
          </p>
        </details>

        <details class="gp-faq-item">
          <summary>Compatible avec mon traitement GLP-1 ?</summary>
          <p>
            Oui, GlucoPulse est conçu pour tous les traitements antidiabétiques :
            Ozempic, Mounjaro, Wegovy, Trulicity, Victoza, Rybelsus, insuline,
            metformine, iSGLT2. Les seuils d'alerte sont personnalisables.
          </p>
        </details>

        <details class="gp-faq-item">
          <summary>Faut-il une ordonnance ?</summary>
          <p>
            Non, le glucomètre est en vente libre. Si votre médecin vous a
            prescrit un suivi glycémique, votre mutuelle peut prendre en charge
            une partie du coût (forfait "matériel médical" — vérifiez votre tableau).
          </p>
        </details>

        <details class="gp-faq-item">
          <summary>Bandelettes : où les acheter ?</summary>
          <p>
            Bandelettes GlucoPulse en pack 50 ou 100, disponibles en pharmacie
            (officines partenaires) et sur notre site. <strong>0,15 €/unité</strong>
