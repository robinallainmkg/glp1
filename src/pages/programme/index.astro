    <!-- Service 3 : Suivi continu -->
    <div style="display: flex; align-items: center; gap: 48px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 300px;">
        <div style="display: inline-block; background: #fef3c7; color: #92400e; border-radius: 8px; padding: 4px 12px; font-size: 0.8rem; font-weight: 600; margin-bottom: 16px;">Suivi personnalise</div>
        <h3 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 12px;">On ne vous lache pas en chemin</h3>
        <p style="font-size: 0.95rem; color: #475569; line-height: 1.7; margin-bottom: 20px;">
          Notre Coach IA est disponible 24/7 pour repondre a vos questions.
          Check-ins reguliers, ajustements en temps reel, et une equipe humaine derriere quand c'est necessaire.
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem; color: #334155; line-height: 2;">
          <li>🤖 Coach IA disponible 24/7</li>
          <li>📞 Support humain par message</li>
          <li>📈 Suivi de progression mensuel</li>
          <li>⚠️ Gestion proactive des effets secondaires</li>
        </ul>
      </div>
      <div style="flex: 0 0 380px; max-width: 100%;">
        <img src="/images/landing/suivi-patient.jpg" alt="Suivi patient personnalise" style="width: 100%; border-radius: 16px; box-shadow: 0 8px 30px rgba(0,0,0,0.1);" loading="lazy">
      </div>
    </div>
  </div>
</section>

<!-- PRICING -->
<section id="tarifs" style="padding: 80px 0; background: #f8fafc;">
  <div style="max-width: 1100px; margin: 0 auto; padding: 0 24px;">
    <div style="text-align: center; margin-bottom: 48px;">
      <h2 style="font-size: 2rem; font-weight: 800; color: #0f172a; margin-bottom: 12px;">Choisissez votre accompagnement</h2>
      <p style="font-size: 1.05rem; color: #64748b;">Sans engagement. Annulation a tout moment.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; max-width: 960px; margin: 0 auto;">

