import StaticLayout from '../layouts/StaticLayout.astro';
import PartnerComparator from '../components/PartnerComparator.astro';
// import NewsletterCapture from '../components/NewsletterCapture.astro';
import fs from 'node:fs';
import path from 'node:path';

// Fonction pour lire le contenu des dossiers de catégories
async function getCategoryContent() {
  const categories: any[] = [
    { slug: 'glp1-cout', name: 'Prix et Où Acheter', icon: 'euro', description: 'Prix Ozempic/Wegovy, remboursements et pharmacies en France' },
    { slug: 'glp1-perte-de-poids', name: 'Perdre du Poids', icon: 'trending-down', description: 'Résultats réels, témoignages et avant/après avec Ozempic & Wegovy' },
    { slug: 'effets-secondaires-glp1', name: 'Effets Secondaires', icon: 'alert', description: 'Nausées, fatigue : comment gérer les effets secondaires' },
    { slug: 'regime-glp1', name: 'Que Manger', icon: 'salad', description: 'Alimentation adaptée pendant un traitement Ozempic/Wegovy' },
    { slug: 'alternatives-glp1', name: 'Autres Solutions', icon: 'leaf', description: 'Alternatives naturelles et autres médicaments pour maigrir' },
    { slug: 'medecins-glp1-france', name: 'Trouver un Médecin', icon: 'stethoscope', description: 'Médecins qui prescrivent Ozempic/Wegovy près de chez vous' },
    { slug: 'recherche-glp1', name: 'Études et Nouveautés', icon: 'microscope', description: 'Dernières études scientifiques et innovations médicamenteuses' },
    { slug: 'traitements-glp1', name: 'Guides Traitements', icon: 'pill', description: 'Guides complets Ozempic, Wegovy, Mounjaro et Saxenda' }
  ];

  const astroRoot = (typeof Astro !== 'undefined' && (Astro as any).root) ? (Astro as any).root : process.cwd();
  const contentPath = path.resolve(astroRoot, 'src', 'content');

  for (const category of categories) {
    try {
      const categoryPath = path.join(contentPath, category.slug);
      if (fs.existsSync(categoryPath)) {
        const files = fs.readdirSync(categoryPath);
        category.articleCount = files.filter(file => file.endsWith('.md')).length;
      } else {
        category.articleCount = 0;
      }
    } catch (error) {
      category.articleCount = 0;
    }
  }

  return categories;
}

const categories = await getCategoryContent();
const mainKeyword = "GLP-1 France";

// Fetch latest articles for "Dernières Actualités" section
import { getCollection } from 'astro:content';
const allCollections = ['traitements-glp1', 'glp1-cout', 'effets-secondaires-glp1', 'recherche-glp1', 'glp1-perte-de-poids', 'regime-glp1', 'alternatives-glp1', 'medecins-glp1-france'];
let latestArticles: any[] = [];
for (const col of allCollections) {
  try {
    const entries = await getCollection(col as any);
    for (const entry of entries) {
      const d = entry.data as any;
      latestArticles.push({
        slug: entry.slug,
        collection: col,
        title: d.title || '',
        description: d.description || '',
        date: d.date || d.pubDate || null,
        thumbnail: d.thumbnail || null,
        thumbnailAlt: d.thumbnailAlt || d.title || '',
      });
    }
  } catch {}
}
latestArticles = latestArticles
  .filter(a => a.date)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 6);
