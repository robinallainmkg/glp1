<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #articles-container {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* FAQ accordion styling */
  details summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary {
    border-bottom: 1px solid #e5e7eb;
  }

  /* Scroll-triggered fade-in animations */
  .hp-fade-in {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hp-fade-in.hp-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hp-delay-1 { transition-delay: 0.15s; }
  .hp-delay-2 { transition-delay: 0.3s; }

  /* Smooth hover lift for cards */
  .hp-card-lift {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hp-card-lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -12px rgb(0 0 0 / 0.1);
  }
</style>

<script>
  // Intersection Observer for scroll-triggered animations
  document.addEventListener('DOMContentLoaded', function() {
    const fadeElements = document.querySelectorAll('.hp-fade-in');
    if (!fadeElements.length) return;

    // Immediately reveal elements that are already in viewport
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('hp-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

    fadeElements.forEach(function(el) { observer.observe(el); });
  });
</script>
