---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createClient } from '@supabase/supabase-js';

// Configuration Supabase
const supabaseUrl = 'https://ywekaivgjzsmdocchvum.supabase.co';
const supabaseKey = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl3ZWthaXZnanpzbWRvY2NodnVtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MjQ2NzMzMDEsImV4cCI6MjA0MDI0OTMwMX0.gQ7uxcJOJKWcKKNZ86qzaD-6Ls1zI9OdYEZIjnBFHW0';

const supabase = createClient(supabaseUrl, supabaseKey);

// Récupération des paramètres
const { specialty } = Astro.params;

// Génération des paths statiques pour toutes les spécialités
export async function getStaticPaths() {
  const supabase = createClient(
    'https://ywekaivgjzsmdocchvum.supabase.co',
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl3ZWthaXZnanpzbWRvY2NodnVtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MjQ2NzMzMDEsImV4cCI6MjA0MDI0OTMwMX0.gQ7uxcJOJKWcKKNZ86qzaD-6Ls1zI9OdYEZIjnBFHW0'
  );

  try {
    const { data: specialties } = await supabase
      .from('specialties')
      .select('slug')
      .eq('is_active', true);

    return (specialties || []).map(specialty => ({
      params: { specialty: specialty.slug }
    }));
  } catch (error) {
    console.error('Erreur getStaticPaths:', error);
    // Fallback avec spécialités par défaut
    return [
      { params: { specialty: 'endocrinologue-glp1' } },
      { params: { specialty: 'diabetologue' } },
      { params: { specialty: 'nutritionniste-obesite' } },
      { params: { specialty: 'medecin-perte-poids' } },
      { params: { specialty: 'clinique-obesite' } }
    ];
  }
}

// Chargement des données pour la spécialité
let specialtyData = null;
let professionals = [];
let topCities = [];
let stats = { total: 0, acceptingNew: 0, avgPrice: null };

try {
  // Récupération des informations de la spécialité
  const { data: specialtyInfo } = await supabase
    .from('specialties')
    .select('*')
    .eq('slug', specialty)
    .single();

  specialtyData = specialtyInfo;

  if (specialtyData) {
    // Récupération des professionnels de cette spécialité
    const { data: professionalsData } = await supabase
      .from('health_professionals')
      .select(`
        *,
        french_cities (
          name,
          slug,
          department_name,
          population
        )
      `)
      .eq('specialty_slug', specialty)
      .eq('is_active', true)
      .order('view_count', { ascending: false })
      .limit(50);

    professionals = professionalsData || [];

    // Statistiques
    const acceptingNewCount = professionals.filter(p => p.accepts_new_patients).length;
    const pricesWithValues = professionals
      .filter(p => p.consultation_price_min)
      .map(p => p.consultation_price_min);
    
    stats = {
      total: professionals.length,
      acceptingNew: acceptingNewCount,
      avgPrice: pricesWithValues.length > 0 
        ? Math.round(pricesWithValues.reduce((a, b) => a + b, 0) / pricesWithValues.length)
        : null
    };

    // Top villes pour cette spécialité
    const cityCount = {};
    professionals.forEach(p => {
      if (p.french_cities) {
        const cityName = p.french_cities.name;
        cityCount[cityName] = (cityCount[cityName] || 0) + 1;
      }
    });

    topCities = Object.entries(cityCount)
      .sort(([,a], [,b]) => b - a)
      .slice(0, 10)
      .map(([name, count]) => ({
        name,
        count,
        slug: name.toLowerCase().replace(/[^a-z0-9]/g, '-')
      }));
  }

} catch (error) {
  console.error('Erreur lors du chargement des données:', error);
}

// Générer le titre et la description SEO
const pageTitle = specialtyData 
  ? `${stats.total} ${specialtyData.name} en France | Annuaire GLP-1`
  : `Professionnels ${specialty} | Annuaire GLP-1`;

const pageDescription = specialtyData
  ? `Trouvez un ${specialtyData.name.toLowerCase()} près de chez vous. ${stats.total} professionnels spécialisés GLP-1 en France. Consultations, tarifs, avis patients.`
  : `Annuaire des professionnels de santé spécialisés dans les traitements GLP-1.`;

// Navigation breadcrumb
const breadcrumb = [
  { name: 'Accueil', href: '/' },
  { name: 'Annuaire', href: '/annuaire' },
  { name: specialtyData?.name || specialty, href: `/annuaire/${specialty}` }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto px-4 py-8">
    
    <!-- Breadcrumb -->
    <nav class="flex mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        {breadcrumb.map((item, index) => (
          <li class="inline-flex items-center">
            {index > 0 && (
              <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 111.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
              </svg>
            )}
            <a href={item.href} class={`text-sm font-medium ${index === breadcrumb.length - 1 ? 'text-gray-500' : 'text-blue-600 hover:text-blue-800'}`}>
              {item.name}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    {specialtyData ? (
      <>
        <!-- Hero Section -->
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            {specialtyData.name} en France
          </h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
            {specialtyData.description}
          </p>
          
          <!-- Statistiques -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-2xl mx-auto">
            <div class="bg-blue-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-blue-600">{stats.total}</div>
              <div class="text-sm text-gray-600">Professionnels</div>
            </div>
            <div class="bg-green-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-green-600">{stats.acceptingNew}</div>
              <div class="text-sm text-gray-600">Acceptent nouveaux patients</div>
            </div>
            <div class="bg-purple-50 rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-600">
                {stats.avgPrice ? `${stats.avgPrice}€` : 'Variable'}
              </div>
              <div class="text-sm text-gray-600">Tarif moyen</div>
            </div>
          </div>
        </div>

        <!-- Filtres et tri -->
        <div class="bg-white rounded-lg shadow-lg p-6 mb-8">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
              <span class="text-sm font-medium text-gray-700">Filtrer par :</span>
              <select class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                <option>Toutes les villes</option>
                {topCities.map(city => (
                  <option value={city.slug}>{city.name} ({city.count})</option>
                ))}
              </select>
              <select class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                <option>Tous les tarifs</option>
                <option>Secteur 1</option>
                <option>Secteur 2</option>
              </select>
            </div>
            <div class="flex items-center space-x-4">
              <span class="text-sm font-medium text-gray-700">Trier par :</span>
              <select class="border border-gray-300 rounded-md px-3 py-2 text-sm">
                <option>Popularité</option>
                <option>Note</option>
                <option>Tarif croissant</option>
                <option>Distance</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Liste des professionnels -->
        {professionals.length > 0 ? (
          <div class="space-y-6 mb-12">
            {professionals.map(professional => (
              <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
                <div class="flex flex-col md:flex-row gap-6">
                  
                  <!-- Photo et infos principales -->
                  <div class="flex-shrink-0">
                    <div class="w-24 h-24 bg-gray-200 rounded-lg flex items-center justify-center">
                      {professional.photo_url ? (
                        <img 
                          src={professional.photo_url} 
                          alt={`${professional.first_name} ${professional.last_name}`}
                          class="w-24 h-24 rounded-lg object-cover"
                        />
                      ) : (
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                      )}
                    </div>
                  </div>

                  <!-- Informations du professionnel -->
                  <div class="flex-1">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between">
                      <div class="mb-4 md:mb-0">
                        <h3 class="text-xl font-bold text-gray-900 mb-1">
                          {professional.title} {professional.first_name} {professional.last_name}
                        </h3>
                        <p class="text-gray-600 mb-2">{specialtyData.name}</p>
                        
                        {professional.french_cities && (
                          <div class="flex items-center text-gray-500 mb-2">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            {professional.french_cities.name}, {professional.french_cities.department_name}
                          </div>
                        )}

                        {professional.address && (
                          <p class="text-sm text-gray-500 mb-2">{professional.address}</p>
                        )}

                        <!-- Badges -->
                        <div class="flex flex-wrap gap-2 mb-3">
                          {professional.accepts_glp1 && (
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                              Spécialiste GLP-1
                            </span>
                          )}
                          {professional.accepts_new_patients && (
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                              Accepte nouveaux patients
                            </span>
                          )}
                          {professional.sector_type === 1 && (
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                              Secteur 1
                            </span>
                          )}
                        </div>

                        <!-- Rating -->
                        {professional.rating && (
                          <div class="flex items-center mb-2">
                            <div class="flex items-center">
                              {[...Array(5)].map((_, i) => (
                                <svg 
                                  class={`w-4 h-4 ${i < Math.floor(professional.rating) ? 'text-yellow-400' : 'text-gray-300'}`}
                                  fill="currentColor" 
                                  viewBox="0 0 20 20"
                                >
                                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                              ))}
                            </div>
                            <span class="ml-2 text-sm text-gray-600">
                              {professional.rating}/5 ({professional.review_count} avis)
                            </span>
                          </div>
                        )}
                      </div>

                      <!-- Prix et contact -->
                      <div class="text-right">
                        {professional.consultation_price_min && (
                          <div class="text-lg font-bold text-gray-900 mb-2">
                            {professional.consultation_price_min}
                            {professional.consultation_price_max && professional.consultation_price_max !== professional.consultation_price_min && 
                              ` - ${professional.consultation_price_max}`
                            }€
                          </div>
                        )}
                        
                        <div class="space-y-2">
                          {professional.phone && (
                            <a 
                              href={`tel:${professional.phone}`}
                              class="block w-full bg-blue-600 text-white text-center py-2 px-4 rounded-lg hover:bg-blue-700 transition-colors"
                            >
                              {professional.phone}
                            </a>
                          )}
                          
                          {professional.doctolib_url && (
                            <a 
                              href={professional.doctolib_url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="block w-full bg-green-600 text-white text-center py-2 px-4 rounded-lg hover:bg-green-700 transition-colors"
                            >
                              Prendre RDV en ligne
                            </a>
                          )}
                        </div>
                      </div>
                    </div>

                    {professional.bio && (
                      <div class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-gray-600 text-sm">{professional.bio}</p>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">Aucun professionnel trouvé</h3>
            <p class="mt-1 text-sm text-gray-500">
              Aucun {specialtyData.name.toLowerCase()} n'est encore référencé dans notre annuaire.
            </p>
          </div>
        )}

        <!-- Villes principales pour cette spécialité -->
        {topCities.length > 0 && (
          <div class="mb-12">
            <h2 class="text-2xl font-bold mb-6">Villes principales pour {specialtyData.name}</h2>
            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
              {topCities.map(city => (
                <a 
                  href={`/annuaire/${specialty}/${city.slug}`}
                  class="block p-4 bg-white rounded-lg shadow hover:shadow-lg transition-shadow text-center"
                >
                  <div class="font-medium text-gray-900">{city.name}</div>
                  <div class="text-sm text-gray-600">{city.count} professionnel{city.count > 1 ? 's' : ''}</div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- FAQ spécifique à la spécialité -->
        <div class="mb-12">
          <h2 class="text-2xl font-bold mb-6">Questions fréquentes - {specialtyData.name}</h2>
          <div class="space-y-4">
            <div class="bg-white rounded-lg shadow p-6">
              <h3 class="font-bold text-lg mb-2">Comment choisir son {specialtyData.name.toLowerCase()} ?</h3>
              <p class="text-gray-600">
                Vérifiez ses qualifications, son expérience avec les traitements GLP-1, 
                les avis patients et la proximité géographique. Privilégiez un praticien 
                formé aux nouvelles thérapies.
              </p>
            </div>
            
            <div class="bg-white rounded-lg shadow p-6">
              <h3 class="font-bold text-lg mb-2">Quel est le tarif moyen d'une consultation ?</h3>
              <p class="text-gray-600">
                {stats.avgPrice 
                  ? `Le tarif moyen pour une consultation ${specialtyData.name.toLowerCase()} est de ${stats.avgPrice}€. En secteur 1, le tarif conventionné s'applique.`
                  : `Les tarifs varient selon le secteur d'exercice et la localisation. Consultez les fiches détaillées pour connaître les tarifs pratiqués.`
                }
              </p>
            </div>
          </div>
        </div>

      </>
    ) : (
      <div class="text-center py-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Spécialité non trouvée</h1>
        <p class="text-gray-600 mb-8">La spécialité "{specialty}" n'existe pas dans notre annuaire.</p>
        <a href="/annuaire" class="inline-block bg-blue-600 text-white py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors">
          Retour à l'annuaire
        </a>
      </div>
    )}

  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
  }
</style>
