  <script>
    document.getElementById('calculate-imc')?.addEventListener('click', function() {
      const weightEl = document.getElementById('weight') as HTMLInputElement | null;
      const heightEl = document.getElementById('height') as HTMLInputElement | null;
      const weight = weightEl ? parseFloat(weightEl.value) : 0;
      const height = heightEl ? parseFloat(heightEl.value) : 0;
      
      if (weight && height) {
        const heightInMeters = height / 100;
        const imc = weight / (heightInMeters * heightInMeters);
        const resultDiv = document.getElementById('imc-result');
        
        let interpretation = '';
        let className = '';
        
        if (imc < 18.5) {
          interpretation = 'Poids insuffisant - Ces traitements ne sont pas adaptés';
          className = 'imc-low';
        } else if (imc < 25) {
          interpretation = 'Poids normal - Ces traitements ne sont pas nécessaires';
          className = 'imc-normal';
        } else if (imc < 30) {
          interpretation = 'Surpoids - Éligible si problèmes de santé associés';
          className = 'imc-overweight';
        } else {
          interpretation = 'Obésité - Éligible aux nouveaux traitements';
          className = 'imc-eligible';
        }
        
        resultDiv.innerHTML = `
          <div class="imc-value">IMC: ${imc.toFixed(1)}</div>
          <div class="imc-interpretation ${className}">${interpretation}</div>
        `;
        
        resultDiv.style.display = 'block';
      }
    });
  </script>

