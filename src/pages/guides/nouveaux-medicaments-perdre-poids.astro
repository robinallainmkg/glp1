---
import ArticleWithAffiliateSidebar from "../../layouts/ArticleWithAffiliateSidebar.astro";

const affiliateProducts = [];
const affiliateConfig = {};
const entry = {};
const frontmatter = null;
---

<ArticleWithAffiliateSidebar articleContent={frontmatter || entry} affiliateProducts={affiliateProducts ?? []} affiliateConfig={affiliateConfig ?? {}}>
  <div class="container">
    <article class="weight-loss-guide">
      <header class="hero-header">
        <h1>Nouveaux Médicaments pour Perdre du Poids : La Révolution 2025</h1>
        <p class="hero-subtitle">
          Une nouvelle génération de médicaments change tout pour la perte de poids. 
          Découvrez ces traitements révolutionnaires qui aident des millions de personnes à retrouver leur poids idéal.
        </p>
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">15-20%</span>
            <span class="stat-label">Perte de poids moyenne</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">85%</span>
            <span class="stat-label">Patients satisfaits</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">1x/semaine</span>
            <span class="stat-label">Une seule injection</span>
          </div>
        </div>
      </header>

      <section class="revolution-section">
        <h2>La Révolution des Médicaments pour Maigrir</h2>
        
        <div class="before-after-comparison">
          <div class="before-column">
            <h3>❌ Avant : Les Anciennes Solutions</h3>
            <ul class="old-solutions">
              <li>Régimes drastiques difficiles à tenir</li>
              <li>Médicaments coupe-faim dangereux</li>
              <li>Chirurgie bariatrique lourde</li>
              <li>Suppléments inefficaces</li>
              <li>Effet yo-yo constant</li>
            </ul>
          </div>
          
          <div class="after-column">
            <h3>✅ Maintenant : Les Nouveaux Traitements</h3>
            <ul class="new-solutions">
              <li>Réduction naturelle de l'appétit</li>
              <li>Molécules sûres et testées</li>
              <li>Perte progressive et durable</li>
              <li>1 injection par semaine seulement</li>
              <li>Résultats maintenus dans le temps</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="how-it-works-section">
        <h2>Comment Ces Médicaments Révolutionnaires Fonctionnent</h2>
        
        <div class="mechanism-explanation">
          <p class="intro-text">
            Ces nouveaux traitements <strong>imitent une hormone naturelle de votre corps</strong> 
            qui régule l'appétit et la digestion. Résultat : vous mangez moins naturellement, 
            sans frustration ni effet de privation.
          </p>
          
          <div class="process-flow">
            <div class="process-step">
              <div class="step-icon">💉</div>
              <h3>1. Injection Simple</h3>
              <p>Une petite injection sous la peau, 1 fois par semaine. Moins douloureux qu'une prise de sang.</p>
            </div>
            
            <div class="process-arrow">→</div>
            
            <div class="process-step">
              <div class="step-icon">🧠</div>
              <h3>2. Action sur le Cerveau</h3>
              <p>Le médicament agit sur les centres de l'appétit pour réduire naturellement vos envies.</p>
            </div>
            
            <div class="process-arrow">→</div>
            
            <div class="process-step">
              <div class="step-icon">🍽️</div>
              <h3>3. Moins Faim</h3>
              <p>Vous êtes rassasié plus vite et plus longtemps. Fini les grignotages et les grosses portions.</p>
            </div>
            
            <div class="process-arrow">→</div>
            
            <div class="process-step">
              <div class="step-icon">📉</div>
              <h3>4. Perte de Poids</h3>
              <p>Perte progressive et durable : 1-2 kg par mois, jusqu'à 15-20% de votre poids initial.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="medications-overview">
        <h2>Les Principaux Médicaments Disponibles</h2>
        
        <div class="meds-grid">
          <a href="/collections/traitements-glp1/guide-complet-wegovy/" class="med-card featured">
            <div class="med-header">
              <h3>Wegovy</h3>
              <span class="med-badge">Le Plus Efficace</span>
            </div>
            <div class="med-content">
              <div class="efficacy">
                <span class="efficacy-number">-20%</span>
                <span class="efficacy-label">Perte de poids moyenne</span>
              </div>
              <ul class="med-benefits">
                <li>✅ Spécialement conçu pour maigrir</li>
                <li>✅ Résultats spectaculaires</li>
                <li>✅ 1 injection par semaine</li>
                <li>✅ Approuvé par les autorités</li>
              </ul>
              <div class="med-price">
                <span class="price">169-360€/mois</span>
                <span class="price-note">Non remboursé</span>
              </div>
            </div>
          </a>

          <a href="/collections/glp1-cout/prix-ozempic-france/" class="med-card">
            <div class="med-header">
              <h3>Ozempic</h3>
              <span class="med-badge">Polyvalent</span>
            </div>
            <div class="med-content">
              <div class="efficacy">
                <span class="efficacy-number">-12%</span>
                <span class="efficacy-label">Perte de poids moyenne</span>
              </div>
              <ul class="med-benefits">
                <li>✅ Indiqué pour le diabète de type 2</li>
                <li>✅ Remboursé 65 % (DT2 uniquement)</li>
                <li>✅ Très étudié</li>
                <li>✅ Bonne tolérance</li>
              </ul>
              <div class="med-price">
                <span class="price">~59,90€/stylo</span>
                <span class="price-note">Remboursé uniquement si diabète</span>
              </div>
            </div>
          </a>

          <a href="/collections/traitements-glp1/guide-complet-saxenda/" class="med-card">
            <div class="med-header">
              <h3>Saxenda</h3>
              <span class="med-badge">Accessible</span>
            </div>
            <div class="med-content">
              <div class="efficacy">
                <span class="efficacy-number">-8%</span>
                <span class="efficacy-label">Perte de poids moyenne</span>
              </div>
              <ul class="med-benefits">
                <li>✅ Indiqué pour l'obésité</li>
                <li>✅ Disponible facilement</li>
                <li>✅ Injection quotidienne</li>
                <li>✅ Premiers résultats rapides</li>
              </ul>
              <div class="med-price">
                <span class="price">240-300€/mois</span>
                <span class="price-note">Non remboursé</span>
              </div>
            </div>
          </a>
        </div>
        
        <div class="comparison-note">
          <p><strong>💡 À savoir :</strong> Ces médicaments appartiennent à la famille des "GLP-1" - 
          des molécules qui imitent une hormone naturelle pour réguler l'appétit.</p>
        </div>
      </section>

      <section class="results-section">
        <h2>Résultats Réels : Ce Que Vous Pouvez Attendre</h2>
        
        <div class="results-timeline">
          <div class="timeline-item">
            <div class="timeline-marker">1M</div>
            <div class="timeline-content">
              <h3>Premier Mois</h3>
              <p><strong>-3 à 5 kg</strong> • Réduction immédiate de l'appétit • Quelques effets secondaires digestifs</p>
            </div>
          </div>
          
          <div class="timeline-item">
            <div class="timeline-marker">3M</div>
            <div class="timeline-content">
              <h3>Troisième Mois</h3>
              <p><strong>-8 à 12 kg</strong> • Habitudes alimentaires changées • Effets secondaires atténués</p>
            </div>
          </div>
          
          <div class="timeline-item">
            <div class="timeline-marker">6M</div>
            <div class="timeline-content">
              <h3>Sixième Mois</h3>
              <p><strong>-12 à 18 kg</strong> • Résultats stables • Nouvelle relation à la nourriture</p>
            </div>
          </div>
          
          <div class="timeline-item">
            <div class="timeline-marker">12M</div>
            <div class="timeline-content">
              <h3>Un An</h3>
              <p><strong>-15 à 25 kg</strong> • Objectif atteint • Maintien du poids facilité</p>
            </div>
          </div>
        </div>

        <div class="success-factors">
          <h3>Facteurs de Réussite</h3>
          <div class="success-content">
            <p class="success-intro">
              Ces nouveaux médicaments ne sont pas magiques. <strong>Votre réussite dépendra de plusieurs facteurs clés</strong> 
              que nous avons identifiés chez les patients qui obtiennent les meilleurs résultats :
            </p>
            
            <div class="factors-grid">
              <div class="factor-card">
                <div class="factor-header">
                  <span class="factor-number">1</span>
                  <h4>Suivi Médical Rigoureux</h4>
                </div>
                <p>Consultations mensuelles les 3 premiers mois, puis trimestrielles. Votre médecin ajustera les doses et surveillera les effets secondaires.</p>
              </div>
              
              <div class="factor-card">
                <div class="factor-header">
                  <span class="factor-number">2</span>
                  <h4>Adaptation Alimentaire</h4>
                </div>
                <p>Pas de régime strict, mais une réduction naturelle des portions. Privilégiez les protéines et évitez les aliments trop gras qui amplifient les nausées.</p>
              </div>
              
              <div class="factor-card">
                <div class="factor-header">
                  <span class="factor-number">3</span>
                  <h4>Activité Physique Progressive</h4>
                </div>
                <p>Commencez par 15-20 minutes de marche quotidienne. Augmentez progressivement. L'important est la régularité, pas l'intensité.</p>
              </div>
              
              <div class="factor-card">
                <div class="factor-header">
                  <span class="factor-number">4</span>
                  <h4>Gestion des Effets Secondaires</h4>
                </div>
                <p>Nausées et fatigue sont normales les premières semaines. Mangez lentement, par petites portions, et hydratez-vous bien.</p>
              </div>
            </div>
            
            <div class="success-tip">
              <strong>💡 Conseil d'expert :</strong> Les patients qui perdent le plus de poids sont ceux qui voient leur traitement 
              comme un "coup de pouce" pour changer leurs habitudes, pas comme une solution miracle.
            </div>
          </div>
        </div>
      </section>

      <section class="eligibility-section">
        <h2>Êtes-Vous Éligible à Ces Traitements ?</h2>
        
        <div class="eligibility-checker">
          <div class="check-grid">
            <div class="check-column positive">
              <h3>✅ Vous Pouvez en Bénéficier Si :</h3>
              <div class="criteria-list">
                <div class="criteria-item">
                  <span class="criteria-icon">⚖️</span>
                  <span class="criteria-text">IMC ≥ 30 (obésité) ou IMC ≥ 27 avec problèmes de santé</span>
                </div>
                <div class="criteria-item">
                  <span class="criteria-icon">📉</span>
                  <span class="criteria-text">Échec des régimes traditionnels</span>
                </div>
                <div class="criteria-item">
                  <span class="criteria-icon">🎯</span>
                  <span class="criteria-text">Motivation pour un traitement long terme</span>
                </div>
                <div class="criteria-item">
                  <span class="criteria-icon">👩‍⚕️</span>
                  <span class="criteria-text">Suivi médical accepté</span>
                </div>
              </div>
            </div>
            
            <div class="check-column negative">
              <h3>❌ Non Recommandé Si :</h3>
              <div class="criteria-list">
                <div class="criteria-item">
                  <span class="criteria-icon">🤰</span>
                  <span class="criteria-text">Grossesse ou projet de grossesse</span>
                </div>
                <div class="criteria-item">
                  <span class="criteria-icon">🍼</span>
                  <span class="criteria-text">Allaitement en cours</span>
                </div>
                <div class="criteria-item">
                  <span class="criteria-icon">⚕️</span>
                  <span class="criteria-text">Antécédents de pancréatite</span>
                </div>
                <div class="criteria-item">
                  <span class="criteria-icon">🧬</span>
                  <span class="criteria-text">Cancer thyroïde familial</span>
                </div>
              </div>
            </div>
          </div>
          
          <div class="imc-calculator">
            <h3>🧮 Calculez Votre IMC</h3>
            <p>L'IMC (Indice de Masse Corporelle) détermine votre éligibilité</p>
            <div class="calculator-inputs">
              <div class="input-group">
                <label>Poids (kg)</label>
                <input type="number" id="weight" placeholder="70">
              </div>
              <div class="input-group">
                <label>Taille (cm)</label>
                <input type="number" id="height" placeholder="170">
              </div>
              <button id="calculate-imc" class="calculate-btn">Calculer</button>
            </div>
            <div id="imc-result" class="imc-result"></div>
          </div>
        </div>
      </section>

      <section class="cost-section">
        <h2>Coût et Remboursement</h2>

        <div class="cost-breakdown">
          <div class="cost-scenario">
            <h3>💊 Traitements obésité (NON remboursés)</h3>
            <div class="cost-details">
              <div class="cost-line">
                <span>Wegovy (semaglutide 2,4 mg)</span>
                <span class="cost-amount">169-360€/mois</span>
              </div>
              <div class="cost-line">
                <span>Mounjaro (tirzepatide)</span>
                <span class="cost-amount">230-440€/mois</span>
              </div>
              <div class="cost-line">
                <span>Saxenda (liraglutide 3 mg)</span>
                <span class="cost-amount">240-300€/mois</span>
              </div>
            </div>
          </div>

          <div class="cost-scenario">
            <h3>💊 Traitements diabète type 2 (remboursés 65 %)</h3>
            <div class="cost-details">
              <div class="cost-line">
                <span>Ozempic (semaglutide)</span>
                <span class="cost-amount">~59,90€/stylo</span>
              </div>
              <div class="cost-line">
                <span>Trulicity (dulaglutide)</span>
                <span class="cost-amount">~81€/mois</span>
              </div>
              <div class="cost-line">
                <span>Victoza (liraglutide 1,8 mg)</span>
                <span class="cost-amount">~60€/mois</span>
              </div>
            </div>
          </div>
        </div>

        <div class="cost-tips">
          <h3>⚠️ Ce qu'il faut savoir</h3>
          <ul>
            <li>Les traitements indiqués pour l'obésité (Wegovy, Mounjaro, Saxenda) ne sont <strong>pas remboursés</strong> par la Sécurité Sociale (mars 2026)</li>
            <li>Ozempic, Trulicity et Victoza sont remboursés <strong>uniquement pour le diabète de type 2</strong> (65 %, 100 % en ALD)</li>
            <li>Un <strong>formulaire de prescription</strong> est obligatoire depuis février 2025 pour Ozempic, Trulicity et Victoza</li>
            <li>Renseignez-vous auprès de votre mutuelle pour une éventuelle prise en charge partielle</li>
          </ul>
        </div>
      </section>

      <section class="getting-started">
        <h2>Comment Commencer</h2>
        
        <div class="steps-process">
          <div class="step-item">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>Consultez un Médecin</h3>
              <p>Endocrinologue, diabétologue ou médecin traitant formé aux nouveaux traitements.</p>
              <a href="/collections/medecins-glp1-france/" class="step-link">Trouver un spécialiste →</a>
            </div>
          </div>
          
          <div class="step-item">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>Bilan Médical</h3>
              <p>Examens de base, vérification des contre-indications, définition des objectifs.</p>
            </div>
          </div>
          
          <div class="step-item">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>Prescription & Démarrage</h3>
              <p>Ordonnance, achat en pharmacie, première injection avec formation.</p>
              <a href="/collections/glp1-cout/wegovy-prix/" class="step-link">Voir les prix →</a>
            </div>
          </div>
          
          <div class="step-item">
            <div class="step-number">4</div>
            <div class="step-content">
              <h3>Suivi Régulier</h3>
              <p>Consultations mensuelles, adaptation des doses, gestion des effets secondaires.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <h2>Questions Fréquentes</h2>
        
        <div class="faq-container">
          <details class="faq-item">
            <summary>Ces médicaments sont-ils vraiment efficaces ?</summary>
            <p>Oui, les études montrent une perte de poids de 15-20% en moyenne sur 12-18 mois. C'est comparable aux résultats de la chirurgie bariatrique, mais sans opération.</p>
          </details>
          
          <details class="faq-item">
            <summary>Y a-t-il des effets secondaires ?</summary>
            <p>Les plus fréquents sont digestifs : nausées, vomissements les premières semaines. Ils diminuent avec le temps et peuvent être gérés avec un bon suivi médical.</p>
          </details>
          
          <details class="faq-item">
            <summary>Combien de temps faut-il prendre le traitement ?</summary>
            <p>Généralement 12-18 mois pour atteindre l'objectif, puis maintien possible selon les cas. C'est un traitement long terme, pas une solution miracle à court terme.</p>
          </details>
          
          <details class="faq-item">
            <summary>Que se passe-t-il à l'arrêt ?</summary>
            <p>Une partie du poids peut être reprise (30-50% en moyenne). L'important est d'avoir acquis de nouvelles habitudes alimentaires pendant le traitement.</p>
          </details>
          
          <details class="faq-item">
            <summary>Peut-on les obtenir sans ordonnance ?</summary>
            <p>Non, ces médicaments nécessitent obligatoirement une prescription médicale et un suivi. Les achats en ligne sans ordonnance sont dangereux et illégaux.</p>
          </details>
          
          <details class="faq-item">
            <summary>Sont-ils remboursés par la Sécurité Sociale ?</summary>
            <p>Wegovy, Mounjaro et Saxenda ne sont <strong>pas remboursés</strong> par la Sécurité Sociale en France (mars 2026). Ozempic, Trulicity et Victoza sont remboursés à 65 % <strong>uniquement pour le diabète de type 2</strong> (100 % en ALD). Certaines mutuelles peuvent proposer une prise en charge partielle des traitements non remboursés.</p>
          </details>
        </div>
      </section>

      <section class="cta-section">
        <div class="cta-content">
          <h2>Prêt à Commencer Votre Transformation ?</h2>
          <p>Ne laissez plus le surpoids limiter votre vie. Ces nouveaux traitements offrent enfin une solution efficace et durable.</p>
          <div class="cta-buttons">
            <a href="/collections/medecins-glp1-france/" class="btn btn-primary">Trouver un Médecin</a>
            <a href="/qu-est-ce-que-glp1/" class="btn btn-secondary">En Savoir Plus</a>
          </div>
          <p class="cta-disclaimer">
            ⚠️ Ces médicaments nécessitent une prescription médicale et un suivi professionnel.
          </p>
        </div>
      </section>
    </article>
  </div>

  <style>
    .weight-loss-guide {
      max-width: 1000px;
      margin: 0 auto;
      padding: var(--spacing-8) 0;
    }

    /* Hero Header */
    .hero-header {
      text-align: center;
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      border-radius: var(--radius-2xl);
      padding: var(--spacing-12) var(--spacing-8);
      margin-bottom: var(--spacing-12);
    }

    .hero-header h1 {
      font-size: var(--font-size-5xl);
      font-weight: 800;
      margin-bottom: var(--spacing-6);
      line-height: 1.1;
      color: #2563EB !important;
      font-weight: 700;
    }

    .hero-subtitle {
      font-size: var(--font-size-xl);
      color: var(--gray-600);
      margin-bottom: var(--spacing-8);
      line-height: 1.6;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-stats {
      display: flex;
      justify-content: center;
      gap: var(--spacing-8);
      flex-wrap: wrap;
    }

    .stat-item {
      text-align: center;
    }

    .stat-number {
      display: block;
      font-size: var(--font-size-3xl);
      font-weight: 800;
      color: var(--primary-blue);
    }

    .stat-label {
      font-size: var(--font-size-sm);
      color: var(--gray-500);
      font-weight: 500;
    }

    /* Before/After Comparison */
    .before-after-comparison {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-8);
      margin: var(--spacing-8) 0;
    }

    .before-column {
      background: var(--red-50);
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
      border-left: 4px solid var(--red-500);
    }

    .after-column {
      background: var(--green-50);
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
      border-left: 4px solid var(--green-500);
    }

    .old-solutions, .new-solutions {
      margin-top: var(--spacing-4);
    }

    .old-solutions li, .new-solutions li {
      margin-bottom: var(--spacing-2);
      padding-left: var(--spacing-2);
    }

    /* Process Flow */
    .process-flow {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: var(--spacing-8) 0;
      flex-wrap: wrap;
      gap: var(--spacing-4);
    }

    .process-step {
      flex: 1;
      min-width: 200px;
      text-align: center;
      background: white;
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-md);
    }

    .step-icon {
      font-size: var(--font-size-4xl);
      margin-bottom: var(--spacing-4);
    }

    .process-arrow {
      font-size: var(--font-size-2xl);
      color: var(--primary-blue);
      font-weight: 600;
    }

    /* Medications Grid */
    .meds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-6);
      margin: var(--spacing-8) 0;
    }

    .med-card {
      background: white;
      border: 2px solid var(--gray-200);
      border-radius: var(--radius-xl);
      padding: var(--spacing-6);
      position: relative;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: all 0.3s ease;
    }

    .med-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
      border-color: var(--primary-blue);
    }

    .med-card.featured {
      border-color: var(--primary-blue);
      transform: scale(1.02);
    }

    .med-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
