          headers: {
            'Content-Type': 'application/json',
            'apikey': SB_KEY,
            'Authorization': 'Bearer ' + SB_KEY,
            'Prefer': 'return=representation'
          },
          body: JSON.stringify(diagnosticData)
        });

        if (!resp.ok) {
          console.error('Erreur Supabase diagnostic:', resp.status, await resp.text());
        } else {
          console.log('Diagnostic enregistre');
        }

