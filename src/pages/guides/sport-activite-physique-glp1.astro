    padding: 3rem 2rem;
    border-radius: 16px;
    margin-bottom: 3rem;
  }

  .hero-section h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
