<ArticleWithAffiliateSidebar metadata={metadata}>
  <div class="article-container">
    <div class="article-header">
      <span class="category-badge">🏥 Traitements GLP-1</span>
      <h1>Guide Complet Wegovy 2026 : Tout Savoir sur ce Traitement Révolutionnaire</h1>
      <p class="article-intro">
        Wegovy (sémaglutide) est l'un des traitements les plus efficaces pour la perte de poids. 
        Ce guide complet vous explique tout ce que vous devez savoir : efficacité, prix, effets secondaires, 
        comment l'obtenir et maximiser vos résultats.
      </p>
      <div class="article-meta">
        <span>👨‍⚕️ {metadata.author}</span>
        <span>📅 {metadata.publishedAt}</span>
        <span>⏱️ {metadata.readingTime}</span>
      </div>
    </div>

    <div class="table-of-contents">
      <h3>📋 Sommaire</h3>
      <ul>
        <li><a href="#quest-ce-que-wegovy">Qu'est-ce que Wegovy ?</a></li>
        <li><a href="#efficacite">Efficacité et Résultats</a></li>
        <li><a href="#prix-wegovy">Prix et Remboursement</a></li>
        <li><a href="#effets-secondaires">Effets Secondaires</a></li>
        <li><a href="#comment-obtenir">Comment Obtenir Wegovy</a></li>
        <li><a href="#utilisation">Mode d'Emploi</a></li>
        <li><a href="#conseils">Conseils pour Maximiser les Résultats</a></li>
        <li><a href="#temoignages">Témoignages</a></li>
      </ul>
