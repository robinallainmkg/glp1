    margin-bottom: 4rem;
  }

  .interaction-section h2 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: #1f2937;
    border-bottom: 3px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  .interaction-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    border-left: 4px solid;
    transition: all 0.3s ease;
  }

  .interaction-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .interaction-card.compatible {
    border-left-color: #10b981;
  }

  .interaction-card.caution {
    border-left-color: #f59e0b;
  }

  .interaction-card.contraindicated {
    border-left-color: #ef4444;
  }

  .interaction-card h3 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
    color: #1f2937;
  }

  .interaction-content p {
    margin-bottom: 1rem;
    color: #4b5563;
    font-weight: 500;
  }

  .interaction-content ul {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .interaction-content li {
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .recommendation {
    margin-top: 1.5rem;
    padding: 1rem;
    border-radius: 8px;
    font-weight: 600;
  }

  .recommendation.safe {
    background: #d1fae5;
    color: #065f46;
    border: 1px solid #10b981;
  }

  .recommendation.caution {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #f59e0b;
  }

  .recommendation.danger {
