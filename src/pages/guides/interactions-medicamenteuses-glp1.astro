  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .warning-banner {
      flex-direction: column;
      text-align: center;
    }

    .interaction-card {
      padding: 1.5rem;
