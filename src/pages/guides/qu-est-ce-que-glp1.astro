---
import ArticleWithAffiliateSidebar from "../../layouts/ArticleWithAffiliateSidebar.astro";

// Safe defaults (avoid typeof checks in templates)
const affiliateProducts = [];
const affiliateConfig = {};
const entry = {};
const frontmatter = null;
---

<ArticleWithAffiliateSidebar articleContent={frontmatter || entry} affiliateProducts={affiliateProducts ?? []} affiliateConfig={affiliateConfig ?? {}}>
  <div class="container">
    <article class="explanation-article">
      <header class="article-header">
        <h1>Qu'est-ce que GLP-1 ? Ozempic, Wegovy Expliqués Simplement</h1>
        <p class="article-intro">
          Vous avez entendu parler d'<strong>Ozempic</strong> ou <strong>Wegovy</strong> mais ne comprenez pas ce qu'est le "GLP-1" ? 
          Voici tout ce que vous devez savoir sur ces médicaments révolutionnaires, expliqué en termes simples.
        </p>
      </header>

      <section class="definition-section">
        <h2>🧬 GLP-1 : L'hormone naturelle qui change tout</h2>
        
        <div class="definition-grid">
          <div class="definition-text">
            <p><strong>GLP-1</strong> signifie "Glucagon-Like Peptide-1". C'est une <strong>hormone naturellement produite par votre intestin</strong> après les repas.</p>
            
            <h3>Son rôle dans votre corps :</h3>
            <ul>
              <li>🍽️ <strong>Régule l'appétit</strong> : vous dit quand vous êtes rassasié</li>
              <li>🩸 <strong>Contrôle la glycémie</strong> : aide à stabiliser le taux de sucre</li>
              <li>⏰ <strong>Ralentit la digestion</strong> : vous restez rassasié plus longtemps</li>
              <li>🧠 <strong>Agit sur le cerveau</strong> : réduit les envies de grignotage</li>
            </ul>
          </div>
          
          <div class="definition-visual">
            <div class="hormone-process">
              <div class="process-step">
                <span class="step-number">1</span>
                <span class="step-text">Vous mangez</span>
              </div>
              <div class="process-arrow">↓</div>
              <div class="process-step">
                <span class="step-number">2</span>
                <span class="step-text">Intestin produit GLP-1</span>
              </div>
              <div class="process-arrow">↓</div>
              <div class="process-step">
                <span class="step-number">3</span>
                <span class="step-text">Signal de satiété</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="medications-section">
        <h2>💊 Les Médicaments GLP-1 : Ozempic, Wegovy & Co</h2>
        
        <p class="section-intro">
          Les médicaments comme Ozempic et Wegovy sont des <strong>"agonistes du GLP-1"</strong>. 
          Ils imitent votre hormone naturelle mais durent beaucoup plus longtemps.
        </p>

        <div class="medications-grid">
          <div class="med-card">
            <h3>🔵 Ozempic</h3>
            <div class="med-details">
              <p><strong>Molécule :</strong> Sémaglutide</p>
              <p><strong>Usage principal :</strong> Diabète type 2</p>
              <p><strong>Bonus :</strong> Perte de poids significative</p>
              <p><strong>Fréquence :</strong> 1 injection/semaine</p>
            </div>
          </div>

          <div class="med-card">
            <h3>🟢 Wegovy</h3>
            <div class="med-details">
              <p><strong>Molécule :</strong> Sémaglutide (dosage +)</p>
              <p><strong>Usage principal :</strong> Perte de poids</p>
              <p><strong>Cible :</strong> Obésité et surpoids</p>
              <p><strong>Fréquence :</strong> 1 injection/semaine</p>
            </div>
          </div>

          <div class="med-card">
            <h3>🟡 Trulicity</h3>
            <div class="med-details">
              <p><strong>Molécule :</strong> Dulaglutide</p>
              <p><strong>Usage principal :</strong> Diabète type 2</p>
              <p><strong>Avantage :</strong> Bien toléré</p>
              <p><strong>Fréquence :</strong> 1 injection/semaine</p>
            </div>
          </div>
        </div>
      </section>

      <section class="comparison-section">
        <h2>🤔 Ozempic vs Wegovy : Quelle différence ?</h2>
        
        <div class="comparison-table">
          <table>
            <thead>
              <tr>
                <th>Critère</th>
                <th>Ozempic</th>
                <th>Wegovy</th>
              </tr>
            <tbody>
              <tr>
                <td><strong>Molécule</strong></td>
                <td>Sémaglutide</td>
            // Removed unused placeholders
            const affiliateConfig = {};
            // Removed unused placeholders
            // Removed unused placeholders
            const entry = {};
            const frontmatter = null;
                <td>1 mg</td>
                <td>2,4 mg</td>
              </tr>
              <tr>
                <td><strong>Indication officielle</strong></td>
                <td>Diabète type 2</td>
                <td>Perte de poids</td>
              </tr>
              <tr>
                <td><strong>Remboursement</strong></td>
                <td>Oui (diabète)</td>
                <td>Partiel (conditions)</td>
              </tr>
              <tr>
                <td><strong>Perte de poids</strong></td>
                <td>8-12%</td>
                <td>15-20%</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="key-insight">
          <h3>💡 Point clé</h3>
          <p>
            <strong>Même molécule, dosages différents :</strong> Wegovy contient plus de sémaglutide qu'Ozempic, 
            d'où une efficacité supérieure pour la perte de poids.
          </p>
        </div>
      </section>

      <section class="how-it-works">
        <h2>⚙️ Comment ça marche concrètement ?</h2>
        
        <div class="mechanism-grid">
          <div class="mechanism-step">
            <div class="step-icon">🩹</div>
            <h3>1. Injection</h3>
            <p>Une fois par semaine, sous la peau (ventre, cuisse ou bras)</p>
          </div>

          <div class="mechanism-step">
            <div class="step-icon">🔄</div>
            <h3>2. Circulation</h3>
            <p>Le médicament circule dans votre sang pendant 7 jours</p>
          </div>

          <div class="mechanism-step">
            <div class="step-icon">🧠</div>
            <h3>3. Action cerveau</h3>
            <p>Réduit l'appétit et les envies de grignotage</p>
          </div>

          <div class="mechanism-step">
            <div class="step-icon">🍽️</div>
            <h3>4. Effet digestif</h3>
            <p>Ralentit la digestion, prolonge la satiété</p>
          </div>
        </div>
      </section>

      <section class="benefits-risks">
        <h2>⚖️ Avantages et Inconvénients</h2>
        
        <div class="pros-cons-grid">
          <div class="pros-section">
            <h3>✅ Avantages</h3>
            <ul>
              <li>Perte de poids significative (10-20%)</li>
              <li>Réduction naturelle de l'appétit</li>
              <li>Amélioration du diabète</li>
              <li>1 seule injection par semaine</li>
              <li>Effets cardiovasculaires positifs</li>
            </ul>
          </div>

          <div class="cons-section">
            <h3>❌ Inconvénients</h3>
            <ul>
              <li>Prix élevé (90-270€/mois)</li>
              <li>Effets secondaires digestifs</li>
              <li>Prescription médicale obligatoire</li>
              <li>Ruptures de stock fréquentes</li>
              <li>Arrêt = reprise partielle du poids</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="who-section">
        <h2>👤 Pour qui ces médicaments ?</h2>
        
        <div class="eligibility-cards">
          <div class="eligibility-card eligible">
            <h3>✅ Vous êtes éligible si :</h3>
            <ul>
              <li>IMC ≥ 30 (obésité)</li>
              <li>IMC ≥ 27 + diabète/HTA</li>
              <li>Échec des régimes classiques</li>
              <li>Motivation long terme</li>
              <li>Suivi médical accepté</li>
            </ul>
          </div>

          <div class="eligibility-card not-eligible">
            <h3>❌ Pas adapté si :</h3>
            <ul>
              <li>Grossesse ou allaitement</li>
              <li>Diabète type 1</li>
              <li>Antécédents pancréatite</li>
              <li>Cancer thyroïde familial</li>
              <li>Troubles alimentaires sévères</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="next-steps">
        <h2>🚀 Prochaines étapes</h2>
        
        <div class="steps-grid">
          <div class="next-step">
            <span class="step-number">1</span>
            <h3>Consultez un médecin</h3>
            <p>Endocrinologue, diabétologue ou médecin traitant formé</p>
            <a href="/medecins-glp1-france/" class="step-link">Trouver un médecin →</a>
          </div>

          <div class="next-step">
            <span class="step-number">2</span>
            <h3>Vérifiez les prix</h3>
            <p>Coûts, remboursements et programmes d'aide</p>
            <a href="/glp1-cout/wegovy-prix/" class="step-link">Voir les prix →</a>
          </div>

          <div class="next-step">
            <span class="step-number">3</span>
            <h3>Préparez-vous</h3>
            <p>Effets secondaires et conseils pratiques</p>
            <a href="/effets-secondaires-glp1/" class="step-link">Guide complet →</a>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <h2>❓ Questions fréquentes</h2>
        
        <div class="faq-grid">
          <div class="faq-item">
            <h3>GLP-1 est-il un médicament chimique ?</h3>
            <p>Non, c'est une copie synthétique d'une hormone naturellement produite par votre corps. La molécule est identique à 94% à votre hormone naturelle.</p>
          </div>

          <div class="faq-item">
            <h3>Pourquoi ça coûte si cher ?</h3>
            <p>Recherche complexe (15 ans, 3 milliards €), production sophistiquée, et position monopolistique temporaire. Les prix baisseront avec la concurrence.</p>
          </div>

          <div class="faq-item">
            <h3>Est-ce que ça marche pour tout le monde ?</h3>
            <p>Environ 85% des patients perdent du poids significativement. L'efficacité varie selon l'individu, le dosage et l'accompagnement.</p>
          </div>

          <div class="faq-item">
            <h3>Peut-on l'arrêter sans risque ?</h3>
            <p>Oui, pas de sevrage physique. Cependant, 60% des patients reprennent une partie du poids perdu dans l'année suivant l'arrêt.</p>
          </div>
        </div>
      </section>
    </article>
  </div>

  <style>
    .explanation-article {
      max-width: 800px;
      margin: 0 auto;
      padding: var(--spacing-8) 0;
    }

    .article-header {
      text-align: center;
      margin-bottom: var(--spacing-12);
    }

    .article-header h1 {
      font-size: var(--font-size-4xl);
      font-weight: 800;
      margin-bottom: var(--spacing-6);
      line-height: 1.2;
    }

    .article-intro {
      font-size: var(--font-size-xl);
      color: var(--gray-600);
      line-height: 1.6;
    }

    /* Definition Section */
    .definition-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: var(--spacing-8);
      margin: var(--spacing-8) 0;
    }

    .hormone-process {
      background: var(--gray-50);
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
      text-align: center;
    }

    .process-step {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-3);
      padding: var(--spacing-3);
    }

    .step-number {
      background: var(--primary-blue);
      color: white;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--font-size-sm);
      font-weight: 600;
    }

    .process-arrow {
      color: var(--primary-blue);
      font-size: var(--font-size-xl);
      margin: var(--spacing-2) 0;
    }

    /* Medications Grid */
    .medications-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--spacing-6);
      margin: var(--spacing-8) 0;
    }

    .med-card {
      background: white;
      border: 2px solid var(--gray-200);
      border-radius: var(--radius-xl);
      padding: var(--spacing-6);
    }

    .med-card h3 {
      margin-bottom: var(--spacing-4);
      font-size: var(--font-size-xl);
    }

    .med-details p {
      margin-bottom: var(--spacing-2);
      font-size: var(--font-size-sm);
    }

    /* Comparison Table */
    .comparison-table {
      margin: var(--spacing-8) 0;
      overflow-x: auto;
    }

    .comparison-table table {
      width: 100%;
      border-collapse: collapse;
      background: white;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }

    .comparison-table th {
      background: var(--gray-100);
      padding: var(--spacing-4);
      font-weight: 600;
      text-align: left;
    }

    .comparison-table td {
      padding: var(--spacing-3) var(--spacing-4);
      border-bottom: 1px solid var(--gray-200);
    }

    .key-insight {
      background: var(--blue-50);
      border-left: 4px solid var(--primary-blue);
      padding: var(--spacing-6);
      border-radius: var(--radius-lg);
      margin: var(--spacing-6) 0;
    }

    /* Mechanism Steps */
    .mechanism-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--spacing-6);
      margin: var(--spacing-8) 0;
    }

    .mechanism-step {
      text-align: center;
      padding: var(--spacing-6);
      background: var(--gray-50);
      border-radius: var(--radius-xl);
    }

    .step-icon {
      font-size: var(--font-size-4xl);
      margin-bottom: var(--spacing-4);
    }

    /* Pros and Cons */
    .pros-cons-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-8);
      margin: var(--spacing-8) 0;
    }

    .pros-section {
      background: var(--green-50);
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
      border-left: 4px solid var(--green-500);
    }

    .cons-section {
      background: var(--red-50);
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
      border-left: 4px solid var(--red-500);
    }

    /* Eligibility Cards */
    .eligibility-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-8);
      margin: var(--spacing-8) 0;
    }

    .eligibility-card {
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
    }

    .eligible {
      background: var(--green-50);
      border-left: 4px solid var(--green-500);
    }

    .not-eligible {
      background: var(--red-50);
      border-left: 4px solid var(--red-500);
    }

    /* Next Steps */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: var(--spacing-6);
      margin: var(--spacing-8) 0;
    }

    .next-step {
      background: white;
      border: 2px solid var(--gray-200);
      border-radius: var(--radius-xl);
      padding: var(--spacing-6);
      text-align: center;
      position: relative;
    }

    .next-step .step-number {
      background: var(--primary-blue);
      color: white;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      margin: 0 auto var(--spacing-4);
    }

    .step-link {
      color: var(--primary-blue);
      text-decoration: none;
      font-weight: 500;
    }

    .step-link:hover {
      text-decoration: underline;
    }

    /* FAQ */
    .faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-6);
      margin: var(--spacing-8) 0;
    }

    .faq-item {
      background: var(--gray-50);
      padding: var(--spacing-6);
      border-radius: var(--radius-xl);
    }

    .faq-item h3 {
      margin-bottom: var(--spacing-3);
      color: var(--gray-800);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .definition-grid,
      .pros-cons-grid,
      .eligibility-cards {
        grid-template-columns: 1fr;
      }
      
      .article-header h1 {
        font-size: var(--font-size-3xl);
      }
    }
  </style>
</ArticleWithAffiliateSidebar>


