  publishedAt: '2025-01-28',
  updatedAt: '2025-01-28',
  featured: true,
  author: 'Dr. Marie-Laure Chen',
  readingTime: '16 min'
};

const affiliateConfig = {
  mobileStrategy: 'sidebar-only',
  maxInlineProducts: 0,
  sidebarPosition: 'right'
};
