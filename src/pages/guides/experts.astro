---
import StaticLayout from '../../layouts/StaticLayout.astro';

// Données SEO pour la page
const seoData = {
  title: 'Nos Experts Médicaux - Endocrinologues et Diabétologues GLP-1',
  description: 'Découvrez notre équipe d\'experts médicaux spécialisés en diabète et obésité. Endocrinologues et diabétologues qualifiés pour vos traitements GLP-1.',
  image: '/images/thumbnails/partenaires.svg',
  url: '/guides/experts',
  type: 'website'
};
---

<StaticLayout title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  url={seoData.url}
  type={seoData.type}
>
  <main class="max-w-6xl mx-auto px-4 py-8" style="background: red; color: white; padding: 2rem; margin: 2rem;">
    <h1>Test - Styles appliqués ?</h1>
    <p>Si vous voyez ce texte en blanc sur fond rouge, les styles inline fonctionnent.</p>
  </main>
    <article class="prose prose-lg max-w-none">
      <!-- Header avec image -->
      <div class="text-center mb-12">
        <div class="mb-6 mx-auto w-32 h-32 flex items-center justify-center bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Nos Experts Médicaux</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Une équipe de <strong>professionnels de santé qualifiés</strong> spécialisés dans les traitements GLP-1 et la prise en charge du diabète et de l'obésité.
        </p>
      </div>

      <!-- Présentation équipe -->
      <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 mb-12">
        <div class="text-center">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">🏥 Équipe Pluridisciplinaire</h2>
          <p class="text-gray-700 mb-6">
            Notre équipe réunit endocrinologues, diabétologues et nutritionnistes expérimentés,
            tous titulaires de diplômes universitaires et inscrits à l'Ordre des Médecins.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
            <div class="bg-white rounded-lg p-4 shadow-sm">
              <div class="text-2xl font-bold text-blue-600 mb-1">15+</div>
              <div class="text-sm text-gray-600">Années d'expérience</div>
            </div>
            <div class="bg-white rounded-lg p-4 shadow-sm">
              <div class="text-2xl font-bold text-blue-600 mb-1">5000+</div>
              <div class="text-sm text-gray-600">Patients accompagnés</div>
            </div>
            <div class="bg-white rounded-lg p-4 shadow-sm">
              <div class="text-2xl font-bold text-blue-600 mb-1">98%</div>
              <div class="text-sm text-gray-600">Taux de satisfaction</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Grille des experts -->
      <div class="grid gap-8 md:grid-cols-2">
        <!-- Dr. Claire Morel -->
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/experts/dr-claire-morel.jpg" alt="Dr. Claire Morel - Endocrinologue" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xl font-bold text-gray-900">Dr. Claire Morel</h3>
              <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Endocrinologue</span>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Spécialité :</span>
                <span class="ml-2">Diabète de type 2 • Obésité</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Expérience :</span>
                <span class="ml-2">12 ans</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Diplômes :</span>
                <span class="ml-2">DES Endocrinologie • DU Diabétologie</span>
              </div>
            </div>
            <p class="text-gray-700 text-sm leading-relaxed">
              Spécialiste reconnue en endocrinologie métabolique, le Dr. Morel accompagne les patients
              dans leur traitement GLP-1 avec une approche personnalisée et bienveillante.
            </p>
          </div>
        </div>

        <!-- Élodie Carpentier -->
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/experts/elodie-carpentier.jpg" alt="Élodie Carpentier - Diabétologue" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xl font-bold text-gray-900">Élodie Carpentier</h3>
              <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Diabétologue</span>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Spécialité :</span>
                <span class="ml-2">Diabète gestationnel • Nutrition</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Expérience :</span>
                <span class="ml-2">8 ans</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Diplômes :</span>
                <span class="ml-2">DES Diabétologie • Master Nutrition</span>
              </div>
            </div>
            <p class="text-gray-700 text-sm leading-relaxed">
              Experte en diabète gestationnel et éducation nutritionnelle, Élodie apporte un
              accompagnement complet aux femmes enceintes et aux patients nécessitant un suivi nutritionnel.
            </p>
          </div>
        </div>

        <!-- Julien Armand -->
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/experts/julien-armand.jpg" alt="Julien Armand - Endocrinologue" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xl font-bold text-gray-900">Julien Armand</h3>
              <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Endocrinologue</span>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Spécialité :</span>
                <span class="ml-2">Obésité sévère • Chirurgie bariatrique</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Expérience :</span>
                <span class="ml-2">15 ans</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Diplômes :</span>
                <span class="ml-2">DES Endocrinologie • DU Obésité</span>
              </div>
            </div>
            <p class="text-gray-700 text-sm leading-relaxed">
              Spécialiste en obésité sévère et chirurgie bariatrique, Julien coordonne les parcours
              de soins complexes et assure le suivi pré et post-opératoire des patients.
            </p>
          </div>
        </div>

        <!-- Marc Delattre -->
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-[4/3] overflow-hidden">
            <img src="/images/experts/marc-delattre.jpg" alt="Marc Delattre - Nutritionniste" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xl font-bold text-gray-900">Marc Delattre</h3>
              <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded-full">Nutritionniste</span>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Spécialité :</span>
                <span class="ml-2">Nutrition clinique • Éducation thérapeutique</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Expérience :</span>
                <span class="ml-2">10 ans</span>
              </div>
              <div class="flex items-center text-sm text-gray-600">
                <span class="font-medium">Diplômes :</span>
                <span class="ml-2">Master Nutrition • DU Éducation Thérapeutique</span>
              </div>
            </div>
            <p class="text-gray-700 text-sm leading-relaxed">
              Expert en nutrition clinique et éducation thérapeutique, Marc aide les patients
              à intégrer durablement de nouvelles habitudes alimentaires dans leur quotidien.
            </p>
          </div>
        </div>
      </div>

      <!-- Section approche -->
      <div class="mt-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">🔬 Notre Approche</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          <div class="text-center p-4">
            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-3">
              <span class="text-2xl">🔍</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Bilan Complet</h3>
            <p class="text-sm text-gray-600">Évaluation personnalisée de votre état de santé</p>
          </div>
          <div class="text-center p-4">
            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-3">
              <span class="text-2xl">💊</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Traitement Adapté</h3>
            <p class="text-sm text-gray-600">Prescription personnalisée selon vos besoins</p>
          </div>
          <div class="text-center p-4">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-3">
              <span class="text-2xl">📞</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Suivi Régulier</h3>
            <p class="text-sm text-gray-600">Accompagnement continu de votre évolution</p>
          </div>
          <div class="text-center p-4">
            <div class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-3">
              <span class="text-2xl">🥗</span>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Support Nutritionnel</h3>
            <p class="text-sm text-gray-600">Conseils alimentaires adaptés</p>
          </div>
        </div>
      </div>
    </article>
  </main>
</StaticLayout>

---
layout: ../../layouts/BaseLayout.astro
---

<section class="hero-section">
