---
// Page démo — noindex via redirect en production
import ArticleWithAffiliateSidebar from '../layouts/ArticleWithAffiliateSidebar.astro';
import InlineAffiliateProduct from '../components/InlineAffiliateProduct.astro';

// Données d'exemple pour les produits d'affiliation avec codes promo et bienfaits détaillés
const affiliateProducts = [
  {
    productName: "Ozempic (Sémaglutide)",
    brand: "Novo Nordisk", 
    productImage: "/images/products/ozempic.jpg",
    discountPercent: 15,
    promoCode: "GLP15FRANCE",
    externalLink: "https://example.com/ozempic",
    category: "Médicament GLP-1",
    benefitsText: `
      <ul>
        <li><strong>Perte de poids moyenne :</strong> 10-15% en 6 mois</li>
        <li><strong>Réduction de l'appétit :</strong> Jusqu'à 70% dès la 1ère semaine</li>
        <li><strong>Contrôle glycémique :</strong> HbA1c réduite de 1,5 points</li>
        <li><strong>Administration :</strong> 1 injection par semaine seulement</li>
        <li><strong>Sécurité :</strong> Approuvé par l'ANSM et l'EMA</li>
      </ul>
    `,
    featured: true
  },
  {
    productName: "Guide Expert GLP-1 2024",
    brand: "Dr. Martin Nutritionniste",
    productImage: "/images/products/guide.jpg",
    discountPercent: 25,
    promoCode: "GUIDE25",
    externalLink: "https://example.com/guide", 
    category: "Guide Nutritionnel",
    benefitsText: `
      <ul>
        <li><strong>150+ pages</strong> de conseils d'experts</li>
        <li><strong>Plans alimentaires</strong> adaptés aux GLP-1</li>
        <li><strong>Gestion des effets secondaires</strong> naturellement</li>
        <li><strong>Recettes exclusives</strong> pour optimiser les résultats</li>
        <li><strong>Suivi personnalisé</strong> pendant 3 mois</li>
      </ul>
    `,
    featured: false
  },
  {
    productName: "Mounjaro (Tirzépatide)",
    brand: "Eli Lilly",
    productImage: "/images/products/mounjaro.jpg",
    discountPercent: 12,
    promoCode: "MOUNJARO12",
    externalLink: "https://example.com/mounjaro",
    category: "Médicament GLP-1",
    benefitsText: `
      <ul>
        <li><strong>Double mécanisme :</strong> GLP-1 + GIP pour plus d'efficacité</li>
        <li><strong>Perte de poids supérieure :</strong> Jusqu'à 20% en 1 an</li>
        <li><strong>Meilleur contrôle glycémique :</strong> Réduction HbA1c de 2 points</li>
        <li><strong>Moins d'effets secondaires :</strong> Tolérance améliorée</li>
        <li><strong>Innovation 2024 :</strong> Dernière génération GLP-1</li>
      </ul>
    `,
    featured: false
  }
];

// Articles similaires
const relatedArticles = [
  {
    title: "Ozempic vs Mounjaro : Comparaison complète",
    slug: "ozempic-vs-mounjaro",
    excerpt: "Découvrez les différences entre ces deux traitements...",
    thumbnail: "/images/thumbnails/ozempic-mounjaro.jpg"
  },
  {
    title: "Effets secondaires du Sémaglutide", 
    slug: "effets-secondaires-semaglutide",
    excerpt: "Tout ce qu'il faut savoir sur les effets secondaires...",
    thumbnail: "/images/thumbnails/effets-secondaires.jpg"
  },
  {
    title: "Guide d'alimentation avec les GLP-1",
    slug: "guide-alimentation-glp1", 
    excerpt: "Optimisez votre alimentation pendant le traitement...",
    thumbnail: "/images/thumbnails/alimentation-glp1.jpg"
  }
];

// Configuration adaptative pour mobile/desktop
const affiliateConfig = {
  enableAutoInjection: true,
  mobileStrategy: 'both', // sidebar + inline sur mobile
  desktopStrategy: 'sidebar', // sidebar uniquement sur desktop
  inlinePositions: [2, 6, 10] // positions d'injection dans le contenu
};

// Métadonnées SEO
const pageTitle = "Demo Sidebar d'Affiliation - Test Adaptatif Mobile/Desktop";
const pageDescription = "Page de test pour la sidebar d'affiliation adaptative avec injection inline sur mobile et sidebar fixe sur desktop.";
---

<ArticleWithAffiliateSidebar 
  title={pageTitle}
  description={pageDescription}
  products={affiliateProducts}
  relatedArticles={relatedArticles}
  config={affiliateConfig}
>
  <article class="prose prose-lg max-w-none">
    <div class="bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-lg p-8 mb-8">
      <h1 class="text-3xl font-bold mb-4">🧪 Demo Système d'Affiliation Adaptatif</h1>
      <p class="text-lg opacity-90 mb-4">
        Cette page teste notre solution au problème de sidebar mobile en injectant automatiquement 
        des produits d'affiliation dans le contenu sur petits écrans.
      </p>
      <div class="bg-white/10 rounded-lg p-4">
        <h3 class="font-semibold mb-2">📱 Fonctionnalités testées :</h3>
        <ul class="text-sm space-y-1 opacity-90">
          <li>✅ Sidebar fixe sur desktop/tablette</li>
          <li>✅ Injection automatique sur mobile</li>
          <li>✅ Adaptation responsive fluide</li>
          <li>✅ Configuration personnalisable</li>
        </ul>
      </div>
    </div>

    <h2>Introduction aux GLP-1</h2>
    <p>
      Les agonistes du récepteur GLP-1 représentent une révolution dans le traitement du diabète de type 2 
      et de l'obésité. Ces médicaments imitent l'action d'une hormone naturelle qui régule la glycémie 
      et l'appétit.
    </p>

    <!-- PRODUIT INLINE #1 - Après le 2ème paragraphe -->
    <InlineAffiliateProduct 
      product={affiliateProducts[0]}
      position="right"
      size="medium"
      showFullDescription={true}
    />

    <h2>Comment ça fonctionne sur cette page</h2>
    <p>
      Le système détecte automatiquement la taille d'écran et adapte l'affichage des produits d'affiliation :
    </p>
    
    <ul>
      <li><strong>Desktop/Tablette :</strong> Sidebar fixe à droite avec tous les produits</li>
      <li><strong>Mobile :</strong> Injection automatique de produits dans le contenu + sidebar en bas</li>
      <li><strong>Adaptatif :</strong> Transition fluide entre les deux modes</li>
    </ul>

    <h2>Avantages des traitements GLP-1</h2>
    <p>
      Les médicaments comme Ozempic et Mounjaro offrent plusieurs avantages significatifs pour 
      la gestion du poids et du diabète. Ils agissent en ralentissant la vidange gastrique, 
      ce qui procure une sensation de satiété prolongée.
    </p>

    <h2>Mécanisme d'action</h2>
    <p>
      Les GLP-1 agissent sur plusieurs niveaux dans l'organisme. Ils stimulent la production d'insuline 
      uniquement lorsque la glycémie est élevée, réduisent la production de glucagon et ralentissent 
      la vidange gastrique.
    </p>

    <!-- PRODUIT INLINE #2 - Après le 6ème paragraphe -->
    <InlineAffiliateProduct 
      product={affiliateProducts[1]}
      position="left"
      size="large"
      showFullDescription={true}
    />

    <h2>Témoignages de patients</h2>
    <p>
      De nombreux patients rapportent une perte de poids significative avec les traitements GLP-1. 
      Les résultats varient selon les individus, mais les études cliniques montrent une efficacité 
      remarquable avec une perte moyenne de 10 à 15% du poids corporel.
    </p>

    <h2>Suivi médical recommandé</h2>
    <p>
      Il est essentiel de maintenir un suivi médical régulier pendant le traitement. Votre médecin 
      ajustera la posologie selon votre réponse au traitement et surveillera les éventuels effets 
      secondaires qui peuvent apparaître en début de traitement.
    </p>

    <h2>Conseils nutritionnels</h2>
    <p>
      Bien que les GLP-1 réduisent considérablement l'appétit, il reste important de maintenir une alimentation 
      équilibrée et nutritive. Privilégiez les protéines maigres, les légumes verts et les céréales complètes 
      pour optimiser les résultats et maintenir votre santé.
    </p>

    <h2>Gestion des effets secondaires</h2>
    <p>
      Les effets secondaires les plus courants incluent des nausées, des vomissements et des troubles digestifs, 
      particulièrement en début de traitement. Ces symptômes s'atténuent généralement avec le temps et 
      peuvent être minimisés par une montée progressive des doses.
    </p>

    <h2>Résultats à long terme</h2>
    <p>
      Les études montrent que les bénéfices des GLP-1 se maintiennent tant que le traitement est 
      poursuivi de manière continue. L'arrêt du traitement peut entraîner une reprise progressive du poids, 
      d'où l'importance d'un suivi médical à long terme.
    </p>

    <h2>Comparaison des options disponibles</h2>
    <p>
      Chaque médicament GLP-1 a ses spécificités particulières. Ozempic (sémaglutide) est administré une fois par semaine, 
      tandis que Mounjaro (tirzépatide) combine deux mécanismes d'action différents pour une efficacité 
      potentiellement supérieure sur la perte de poids.
    </p>

    <h2>Conclusion et perspectives</h2>
    <p>
      Les traitements GLP-1 représentent un espoir considérable pour les personnes en surpoids 
      ou souffrant de diabète de type 2. Avec un suivi médical approprié, des attentes réalistes 
      et une approche globale incluant nutrition et activité physique, ils peuvent véritablement 
      transformer la vie des patients.
    </p>

    <div class="mt-12 p-6 bg-blue-50 rounded-lg">
      <h3 class="text-lg font-semibold text-blue-900 mb-3">
        🔧 Informations techniques pour développeurs
      </h3>
      <ul class="text-sm text-blue-800 space-y-2">
        <li><strong>Layout utilisé :</strong> ArticleWithAffiliateSidebar</li>
        <li><strong>Produits d'affiliation :</strong> {affiliateProducts.length} produits configurés</li>
        <li><strong>Articles similaires :</strong> {relatedArticles.length} articles liés</li>
        <li><strong>Mode adaptatif :</strong> {affiliateConfig.mobileStrategy} sur mobile, {affiliateConfig.desktopStrategy} sur desktop</li>
        <li><strong>Injection inline :</strong> Positions {affiliateConfig.inlinePositions.join(', ')}</li>
      </ul>
    </div>
  </article>
</ArticleWithAffiliateSidebar>
