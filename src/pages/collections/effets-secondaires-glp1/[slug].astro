---
import ArticleWithAffiliateSidebar from '../../../layouts/ArticleWithAffiliateSidebar.astro';
import FAQSchema from '../../../components/FAQSchema.astro';
import { getCollection } from 'astro:content';
import { getRecommendedProducts } from '../../../lib/affiliate';

export async function getStaticPaths() {
  const entries = await getCollection('effets-secondaires-glp1');
  return entries.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const entryAny: any = entry;
const { Content } = await entryAny.render();
const content = entryAny.body;

// Utiliser le nom de la collection au lieu de la catégorie du frontmatter
const collectionName = "effets-secondaires-glp1";

// Récupérer les produits d'affiliation recommandés
const affiliateProducts = await getRecommendedProducts(content, collectionName, 3);

// FAQ Schema data from frontmatter
const faqItems = entryAny.data.faqSchema || [];

// Configuration TinaCMS pour cette page
// Tina props removed (not used in production)
---

<ArticleWithAffiliateSidebar showAffiliateSidebar={true} title={entryAny.data.title}
  description={entryAny.data.description || entryAny.data.metaDescription || ""}
  image={entryAny.data.image || entryAny.data.thumbnail || `/images/thumbnails/${entryAny.collection}.svg`}
  author={entryAny.data.author || "Équipe GLP-1 France"}
  category={collectionName}
  articleContent={content}
  affiliateProducts={affiliateProducts ?? []}
  affiliateConfig={{
    enableAutoInjection: true,
    mobileStrategy: 'both',
    maxInlineProducts: 3,
    injectionStrategy: 'auto'
  }}
>
  {faqItems.length > 0 && <FAQSchema items={faqItems} />}
  <Content />
</ArticleWithAffiliateSidebar>
