---
import ArticleWithAffiliateSidebar from "../../../layouts/ArticleWithAffiliateSidebar.astro";

// Removed unused placeholders

// Configuration d'affiliation pour cette page
const affiliateConfig = {
  enableAutoInjection: true,
  mobileStrategy: 'both' as const,
  maxInlineProducts: 2,
  injectionStrategy: 'auto' as const
};

// Contenu de l'article pour l'analyse d'affiliation
const articleContent = `
Wegovy Prix : Tarifs Détaillés en France 2026
Prix Wegovy pharmacie, coût sémaglutide, remboursement Wegovy
Quel est le prix de Wegovy en France ? Analyse complète des tarifs et remboursement
Médicament perte de poids, injection sémaglutide, prescription médicale
`;
---

<ArticleWithAffiliateSidebar 
  title="Wegovy Prix : Tarifs Détaillés en France 2026"
  description="Prix Wegovy en France : tarifs pharmacie, coût sémaglutide et remboursement. Guide complet 2026."
  articleContent={articleContent} 
  affiliateConfig={affiliateConfig ?? {}} 
  image="/images/thumbnails/wegovy-prix.jpg"
  category="glp1-cout"
>

<div class="container">
  <article class="article-content">
    <header class="article-header">
      <h2>Wegovy Prix : Tarifs Détaillés en France 2026</h2>
      <div class="article-meta">
        <span class="article-author">Dr. Émilie Martin</span>
        <span class="article-date">8 août 2026</span>
        <span class="article-reading-time">8 min de lecture</span>
      </div>
    </header>

    <div class="article-body">
      <h2>💰 Prix de Wegovy par dosage</h2>
      <div class="price-table">
        <table>
          <thead>
            <tr>
              <th>Dosage</th>
              <th>Prix pharmacie</th>
              <th>Durée</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>0,25 mg</td>
              <td>280€</td>
              <td>4 semaines</td>
            </tr>
            <tr>
              <td>0,5 mg</td>
              <td>290€</td>
              <td>4 semaines</td>
            </tr>
            <tr>
              <td>1,0 mg</td>
              <td>300€</td>
              <td>4 semaines</td>
            </tr>
            <tr>
              <td>1,7 mg</td>
              <td>310€</td>
              <td>4 semaines</td>
            </tr>
            <tr>
              <td>2,4 mg</td>
              <td>320€</td>
              <td>4 semaines</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h2>🏥 Remboursement Sécurité Sociale</h2>
      <p>
        Wegovy peut être remboursé à <strong>65%</strong> dans certaines conditions :
      </p>
      <ul>
        <li>IMC ≥ 35 avec comorbidités sévères</li>
        <li>Prescription hospitalière initiale</li>
        <li>Protocole de soins validé</li>
        <li>Suivi médical trimestriel</li>
      </ul>

      <h2>🔄 Comparaison avec les alternatives</h2>
      <p>
        Comparé à <a href="/collections/glp1-cout/saxenda-prix-pharmacie/">Saxenda</a> (250€/mois)
        et aux <a href="/collections/glp1-cout/operation-pour-maigrir-prix/">interventions chirurgicales</a> (15 000€+), 
        Wegovy représente un investissement significatif mais potentiellement moins coûteux sur le long terme.
      </p>

      <h2>💡 Conseils pour réduire les coûts</h2>
      <ul>
        <li>Vérifiez la couverture de votre mutuelle</li>
        <li>Explorez les programmes d'aide du laboratoire</li>
        <li>Considérez les génériques à venir</li>
        <li>Négociez avec votre pharmacien</li>
      </ul>
    </div>
  </article>
</div>

<style>
  .price-table table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--spacing-6) 0;
  }
  
  .price-table th,
  .price-table td {
    padding: var(--spacing-3);
    text-align: left;
    border-bottom: 1px solid var(--gray-200);
  }
  
  .price-table th {
    background: var(--gray-50);
    font-weight: 600;
    color: var(--primary-blue);
  }
  
  .price-table tr:hover {
    background: var(--gray-50);
  }
</style>

</ArticleWithAffiliateSidebar>
