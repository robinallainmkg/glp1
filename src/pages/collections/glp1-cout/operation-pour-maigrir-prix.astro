---
import ArticleWithAffiliateSidebar from "../../../layouts/ArticleWithAffiliateSidebar.astro";
// affiliateProducts placeholder removed
const affiliateConfig = {
  enableAutoInjection: true,
  mobileStrategy: 'both',
  maxInlineProducts: 2,
  injectionStrategy: 'auto'
};
// entry/frontmatter placeholders removed

// Contenu de l'article pour l'analyse d'affiliation
const articleContent = `
Opération pour Maigrir : Prix et Alternatives en 2025
Prix chirurgie bariatrique, sleeve gastrectomie, bypass gastrique
Combien coûte une opération pour maigrir ? Prix sleeve, bypass et alternatives
Chirurgie obésité, intervention bariatrique, remboursement sécurité sociale
`;
---

<ArticleWithAffiliateSidebar 
  title="Opération pour Maigrir : Prix et Alternatives en 2025"
  description="Prix opération pour maigrir : sleeve, bypass, prix et remboursement. Guide chirurgie bariatrique 2025."
  articleContent={articleContent} 
  affiliateConfig={affiliateConfig ?? {}} 
  image="/images/thumbnails/operation-pour-maigrir-prix.jpg"
  category="glp1-cout"
>

<div class="container">
  <article class="article-content">
    <header class="article-header">
      <h1>Opération pour Maigrir : Prix et Alternatives en 2025</h1>
      <div class="article-meta">
        <span class="article-author">Dr. Émilie Martin</span>
        <span class="article-date">8 août 2025</span>
        <span class="article-reading-time">9 min de lecture</span>
      </div>
    </header>

    <div class="article-body">
      <h2>💰 Prix des interventions chirurgicales</h2>
      <div class="surgery-prices">
        <div class="price-card">
          <h3>Sleeve Gastrectomie</h3>
          <div class="price">15 000€ - 20 000€</div>
          <p>Réduction de l'estomac de 80%</p>
        </div>
        
        <div class="price-card">
          <h3>Bypass Gastrique</h3>
          <div class="price">18 000€ - 25 000€</div>
          <p>Court-circuit de l'intestin</p>
        </div>
        
        <div class="price-card">
          <h3>Anneau Gastrique</h3>
          <div class="price">8 000€ - 12 000€</div>
          <p>Pose d'un anneau ajustable</p>
        </div>
      </div>

      <h2>🏥 Remboursement Sécurité Sociale</h2>
      <p>
        La chirurgie bariatrique est remboursée à <strong>100%</strong> sous conditions :
      </p>
      <ul>
        <li>IMC ≥ 40 ou IMC ≥ 35 avec comorbidités</li>
        <li>Échec de traitement médical pendant 6 mois</li>
        <li>Évaluation psychiatrique et nutritionnelle</li>
        <li>Centre agréé et équipe pluridisciplinaire</li>
      </ul>

      <h2>⚖️ Chirurgie vs Traitements GLP-1</h2>
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Critère</th>
            <th>Chirurgie</th>
            <th>GLP-1 (Wegovy/Saxenda)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Coût initial</td>
            <td>15 000€ - 25 000€</td>
            <td>3 000€ - 4 000€/an</td>
          </tr>
          <tr>
            <td>Risques</td>
            <td>Élevés (chirurgie)</td>
            <td>Modérés (médicament)</td>
          </tr>
          <tr>
            <td>Réversibilité</td>
            <td>Non/Limitée</td>
            <td>Oui</td>
          </tr>
          <tr>
            <td>Perte de poids</td>
            <td>60-80% excès</td>
            <td>15-20% total</td>
          </tr>
        </tbody>
      </table>

      <h2>🤔 Quelle option choisir ?</h2>
      <p>
        Le choix entre chirurgie et traitements GLP-1 dépend de plusieurs facteurs :
      </p>
      
      <div class="decision-guide">
        <div class="option">
          <h3>Chirurgie recommandée si :</h3>
          <ul>
            <li>IMC > 40 ou > 35 avec comorbidités sévères</li>
            <li>Échec des traitements médicaux</li>
            <li>Motivation et suivi assurés</li>
            <li>Absence de contre-indications</li>
          </ul>
        </div>
        
        <div class="option">
          <h3>GLP-1 préférable si :</h3>
          <ul>
            <li>IMC entre 27 et 40</li>
            <li>Première approche médicamenteuse</li>
            <li>Contre-indications chirurgicales</li>
            <li>Préférence pour une approche réversible</li>
          </ul>
        </div>
      </div>

      <h2>🔗 Pour aller plus loin</h2>
      <p>
        Consultez nos guides sur les <a href="/collections/glp1-perte-de-poids/">détails de la perte de poids sous GLP-1</a>
        et les <a href="/collections/glp1-cout/wegovy-prix/">prix des traitements GLP-1</a> pour faire le meilleur choix.
      </p>
    </div>
  </article>
</div>

<style>
  .surgery-prices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-6);
    margin: var(--spacing-6) 0;
  }
  
  .price-card {
    background: white;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-xl);
    padding: var(--spacing-6);
    text-align: center;
    transition: all 0.3s ease;
  }
  
  .price-card:hover {
    border-color: var(--primary-blue);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .price-card h3 {
    color: var(--primary-blue);
    margin-bottom: var(--spacing-3);
  }
  
  .price {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--accent-green);
    margin: var(--spacing-3) 0;
  }
  
  .decision-guide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-6);
    margin: var(--spacing-6) 0;
  }
  
  .option {
    background: var(--gray-50);
    padding: var(--spacing-6);
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--primary-blue);
  }
  
  .option h3 {
    color: var(--primary-blue);
    margin-bottom: var(--spacing-4);
  }
  
  .comparison-table {
    width: 100%;
    margin: var(--spacing-6) 0;
  }
  
  .comparison-table table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .comparison-table th,
  .comparison-table td {
    padding: var(--spacing-3);
    text-align: left;
    border-bottom: 1px solid var(--gray-200);
  }
  
  .comparison-table th {
    background: var(--gray-50);
    font-weight: 600;
    color: var(--primary-blue);
  }
</style>

</ArticleWithAffiliateSidebar>
