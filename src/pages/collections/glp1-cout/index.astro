---
import CollectionLayout from '../../../layouts/CollectionLayout.astro';
import { getCollection } from 'astro:content';

// Récupérer tous les articles de cette collection
const articles = await getCollection('glp1-cout');

// Créer l'objet collection attendu par le layout
const collection = {
  id: 'glp1-cout',
  name: 'Prix et coût GLP-1',
  slug: 'glp1-cout',
  description: 'GLP-1 prix 2026 en France : Ozempic 80€, Wegovy dès 169€, Mounjaro 230€, Saxenda 240€. Remboursement Sécu et mutuelle (Mounjaro 2026) - tous les comparatifs.',
  icon: '💰',
  color: '#ea580c',
  seoTitle: 'GLP-1 Prix 2026 : Comparatif Ozempic, Wegovy, Mounjaro',
  seoDescription: 'GLP-1 prix France 2026 : Ozempic 80€, Wegovy 169€, Mounjaro 230€, Saxenda 240€. Remboursement Ameli + mutuelles (forfait 50-200€) - guide complet.',
  keywords: ["glp-1 prix","prix glp1","glp1 prix","coût ozempic","remboursement wegovy","mounjaro remboursement 2026 mutuelle","mounjaro remboursement 2026","prix saxenda","prix mounjaro","prix wegovy"],
  image: '/images/thumbnails/glp1-cout.svg'
};

// Formater les articles pour le layout
const formattedArticles = articles.map((article: any) => ({
  slug: article.slug,
  title: article.data.title,
  description: article.data.description || article.data.metaDescription || '',
  author: article.data.author || 'Équipe GLP-1 France',
  url: `/collections/glp1-cout/${article.slug}`,
  wordCount: article.body.split(' ').length,
  readingTime: Math.ceil(article.body.split(' ').length / 200),
  lastModified: article.data.lastModified || article.data.pubDate || new Date().toISOString(),
  thumbnail: article.data.thumbnail || article.data.image || `/images/thumbnails/${article.slug}-illus.jpg`
}));
---

<CollectionLayout 
  collection={collection}
  articles={formattedArticles}
>
</CollectionLayout>