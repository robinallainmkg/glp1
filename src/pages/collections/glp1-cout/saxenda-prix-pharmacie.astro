---
import ArticleWithAffiliateSidebar from "../../../layouts/ArticleWithAffiliateSidebar.astro";

// Removed unused placeholders

// Configuration d'affiliation pour cette page
const affiliateConfig = {
  enableAutoInjection: true,
  mobileStrategy: 'both' as const,
  maxInlineProducts: 2,
  injectionStrategy: 'auto' as const
};

// Contenu de l'article pour l'analyse d'affiliation
const articleContent = `
Saxenda Prix en Pharmacie : Guide Complet 2026
Prix Saxenda pharmacie, coût liraglutide, remboursement Saxenda
Combien coûte Saxenda en pharmacie française ? Guide complet des prix et remboursement
Médicament pour maigrir, injection liraglutide, prescription médicale
`;
---

<ArticleWithAffiliateSidebar 
  title="Saxenda Prix en Pharmacie : Guide Complet 2026"
  description="Prix Saxenda en pharmacie : combien coûte le liraglutide ? Guide remboursement et tarifs 2026."
  articleContent={articleContent} 
  affiliateConfig={affiliateConfig ?? {}} 
  image="/images/thumbnails/saxenda-prix-pharmacie.jpg"
  category="glp1-cout"
>

<div class="container">
  <article class="article-content">
    <header class="article-header">
      <h2>Saxenda Prix en Pharmacie : Guide Complet 2026</h2>
      <div class="article-meta">
        <span class="article-author">Dr. Émilie Martin</span>
        <span class="article-date">8 août 2026</span>
        <span class="article-reading-time">7 min de lecture</span>
      </div>
    </header>

    <div class="article-body">
      <h2>💰 Prix de Saxenda en France</h2>
      <p>
        Le prix de Saxenda en pharmacie française s'élève à <strong>environ 250€ par mois</strong>. 
        Ce prix peut légèrement varier selon les pharmacies et les négociations locales.
      </p>

      <h2>📦 Contenu et posologie</h2>
      <ul>
        <li><strong>5 stylos pré-remplis</strong> de 6 mg/ml</li>
        <li>Dose maximale : <strong>3 mg par jour</strong></li>
        <li>Escalade progressive sur 5 semaines</li>
        <li>Conservation au réfrigérateur</li>
      </ul>

