---
import { getCollection } from 'astro:content';
import ArticleWithAffiliateSidebar from '../../../layouts/ArticleWithAffiliateSidebar.astro';
import { getAllAffiliateProducts } from '../../../lib/affiliate.ts';

export async function getStaticPaths() {
  const pagesStatiques = await getCollection('pages-statiques');
  return pagesStatiques.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Chargement des produits d'affiliation
const affiliateProducts = await getAllAffiliateProducts();

// Données pour le layout avec affiliation
const layoutProps = {
  title: entry.data.title,
  description: entry.data.description,
  author: entry.data.author || 'Dr. Martin',
  pubDate: entry.data.pubDate || entry.data.date,
  heroImage: entry.data.image || entry.data.thumbnail,
  category: entry.data.category || 'pages-statiques',
  readingTime: entry.data.readingTime || 8,
  affiliateProducts: affiliateProducts,
  enableAffiliation: true,
  affiliateConfig: {
    enableAutoInjection: true,
    mobileStrategy: 'both',
    maxInlineProducts: 3,
    injectionStrategy: 'auto'
  }
};
---

<ArticleWithAffiliateSidebar {...layoutProps}>
  <Content />
</ArticleWithAffiliateSidebar>
