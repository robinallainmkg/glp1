---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllAffiliateProducts } from '../../../lib/affiliate.ts';
import AffiliateSidebar from '../../../components/AffiliateSidebar.astro';

// Récupération des articles de la collection pages-statiques
const pagesStatiques = await getCollection('pages-statiques');

// Tri par date de publication (plus récent en premier)
const sortedPages = pagesStatiques.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || a.data.date || '2025-01-01');
  const dateB = new Date(b.data.pubDate || b.data.date || '2025-01-01');
  return dateB.getTime() - dateA.getTime();
});

// Chargement des produits d'affiliation
const affiliateProducts = await getAllAffiliateProducts();
console.log('🔍 Connexion à Supabase pour charger les produits...');
console.log(`✅ Produits Supabase chargés: ${affiliateProducts.length} produits trouvés`);
---

<BaseLayout 
  title="Pages Statiques GLP-1 France"
  description="Découvrez nos pages spéciales sur les traitements GLP-1, témoignages de célébrités et actualités médicales."
>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col lg:flex-row gap-8">
      
      <!-- Contenu principal -->
      <main class="flex-1">
        <h1 class="text-4xl font-bold text-gray-900 mb-8">
          📄 Pages Spéciales GLP-1
        </h1>
        
        <p class="text-lg text-gray-600 mb-8">
          Découvrez nos contenus exclusifs sur les traitements GLP-1, témoignages de personnalités et actualités médicales.
        </p>

        <!-- Grille des articles -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-1">
          {sortedPages.map((page) => (
            <article class="bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow p-6">
              <div class="flex flex-col md:flex-row gap-4">
                
                <!-- Image -->
                {page.data.image && (
                  <div class="md:w-48 flex-shrink-0">
                    <img 
                      src={page.data.image} 
                      alt={page.data.thumbnailAlt || page.data.title}
                      class="w-full h-32 md:h-24 object-cover rounded-lg"
                      loading="lazy"
                    />
                  </div>
                )}
                
                <!-- Contenu -->
                <div class="flex-1">
                  <h2 class="text-xl font-bold text-gray-900 mb-2">
                    <a 
                      href={`/collections/pages-statiques/${page.slug}/`}
                      class="hover:text-blue-600 transition-colors"
                    >
                      {page.data.title}
                    </a>
                  </h2>
                  
                  <p class="text-gray-600 mb-3 line-clamp-2">
                    {page.data.description}
                  </p>
                  
                  <div class="flex items-center gap-4 text-sm text-gray-500">
                    <span>👨‍⚕️ {page.data.author || 'Dr. Martin'}</span>
                    <span>📅 {new Date(page.data.pubDate || page.data.date || '2025-01-01').toLocaleDateString('fr-FR')}</span>
                    {page.data.readingTime && (
                      <span>⏱️ {page.data.readingTime} min</span>
                    )}
                  </div>
                  
                  <a 
                    href={`/collections/pages-statiques/${page.slug}/`}
                    class="inline-block mt-3 text-blue-600 hover:text-blue-800 font-medium"
                  >
                    Lire la suite →
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        {sortedPages.length === 0 && (
          <div class="text-center py-12">
            <p class="text-gray-500 text-lg">Aucune page statique disponible pour le moment.</p>
          </div>
        )}
      </main>

      <!-- Sidebar avec affiliation -->
      <aside class="lg:w-80">
        <AffiliateSidebar 
          products={affiliateProducts}
          authorName="Dr. Martin"
          className="sticky top-4"
        />
      </aside>
      
    </div>
  </div>
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
