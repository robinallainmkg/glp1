---
// Redirection 301 pour SEO : /glp1-diabete/diabete-type-2-traitement/ → /collections/glp1-diabete/
if (Astro.url.pathname === '/glp1-diabete/diabete-type-2-traitement' || Astro.url.pathname === '/glp1-diabete/diabete-type-2-traitement/') {
  return Astro.redirect('/collections/glp1-diabete/', 301);
}
---

<html>
<head>
  <title>Redirection en cours...</title>
  <meta http-equiv="refresh" content="0; url=/collections/glp1-diabete/">
  <link rel="canonical" href="/collections/glp1-diabete/">
</head>
<body>
  <p>Redirection vers <a href="/collections/glp1-diabete/">la page du diabète de type 2 et GLP-1</a>...</p>
</body>
</html>
