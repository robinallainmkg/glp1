---
import StaticLayout from '../layouts/StaticLayout.astro';
---

<StaticLayout 
  title="Calculateur de Prix GLP-1 Personnalisé - Ozempic Wegovy Mounjaro"
  description="Calculez le coût réel de votre traitement GLP-1 selon votre IMC, mutuelle et région. Outil gratuit et personnalisé."
>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        💰 Calculateur de Prix GLP-1 Personnalisé
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Découvrez le coût réel de votre traitement selon votre profil, votre mutuelle et votre région
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
        <!-- Progress Bar -->
        <div class="bg-blue-600 h-2">
          <div id="progress-bar" class="bg-yellow-400 h-full transition-all duration-500" style="width: 0%"></div>
        </div>

        <!-- Step 1: Profil -->
        <div id="step-1" class="step-content p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            👤 Votre Profil
          </h2>
          
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Âge</label>
              <input 
                type="number" 
                id="age" 
                min="18" 
                max="80" 
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                placeholder="Ex: 45"
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Poids (kg)</label>
              <input 
                type="number" 
                id="weight" 
                min="40" 
                max="200" 
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                placeholder="Ex: 85"
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Taille (cm)</label>
              <input 
                type="number" 
                id="height" 
                min="140" 
                max="220" 
                class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none"
                placeholder="Ex: 170"
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Région</label>
              <select id="region" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:outline-none">
                <option value="">Sélectionnez votre région</option>
                <option value="idf">Île-de-France</option>
                <option value="paca">PACA</option>
                <option value="ara">Auvergne-Rhône-Alpes</option>
                <option value="hdf">Hauts-de-France</option>
                <option value="other">Autre</option>
              </select>
            </div>
          </div>

          <div class="mt-8 flex justify-end">
            <button onclick="nextStep(2)" class="px-8 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors">
              Étape suivante →
            </button>
          </div>
        </div>

        <!-- Step 2: Mutuelle -->
        <div id="step-2" class="step-content p-8 hidden">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            🏥 Votre Couverture Santé
          </h2>
          
          <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <label class="mutuelle-card cursor-pointer">
                <input type="radio" name="mutuelle" value="premium" class="sr-only" />
                <div class="p-6 border-2 border-gray-200 rounded-xl hover:border-blue-500 transition-all mutuelle-option">
                  <h3 class="font-bold text-lg mb-2">Mutuelle Premium</h3>
                  <p class="text-gray-600 text-sm">Harmonie, Malakoff, AG2R...</p>
                  <div class="text-green-600 font-semibold mt-2">Remboursement 65-80%</div>
                </div>
              </label>
              
              <label class="mutuelle-card cursor-pointer">
                <input type="radio" name="mutuelle" value="standard" class="sr-only" />
                <div class="p-6 border-2 border-gray-200 rounded-xl hover:border-blue-500 transition-all mutuelle-option">
                  <h3 class="font-bold text-lg mb-2">Mutuelle Standard</h3>
                  <p class="text-gray-600 text-sm">MGEN, MAAF, Crédit Agricole...</p>
                  <div class="text-orange-600 font-semibold mt-2">Remboursement 35-50%</div>
                </div>
              </label>
              
              <label class="mutuelle-card cursor-pointer">
                <input type="radio" name="mutuelle" value="basic" class="sr-only" />
                <div class="p-6 border-2 border-gray-200 rounded-xl hover:border-blue-500 transition-all mutuelle-option">
                  <h3 class="font-bold text-lg mb-2">Sécu seule</h3>
                  <p class="text-gray-600 text-sm">Pas de mutuelle</p>
                  <div class="text-red-600 font-semibold mt-2">Remboursement 0%</div>
                </div>
              </label>
            </div>
          </div>

          <div class="mt-8 flex justify-between">
            <button onclick="previousStep(1)" class="px-8 py-3 bg-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-400 transition-colors">
              ← Retour
            </button>
            <button onclick="nextStep(3)" class="px-8 py-3 bg-blue-600 text-white font-semibold rounded-xl hover:bg-blue-700 transition-colors">
              Calculer mon prix →
            </button>
          </div>
        </div>

        <!-- Step 3: Résultats -->
        <div id="step-3" class="step-content p-8 hidden">
          <div id="results-content">
            <!-- Contenu généré dynamiquement -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.mutuelle-option:has(input:checked) {
  @apply border-blue-500 bg-blue-50;
}
</style>

<script>
let currentStep = 1;
let userData = {};

function nextStep(step) {
  // Validation et collecte des données
  if (currentStep === 1) {
    userData.age = document.getElementById('age').value;
    userData.weight = document.getElementById('weight').value;
    userData.height = document.getElementById('height').value;
    userData.region = document.getElementById('region').value;
    userData.imc = (userData.weight / ((userData.height / 100) ** 2)).toFixed(1);
  }
  
  if (currentStep === 2) {
    userData.mutuelle = document.querySelector('input[name="mutuelle"]:checked')?.value;
    if (step === 3) {
      generateResults();
    }
  }

  document.getElementById(`step-${currentStep}`).classList.add('hidden');
  document.getElementById(`step-${step}`).classList.remove('hidden');
  
  currentStep = step;
  updateProgressBar();
}

function previousStep(step) {
  document.getElementById(`step-${currentStep}`).classList.add('hidden');
  document.getElementById(`step-${step}`).classList.remove('hidden');
  
  currentStep = step;
  updateProgressBar();
}

function updateProgressBar() {
  const progress = (currentStep / 3) * 100;
  document.getElementById('progress-bar').style.width = `${progress}%`;
}

function generateResults() {
  // Algorithme de calcul personnalisé
  const treatments = [
    {
      name: 'Wegovy',
      basePrice: 272,
      eligible: userData.imc >= 30,
      description: 'Traitement le plus efficace pour la perte de poids'
    },
    {
      name: 'Mounjaro', 
      basePrice: 285,
      eligible: userData.imc >= 27,
      description: 'Nouvelle génération, efficacité supérieure'
    },
    {
      name: 'Ozempic',
      basePrice: 89,
      eligible: true,
      description: 'Option économique, bien remboursé'
    }
  ];

  const mutuelleDiscounts = {
    premium: 0.7,
    standard: 0.4,
    basic: 0
  };

  const discount = mutuelleDiscounts[userData.mutuelle] || 0;

  let resultsHTML = `
    <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">
      🎯 Votre Analyse Personnalisée
    </h2>
    
    <div class="bg-blue-50 p-6 rounded-xl mb-8">
      <div class="grid md:grid-cols-4 gap-4 text-center">
        <div>
          <div class="text-2xl font-bold text-blue-600">IMC ${userData.imc}</div>
          <div class="text-sm text-gray-600">Votre IMC</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-green-600">${Math.round(discount * 100)}%</div>
          <div class="text-sm text-gray-600">Remboursement</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-purple-600">${userData.region}</div>
          <div class="text-sm text-gray-600">Région</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-orange-600">${userData.age} ans</div>
          <div class="text-sm text-gray-600">Âge</div>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-8">
  `;

  treatments.forEach((treatment, index) => {
    const finalPrice = Math.round(treatment.basePrice * (1 - discount));
    const savings = Math.round(treatment.basePrice * discount);
    
    resultsHTML += `
      <div class="bg-white border-2 ${treatment.eligible ? 'border-green-500' : 'border-gray-300'} rounded-xl p-6 ${index === 0 ? 'ring-2 ring-blue-500' : ''}">
        <h3 class="text-xl font-bold mb-3">${treatment.name}</h3>
        <div class="text-3xl font-bold text-gray-900 mb-2">${finalPrice}€</div>
        <div class="text-sm text-gray-500 line-through mb-2">${treatment.basePrice}€</div>
        <div class="text-green-600 font-semibold mb-4">Économie: ${savings}€/mois</div>
        <p class="text-gray-600 text-sm mb-4">${treatment.description}</p>
        ${treatment.eligible 
          ? '<div class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">✅ Éligible</div>'
          : '<div class="bg-red-100 text-red-800 px-3 py-1 rounded-full text-sm font-medium">❌ Non éligible</div>'
        }
      </div>
    `;
  });

  resultsHTML += `
    </div>

    <div class="bg-gradient-to-r from-yellow-400 to-orange-500 text-white p-8 rounded-xl text-center mb-8">
      <h3 class="text-2xl font-bold mb-4">💡 Votre Recommandation Personnalisée</h3>
      <p class="text-lg mb-6">
        Basé sur votre profil, nous recommandons <strong>Wegovy</strong> avec un coût mensuel de <strong>${Math.round(272 * (1 - discount))}€</strong>
      </p>
      <div class="flex flex-col md:flex-row gap-4 justify-center">
        <a href="/collections/glp1-cout/prix-wegovy-france" class="px-8 py-3 bg-white text-orange-600 font-bold rounded-xl hover:bg-gray-100 transition-colors">
          📋 Guide Complet Wegovy
        </a>
        <a href="#newsletter" class="px-8 py-3 bg-orange-700 text-white font-bold rounded-xl hover:bg-orange-800 transition-colors">
          📧 Recevoir la Liste des Médecins
        </a>
      </div>
    </div>

    <div class="text-center">
      <button onclick="restart()" class="px-8 py-3 bg-gray-600 text-white font-semibold rounded-xl hover:bg-gray-700 transition-colors">
        🔄 Nouveau Calcul
      </button>
    </div>
  `;

  document.getElementById('results-content').innerHTML = resultsHTML;

  // Envoyer les données analytics
  sendAnalytics();
}

function restart() {
  currentStep = 1;
  userData = {};
  document.getElementById('step-3').classList.add('hidden');
  document.getElementById('step-1').classList.remove('hidden');
  updateProgressBar();
  
  // Reset form
  document.querySelectorAll('input, select').forEach(input => input.value = '');
}

function sendAnalytics() {
  // Envoyer les données à votre base de données pour analytics
  fetch('/api/calculator-usage', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      ...userData,
      timestamp: new Date().toISOString(),
      userAgent: navigator.userAgent
    })
  });
}

// Event listeners pour les cartes mutuelle
document.querySelectorAll('.mutuelle-card input').forEach(input => {
  input.addEventListener('change', function() {
    document.querySelectorAll('.mutuelle-option').forEach(option => {
      option.classList.remove('border-blue-500', 'bg-blue-50');
    });
    
    if (this.checked) {
      this.parentElement.querySelector('.mutuelle-option').classList.add('border-blue-500', 'bg-blue-50');
    }
  });
});
</script>

</StaticLayout>
