  .showcase-checklist .check{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;background:#d97706;color:#fff;font-size:.7rem;font-weight:700;margin-right:10px}

  /* Why section */
  .why{padding:100px 0;text-align:center}
  .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:800px;margin:0 auto}
  .why-card{background:#fff;border-radius:24px;padding:40px 32px;border:1px solid #e8e8e8;text-align:left}
  .why-card.highlight{border:2px solid #d97706;box-shadow:0 12px 40px rgba(217,119,6,.1)}
  .why-icon{margin-bottom:16px}
  .why-card h3{font-size:1.1rem;font-weight:800;margin-bottom:8px}
  .why-stat{font-size:1.6rem;font-weight:900;margin-bottom:12px}
  .why-stat.red{color:#dc2626}
  .why-stat.green{color:#16a34a}
  .why-card p{font-size:.88rem;color:#64748b;line-height:1.7}

  /* Full img */
  .full-img{position:relative;height:400px;overflow:hidden}
  .full-img img{width:100%;height:100%;object-fit:cover}
  .full-img-text{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(0,0,0,.4);color:#fff;text-align:center;padding:24px}
  .full-img-text h3{font-size:2rem;font-weight:900;margin-bottom:8px}
  .full-img-text p{font-size:1rem;opacity:.9;max-width:500px}

  /* Services */
  .services{padding:100px 0;text-align:center}
  .svc-row{display:flex;align-items:center;gap:60px;margin-bottom:80px;text-align:left}
  .svc-row.reverse{flex-direction:row-reverse}
  .svc-text{flex:1}
  .svc-img{flex:0 0 420px;max-width:100%}
  .svc-img img{width:100%;border-radius:20px;box-shadow:0 16px 50px rgba(0,0,0,.08)}
  .tag{display:inline-block;padding:5px 14px;border-radius:8px;font-size:.78rem;font-weight:600;margin-bottom:16px}
  .tag-warm{background:#fffbeb;color:#92400e}.tag-rose{background:#fff1f2;color:#9f1239}.tag-sky{background:#f0f9ff;color:#0369a1}
  .svc-text h3{font-size:1.5rem;font-weight:800;margin-bottom:12px}
  .svc-text p{font-size:.92rem;color:#475569;line-height:1.7;margin-bottom:20px}
  .wh-list{list-style:none;font-size:.88rem;color:#334155;line-height:2.2}
  .wh-list li::before{content:"\2713  ";color:#d97706;font-weight:700}

  /* Annette inline CTA */
  .annette-inline{padding:40px 0;background:#fffbeb;border-top:1px solid #fde68a;border-bottom:1px solid #fde68a}
  .annette-inline-inner{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap}
  .annette-inline-inner strong{font-size:1.05rem}
  .annette-inline-inner p{font-size:.88rem;color:#6b7280;margin:4px 0 0}

  /* Results */
  .results{padding:100px 0;background:#fafafa;text-align:center}
  .results-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center;margin-top:48px;text-align:left}
  .res-card{position:relative;border-radius:24px;overflow:hidden}
  .res-card img{width:100%;display:block}
  .res-overlay{position:absolute;bottom:0;left:0;right:0;padding:24px;background:linear-gradient(transparent,rgba(0,0,0,.7));color:#fff}
  .res-overlay strong{font-size:1.8rem;font-weight:900;display:block}
  .res-overlay span{font-size:.85rem;opacity:.9}
  .res-stats{display:flex;flex-direction:column;gap:20px}
  .stat{background:#fff;padding:24px;border-radius:16px;border:1px solid #e8e8e8}
  .stat-n{font-size:1.8rem;font-weight:900;background:linear-gradient(135deg,#d97706,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:4px}
  .stat-l{font-size:.85rem;color:#64748b;line-height:1.5}

  /* Pricing solo */
  .pricing{padding:100px 0;background:#fafafa;text-align:center}
  .pricing-solo{max-width:800px;margin:48px auto 0}
  .price-card-hero{background:#fff;border:2px solid #d97706;border-radius:24px;padding:48px 40px;display:grid;grid-template-columns:1fr 1fr;gap:40px;text-align:left;box-shadow:0 16px 50px rgba(217,119,6,.1)}
  .pch-left{display:flex;flex-direction:column;justify-content:center}
  .pn{font-size:.82rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:#d97706}
  .pa{font-size:3rem;font-weight:900;color:#1a1a2e;letter-spacing:-.03em;margin:8px 0}
  .pa span{font-size:1rem;font-weight:500;color:#94a3b8}
  .pd{font-size:.9rem;color:#64748b;line-height:1.6;margin-bottom:8px}
  .pf{list-style:none;font-size:.88rem;line-height:2.4}
  .pf .y{color:#334155}.pf .y::before{content:"\2713  ";color:#d97706;font-weight:700}.pf .y.b{font-weight:700}
  .pricing-note{font-size:.8rem;color:#94a3b8;margin-top:24px;max-width:600px;margin-left:auto;margin-right:auto}

  /* Trust */
  .trust{padding:80px 0;background:#fffbeb}
  .trust-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
  .trust-item{padding:24px}.ti{font-size:2rem;margin-bottom:12px;display:flex;justify-content:center}
  .trust-item h4{font-size:.95rem;font-weight:700;margin-bottom:6px}
  .trust-item p{font-size:.82rem;color:#475569;line-height:1.5}

  /* Testimonials */
  .testi{padding:100px 0;text-align:center}
  .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px;text-align:left}
  .testi-card{background:#fff;border-radius:20px;padding:28px;border:1px solid #e8e8e8;display:flex;flex-direction:column}
  .stars{color:#f59e0b;font-size:.9rem;margin-bottom:12px;letter-spacing:2px}
  .testi-card p{font-size:.9rem;color:#334155;line-height:1.7;flex:1;margin-bottom:20px;font-style:italic}
  .testi-author{display:flex;align-items:center;gap:12px}
  .testi-author img{width:44px;height:44px;border-radius:50%;object-fit:cover}
  .testi-author strong{display:block;font-size:.88rem}
  .testi-author span{font-size:.78rem;color:#94a3b8}

  /* FAQ */
  .faq{padding:100px 0;text-align:center}
  .faq-list{text-align:left;margin-top:40px;display:flex;flex-direction:column;gap:12px}
  .faq-item{background:#fff;border-radius:16px;overflow:hidden;border:1px solid #e8e8e8;transition:box-shadow .3s}
  .faq-item[open]{box-shadow:0 4px 20px rgba(0,0,0,.06)}
  .faq-item summary{padding:20px 24px;font-weight:700;font-size:.95rem;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary::after{content:"+";font-size:1.4rem;color:#94a3b8;font-weight:400}
  .faq-item[open] summary::after{content:"\2212"}
  .faq-a{padding:0 24px 20px}.faq-a p{font-size:.9rem;color:#475569;line-height:1.7}

  /* CTA final */
  .cta-final{padding:120px 0;text-align:center;background:linear-gradient(135deg,#451a03,#78350f);color:#fff}
  .cta-final h2{color:#fff;font-size:clamp(2rem,4vw,3rem);margin-bottom:16px}
  .cta-final h2 em{-webkit-text-fill-color:#fff}
  .cta-final p{color:rgba(255,255,255,.75);font-size:1.1rem;margin-bottom:36px;max-width:500px;margin-left:auto;margin-right:auto}
  .cta-btns{display:flex;flex-direction:column;align-items:center;gap:12px}
  .cta-sub{display:block;margin-top:16px;font-size:.8rem;color:rgba(255,255,255,.4)}

  /* Footer */
  .lp-footer{padding:40px 0;border-top:1px solid #f0f0f0}
  .footer-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px}
  .footer-links{display:flex;gap:24px}
  .footer-links a{text-decoration:none;color:#94a3b8;font-size:.82rem}.footer-links a:hover{color:#92400e}
  .footer-copy{font-size:.75rem;color:#cbd5e1;width:100%;text-align:center;margin-top:16px}
  .footer-copy small{color:#94a3b8}

  /* RESPONSIVE */
  @media(max-width:900px){
    .burger{display:block}.nav-links,.nav-cta{display:none}
    .hero{padding:120px 24px 80px}
    .showcase-grid{grid-template-columns:1fr}.showcase-images{margin-bottom:40px}
    .why-grid{grid-template-columns:1fr}
    .svc-row,.svc-row.reverse{flex-direction:column;gap:32px}.svc-img{flex:1 1 100%}
    .results-grid{grid-template-columns:1fr}
    .testi-grid{grid-template-columns:1fr}
    .price-card-hero{grid-template-columns:1fr;padding:32px 24px}
    .trust-grid{grid-template-columns:1fr 1fr}
  }
  @media(max-width:600px){
    .hero h1{font-size:2rem}
    .hero-trust{flex-direction:column;align-items:center;gap:8px}
    .full-img{height:280px}
    .trust-grid{grid-template-columns:1fr}
    .footer-inner{flex-direction:column;text-align:center}
    .footer-links{justify-content:center}
    .annette-inline-inner{flex-direction:column;text-align:center}
  }
</style>

<!-- ══════════════════════ SCRIPTS ══════════════════════ -->
<script>
  const burger=document.getElementById('burger'),mm=document.getElementById('mobileMenu');
  burger?.addEventListener('click',()=>{burger.classList.toggle('open');mm?.classList.toggle('open')});
  mm?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{burger?.classList.remove('open');mm?.classList.remove('open')}));
  const nb=document.getElementById('navbar');
  window.addEventListener('scroll',()=>nb?.classList.toggle('scrolled',window.scrollY>20),{passive:true});
  const obs=new IntersectionObserver(e=>e.forEach(x=>{if(x.isIntersecting)x.target.classList.add('visible')}),{threshold:.08,rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.fade-up').forEach(el=>obs.observe(el));
  document.querySelectorAll('a[href^="#"]').forEach(a=>{a.addEventListener('click',e=>{e.preventDefault();const t=document.querySelector(a.getAttribute('href')||'');t?.scrollIntoView({behavior:'smooth',block:'start'})})});
</script>

</body>
</html>
