---
import GoogleAnalytics from '../../../components/GoogleAnalytics.astro';
import Hotjar from '../../../components/Hotjar.astro';
const annette = "https://www.annette.care/?utm_source=glp1france&utm_medium=cpa&utm_campaign=annette_lp";
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accompagnement GLP-1 avec Annette.care — Suivi personnalisé par des experts</title>
  <meta name="description" content="Annette.care : l'accompagnement humain et digital pour votre traitement GLP-1. Diététiciens, suivi comportemental, application mobile. Jusqu'à 20% de perte de poids avec un programme adapté.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="canonical" href="https://glp1-france.fr/annette/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <GoogleAnalytics />
  <Hotjar />
</head>
<body>

<!-- ══════ NAVBAR ══════ -->
<nav id="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-logo"><span class="logo-dot"></span>GLP-1 France <span class="logo-x">x</span> Annette</a>
    <div class="nav-links" id="navLinks">
      <a href="#programme">Le programme</a>
      <a href="#services">Services</a>
      <a href="#resultats">Résultats</a>
      <a href="#faq">FAQ</a>
    </div>
    <a href={annette} target="_blank" rel="noopener sponsored" class="nav-cta">Vérifier mon éligibilité</a>
    <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</nav>
<div class="mobile-menu" id="mobileMenu">
  <a href="#programme">Le programme</a>
  <a href="#services">Services</a>
  <a href="#resultats">Résultats</a>
  <a href="#faq">FAQ</a>
  <a href={annette} target="_blank" rel="noopener sponsored" class="btn-primary" style="text-align:center;margin-top:12px;">Vérifier mon éligibilité</a>
</div>

<!-- ══════ HERO ══════ -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-partner fade-up">
      <span class="partner-badge">Partenaire officiel</span>
    </div>
    <h1 class="fade-up">Perdre du poids sous GLP-1,<br><em>sans être seul(e).</em></h1>
    <p class="hero-desc fade-up">Annette.care combine experts humains (diététiciens, spécialistes du comportement) et outils digitaux pour un accompagnement durable sous traitement GLP-1. Pas juste une prescription — un vrai suivi.</p>
    <div class="hero-actions fade-up">
      <a href={annette} target="_blank" rel="noopener sponsored" class="btn-hero">Vérifier mon éligibilité &rarr;</a>
    </div>
    <div class="hero-trust fade-up">
      <div class="ht-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span>2 000+ patients accompagnés</span></div>
      <div class="ht-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span>4.8/5 satisfaction</span></div>
      <div class="ht-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg><span>Équipe pluridisciplinaire</span></div>
    </div>
  </div>
</section>

<!-- ══════ LOGO BAR ══════ -->
<section class="marquee">
  <div class="marquee-track">
    <div class="marquee-content">
      <span>&#183; DIÉTÉTICIENS DIPLÔMÉS</span>
      <span>&#183; SUIVI COMPORTEMENTAL</span>
      <span>&#183; APPLICATION MOBILE</span>
      <span>&#183; COORDINATION MÉDICALE</span>
      <span>&#183; RÉSULTATS DURABLES</span>
      <span>&#183; DIÉTÉTICIENS DIPLÔMÉS</span>
      <span>&#183; SUIVI COMPORTEMENTAL</span>
      <span>&#183; APPLICATION MOBILE</span>
      <span>&#183; COORDINATION MÉDICALE</span>
      <span>&#183; RÉSULTATS DURABLES</span>
    </div>
  </div>
</section>

<!-- ══════ PRODUCT SHOWCASE ══════ -->
<section class="showcase">
  <div class="container">
    <div class="showcase-label fade-up">ACCOMPAGNEMENT ANNETTE.CARE</div>
    <h2 class="showcase-title fade-up">Plus qu'une prescription,<br><em>un accompagnement complet</em></h2>

    <div class="showcase-grid">
      <div class="showcase-images fade-up">
        <div class="showcase-img-main">
          <img src="/images/landing/coaching-nutrition.jpg" alt="Coaching nutritionnel" loading="lazy">
        </div>
        <div class="showcase-img-center">
          <img src="/images/landing/woman-activewear.jpg" alt="Patiente en forme" loading="lazy">
        </div>
        <div class="showcase-img-right">
          <img src="/images/landing/app-coaching.jpg" alt="Application mobile Annette" loading="lazy">
        </div>
      </div>

      <div class="showcase-checklist fade-up">
        <h3>Ce qui vous attend :</h3>
        <ul>
          <li><span class="check">&#10003;</span> Diététiciens diplômés, dédiés à votre parcours</li>
          <li><span class="check">&#10003;</span> Spécialistes du comportement alimentaire</li>
          <li><span class="check">&#10003;</span> Application mobile pour le suivi au quotidien</li>
          <li><span class="check">&#10003;</span> Coordination avec votre médecin prescripteur</li>
          <li><span class="check">&#10003;</span> Conseils hebdomadaires personnalisés</li>
          <li><span class="check">&#10003;</span> Communauté de patients pour échanger</li>
        </ul>
        <a href={annette} target="_blank" rel="noopener sponsored" class="btn-primary" style="margin-top:24px;">Commencer mon bilan &rarr;</a>
      </div>
    </div>
  </div>
</section>

<!-- ══════ POURQUOI ANNETTE ══════ -->
<section class="why" id="programme">
  <div class="container">
    <div class="pill fade-up">Pourquoi Annette</div>
    <h2 class="fade-up">Le médicament ne suffit pas.<br><em>L'accompagnement fait la différence.</em></h2>
    <p class="sub fade-up">Les GLP-1 coupent l'appétit — mais sans suivi adapté, la reprise de poids est quasi systématique à l'arrêt. Annette.care installe les bonnes habitudes pendant le traitement pour des résultats durables.</p>

    <div class="why-grid">
      <div class="why-card fade-up">
        <div class="why-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="1.5"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2z"/><path d="M12 6v6l4 2"/></svg></div>
        <h3>Sans accompagnement</h3>
        <div class="why-stat red">68% de reprise</div>
        <p>Des études montrent que la majorité des patients reprennent le poids perdu dans les 12 mois suivant l'arrêt du traitement sans suivi adapté.</p>
      </div>
      <div class="why-card highlight fade-up">
        <div class="why-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></div>
        <h3>Avec Annette.care</h3>
        <div class="why-stat green">Résultats durables</div>
        <p>L'accompagnement nutritionnel et comportemental installe les habitudes qui perdurent, même après le traitement. Jusqu'à 20% de perte de poids.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════ FULL-WIDTH IMAGE ══════ -->
<section class="full-img fade-up">
  <img src="/images/landing/healthy-meal.jpg" alt="Nutrition adaptée GLP-1" loading="lazy">
  <div class="full-img-text">
    <h3>Manger mieux, pas moins</h3>
    <p>Des plans alimentaires adaptés au traitement GLP-1 pour préserver votre énergie et votre masse musculaire</p>
  </div>
</section>

<!-- ══════ SERVICES ══════ -->
<section class="services" id="services">
  <div class="container">
    <div class="pill fade-up">L'accompagnement</div>
    <h2 class="fade-up">Une équipe humaine<br><em>à vos côtés</em></h2>

    <div class="svc-row fade-up">
      <div class="svc-text">
        <div class="tag tag-warm">Diététique</div>
        <h3>Des diététiciens spécialisés GLP-1</h3>
        <p>Votre diététicien connaît les spécificités des traitements GLP-1 : adaptation des portions, gestion de la perte d'appétit, préservation de la masse musculaire, prévention des carences.</p>
        <ul class="wh-list"><li>Plan alimentaire personnalisé</li><li>Ajustements selon vos progrès</li><li>Conseils hebdomadaires par l'app</li><li>Recettes adaptées et faciles</li></ul>
      </div>
      <div class="svc-img"><img src="/images/landing/meal-prep-top.jpg" alt="Nutrition" loading="lazy"></div>
    </div>

    <div class="svc-row reverse fade-up">
      <div class="svc-text">
        <div class="tag tag-rose">Comportemental</div>
        <h3>Changez vos habitudes en profondeur</h3>
        <p>Le médicament gère la faim, mais les habitudes restent. Les spécialistes du comportement d'Annette.care vous aident à transformer durablement votre relation à l'alimentation.</p>
        <ul class="wh-list"><li>Gestion du stress alimentaire</li><li>Identification des déclencheurs</li><li>Stratégies anti-grignotage</li><li>Préparation à l'après-traitement</li></ul>
      </div>
      <div class="svc-img"><img src="/images/landing/suivi-patient.jpg" alt="Suivi comportemental" loading="lazy"></div>
    </div>

    <div class="svc-row fade-up">
      <div class="svc-text">
        <div class="tag tag-sky">Application mobile</div>
        <h3>Votre équipe dans la poche</h3>
        <p>L'application Annette.care centralise le suivi de poids, les échanges avec votre équipe, le contenu éducatif et les encouragements de la communauté.</p>
        <ul class="wh-list"><li>Suivi de poids et objectifs</li><li>Messages avec l'équipe d'experts</li><li>Contenu éducatif personnalisé</li><li>Communauté de patients</li></ul>
      </div>
      <div class="svc-img"><img src="/images/landing/app-coaching.jpg" alt="Application mobile" loading="lazy"></div>
    </div>
  </div>
</section>

<!-- ══════ INLINE CTA ══════ -->
<section class="annette-inline fade-up">
  <div class="container">
    <div class="annette-inline-inner">
      <div><strong>Vous êtes sous GLP-1 ou vous envisagez un traitement ?</strong><p>Vérifiez votre éligibilité et découvrez comment Annette.care peut vous accompagner.</p></div>
      <a href={annette} target="_blank" rel="noopener sponsored" class="btn-annette">Vérifier mon éligibilité &rarr;</a>
    </div>
  </div>
</section>

<!-- ══════ RESULTATS ══════ -->
<section class="results" id="resultats">
  <div class="container">
    <div class="pill fade-up">Résultats</div>
    <h2 class="fade-up">Des chiffres qui<br><em>parlent d'eux-mêmes</em></h2>
    <div class="results-grid">
      <div class="res-card fade-up">
        <img src="/images/landing/before-after.jpg" alt="Transformation GLP-1" loading="lazy">
        <div class="res-overlay"><strong>Jusqu'à -20%</strong><span>de poids corporel avec accompagnement adapté</span></div>
      </div>
      <div class="res-stats">
        <div class="stat fade-up"><div class="stat-n">2 000+</div><div class="stat-l">Patients déjà accompagnés par l'équipe Annette.care</div></div>
        <div class="stat fade-up"><div class="stat-n">4.8/5</div><div class="stat-l">Note de satisfaction — programme et équipe d'experts</div></div>
        <div class="stat fade-up"><div class="stat-n">20%</div><div class="stat-l">Perte de poids moyenne avec GLP-1 + accompagnement adapté (étude STEP 3)</div></div>
      </div>
    </div>
  </div>
</section>

<!-- ══════ LIFESTYLE IMAGE ══════ -->
<section class="full-img fade-up">
  <img src="/images/landing/couple-walking.jpg" alt="Mode de vie actif après GLP-1" loading="lazy">
  <div class="full-img-text">
    <h3>Des résultats qui durent</h3>
    <p>L'objectif : que vos nouvelles habitudes persistent, même après le traitement</p>
  </div>
</section>

<!-- ══════ PRICING ══════ -->
<section class="pricing" id="tarifs">
  <div class="container">
    <div class="pill fade-up">L'offre</div>
    <h2 class="fade-up">Un prix simple<br><em>et transparent</em></h2>
    <p class="sub fade-up">Pas de frais cachés, pas d'engagement longue durée.</p>

    <div class="pricing-solo">
      <div class="price-card-hero fade-up">
        <div class="pch-left">
          <span class="pn">Accompagnement complet</span>
          <div class="pa">49&euro;<span>/mois</span></div>
          <p class="pd">Accès complet à l'équipe d'experts, à l'application et à la communauté. Tout inclus.</p>
          <a href={annette} target="_blank" rel="noopener sponsored" class="btn-annette" style="display:inline-block;margin-top:8px;">Commencer maintenant &rarr;</a>
        </div>
        <div class="pch-right">
          <ul class="pf">
            <li class="y b">Diététicien(ne) dédié(e)</li>
            <li class="y b">Spécialiste du comportement</li>
            <li class="y">Application mobile complète</li>
            <li class="y">Conseils hebdomadaires personnalisés</li>
            <li class="y">Coordination avec votre médecin</li>
            <li class="y">Communauté de patients</li>
            <li class="y">Contenu éducatif illimité</li>
            <li class="y">Suivi de progression</li>
          </ul>
        </div>
      </div>
    </div>

    <p class="pricing-note fade-up">Le programme Annette.care est un accompagnement — il ne remplace pas la consultation médicale ni la prescription. Votre médecin reste votre référent pour le traitement GLP-1.</p>
  </div>
</section>

<!-- ══════ TRUST ══════ -->
<section class="trust">
  <div class="container">
    <div class="trust-grid">
      <div class="trust-item fade-up"><div class="ti"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="1.5"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div><h4>Équipe humaine</h4><p>De vrais experts, pas des algorithmes. Diététiciens et spécialistes diplômés.</p></div>
      <div class="trust-item fade-up"><div class="ti"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg></div><h4>App intuitive</h4><p>Tout dans votre poche : suivi, messages, contenu, communauté.</p></div>
      <div class="trust-item fade-up"><div class="ti"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></div><h4>Résultats prouvés</h4><p>2 000+ patients, 4.8/5 satisfaction. Données basées sur les études STEP.</p></div>
      <div class="trust-item fade-up"><div class="ti"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#92400e" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><h4>Données protégées</h4><p>Vos données de santé sont sécurisées et confidentielles.</p></div>
    </div>
  </div>
</section>

<!-- ══════ TEMOIGNAGES ══════ -->
<section class="testi">
  <div class="container">
    <div class="pill fade-up">Témoignages</div>
    <h2 class="fade-up">Ils sont accompagnés<br><em>par Annette</em></h2>
    <div class="testi-grid">
      <div class="testi-card fade-up">
        <div class="stars">&starf;&starf;&starf;&starf;&starf;</div>
        <p>&laquo; Le suivi avec ma diététicienne a changé ma façon de manger. Sous Wegovy, je n'avais plus faim — elle m'a appris à manger mieux, pas juste moins. &raquo;</p>
        <div class="testi-author"><img src="/images/landing/woman-scale.jpg" alt="Claire M." loading="lazy"><div><strong>Claire M.</strong><span>Paris — Wegovy</span></div></div>
      </div>
      <div class="testi-card fade-up">
        <div class="stars">&starf;&starf;&starf;&starf;&starf;</div>
        <p>&laquo; Le volet comportemental m'a beaucoup aidé. Comprendre pourquoi je grignotais m'a permis de changer mes habitudes durablement. &raquo;</p>
        <div class="testi-author"><img src="/images/landing/woman-mirror.jpg" alt="Thomas R." loading="lazy"><div><strong>Thomas R.</strong><span>Marseille — Mounjaro</span></div></div>
      </div>
      <div class="testi-card fade-up">
        <div class="stars">&starf;&starf;&starf;&starf;&starf;</div>
        <p>&laquo; L'application est très bien faite et la communauté motive. On se sent moins seul(e) dans ce parcours. &raquo;</p>
        <div class="testi-author"><img src="/images/landing/coaching-nutrition.jpg" alt="Nadia B." loading="lazy"><div><strong>Nadia B.</strong><span>Toulouse — Ozempic</span></div></div>
      </div>
    </div>
  </div>
</section>

<!-- ══════ FAQ ══════ -->
<section class="faq" id="faq">
  <div class="container narrow">
    <div class="pill fade-up">Questions fréquentes</div>
    <h2 class="fade-up">Tout ce que vous<br><em>devez savoir</em></h2>
    <div class="faq-list">
      <details class="faq-item fade-up"><summary>Annette.care prescrit-elle des médicaments ?</summary><div class="faq-a"><p>Non. Annette.care est un programme d'accompagnement, pas de prescription. Votre médecin traitant ou spécialiste reste votre référent pour le traitement GLP-1. Annette.care se coordonne avec lui.</p></div></details>
      <details class="faq-item fade-up"><summary>Qui peut bénéficier du programme ?</summary><div class="faq-a"><p>Le programme s'adresse aux adultes avec un IMC &ge; 30 (ou &ge; 27 avec comorbidités) qui sont sous traitement GLP-1 ou envisagent d'en commencer un.</p></div></details>
      <details class="faq-item fade-up"><summary>Que comprend l'abonnement à 49&euro;/mois ?</summary><div class="faq-a"><p>L'accès complet : diététicien(ne) dédié(e), spécialiste du comportement, application mobile, contenu éducatif, communauté de patients, suivi de progression et conseils hebdomadaires.</p></div></details>
      <details class="faq-item fade-up"><summary>Puis-je arrêter à tout moment ?</summary><div class="faq-a"><p>Oui, l'abonnement est sans engagement. Vous pouvez arrêter quand vous le souhaitez, directement depuis l'application.</p></div></details>
      <details class="faq-item fade-up"><summary>Comment se passe le suivi au quotidien ?</summary><div class="faq-a"><p>Vous échangez avec votre équipe via l'application. Conseils hebdomadaires personnalisés, suivi de poids, accès à du contenu éducatif et à la communauté de patients.</p></div></details>
      <details class="faq-item fade-up"><summary>Quels résultats puis-je attendre ?</summary><div class="faq-a"><p>Les études cliniques (STEP 3) montrent jusqu'à 20% de perte de poids avec GLP-1 et accompagnement comportemental. Les résultats varient selon les individus.</p></div></details>
    </div>
  </div>
</section>

<!-- ══════ CTA FINAL ══════ -->
<section class="cta-final">
  <div class="container narrow">
    <h2 class="fade-up">Prêt(e) à être<br>accompagné(e) ?</h2>
    <p class="fade-up">Vérifiez votre éligibilité et rejoignez les 2 000+ patients suivis par Annette.care.</p>
    <div class="cta-btns fade-up">
      <a href={annette} target="_blank" rel="noopener sponsored" class="btn-primary large">Vérifier mon éligibilité &rarr;</a>
    </div>
    <span class="cta-sub fade-up">49&euro;/mois. Sans engagement. Annulation à tout moment.</span>
  </div>
</section>

<!-- ══════ FOOTER ══════ -->
<footer class="lp-footer">
  <div class="container">
    <div class="footer-inner">
      <a href="/" class="nav-logo"><span class="logo-dot"></span> GLP-1 France</a>
      <div class="footer-links"><a href="/mentions-legales/">Mentions légales</a><a href="/politique-de-confidentialite/">Confidentialité</a><a href="/contact/">Contact</a></div>
      <p class="footer-copy">&copy; 2026 GLP-1 France. Contenu informatif — ne remplace pas un avis médical.<br><small>Les liens vers Annette.care sont des liens d'affiliation. Commission possible sans surcoût pour vous.</small></p>
    </div>
  </div>
</footer>

<!-- ══════════════════════ STYLES ══════════════════════ -->
<style>
  *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Onest',system-ui,-apple-system,sans-serif;color:#1a1a2e;background:#fff;line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
  .container{max-width:1140px;margin:0 auto;padding:0 24px}
  .container.narrow{max-width:760px}

  /* Animations */
  .fade-up{opacity:0;transform:translateY(30px);transition:opacity .7s ease,transform .7s ease}
  .fade-up.visible{opacity:1;transform:translateY(0)}

  /* Navbar */
  #navbar{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(255,255,255,.85);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(0,0,0,.06);transition:box-shadow .3s}
  #navbar.scrolled{box-shadow:0 4px 30px rgba(0,0,0,.08)}
  .nav-inner{max-width:1140px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:64px}
  .nav-logo{font-weight:800;font-size:1.15rem;color:#1a1a2e;text-decoration:none;display:flex;align-items:center;gap:8px}
  .logo-dot{width:10px;height:10px;border-radius:50%;background:linear-gradient(135deg,#d97706,#f59e0b)}
  .logo-x{font-size:.7rem;font-weight:500;color:#94a3b8;margin:0 2px}
  .nav-links{display:flex;gap:28px}
  .nav-links a{text-decoration:none;color:#64748b;font-size:.86rem;font-weight:500;transition:color .2s}
  .nav-links a:hover{color:#92400e}
  .nav-cta{background:#d97706;color:#fff!important;padding:8px 20px;border-radius:8px;text-decoration:none;font-weight:600;font-size:.85rem;transition:background .2s}
  .nav-cta:hover{background:#b45309}
  .burger{display:none;background:none;border:none;cursor:pointer;width:28px;height:20px;position:relative;z-index:1001}
  .burger span{display:block;width:100%;height:2px;background:#1a1a2e;border-radius:2px;position:absolute;left:0;transition:all .3s}
  .burger span:nth-child(1){top:0}.burger span:nth-child(2){top:9px}.burger span:nth-child(3){top:18px}
  .burger.open span:nth-child(1){top:9px;transform:rotate(45deg)}.burger.open span:nth-child(2){opacity:0}.burger.open span:nth-child(3){top:9px;transform:rotate(-45deg)}
  .mobile-menu{display:none;position:fixed;top:64px;left:0;right:0;bottom:0;background:#fff;padding:32px 24px;z-index:999;flex-direction:column;gap:24px}
  .mobile-menu.open{display:flex}
  .mobile-menu a{font-size:1.2rem;color:#1a1a2e;text-decoration:none;font-weight:600}

  /* HERO — warm amber/earth tones */
  .hero{background:linear-gradient(160deg,#451a03 0%,#78350f 40%,#451a03 100%);color:#fff;padding:160px 24px 100px;text-align:center;position:relative;overflow:hidden}
  .hero::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle at 30% 70%,rgba(217,119,6,.15) 0%,transparent 50%);pointer-events:none}
  .hero-inner{max-width:800px;margin:0 auto;position:relative;z-index:1}
  .hero-partner{margin-bottom:20px}
  .partner-badge{display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.15);padding:8px 20px;border-radius:100px;font-size:.82rem;font-weight:600;letter-spacing:.02em}
  .hero h1{font-size:clamp(2.4rem,6vw,4rem);font-weight:900;line-height:1.05;letter-spacing:-.03em;margin-bottom:24px}
  .hero h1 em{font-style:normal;color:#fbbf24}
  .hero-desc{font-size:1.05rem;opacity:.8;max-width:620px;margin:0 auto 36px;line-height:1.7}
  .hero-actions{display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:32px}
  .btn-hero{display:inline-block;background:#d97706;color:#fff;padding:16px 36px;border-radius:12px;text-decoration:none;font-weight:700;font-size:1rem;transition:all .3s}
  .btn-hero:hover{background:#b45309;transform:translateY(-2px);box-shadow:0 8px 30px rgba(217,119,6,.4)}
  .hero-trust{display:flex;gap:24px;justify-content:center;flex-wrap:wrap}
  .ht-item{display:flex;align-items:center;gap:6px;font-size:.82rem;opacity:.7}

  /* Marquee */
  .marquee{background:#fffbeb;padding:18px 0;overflow:hidden;border-top:1px solid #fde68a;border-bottom:1px solid #fde68a}
  .marquee-track{display:flex;width:max-content}
  .marquee-content{display:flex;gap:48px;animation:scroll 30s linear infinite;white-space:nowrap}
  .marquee-content span{font-size:.82rem;font-weight:700;letter-spacing:.1em;color:#92400e;text-transform:uppercase}
  @keyframes scroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

  /* Buttons */
  .btn-primary{display:inline-block;background:#d97706;color:#fff;padding:14px 32px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.95rem;transition:all .3s;border:none;cursor:pointer}
  .btn-primary:hover{background:#b45309;transform:translateY(-2px);box-shadow:0 8px 25px rgba(217,119,6,.3)}
  .btn-primary.large{padding:18px 40px;font-size:1.1rem}
  .btn-annette{display:inline-block;background:#d97706;color:#fff;padding:14px 28px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.92rem;transition:all .3s}
  .btn-annette:hover{background:#b45309;transform:translateY(-2px);box-shadow:0 8px 25px rgba(217,119,6,.3)}

  /* Section utils */
  .pill{display:inline-block;background:rgba(217,119,6,.08);color:#d97706;padding:6px 16px;border-radius:100px;font-size:.78rem;font-weight:600;text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px}
  .sub{font-size:1.05rem;color:#64748b;max-width:600px;margin:0 auto 48px;line-height:1.7}
  h2{font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:900;line-height:1.15;letter-spacing:-.02em;margin-bottom:16px}
  h2 em{font-style:normal;background:linear-gradient(135deg,#d97706,#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}

  /* Showcase */
  .showcase{padding:100px 0;background:#fffbeb;text-align:center}
  .showcase-label{font-size:.78rem;font-weight:700;letter-spacing:.1em;color:#d97706;text-transform:uppercase;margin-bottom:12px}
  .showcase-title{font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:900;line-height:1.15;margin-bottom:48px}
  .showcase-title em{font-style:normal;color:#d97706}
  .showcase-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:60px;align-items:center;text-align:left}
  .showcase-images{display:grid;grid-template-columns:1.1fr .8fr .7fr;gap:12px;align-items:center}
  .showcase-img-main img,.showcase-img-center img,.showcase-img-right img{width:100%;border-radius:20px;box-shadow:0 8px 30px rgba(0,0,0,.08)}
