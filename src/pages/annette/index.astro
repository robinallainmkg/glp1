---
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import Hotjar from '../../components/Hotjar.astro';
const annette = "https://www.annette.care/?utm_source=glp1france&utm_medium=affiliation&utm_campaign=partenariat_landing";
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Programme Annette.care — Accompagnement perte de poids sous GLP-1</title>
  <meta name="description" content="Annette accompagne les patients sous Wegovy, Mounjaro et Saxenda : diététicien dédié, suivi quotidien, téléconsultations médicales. 24,50€ le 1er mois avec le code GLP1FRANCE50.">
  <meta name="robots" content="noindex, nofollow">
  <link rel="canonical" href="https://glp1-france.fr/annette/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <GoogleAnalytics />
  <Hotjar />
  <style>
    /* ══════ RESET & BASE ══════ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Onest', system-ui, -apple-system, sans-serif;
      color: #1a1a1a;
      background: #F0F9FF;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; display: block; }

    /* ══════ HEADER ══════ */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(240, 249, 255, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(27, 111, 160, 0.1);
      padding: 14px 24px;
    }
    .header-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .header-logo {
      font-weight: 700;
      font-size: 1.1rem;
      color: #1B6FA0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .logo-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      background: #1B6FA0;
      border-radius: 50%;
    }
    .header-back {
      font-size: 0.9rem;
      color: #1B6FA0;
      opacity: 0.7;
      transition: opacity 0.2s;
    }
    .header-back:hover { opacity: 1; }

    /* ══════ HERO ══════ */
    .hero {
      background: linear-gradient(135deg, #F0F9FF 0%, #E8F6FF 40%, #A9E1FF 100%);
      padding: 80px 24px 72px;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(59, 159, 217, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-inner {
      max-width: 720px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }
    .partner-badge {
      display: inline-block;
      background: rgba(27, 111, 160, 0.12);
      color: #1B6FA0;
      font-weight: 600;
      font-size: 0.82rem;
      padding: 6px 16px;
      border-radius: 20px;
      margin-bottom: 24px;
      letter-spacing: 0.02em;
    }
    .hero h1 {
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      font-weight: 800;
      line-height: 1.15;
      color: #0D4F73;
      margin-bottom: 20px;
    }
    .hero h1 em {
      font-style: normal;
      color: #1B6FA0;
    }
    .hero-desc {
      font-size: 1.1rem;
      color: #1B6FA0;
      max-width: 600px;
      margin: 0 auto 32px;
      line-height: 1.7;
    }
    .hero-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .btn-hero {
      display: inline-block;
      background: #1B6FA0;
      color: #fff;
      font-weight: 700;
      font-size: 1.05rem;
      padding: 16px 36px;
      border-radius: 12px;
      transition: background 0.2s, transform 0.15s;
      box-shadow: 0 4px 16px rgba(27, 111, 160, 0.3);
    }
    .btn-hero:hover {
      background: #1B6FA0;
      transform: translateY(-1px);
    }
    .hero-promo {
      font-size: 0.92rem;
      color: #1B6FA0;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.6);
      padding: 8px 20px;
      border-radius: 8px;
      border: 1px dashed #1B6FA0;
    }
    .hero-promo code {
      background: #1B6FA0;
      color: #fff;
      padding: 2px 8px;
      border-radius: 4px;
      font-family: 'Onest', monospace;
      font-weight: 700;
      font-size: 0.88rem;
    }

    /* ══════ SECTION COMMON ══════ */
    .container { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
    section { padding: 72px 24px; }
    .section-label {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #1B6FA0;
      background: rgba(27, 111, 160, 0.08);
      padding: 6px 14px;
      border-radius: 6px;
      margin-bottom: 16px;
    }
    .section-title {
      font-size: clamp(1.5rem, 4vw, 2.2rem);
      font-weight: 800;
      color: #0D4F73;
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .section-title em {
      font-style: normal;
      color: #1B6FA0;
    }
    .section-desc {
      font-size: 1.05rem;
      color: #1B6FA0;
      max-width: 600px;
      line-height: 1.6;
    }
    .section-desc.centered { margin: 0 auto; text-align: center; }

    /* ══════ PROBLEM SECTION ══════ */
    .problem {
      background: #fff;
      border-top: 1px solid rgba(27, 111, 160, 0.1);
      border-bottom: 1px solid rgba(27, 111, 160, 0.1);
    }
    .problem-inner {
      max-width: 1100px;
      margin: 0 auto;
    }
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 40px;
    }
    .problem-card {
      background: #F0F9FF;
      border: 1px solid rgba(27, 111, 160, 0.12);
      border-radius: 16px;
      padding: 28px 24px;
    }
    .problem-icon {
      width: 44px;
      height: 44px;
      background: rgba(239, 68, 68, 0.08);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      font-size: 1.3rem;
    }
    .problem-card h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #0D4F73;
      margin-bottom: 8px;
    }
    .problem-card p {
      font-size: 0.92rem;
      color: #1B6FA0;
      line-height: 1.55;
    }
    .problem-stat {
      display: inline-block;
      font-size: 2.2rem;
      font-weight: 900;
      color: #dc2626;
      margin-bottom: 4px;
    }

    /* ══════ PROGRAM SECTION ══════ */
    .program {
      background: #F0F9FF;
    }
    .program-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-top: 40px;
    }
    .program-card {
      background: #fff;
      border: 1px solid rgba(27, 111, 160, 0.1);
      border-radius: 16px;
      padding: 28px 24px;
      transition: box-shadow 0.2s, transform 0.15s;
    }
    .program-card:hover {
      box-shadow: 0 8px 24px rgba(27, 111, 160, 0.1);
      transform: translateY(-2px);
    }
    .program-icon {
      width: 44px;
      height: 44px;
      background: rgba(27, 111, 160, 0.08);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
      font-size: 1.3rem;
    }
    .program-card h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #0D4F73;
      margin-bottom: 6px;
    }
    .program-card p {
      font-size: 0.92rem;
      color: #1B6FA0;
      line-height: 1.55;
    }

    /* ══════ PRICING SECTION ══════ */
    .pricing {
      background: #fff;
      text-align: center;
      border-top: 1px solid rgba(27, 111, 160, 0.1);
      border-bottom: 1px solid rgba(27, 111, 160, 0.1);
    }
    .pricing-card {
      max-width: 480px;
      margin: 40px auto 0;
      background: linear-gradient(135deg, #F0F9FF, #E8F6FF);
      border: 2px solid #1B6FA0;
      border-radius: 20px;
      padding: 40px 32px;
      position: relative;
      overflow: hidden;
    }
    .pricing-card::before {
      content: '';
      position: absolute;
      top: -40px;
      right: -40px;
      width: 120px;
      height: 120px;
      background: rgba(27, 111, 160, 0.06);
      border-radius: 50%;
      pointer-events: none;
    }
    .pricing-original {
      font-size: 1rem;
      color: #1B6FA0;
      opacity: 0.7;
    }
    .pricing-original s { text-decoration: line-through; }
    .pricing-amount {
      font-size: 3.2rem;
      font-weight: 900;
      color: #1B6FA0;
      margin: 8px 0 4px;
    }
    .pricing-amount span {
      font-size: 1.1rem;
      font-weight: 600;
      color: #1B6FA0;
    }
    .pricing-period {
      font-size: 0.95rem;
      color: #1B6FA0;
      margin-bottom: 8px;
    }
    .pricing-code {
      display: inline-block;
      background: #1B6FA0;
      color: #fff;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 6px 16px;
      border-radius: 6px;
      margin: 12px 0 6px;
      font-family: 'Onest', monospace;
    }
    .pricing-promo-note {
      font-size: 0.85rem;
      color: #1B6FA0;
      opacity: 0.8;
      margin-bottom: 20px;
    }
    .pricing-features {
      list-style: none;
      text-align: left;
      margin: 20px 0 28px;
      padding: 0;
    }
    .pricing-features li {
      padding: 8px 0;
      font-size: 0.95rem;
      color: #0D4F73;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid rgba(27, 111, 160, 0.08);
    }
    .pricing-features li:last-child { border: none; }
    .pricing-check {
      color: #1B6FA0;
      font-weight: 700;
      font-size: 1rem;
      flex-shrink: 0;
    }
    .pricing-note {
      font-size: 0.85rem;
      color: #1B6FA0;
      opacity: 0.7;
      margin-top: 16px;
    }
    .btn-pricing {
      display: inline-block;
      background: #1B6FA0;
      color: #fff;
      font-weight: 700;
      font-size: 1.05rem;
      padding: 16px 40px;
      border-radius: 12px;
      transition: background 0.2s, transform 0.15s;
      box-shadow: 0 4px 16px rgba(27, 111, 160, 0.3);
    }
    .btn-pricing:hover {
      background: #1B6FA0;
      transform: translateY(-1px);
    }

    /* ══════ TRUST SECTION ══════ */
    .trust {
      background: #F0F9FF;
    }
    .trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-top: 40px;
    }
    .trust-card {
      background: #fff;
      border: 1px solid rgba(27, 111, 160, 0.1);
      border-radius: 16px;
      padding: 32px 24px;
      text-align: center;
    }
    .trust-icon {
      width: 52px;
      height: 52px;
      background: rgba(27, 111, 160, 0.08);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 16px;
      font-size: 1.5rem;
    }
    .trust-num {
      font-size: 1.8rem;
      font-weight: 900;
      color: #1B6FA0;
      margin-bottom: 4px;
    }
    .trust-card h3 {
      font-size: 0.95rem;
      font-weight: 600;
      color: #0D4F73;
    }

    /* ══════ FAQ SECTION ══════ */
    .faq {
      background: #fff;
      border-top: 1px solid rgba(27, 111, 160, 0.1);
    }
    .faq-list {
      max-width: 720px;
      margin: 40px auto 0;
    }
    .faq-item {
      border: 1px solid rgba(27, 111, 160, 0.12);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
      background: #F0F9FF;
    }
    .faq-question {
      width: 100%;
      background: none;
      border: none;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 600;
      color: #0D4F73;
      padding: 18px 24px;
      text-align: left;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background 0.15s;
    }
    .faq-question:hover { background: rgba(27, 111, 160, 0.04); }
    .faq-chevron {
      font-size: 1.2rem;
      color: #1B6FA0;
      transition: transform 0.25s;
      flex-shrink: 0;
      margin-left: 12px;
    }
    .faq-item.open .faq-chevron { transform: rotate(180deg); }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }
    .faq-answer-inner {
      padding: 0 24px 18px;
      font-size: 0.95rem;
      color: #1B6FA0;
      line-height: 1.6;
    }
    .faq-item.open .faq-answer { max-height: 300px; }

    /* ══════ FINAL CTA ══════ */
    .final-cta {
      background: linear-gradient(135deg, #1B6FA0, #3B9FD9);
      text-align: center;
      padding: 64px 24px;
    }
    .final-cta h2 {
      font-size: clamp(1.4rem, 4vw, 2rem);
      font-weight: 800;
      color: #fff;
      margin-bottom: 12px;
    }
    .final-cta p {
      font-size: 1.05rem;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 28px;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
    }
    .btn-final {
      display: inline-block;
      background: #fff;
      color: #1B6FA0;
      font-weight: 700;
      font-size: 1.05rem;
      padding: 16px 40px;
      border-radius: 12px;
      transition: background 0.2s, transform 0.15s;
      box-shadow: 0 4px 20px rgba(27, 111, 160, 0.2);
    }
    .btn-final:hover {
      background: #E8F6FF;
      transform: translateY(-1px);
    }
    .final-promo {
      margin-top: 14px;
      font-size: 0.88rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 500;
    }
    .final-promo code {
      background: rgba(255, 255, 255, 0.2);
      padding: 2px 8px;
      border-radius: 4px;
      font-family: 'Onest', monospace;
      font-weight: 700;
    }

    /* ══════ DISCLAIMER ══════ */
    .disclaimer {
      background: #F0F9FF;
      padding: 32px 24px;
      text-align: center;
      border-top: 1px solid rgba(27, 111, 160, 0.1);
    }
    .disclaimer p {
      font-size: 0.8rem;
      color: #1B6FA0;
      opacity: 0.6;
      max-width: 680px;
      margin: 0 auto;
      line-height: 1.55;
    }
    .disclaimer p + p { margin-top: 8px; }

    /* ══════ RESPONSIVE ══════ */
    @media (max-width: 768px) {
      .hero { padding: 56px 20px 56px; }
      section { padding: 56px 20px; }
      .problem-grid { grid-template-columns: 1fr; }
      .program-grid { grid-template-columns: 1fr; }
      .trust-grid { grid-template-columns: 1fr; }
      .pricing-card { padding: 32px 24px; }
      .pricing-amount { font-size: 2.6rem; }
      .btn-hero, .btn-pricing, .btn-final {
        padding: 14px 28px;
        font-size: 0.98rem;
      }
    }

    /* ══════ FADE-IN ANIMATION ══════ */
    .fade-up {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

<!-- ══════ HEADER ══════ -->
<header class="header">
  <div class="header-inner">
    <a href="/" class="header-logo"><span class="logo-dot"></span>GLP-1 France</a>
    <a href="/" class="header-back">&larr; Retour au site</a>
  </div>
</header>

<!-- ══════ HERO ══════ -->
<section class="hero">
  <div class="hero-inner">
    <div class="fade-up">
      <img src="/images/partners/annette/logo-black.png" alt="Annette" style="height:32px;margin-bottom:1rem;display:inline-block;">
      <span class="partner-badge">Partenaire GLP-1 France</span>
    </div>
    <h1 class="fade-up">Optimisez votre traitement GLP-1 avec un <em>accompagnement structuré</em></h1>
    <p class="hero-desc fade-up">Annette accompagne les patients sous Wegovy, Mounjaro et Saxenda avec un suivi diététique personnalisé et un encadrement médical adapté.</p>
    <div class="fade-up" style="margin-bottom:28px;">
      <img src="/images/partners/annette/hero-woman.png" alt="Accompagnement Annette" style="max-width:320px;margin:0 auto;border-radius:16px;">
    </div>
    <div class="hero-actions fade-up">
      <a href={annette} target="_blank" rel="noopener sponsored" class="btn-hero">Découvrir le programme &rarr;</a>
      <div class="hero-promo">24,50&euro; le 1er mois avec <code>GLP1FRANCE50</code></div>
    </div>
  </div>
</section>

<!-- ══════ PROBLEM ══════ -->
<section class="problem">
  <div class="problem-inner">
    <div class="fade-up" style="text-align:center;">
      <span class="section-label">Le constat</span>
      <h2 class="section-title">Le traitement seul <em>ne suffit pas</em></h2>
    </div>
    <div class="problem-grid">
      <div class="problem-card fade-up">
        <div class="problem-icon">&#9888;&#65039;</div>
        <div class="problem-stat">68%</div>
        <h3>de reprise de poids</h3>
        <p>Sans accompagnement adapté, la majorité des patients reprennent le poids perdu à l'arrêt du traitement GLP-1.</p>
      </div>
      <div class="problem-card fade-up">
        <div class="problem-icon">&#127860;</div>
        <h3>Peu de suivi nutritionnel</h3>
        <p>Les traitements GLP-1 coupent l'appétit, mais chaque repas doit être pensé pour préserver la masse musculaire et éviter les carences.</p>
      </div>
      <div class="problem-card fade-up">
        <div class="problem-icon">&#128169;</div>
        <h3>Effets secondaires mal gérés</h3>
        <p>Nausées, fatigue, troubles digestifs : sans repères quotidiens, les effets secondaires découragent de nombreux patients.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════ PROGRAM ══════ -->
<section class="program">
  <div class="container">
    <div class="fade-up" style="text-align:center;">
      <span class="section-label">Le programme</span>
      <h2 class="section-title">Ce qu'Annette <em>propose</em></h2>
      <p class="section-desc centered">Un accompagnement complet pensé pour les patients sous traitement GLP-1, combinant suivi humain et outils numériques.</p>
    </div>
    <div class="program-grid">
      <div class="program-card fade-up">
        <div class="program-icon">&#128105;&#8205;&#9877;&#65039;</div>
        <h3>Diététicien dédié et suivi quotidien</h3>
        <p>Un diététicien vous accompagne au quotidien pour adapter votre alimentation à chaque étape de votre traitement.</p>
      </div>
      <div class="program-card fade-up">
        <div class="program-icon">&#127861;</div>
        <h3>Programme nutritionnel personnalisé</h3>
        <p>Plans de repas sur mesure, recettes adaptées et objectifs nutritionnels calibrés pour maximiser votre perte de poids.</p>
      </div>
      <div class="program-card fade-up">
        <div class="program-icon">&#128241;</div>
        <h3>Suivi des effets secondaires dans l'app</h3>
        <p>Signalez vos symptômes dans l'application. Votre équipe ajuste le programme en fonction de votre ressenti quotidien.</p>
      </div>
      <div class="program-card fade-up">
        <div class="program-icon">&#128187;</div>
        <h3>Téléconsultations avec médecins partenaires</h3>
        <p>Accédez à un réseau d'environ 10 médecins partenaires spécialisés pour un suivi médical régulier et adapté.</p>
      </div>
      <div class="program-card fade-up">
        <div class="program-icon">&#128172;</div>
        <h3>Chat illimité avec diététiciens</h3>
        <p>Posez vos questions à tout moment. Les diététiciens d'Annette répondent pour vous guider entre les consultations.</p>
      </div>
      <div class="program-card fade-up">
        <div class="program-icon">&#129302;</div>
        <h3>IA intégrée + communauté de patients</h3>
        <p>Intelligence artificielle pour des recommandations instantanées et une communauté de patients pour partager et se motiver.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════ PRICING ══════ -->
<section class="pricing">
  <div class="container">
    <div class="fade-up">
      <span class="section-label">Tarif</span>
      <h2 class="section-title">Un prix accessible pour <em>un vrai suivi</em></h2>
    </div>
    <div class="pricing-card fade-up">
      <div class="pricing-original">Prix standard : <s>49&euro;/mois</s></div>
      <div class="pricing-amount">24,50&euro; <span>/1er mois</span></div>
      <div class="pricing-period">puis 49&euro;/mois &mdash; engagement 3 mois</div>
